---
/**
 * Peninsula Insider  -  BaseLayout
 *
 * Single wrapping layout for every page in the rebuild.
 * Handles <head>, fonts, global styles, masthead, footer.
 * Content slots through <slot />.
 */

import '../styles/global.css';
import '../styles/concierge.css';   // chat & drawer styles, loaded on every page
import '../styles/search.css';      // site-search overlay + /search page styles
import '../styles/v4.css';          // V4 mega-menu chrome, additive tokens scoped --v4-*
import '../styles/inline-edit.css'; // admin-only inline editor chrome, inert unless edit mode is on
import { ClientRouter } from 'astro:transitions';
// V4 menu promotion (2026-05-06): the V2 Masthead is replaced by V4Masthead.
// V2 Masthead.astro stays in the codebase as reference but is no longer
// imported here. The V4MobileDrawer replaces V2's #mobileNav overlay.
import V4Masthead from '../components/v4/V4Masthead.astro';
import V4MobileDrawer from '../components/v4/V4MobileDrawer.astro';
import Footer from '../components/Footer.astro';
import ConciergeDrawer from '../components/ConciergeDrawer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import AuthModal from '../components/v2/AuthModal.astro';
import ProfileDropdown from '../components/v2/ProfileDropdown.astro';
import CookieBanner from '../components/CookieBanner.astro';
import SaveSiteController from '../components/SaveSiteController.astro';
import CloudSync from '../components/CloudSync.astro';
import InlineEditor from '../components/admin/InlineEditor.astro';

export interface Props {
  title: string;
  description?: string;
  section?: 'home' | 'eat' | 'stay' | 'wine' | 'explore' | 'journal' | 'places' | 'escape' | 'whats-on';
  preview?: boolean;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** Override the search-result chip label. Defaults to a label derived from section. */
  searchKind?: string;
  /** Exclude this page from the Pagefind index entirely (e.g. /search itself). */
  searchExclude?: boolean;
}

const SITE_URL = 'https://peninsulainsider.com.au';

const {
  title,
  description = 'The independent editorial guide to the Mornington Peninsula, honest, opinionated coverage of eating, drinking, staying, and exploring.',
  section = 'home',
  preview = false,
  canonical,
  ogImage = '/images/sourced/home-cover.webp',
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  searchKind,
  searchExclude = false,
} = Astro.props;

// Map the editorial section to a search-chip label. Reader-facing strings —
// these populate the "kind" filter chips on /search.
const SECTION_TO_SEARCH_KIND: Record<string, string> = {
  home: 'Home',
  eat: 'Eat',
  stay: 'Stay',
  wine: 'Wine',
  explore: 'Explore',
  journal: 'Journal',
  places: 'Places',
  escape: 'Plans',
  'whats-on': "What's On",
};
const resolvedSearchKind = searchKind ?? SECTION_TO_SEARCH_KIND[section] ?? 'Guide';

// Canonical: use explicit prop if provided, otherwise derive from current URL pathname.
// Strip any /V2/ base prefix so canonicals always point at the production root.
// GitHub Pages serves all pages with trailing slashes, canonicals must match.
const rawPathname = Astro.url.pathname.replace(/^\/V2/, '') || '/';
const normalizedPath = rawPathname === '/' ? '/' : rawPathname.replace(/\/?$/, '/');
const rawCanonical = canonical ?? `${SITE_URL}${normalizedPath}`;
const canonicalUrl = rawCanonical.endsWith('/') ? rawCanonical : rawCanonical + '/';

// OG image must be an absolute URL.
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : `${SITE_URL}${ogImage.startsWith('/') ? ogImage : '/' + ogImage}`;

// Don't render the floating drawer when the visitor is on /ask itself.
// /ask IS the full-screen chat, the drawer would be a duplicate.
const isAskPage = rawPathname.startsWith('/ask');
---

<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="content-language" content="en-AU" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Outfit:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Peninsula Insider" />
  <meta property="og:locale" content="en_AU" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Peninsula Insider',
    url: SITE_URL,
    logo: `${SITE_URL}/images/sourced/home-cover.webp`,
  })} />

  <!-- View transitions: client-side routing with page fade -->
  <ClientRouter />

  <link rel="stylesheet" href="/assets/styles.css" />

  <!-- Enhancement layers -->
  <link rel="stylesheet" href="/assets/mobile-fixes.css" />
  <link rel="stylesheet" href="/assets/scroll-animations.css" />

  <!-- Google tag (gtag.js) — gated on user consent.
       The loader checks localStorage 'pi-consent-v1' and only injects
       gtag if analytics consent is true. CookieBanner dispatches
       'pi:consent-changed' when the user opts in/out, and we wire that
       up here so the script can be added later in the same pageview. -->
  <script is:inline>
    (function () {
      var GA_ID = 'G-0MR9YVZ9NW';
      var KEY = 'pi-consent-v1';

      function loadGtag() {
        if (window._piGtagLoaded) return;
        window._piGtagLoaded = true;
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID);
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
      }

      function readConsent() {
        try {
          var raw = localStorage.getItem(KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (_e) { return null; }
      }

      var consent = readConsent();
      if (consent && consent.analytics) loadGtag();

      window.addEventListener('pi:consent-changed', function (e) {
        var s = (e && e.detail) || readConsent();
        if (s && s.analytics) loadGtag();
      });
    })();
  </script>

  <!-- TEMPORARY PASSWORD GATE -->
  <script is:inline>
    (function() {
      var KEY  = 'pi-access-v1';
      if (localStorage.getItem(KEY) === '1') return;
      var path = window.location.pathname;
      if (path === '/access/' || path === '/access') return;
      window.location.replace('/access/?r=' + encodeURIComponent(window.location.href));
    })();
  </script>
  <!-- END TEMPORARY PASSWORD GATE -->
</head>
<body data-page={section} data-path={rawPathname} data-v4="true">

  <V4Masthead section={section} />

  {/* Measure the masthead height and publish it as --masthead-h on
      <html> so .breadcrumbs (and any other element that wants to pin
      itself just under the masthead) can sticky-position itself
      precisely on every viewport. ResizeObserver handles the mobile
      utility-row collapse and the responsive nav height changes. */}
  <script is:inline>
    (function () {
      function setMastheadH() {
        var m = document.querySelector('.masthead');
        if (!m) return;
        var h = Math.round(m.getBoundingClientRect().height);
        document.documentElement.style.setProperty('--masthead-h', h + 'px');
      }
      setMastheadH();
      if ('ResizeObserver' in window) {
        var m = document.querySelector('.masthead');
        if (m) new ResizeObserver(setMastheadH).observe(m);
      } else {
        window.addEventListener('resize', setMastheadH);
      }
      // Re-measure after page transitions (Astro view-transitions).
      document.addEventListener('astro:page-load', setMastheadH);
    })();
  </script>

  {/* data-pagefind-body scopes the index to <main>, so the masthead, footer,
      concierge drawer, and search overlay aren't indexed.
      data-pagefind-filter populates the "kind" facet on /search.
      data-pagefind-meta makes the same value available on each result card
      so the UI can render the type eyebrow without a second lookup.
      data-pagefind-ignore opts the page out of the search index entirely. */}
  <main
    data-pagefind-body={searchExclude ? undefined : ''}
    data-pagefind-filter={searchExclude ? undefined : `kind:${resolvedSearchKind}`}
    data-pagefind-meta={searchExclude ? undefined : `kind:${resolvedSearchKind}`}
    data-pagefind-ignore={searchExclude ? '' : undefined}
  >
    {/* Pagefind search-result image source. Mirrors the page's ogImage
        (which every page already sets for social sharing) into the search
        index as `meta.image`. Without this, Pagefind tries to auto-detect
        an image from the first <img> tag in the body — which fails for
        most page types here because heroes use CSS background-image, not
        real img elements. Single source of truth: ogImage.

        IMPORTANT: no `hidden` attribute. Pagefind treats `hidden` and
        display:none elements as invisible and skips them during indexing,
        which means `data-pagefind-meta` attributes on hidden elements are
        ignored. Empty <span> has zero visual impact regardless. */}
    {!searchExclude && ogImage && (
      <span data-pagefind-meta={`image:${ogImageAbsolute}`}></span>
    )}
    <slot />
  </main>

  <Footer />

  <!-- V4 mobile drawer — replaces the V2 #mobileNav overlay.
       Bound by the V4 mega+drawer script below. -->
  <V4MobileDrawer />

  <!-- V2 auth phase 1, modal + profile dropdown.
       Modal hidden until any [data-open-auth] element triggers it.
       Dropdown auto-mounts into the masthead utility row when signed in. -->
  <ProfileDropdown />
  <AuthModal />

  <!-- Set API URL BEFORE the drawer renders, its boot script reads
       window.PI_API_URL at parse time, so this must come first. -->
  <script is:inline define:vars={{ API_URL: import.meta.env.PUBLIC_CONCIERGE_API_URL || 'http://localhost:8787' }}>
    window.PI_API_URL = API_URL;
  </script>

  <!-- Supabase config for browser-side analytics (search query logging etc).
       Anon key is safe to expose — RLS ensures anon can only INSERT, not read. -->
  <script is:inline define:vars={{ SB_URL: import.meta.env.PUBLIC_SUPABASE_URL || 'https://tjjhpvslpysfklwpqmgz.supabase.co', SB_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '' }}>
    window.__PI_SB = { url: SB_URL, key: SB_ANON_KEY };
  </script>

  <!-- PI concierge drawer, slides in from the right edge.
       Suppressed on /ask itself (which is the full-page version). -->
  {!isAskPage && <ConciergeDrawer />}

  <!-- Site search overlay — instant Pagefind dropdown, opened by any
       [data-open-search] trigger or the `/` keyboard shortcut. -->
  <SearchOverlay />

  <!-- Cookie consent banner. Shows on first visit only; gates the
       gtag.js loader above via the 'pi:consent-changed' event. -->
  <CookieBanner />

  <!-- Save / share-list controller (Phase 2 WS2E). Site-wide; binds save
       buttons on every page, owns localStorage, exposes window.PISave. -->
  <SaveSiteController />

  <!-- Cross-device sync (Phase 3 WS3E). Bridges localStorage to Supabase
       when the user is signed in. No-ops when auth isn't configured. -->
  <CloudSync />

  <!-- Inline editor mount. Boots a tiny client bundle that detects an admin
       session and lights up [data-pi-edit] elements for click-to-edit text
       and right-click-to-replace images. Inert for non-admin visitors. -->
  <InlineEditor />

  <!-- Image slot hydration — reads all published cms_image_slots from Supabase
       and swaps matching <img> src values on every page load. Covers every page
       so right-click image edits on any page (events, places, venues, home) are
       visible immediately on next load without waiting for a rebuild.
       Non-fatal: if Supabase is unreachable the static images remain. -->
  <script is:inline define:vars={{ __SB_URL: import.meta.env.PUBLIC_SUPABASE_URL || 'https://tjjhpvslpysfklwpqmgz.supabase.co', __SB_ANON: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '' }}>
    (function () {
      if (!__SB_URL || !__SB_ANON) return;
      function applySlots() {
        var url = new URL('/rest/v1/cms_image_slots', __SB_URL);
        url.searchParams.set('select', 'entity_type,entity_slug,field_path,public_url');
        url.searchParams.set('status', 'eq.published');
        fetch(url.toString(), {
          headers: {
            apikey: __SB_ANON,
            Authorization: 'Bearer ' + __SB_ANON,
            'Accept-Profile': 'pi',
          },
        }).then(function (res) {
          if (!res.ok) return;
          return res.json();
        }).then(function (slots) {
          if (!Array.isArray(slots)) return;
          slots.forEach(function (slot) {
            if (!slot.public_url) return;
            var el = document.querySelector(
              '[data-pi-entity-type="' + slot.entity_type + '"][data-pi-entity-slug="' + slot.entity_slug + '"][data-pi-field-path="' + slot.field_path + '"]'
            );
            if (!el) return;
            if (el instanceof HTMLImageElement) {
              el.src = slot.public_url;
            } else {
              // Background-image element (div, a, figure, etc.)
              el.style.backgroundImage = 'url("' + slot.public_url.replace(/"/g, '\\"') + '")';
            }
          });
        }).catch(function () { /* non-fatal */ });
      }
      // Run on initial load and on Astro view-transition page loads.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applySlots, { once: true });
      } else {
        applySlots();
      }
      document.addEventListener('astro:page-load', applySlots);
    })();
  </script>

  <script is:inline>
    (function () {
      function killMobileHeaderAskPill() {
        if (!window.matchMedia('(max-width: 1024px)').matches) return;
        document.querySelectorAll('.v4-mobile-actions .v4-ask-pill, .v4-actions .v4-ask-pill').forEach(function (el) {
          el.remove();
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', killMobileHeaderAskPill, { once: true });
      } else {
        killMobileHeaderAskPill();
      }
      document.addEventListener('astro:page-load', killMobileHeaderAskPill);
    })();
  </script>

  <!-- Sticky Subscribe pill, fades in once the reader passes the 50%
       scroll mark. Mobile-only. Hidden on /newsletter, /ask, /account
       via CSS rules keyed on body[data-path]. Bottom-LEFT so it sits
       opposite the concierge FAB (bottom-right) and they don't collide. -->
  <a href="/dispatch/" class="subscribe-pill" aria-label="Join the Peninsula Dispatch">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
      <polyline points="22,6 12,13 2,6"/>
    </svg>
    <span class="subscribe-pill__label">Join</span>
  </a>

  <script is:inline>
    (function () {
      function initSubscribePill() {
        var body = document.body;
        if (body._subPillBound) return;
        body._subPillBound = true;
        var threshold = 0.5; // 50% of scrollable page
        var rafId = null;
        function check() {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          if (max <= 0) {
            body.classList.remove('show-subscribe-pill');
            return;
          }
          var pct = window.scrollY / max;
          body.classList.toggle('show-subscribe-pill', pct >= threshold);
        }
        window.addEventListener('scroll', function () {
          if (rafId) return;
          rafId = requestAnimationFrame(function () { check(); rafId = null; });
        }, { passive: true });
        check();
      }
      initSubscribePill();
      document.addEventListener('astro:page-load', function () {
        document.body._subPillBound = false;
        initSubscribePill();
      });
    })();
  </script>

  <!-- V4 mega-menu + mobile drawer behaviour.
       Replaces V2's #mobileNav burger script. Three responsibilities:
       1. Hover/focus open + leave/escape/click-outside close on desktop pillars.
       2. Burger opens the V4 drawer; accordion pillars expand inline.
       3. data-pi-trigger="true" intercepts clicks and opens the concierge
          drawer via window.openConcierge() (was previously inside V2 Masthead). -->
  <script is:inline>
    (function () {
      function initV4Mega() {
        var items = document.querySelectorAll('[data-v4-pillar]');
        if (!items.length) return;

        function closeAll(except) {
          items.forEach(function (n) {
            if (n === except) return;
            n.classList.remove('is-open');
            var trig = n.querySelector('[data-v4-pillar-link]');
            if (trig) trig.setAttribute('aria-expanded', 'false');
          });
        }

        items.forEach(function (item) {
          if (item._v4Bound) return;
          item._v4Bound = true;
          var link = item.querySelector('[data-v4-pillar-link]');
          var openTimer = null, closeTimer = null;

          function open() {
            clearTimeout(closeTimer);
            openTimer = setTimeout(function () {
              closeAll(item);
              item.classList.add('is-open');
              if (link) link.setAttribute('aria-expanded', 'true');
            }, 70);
          }
          function close() {
            clearTimeout(openTimer);
            closeTimer = setTimeout(function () {
              item.classList.remove('is-open');
              if (link) link.setAttribute('aria-expanded', 'false');
            }, 220);
          }

          item.addEventListener('mouseenter', open);
          item.addEventListener('mouseleave', close);
          if (link) {
            link.addEventListener('focus', open);
            link.addEventListener('keydown', function (e) {
              if (e.key === 'Escape') {
                item.classList.remove('is-open');
                link.setAttribute('aria-expanded', 'false');
                link.focus();
              }
            });
          }
          var panel = item.querySelector('[data-v4-mega]');
          if (panel) {
            panel.addEventListener('keydown', function (e) {
              if (e.key === 'Escape') {
                item.classList.remove('is-open');
                if (link) {
                  link.setAttribute('aria-expanded', 'false');
                  link.focus();
                }
              }
            });
          }
        });

        document.addEventListener('click', function (e) {
          var target = e.target;
          var inside = target.closest && target.closest('[data-v4-pillar]');
          if (!inside) closeAll(null);
        });
      }

      function initV4Drawer() {
        var burger = document.querySelector('.v4-burger');
        var drawer = document.getElementById('v4Drawer');
        if (!burger || !drawer) return;
        if (burger._v4DrawerBound) return;
        burger._v4DrawerBound = true;

        var closeBtn = drawer.querySelector('[data-v4-drawer-close]');
        var pillarTriggers = drawer.querySelectorAll('[data-v4-drawer-pillar]');

        function openDrawer() {
          drawer.classList.add('is-open');
          burger.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }
        function closeDrawer() {
          drawer.classList.remove('is-open');
          burger.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          drawer.querySelectorAll('.v4-drawer__pillar.is-expanded').forEach(function (p) {
            p.classList.remove('is-expanded');
            var t = p.querySelector('[data-v4-drawer-pillar]');
            if (t) t.setAttribute('aria-expanded', 'false');
          });
        }

        burger.addEventListener('click', function () {
          var isOpen = drawer.classList.contains('is-open');
          if (isOpen) closeDrawer(); else openDrawer();
        });
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
        });

        pillarTriggers.forEach(function (trig) {
          trig.addEventListener('click', function () {
            var pillar = trig.closest('.v4-drawer__pillar');
            if (!pillar) return;
            var isExpanded = pillar.classList.contains('is-expanded');
            drawer.querySelectorAll('.v4-drawer__pillar.is-expanded').forEach(function (p) {
              if (p !== pillar) {
                p.classList.remove('is-expanded');
                var t = p.querySelector('[data-v4-drawer-pillar]');
                if (t) t.setAttribute('aria-expanded', 'false');
              }
            });
            pillar.classList.toggle('is-expanded', !isExpanded);
            trig.setAttribute('aria-expanded', String(!isExpanded));
          });
        });

        drawer.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', closeDrawer);
        });
      }

      function initPiTriggers() {
        document.querySelectorAll('[data-pi-trigger="true"]').forEach(function (el) {
          if (el._piTrigBound) return;
          el._piTrigBound = true;
          el.addEventListener('click', function (e) {
            if (typeof window.openConcierge !== 'function') return;
            e.preventDefault();
            window.openConcierge();
          });
        });
      }

      function bootAll() {
        initV4Mega();
        initV4Drawer();
        initPiTriggers();
      }

      bootAll();
      document.addEventListener('astro:page-load', bootAll);
    })();
  </script>

  <!-- Copy-link share button -->
  <script is:inline>
    (function () {
      function initShareBtn() {
        var btn = document.getElementById('copyLink');
        if (!btn || btn._shareBound) return;
        btn._shareBound = true;
        btn.addEventListener('click', function () {
          var url = window.location.href;
          (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject())
            .catch(function () {
              var ta = document.createElement('textarea');
              ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
              document.body.appendChild(ta); ta.select();
              document.execCommand('copy'); document.body.removeChild(ta);
            })
            .then(function () {
              var label = btn.querySelector('.article__share-btn-label');
              btn.classList.add('is-copied');
              if (label) label.textContent = 'Copied!';
              setTimeout(function () {
                btn.classList.remove('is-copied');
                if (label) label.textContent = 'Copy link';
              }, 2200);
            });
        });
      }
      initShareBtn();
      document.addEventListener('astro:page-load', initShareBtn);
    })();
  </script>

  <!-- Enhancement JS -->
  <script is:inline src="/assets/subscribe-form.js"></script>
  <script is:inline src="/assets/scroll-animations.js"></script>

  {/* Lenis smooth scroll. Bundled by Vite (no is:inline), runs once on first
      load. Honours prefers-reduced-motion: when set we skip Lenis entirely
      and let the browser scroll natively, which preserves accessibility.
      Disabled inside elements with data-lenis-prevent so the concierge
      drawer, search overlay, and mobile nav handle their own scrolling. */}
  <script>
    import Lenis from 'lenis';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Touch devices keep native scroll. Lenis wraps html with `overflow: clip`
    // which on iOS interferes with pull-to-refresh, scroll-position restore on
    // back-nav, and the address-bar hide/show transition. We use a coarse
    // pointer + touch check rather than UA sniffing so it works correctly for
    // hybrid devices and survives future iPad/Android changes.
    const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    if (!reducedMotion && !isTouch && !(window as any)._piLenis) {
      const lenis = new Lenis({
        duration: 1.05,                         // gentle, not slidey
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        lerp: 0.1,
      });
      (window as any)._piLenis = lenis;

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Stop Lenis from fighting native scroll inside overlays/drawers.
      document.addEventListener('pi:lenis-stop', () => lenis.stop());
      document.addEventListener('pi:lenis-start', () => lenis.start());
    }
  </script>

</body>
</html>


