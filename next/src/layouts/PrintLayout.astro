---
/**
 * PrintLayout  -  Peninsula Insider
 *
 * Print canvas for /partners/founders-prospectus/ and /partners/advertising-kit/.
 * Each .pi-page wraps one A4 sheet. Headless Chrome renders to PDF
 * (see scripts/render-pdfs.mjs).
 *
 * Treatment: editorial cahier. Cormorant Garamond display, Outfit text,
 * roman folios, hairline rules, restrained colour, photography-led.
 */

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Peninsula Insider partnership document.' } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Outfit:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style is:global>
    /* ============================================================
       PEN INSULA INSIDER — PRINT LAYOUT
       Editorial cahier. Print-first.
    ============================================================ */
    :root {
      --pi-bg:        #F5F1EB; /* warm cream / parchment */
      --pi-bg-alt:    #EBE6DD; /* sand */
      --pi-bg-tint:   #ECE4D6; /* deeper sand */
      --pi-bg-deep:   #1E1B18; /* ink */
      --pi-text:      #2B2520; /* charcoal */
      --pi-text-2:    #4A413B; /* mid charcoal */
      --pi-soft:      #7A726A; /* stone soft */
      --pi-soft-2:    #9C938A; /* stone softer */
      --pi-accent:    #8B4E3B; /* pinot / oxblood */
      --pi-accent-d:  #6D3A2B; /* deeper oxblood */
      --pi-gold:      #B69A6B; /* aged gold */
      --pi-gold-d:    #8E763E; /* deeper gold */
      --pi-sage:      #7A8B6D; /* eucalyptus */
      --pi-sage-d:    #5C6E50; /* deeper sage */
      --pi-border:    #D8D1C7; /* stone border */
      --pi-border-2:  #C2BAAE; /* heavier border */
      --pi-white:     #FDFCFA;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: var(--pi-bg); color: var(--pi-text); }

    body {
      font-family: 'Outfit', system-ui, -apple-system, sans-serif;
      font-size: 10.5pt;
      line-height: 1.55;
      letter-spacing: 0.005em;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-feature-settings: "kern" 1, "liga" 1, "onum" 1;
    }

    h1, h2, h3, h4, .pi-display, .pi-serif {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      letter-spacing: -0.005em;
      color: var(--pi-text);
      font-feature-settings: "kern" 1, "liga" 1, "dlig" 1, "onum" 0, "lnum" 1;
    }

    em { font-style: italic; }
    strong { font-weight: 600; }
    a { color: inherit; text-decoration: none; }

    ::selection { background: var(--pi-gold); color: var(--pi-bg-deep); }

    /* ============================================================
       PAGE STRUCTURE
    ============================================================ */
    @page {
      size: A4;
      margin: 0;
    }

    .pi-page {
      width: 210mm;
      height: 297mm;
      padding: 22mm 22mm 18mm;
      background: var(--pi-bg);
      page-break-after: always;
      break-after: page;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .pi-page:last-child { page-break-after: auto; break-after: auto; }

    .pi-page--sand    { background: var(--pi-bg-alt); }
    .pi-page--sand-2  { background: var(--pi-bg-tint); }
    .pi-page--ink     { background: var(--pi-bg-deep); color: var(--pi-bg); }
    .pi-page--ink h1, .pi-page--ink h2, .pi-page--ink h3 { color: var(--pi-bg); }
    .pi-page--ink .pi-eyebrow { color: var(--pi-gold); }
    .pi-page--ink .pi-rule    { border-color: rgba(245, 241, 235, 0.18); }
    .pi-page--ink .pi-running-head,
    .pi-page--ink .pi-running-foot { color: var(--pi-soft-2); border-color: rgba(245, 241, 235, 0.18); }
    .pi-page--ink .pi-running-head__brand { color: var(--pi-bg); }
    .pi-page--ink .pi-running-foot__url   { color: var(--pi-gold); }

    /* Cover full bleed */
    .pi-page--cover {
      padding: 0;
      background: var(--pi-bg-deep);
      color: var(--pi-bg);
    }

    .pi-page__inner {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    /* ============================================================
       COVER PRIMITIVES
    ============================================================ */
    .pi-cover {
      position: relative;
      width: 100%;
      height: 100%;
      color: var(--pi-bg);
      overflow: hidden;
    }
    .pi-cover__image {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: saturate(0.92);
    }
    .pi-cover__overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg,
          rgba(30, 27, 24, 0.55) 0%,
          rgba(30, 27, 24, 0.30) 28%,
          rgba(30, 27, 24, 0.20) 55%,
          rgba(30, 27, 24, 0.65) 100%);
    }
    .pi-cover__grain {
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(rgba(245, 241, 235, 0.04) 1px, transparent 1px),
        radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px);
      background-size: 3px 3px, 5px 5px;
      background-position: 0 0, 1px 1px;
      mix-blend-mode: overlay;
      opacity: 0.55;
    }
    .pi-cover__inner {
      position: relative;
      width: 100%;
      height: 100%;
      padding: 22mm 22mm 18mm;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 1;
    }
    .pi-cover__topbar,
    .pi-cover__bottombar {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(245, 241, 235, 0.78);
    }
    .pi-cover__topbar { align-items: flex-start; }
    .pi-cover__brand {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-weight: 500;
      font-size: 11pt;
      letter-spacing: 0.06em;
      text-transform: none;
      color: var(--pi-bg);
    }
    .pi-cover__brand strong {
      font-weight: 600;
      letter-spacing: 0.005em;
    }

    .pi-cover__title-block {
      max-width: 150mm;
    }
    .pi-cover__rule {
      width: 12mm;
      height: 1pt;
      background: var(--pi-gold);
      margin-bottom: 6mm;
    }
    .pi-cover__eyebrow {
      font-family: 'Outfit', sans-serif;
      font-size: 9pt;
      font-weight: 500;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--pi-gold);
      margin-bottom: 6mm;
    }
    .pi-cover__title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 78pt;
      line-height: 0.92;
      letter-spacing: -0.022em;
      color: var(--pi-bg);
      margin-bottom: 8mm;
    }
    .pi-cover__title em {
      font-style: italic;
      font-weight: 400;
      color: var(--pi-bg);
    }
    .pi-cover__sub {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 16pt;
      line-height: 1.35;
      letter-spacing: 0.005em;
      color: rgba(245, 241, 235, 0.92);
      max-width: 130mm;
    }

    /* ============================================================
       RUNNING ELEMENTS (HEAD + FOOT)
    ============================================================ */
    .pi-running-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
      padding-bottom: 7mm;
      border-bottom: 0.5pt solid var(--pi-border);
      margin-bottom: 11mm;
    }
    .pi-running-head__brand {
      color: var(--pi-text);
      font-weight: 600;
      letter-spacing: 0.18em;
    }
    .pi-running-head__brand em {
      font-style: italic;
      font-weight: 400;
      letter-spacing: 0.04em;
    }
    .pi-running-head__title {
      letter-spacing: 0.18em;
    }
    .pi-running-head__title-numeral {
      color: var(--pi-accent);
      margin-right: 0.5em;
      font-weight: 600;
    }

    .pi-running-foot {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      font-family: 'Outfit', sans-serif;
      font-size: 7pt;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
      padding-top: 5mm;
      border-top: 0.5pt solid var(--pi-border);
      margin-top: auto;
    }
    .pi-running-foot__url { color: var(--pi-accent); letter-spacing: 0.08em; text-transform: lowercase; font-style: italic; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 9pt; }
    .pi-running-foot__pageno {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.18em;
      font-weight: 500;
    }

    /* ============================================================
       CHAPTER OPENING (eyebrow + roman numeral + title)
    ============================================================ */
    .pi-chapter {
      display: grid;
      grid-template-columns: 22mm 1fr;
      gap: 8mm;
      align-items: baseline;
      margin-bottom: 11mm;
    }
    .pi-chapter__numeral {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      font-style: italic;
      font-size: 38pt;
      line-height: 0.85;
      color: var(--pi-accent);
      letter-spacing: 0;
      text-align: right;
    }
    .pi-chapter__body { min-width: 0; }
    .pi-chapter__eyebrow {
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--pi-soft);
      margin-bottom: 4mm;
    }
    .pi-chapter__title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 36pt;
      line-height: 1.02;
      letter-spacing: -0.015em;
      color: var(--pi-text);
    }
    .pi-chapter__title em { font-style: italic; font-weight: 400; }

    /* ============================================================
       TYPOGRAPHY HELPERS
    ============================================================ */
    .pi-eyebrow {
      font-family: 'Outfit', sans-serif;
      font-size: 8pt;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-accent);
    }
    .pi-eyebrow--soft { color: var(--pi-soft); }
    .pi-eyebrow--sage { color: var(--pi-sage-d); }
    .pi-eyebrow--gold { color: var(--pi-gold-d); }

    .pi-display-xl {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 64pt;
      line-height: 0.95;
      letter-spacing: -0.02em;
    }
    .pi-display-l {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 38pt;
      line-height: 1.04;
      letter-spacing: -0.015em;
    }
    .pi-display-m {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 26pt;
      line-height: 1.1;
      letter-spacing: -0.01em;
    }
    .pi-display-s {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 18pt;
      line-height: 1.2;
    }
    .pi-display-xs {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 14pt;
      line-height: 1.25;
    }

    .pi-dek {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-weight: 400;
      font-size: 14pt;
      line-height: 1.45;
      color: var(--pi-soft);
    }

    .pi-prose p {
      font-size: 10.5pt;
      line-height: 1.65;
      margin: 0 0 0.7em;
      max-width: 165mm;
    }
    .pi-prose p:last-child { margin-bottom: 0; }
    .pi-prose strong { font-weight: 600; color: var(--pi-text); }
    .pi-prose--narrow p { max-width: 130mm; }
    .pi-prose--ink p { color: var(--pi-bg); }
    .pi-prose--ink strong { color: var(--pi-bg); }

    .pi-lede {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 14pt;
      line-height: 1.45;
      color: var(--pi-text);
      max-width: 160mm;
    }
    .pi-lede--ink { color: rgba(245, 241, 235, 0.92); }

    /* Drop cap (used on the invitation page only) */
    .pi-prose--dropcap > p:first-of-type::first-letter {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      float: left;
      font-size: 56pt;
      line-height: 0.85;
      padding: 3mm 3mm 0 0;
      color: var(--pi-accent);
    }

    .pi-pullquote {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-weight: 500;
      font-size: 22pt;
      line-height: 1.2;
      color: var(--pi-text);
      border-left: 1pt solid var(--pi-accent);
      padding-left: 10mm;
      max-width: 150mm;
    }
    .pi-pullquote--center {
      border-left: none;
      text-align: center;
      padding: 0;
      font-size: 26pt;
      line-height: 1.18;
      max-width: 160mm;
      margin: 0 auto;
    }
    .pi-pullquote__cite {
      display: block;
      font-family: 'Outfit', sans-serif;
      font-style: normal;
      font-size: 8pt;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
      margin-top: 5mm;
    }

    .pi-rule {
      border: none;
      border-top: 0.5pt solid var(--pi-border);
      margin: 6mm 0;
    }
    .pi-rule--accent {
      border-top: 1pt solid var(--pi-accent);
      width: 14mm;
      margin: 0 0 5mm;
    }
    .pi-rule--gold {
      border-top: 1pt solid var(--pi-gold);
      width: 14mm;
      margin: 0 0 5mm;
    }
    .pi-rule--center {
      width: 30mm;
      margin: 0 auto;
    }

    /* ============================================================
       LAYOUT HELPERS
    ============================================================ */
    .pi-stack > * + * { margin-top: 6mm; }
    .pi-stack-tight > * + * { margin-top: 3mm; }
    .pi-stack-loose > * + * { margin-top: 12mm; }

    .pi-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10mm;
    }
    .pi-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8mm;
    }
    .pi-grid-aside {
      display: grid;
      grid-template-columns: 1fr 0.7fr;
      gap: 14mm;
      align-items: start;
    }
    .pi-grid-aside--left {
      grid-template-columns: 0.7fr 1fr;
    }
    .pi-grid-12 {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 4mm;
    }
    .pi-grid-fill {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
    }

    .pi-col-span-7 { grid-column: span 7; }
    .pi-col-span-5 { grid-column: span 5; }
    .pi-col-span-6 { grid-column: span 6; }
    .pi-col-span-8 { grid-column: span 8; }
    .pi-col-span-4 { grid-column: span 4; }
    .pi-col-start-2 { grid-column-start: 2; }
    .pi-col-start-3 { grid-column-start: 3; }

    /* ============================================================
       FIGURES & PHOTOGRAPHY
    ============================================================ */
    .pi-figure {
      width: 100%;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
    .pi-figure--cap-3-2 { aspect-ratio: 3 / 2; }
    .pi-figure--cap-4-3 { aspect-ratio: 4 / 3; }
    .pi-figure--cap-1-1 { aspect-ratio: 1 / 1; }
    .pi-figure--tall    { aspect-ratio: 3 / 4; }
    .pi-figure--wide    { aspect-ratio: 16 / 9; }
    .pi-figure--bleed-h { width: calc(100% + 44mm); margin-left: -22mm; }

    .pi-figure-frame {
      position: relative;
    }
    .pi-figure-caption {
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--pi-soft);
      margin-top: 2mm;
    }

    /* ============================================================
       NAMED BLOCKS (cards / panels / claims)
    ============================================================ */
    .pi-claim {
      padding-top: 6mm;
      border-top: 1pt solid var(--pi-text);
    }
    .pi-claim__head {
      display: flex;
      align-items: baseline;
      gap: 6mm;
      margin-bottom: 4mm;
    }
    .pi-claim__no {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 22pt;
      line-height: 1;
      color: var(--pi-accent);
      flex-shrink: 0;
    }
    .pi-claim__title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 17pt;
      line-height: 1.15;
      letter-spacing: -0.005em;
      color: var(--pi-text);
    }
    .pi-claim__body {
      font-size: 10pt;
      line-height: 1.6;
      color: var(--pi-text-2);
      max-width: 145mm;
    }

    .pi-tier {
      padding: 7mm 7mm 8mm;
      border: 0.5pt solid var(--pi-border);
      background: var(--pi-white);
      display: flex;
      flex-direction: column;
      gap: 3mm;
      min-height: 60mm;
    }
    .pi-tier--featured {
      border: 1pt solid var(--pi-accent);
      background: var(--pi-bg-tint);
    }
    .pi-tier__eyebrow {
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-sage-d);
    }
    .pi-tier__title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 22pt;
      line-height: 1.05;
      color: var(--pi-text);
    }
    .pi-tier__body {
      font-size: 9.5pt;
      line-height: 1.55;
      color: var(--pi-text-2);
      flex: 1;
    }
    .pi-tier__price {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 12pt;
      color: var(--pi-accent);
      padding-top: 4mm;
      border-top: 0.5pt solid var(--pi-border);
    }

    /* The big confident price treatment */
    .pi-price {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12mm;
      align-items: end;
      padding: 10mm 0 8mm;
      border-top: 1pt solid var(--pi-text);
      border-bottom: 0.5pt solid var(--pi-border);
    }
    .pi-price__amount {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 78pt;
      line-height: 0.9;
      letter-spacing: -0.025em;
      color: var(--pi-text);
      font-feature-settings: "lnum" 1, "tnum" 0;
    }
    .pi-price__amount em {
      font-style: italic;
      font-weight: 400;
      color: var(--pi-accent);
    }
    .pi-price__caption {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 13pt;
      line-height: 1.4;
      color: var(--pi-soft);
      max-width: 70mm;
    }

    .pi-stat {
      display: flex;
      flex-direction: column;
      gap: 1mm;
      padding: 4mm 0 5mm;
      border-top: 0.5pt solid var(--pi-border);
    }
    .pi-stat__value {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 26pt;
      line-height: 1;
      color: var(--pi-text);
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    .pi-stat__value em {
      font-style: italic;
      font-weight: 400;
    }
    .pi-stat__label {
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
      margin-top: 1mm;
    }

    /* ============================================================
       TABLES
    ============================================================ */
    .pi-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9.5pt;
    }
    .pi-table th, .pi-table td {
      text-align: left;
      padding: 3.5mm 4mm 3.5mm 0;
      border-bottom: 0.5pt solid var(--pi-border);
      vertical-align: top;
    }
    .pi-table th {
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
      border-bottom: 1pt solid var(--pi-text);
      padding-bottom: 4mm;
    }
    .pi-table td.pi-table__price {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      color: var(--pi-accent);
      white-space: nowrap;
      font-size: 11pt;
    }
    .pi-table td:last-child { padding-right: 0; }
    .pi-table th:last-child { padding-right: 0; }
    .pi-table tr:last-child td { border-bottom: none; }

    /* Sequence / timeline table */
    .pi-sequence {
      list-style: none;
      padding: 0;
      margin: 0;
      counter-reset: sequence;
    }
    .pi-sequence__item {
      display: grid;
      grid-template-columns: 14mm 1fr;
      gap: 6mm;
      padding: 5mm 0;
      border-top: 0.5pt solid var(--pi-border);
      counter-increment: sequence;
    }
    .pi-sequence__item:last-child { border-bottom: 0.5pt solid var(--pi-border); }
    .pi-sequence__no {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 18pt;
      line-height: 1;
      color: var(--pi-accent);
    }
    .pi-sequence__no::before {
      content: counter(sequence, decimal-leading-zero) ".";
    }
    .pi-sequence__step {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 13pt;
      line-height: 1.3;
      color: var(--pi-text);
      margin-bottom: 1mm;
    }
    .pi-sequence__when {
      font-family: 'Outfit', sans-serif;
      font-size: 8pt;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--pi-soft);
    }

    /* ============================================================
       LISTS
    ============================================================ */
    .pi-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .pi-list li {
      position: relative;
      padding-left: 8mm;
      margin-bottom: 4mm;
      font-size: 10pt;
      line-height: 1.55;
      color: var(--pi-text-2);
    }
    .pi-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 1.9mm;
      width: 5mm;
      height: 0.5pt;
      background: var(--pi-accent);
    }
    .pi-list li:last-child { margin-bottom: 0; }
    .pi-list li strong { color: var(--pi-text); font-weight: 600; }

    .pi-list--numbered { counter-reset: pi-num; }
    .pi-list--numbered li {
      padding-left: 12mm;
      counter-increment: pi-num;
    }
    .pi-list--numbered li::before {
      content: counter(pi-num, decimal-leading-zero);
      background: transparent;
      width: auto;
      height: auto;
      top: 0;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 12pt;
      color: var(--pi-accent);
    }

    /* Cohort seat list */
    .pi-cohort {
      list-style: none;
      padding: 0;
      margin: 0;
      counter-reset: cohort;
    }
    .pi-cohort li {
      display: grid;
      grid-template-columns: 14mm 1fr;
      gap: 6mm;
      align-items: baseline;
      padding: 2.5mm 0;
      border-top: 0.5pt solid var(--pi-border);
      counter-increment: cohort;
    }
    .pi-cohort__seat {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 13pt;
      line-height: 1.25;
      color: var(--pi-text);
    }
    .pi-cohort__seat em {
      font-style: italic;
      color: var(--pi-soft);
      font-size: 10pt;
      display: block;
      margin-top: 0.5mm;
    }
    .pi-cohort li:last-child { border-bottom: 0.5pt solid var(--pi-border); }
    .pi-cohort li::before {
      content: "Seat " counter(cohort);
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
      padding-top: 2mm;
    }

    .pi-keyvalue {
      display: grid;
      grid-template-columns: 38mm 1fr;
      gap: 4mm 6mm;
      padding-top: 4mm;
      border-top: 0.5pt solid var(--pi-border);
    }
    .pi-keyvalue dt {
      font-family: 'Outfit', sans-serif;
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
      padding-top: 1mm;
    }
    .pi-keyvalue dd {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 12pt;
      line-height: 1.35;
      color: var(--pi-text);
    }

    /* ============================================================
       LETTER (used on the invitation page)
    ============================================================ */
    .pi-letter {
      max-width: 138mm;
      margin: 0 auto;
    }
    .pi-letter__opening {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 16pt;
      line-height: 1.45;
      color: var(--pi-text);
      margin-bottom: 7mm;
    }
    .pi-letter p {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 13.5pt;
      line-height: 1.55;
      color: var(--pi-text);
      margin-bottom: 5mm;
      font-feature-settings: "kern" 1, "liga" 1;
    }
    .pi-letter__signoff {
      margin-top: 12mm;
      padding-top: 8mm;
      border-top: 0.5pt solid var(--pi-border);
    }
    .pi-letter__sig {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-weight: 500;
      font-size: 18pt;
      line-height: 1.2;
      color: var(--pi-text);
      letter-spacing: 0.005em;
      margin-bottom: 4mm;
    }
    .pi-letter__role {
      font-family: 'Outfit', sans-serif;
      font-size: 8pt;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pi-soft);
    }

    /* ============================================================
       WORDMARK & ORNAMENT
    ============================================================ */
    .pi-mark {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-weight: 500;
      font-size: 13pt;
      letter-spacing: -0.01em;
      color: var(--pi-text);
    }
    .pi-mark__brand {
      display: block;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: normal;
      font-weight: 500;
      font-size: 14pt;
      letter-spacing: 0.04em;
    }
    .pi-mark__brand strong { font-weight: 700; letter-spacing: 0.005em; }

    .pi-signoff {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-style: italic;
      font-size: 12pt;
      color: var(--pi-text);
    }

    .pi-ornament {
      display: block;
      width: 20mm;
      margin: 0 auto;
      color: var(--pi-accent);
    }

    /* ============================================================
       SCREEN-ONLY PREVIEW
    ============================================================ */
    @media screen {
      body {
        padding: 16mm 0;
        background: #1a1815;
      }
      .pi-page {
        margin: 0 auto 10mm;
        box-shadow: 0 4mm 16mm rgba(0, 0, 0, 0.45);
      }
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
