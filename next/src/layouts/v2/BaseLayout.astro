---
/**
 * Peninsula Insider - v2 BaseLayout (staging template)
 *
 * Magazine-editorial redesign. Served at /v2-staging/ on GitHub Pages
 * via build-v2-staging.sh. Production (live root) is untouched.
 *
 * Typography: Newsreader (variable optical sizing) + Inter (body).
 * Tokens + components in public/assets/v2/global.css.
 * Scroll reveals + rotator in public/assets/v2/scroll-animations.js.
 */

import UtilityBar from '../../components/v2/UtilityBar.astro';
import Masthead from '../../components/v2/Masthead.astro';
import Colophon from '../../components/v2/Colophon.astro';

export interface Props {
  title: string;
  description?: string;
  section?: string;
  ogImage?: string;
  issueMark?: string;
  issueLabel?: string;
}

const {
  title,
  description = 'The independent editorial guide to the Mornington Peninsula - honest, opinionated coverage of eating, drinking, staying, and exploring.',
  section = '',
  ogImage = '/images/sourced/home-cover.webp',
  issueMark,
  issueLabel,
} = Astro.props;

// Astro's BASE_URL honours the `base` config (set by ASTRO_BASE env var).
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const ogImagePath = ogImage.startsWith('http')
  ? ogImage
  : `${base}${ogImage.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#201B17" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImagePath} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,300;1,6..72,400;1,6..72,500;1,6..72,600;1,6..72,700&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href={`${base}assets/v2/global.css`} />
</head>
<body>
  <UtilityBar issueMark={issueMark} issueLabel={issueLabel} />
  <Masthead section={section} />

  <main>
    <slot />
  </main>

  <Colophon />

  <script is:inline src={`${base}assets/v2/scroll-animations.js`}></script>
  <script is:inline src={`${base}assets/subscribe-form.js`}></script>
</body>
</html>
