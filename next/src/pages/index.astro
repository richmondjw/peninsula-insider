---
/**
 * Homepage — Editorial magazine cover for the Mornington Peninsula guide.
 *
 * Cover story, a single start panel, then the useful planning surfaces.
 *
 * Promoted from /preview-home-redesign/ on 2026-05-25, replacing the
 * cinematic fullbleed cover that lives in git history.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceCard from '../components/PlaceCard.astro';
import ItineraryCard from '../components/ItineraryCard.astro';
import WeekendPickerBlock from '../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import ThreeMissionBar from '../components/ThreeMissionBar.astro';
import ScrollReveal from '../components/react/ScrollReveal.tsx';
import { routeSlug, dispatchWeekend } from '../lib/editorial';
import { loadPublishedHomepageOverrides } from '../lib/content/homepage';
// ── CMS overrides ─────────────────────────────────────────────────────────
const cmsOverrides = await loadPublishedHomepageOverrides();
const cmsText  = cmsOverrides.textFieldsByPath;
const cmsImage = cmsOverrides.imageSlotsByPath;

// ── Core collections ───────────────────────────────────────────────────────
const articles    = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const places      = await getCollection('places');
const itineraries = await getCollection('itineraries');

// ── Upcoming events for the ThreeMissionBar "This Weekend" panel ───────────
const now = new Date();
const upcomingEvents = (await getCollection('events'))
  .filter((e) => {
    if (e.data.status === 'archived' || e.data.status === 'draft') return false;
    const end = (e.data as any).endDate ?? e.data.startDate;
    return end >= now;
  })
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime())
  .slice(0, 3);

// ── Featured plans ─────────────────────────────────────────────────────────
const featuredPlanSlugs = [
  'ridge-to-sea-two-night-escape',
  'wellness-weekend',
  'sorrento-off-season-weekend',
];
const featuredPlans = featuredPlanSlugs
  .map((s) => itineraries.find((it) => routeSlug(it) === s))
  .filter(Boolean);
const fallbackPlans = itineraries
  .filter((it) => !featuredPlanSlugs.includes(routeSlug(it)))
  .slice(0, 3 - featuredPlans.length);
const planCards = [...featuredPlans, ...fallbackPlans].slice(0, 3);

// ── Below-fold editorial data ──────────────────────────────────────────────
const weekendDispatch = articles
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))[0];

const dispatchWindow = weekendDispatch
  ? dispatchWeekend(weekendDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };

const dispatchHref = weekendDispatch
  ? `/journal/${routeSlug(weekendDispatch)}/`
  : '/whats-on/this-weekend/';

// ── Featured places ────────────────────────────────────────────────────────
const featuredPlaceSlugs = [
  'sorrento', 'red-hill', 'flinders', 'arthurs-seat',
  'rosebud', 'rye', 'portsea', 'blairgowrie', 'merricks', 'main-ridge',
];
const featuredPlaces = featuredPlaceSlugs
  .map((slug) => places.find((p) => routeSlug(p) === slug))
  .filter(Boolean);

const placesLabelRaw = cmsText['places.label'];
const placesLabel = /know the terrain/i.test(placesLabelRaw ?? '')
  ? 'Area guide'
  : placesLabelRaw ?? 'Area guide';
const placesTitleRaw = cmsText['places.title'];
const placesTitle = placesTitleRaw === 'The Peninsula, place by place'
  ? 'Explore the Peninsula'
  : placesTitleRaw ?? 'Explore the Peninsula';

// ── Cover scenes ───────────────────────────────────────────────────────────
const coverImageOverride = cmsImage['cover.image'];

interface Scene {
  id: string;
  label: string;
  hours: string;
  image: string;
  imageAlt: string;
  caption: string;
  headline: string;
  dispatch: string;
  primaryHref: string;
  primaryLabel: string;
}

const scenes: Scene[] = [
  {
    id: 'flinders-weekend',
    label: 'SLOW PENINSULA',
    hours: '7 MIN READ',
    image: '/images/sourced/explore-bushrangers-bay-walk-01.webp',
    imageAlt: 'Bushrangers Bay headland and Bass Strait below Cape Schanck, on the slow southern coast of the Mornington Peninsula',
    caption: 'Bushrangers Bay, south coast',
    headline: 'The <em>other</em> Peninsula weekend.',
    dispatch: 'When Red Hill is booked out and Sorrento feels like a queue, Flinders offers another version of the Peninsula weekend — south of everything, closer to the ocean, and slower on purpose.',
    primaryHref: '/journal/a-flinders-weekend/',
    primaryLabel: 'Read',
  },
  {
    id: 'winter-peninsula-weekend',
    label: 'FEATURE',
    hours: '8 MIN READ',
    image: '/images/sourced/home-cover-cape-schanck-rainbow-01.webp',
    imageAlt: 'Rain squall clearing over Cape Schanck bay in winter, rainbow arcing over mist-softened headland and steel-grey Bass Strait',
    caption: 'Cape Schanck, winter clearing',
    headline: 'A <em>winter</em> Peninsula weekend.',
    dispatch: 'Short days, empty dining rooms, a fire in every cellar door with a hearth, and a coast that looks like a different country in a southerly. The Peninsula in winter is its most underrated season.',
    primaryHref: '/journal/a-winter-peninsula-weekend/',
    primaryLabel: 'Read',
  },
  {
    id: 'late-walks',
    label: 'WALK',
    hours: '7 MIN READ',
    image: '/images/sourced/home-cover-back-beach-horses-01.jpg',
    imageAlt: 'Horses on a Peninsula ocean back beach, Bass Strait in the background',
    caption: 'Back beach, Bass Strait side',
    headline: 'When the light <em>starts improving.</em>',
    dispatch: 'Bushrangers Bay for a full reset. Cape Schanck boardwalk when time is short. Sorrento Back Beach for mood rather than route. The four walks that earn the second drink.',
    primaryHref: '/journal/the-peninsulas-best-late-afternoon-walks/',
    primaryLabel: 'Read',
  },
  {
    id: 'cover',
    label: cmsText['cover.label'] ?? 'FEATURE',
    hours: cmsText['cover.hours'] ?? '9 MIN READ',
    image: coverImageOverride?.src ?? '/images/sourced/category-restaurant-01.webp',
    imageAlt: coverImageOverride?.alt ?? 'Warm, polished restaurant interior with a marble bar, timber stools, and low lighting.',
    caption: coverImageOverride?.caption ?? cmsText['cover.caption'] ?? 'Peninsula dining room',
    headline: cmsText['cover.headline'] ?? 'The Hatted Restaurants of the <em>Peninsula.</em>',
    dispatch: cmsText['cover.dispatch'] ?? 'Four two-hat restaurants. Seven one-hat tables. Barragunda is the debut, Tedesca took Regional Restaurant of the Year, and Laura is still where the long lunch happens. The complete list, with booking realities.',
    primaryHref: cmsText['cover.primaryHref'] ?? '/journal/hatted-restaurants-mornington-peninsula-2025/',
    primaryLabel: cmsText['cover.primaryLabel'] ?? 'Read the cover story',
  },
  {
    id: 'cape-schanck',
    label: 'GUIDE',
    hours: '8 MIN READ',
    image: '/images/sourced/explore-cape-schanck-lighthouse-01.webp',
    imageAlt: 'Cape Schanck lighthouse above the basalt clifftop coastline, Mornington Peninsula National Park',
    caption: 'Cape Schanck, Mornington Peninsula National Park',
    headline: 'The lighthouse at the edge of <em>everything.</em>',
    dispatch: 'The 1859 limestone lighthouse, the boardwalk to Pulpit Rock, and the walk to Bushrangers Bay. The grounds are free from 6am. Here is the full structure of the day.',
    primaryHref: '/journal/cape-schanck-guide/',
    primaryLabel: 'Read the guide',
  },
];

const coverScene = scenes[0];
const latestScenes = scenes.slice(1, 3);

export const prerender = true;
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula — best restaurants, cellar doors, beaches, walks, and places to stay. Every venue visited. Every opinion earned. Updated May 2026."
  section="home"
  canonical="https://peninsulainsider.com.au"
>

  {/* ── ZONE 1: One cover story, no carousel */}
  <section class="cover" aria-label="Cover story">
    <div class="container cover__slide-inner">
      <div class="cover__type">
        <p class="cover__meta">
          <span class="cover__chip">{coverScene.label}</span>
          <span class="cover__dot" aria-hidden="true">·</span>
          <span class="cover__hours">{coverScene.hours}</span>
        </p>
        <a href={coverScene.primaryHref} class="cover__headline-link">
          <h1 class="cover__headline" set:html={coverScene.headline} />
        </a>
        <p class="cover__dispatch">{coverScene.dispatch}</p>
        <a class="cover__primary" href={coverScene.primaryHref}>{coverScene.primaryLabel}</a>

        <div class="cover__latest" aria-label="Latest stories">
          <p class="cover__latest-label">Latest</p>
          <div class="cover__latest-list">
            {latestScenes.map((scene) => (
              <a class="cover__latest-link" href={scene.primaryHref}>
                <span>{scene.label}</span>
                <strong set:html={scene.headline} />
              </a>
            ))}
          </div>
        </div>
      </div>
      <a href={coverScene.primaryHref} class="cover__visual-link" tabindex="-1" aria-hidden="true">
        <figure class="cover__visual">
          <div class="cover__visual-frame">
            <img
              src={coverScene.image}
              alt={coverScene.imageAlt}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          {coverScene.caption && (
            <figcaption class="cover__caption">{coverScene.caption}</figcaption>
          )}
        </figure>
      </a>
    </div>
  </section>

  {/* ── ZONE 2: Start panel */}
  <ThreeMissionBar
    weekendLabel={dispatchWindow.label}
    dispatchHref={dispatchHref}
    events={upcomingEvents}
  />

  {/* ── ZONE 3: Weekend Dispatch ─────────────────────────────────────────── */}
  {weekendDispatch && (
    <ScrollReveal client:visible>
      <WeekendPickerBlock
        dispatch={weekendDispatch}
        weekend={`This weekend · ${dispatchWindow.label}`}
      />
    </ScrollReveal>
  )}

  {/* ── ZONE 4: Places rail ──────────────────────────────────────────────── */}
  {featuredPlaces.length > 0 && (
    <ScrollReveal client:visible>
    <section class="places places--compact">
      <div class="container">
        <div class="places__header">
          <p class="label label--accent places__label">{placesLabel}</p>
          <h2 class="places__title">{placesTitle}</h2>
          <p class="places__sub">{cmsText['places.sub'] ?? 'Start with the Peninsula destinations people search for first — the towns, villages and landmarks that anchor most trips.'}</p>
        </div>
        <div class="places__grid">
          {featuredPlaces.map((place, index) => (
            <PlaceCard
              place={place}
              variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'}
              showDetails={false}
            />
          ))}
        </div>
        <div class="places__footer">
          <a href="/explore/places/" class="venues__link">Explore all places →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 5: Plans grid ───────────────────────────────────────────────── */}
  {planCards.length > 0 && (
    <ScrollReveal client:visible>
    <section class="hp-plans">
      <div class="container">
        <div class="hp-plans__head">
          <p class="label label--accent">{cmsText['plans.label'] ?? 'Plans'}</p>
          <h2 class="hp-plans__title">{cmsText['plans.title'] ?? 'Take the whole weekend.'}</h2>
          <p class="hp-plans__sub">{cmsText['plans.sub'] ?? 'Three edited itineraries, paced around a real anchor stay.'}</p>
          <a class="hp-plans__melbourne" href="/explore/plans/?intent=melbourne-weekend">Coming from Melbourne? Start here.</a>
        </div>
        <div class="hp-plans__grid">
          {planCards.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
        </div>
        <div class="hp-plans__footer">
          <a href="/explore/plans/" class="venues__link">View Plans →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 6: Newsletter ──────────────────────────────────────────────── */}
  <ScrollReveal client:visible>
    <NewsletterBlock />
  </ScrollReveal>


</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════════════════
     Option A typography — applied site-wide.
     Outfit + Cormorant Garamond, fixed across all sizes.
     Cormorant italic stripped below 28px where hairlines disappear.
  ═══════════════════════════════════════════════════════════════════════════ */

  /* 1 ── Body: Outfit stays, but weight and size fixed */
  body {
    font-size: 1rem !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
  }

  /* 2 ── Labels: bump minimum size */
  .label, [class*="__label"], [class*="__chip"],
  [class*="__tag"], [class*="__section"], [class*="__meta"] {
    font-size: max(0.72rem, 11.5px);
  }

  /* 3 ── Headings: Cormorant stays, enforce minimum sizes */
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.8rem); }
  h3 { font-size: clamp(1.25rem, 2.5vw, 1.9rem); }
  h4 { font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 500; }

  /* 4 ── Masthead tagline: strip Cormorant italic at ~15px → plain Outfit */
  .masthead__tagline {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal;
    font-weight: 300;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  /* 5 ── Cover dispatch: strip Cormorant italic → Outfit, clean weight */
  .cover__dispatch {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal !important;
    font-weight: 300;
    font-size: clamp(1rem, 1.3vw, 1.12rem) !important;
    line-height: 1.58;
    color: rgba(23, 20, 19, 0.68);
    letter-spacing: 0.01em;
  }

  /* 6 ── Melbourne strip: strip Cormorant italic → Outfit */
  .melb-strip__text {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal !important;
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    font-weight: 400;
  }

  /* 7 ── Notebook headline: was small Cormorant → Outfit medium */
  .hp-notebook__headline {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-weight: 500;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
  }

  /* ── Cover ──────────────────────────────────────────────────────────────── */
  .cover {
    background: #FFFFFF;
    color: #171413;
    padding: clamp(2.4rem, 5vw, 5rem) 0;
    border-bottom: 1px solid rgba(23, 20, 19, 0.08);
  }
  .cover__slide-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .cover__type { min-width: 0; }
  .cover__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(23, 20, 19, 0.16);
    max-width: 26rem;
  }
  .cover__chip {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.26em; text-transform: uppercase;
    color: #A0541F;
  }
  .cover__date, .cover__hours {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(23, 20, 19, 0.55);
  }
  .cover__dot { color: rgba(23, 20, 19, 0.3); font-size: 0.62rem; }
  .cover__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.8rem, 5.8vw, 5.2rem);
    font-weight: 500; line-height: 0.96;
    letter-spacing: -0.025em; color: #171413;
    margin: 0 0 1.5rem; max-width: 14ch;
  }
  .cover__headline em { font-style: italic; font-weight: 500; color: #A0541F; }
  .cover__dispatch {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    line-height: 1.55; color: rgba(23, 20, 19, 0.75);
    margin: 0 0 1.35rem; max-width: 38ch;
  }
  .cover__primary {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #A0541F;
    text-decoration: none;
    border-bottom: 1px solid rgba(160, 84, 31, 0.35);
    padding-bottom: 0.18rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .cover__primary:hover { color: #171413; border-color: #171413; }
  .cover__latest {
    border-top: 1px solid rgba(23, 20, 19, 0.12);
    padding-top: 1rem;
    max-width: 34rem;
  }
  .cover__latest-label {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.46);
    margin: 0 0 0.85rem;
  }
  .cover__latest-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .cover__latest-link {
    display: block;
    color: #171413;
    text-decoration: none;
  }
  .cover__latest-link span {
    display: block;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #A0541F;
    margin-bottom: 0.3rem;
  }
  .cover__latest-link strong {
    display: block;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(0.92rem, 1.2vw, 1rem);
    font-weight: 500;
    line-height: 1.35;
    color: rgba(23, 20, 19, 0.78);
  }
  .cover__latest-link:hover strong { color: #A0541F; }
  .cover__latest-link em { font-style: normal; color: inherit; }
  /* Headline is the primary click target */
  .cover__headline-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .cover__headline-link:hover .cover__headline { opacity: 0.78; }
  /* Image link — decorative duplicate of headline link */
  .cover__visual-link {
    display: contents;
  }
  .cover__visual-link:hover .cover__visual-frame img { opacity: 0.88; }
  .cover__visual {
    margin: 0; min-width: 0;
    aspect-ratio: 4 / 5;
  }
  .cover__visual-frame {
    overflow: hidden; width: 100%; height: 100%;
    aspect-ratio: 4 / 5;
  }
  .cover__visual-frame img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .cover__caption {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.4);
    margin: 0.6rem 0 0;
  }

  /* Cover entrance animation */
  @keyframes cover-enter {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .cover__meta,
  .cover__headline,
  .cover__dispatch,
  .cover__visual {
    animation: cover-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .cover__visual   { animation-delay: 0.10s; }
  .cover__meta     { animation-delay: 0.18s; }
  .cover__headline { animation-delay: 0.32s; }
  .cover__dispatch { animation-delay: 0.52s; }
  @media (prefers-reduced-motion: reduce) {
    .cover__meta,
    .cover__headline,
    .cover__dispatch,
    .cover__visual { animation: none; }
  }

  /* ── Cover mobile ────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .cover__slide-inner { grid-template-columns: 1fr; gap: 1.75rem; }
    .cover__visual { order: 1; aspect-ratio: 16 / 9; }
    .cover__type   { order: 2; }
    .cover__visual-frame { aspect-ratio: 16 / 9; }
    .cover__headline { font-size: clamp(2.625rem, 11vw, 3.6rem); line-height: 0.98; max-width: none; }
    .cover__dispatch { margin-bottom: 1.5rem; }
    .cover__latest-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .cover__latest { display: none; }
    .cover__primary { margin-bottom: 0; }
  }

  /* ── Shortlist, Plans, Notebook — copied from index.astro ────────────────── */
  @media (max-width: 767px) { .hp-shortlist-wrap { display: none; } }

  .places--compact .place-card__body { padding: 1rem 0 0; }
  .places--compact .place-card__name { margin-bottom: 0; }

  .hp-plans {
    padding: clamp(4rem, 7vw, 6rem) 0;
    background: var(--cream, #F6F1E8);
    border-top: 1px solid rgba(23, 20, 19, 0.06);
    border-bottom: 1px solid rgba(23, 20, 19, 0.06);
  }
  .hp-plans__head { text-align: left; max-width: 48rem; margin: 0 0 clamp(2rem, 4vw, 3rem); }
  .hp-plans__title {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-size: clamp(1.7rem, 3vw, 2.4rem); font-weight: 500;
    letter-spacing: -0.02em; color: var(--ink, #171413);
    margin: 0.5rem 0 0.75rem; line-height: 1.1;
  }
  .hp-plans__sub {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-size: 1.05rem; line-height: 1.55;
    color: var(--ink-soft, #3A3531); margin: 0; max-width: 42rem;
  }
  .hp-plans__melbourne {
    display: inline-flex;
    width: fit-content;
    margin-top: 1rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(139, 78, 59, 0.35);
    padding-bottom: 0.15rem;
  }
  .hp-plans__melbourne:hover { color: var(--text); border-color: var(--text); }
  .hp-plans__grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (max-width: 900px) { .hp-plans__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .hp-plans__grid { grid-template-columns: 1fr; gap: 2rem; } }
  .hp-plans__footer { margin-top: clamp(2rem, 4vw, 3rem); text-align: right; }

  .hp-notebook {
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-top: 1px solid var(--border);
  }
  .hp-notebook__inner {
    display: grid; grid-template-columns: 7rem 1fr auto;
    gap: 0 2.5rem; align-items: start;
  }
  .hp-notebook__label { padding-top: 0.15rem; }
  .hp-notebook__section {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.68rem; font-weight: 400;
