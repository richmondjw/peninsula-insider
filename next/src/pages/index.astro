---
/**
 * Homepage — Cinematic cover for the issue's spotlight article.
 *
 * Full-bleed editorial cover, magazine-style. One image, one cover line,
 * one PI dispatch tied to the current spotlight. Scrim + grain + Ken Burns
 * drift carry the cinematic feel; rules in BRAND-PI.md govern voice.
 *
 * Below the fold the editorial hierarchy is:
 * Peninsula This Weekend → Places rail → Plans → Shortlist → Editor's Letter
 * → Newsletter.
 *
 * Spotlight is set in the `scenes` array near the top of the script block.
 * The array + grid-stack scaffold is preserved so a rotator (time-of-day,
 * monthly cover swap, three editor's picks) can be reintroduced cleanly —
 * see the "No client-side picker" comment further down for the entry point.
 *
 * Honours prefers-reduced-motion (no Ken Burns drift).
 * Promoted from /preview-cinematic/ on 2026-05-08, replacing the
 * HomeCover-based magazine layout that lives in git history at HEAD~1.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Shortlist from '../components/Shortlist.astro';
import EditorsLetter from '../components/EditorsLetter.astro';
import PlaceCard from '../components/PlaceCard.astro';
import ItineraryCard from '../components/ItineraryCard.astro';
import WeekendPickerBlock from '../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import ScrollReveal from '../components/react/ScrollReveal.tsx';
import { routeSlug, currentSeason, seasonBlurb, dispatchWeekend } from '../lib/editorial';
import { loadPublishedHomepageOverrides, getHomepageAdminContent } from '../lib/content/homepage';
import { sanityReadEnabled } from '../lib/sanity/client';
import { fetchHomepageCoverFromSanity } from '../lib/sanity/singletons-adapter';
import { fetchPlaceFromSanity } from '../lib/sanity/place-adapter';
import { fetchItineraryFromSanity } from '../lib/sanity/itinerary-adapter';
import { editableText, editableImage } from '../lib/inline-edit/attrs';

// CMS-driven overrides for editor-controlled fields on the homepage. Empty
// when Supabase is unconfigured or no rows are published; falls through to
// the inline defaults below in that case. Per-field use only — dynamic
// seasonal copy still wins when nothing is published.
const cmsOverrides = await loadPublishedHomepageOverrides();
const cmsText = cmsOverrides.textFieldsByPath;
const cmsImage = cmsOverrides.imageSlotsByPath;

const articles    = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const places      = await getCollection('places');
const itineraries = await getCollection('itineraries');

// The Notebook — "Today from The Notebook" homepage module.
// One note only, most recent published + not yet expired. No feed behaviour.
const now = new Date();
const notebookNote = (await getCollection('quickNotes', ({ data }) => data.status === 'published' && data.expiresAt > now))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
  [0] ?? null;

// Homepage Plans card grid (Wave 3 prep, 2026-05-10) — rebalances the
// homepage hierarchy so Plans gets visible weight per Strategic Review §6.
// Picks three itineraries that span the editorial range: a two-night
// sweet-spot weekend, a longer reset, and a short-form quick escape.
// Falls through to publish order if any of the named slugs are missing.
const featuredPlanSlugs = [
  'ridge-to-sea-two-night-escape',
  'wellness-weekend',
  'sorrento-off-season-weekend',
];
const featuredPlans = featuredPlanSlugs
  .map((s) => itineraries.find((it) => routeSlug(it) === s))
  .filter(Boolean);
const fallbackPlans = itineraries
  .filter((it) => !featuredPlanSlugs.includes(routeSlug(it)))
  .slice(0, 3 - featuredPlans.length);
const planCards = [...featuredPlans, ...fallbackPlans].slice(0, 3);

// ── Below-fold data (mirrors index.astro so the integration is visible) ─────
const featured = articles.find((a) => a.data.featured && a.data.format !== 'weekend-picker')
  ?? articles.find((a) => a.data.format !== 'weekend-picker')
  ?? articles[0];

const weekendDispatch = articles
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))[0];
const dispatchWindow = weekendDispatch
  ? dispatchWeekend(weekendDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };

const editorPicks = articles
  .filter((a) => routeSlug(a) !== routeSlug(featured))
  .filter((a) =>
    ['the-chardonnay-case', 'three-italian-dinners', 'the-peninsula-pantry',
     'the-long-lunch', 'the-thermal-springs-weekend'].includes(routeSlug(a))
  )
  .slice(0, 3);

// Homepage destination rail: prioritise high-intent, recognisable
// destination searches rather than evenly representing every Peninsula zone.
const featuredPlaceSlugs = [
  'sorrento',
  'red-hill',
  'flinders',
  'arthurs-seat',
  'rosebud',
  'rye',
  'portsea',
  'blairgowrie',
  'merricks',
  'main-ridge',
];
const featuredPlaces = featuredPlaceSlugs
  .map((slug) => places.find((p) => routeSlug(p) === slug))
  .filter(Boolean);
const placesLabelRaw = cmsText['places.label'];
const placesLabel = /know the terrain/i.test(placesLabelRaw ?? '')
  ? 'Area guide'
  : placesLabelRaw ?? 'Area guide';
const placesTitleRaw = cmsText['places.title'];
const placesTitle = placesTitleRaw === 'The Peninsula, place by place'
  ? 'Explore the Peninsula'
  : placesTitleRaw ?? 'Explore the Peninsula';

// Dual-read: when the per-entity Sanity flag is on, overwrite the heroImage
// src on featured places + plan cards with the Sanity CDN URL. Sanity's
// production client has stega enabled and the adapters thread ctx through
// intentUrl(), so the rendered URL carries an invisible marker pointing
// back at the source doc/field. That marker is what lets the admin
// right-click overlay auto-detect the binding for "Replace from media
// library…". Card visuals are unchanged — only the URL string differs.
async function applySanityHero<T extends { data: any }>(
  entity: T,
  slug: string,
  fetcher: (s: string) => Promise<any | null>,
): Promise<T> {
  const doc = await fetcher(slug);
  const sanitySrc = doc?.data?.heroImage?.src;
  if (!sanitySrc) return entity;
  return {
    ...entity,
    data: {
      ...entity.data,
      heroImage: { ...entity.data.heroImage, src: sanitySrc },
    },
  };
}
const placeReadOn      = sanityReadEnabled('places');
const itineraryReadOn  = sanityReadEnabled('itineraries');
let hydratedFeaturedPlaces = featuredPlaces as typeof featuredPlaces;
let hydratedPlanCards      = planCards as typeof planCards;
try {
  const [hPlaces, hPlans] = await Promise.all([
    Promise.all(
      featuredPlaces.map((p) =>
        placeReadOn ? applySanityHero(p, routeSlug(p), fetchPlaceFromSanity) : p,
      ),
    ),
    Promise.all(
      planCards.map((it) =>
        itineraryReadOn ? applySanityHero(it, routeSlug(it), fetchItineraryFromSanity) : it,
      ),
    ),
  ]);
  hydratedFeaturedPlaces = hPlaces as typeof featuredPlaces;
  hydratedPlanCards      = hPlans as typeof planCards;
} catch (err) {
  console.error('[homepage] Sanity card hydration failed, falling back to static data:', err);
}

const season         = currentSeason();
const seasonBlurbData = seasonBlurb[season];
// issueDate const removed 2026-05-12 — was used only by the dropped
// "Vol 04 · {issueDate}" cinema chrome.

// ── Cinematic hero data ────────────────────────────────────────────────────
// Production cover: the May issue's spotlight is the Hatted Restaurants
// article. Single-image, single-story cover (a magazine cover features one
// piece, not five). The time-of-day rotator structure has been collapsed
// to a single scene — the array+grid scaffold is preserved so we can bring
// rotation back later if we ever do a "five covers" issue.
//
// Image: Pt. Leo Estate sculpture park, above Western Port. Laura (one of
// the four two-hat restaurants the article leads with) lives at Pt. Leo.
// CC-BY-SA-4.0, documented in /images/sourced/LICENSES.md.

interface Scene {
  id: string;             // stable key
  label: string;          // eyebrow chip, e.g. "THE COVER STORY"
  hours: string;          // small-print sub, e.g. "9 MIN READ"
  image: string;
  imageAlt: string;
  caption: string;        // bottom-right location credit
  headline: string;       // <em> tags render italic gold accent
  dispatch: string;       // PI voice — see BRAND-PI.md voice rules
  primaryHref: string;
  primaryLabel: string;
}

type RenderScene = Scene & { sanitySceneIndex?: number };

// Cover scene fields are editor-controlled. CMS overrides (when present)
// win over the inline defaults; the inline values are the canonical fallback
// so the homepage renders identically when no CMS rows are published.
const coverImageOverride = cmsImage['cover.image'];
const scenes: Scene[] = [
  // ── Active cover — swap any scene to [0] to make it live ─────────────────
  {
    id: 'flinders-weekend',
    label: 'SLOW PENINSULA',
    hours: '7 MIN READ',
    image: '/images/sourced/home-cover-sorrento-pier-01.jpg',
    imageAlt: 'Sorrento pier extending into the calm bay, boats moored in blue water, viewed from the coastal hillside above',
    caption: 'Sorrento, Port Phillip Bay',
    headline: 'The <em>other</em> Peninsula weekend.',
    dispatch: 'When Red Hill is booked out and Sorrento feels like a queue, Flinders offers another version of the Peninsula weekend — south of everything, closer to the ocean, and slower on purpose.',
    primaryHref: '/journal/a-flinders-weekend/',
    primaryLabel: 'Read',
  },
  // ── WINTER JUNE 2026 — move to [0] on June 1 to open the Winter issue ──
  // July swap: 'The Winter Table' · August swap: 'Fireplaces, Red Wine & Long Lunches'
  {
    id: 'winter-peninsula-weekend',
    label: 'FEATURE',
    hours: '8 MIN READ',
    image: '/images/sourced/home-cover-cape-schanck-rainbow-01.webp',
    imageAlt: 'Rain squall clearing over Cape Schanck bay in winter, rainbow arcing over mist-softened headland and steel-grey Bass Strait',
    caption: 'Cape Schanck, winter clearing',
    headline: 'A <em>winter</em> Peninsula weekend.',
    dispatch: 'Short days, empty dining rooms, a fire in every cellar door with a hearth, and a coast that looks like a different country in a southerly. The Peninsula in winter is its most underrated season.',
    primaryHref: '/journal/a-winter-peninsula-weekend/',
    primaryLabel: 'Read',
  },
  // ── Rotation bench ────────────────────────────────────────────────────────
  {
    id: 'late-walks',
    label: 'WALK',
    hours: '7 MIN READ',
    image: '/images/sourced/home-cover-back-beach-horses-01.jpg',
    imageAlt: 'Horses on a Peninsula ocean back beach, Bass Strait in the background',
    caption: 'Back beach, Bass Strait side',
    headline: 'When the light <em>starts improving.</em>',
    dispatch: 'Bushrangers Bay for a full reset. Cape Schanck boardwalk when time is short. Sorrento Back Beach for mood rather than route. The four walks that earn the second drink.',
    primaryHref: '/journal/the-peninsulas-best-late-afternoon-walks/',
    primaryLabel: 'Read',
  },
  // ── Rotation bench — move any scene to [0] to make it live ─────────────
  {
    id: 'cover',
    label: cmsText['cover.label'] ?? 'FEATURE',
    hours: cmsText['cover.hours'] ?? '9 MIN READ',
    image: coverImageOverride?.src ?? '/images/sourced/category-restaurant-01.webp',
    imageAlt: coverImageOverride?.alt ?? 'Warm, polished restaurant interior with a marble bar, timber stools, and low lighting. The kind of room that suits a Peninsula hatted-restaurant shortlist.',
    caption: coverImageOverride?.caption ?? cmsText['cover.caption'] ?? 'Peninsula dining room',
    headline: cmsText['cover.headline'] ?? 'The Hatted Restaurants of the <em>Peninsula.</em>',
    dispatch: cmsText['cover.dispatch'] ?? 'Four two-hat restaurants. Seven one-hat tables. Barragunda is the debut, Tedesca took Regional Restaurant of the Year, and Laura is still where the long lunch happens. The complete list, with booking realities.',
    primaryHref: cmsText['cover.primaryHref'] ?? '/journal/hatted-restaurants-mornington-peninsula-2025/',
    primaryLabel: cmsText['cover.primaryLabel'] ?? 'Read the cover story',
  },
  {
    id: 'cape-schanck',
    label: 'GUIDE',
    hours: '8 MIN READ',
    image: '/images/sourced/explore-cape-schanck-lighthouse-01.webp',
    imageAlt: 'Cape Schanck lighthouse above the basalt clifftop coastline, Mornington Peninsula National Park',
    caption: 'Cape Schanck, Mornington Peninsula National Park',
    headline: 'The lighthouse at the edge of <em>everything.</em>',
    dispatch: 'The 1859 limestone lighthouse, the boardwalk to Pulpit Rock, and the walk to Bushrangers Bay. The grounds are free from 6am. Here is the full structure of the day.',
    primaryHref: '/journal/cape-schanck-guide/',
    primaryLabel: 'Read the guide',
  },
];

// The <img> in the cover block is tagged `page/home/cover.image`, so
// whichever scene is active (scenes[0]) must render the override when
// one's published — or the image disagrees with what editors uploaded.
// Apply the override to the active scene rather than burying it in
// scenes[2] which only fires if that scene gets promoted to [0].
const activeScene = scenes[0];
let ssrScene: Scene = coverImageOverride
  ? {
      ...activeScene,
      image: coverImageOverride.src,
      imageAlt: coverImageOverride.alt ?? activeScene.imageAlt,
      caption: coverImageOverride.caption ?? activeScene.caption,
    }
  : activeScene;

// Build-time read: bake the homepageCover singleton from Sanity into the
// static HTML. No runtime guard needed — this runs once per build.
let sanityActiveSceneIndex: number | null = null;
// Static fallback: tag alsoScenes with their position in the scenes array so
// the admin overlay can always bind to homepageCover.scenes[N].image, even
// when the Sanity read fails (e.g. during local dev without SANITY_READ_ENABLED).
let alsoScenes: RenderScene[] = scenes.slice(1, 4).map((s, i) => ({ ...s, sanitySceneIndex: i + 1 }));
try {
  const sanityCover = await fetchHomepageCoverFromSanity();
  if (sanityCover && sanityCover.scenes.length > 0) {
    sanityActiveSceneIndex = Math.min(sanityCover.activeIndex, sanityCover.scenes.length - 1);
    const sc = sanityCover.scenes[sanityActiveSceneIndex];
    const sanityScenes: RenderScene[] = sanityCover.scenes.map((scene, idx) => ({
      ...scene,
      sanitySceneIndex: idx,
    }));
    ssrScene = {
      id: sc.id,
      label: sc.label,
      hours: sc.hours,
      image: sc.image,
      imageAlt: sc.imageAlt,
      caption: sc.caption,
      headline: sc.headline,
      dispatch: sc.dispatch,
      primaryHref: sc.primaryHref,
      primaryLabel: sc.primaryLabel,
    };
    alsoScenes = sanityScenes
      .filter((_, idx) => idx !== sanityActiveSceneIndex)
      .slice(0, 3);
  }
} catch (err) {
  console.error('[homepage] Sanity cover fetch failed, falling back to static cover:', err);
}

// Local-image override: only applies when Sanity returned no cover data.
// If Sanity has a cover, Sanity wins — editors control the image via the
// right-click admin overlay and patches land on homepageCover.scenes[N].image.
// The hardcoded /images/ path in scenes[] acts as a build-time fallback only.
if (sanityActiveSceneIndex === null && activeScene.image.startsWith('/images/')) {
  ssrScene = { ...ssrScene, image: activeScene.image, imageAlt: activeScene.imageAlt, caption: activeScene.caption };
}

// Editorial meta line: cover-essay date. Hardcoded for the prototype;
// when the cover becomes CMS-driven (or rotates from articles) this should
// pull from the article's publishedAt. Format matches the New Yorker /
// Atlantic essay pattern: "{type} · {date} · {read time}".
const coverDate = new Date('2026-05-13').toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
export const prerender = true;
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula — best restaurants, cellar doors, beaches, walks, and places to stay. Every venue visited. Every opinion earned. Updated May 2026."
  section="home"
  canonical="https://peninsulainsider.com.au"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Peninsula Insider',
    url: 'https://peninsulainsider.com.au',
    description: 'An editorial guide to the Mornington Peninsula.',
    inLanguage: 'en-AU',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://peninsulainsider.com.au/journal?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Mornington Peninsula known for?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Mornington Peninsula is known for cool-climate Pinot Noir and Chardonnay, vineyard restaurants, natural hot springs, dramatic ocean coastline, and calm bay beaches, all within 90 minutes of Melbourne.',
        },
      },
      {
        '@type': 'Question',
        name: 'How far is the Mornington Peninsula from Melbourne?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mornington town is about 60 km from Melbourne CBD (around 60 minutes). Sorrento and Portsea at the tip are 95 to 105 km, roughly 90 minutes in normal traffic.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the best time to visit the Mornington Peninsula?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Autumn (March to May) is the best season: vintage is underway on the ridge, crowds thin after Easter, and the light over the vineyards is at its best.',
        },
      },
    ],
  })} />

  {/* ── Cinema hero — letterboxed editorial cover (2026-05-23).
       Black top and bottom bars bracket a full-bleed film frame.
       Bars collapse on first scroll to expand the image edge-to-edge.
       Replaces the split-grid cover + also-in-issue strip. */}
  <section class="cinema" aria-label="Cover story" data-section="cinema">

    {/* TOP BAR: publication identity + current story label */}
    <div class="cinema__bar cinema__bar--top">
      <span class="cinema__pub">PENINSULA INSIDER</span>
      <span class="cinema__bar-dot" aria-hidden="true">·</span>
      <span class="cinema__season">AUTUMN 2026</span>
      <span class="cinema__bar-spacer" aria-hidden="true"></span>
      <span class="cinema__chip">{ssrScene.label}</span>
      <span class="cinema__bar-dot cinema__bar-dot--mid" aria-hidden="true">·</span>
      <span class="cinema__hours">{ssrScene.hours}</span>
    </div>

    {/* FILM FRAME: full-bleed image with overlay copy */}
    <div class="cinema__frame">
      {/* Still image with dramatic Ken Burns drift.
          To add video: replace the <img> with:
          <video class="cinema__still" autoplay muted loop playsinline poster={ssrScene.image}>
            <source src="/video/cover-hero.mp4" type="video/mp4" />
          </video>  */}
      <img
        class="cinema__still"
        src={ssrScene.image}
        alt={ssrScene.imageAlt}
        loading="eager"
        fetchpriority="high"
        {...editableImage({
          entityType: 'page',
          entitySlug: 'home',
          fieldPath: 'cover.image',
          label: 'Cover image',
          purpose: 'hero',
          sanitySingletonId: 'homepageCover',
          sanitySingletonPath: `scenes[${sanityActiveSceneIndex ?? 0}].image`,
        })}
      />
      <div class="cinema__scrim" aria-hidden="true"></div>

      <div class="cinema__copy">
        <h1
          class="cinema__headline"
          set:html={ssrScene.headline}
          {...editableText({
            entityType: 'page',
            entitySlug: 'home',
            fieldPath: 'cover.headline',
            label: 'Cover headline',
          })}
        />
        <p
          class="cinema__dispatch"
          {...editableText({
            entityType: 'page',
            entitySlug: 'home',
            fieldPath: 'cover.dispatch',
            label: 'Cover dispatch',
          })}
        >{ssrScene.dispatch}</p>
        <div class="cinema__ctas">
          <a class="cinema__cta" href={ssrScene.primaryHref}>
            {ssrScene.primaryLabel} <span aria-hidden="true">→</span>
          </a>
          <a class="cinema__ask-link" href="/ask/" data-pi-trigger="true">
            or ask The Insider <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    {/* BOTTOM BAR: secondary picks in the letterbox band */}
    <div class="cinema__bar cinema__bar--bottom">
      <span class="cinema__also-label">Also in this issue</span>
      <span class="cinema__bar-spacer" aria-hidden="true"></span>
      {alsoScenes.map((s) => (
        <a class="cinema__also-item" href={s.primaryHref}>
          <span class="cinema__also-chip">{s.label}</span>
          <span class="cinema__also-title" set:html={s.headline} />
        </a>
      ))}
      <span class="cinema__bar-spacer cinema__bar-spacer--tail" aria-hidden="true"></span>
      <a class="cinema__all-link" href="/journal/">All stories →</a>
    </div>

  </section>

  {/* ── Section navigation strip ─────────────────────────────────────────────
       Horizontal scrollable chip row. Primarily a mobile affordance: gives
       users a direct path into any section without opening the hamburger.
       Desktop: the full nav is visible; this strip is supplementary. */}
  <nav class="hp-section-nav" aria-label="Browse sections">
    <div class="hp-section-nav__track">
      <a class="hp-section-nav__chip" href="/whats-on/">What&rsquo;s On</a>
      <a class="hp-section-nav__chip" href="/plans/">Plans</a>
      <a class="hp-section-nav__chip" href="/eat/">Eat &amp; Drink</a>
      <a class="hp-section-nav__chip" href="/wine/">Wine</a>
      <a class="hp-section-nav__chip" href="/stay/">Stay</a>
      <a class="hp-section-nav__chip" href="/places/">Places</a>
      <a class="hp-section-nav__chip" href="/explore/">Explore</a>
      <a class="hp-section-nav__chip" href="/journal/">Journal</a>
    </div>
  </nav>

  {/* ── Below the fold — primary weekend dispatch, terrain, plans, shortlist ──
       Each section is wrapped in a <ScrollReveal> island that fades it up
       as it enters the viewport. The wrappers hydrate on client:visible so
       they cost nothing until the user starts scrolling. */}
  {weekendDispatch && (
    <ScrollReveal client:visible>
      <WeekendPickerBlock
        dispatch={weekendDispatch}
        weekend={`This weekend · ${dispatchWindow.label}`}
      />
    </ScrollReveal>
  )}

  {featuredPlaces.length > 0 && (
    <ScrollReveal client:visible>
    <section class="places places--compact">
      <div class="container">
        <div class="places__header">
          <p
            class="label label--accent places__label"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.label', label: 'Places eyebrow' })}
          >{placesLabel}</p>
          <h2
            class="places__title"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.title', label: 'Places title' })}
          >{placesTitle}</h2>
          <p
            class="places__sub"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.sub', label: 'Places sub' })}
          >{cmsText['places.sub'] ?? 'Start with the Peninsula destinations people search for first, the towns, villages and landmarks that anchor most trips.'}</p>
        </div>
        <div class="places__grid">
          {hydratedFeaturedPlaces.map((place, index) => (
            <PlaceCard
              place={place}
              variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'}
              showDetails={false}
            />
          ))}
        </div>
        <div class="places__footer">
          <a href="/places/" class="venues__link">Explore all places →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {planCards.length > 0 && (
    <ScrollReveal client:visible>
    <section class="hp-plans">
      <div class="container">
        <div class="hp-plans__head">
          <p
            class="label label--accent"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.label', label: 'Plans eyebrow' })}
          >{cmsText['plans.label'] ?? 'Plans'}</p>
          <h2
            class="hp-plans__title"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.title', label: 'Plans title' })}
          >{cmsText['plans.title'] ?? 'Or take the whole weekend.'}</h2>
          <p
            class="hp-plans__sub"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.sub', label: 'Plans sub' })}
          >{cmsText['plans.sub'] ?? 'Three editorial itineraries, built around a single anchor stay, paced for the way the Peninsula actually works.'}</p>
        </div>
        <div class="hp-plans__grid">
          {hydratedPlanCards.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
        </div>
        <div class="hp-plans__footer">
          <a href="/plans/" class="venues__link">View Plans →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {editorPicks.length > 0 && (
    <ScrollReveal client:visible>
    <div class="hp-shortlist-wrap">
    <Shortlist
      eyebrow="The Shortlist"
      title="Three pieces worth the <em>appointment</em>."
      dek="The three we'd send a close friend to this issue, picked for the ratio of payoff to effort, not the view from the tasting room."
      link={{ label: 'View Journal', href: '/journal/' }}
      items={editorPicks.map((article) => ({
        rank: '',
        meta: [],
        name: article.data.title,
        href: `/journal/${routeSlug(article)}`,
        why: article.data.dek,
        tags: [],
      }))}
    />
    </div>
    </ScrollReveal>
  )}

  {/* Editor's Letter — falls through to homepage.ts defaults when no CMS override is published.
      Rotate the copy in homepage.ts each season; CMS overrides win when set. */}
  <ScrollReveal client:visible>
  {(() => {
    const elImage = cmsImage['editors-letter.image'];
    const hpContent = getHomepageAdminContent();
    const elDefaults = hpContent.editorsLetter;
    const editorsLetterTitle = cmsText['editors-letter.title'] ?? elDefaults.title;
    const editorsLetterParagraphs = [
      cmsText['editors-letter.paragraphs.0'] ?? elDefaults.paragraphs[0],
      cmsText['editors-letter.paragraphs.1'] ?? elDefaults.paragraphs[1],
    ];
    return (
      <EditorsLetter
        eyebrow={cmsText['editors-letter.eyebrow'] ?? elDefaults.eyebrow}
        title={editorsLetterTitle}
        paragraphs={editorsLetterParagraphs}
        pullQuote={cmsText['editors-letter.pullQuote'] ?? elDefaults.pullQuote}
        signatureName={cmsText['editors-letter.signatureName'] ?? elDefaults.signatureName}
        signatureRole={cmsText['editors-letter.signatureRole'] ?? elDefaults.signatureRole}
        image={elImage?.src ?? elDefaults.image}
        imageAlt={elImage?.alt ?? elDefaults.imageAlt}
        imageCaption={elImage?.caption ?? elDefaults.imageCaption}
      />
    );
  })()}
  </ScrollReveal>

  {/* ── TODAY FROM THE NOTEBOOK ───────────────────────────────────────────
      One note. No feed. Freshness signal for repeat visitors.
      Placement: lower homepage, after major editorial surfaces, before footer.
  ────────────────────────────────────────────────────────────────────────── */}
  {notebookNote && (
    <ScrollReveal client:visible>
      <section class="hp-notebook" aria-label="Today from The Notebook">
        <div class="container">
          <div class="hp-notebook__inner">
            <div class="hp-notebook__label">
              <p class="label label--accent">The Notebook</p>
            </div>
            <div class="hp-notebook__note">
              <p class="hp-notebook__section">{notebookNote.data.section === 'note' ? 'Editor' : notebookNote.data.section}</p>
              <a class="hp-notebook__headline" href={`/quick-note/${notebookNote.id.replace(/\.md$/, '')}/`}>
                {notebookNote.data.headline}
              </a>
              {notebookNote.data.verdict && (
                <p class="hp-notebook__verdict">{notebookNote.data.verdict}</p>
              )}
            </div>
            <div class="hp-notebook__link">
              <a href="/quick-note/" class="hp-notebook__more">The Notebook →</a>
            </div>
          </div>
        </div>
      </section>
    </ScrollReveal>
  )}

  <ScrollReveal client:visible>
    <NewsletterBlock />
  </ScrollReveal>

</BaseLayout>

{/* ─────────────────────────────────────────────────────────────────────────
   Homepage styles. Cinema hero (.cinema*) up top, then below-fold sections.
   ───────────────────────────────────────────────────────────────────────── */}
<style is:global>
  /* =========================================================================
     CINEMA HERO — letterboxed editorial cover (2026-05-23)
     Dark background creates top/bottom "bars" around a full-bleed film frame.
     Bars collapse on first scroll (JS adds .is-open) so the image expands
     edge-to-edge. Oversized Cormorant headline anchored to frame bottom-left.
     ========================================================================= */

  .cinema {
    display: flex;
    flex-direction: column;
    height: 100svh;
    min-height: 560px;
    background: #0A0806;
    color: #F6F1E8;
    overflow: hidden;
  }

  /* Letterbox bars: top + bottom bands that bracket the film frame */
  .cinema__bar {
    flex-shrink: 0;
    height: clamp(52px, 9vh, 100px);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0 clamp(1.5rem, 5vw, 4rem);
    overflow: hidden;
    white-space: nowrap;
    transition: height 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.45s ease;
  }
  .cinema__bar--top {
    border-bottom: 1px solid rgba(246, 241, 232, 0.1);
  }
  .cinema__bar--bottom {
    border-top: 1px solid rgba(246, 241, 232, 0.1);
  }

  /* Bars collapse when .is-open is added on scroll */
  .cinema.is-open .cinema__bar--top,
  .cinema.is-open .cinema__bar--bottom {
    height: 0;
    opacity: 0;
  }

  /* Bar typographic atoms */
  .cinema__pub {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(246, 241, 232, 0.92);
  }
  .cinema__season {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.58rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(246, 241, 232, 0.45);
  }
  .cinema__bar-dot {
    color: rgba(246, 241, 232, 0.2);
    font-size: 0.5rem;
    flex-shrink: 0;
  }
  /* Spacer rule between identity and story label */
  .cinema__bar-spacer {
    flex: 1;
    min-width: 1rem;
    height: 1px;
    background: rgba(246, 241, 232, 0.08);
    display: block;
    flex-shrink: 1;
  }
  .cinema__bar-spacer--tail {
    flex: 0 0 1.5rem;
  }
  .cinema__chip {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #C4763A;
    flex-shrink: 0;
  }
  .cinema__hours {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.56rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(246, 241, 232, 0.38);
    flex-shrink: 0;
  }

  /* Bottom bar: "also in this issue" */
  .cinema__also-label {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(246, 241, 232, 0.38);
    flex-shrink: 0;
  }
  .cinema__also-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    border-left: 1px solid rgba(246, 241, 232, 0.1);
    text-decoration: none;
    flex-shrink: 0;
    max-width: 32ch;
    overflow: hidden;
    transition: opacity 0.2s ease;
  }
  .cinema__also-item:hover { opacity: 0.65; }
  .cinema__also-chip {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C4763A;
    flex-shrink: 0;
  }
  .cinema__also-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 0.82rem;
    font-weight: 400;
    color: rgba(246, 241, 232, 0.72);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cinema__also-title em {
    font-style: italic;
    color: rgba(246, 241, 232, 0.72);
  }
  .cinema__all-link {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(246, 241, 232, 0.45);
    text-decoration: none;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }
  .cinema__all-link:hover { color: rgba(246, 241, 232, 0.9); }

  /* Film frame: flexes to fill the space between bars */
  .cinema__frame {
    flex: 1;
    position: relative;
    min-height: 0;
    overflow: hidden;
  }

  /* Still image with dramatic Ken Burns drift */
  .cinema__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform-origin: center 38%;
    animation: cinema-drift 16s ease-in-out infinite alternate;
  }
  @keyframes cinema-drift {
    from { transform: scale(1.0);   }
    to   { transform: scale(1.075); }
  }

  /* Gradient scrim: deep at the bottom for text legibility, fades to clear */
  .cinema__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top,
        rgba(10, 8, 6, 0.90) 0%,
        rgba(10, 8, 6, 0.52) 26%,
        rgba(10, 8, 6, 0.10) 56%,
        transparent          100%);
    pointer-events: none;
  }

  /* Copy: headline + dispatch + CTAs, pinned to frame bottom-left */
  .cinema__copy {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    z-index: 2;
  }

  .cinema__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(3.8rem, 11vw, 10.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: #F6F1E8;
    margin: 0 0 clamp(1rem, 2.5vw, 1.75rem);
    max-width: none;
    animation: cinema-enter 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }
  .cinema__headline em {
    font-style: italic;
    color: #D4874A;
  }

  .cinema__dispatch {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.0rem, 1.4vw, 1.28rem);
    line-height: 1.55;
    color: rgba(246, 241, 232, 0.8);
    margin: 0 0 1.75rem;
    max-width: 54ch;
    animation: cinema-enter 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.50s both;
  }

  .cinema__ctas {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    animation: cinema-enter 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.70s both;
  }
  .cinema__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.6rem;
    background: #F6F1E8;
    color: #171413;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    min-height: 44px;
    transition: background 0.22s ease, color 0.22s ease;
  }
  .cinema__cta:hover {
    background: #D4874A;
    color: #F6F1E8;
  }
  .cinema__ask-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    color: rgba(246, 241, 232, 0.6);
    text-decoration: none;
    padding: 0 0.4rem;
    margin-left: 0.5rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.25);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .cinema__ask-link:hover {
    color: rgba(246, 241, 232, 0.92);
    border-bottom-color: rgba(246, 241, 232, 0.6);
  }

  /* Entrance animation */
  @keyframes cinema-enter {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  /* Responsive */
  @media (max-width: 900px) {
    /* Secondary stories in bottom bar hidden on tablet/mobile */
    .cinema__also-item { display: none; }
    .cinema__bar--bottom { justify-content: space-between; }
    /* Top bar: show pub name only — hide separators and secondary tokens */
    .cinema__season,
    .cinema__chip,
    .cinema__hours,
    .cinema__bar-dot,
    .cinema__bar-spacer { display: none; }
  }
  @media (max-width: 640px) {
    .cinema__dispatch { display: none; }
    .cinema__bar { padding: 0 1.25rem; }
    .cinema__copy { padding: 2rem 1.25rem; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .cinema__still {
      animation: none;
      transform: scale(1.04);
    }
    .cinema__headline,
    .cinema__dispatch,
    .cinema__ctas { animation: none; }
    .cinema__bar,
    .cinema.is-open .cinema__bar--top,
    .cinema.is-open .cinema__bar--bottom { transition: none; }
  }



  /* =========================================================================
     Below-fold styles — homepage sections below the cinematic cover.
     ─────────────────────────────────────────────────────────────────────── */

  /* ── Section navigation strip ─────────────────────────────────────────── */
  .hp-section-nav {
    border-top: 1px solid var(--line, #D9D1BE);
    border-bottom: 1px solid var(--line, #D9D1BE);
    background: var(--paper-warm, #F3EDDE);
    overflow: hidden;
  }
  .hp-section-nav__track {
    display: flex;
    gap: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }
  .hp-section-nav__track::-webkit-scrollbar { display: none; }
  .hp-section-nav__chip {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 0.75rem 1rem;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft, #3A3531);
    text-decoration: none;
    border-right: 1px solid var(--line, #D9D1BE);
    transition: color 0.15s ease, background 0.15s ease;
    flex-shrink: 0;
  }
  .hp-section-nav__chip:first-child { padding-left: 0; }
  .hp-section-nav__chip:last-child { border-right: none; }
  .hp-section-nav__chip:hover,
  .hp-section-nav__chip:focus-visible {
    color: var(--ochre, #A0541F);
    background: transparent;
  }
  /* On desktop the full nav is available — keep strip subtle */
  @media (min-width: 768px) {
    .hp-section-nav {
      display: none; /* hamburger nav is reachable on desktop; strip is a mobile affordance */
    }
  }

  /* One editorial on mobile: hide the Shortlist block on small screens,
     keep the Editor's Letter as the single editorial surface. */
  @media (max-width: 767px) {
    .hp-shortlist-wrap {
      display: none;
    }
  }

  /* ── Places compact: homepage terrain tiles read as image + place name only ── */
  .places--compact .place-card__body {
    padding: 1rem 0 0;
  }
  .places--compact .place-card__name {
    margin-bottom: 0;
  }

  /* ── Homepage Plans card grid (Wave 3 prep, 2026-05-10) ──────────────────
     Keeps planning visible after the primary weekend dispatch and regional
     orientation, without the extra single-venue edit layer.
     ────────────────────────────────────────────────────────────────────── */
  .hp-plans {
    padding: clamp(4rem, 7vw, 6rem) 0;
    background: var(--cream, #F6F1E8);
    border-top: 1px solid rgba(23, 20, 19, 0.06);
    border-bottom: 1px solid rgba(23, 20, 19, 0.06);
  }
  .hp-plans__head {
    text-align: left;
    max-width: 48rem;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }
  .hp-plans__title {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink, #171413);
    margin: 0.5rem 0 0.75rem;
    line-height: 1.1;
  }
  .hp-plans__sub {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-soft, #3A3531);
    margin: 0;
    max-width: 42rem;
  }
  .hp-plans__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (max-width: 900px) {
    .hp-plans__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .hp-plans__grid { grid-template-columns: 1fr; gap: 2rem; }
  }
  .hp-plans__footer {
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: right;
  }

  /* ── Today from The Notebook ─────────────────────────────────────────────── */
  .hp-notebook {
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-top: 1px solid var(--border);
  }
  .hp-notebook__inner {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 0 2.5rem;
    align-items: start;
  }
  .hp-notebook__label {
    padding-top: 0.15rem;
  }
  .hp-notebook__section {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0 0 0.35rem;
  }
  .hp-notebook__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
    text-decoration: none;
    display: block;
  }
  .hp-notebook__headline:hover { color: var(--accent); }
  .hp-notebook__verdict {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--soft);
    margin: 0.4rem 0 0;
  }
  .hp-notebook__more {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--soft);
    text-decoration: none;
    white-space: nowrap;
    padding-top: 0.2rem;
    display: block;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
  }
  .hp-notebook__more:hover { color: var(--text); border-color: var(--text); }
  @media (max-width: 640px) {
    .hp-notebook__inner {
      grid-template-columns: 1fr;
      gap: 0.75rem 0;
    }
    .hp-notebook__link { padding-top: 0.25rem; }
  }
</style>

<script>
  /* Cinema letterbox: collapse bars on first scroll so the image fills edge-to-edge. */
  (function () {
    const cinema = document.querySelector('.cinema');
    if (!cinema) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const update = () => {
      if (window.scrollY > 30) {
        cinema.classList.add('is-open');
      } else {
        cinema.classList.remove('is-open');
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }());
</script>
