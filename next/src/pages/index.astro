---
/**
 * Homepage — Cinematic cover for the issue's spotlight article.
 *
 * Full-bleed editorial cover, magazine-style. One image, one cover line,
 * one PI dispatch tied to the current spotlight. Scrim + grain + Ken Burns
 * drift carry the cinematic feel; rules in BRAND-PI.md govern voice.
 *
 * Below the fold the editorial hierarchy is:
 * Peninsula This Weekend → Places rail → Plans → Shortlist → Editor's Letter
 * → Newsletter.
 *
 * Spotlight is set in the `scenes` array near the top of the script block.
 * The array + grid-stack scaffold is preserved so a rotator (time-of-day,
 * monthly cover swap, three editor's picks) can be reintroduced cleanly —
 * see the "No client-side picker" comment further down for the entry point.
 *
 * Honours prefers-reduced-motion (no Ken Burns drift).
 * Promoted from /preview-cinematic/ on 2026-05-08, replacing the
 * HomeCover-based magazine layout that lives in git history at HEAD~1.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Shortlist from '../components/Shortlist.astro';
import EditorsLetter from '../components/EditorsLetter.astro';
import PlaceCard from '../components/PlaceCard.astro';
import ItineraryCard from '../components/ItineraryCard.astro';
import WeekendPickerBlock from '../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import ScrollReveal from '../components/react/ScrollReveal.tsx';
import { routeSlug, currentSeason, seasonBlurb, dispatchWeekend } from '../lib/editorial';
import { loadPublishedHomepageOverrides } from '../lib/content/homepage';
import { editableText, editableImage } from '../lib/inline-edit/attrs';

// CMS-driven overrides for editor-controlled fields on the homepage. Empty
// when Supabase is unconfigured or no rows are published; falls through to
// the inline defaults below in that case. Per-field use only — dynamic
// seasonal copy still wins when nothing is published.
const cmsOverrides = await loadPublishedHomepageOverrides();
const cmsText = cmsOverrides.textFieldsByPath;
const cmsImage = cmsOverrides.imageSlotsByPath;

const articles    = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const places      = await getCollection('places');
const itineraries = await getCollection('itineraries');

// The Notebook — "Today from The Notebook" homepage module.
// One note only, most recent published + not yet expired. No feed behaviour.
const now = new Date();
const notebookNote = (await getCollection('quickNotes', ({ data }) => data.status === 'published' && data.expiresAt > now))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  [0] ?? null;

// Homepage Plans card grid (Wave 3 prep, 2026-05-10) — rebalances the
// homepage hierarchy so Plans gets visible weight per Strategic Review §6.
// Picks three itineraries that span the editorial range: a two-night
// sweet-spot weekend, a longer reset, and a short-form quick escape.
// Falls through to publish order if any of the named slugs are missing.
const featuredPlanSlugs = [
  'ridge-to-sea-two-night-escape',
  'wellness-weekend',
  'sorrento-off-season-weekend',
];
const featuredPlans = featuredPlanSlugs
  .map((s) => itineraries.find((it) => routeSlug(it) === s))
  .filter(Boolean);
const fallbackPlans = itineraries
  .filter((it) => !featuredPlanSlugs.includes(routeSlug(it)))
  .slice(0, 3 - featuredPlans.length);
const planCards = [...featuredPlans, ...fallbackPlans].slice(0, 3);

// ── Below-fold data (mirrors index.astro so the integration is visible) ─────
const featured = articles.find((a) => a.data.featured && a.data.format !== 'weekend-picker')
  ?? articles.find((a) => a.data.format !== 'weekend-picker')
  ?? articles[0];

const weekendDispatch = articles
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];
const dispatchWindow = weekendDispatch
  ? dispatchWeekend(weekendDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };

const editorPicks = articles
  .filter((a) => routeSlug(a) !== routeSlug(featured))
  .filter((a) =>
    ['the-chardonnay-case', 'three-italian-dinners', 'the-peninsula-pantry',
     'the-long-lunch', 'the-thermal-springs-weekend'].includes(routeSlug(a))
  )
  .slice(0, 3);

// Homepage destination rail: prioritise high-intent, recognisable
// destination searches rather than evenly representing every Peninsula zone.
const featuredPlaceSlugs = [
  'sorrento',
  'red-hill',
  'flinders',
  'arthurs-seat',
  'rosebud',
  'rye',
  'portsea',
  'blairgowrie',
  'merricks',
  'main-ridge',
];
const featuredPlaces = featuredPlaceSlugs
  .map((slug) => places.find((p) => routeSlug(p) === slug))
  .filter(Boolean);
const placesLabelRaw = cmsText['places.label'];
const placesLabel = /know the terrain/i.test(placesLabelRaw ?? '')
  ? 'Area guide'
  : placesLabelRaw ?? 'Area guide';
const placesTitleRaw = cmsText['places.title'];
const placesTitle = placesTitleRaw === 'The Peninsula, place by place'
  ? 'Explore the Peninsula'
  : placesTitleRaw ?? 'Explore the Peninsula';

const season         = currentSeason();
const seasonBlurbData = seasonBlurb[season];
// issueDate const removed 2026-05-12 — was used only by the dropped
// "Vol 04 · {issueDate}" cinema chrome.

// ── Cinematic hero data ────────────────────────────────────────────────────
// Production cover: the May issue's spotlight is the Hatted Restaurants
// article. Single-image, single-story cover (a magazine cover features one
// piece, not five). The time-of-day rotator structure has been collapsed
// to a single scene — the array+grid scaffold is preserved so we can bring
// rotation back later if we ever do a "five covers" issue.
//
// Image: Pt. Leo Estate sculpture park, above Western Port. Laura (one of
// the four two-hat restaurants the article leads with) lives at Pt. Leo.
// CC-BY-SA-4.0, documented in /images/sourced/LICENSES.md.

interface Scene {
  id: string;             // stable key
  label: string;          // eyebrow chip, e.g. "THE COVER STORY"
  hours: string;          // small-print sub, e.g. "9 MIN READ"
  image: string;
  imageAlt: string;
  caption: string;        // bottom-right location credit
  headline: string;       // <em> tags render italic gold accent
  dispatch: string;       // PI voice — see BRAND-PI.md voice rules
  primaryHref: string;
  primaryLabel: string;
}

// Cover scene fields are editor-controlled. CMS overrides (when present)
// win over the inline defaults; the inline values are the canonical fallback
// so the homepage renders identically when no CMS rows are published.
const coverImageOverride = cmsImage['cover.image'];
const scenes: Scene[] = [
  // ── Active cover — swap any scene to [0] to make it live ─────────────────
  {
    id: 'flinders-weekend',
    label: 'THE SLOW SIDE',
    hours: '7 MIN READ',
    image: '/images/sourced/explore-bushrangers-bay-walk-01.webp',
    imageAlt: 'Bushrangers Bay headland and Bass Strait below Cape Schanck, on the slow southern coast of the Mornington Peninsula',
    caption: 'Bushrangers Bay, south coast',
    headline: 'The <em>other</em> Peninsula weekend.',
    dispatch: 'When Red Hill is booked out and Sorrento feels like a queue, there is another version of the Peninsula weekend, south of everything, closer to the ocean, and slower on purpose.',
    primaryHref: '/journal/a-flinders-weekend/',
    primaryLabel: 'Read the piece',
  },
  // ── Rotation bench ────────────────────────────────────────────────────────
  {
    id: 'late-walks',
    label: 'THE WALK',
    hours: '7 MIN READ',
    image: '/images/sourced/home-cover-back-beach-horses-01.jpg',
    imageAlt: 'Horses on a Peninsula ocean back beach, Bass Strait in the background',
    caption: 'Back beach, Bass Strait side',
    headline: 'When the light <em>starts improving.</em>',
    dispatch: 'Bushrangers Bay for a full reset. Cape Schanck boardwalk when time is short. Sorrento Back Beach for mood rather than route. The four walks that earn the second drink.',
    primaryHref: '/journal/the-peninsulas-best-late-afternoon-walks/',
    primaryLabel: 'Read the piece',
  },
  // ── Rotation bench — move any scene to [0] to make it live ─────────────
  {
    id: 'cover',
    label: cmsText['cover.label'] ?? 'THE COVER STORY',
    hours: cmsText['cover.hours'] ?? '9 MIN READ',
    image: coverImageOverride?.src ?? '/images/sourced/category-restaurant-01.webp',
    imageAlt: coverImageOverride?.alt ?? 'Warm, polished restaurant interior with a marble bar, timber stools, and low lighting. The kind of room that suits a Peninsula hatted-restaurant shortlist.',
    caption: coverImageOverride?.caption ?? cmsText['cover.caption'] ?? 'Peninsula dining room',
    headline: cmsText['cover.headline'] ?? 'The Hatted Restaurants of the <em>Peninsula.</em>',
    dispatch: cmsText['cover.dispatch'] ?? 'Four two-hat restaurants. Seven one-hat tables. Barragunda is the debut, Tedesca took Regional Restaurant of the Year, and Laura is still where the long lunch happens. The complete list, with booking realities.',
    primaryHref: cmsText['cover.primaryHref'] ?? '/journal/hatted-restaurants-mornington-peninsula-2025/',
    primaryLabel: cmsText['cover.primaryLabel'] ?? 'Read the cover story',
  },
  {
    id: 'cape-schanck',
    label: 'THE COMPLETE GUIDE',
    hours: '8 MIN READ',
    image: '/images/sourced/explore-cape-schanck-lighthouse-01.webp',
    imageAlt: 'Cape Schanck lighthouse above the basalt clifftop coastline, Mornington Peninsula National Park',
    caption: 'Cape Schanck, Mornington Peninsula National Park',
    headline: 'The lighthouse at the edge of <em>everything.</em>',
    dispatch: 'The 1859 limestone lighthouse, the boardwalk to Pulpit Rock, and the walk to Bushrangers Bay. The grounds are free from 6am. Here is the full structure of the day.',
    primaryHref: '/journal/cape-schanck-guide/',
    primaryLabel: 'Read the guide',
  },
];

const ssrScene = scenes[0];

// Editorial meta line: cover-essay date. Hardcoded for the prototype;
// when the cover becomes CMS-driven (or rotates from articles) this should
// pull from the article's publishedAt. Format matches the New Yorker /
// Atlantic essay pattern: "{type} · {date} · {read time}".
const coverDate = new Date('2026-05-13').toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula — best restaurants, cellar doors, beaches, walks, and places to stay. Every venue visited. Every opinion earned. Updated May 2026."
  section="home"
  canonical="https://peninsulainsider.com.au"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Peninsula Insider',
    url: 'https://peninsulainsider.com.au',
    description: 'An editorial guide to the Mornington Peninsula.',
    inLanguage: 'en-AU',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://peninsulainsider.com.au/journal?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Mornington Peninsula known for?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Mornington Peninsula is known for cool-climate Pinot Noir and Chardonnay, vineyard restaurants, natural hot springs, dramatic ocean coastline, and calm bay beaches, all within 90 minutes of Melbourne.',
        },
      },
      {
        '@type': 'Question',
        name: 'How far is the Mornington Peninsula from Melbourne?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mornington town is about 60 km from Melbourne CBD (around 60 minutes). Sorrento and Portsea at the tip are 95 to 105 km, roughly 90 minutes in normal traffic.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the best time to visit the Mornington Peninsula?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Autumn (March to May) is the best season: vintage is underway on the ridge, crowds thin after Easter, and the light over the vineyards is at its best.',
        },
      },
    ],
  })} />

  {/* ── Split-grid editorial cover (2026-05-13).
       Replaces the cinematic full-bleed + 10s rotator with a magazine-style
       static cover: type column left, single photograph right. One cover
       essay per issue (the publication doesn't carousel through five). The
       "rotation bench" scenes [1..3] now render as a static "Also in this
       issue" strip below the hero block. */}
  <section class="cover" aria-label="Cover essay">
    <div class="container cover__inner">
      <div class="cover__type">
        <p class="cover__meta">
          <span class="cover__chip">{ssrScene.label}</span>
          <span class="cover__dot" aria-hidden="true">·</span>
          <span class="cover__date">{coverDate}</span>
          <span class="cover__dot" aria-hidden="true">·</span>
          <span class="cover__hours">{ssrScene.hours}</span>
        </p>
        <h1
          class="cover__headline"
          set:html={ssrScene.headline}
          {...editableText({
            entityType: 'page',
            entitySlug: 'home',
            fieldPath: 'cover.headline',
            label: 'Cover headline',
          })}
        />
        <p
          class="cover__dispatch"
          {...editableText({
            entityType: 'page',
            entitySlug: 'home',
            fieldPath: 'cover.dispatch',
            label: 'Cover dispatch',
          })}
        >{ssrScene.dispatch}</p>
        <div class="cover__ctas">
          <a class="cover__cta" href={ssrScene.primaryHref}>
            {ssrScene.primaryLabel} <span aria-hidden="true">→</span>
          </a>
          <a class="cover__ask-link" href="/ask/" data-pi-trigger="true">
            or ask The Insider <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure class="cover__visual">
        <div class="cover__visual-frame">
          <img
            src={ssrScene.image}
            alt={ssrScene.imageAlt}
            loading="eager"
            fetchpriority="high"
            {...editableImage({
              entityType: 'page',
              entitySlug: 'home',
              fieldPath: 'cover.image',
              label: 'Cover image',
              purpose: 'hero',
            })}
          />
        </div>
        {/* Cover photo-location caption hidden 2026-05-13 per Emma's
            editorial direction: remove all photo location captions and
            credits sitewide until each image's location is verified
            (homepage, what's on, plans, journal). Keep the figure +
            image; only the figcaption is suppressed. */}
      </figure>
    </div>
  </section>

  {/* Also in this issue — three secondary picks. Static row, no carousel.
       Sourced from the same scenes array (rotation bench → editorial picks). */}
  <section class="cover-also" aria-label="Also in this issue">
    <div class="container">
      <div class="cover-also__head">
        <p class="cover-also__label">Also in this issue</p>
        <a class="cover-also__link" href="/journal/">All essays →</a>
      </div>
      <div class="cover-also__grid">
        {scenes.slice(1, 4).map((s) => (
          <a class="cover-also__item" href={s.primaryHref}>
            <div class="cover-also__thumb">
              <img src={s.image} alt={s.imageAlt} loading="lazy" />
            </div>
            <p class="cover-also__meta">
              <span class="cover-also__chip">{s.label}</span>
              <span class="cover-also__hours">{s.hours}</span>
            </p>
            <h3 class="cover-also__headline" set:html={s.headline} />
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Below the fold — primary weekend dispatch, terrain, plans, shortlist ──
       Each section is wrapped in a <ScrollReveal> island that fades it up
       as it enters the viewport. The wrappers hydrate on client:visible so
       they cost nothing until the user starts scrolling. */}
  {weekendDispatch && (
    <ScrollReveal client:visible>
      <WeekendPickerBlock
        dispatch={weekendDispatch}
        weekend={`This weekend · ${dispatchWindow.label}`}
      />
    </ScrollReveal>
  )}

  {featuredPlaces.length > 0 && (
    <ScrollReveal client:visible>
    <section class="places places--compact">
      <div class="container">
        <div class="places__header">
          <p
            class="label label--accent places__label"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.label', label: 'Places eyebrow' })}
          >{placesLabel}</p>
          <h2
            class="places__title"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.title', label: 'Places title' })}
          >{placesTitle}</h2>
          <p
            class="places__sub"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.sub', label: 'Places sub' })}
          >{cmsText['places.sub'] ?? 'Start with the Peninsula destinations people search for first, the towns, villages and landmarks that anchor most trips.'}</p>
        </div>
        <div class="places__grid">
          {featuredPlaces.map((place, index) => (
            <PlaceCard
              place={place}
              variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'}
              showDetails={false}
            />
          ))}
        </div>
        <div class="places__footer">
          <a href="/places/" class="venues__link">Explore all places →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {planCards.length > 0 && (
    <ScrollReveal client:visible>
    <section class="hp-plans">
      <div class="container">
        <div class="hp-plans__head">
          <p
            class="label label--accent"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.label', label: 'Plans eyebrow' })}
          >{cmsText['plans.label'] ?? 'Plans'}</p>
          <h2
            class="hp-plans__title"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.title', label: 'Plans title' })}
          >{cmsText['plans.title'] ?? 'Or take the whole weekend.'}</h2>
          <p
            class="hp-plans__sub"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.sub', label: 'Plans sub' })}
          >{cmsText['plans.sub'] ?? 'Three editorial itineraries, built around a single anchor stay, paced for the way the Peninsula actually works.'}</p>
        </div>
        <div class="hp-plans__grid">
          {planCards.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
        </div>
        <div class="hp-plans__footer">
          <a href="/plans/" class="venues__link">View Plans →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {editorPicks.length > 0 && (
    <ScrollReveal client:visible>
    <Shortlist
      eyebrow="The Shortlist"
      title="Three pieces worth the <em>appointment</em>."
      dek="The three we'd send a close friend to this issue, picked for the ratio of payoff to effort, not the view from the tasting room."
      link={{ label: 'View Journal', href: '/journal/' }}
      items={editorPicks.map((article) => ({
        rank: '',
        meta: [],
        name: article.data.title,
        href: `/journal/${routeSlug(article)}`,
        why: article.data.dek,
        tags: [],
      }))}
    />
    </ScrollReveal>
  )}

  {/* Editor's Letter — title and paragraphs keep their seasonal interpolation
      because the JSON-default copy is autumn-specific; CMS overrides apply
      only when an editor explicitly sets that field. Other fields fall
      through to the inline defaults when no override is published. */}
  <ScrollReveal client:visible>
  {(() => {
    const elImage = cmsImage['editors-letter.image'];
    const editorsLetterTitle = cmsText['editors-letter.title']
      ?? `On the <em>quiet authority</em> of a good ${seasonBlurbData.label?.toLowerCase() ?? 'autumn'}.`;
    const editorsLetterParagraphs = [
      cmsText['editors-letter.paragraphs.0']
        ?? `${seasonBlurbData.label ?? 'Autumn'} is the season the Peninsula stops performing. The weekend crowds thin, the vintage trucks finish their last runs, and the ridge takes on the colour it has for about six weeks a year.`,
      cmsText['editors-letter.paragraphs.1']
        ?? `We've rebuilt the cellar-door shortlist from scratch this season, visited every restaurant on the long-lunch list at least twice, and walked every beach on the ranking.`,

    ];
    return (
      <EditorsLetter
        eyebrow={cmsText['editors-letter.eyebrow'] ?? "Editor's Letter"}
        title={editorsLetterTitle}
        paragraphs={editorsLetterParagraphs}
        pullQuote={cmsText['editors-letter.pullQuote'] ?? "This issue is built for the six weeks where the Peninsula is at its most itself, before winter settles in and the coast goes quiet."}
        signatureName={cmsText['editors-letter.signatureName'] ?? "The Editors"}
        signatureRole={cmsText['editors-letter.signatureRole'] ?? "Peninsula Insider"}
        image={elImage?.src ?? "/images/sourced/place-red-hill-01.webp"}
        imageAlt={elImage?.alt ?? "Vine rows in late-season colour, Red Hill"}
        imageCaption={elImage?.caption ?? "The last weekend of vintage, Red Hill, <em>the quietest a working winery ever gets.</em>"}
      />
    );
  })()}
  </ScrollReveal>

  {/* ── TODAY FROM THE NOTEBOOK ───────────────────────────────────────────
      One note. No feed. Freshness signal for repeat visitors.
      Placement: lower homepage, after major editorial surfaces, before footer.
  ────────────────────────────────────────────────────────────────────────── */}
  {notebookNote && (
    <ScrollReveal client:visible>
      <section class="hp-notebook" aria-label="Today from The Notebook">
        <div class="container">
          <div class="hp-notebook__inner">
            <div class="hp-notebook__label">
              <p class="label label--accent">The Notebook</p>
            </div>
            <div class="hp-notebook__note">
              <p class="hp-notebook__section">{notebookNote.data.section === 'note' ? 'Editor' : notebookNote.data.section}</p>
              <a class="hp-notebook__headline" href={`/notebook/${notebookNote.id.replace(/\.md$/, '')}/`}>
                {notebookNote.data.headline}
              </a>
              {notebookNote.data.verdict && (
                <p class="hp-notebook__verdict">{notebookNote.data.verdict}</p>
              )}
            </div>
            <div class="hp-notebook__link">
              <a href="/notebook/" class="hp-notebook__more">The Notebook →</a>
            </div>
          </div>
        </div>
      </section>
    </ScrollReveal>
  )}

  <ScrollReveal client:visible>
    <NewsletterBlock />
  </ScrollReveal>

</BaseLayout>

{/* ─────────────────────────────────────────────────────────────────────────
   Homepage styles. Split-grid cover (.cover*) + Also-in-issue strip
   (.cover-also*) up top, then the existing below-fold sections.
   ───────────────────────────────────────────────────────────────────────── */}
<style is:global>
  /* =========================================================================
     SPLIT-GRID COVER — editorial spread, no carousel. Replaced the cinematic
     full-bleed + 10s rotator on 2026-05-13. One cover essay per issue.
     Cream paper background, type column left, single photograph right; on
     narrow screens the columns stack vertically with the type on top.
     ===================================================================== */
  .cover {
    background: #FFFFFF;
    color: #171413;
    /* Asymmetric vertical rhythm: real breathing room above the eyebrow
       so it lifts off the masthead hairline, but a tight gap below so
       "Also in this issue" reads as a continued spread, not a new band. */
    padding: clamp(2rem, 4vw, 4rem) 0 clamp(0.75rem, 1.25vw, 1.25rem);
    border-bottom: 1px solid rgba(23, 20, 19, 0.08);
  }
  .cover__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .cover__type {
    min-width: 0;
  }
  .cover__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(23, 20, 19, 0.16);
    max-width: 26rem;
  }
  .cover__chip {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #A0541F;
  }
  .cover__date,
  .cover__hours {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.55);
  }
  .cover__dot {
    color: rgba(23, 20, 19, 0.3);
    font-size: 0.62rem;
  }
  .cover__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.8rem, 6.2vw, 5.6rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.025em;
    color: #171413;
