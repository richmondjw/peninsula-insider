  .cover-also__thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin: 0 0 1rem;
  }
  .cover-also__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cover-also__item:hover .cover-also__thumb img {
    transform: scale(1.04);
  }
  .cover-also__meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.55rem;
