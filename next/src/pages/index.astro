---
/**
 * Homepage — Cinematic cover for the issue's spotlight article.
 *
 * Full-bleed editorial cover, magazine-style. One image, one cover line,
 * one PI dispatch tied to the current spotlight. Scrim + grain + Ken Burns
 * drift carry the cinematic feel; rules in BRAND-PI.md govern voice.
 *
 * Below the fold the existing editorial layout resumes:
 * Weekend Picker → Places rail → Three picks → Shortlist → Editor's Letter
 * → Newsletter.
 *
 * Spotlight is set in the `scenes` array near the top of the script block.
 * The array + grid-stack scaffold is preserved so a rotator (time-of-day,
 * monthly cover swap, three editor's picks) can be reintroduced cleanly —
 * see the "No client-side picker" comment further down for the entry point.
 *
 * Honours prefers-reduced-motion (no Ken Burns drift).
 * Promoted from /preview-cinematic/ on 2026-05-08, replacing the
 * HomeCover-based magazine layout that lives in git history at HEAD~1.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Shortlist from '../components/Shortlist.astro';
import EditorsLetter from '../components/EditorsLetter.astro';
import PlaceCard from '../components/PlaceCard.astro';
import WeekendPickerBlock from '../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { formatLabel, routeSlug, stayTypes, currentSeason, seasonBlurb, dispatchWeekend, resolveHeroSrc } from '../lib/editorial';

const venues      = await getCollection('venues');
const articles    = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const places      = await getCollection('places');
const experiences = await getCollection('experiences');

// ── Below-fold data (mirrors index.astro so the integration is visible) ─────
const featured = articles.find((a) => a.data.featured && a.data.format !== 'weekend-picker')
  ?? articles.find((a) => a.data.format !== 'weekend-picker')
  ?? articles[0];

const weekendDispatch = articles
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];
const dispatchWindow = weekendDispatch
  ? dispatchWeekend(weekendDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };

const editorPicks = articles
  .filter((a) => routeSlug(a) !== routeSlug(featured))
  .filter((a) =>
    ['the-chardonnay-case', 'three-italian-dinners', 'the-peninsula-pantry',
     'the-long-lunch', 'the-thermal-springs-weekend'].includes(routeSlug(a))
  )
  .slice(0, 5);

const eatPick = venues.find((v) => routeSlug(v) === 'laura')
  ?? venues.find((v) => routeSlug(v) === 'ten-minutes-by-tractor')
  ?? venues.filter((v) => v.data.type === 'restaurant')[0];

const stayPick = venues.find((v) => routeSlug(v) === 'jackalope')
  ?? venues.filter((v) => stayTypes.includes(v.data.type))[0];

const explorePick = experiences.find((e) => routeSlug(e) === 'bushrangers-bay-walk')
  ?? experiences[0];

const featuredPlaces = places.filter((p) =>
  ['red-hill', 'sorrento', 'flinders', 'mornington', 'portsea', 'main-ridge'].includes(routeSlug(p))
);

const season         = currentSeason();
const seasonBlurbData = seasonBlurb[season];

const now       = new Date();
const issueDate = now.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' });

// ── Cinematic hero data ────────────────────────────────────────────────────
// Production cover: the May issue's spotlight is the Hatted Restaurants
// article. Single-image, single-story cover (a magazine cover features one
// piece, not five). The time-of-day rotator structure has been collapsed
// to a single scene — the array+grid scaffold is preserved so we can bring
// rotation back later if we ever do a "five covers" issue.
//
// Image: Pt. Leo Estate sculpture park, above Western Port. Laura (one of
// the four two-hat restaurants the article leads with) lives at Pt. Leo.
// CC-BY-SA-4.0, documented in /images/sourced/LICENSES.md.

interface Scene {
  id: string;             // stable key
  label: string;          // eyebrow chip, e.g. "THE COVER STORY"
  hours: string;          // small-print sub, e.g. "9 MIN READ"
  image: string;
  imageAlt: string;
  caption: string;        // bottom-right location credit
  headline: string;       // <em> tags render italic gold accent
  dispatch: string;       // PI voice — see BRAND-PI.md voice rules
  primaryHref: string;
  primaryLabel: string;
}

const scenes: Scene[] = [
  {
    id: 'cover',
    label: 'THE COVER STORY',
    hours: '9 MIN READ',
    image: '/images/sourced/venue-pt-leo-sculpture-01.webp',
    imageAlt: "Pt. Leo Estate sculpture park, with Barry Flanagan's Drummer hare on the lawn above Western Port — home of Laura, one of the Peninsula's two-hat restaurants",
    caption: 'Pt. Leo Estate, Merricks',
    headline: 'The Hatted Restaurants of the <em>Peninsula.</em>',
    dispatch: 'Four two-hat restaurants. Seven one-hat tables. Barragunda is the debut, Tedesca took Regional Restaurant of the Year, and Laura is still where the long lunch happens. The complete list, with booking realities.',
    primaryHref: '/journal/hatted-restaurants-mornington-peninsula-2025/',
    primaryLabel: 'Read the cover story',
  },
];

const ssrScene = scenes[0];
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="The independent guide to the Mornington Peninsula, best restaurants, cellar doors, beaches, walks, and places to stay. Every venue visited. Every opinion earned. Updated May 2026."
  section="home"
  canonical="https://peninsulainsider.com.au"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Peninsula Insider',
    url: 'https://peninsulainsider.com.au',
    description: 'The independent editorial guide to the Mornington Peninsula.',
    inLanguage: 'en-AU',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://peninsulainsider.com.au/journal?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Mornington Peninsula known for?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Mornington Peninsula is known for cool-climate Pinot Noir and Chardonnay, vineyard restaurants, natural hot springs, dramatic ocean coastline, and calm bay beaches, all within 90 minutes of Melbourne.',
        },
      },
      {
        '@type': 'Question',
        name: 'How far is the Mornington Peninsula from Melbourne?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mornington town is about 60 km from Melbourne CBD (around 60 minutes). Sorrento and Portsea at the tip are 95 to 105 km, roughly 90 minutes in normal traffic.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the best time to visit the Mornington Peninsula?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Autumn (March to May) is the best season: vintage is underway on the ridge, crowds thin after Easter, and the light over the vineyards is at its best.',
        },
      },
    ],
  })} />

  {/* ── Cinematic hero ─────────────────────────────────────────────────────── */}
  <section class="cinema" aria-label="Cover">
    {/* Image layer (array kept so rotation can be reintroduced cleanly later) */}
    <div class="cinema__bg" aria-hidden="true">
      {scenes.map((s) => (
        <div class={`cinema-scene${s.id === ssrScene.id ? ' is-active' : ''}`} data-scene={s.id}>
          <img
            src={s.image}
            alt={s.imageAlt}
            loading="eager"
            fetchpriority={s.id === ssrScene.id ? 'high' : undefined}
          />
        </div>
      ))}
    </div>

    {/* Vertical scrim for legibility of bottom-anchored copy */}
    <div class="cinema__scrim" aria-hidden="true"></div>

    {/* Local grain (separate from global so we can tune intensity) */}
    <div class="cinema__grain" aria-hidden="true"></div>

    {/* Top chrome — masthead identity + issue */}
    <header class="cinema__top">
      <div class="cinema__brand">Peninsula Insider</div>
      <div class="cinema__issue">
        <span>Vol 04</span>
        <span class="cinema__dot" aria-hidden="true">·</span>
        <span>{issueDate}</span>
      </div>
    </header>

    {/* Bottom-left copy block. Grid-stack scaffold preserved so rotation
         can be reintroduced cleanly — currently a single scene. */}
    <div class="cinema__copy">
      <div class="cinema-copy-wrap">
        {scenes.map((s) => (
          <div class={`cinema-copy${s.id === ssrScene.id ? ' is-active' : ''}`} data-copy={s.id}>
            <p class="cinema-copy__time">
              <span class="cinema-copy__chip">{s.label}</span>
              <span class="cinema-copy__hours">{s.hours}</span>
            </p>
            <h1 class="cinema-copy__headline" set:html={s.headline} />
            <p class="cinema-copy__dispatch">{s.dispatch}</p>
          </div>
        ))}
      </div>

      <div class="cinema__ctas">
        <a class="cinema__cta cinema__cta--primary" href={ssrScene.primaryHref}>
          {ssrScene.primaryLabel} <span aria-hidden="true">→</span>
        </a>
        <a class="cinema__cta cinema__cta--ghost" href="/ask/" data-pi-trigger="true">
          Ask PI <span aria-hidden="true">→</span>
        </a>
      </div>

      <p class="cinema__signature">PI's notebook</p>
    </div>

    {/* Bottom-right caption */}
    <p class="cinema__caption">{ssrScene.caption}</p>

    {/* Scroll hint */}
    <div class="cinema__scroll" aria-hidden="true">
      <span class="cinema__scroll-label">Inside the issue</span>
      <span class="cinema__scroll-line"></span>
    </div>
  </section>

  {/* ── Below the fold — existing magazine layout, unchanged ───────────────── */}
  {weekendDispatch && (
    <WeekendPickerBlock
      dispatch={weekendDispatch}
      weekend={`This weekend · ${dispatchWindow.label}`}
    />
  )}

  {featuredPlaces.length > 0 && (
    <section class="places places--compact">
      <div class="container">
        <div class="places__header">
          <p class="label label--accent places__label">Know the terrain</p>
          <h2 class="places__title">The Peninsula, place by place</h2>
          <p class="places__sub">Six towns that organise the region — ridge, coast, and bay.</p>
        </div>
        <div class="places__grid">
          {featuredPlaces.map((place, index) => (
            <PlaceCard
              place={place}
              variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'}
            />
          ))}
        </div>
        <div class="places__footer">
          <a href="/places/" class="venues__link">All {places.length} places →</a>
        </div>
      </div>
    </section>
  )}

  {(eatPick || stayPick || explorePick) && (
    <section class="hp-picks">
      <div class="container">
        <div class="hp-picks__head">
          <div>
            <p class="label label--accent">This week's edit</p>
            <h2 class="hp-picks__title">Three reasons to go</h2>
          </div>
          <a href="/journal/" class="venues__link">Read all →</a>
        </div>
        <div class="hp-picks__grid">
          {eatPick && (
            <a href={`/eat/${routeSlug(eatPick)}`} class="hp-pick">
              <div class="hp-pick__img">
                <img src={resolveHeroSrc(eatPick.data)} alt={eatPick.data.heroImage?.alt ?? eatPick.data.name ?? 'Restaurant pick'} loading="lazy" decoding="async" />
              </div>
              <p class="hp-pick__tag">Eat &amp; Drink</p>
              <h3 class="hp-pick__name">{eatPick.data.name}</h3>
              {eatPick.data.signature && (<p class="hp-pick__note">{eatPick.data.signature}</p>)}
            </a>
          )}
          {stayPick && (
            <a href={`/stay/${routeSlug(stayPick)}`} class="hp-pick">
              <div class="hp-pick__img">
                <img src={resolveHeroSrc(stayPick.data)} alt={stayPick.data.heroImage?.alt ?? stayPick.data.name ?? 'Stay pick'} loading="lazy" decoding="async" />
              </div>
              <p class="hp-pick__tag">Stay</p>
              <h3 class="hp-pick__name">{stayPick.data.name}</h3>
              {stayPick.data.signature && (<p class="hp-pick__note">{stayPick.data.signature}</p>)}
            </a>
          )}
          {explorePick && (
            <a href={`/explore/${routeSlug(explorePick)}`} class="hp-pick">
              <div class="hp-pick__img">
                <img src={resolveHeroSrc(explorePick.data)} alt={explorePick.data.heroImage?.alt ?? explorePick.data.name ?? 'Explore pick'} loading="lazy" decoding="async" />
              </div>
              <p class="hp-pick__tag">Explore</p>
              <h3 class="hp-pick__name">{explorePick.data.name}</h3>
              {explorePick.data.editorNote && (
                <p class="hp-pick__note">{String(explorePick.data.editorNote).split('.')[0].trim()}.</p>
              )}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {editorPicks.length > 0 && (
    <Shortlist
      eyebrow="The Shortlist"
      title="Five pieces worth the <em>appointment</em>."
      dek="The handful we'd send a close friend to this issue, picked for the ratio of payoff to effort, not the view from the tasting room."
      link={{ label: 'Read all in the Journal', href: '/journal/' }}
      items={editorPicks.map((article, i) => ({
        rank: String(i + 1).padStart(2, '0'),
        meta: [
          formatLabel[article.data.format] ?? String(article.data.format ?? 'Editorial'),
          article.data.readingTimeMinutes ? `${article.data.readingTimeMinutes} min read` : 'Editorial',
          article.data.publishedAt
            ? new Date(article.data.publishedAt).toLocaleDateString('en-AU', { month: 'long', year: 'numeric' })
            : '',
        ].filter(Boolean),
        name: article.data.title,
        href: `/journal/${routeSlug(article)}`,
        why: article.data.dek,
        tags: (article.data.tags ?? []).slice(0, 2).map((t: string) => ({ label: String(t).replace(/-/g, ' ') })),
      }))}
    />
  )}

  <EditorsLetter
    eyebrow="Editor's Letter"
    title={`On the <em>quiet authority</em> of a good ${seasonBlurbData.label?.toLowerCase() ?? 'autumn'}.`}
    paragraphs={[
      `${seasonBlurbData.label ?? 'Autumn'} is the season the Peninsula stops performing. The weekend crowds thin, the vintage trucks finish their last runs, and the ridge takes on the colour it has for about six weeks a year.`,
      `We've rebuilt the cellar-door shortlist from scratch this season, visited every restaurant on the long-lunch list at least twice, and walked every beach on the ranking.`,
      `If this is your first issue with us, welcome. If you're returning, thanks for the patience through the refit.`,
    ]}
    pullQuote="This issue is built for the six weeks where the Peninsula is at its most itself, before winter settles in and the coast goes quiet."
    signatureName="The Editors"
    signatureRole="Peninsula Insider"
    image="/images/sourced/place-red-hill-01.webp"
    imageAlt="Vine rows in late-season colour, Red Hill"
    imageCaption="The last weekend of vintage, Red Hill, <em>the quietest a working winery ever gets.</em>"
  />

  <NewsletterBlock />
</BaseLayout>

{/* ─────────────────────────────────────────────────────────────────────────
   Cinematic hero styles. Self-contained, scoped to .cinema*.
   Below-fold sections inherit existing global styles.
   ───────────────────────────────────────────────────────────────────────── */}
<style is:global>
  .cinema {
    position: relative;
    min-height: 75vh;            /* three-quarter screen — next section peeks below */
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: #1E1B18;
    color: #FDFCFA;
  }

  /* ── Image layer ─────────────────────────────────────────────────────────── */
  .cinema__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cinema-scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }
  .cinema-scene.is-active {
    opacity: 1;
  }
  .cinema-scene img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    display: block;
    transform: scale(1.04);
    /* Ken Burns is applied only to the active scene to save battery. */
  }
  .cinema-scene.is-active img {
    animation: cinema-kenburns 28s ease-in-out infinite alternate;
  }
  @keyframes cinema-kenburns {
    0%   { transform: scale(1.04) translate3d(0, 0, 0); }
    100% { transform: scale(1.10) translate3d(-1.5%, -1%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cinema-scene.is-active img { animation: none; transform: scale(1.04); }
    .cinema-scene { transition: opacity 0.2s linear; }
  }

  /* ── Scrim — two layers stacked.
     1. Vertical gradient: top kept light, dark phase pulled UP to 35% so the
        copy block (~50–80% down) sits on real shade, not photo.
     2. Bottom-left radial vignette: localised dark wash anchored under the
        copy column. Reads as natural light fall-off, keeps the rest of the
        photo bright, and bites legibility back without flattening the image.
     ──────────────────────────────────────────────────────────────────────── */
  .cinema__scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      /* localised vignette behind the copy */
      radial-gradient(
        ellipse 70% 75% at 22% 88%,
        rgba(0, 0, 0, 0.62) 0%,
        rgba(0, 0, 0, 0.32) 45%,
        transparent 75%
      ),
      /* vertical scrim — dark phase starts higher */
      linear-gradient(
        to bottom,
        rgba(20, 18, 16, 0.32) 0%,
        rgba(20, 18, 16, 0.05) 18%,
        rgba(20, 18, 16, 0.18) 35%,
        rgba(20, 18, 16, 0.58) 65%,
        rgba(20, 18, 16, 0.88) 100%
      );
  }

  /* ── Local grain layer — slightly heavier than the global one ────────────── */
  .cinema__grain {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    opacity: 0.06;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 160px;
    mix-blend-mode: overlay;
  }

  /* ── Top chrome ──────────────────────────────────────────────────────────── */
  .cinema__top {
    position: absolute;
    z-index: 3;
    top: 0; left: 0; right: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 4vw, 3rem);
    pointer-events: none;
  }
  .cinema__brand {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    letter-spacing: 0.01em;
    color: #FDFCFA;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.55),
      0 1px 14px rgba(0, 0, 0, 0.4);
  }
  .cinema__issue {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(253, 252, 250, 0.92);
    display: flex;
    gap: 0.55rem;
    align-items: center;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.55),
      0 1px 14px rgba(0, 0, 0, 0.4);
  }
  .cinema__dot { color: rgba(253, 252, 250, 0.4); }

  /* ── Bottom copy block ───────────────────────────────────────────────────── */
  /* The copy column is a flex stack anchored to the bottom of the hero.
     Inside it, .cinema-copy-wrap grid-stacks the 5 zone variants so the wrap
     auto-sizes to the tallest one, and the CTAs flow normally beneath with
     real margin spacing — not a calculated offset. */
  .cinema__copy {
    position: relative;
    z-index: 3;
    align-self: flex-end;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .cinema-copy-wrap {
    display: grid;               /* all variants share grid cell 1/1 */
    grid-template-areas: "stack";
  }

  .cinema-copy {
    grid-area: stack;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 1.0s cubic-bezier(0.4, 0, 0.2, 1), transform 1.0s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    will-change: opacity, transform;
  }
  .cinema-copy.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .cinema-copy { transition: opacity 0.2s linear; transform: none; }
  }

  .cinema-copy__time {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1rem;            /* was 1.5rem — tightened gap to headline */
    padding-bottom: 0.85rem;     /* was 1rem — rule sits a touch closer */
    border-bottom: 1px solid rgba(253, 252, 250, 0.16);
    max-width: 24rem;
  }
  .cinema-copy__chip {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #C9A971;              /* gold, brightened slightly for contrast */
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.7),
      0 1px 18px rgba(0, 0, 0, 0.5);
  }
  .cinema-copy__hours {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(253, 252, 250, 0.75); /* was 0.55 — too faint over photo */
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.6),
      0 1px 16px rgba(0, 0, 0, 0.4);
  }

  .cinema-copy__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.025em;
    color: #FDFCFA;
    margin: 0 0 1.25rem;
    max-width: 14ch;
    /* Multi-stop shadow — tight ink under the type, soft halo behind it.
       Reads as printed type on paper, not as glow. */
    text-shadow:
      0 1px 1px rgba(0, 0, 0, 0.55),
      0 2px 8px rgba(0, 0, 0, 0.45),
      0 6px 32px rgba(0, 0, 0, 0.4);
  }
  .cinema-copy__headline em {
    font-style: italic;
    font-weight: 500;
    color: #C9A971;              /* gold, brightened to match chip */
    text-shadow:
      0 1px 1px rgba(0, 0, 0, 0.55),
      0 2px 12px rgba(0, 0, 0, 0.45),
      0 4px 28px rgba(120, 90, 40, 0.35);
  }

  .cinema-copy__dispatch {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;            /* was default 400 — italic at body size needs the bump */
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.55;
    color: #FDFCFA;              /* was rgba(...0.82) — full opacity for legibility */
    margin: 0;
    max-width: 48ch;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.6),
      0 2px 16px rgba(0, 0, 0, 0.45);
  }

  /* ── CTAs (constant, sit just below the copy block in normal flow) ───────── */
  .cinema__ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
