---
/**
 * Homepage — Editorial magazine cover for the Mornington Peninsula guide.
 *
 * Cover carousel: full article rotates (text + image together).
 * Below the fold: Section nav → Weekend Dispatch → Places rail → Plans
 *   → Shortlist → Editor's Letter → Notebook → Newsletter.
 *
 * Promoted from /preview-home-redesign/ on 2026-05-25, replacing the
 * cinematic fullbleed cover that lives in git history.
 *
 * Simplified 2026-06-10: ThreeMissionBar and MelbourneEntryStrip removed —
 * each routed intents (Ask / weekend / plans) that already have exactly one
 * surface elsewhere on this screen (Ask floating button, the Weekend
 * Dispatch card, the Plans grid). The Melbourne entry link now lives
 * inside WeekendPickerBlock.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Shortlist from '../components/Shortlist.astro';
import EditorsLetter from '../components/EditorsLetter.astro';
import PlaceCard from '../components/PlaceCard.astro';
import ItineraryCard from '../components/ItineraryCard.astro';
import WeekendPickerBlock from '../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import ScrollReveal from '../components/react/ScrollReveal.tsx';
import { routeSlug, dispatchWeekend } from '../lib/editorial';
import { loadPublishedHomepageOverrides, getHomepageAdminContent } from '../lib/content/homepage';
import { editableText, editableImage } from '../lib/inline-edit/attrs';
// ── CMS overrides ─────────────────────────────────────────────────────────
const cmsOverrides = await loadPublishedHomepageOverrides();
const cmsText  = cmsOverrides.textFieldsByPath;
const cmsImage = cmsOverrides.imageSlotsByPath;

// ── Core collections ───────────────────────────────────────────────────────
const articles    = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const places      = await getCollection('places');
const itineraries = await getCollection('itineraries');

const now = new Date();

// ── Quick notes (The Notebook) ─────────────────────────────────────────────
const notebookNote = (await getCollection('quickNotes', ({ data }) => data.status === 'published' && data.expiresAt > now))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
  [0] ?? null;

// ── Featured plans ─────────────────────────────────────────────────────────
const featuredPlanSlugs = [
  'ridge-to-sea-two-night-escape',
  'wellness-weekend',
  'sorrento-off-season-weekend',
];
const featuredPlans = featuredPlanSlugs
  .map((s) => itineraries.find((it) => routeSlug(it) === s))
  .filter(Boolean);
const fallbackPlans = itineraries
  .filter((it) => !featuredPlanSlugs.includes(routeSlug(it)))
  .slice(0, 3 - featuredPlans.length);
const planCards = [...featuredPlans, ...fallbackPlans].slice(0, 3);

// ── Below-fold editorial data ──────────────────────────────────────────────
const featured = articles.find((a) => a.data.featured && a.data.format !== 'weekend-picker')
  ?? articles.find((a) => a.data.format !== 'weekend-picker')
  ?? articles[0];

const weekendDispatch = articles
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))[0];

const dispatchWindow = weekendDispatch
  ? dispatchWeekend(weekendDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };

const editorPicks = articles
  .filter((a) => routeSlug(a) !== routeSlug(featured))
  .filter((a) =>
    ['the-chardonnay-case', 'three-italian-dinners', 'the-peninsula-pantry',
     'the-long-lunch', 'the-thermal-springs-weekend'].includes(routeSlug(a))
  )
  .slice(0, 3);

// ── Featured places ────────────────────────────────────────────────────────
const featuredPlaceSlugs = [
  'sorrento', 'red-hill', 'flinders', 'arthurs-seat',
  'rosebud', 'rye', 'portsea', 'blairgowrie', 'merricks', 'main-ridge',
];
const featuredPlaces = featuredPlaceSlugs
  .map((slug) => places.find((p) => routeSlug(p) === slug))
  .filter(Boolean);

const placesLabelRaw = cmsText['places.label'];
const placesLabel = /know the terrain/i.test(placesLabelRaw ?? '')
  ? 'Area guide'
  : placesLabelRaw ?? 'Area guide';
const placesTitleRaw = cmsText['places.title'];
const placesTitle = placesTitleRaw === 'The Peninsula, place by place'
  ? 'Explore the Peninsula'
  : placesTitleRaw ?? 'Explore the Peninsula';

// ── Cover scenes ───────────────────────────────────────────────────────────
const coverImageOverride = cmsImage['cover.image'];

interface Scene {
  id: string;
  label: string;
  hours: string;
  image: string;
  imageAlt: string;
  caption: string;
  headline: string;
  dispatch: string;
  primaryHref: string;
  primaryLabel: string;
}

const scenes: Scene[] = [
  {
    id: 'flinders-weekend',
    label: 'SLOW PENINSULA',
    hours: '7 MIN READ',
    image: '/images/sourced/explore-bushrangers-bay-walk-01.webp',
    imageAlt: 'Bushrangers Bay headland and Bass Strait below Cape Schanck, on the slow southern coast of the Mornington Peninsula',
    caption: 'Bushrangers Bay, south coast',
    headline: 'The <em>other</em> Peninsula weekend.',
    dispatch: 'When Red Hill is booked out and Sorrento feels like a queue, Flinders offers another version of the Peninsula weekend — south of everything, closer to the ocean, and slower on purpose.',
    primaryHref: '/journal/a-flinders-weekend/',
    primaryLabel: 'Read',
  },
  {
    id: 'winter-peninsula-weekend',
    label: 'FEATURE',
    hours: '8 MIN READ',
    image: '/images/sourced/home-cover-cape-schanck-rainbow-01.webp',
    imageAlt: 'Rain squall clearing over Cape Schanck bay in winter, rainbow arcing over mist-softened headland and steel-grey Bass Strait',
    caption: 'Cape Schanck, winter clearing',
    headline: 'A <em>winter</em> Peninsula weekend.',
    dispatch: 'Short days, empty dining rooms, a fire in every cellar door with a hearth, and a coast that looks like a different country in a southerly. The Peninsula in winter is its most underrated season.',
    primaryHref: '/journal/a-winter-peninsula-weekend/',
    primaryLabel: 'Read',
  },
  {
    id: 'late-walks',
    label: 'WALK',
    hours: '7 MIN READ',
    image: '/images/sourced/home-cover-back-beach-horses-01.jpg',
    imageAlt: 'Horses on a Peninsula ocean back beach, Bass Strait in the background',
    caption: 'Back beach, Bass Strait side',
    headline: 'When the light <em>starts improving.</em>',
    dispatch: 'Bushrangers Bay for a full reset. Cape Schanck boardwalk when time is short. Sorrento Back Beach for mood rather than route. The four walks that earn the second drink.',
    primaryHref: '/journal/the-peninsulas-best-late-afternoon-walks/',
    primaryLabel: 'Read',
  },
  {
    id: 'cover',
    label: cmsText['cover.label'] ?? 'FEATURE',
    hours: cmsText['cover.hours'] ?? '9 MIN READ',
    image: coverImageOverride?.src ?? '/images/sourced/category-restaurant-01.webp',
    imageAlt: coverImageOverride?.alt ?? 'Warm, polished restaurant interior with a marble bar, timber stools, and low lighting.',
    caption: coverImageOverride?.caption ?? cmsText['cover.caption'] ?? 'Peninsula dining room',
    headline: cmsText['cover.headline'] ?? 'The Hatted Restaurants of the <em>Peninsula.</em>',
    dispatch: cmsText['cover.dispatch'] ?? 'Four two-hat restaurants. Seven one-hat tables. Barragunda is the debut, Tedesca took Regional Restaurant of the Year, and Laura is still where the long lunch happens. The complete list, with booking realities.',
    primaryHref: cmsText['cover.primaryHref'] ?? '/journal/hatted-restaurants-mornington-peninsula-2025/',
    primaryLabel: cmsText['cover.primaryLabel'] ?? 'Read the cover story',
  },
  {
    id: 'cape-schanck',
    label: 'GUIDE',
    hours: '8 MIN READ',
    image: '/images/sourced/explore-cape-schanck-lighthouse-01.webp',
    imageAlt: 'Cape Schanck lighthouse above the basalt clifftop coastline, Mornington Peninsula National Park',
    caption: 'Cape Schanck, Mornington Peninsula National Park',
    headline: 'The lighthouse at the edge of <em>everything.</em>',
    dispatch: 'The 1859 limestone lighthouse, the boardwalk to Pulpit Rock, and the walk to Bushrangers Bay. The grounds are free from 6am. Here is the full structure of the day.',
    primaryHref: '/journal/cape-schanck-guide/',
    primaryLabel: 'Read the guide',
  },
];


export const prerender = true;
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula — best restaurants, cellar doors, beaches, walks, and places to stay. Every venue visited. Every opinion earned. Updated May 2026."
  section="home"
  canonical="https://peninsulainsider.com.au"
>

  {/* ── ZONE 1: Cover carousel — full article rotates (text + image together) */}
  <section class="cover" aria-label="Cover stories">
    <div class="cover__carousel" id="cover-carousel">
      {scenes.map((scene, i) => (
        <div class={`cover__slide${i === 0 ? ' is-active' : ''}`} data-slide-index={i}>
          <div class="container cover__slide-inner">
            <div class="cover__type">
              <p class="cover__meta">
                <span class="cover__chip">{scene.label}</span>
                <span class="cover__dot" aria-hidden="true">·</span>
                <span class="cover__hours">{scene.hours}</span>
              </p>
              <a href={scene.primaryHref} class="cover__headline-link">
                {i === 0
                  ? <h1 class="cover__headline" set:html={scene.headline} />
                  : <p class="cover__headline" set:html={scene.headline} />
                }
              </a>
              <p class="cover__dispatch">{scene.dispatch}</p>
            </div>
            <a href={scene.primaryHref} class="cover__visual-link" tabindex="-1" aria-hidden="true">
              <figure class="cover__visual">
                <div class="cover__visual-frame">
                  <img
                    src={scene.image}
                    alt={scene.imageAlt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                  />
                </div>
                {scene.caption && (
                  <figcaption class="cover__caption">{scene.caption}</figcaption>
                )}
              </figure>
            </a>
          </div>
        </div>
      ))}
    </div>

    {/* Story navigation — quiet progress bars, one per story. Labels were
        removed 2026-06-10: tiny uppercase tags ("SLOW PENINSULA", "WALK")
        read as content filters and meant nothing before the stories were
        seen. Accessible names carry the story headline instead. */}
    <nav class="cover__nav" aria-label="Switch story">
      <div class="container cover__nav-inner">
        {scenes.map((scene, i) => (
          <button
            class={`cover__nav-btn${i === 0 ? ' is-active' : ''}`}
            data-target={i}
            type="button"
            aria-label={`Story ${i + 1} of ${scenes.length}: ${scene.headline.replace(/<[^>]+>/g, '')}`}
          >
            <span class="cover__nav-bar" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </nav>
  </section>

  {/* ── ZONE 2: Section navigation strip ─────────────────────────────────── */}
  <nav class="hp-section-nav" aria-label="Browse sections">
    <div class="hp-section-nav__track">
      <a class="hp-section-nav__chip" href="/whats-on/">What&rsquo;s On</a>
      <a class="hp-section-nav__chip" href="/explore/plans/">Plans</a>
      <a class="hp-section-nav__chip" href="/eat/">Eat &amp; Drink</a>
      <a class="hp-section-nav__chip" href="/wine/">Wine</a>
      <a class="hp-section-nav__chip" href="/stay/">Stay</a>
      <a class="hp-section-nav__chip" href="/explore/places/">Places</a>
      <a class="hp-section-nav__chip" href="/explore/">Explore</a>
      <a class="hp-section-nav__chip" href="/journal/">Journal</a>
    </div>
  </nav>

  {/* ── ZONE 3: Weekend Dispatch ─────────────────────────────────────────── */}
  {weekendDispatch && (
    <ScrollReveal client:visible>
      <WeekendPickerBlock
        dispatch={weekendDispatch}
        weekend={`This weekend · ${dispatchWindow.label}`}
      />
    </ScrollReveal>
  )}

  {/* ── ZONE 6: Places rail ──────────────────────────────────────────────── */}
  {featuredPlaces.length > 0 && (
    <ScrollReveal client:visible>
    <section class="places places--compact">
      <div class="container">
        <div class="places__header">
          <p class="label label--accent places__label">{placesLabel}</p>
          <h2 class="places__title">{placesTitle}</h2>
          <p class="places__sub">{cmsText['places.sub'] ?? 'Start with the Peninsula destinations people search for first — the towns, villages and landmarks that anchor most trips.'}</p>
        </div>
        <div class="places__grid">
          {featuredPlaces.map((place, index) => (
            <PlaceCard
              place={place}
              variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'}
              showDetails={false}
            />
          ))}
        </div>
        <div class="places__footer">
          <a href="/explore/places/" class="venues__link">Explore all places →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 7: Plans grid ───────────────────────────────────────────────── */}
  {planCards.length > 0 && (
    <ScrollReveal client:visible>
    <section class="hp-plans">
      <div class="container">
        <div class="hp-plans__head">
          <p class="label label--accent">{cmsText['plans.label'] ?? 'Plans'}</p>
          <h2 class="hp-plans__title">{cmsText['plans.title'] ?? 'Or take the whole weekend.'}</h2>
          <p class="hp-plans__sub">{cmsText['plans.sub'] ?? 'Three editorial itineraries, built around a single anchor stay, paced for the way the Peninsula actually works.'}</p>
        </div>
        <div class="hp-plans__grid">
          {planCards.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
        </div>
        <div class="hp-plans__footer">
          <a href="/explore/plans/" class="venues__link">View Plans →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 8: Shortlist ────────────────────────────────────────────────── */}
  {editorPicks.length > 0 && (
    <ScrollReveal client:visible>
    <div class="hp-shortlist-wrap">
    <Shortlist
      eyebrow="The Shortlist"
      title="Three pieces worth the <em>appointment</em>."
      dek="The three we'd send a close friend to this issue, picked for the ratio of payoff to effort, not the view from the tasting room."
      link={{ label: 'View Journal', href: '/journal/' }}
      items={editorPicks.map((article) => ({
        rank: '',
        meta: [],
        name: article.data.title,
        href: `/journal/${routeSlug(article)}`,
        why: article.data.dek,
        tags: [],
      }))}
    />
    </div>
    </ScrollReveal>
  )}

  {/* ── ZONE 10: Editor's Letter ─────────────────────────────────────────── */}
  <ScrollReveal client:visible>
  {(() => {
    const elImage    = cmsImage['editors-letter.image'];
    const hpContent  = getHomepageAdminContent();
    const elDefaults = hpContent.editorsLetter;
    return (
      <EditorsLetter
        eyebrow={cmsText['editors-letter.eyebrow'] ?? elDefaults.eyebrow}
        title={cmsText['editors-letter.title'] ?? elDefaults.title}
        paragraphs={[
          cmsText['editors-letter.paragraphs.0'] ?? elDefaults.paragraphs[0],
          cmsText['editors-letter.paragraphs.1'] ?? elDefaults.paragraphs[1],
        ]}
        pullQuote={cmsText['editors-letter.pullQuote'] ?? elDefaults.pullQuote}
        signatureName={cmsText['editors-letter.signatureName'] ?? elDefaults.signatureName}
        signatureRole={cmsText['editors-letter.signatureRole'] ?? elDefaults.signatureRole}
        image={elImage?.src ?? elDefaults.image}
        imageAlt={elImage?.alt ?? elDefaults.imageAlt}
        imageCaption={elImage?.caption ?? elDefaults.imageCaption}
      />
    );
  })()}
  </ScrollReveal>

  {/* ── ZONE 11: Notebook ────────────────────────────────────────────────── */}
  {notebookNote && (
    <ScrollReveal client:visible>
      <section class="hp-notebook" aria-label="Today from The Notebook">
        <div class="container">
          <div class="hp-notebook__inner">
            <div class="hp-notebook__label">
              <p class="label label--accent">The Notebook</p>
            </div>
            <div class="hp-notebook__note">
              <p class="hp-notebook__section">{notebookNote.data.section === 'note' ? 'Editor' : notebookNote.data.section}</p>
              <a class="hp-notebook__headline" href={`/quick-note/${notebookNote.id.replace(/\.md$/, '')}/`}>
                {notebookNote.data.headline}
              </a>
              {notebookNote.data.verdict && (
                <p class="hp-notebook__verdict">{notebookNote.data.verdict}</p>
              )}
            </div>
            <div class="hp-notebook__link">
              <a href="/quick-note/" class="hp-notebook__more">The Notebook →</a>
            </div>
          </div>
        </div>
      </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 12: Newsletter ──────────────────────────────────────────────── */}
  <ScrollReveal client:visible>
    <NewsletterBlock />
  </ScrollReveal>

  {/* ── Cover carousel script ────────────────────────────────────────────── */}
  <script is:inline>
    (function () {
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var INTERVAL_MS = 10000;

      function initCarousel(el) {
        if (el.dataset.carouselReady) return; /* guard against double-init */
        var slides = Array.from(el.querySelectorAll('.cover__slide'));
        var navBtns = Array.from(document.querySelectorAll('.cover__nav-btn'));
        if (slides.length < 2) return;

        /* find initial active index from SSR class */
        var current = Math.max(0, slides.findIndex(function(s) { return s.classList.contains('is-active'); }));
        var timer;

        function setInert(slide, on) {
          if (on) { slide.setAttribute('inert', ''); slide.setAttribute('aria-hidden', 'true'); }
          else    { slide.removeAttribute('inert'); slide.removeAttribute('aria-hidden'); }
        }

        function goTo(idx) {
          var prev = current;
          current = ((idx % slides.length) + slides.length) % slides.length;
          if (prev === current) return;

          slides[prev].classList.remove('is-active');
          setInert(slides[prev], true);
          if (navBtns[prev]) navBtns[prev].classList.remove('is-active');

          slides[current].classList.add('is-active');
          setInert(slides[current], false);
          if (navBtns[current]) {
            navBtns[current].classList.remove('is-active');
            void navBtns[current].offsetWidth; /* force reflow to restart progress-bar animation */
            navBtns[current].classList.add('is-active');
          }
        }

        /* initialise inert on non-active slides */
        slides.forEach(function (s, i) { if (i !== current) setInert(s, true); });
        el.dataset.carouselReady = '1';

        navBtns.forEach(function (btn, i) {
          btn.addEventListener('click', function () {
            clearInterval(timer);
            goTo(i);
            if (!reducedMotion) timer = setInterval(function () { goTo(current + 1); }, INTERVAL_MS);
          });
        });

        if (!reducedMotion) {
          timer = setInterval(function () { goTo(current + 1); }, INTERVAL_MS);
        }
      }

      function setup() {
        var el = document.getElementById('cover-carousel');
        if (el) initCarousel(el);
      }
      document.addEventListener('astro:page-load', setup);
      setup();
    })();
  </script>


</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════════════════
     Option A typography — applied site-wide.
     Outfit + Cormorant Garamond, fixed across all sizes.
     Cormorant italic stripped below 28px where hairlines disappear.
  ═══════════════════════════════════════════════════════════════════════════ */

  /* 1 ── Body: Outfit stays, but weight and size fixed */
  body {
    font-size: 1rem !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
  }

  /* 2 ── Labels: bump minimum size */
  .label, [class*="__label"], [class*="__chip"],
  [class*="__tag"], [class*="__section"], [class*="__meta"] {
    font-size: max(0.72rem, 11.5px);
  }

  /* 3 ── Headings: Cormorant stays, enforce minimum sizes */
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.8rem); }
  h3 { font-size: clamp(1.25rem, 2.5vw, 1.9rem); }
  h4 { font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 500; }

  /* 4 ── Masthead tagline: strip Cormorant italic at ~15px → plain Outfit */
  .masthead__tagline {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal;
    font-weight: 300;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  /* 5 ── Cover dispatch: strip Cormorant italic → Outfit, clean weight */
  .cover__dispatch {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal !important;
    font-weight: 300;
    font-size: clamp(1rem, 1.5vw, 1.2rem) !important;
    line-height: 1.65;
    color: rgba(23, 20, 19, 0.68);
    letter-spacing: 0.01em;
  }

  /* 6 ── Melbourne strip: strip Cormorant italic → Outfit */
  .melb-strip__text {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal !important;
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    font-weight: 400;
  }

  /* 7 ── Notebook headline: was small Cormorant → Outfit medium */
  .hp-notebook__headline {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-weight: 500;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
  }

  /* ── Cover ──────────────────────────────────────────────────────────────── */
  .cover {
    background: #FFFFFF;
    color: #171413;
    padding: clamp(2rem, 4vw, 4rem) 0 clamp(0.75rem, 1.25vw, 1.25rem);
    border-bottom: 1px solid rgba(23, 20, 19, 0.08);
  }
  .cover__slide-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .cover__type { min-width: 0; }
  .cover__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(23, 20, 19, 0.16);
    max-width: 26rem;
  }
  .cover__chip {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.26em; text-transform: uppercase;
    color: #A0541F;
  }
  .cover__date, .cover__hours {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(23, 20, 19, 0.55);
  }
  .cover__dot { color: rgba(23, 20, 19, 0.3); font-size: 0.62rem; }
  .cover__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.8rem, 6.2vw, 5.6rem);
    font-weight: 500; line-height: 0.96;
    letter-spacing: -0.025em; color: #171413;
    margin: 0 0 1.5rem; max-width: 14ch;
  }
  .cover__headline em { font-style: italic; font-weight: 500; color: #A0541F; }
  .cover__dispatch {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    line-height: 1.55; color: rgba(23, 20, 19, 0.75);
    margin: 0 0 2rem; max-width: 42ch;
  }
  /* Headline is the primary click target */
  .cover__headline-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .cover__headline-link:hover .cover__headline { opacity: 0.78; }
  /* Image link — decorative duplicate of headline link */
  .cover__visual-link {
    display: contents;
