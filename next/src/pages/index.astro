---
/**
 * Homepage - Editorial magazine cover for the Mornington Peninsula guide.
 *
 * Cover carousel: full article rotates (text + image together).
 * Below the fold: Section nav → Weekend Dispatch → Places rail → Plans
 *   → Shortlist → Editor's Letter → Notebook → Newsletter.
 *
 * Promoted from /preview-home-redesign/ on 2026-05-25, replacing the
 * cinematic fullbleed cover that lives in git history.
 *
 * Simplified 2026-06-10: ThreeMissionBar and MelbourneEntryStrip removed - * each routed intents (Ask / weekend / plans) that already have exactly one
 * surface elsewhere on this screen (Ask floating button, the Weekend
 * Dispatch card, the Plans grid). The Melbourne entry link now lives
 * inside WeekendPickerBlock.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Shortlist from '../components/Shortlist.astro';
import EditorsLetter from '../components/EditorsLetter.astro';
import PlaceCard from '../components/PlaceCard.astro';
import ItineraryCard from '../components/ItineraryCard.astro';
import WeekendPickerBlock from '../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import EventCard from '../components/EventCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ScrollReveal from '../components/react/ScrollReveal.tsx';
import { routeSlug, dispatchWeekend } from '../lib/editorial';
import { loadPublishedHomepageOverrides, getHomepageAdminContent } from '../lib/content/homepage';
import HomeHeroCarousel from '../components/HomeHeroCarousel.astro';
// ── CMS overrides ─────────────────────────────────────────────────────────
const cmsOverrides = await loadPublishedHomepageOverrides();
const cmsText  = cmsOverrides.textFieldsByPath;
const cmsImage = cmsOverrides.imageSlotsByPath;

// ── Core collections ───────────────────────────────────────────────────────
const articles    = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const places      = await getCollection('places');
const itineraries = await getCollection('itineraries');

const now = new Date();

// ── Quick notes (The Notebook) ─────────────────────────────────────────────
const notebookNote = (await getCollection('quickNotes', ({ data }) => data.status === 'published' && data.expiresAt > now))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
  [0] ?? null;

// ── Featured plans ─────────────────────────────────────────────────────────
const featuredPlanSlugs = [
  'ridge-to-sea-two-night-escape',
  'wellness-weekend',
  'sorrento-off-season-weekend',
];
const featuredPlans = featuredPlanSlugs
  .map((s) => itineraries.find((it) => routeSlug(it) === s))
  .filter(Boolean);
const fallbackPlans = itineraries
  .filter((it) => !featuredPlanSlugs.includes(routeSlug(it)))
  .slice(0, 3 - featuredPlans.length);
const planCards = [...featuredPlans, ...fallbackPlans].slice(0, 3);

// ── Below-fold editorial data ──────────────────────────────────────────────
const featured = articles.find((a) => a.data.featured && a.data.format !== 'weekend-picker')
  ?? articles.find((a) => a.data.format !== 'weekend-picker')
  ?? articles[0];

const weekendDispatch = articles
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))[0];

const dispatchWindow = weekendDispatch
  ? dispatchWeekend(weekendDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };

// ── Events on this weekend (Vivid-style rail, Phase 4) ─────────────────────
// Only events genuinely on during the dispatch weekend: date range overlaps
// Sat–Sun, or a computed nextOccurrence falls inside it. Avoids the old
// "1 April – 30 June under a weekend heading" failure.
const wkStart = dispatchWindow.sat;
const wkEnd = new Date(dispatchWindow.sun.getTime() + 86399999);
const weekendEvents = (await getCollection('events'))
  .filter((e) => e.data.status !== 'archived' && e.data.status !== 'draft')
  .filter((e) => {
    const start = e.data.startDate;
    const end = (e.data as any).endDate ?? e.data.startDate;
    const occ = (e.data as any).nextOccurrence;
    const rangeOverlaps = start && start <= wkEnd && end >= wkStart;
    const occurrenceIn = occ && occ >= wkStart && occ <= wkEnd;
    return rangeOverlaps || occurrenceIn;
  })
  .sort((a, b) => {
    const ka = ((a.data as any).nextOccurrence ?? a.data.startDate)?.getTime() ?? 0;
    const kb = ((b.data as any).nextOccurrence ?? b.data.startDate)?.getTime() ?? 0;
    return ka - kb;
  })
  .slice(0, 8);

const editorPicks = articles
  .filter((a) => routeSlug(a) !== routeSlug(featured))
  .filter((a) =>
    ['the-chardonnay-case', 'three-italian-dinners', 'the-peninsula-pantry',
     'the-long-lunch', 'the-thermal-springs-weekend'].includes(routeSlug(a))
  )
  .slice(0, 3);

// ── Featured places ────────────────────────────────────────────────────────
const featuredPlaceSlugs = [
  'sorrento', 'red-hill', 'flinders', 'arthurs-seat',
  'rosebud', 'rye', 'portsea', 'blairgowrie', 'merricks', 'main-ridge',
];
const featuredPlaces = featuredPlaceSlugs
  .map((slug) => places.find((p) => routeSlug(p) === slug))
  .filter(Boolean);

const placesLabelRaw = cmsText['places.label'];
const placesLabel = /know the terrain/i.test(placesLabelRaw ?? '')
  ? 'Area guide'
  : placesLabelRaw ?? 'Area guide';
const placesTitleRaw = cmsText['places.title'];
const placesTitle = placesTitleRaw === 'The Peninsula, place by place'
  ? 'Explore the Peninsula'
  : placesTitleRaw ?? 'Explore the Peninsula';

// The cover carousel lives in <HomeHeroCarousel /> (src/components). It owns
// its data resolution (single source: CMS override -> home-hero-slides.json),
// inline-edit bindings, markup, and script. The `.cover*` CSS stays in this
// page's <style is:global> below (it depends on load order to neutralise the
// legacy sitewide /assets/styles.css `.cover` reset).

export const prerender = true;
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula - best restaurants, cellar doors, beaches, walks, and places to stay. Every venue visited. Every opinion earned."
  section="home"
  canonical="https://peninsulainsider.com.au"
>

  {/* ── ZONE 1: Cover carousel - full-screen slides, images + text editable
      in place. Self-contained component (data, markup, script). CSS lives in
      this page's <style is:global> below. */}
  <HomeHeroCarousel />

  {/* ── ZONE 2: Big-four section rows (Vivid-style, Phase 3) - navigation
      presented as content: four giant display rows with trailing arrows,
      then a quiet secondary line for the journey sections. Mobile only;
      desktop has the mega-menu pillars. */}
  <nav class="hp-big4" aria-label="Browse sections">
    <div class="container">
      {[
        { label: 'Eat & Drink', href: '/eat/' },
        { label: 'Wine', href: '/wine/' },
        { label: 'Stay', href: '/stay/' },
        { label: 'Explore', href: '/explore/' },
      ].map((item) => (
        <a class="hp-big4__row" href={item.href}>
          <span class="hp-big4__name">{item.label}</span>
          <svg class="hp-big4__arrow" viewBox="0 0 18 14" width="20" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 7h15M11 1.5 16.5 7 11 12.5" />
          </svg>
        </a>
      ))}
      <div class="hp-big4__secondary">
        <a href="/whats-on/">What&rsquo;s On</a>
        <span class="hp-big4__dot" aria-hidden="true">·</span>
        <a href="/explore/plans/">Plans</a>
        <span class="hp-big4__dot" aria-hidden="true">·</span>
        <a href="/journal/">Journal</a>
      </div>
    </div>
  </nav>

  {/* ── ZONE 3: Weekend Dispatch ─────────────────────────────────────────── */}
  {weekendDispatch && (
    <ScrollReveal client:visible>
      <WeekendPickerBlock
        dispatch={weekendDispatch}
        weekend={`This weekend · ${dispatchWindow.label}`}
      />
    </ScrollReveal>
  )}

  {/* ── ZONE 3.5: "On this weekend" rail (Vivid-style, Phase 4) ──────────── */}
  {weekendEvents.length > 0 && (
    <section class="hp-rail" aria-label="On this weekend">
      <div class="container">
        <div class="hp-rail__head">
          <h2 class="hp-rail__title">On this weekend</h2>
          <div class="hp-rail__actions">
            <div class="hp-rail__nav">
              <button type="button" class="hp-rail__arrow" data-rail-prev aria-label="Scroll left">←</button>
              <button type="button" class="hp-rail__arrow" data-rail-next aria-label="Scroll right">→</button>
            </div>
            <a class="hp-rail__more" href="/whats-on/">More What&rsquo;s On <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <div class="hp-rail__track">
        {weekendEvents.map((event) => {
          const occ = (event.data as any).nextOccurrence;
          const start = event.data.startDate;
          const fmt = (d: Date) => d.toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Australia/Melbourne' });
          const label = occ && occ >= wkStart && occ <= wkEnd
            ? fmt(occ)
            : start && start >= wkStart
            ? fmt(start)
            : 'On this weekend';
          return <EventCard event={event} dateLabelOverride={label} />;
        })}
      </div>
    </section>
  )}

  {/* Arrow paging for the card rails. No wheel/drag capture - the page scrolls
      normally over the rail; the desktop arrows just nudge the native
      horizontally-scrollable track left/right and disable at the ends. */}
  <script is:inline>
    (function () {
      function bindRail(rail) {
        if (rail.__navBound) return;
        var track = rail.querySelector('.hp-rail__track');
        var prev = rail.querySelector('[data-rail-prev]');
        var next = rail.querySelector('[data-rail-next]');
        if (!track || !prev || !next) return;
        rail.__navBound = true;

        function page(dir) {
          var amount = Math.max(track.clientWidth * 0.8, 280);
          track.scrollBy({ left: dir * amount, behavior: 'smooth' });
        }
        function update() {
          var max = track.scrollWidth - track.clientWidth;
          prev.disabled = track.scrollLeft <= 1;
          next.disabled = track.scrollLeft >= max - 1;
        }
        prev.addEventListener('click', function () { page(-1); });
        next.addEventListener('click', function () { page(1); });
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
      function setup() { document.querySelectorAll('.hp-rail').forEach(bindRail); }
      setup();
      document.addEventListener('astro:page-load', setup);
    })();
  </script>

  {/* ── ZONE 6: Places rail ──────────────────────────────────────────────── */}
  {featuredPlaces.length > 0 && (
    <ScrollReveal client:visible>
    <section class="places places--compact">
      <div class="container">
        <div class="places__header">
          <p class="label label--accent places__label">{placesLabel}</p>
          <h2 class="places__title">{placesTitle}</h2>
          <p class="places__sub">{cmsText['places.sub'] ?? 'Start with the Peninsula destinations people search for first - the towns, villages and landmarks that anchor most trips.'}</p>
        </div>
        <div class="places__grid">
          {featuredPlaces.map((place, index) => (
            <PlaceCard
              place={place}
              variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'}
              showDetails={false}
            />
          ))}
        </div>
        <div class="places__footer">
          <a href="/explore/places/" class="venues__link">Explore all places →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 7: Plans grid ───────────────────────────────────────────────── */}
  {planCards.length > 0 && (
    <ScrollReveal client:visible>
    <section class="hp-plans">
      <div class="container">
        <div class="hp-plans__head">
          <p class="label label--accent">{cmsText['plans.label'] ?? 'Plans'}</p>
          <h2 class="hp-plans__title">{cmsText['plans.title'] ?? 'Or take the whole weekend.'}</h2>
          <p class="hp-plans__sub">{cmsText['plans.sub'] ?? 'Three editorial itineraries, built around a single anchor stay, paced for the way the Peninsula actually works.'}</p>
        </div>
        <div class="hp-plans__grid">
          {planCards.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
        </div>
        <div class="hp-plans__footer">
          <a href="/explore/plans/" class="venues__link">View Plans →</a>
        </div>
      </div>
    </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 7.5: "From the Journal" rail - mobile counterpart of the
      desktop Shortlist below (hp-shortlist-wrap is hidden ≤767px). */}
  {editorPicks.length > 0 && (
    <section class="hp-rail hp-rail--journal" aria-label="From the Journal">
      <div class="container">
        <div class="hp-rail__head">
          <h2 class="hp-rail__title">From the Journal</h2>
          <a class="hp-rail__more" href="/journal/">View Journal <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hp-rail__track">
        {editorPicks.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
  )}

  {/* ── ZONE 8: Shortlist ────────────────────────────────────────────────── */}
  {editorPicks.length > 0 && (
    <ScrollReveal client:visible>
    <div class="hp-shortlist-wrap">
    <Shortlist
      eyebrow="The Shortlist"
      title="Three pieces worth the <em>appointment</em>."
      dek="The three we'd send a close friend to this issue, picked for the ratio of payoff to effort, not the view from the tasting room."
      link={{ label: 'View Journal', href: '/journal/' }}
      items={editorPicks.map((article) => ({
        rank: '',
        meta: [],
        name: article.data.title,
        href: `/journal/${routeSlug(article)}`,
        why: article.data.dek,
        tags: [],
      }))}
    />
    </div>
    </ScrollReveal>
  )}

  {/* ── ZONE 10: Editor's Letter ─────────────────────────────────────────── */}
  <ScrollReveal client:visible>
  {(() => {
    const elImage    = cmsImage['editors-letter.image'];
    const hpContent  = getHomepageAdminContent();
    const elDefaults = hpContent.editorsLetter;
    return (
      <EditorsLetter
        eyebrow={cmsText['editors-letter.eyebrow'] ?? elDefaults.eyebrow}
        title={cmsText['editors-letter.title'] ?? elDefaults.title}
        paragraphs={[
          cmsText['editors-letter.paragraphs.0'] ?? elDefaults.paragraphs[0],
          cmsText['editors-letter.paragraphs.1'] ?? elDefaults.paragraphs[1],
        ]}
        pullQuote={cmsText['editors-letter.pullQuote'] ?? elDefaults.pullQuote}
        signatureName={cmsText['editors-letter.signatureName'] ?? elDefaults.signatureName}
        signatureRole={cmsText['editors-letter.signatureRole'] ?? elDefaults.signatureRole}
        image={elImage?.src ?? elDefaults.image}
        imageAlt={elImage?.alt ?? elDefaults.imageAlt}
        imageCaption={elImage?.caption ?? elDefaults.imageCaption}
      />
    );
  })()}
  </ScrollReveal>

  {/* ── ZONE 11: Notebook ────────────────────────────────────────────────── */}
  {notebookNote && (
    <ScrollReveal client:visible>
      <section class="hp-notebook" aria-label="Today from The Notebook">
        <div class="container">
          <div class="hp-notebook__inner">
            <div class="hp-notebook__label">
              <p class="label label--accent">The Notebook</p>
            </div>
            <div class="hp-notebook__note">
              <p class="hp-notebook__section">{notebookNote.data.section === 'note' ? 'Editor' : notebookNote.data.section}</p>
              <a class="hp-notebook__headline" href={`/quick-note/${notebookNote.id.replace(/\.md$/, '')}/`}>
                {notebookNote.data.headline}
              </a>
              {notebookNote.data.verdict && (
                <p class="hp-notebook__verdict">{notebookNote.data.verdict}</p>
              )}
            </div>
            <div class="hp-notebook__link">
              <a href="/quick-note/" class="hp-notebook__more">The Notebook →</a>
            </div>
          </div>
        </div>
      </section>
    </ScrollReveal>
  )}

  {/* ── ZONE 12: Newsletter ──────────────────────────────────────────────── */}
  <ScrollReveal client:visible>
    <NewsletterBlock />
  </ScrollReveal>


</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════════════════
     Option A typography - applied site-wide.
     Outfit + Cormorant Garamond, fixed across all sizes.
     Cormorant italic stripped below 28px where hairlines disappear.
  ═══════════════════════════════════════════════════════════════════════════ */

  /* 1 ── Body: Outfit stays, but weight and size fixed */
  body {
    font-size: 1rem !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
  }

  /* 2 ── Labels: bump minimum size */
  .label, [class*="__label"], [class*="__chip"],
  [class*="__tag"], [class*="__section"], [class*="__meta"] {
    font-size: max(0.72rem, 11.5px);
  }

  /* 3 ── Headings: Cormorant stays, enforce minimum sizes */
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.8rem); }
  h3 { font-size: clamp(1.25rem, 2.5vw, 1.9rem); }
  h4 { font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 500; }

  /* 4 ── Masthead tagline: strip Cormorant italic at ~15px → plain Outfit */
  .masthead__tagline {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal;
    font-weight: 300;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }

  /* 5 ── Cover dispatch: strip Cormorant italic → Outfit, clean weight */
  .cover__dispatch {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal !important;
    font-weight: 300;
    font-size: clamp(1rem, 1.5vw, 1.2rem) !important;
    line-height: 1.65;
    color: rgba(23, 20, 19, 0.68);
    letter-spacing: 0.01em;
  }

  /* 6 ── Melbourne strip: strip Cormorant italic → Outfit */
  .melb-strip__text {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-style: normal !important;
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    font-weight: 400;
  }

  /* 7 ── Notebook headline: was small Cormorant → Outfit medium */
  .hp-notebook__headline {
    font-family: 'Outfit', system-ui, sans-serif !important;
    font-weight: 500;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
  }

  /* ── Cover - Vivid-style full-screen slider ─────────────────────────────
     Full-bleed photo, warm-dark scrim, overlay bottom-left, control strip
     along the bottom edge. Height fills the viewport under the masthead;
     svh keeps iOS URL-bar collapse from causing jumps. --masthead-h is
     tuned per breakpoint below. */
  .cover {
    position: relative;
    /* Neutralise the legacy /assets/styles.css .cover rules (editorial
       padding + border) - that stylesheet still loads first sitewide. */
    padding: 0;
    border: 0;
    background: var(--bg-dark);
    --masthead-h: 150px;          /* desktop: utility + brand + nav rows */
    /* Desktop 60% / mobile 75% of the viewport below the masthead
       (desktop set to 60% per James, 2026-06-18) - the next section peeks
       above the fold as a scroll affordance. Mobile ratio is in the mobile block. */
    --cover-ratio: 0.6;
    --cover-h: calc((100svh - var(--masthead-h)) * var(--cover-ratio));
  }
  @supports not (height: 100svh) {
    .cover { --cover-h: calc((100vh - var(--masthead-h)) * var(--cover-ratio)); }
  }
  .cover__carousel { display: grid; }
  .cover__slide {
    grid-area: 1 / 1;
    position: relative;
    z-index: 0;
    /* Grow-to-fit (James, 2026-06-20): the slide is AT LEAST --cover-h tall
       (clamped 430–960px), but it is no longer a fixed, clip-to-fit box. The
       overlay flows in this grid and bottom-aligns, so a tall headline +
       standfirst + CTA pushes the slide taller instead of being clipped off
       the top edge under the masthead. min-height (not height) is the key. */
    display: grid;
    min-height: clamp(430px, var(--cover-h), 960px);
    overflow: hidden;
    pointer-events: none;
  }
  .cover__slide.is-active {
    z-index: 1;
    pointer-events: auto;
    animation: cover-slide-in 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  /* Before JS initialises, hide non-first slides so no content bleed */
  .cover__carousel:not([data-carousel-ready]) .cover__slide:not(:first-child) {
    display: none;
  }
  @keyframes cover-slide-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover__slide.is-active { animation: none; }
  }

  .cover__media, .cover__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .cover__media img { object-fit: cover; display: block; }
  /* Warm-dark scrim - guarantees headline + standfirst contrast on ANY
     photo, including pale skies and bright sand (James, 2026-06-18).
     Three layers, concentrated bottom-left where the type sits so the
     centre of the photo keeps its brightness:
       1. a strong radial pool behind the text column, large enough to
          cover a 3-line headline;
       2. a vertical floor that deepens toward the bottom edge (CTA +
          control strip) and eases to a light wash up top;
       3. a faint uniform veil so a blown-out photo still holds white type.
     Per-slide control: --scrim multiplies the whole scrim (default 1).
     Raise it for very bright photos, lower it for already-dark ones - set `"scrim": <number>` on a slide in home-hero-slides.json. */
  .cover__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(135% 125% at 6% 100%,
        rgba(16, 12, 8, 0.80) 0%,
        rgba(16, 12, 8, 0.52) 30%,
        rgba(16, 12, 8, 0.22) 56%,
        rgba(16, 12, 8, 0) 80%),
      linear-gradient(180deg,
        rgba(16, 12, 8, 0.05) 0%,
        rgba(16, 12, 8, 0.12) 42%,
        rgba(16, 12, 8, 0.50) 72%,
        rgba(16, 12, 8, 0.86) 100%),
      linear-gradient(rgba(16, 12, 8, 0.07), rgba(16, 12, 8, 0.07));
    opacity: var(--scrim, 1);
  }

  .cover__overlay {
    /* In flow within the slide grid, pinned to the bottom - so the overlay's
       own height sets the slide's floor and the top lines (meta + headline)
       can never be clipped, however tall the type or short the viewport. */
    position: relative;
    grid-area: 1 / 1;
    align-self: end;
    z-index: 2;
    margin: 0 auto;               /* .container handles max-width + padding */
    padding-top: 2rem;            /* breathing room when the overlay drives height */
    padding-bottom: 5.25rem;      /* clears the control strip */
    color: #FDFCFA;
  }
  .cover__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1rem;
    text-shadow: 0 1px 10px rgba(8, 6, 4, 0.5);
  }
  .cover__chip {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.26em; text-transform: uppercase;
    color: #F5DCB2;
  }
  .cover__hours {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(253, 252, 250, 0.75);
  }
  .cover__dot { color: rgba(253, 252, 250, 0.45); font-size: 0.62rem; }
  .cover__headline-link { text-decoration: none; color: inherit; display: block; }
  .cover__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
