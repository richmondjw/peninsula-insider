---
/** Home, six sections (Phase 5 "say it once", 2026-11-10):
 * welcome → plan your day (chooser + three plans) → this weekend →
 * three ways in (orientation map) → one Journal feature → the Insider Note.
 * Interest doors were removed (they repeated the header nav and the plan
 * photographs); Play lives in the masthead and footer.
 * Published image overrides retain their own metadata. SEO identity is preserved.
 */
import ImageFormatFallback from '../components/ImageFormatFallback.astro';
import HomeCover from '../components/v5/home/HomeCover.astro';
import HomeWeekend from '../components/v5/home/HomeWeekend.astro';
import HomeOrientation from '../components/v5/home/HomeOrientation.astro';
import HomePlan from '../components/v5/home/HomePlan.astro';
import HomeJournalFeature from '../components/v5/home/HomeJournalFeature.astro';
import HomeDispatch from '../components/v5/home/HomeDispatch.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula - best restaurants, cellar doors, beaches, walks, and places to stay. Every pick earns its place. Every verdict has a reason."
  section="home"
  canonical="https://peninsulainsider.com.au"
>
  <ImageFormatFallback />
  <HomeCover />
  <HomePlan />
  <HomeWeekend />
  <HomeOrientation />
  <HomeJournalFeature />
  <HomeDispatch />
</BaseLayout>
