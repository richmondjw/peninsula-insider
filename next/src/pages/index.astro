---
/** Home editorial sequence: welcome, day planner, curated venues, weekend events,
 * seasonal reading, orientation, flagship story and newsletter.
 * 2026-11-17: add two bounded discovery sections without replacing the planner.
 * Published image metadata and SEO identity are preserved.
 */
import ImageFormatFallback from '../components/ImageFormatFallback.astro';
import HomeInsiderPicks from '../components/v5/home/HomeInsiderPicks.astro';
import HomeSeasonalEdit from '../components/v5/home/HomeSeasonalEdit.astro';
import HomeCover from '../components/v5/home/HomeCover.astro';
import HomeWeekend from '../components/v5/home/HomeWeekend.astro';
import HomeOrientation from '../components/v5/home/HomeOrientation.astro';
import HomePlan from '../components/v5/home/HomePlan.astro';
import HomeJournalFeature from '../components/v5/home/HomeJournalFeature.astro';
import HomeDispatch from '../components/v5/home/HomeDispatch.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula - best restaurants, cellar doors, beaches, walks, and places to stay. Every pick earns its place. Every verdict has a reason."
  section="home"
  canonical="https://peninsulainsider.com.au"
>
  <ImageFormatFallback />
  <HomeCover />
  <HomePlan />
  <HomeInsiderPicks />
  <HomeWeekend />
  <HomeSeasonalEdit />
  <HomeOrientation />
  <HomeJournalFeature />
  <HomeDispatch />
</BaseLayout>

<style>
/* Allow enlarged type to reflow the homepage masthead instead of pushing controls offscreen. */
:global(body[data-path="/"] .masthead-row){flex-wrap:wrap;height:auto;row-gap:var(--space-2)}
 :global(body[data-path="/"] .brand-lockup){min-width:0;max-width:100%}
 :global(body[data-path="/"] .brand){white-space:normal;overflow-wrap:anywhere}
 :global(body[data-path="/"] .site-nav){flex-wrap:wrap;max-width:100%;row-gap:0}
@media(max-width:767px){:global(body[data-path="/"] .masthead-row){padding-block:var(--space-2)}}
</style>
