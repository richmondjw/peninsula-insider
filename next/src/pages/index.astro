---
/**
 * Homepage — Cinematic cover for the issue's spotlight article.
 *
 * Full-bleed editorial cover, magazine-style. One image, one cover line,
 * one PI dispatch tied to the current spotlight. Scrim + grain + Ken Burns
 * drift carry the cinematic feel; rules in BRAND-PI.md govern voice.
 *
 * Below the fold the existing editorial layout resumes:
 * Weekend Picker → Places rail → Three picks → Shortlist → Editor's Letter
 * → Newsletter.
 *
 * Spotlight is set in the `scenes` array near the top of the script block.
 * The array + grid-stack scaffold is preserved so a rotator (time-of-day,
 * monthly cover swap, three editor's picks) can be reintroduced cleanly —
 * see the "No client-side picker" comment further down for the entry point.
 *
 * Honours prefers-reduced-motion (no Ken Burns drift).
 * Promoted from /preview-cinematic/ on 2026-05-08, replacing the
 * HomeCover-based magazine layout that lives in git history at HEAD~1.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Shortlist from '../components/Shortlist.astro';
import EditorsLetter from '../components/EditorsLetter.astro';
import PlaceCard from '../components/PlaceCard.astro';
import ItineraryCard from '../components/ItineraryCard.astro';
import EventCard from '../components/EventCard.astro';
import WeekendPickerBlock from '../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { formatLabel, routeSlug, stayTypes, currentSeason, seasonBlurb, dispatchWeekend, resolveHeroSrc, isUpcoming, melbourneDateKey } from '../lib/editorial';
import { eventInWindow } from '../lib/events';
import { loadPublishedHomepageOverrides } from '../lib/content/homepage';
import { editableText, editableImage } from '../lib/inline-edit/attrs';

// CMS-driven overrides for editor-controlled fields on the homepage. Empty
// when Supabase is unconfigured or no rows are published; falls through to
// the inline defaults below in that case. Per-field use only — dynamic
// seasonal copy still wins when nothing is published.
const cmsOverrides = await loadPublishedHomepageOverrides();
const cmsText = cmsOverrides.textFieldsByPath;
const cmsImage = cmsOverrides.imageSlotsByPath;

// `now` is declared at the top so every data block below can reference it
// without hitting the temporal dead zone. Used by event-recency filters
// and the cinema scene picker.
const now = new Date();

const venues      = await getCollection('venues');
const articles    = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const places      = await getCollection('places');
const experiences = await getCollection('experiences');
const itineraries = await getCollection('itineraries');

// Homepage Plans card grid (Wave 3 prep, 2026-05-10) — rebalances the
// homepage hierarchy so Plans gets visible weight per Strategic Review §6.
// Picks three itineraries that span the editorial range: a two-night
// sweet-spot weekend, a longer reset, and a short-form quick escape.
// Falls through to publish order if any of the named slugs are missing.
const featuredPlanSlugs = [
  'ridge-to-sea-two-night-escape',
  'wellness-weekend',
  'sorrento-off-season-weekend',
];
const featuredPlans = featuredPlanSlugs
  .map((s) => itineraries.find((it) => routeSlug(it) === s))
  .filter(Boolean);
const fallbackPlans = itineraries
  .filter((it) => !featuredPlanSlugs.includes(routeSlug(it)))
  .slice(0, 3 - featuredPlans.length);
const planCards = [...featuredPlans, ...fallbackPlans].slice(0, 3);

// ── Below-fold data (mirrors index.astro so the integration is visible) ─────
const featured = articles.find((a) => a.data.featured && a.data.format !== 'weekend-picker')
  ?? articles.find((a) => a.data.format !== 'weekend-picker')
  ?? articles[0];

const weekendDispatch = articles
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];
const dispatchWindow = weekendDispatch
  ? dispatchWeekend(weekendDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };

// ── Peninsula Insider Picks This Weekend ─────────────────────────────────
// Surfaces the canonical weekly editorial shortlist on the homepage. Same
// data source as /whats-on/: the `weekend-picks` content collection (when
// curated) with fallback to events tagged `lens: weekend-pick`. Sliced to
// the top 3 here — full list lives at /whats-on/#picks.
const events = (await getCollection('events', ({ data }) => data.status === 'published'))
  .filter((event) => {
    const cancelled = /cancelled/i.test(event.data.verificationStatus ?? '') || /^cancelled:/i.test(event.data.summary ?? '');
    if (cancelled) return false;
    if (['weekly', 'monthly', 'ongoing'].includes(event.data.recurrence)) return true;
    const end = event.data.endDate ?? event.data.startDate;
    return isUpcoming(end, now);
  })
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());

const nextWeekendEvents = events.filter((event) =>
  eventInWindow(event, dispatchWindow.start, dispatchWindow.end)
);

const weekendPicksOverrides = await getCollection('weekend-picks', ({ data }) =>
  melbourneDateKey(data.weekendStart) === melbourneDateKey(dispatchWindow.start)
);
const weekendPicksEntry = weekendPicksOverrides[0];

const eventsBySlug = new Map(events.map((e) => [e.data.slug, e] as const));

type HomeWeekendPick = {
  event: typeof events[number];
  verdictOverride?: string;
  featured: boolean;
};

const homeWeekendPicks: HomeWeekendPick[] = weekendPicksEntry
  ? [...weekendPicksEntry.data.picks]
      .sort((a, b) => a.position - b.position)
      .map((p) => {
        const ev = eventsBySlug.get(p.eventSlug);
        return ev ? { event: ev, verdictOverride: p.editorVerdict, featured: p.featured } : null;
      })
      .filter((x): x is HomeWeekendPick => x !== null)
      .slice(0, 3)
  : nextWeekendEvents
      .filter((event) => event.data.lens.includes('weekend-pick'))
      .slice(0, 3)
      .map((event, i) => ({ event, featured: i === 0 }));

const editorPicks = articles
  .filter((a) => routeSlug(a) !== routeSlug(featured))
  .filter((a) =>
    ['the-chardonnay-case', 'three-italian-dinners', 'the-peninsula-pantry',
     'the-long-lunch', 'the-thermal-springs-weekend'].includes(routeSlug(a))
  )
  .slice(0, 5);

const eatPick = venues.find((v) => routeSlug(v) === 'laura')
  ?? venues.find((v) => routeSlug(v) === 'ten-minutes-by-tractor')
  ?? venues.filter((v) => v.data.type === 'restaurant')[0];

const stayPick = venues.find((v) => routeSlug(v) === 'jackalope')
  ?? venues.filter((v) => stayTypes.includes(v.data.type))[0];

const explorePick = experiences.find((e) => routeSlug(e) === 'bushrangers-bay-walk')
  ?? experiences[0];

const featuredPlaces = places.filter((p) =>
  ['red-hill', 'sorrento', 'flinders', 'mornington', 'portsea', 'main-ridge'].includes(routeSlug(p))
);

const season         = currentSeason();
const seasonBlurbData = seasonBlurb[season];
// `now` is declared near the top of the script block.
// (issueDate const removed 2026-05-12 — was used only by the dropped
// "Vol 04 · {issueDate}" cinema chrome.)

// ── Cinematic hero data ────────────────────────────────────────────────────
// Production cover: the May issue's spotlight is the Hatted Restaurants
// article. Single-image, single-story cover (a magazine cover features one
// piece, not five). The time-of-day rotator structure has been collapsed
// to a single scene — the array+grid scaffold is preserved so we can bring
// rotation back later if we ever do a "five covers" issue.
//
// Image: Pt. Leo Estate sculpture park, above Western Port. Laura (one of
// the four two-hat restaurants the article leads with) lives at Pt. Leo.
// CC-BY-SA-4.0, documented in /images/sourced/LICENSES.md.

interface Scene {
  id: string;             // stable key
  label: string;          // eyebrow chip, e.g. "THE COVER STORY"
  hours: string;          // small-print sub, e.g. "9 MIN READ"
  image: string;
  imageAlt: string;
  caption: string;        // bottom-right location credit
  headline: string;       // <em> tags render italic gold accent
  dispatch: string;       // PI voice — see BRAND-PI.md voice rules
  primaryHref: string;
  primaryLabel: string;
}

// Cover scene fields are editor-controlled. CMS overrides (when present)
// win over the inline defaults; the inline values are the canonical fallback
// so the homepage renders identically when no CMS rows are published.
const coverImageOverride = cmsImage['cover.image'];
const scenes: Scene[] = [
  // ── Active cover — swap any scene to [0] to make it live ─────────────────
  {
    id: 'flinders-weekend',
    label: 'THE SLOW SIDE',
    hours: '7 MIN READ',
    image: '/images/sourced/home-cover-south-coast-rainbow-01.webp',
    imageAlt: 'Flinders boat harbour and coastline from above, Bass Strait, south coast Mornington Peninsula',
    caption: 'Flinders, south coast',
    headline: 'The <em>other</em> Peninsula weekend.',
    dispatch: 'When Red Hill is booked out and Sorrento feels like a queue, there is another version of the Peninsula weekend — south of everything, closer to the ocean, and slower on purpose.',
    primaryHref: '/journal/a-flinders-weekend/',
    primaryLabel: 'Read the piece',
  },
  // ── Rotation bench ────────────────────────────────────────────────────────
  {
    id: 'late-walks',
    label: 'THE WALK',
    hours: '7 MIN READ',
    image: '/images/sourced/home-cover-back-beach-horses-01.jpg',
    imageAlt: 'Horses on a Peninsula ocean back beach, Bass Strait in the background',
    caption: 'Back beach, Bass Strait side',
    headline: 'When the light <em>starts improving.</em>',
    dispatch: 'Bushrangers Bay for a full reset. Cape Schanck boardwalk when time is short. Sorrento Back Beach for mood rather than route. The four walks that earn the second drink.',
    primaryHref: '/journal/the-peninsulas-best-late-afternoon-walks/',
    primaryLabel: 'Read the piece',
  },
  // ── Rotation bench — move any scene to [0] to make it live ─────────────
  {
    id: 'cover',
    label: cmsText['cover.label'] ?? 'THE COVER STORY',
    hours: cmsText['cover.hours'] ?? '9 MIN READ',
    image: coverImageOverride?.src ?? '/images/sourced/home-cover-bay-umbrella-01.webp',
    imageAlt: coverImageOverride?.alt ?? 'A wide sandy bay beach with dune grass in the foreground, a bright red umbrella and chair to the right, and calm water under a blue sky.',
    caption: coverImageOverride?.caption ?? cmsText['cover.caption'] ?? 'Bay beach, Mornington Peninsula',
    headline: cmsText['cover.headline'] ?? 'The Hatted Restaurants of the <em>Peninsula.</em>',
    dispatch: cmsText['cover.dispatch'] ?? 'Four two-hat restaurants. Seven one-hat tables. Barragunda is the debut, Tedesca took Regional Restaurant of the Year, and Laura is still where the long lunch happens. The complete list, with booking realities.',
    primaryHref: cmsText['cover.primaryHref'] ?? '/journal/hatted-restaurants-mornington-peninsula-2025/',
    primaryLabel: cmsText['cover.primaryLabel'] ?? 'Read the cover story',
  },
  {
    id: 'cape-schanck',
    label: 'THE COMPLETE GUIDE',
    hours: '8 MIN READ',
    image: '/images/sourced/home-cover-cape-schanck-rainbow-01.webp',
    imageAlt: 'Rainbow arching over Bass Strait with the Cape Schanck lighthouse headland, Mornington Peninsula',
    caption: 'Cape Schanck, Mornington Peninsula National Park',
    headline: 'The lighthouse at the edge of <em>everything.</em>',
    dispatch: 'The 1859 limestone lighthouse, the boardwalk to Pulpit Rock, and the walk to Bushrangers Bay. The grounds are free from 6am. Here is the full structure of the day.',
    primaryHref: '/journal/cape-schanck-guide/',
    primaryLabel: 'Read the guide',
  },
];

const ssrScene = scenes[0];
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="The independent guide to the Mornington Peninsula, best restaurants, cellar doors, beaches, walks, and places to stay. Every venue visited. Every opinion earned. Updated May 2026."
  section="home"
  canonical="https://peninsulainsider.com.au"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Peninsula Insider',
    url: 'https://peninsulainsider.com.au',
    description: 'The independent editorial guide to the Mornington Peninsula.',
    inLanguage: 'en-AU',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://peninsulainsider.com.au/journal?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Mornington Peninsula known for?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Mornington Peninsula is known for cool-climate Pinot Noir and Chardonnay, vineyard restaurants, natural hot springs, dramatic ocean coastline, and calm bay beaches, all within 90 minutes of Melbourne.',
        },
      },
      {
        '@type': 'Question',
        name: 'How far is the Mornington Peninsula from Melbourne?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Mornington town is about 60 km from Melbourne CBD (around 60 minutes). Sorrento and Portsea at the tip are 95 to 105 km, roughly 90 minutes in normal traffic.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the best time to visit the Mornington Peninsula?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Autumn (March to May) is the best season: vintage is underway on the ridge, crowds thin after Easter, and the light over the vineyards is at its best.',
        },
      },
    ],
  })} />

  {/* ── Cinematic hero ─────────────────────────────────────────────────────── */}
  <section class="cinema" aria-label="Cover">
    {/* Image layer (array kept so rotation can be reintroduced cleanly later) */}
    <div class="cinema__bg" aria-hidden="true">
      {scenes.map((s) => (
        <div class={`cinema-scene${s.id === ssrScene.id ? ' is-active' : ''}`} data-scene={s.id}>
          <img
            src={s.image}
            alt={s.imageAlt}
            loading="eager"
            fetchpriority={s.id === ssrScene.id ? 'high' : undefined}
            {...(s.id === ssrScene.id ? editableImage({
              entityType: 'page',
              entitySlug: 'home',
              fieldPath: 'cover.image',
              label: 'Cover image',
              purpose: 'hero',
            }) : {})}
          />
        </div>
      ))}
    </div>

    {/* Vertical scrim for legibility of bottom-anchored copy */}
    <div class="cinema__scrim" aria-hidden="true"></div>

    {/* Local grain (separate from global so we can tune intensity) */}
    <div class="cinema__grain" aria-hidden="true"></div>

    {/* Top chrome — brand identity only. The "Vol 04 · {issueDate}" magazine
        issue chrome was removed (2026-05-12) per the editorial brief: the
        publication doesn't operate on discrete issues and the framing was
        out of step with the planning-dashboard direction. */}
    <header class="cinema__top">
      <div class="cinema__brand">Peninsula Insider</div>
    </header>

    {/* Bottom-left copy block. Grid-stack scaffold preserved so rotation
         can be reintroduced cleanly — currently a single scene. */}
    <div class="cinema__copy">
      <div class="cinema-copy-wrap">
        {scenes.map((s) => (
          <div class={`cinema-copy${s.id === ssrScene.id ? ' is-active' : ''}`} data-copy={s.id}>
            <p class="cinema-copy__time">
              <span class="cinema-copy__chip">{s.label}</span>
              <span class="cinema-copy__hours">{s.hours}</span>
            </p>
            <h1
              class="cinema-copy__headline"
              set:html={s.headline}
              {...(s.id === ssrScene.id ? editableText({
                entityType: 'page',
                entitySlug: 'home',
                fieldPath: 'cover.headline',
                label: 'Cover headline',
              }) : {})}
            />
            <p
              class="cinema-copy__dispatch"
              {...(s.id === ssrScene.id ? editableText({
                entityType: 'page',
                entitySlug: 'home',
                fieldPath: 'cover.dispatch',
                label: 'Cover dispatch',
              }) : {})}
            >{s.dispatch}</p>
          </div>
        ))}
      </div>

      <div class="cinema__ctas">
        <a class="cinema__cta cinema__cta--primary" href={ssrScene.primaryHref}>
          {ssrScene.primaryLabel} <span aria-hidden="true">→</span>
        </a>
        <a class="cinema__cta cinema__cta--ghost" href="/ask/" data-pi-trigger="true">
          Ask PI <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {/* Bottom-right caption */}
    <p
      class="cinema__caption"
      {...editableText({
        entityType: 'page',
        entitySlug: 'home',
        fieldPath: 'cover.caption',
        label: 'Cover caption',
      })}
    >{ssrScene.caption}</p>

    {/* The "Inside the issue" scroll hint was removed (2026-05-12) along
        with the issue-volume chrome — same reason: the publication doesn't
        operate on discrete issues. */}
  </section>

  <section class="cinema-mobile-copy" aria-label="Cover story summary">
    <div class="cinema-mobile-copy__inner">
      <p class="cinema-mobile-copy__time">
        <span class="cinema-mobile-copy__chip">{ssrScene.label}</span>
        <span class="cinema-mobile-copy__hours">{ssrScene.hours}</span>
      </p>
      <h1 class="cinema-mobile-copy__headline" set:html={ssrScene.headline} />
      <p class="cinema-mobile-copy__dispatch">{ssrScene.dispatch}</p>
      <div class="cinema-mobile-copy__ctas">
        <a class="cinema-mobile-copy__cta cinema-mobile-copy__cta--primary" href={ssrScene.primaryHref}>
          {ssrScene.primaryLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* ── Peninsula Insider Picks This Weekend ─────────────────────────────────
       The canonical weekly editorial shortlist, surfaced on the homepage so
       a Friday-afternoon visitor answers "what should I do this weekend?"
       in the first scroll. Top 3 only — full list at /whats-on/#picks. */}
  {homeWeekendPicks.length > 0 && (
    <section class="hp-weekend-picks">
      <div class="container">
        <div class="hp-weekend-picks__head">
          <div>
            <p class="label label--accent">Peninsula Insider Picks</p>
            <h2 class="hp-weekend-picks__title">This weekend, the editor would book.</h2>
            <p class="hp-weekend-picks__sub">The strongest events on the Peninsula for {dispatchWindow.label}. Selected, not listed.</p>
          </div>
          <a href="/whats-on/#picks" class="venues__link">See all picks →</a>
        </div>
        <div class="event-grid hp-weekend-picks__grid">
          {homeWeekendPicks.map(({ event, verdictOverride, featured }) => {
            const eventWithOverride = verdictOverride
              ? { ...event, data: { ...event.data, editorVerdict: verdictOverride } }
              : event;
            return (
              <EventCard
                event={eventWithOverride}
                featured={featured}
                showVerdict={true}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* ── Below the fold — existing magazine layout, unchanged ───────────────── */}
  {weekendDispatch && (
    <WeekendPickerBlock
      dispatch={weekendDispatch}
      weekend={`This weekend · ${dispatchWindow.label}`}
    />
  )}

  {featuredPlaces.length > 0 && (
    <section class="places places--compact">
      <div class="container">
        <div class="places__header">
          <p
            class="label label--accent places__label"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.label', label: 'Places eyebrow' })}
          >{cmsText['places.label'] ?? 'Know the terrain'}</p>
          <h2
            class="places__title"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.title', label: 'Places title' })}
          >{cmsText['places.title'] ?? 'The Peninsula, place by place'}</h2>
          <p
            class="places__sub"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'places.sub', label: 'Places sub' })}
          >{cmsText['places.sub'] ?? 'Six towns that organise the region — ridge, coast, and bay.'}</p>
        </div>
        <div class="places__grid">
          {featuredPlaces.map((place, index) => (
            <PlaceCard
              place={place}
              variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'}
            />
          ))}
        </div>
        <div class="places__footer">
          <a href="/places/" class="venues__link">All {places.length} places →</a>
        </div>
      </div>
    </section>
  )}

  {(eatPick || stayPick || explorePick) && (
    <section class="hp-picks">
      <div class="container">
        <div class="hp-picks__head">
          <div>
            <p
              class="label label--accent"
              {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'picks.label', label: 'Picks eyebrow' })}
            >{cmsText['picks.label'] ?? "This week's edit"}</p>
            <h2
              class="hp-picks__title"
              {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'picks.title', label: 'Picks title' })}
            >{cmsText['picks.title'] ?? 'Three reasons to go'}</h2>
          </div>
          <a href="/journal/" class="venues__link">Read all →</a>
        </div>
        <div class="hp-picks__grid">
          {eatPick && (
            <a href={`/eat/${routeSlug(eatPick)}`} class="hp-pick">
              <div class="hp-pick__img">
                <img src={resolveHeroSrc(eatPick.data)} alt={eatPick.data.heroImage?.alt ?? eatPick.data.name ?? 'Restaurant pick'} loading="lazy" decoding="async" />
              </div>
              <p class="hp-pick__tag">Eat &amp; Drink</p>
              <h3 class="hp-pick__name">{eatPick.data.name}</h3>
              {eatPick.data.signature && (<p class="hp-pick__note">{eatPick.data.signature}</p>)}
            </a>
          )}
          {stayPick && (
            <a href={`/stay/${routeSlug(stayPick)}`} class="hp-pick">
              <div class="hp-pick__img">
                <img src={resolveHeroSrc(stayPick.data)} alt={stayPick.data.heroImage?.alt ?? stayPick.data.name ?? 'Stay pick'} loading="lazy" decoding="async" />
              </div>
              <p class="hp-pick__tag">Stay</p>
              <h3 class="hp-pick__name">{stayPick.data.name}</h3>
              {stayPick.data.signature && (<p class="hp-pick__note">{stayPick.data.signature}</p>)}
            </a>
          )}
          {explorePick && (
            <a href={`/explore/${routeSlug(explorePick)}`} class="hp-pick">
              <div class="hp-pick__img">
                <img src={resolveHeroSrc(explorePick.data)} alt={explorePick.data.heroImage?.alt ?? explorePick.data.name ?? 'Explore pick'} loading="lazy" decoding="async" />
              </div>
              <p class="hp-pick__tag">Explore</p>
              <h3 class="hp-pick__name">{explorePick.data.name}</h3>
              {explorePick.data.editorNote && (
                <p class="hp-pick__note">{String(explorePick.data.editorNote).split('.')[0].trim()}.</p>
              )}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {planCards.length > 0 && (
    <section class="hp-plans">
      <div class="container">
        <div class="hp-plans__head">
          <p
            class="label label--accent"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.label', label: 'Plans eyebrow' })}
          >{cmsText['plans.label'] ?? 'The Plans'}</p>
          <h2
            class="hp-plans__title"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.title', label: 'Plans title' })}
          >{cmsText['plans.title'] ?? 'Or take the whole weekend.'}</h2>
          <p
            class="hp-plans__sub"
            {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'plans.sub', label: 'Plans sub' })}
          >{cmsText['plans.sub'] ?? 'Three editorial itineraries — built around a single anchor stay, paced for the way the Peninsula actually works.'}</p>
        </div>
        <div class="hp-plans__grid">
          {planCards.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
        </div>
        <div class="hp-plans__footer">
          <a href="/plans/" class="venues__link">All {itineraries.length} plans →</a>
        </div>
      </div>
    </section>
  )}

  {editorPicks.length > 0 && (
    <Shortlist
      eyebrow="The Shortlist"
      title="Five pieces worth the <em>appointment</em>."
      dek="The handful we'd send a close friend to this issue, picked for the ratio of payoff to effort, not the view from the tasting room."
      link={{ label: 'Read all in the Journal', href: '/journal/' }}
      items={editorPicks.map((article, i) => ({
        rank: String(i + 1).padStart(2, '0'),
        meta: [
          formatLabel[article.data.format] ?? String(article.data.format ?? 'Editorial'),
          article.data.readingTimeMinutes ? `${article.data.readingTimeMinutes} min read` : 'Editorial',
          article.data.publishedAt
            ? new Date(article.data.publishedAt).toLocaleDateString('en-AU', { month: 'long', year: 'numeric' })
            : '',
        ].filter(Boolean),
        name: article.data.title,
        href: `/journal/${routeSlug(article)}`,
        why: article.data.dek,
        tags: (article.data.tags ?? []).slice(0, 2).map((t: string) => ({ label: String(t).replace(/-/g, ' ') })),
      }))}
    />
  )}

  {/* Editor's Letter — title and paragraphs keep their seasonal interpolation
      because the JSON-default copy is autumn-specific; CMS overrides apply
      only when an editor explicitly sets that field. Other fields fall
      through to the inline defaults when no override is published. */}
  {(() => {
    const elImage = cmsImage['editors-letter.image'];
    const editorsLetterTitle = cmsText['editors-letter.title']
      ?? `On the <em>quiet authority</em> of a good ${seasonBlurbData.label?.toLowerCase() ?? 'autumn'}.`;
    const editorsLetterParagraphs = [
      cmsText['editors-letter.paragraphs.0']
        ?? `${seasonBlurbData.label ?? 'Autumn'} is the season the Peninsula stops performing. The weekend crowds thin, the vintage trucks finish their last runs, and the ridge takes on the colour it has for about six weeks a year.`,
      cmsText['editors-letter.paragraphs.1']
        ?? `We've rebuilt the cellar-door shortlist from scratch this season, visited every restaurant on the long-lunch list at least twice, and walked every beach on the ranking.`,
      cmsText['editors-letter.paragraphs.2']
        ?? `If this is your first issue with us, welcome. If you're returning, thanks for the patience through the refit.`,
    ];
    return (
      <EditorsLetter
        eyebrow={cmsText['editors-letter.eyebrow'] ?? "Editor's Letter"}
        title={editorsLetterTitle}
        paragraphs={editorsLetterParagraphs}
        pullQuote={cmsText['editors-letter.pullQuote'] ?? "This issue is built for the six weeks where the Peninsula is at its most itself, before winter settles in and the coast goes quiet."}
        signatureName={cmsText['editors-letter.signatureName'] ?? "The Editors"}
        signatureRole={cmsText['editors-letter.signatureRole'] ?? "Peninsula Insider"}
        image={elImage?.src ?? "/images/sourced/place-red-hill-01.webp"}
        imageAlt={elImage?.alt ?? "Vine rows in late-season colour, Red Hill"}
        imageCaption={elImage?.caption ?? "The last weekend of vintage, Red Hill, <em>the quietest a working winery ever gets.</em>"}
      />
    );
  })()}

  <NewsletterBlock />

  {/* ── 10-second hero rotator ───────────────────────────────────────────────
       Advances one scene every 10 seconds using the CSS opacity transitions
       already on .cinema-scene (1.4s) and .cinema-copy (1.0s). The fade
       overlaps the dwell so the cover never feels static and never feels
       like a click-through carousel either.
       define:vars serialises the scene metadata at build time so there is
       no runtime fetch, just a lightweight setInterval on the client. */}
  <script define:vars={{ rotatorScenes: scenes.map(s => ({
    id: s.id,
    primaryHref: s.primaryHref,
    primaryLabel: s.primaryLabel,
    caption: s.caption,
    label: s.label,
    hours: s.hours,
    headline: s.headline,
    dispatch: s.dispatch,
  })) }}>
  if (rotatorScenes.length >= 2) {
    let idx = 0;
    setInterval(function () {
      idx = (idx + 1) % rotatorScenes.length;
      const s = rotatorScenes[idx];

      // Crossfade image layers
      document.querySelectorAll('[data-scene]').forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-scene') === s.id);
      });

      // Crossfade copy blocks
      document.querySelectorAll('[data-copy]').forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-copy') === s.id);
      });

      // Update desktop primary CTA
      var cta = document.querySelector('.cinema__cta--primary');
      if (cta) {
        cta.setAttribute('href', s.primaryHref);
        cta.innerHTML = s.primaryLabel + ' <span aria-hidden="true">→</span>';
      }

      // Update bottom-right caption
      var cap = document.querySelector('.cinema__caption');
      if (cap) cap.textContent = s.caption;

      // Update mobile copy section (below-fold on small screens)
      var chip = document.querySelector('.cinema-mobile-copy__chip');
      if (chip) chip.textContent = s.label;
      var hrs = document.querySelector('.cinema-mobile-copy__hours');
      if (hrs) hrs.textContent = s.hours;
      var hl = document.querySelector('.cinema-mobile-copy__headline');
      if (hl) hl.innerHTML = s.headline;
      var dp = document.querySelector('.cinema-mobile-copy__dispatch');
      if (dp) dp.textContent = s.dispatch;
      var mCta = document.querySelector('.cinema-mobile-copy__cta--primary');
      if (mCta) {
        mCta.setAttribute('href', s.primaryHref);
        mCta.innerHTML = s.primaryLabel + ' <span aria-hidden="true">→</span>';
      }
    }, 10 * 1000);
  }
  </script>
</BaseLayout>

{/* ─────────────────────────────────────────────────────────────────────────
   Cinematic hero styles. Self-contained, scoped to .cinema*.
   Below-fold sections inherit existing global styles.
   ───────────────────────────────────────────────────────────────────────── */}
<style is:global>
  .cinema {
    position: relative;
    min-height: 75vh;            /* three-quarter screen — next section peeks below */
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: #1E1B18;
    color: #FDFCFA;
  }

  /* ── Image layer ─────────────────────────────────────────────────────────── */
  .cinema__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cinema-scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }
  .cinema-scene.is-active {
    opacity: 1;
  }
  .cinema-scene img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    display: block;
    transform: scale(1.04);
    /* Ken Burns is applied only to the active scene to save battery. */
  }
  .cinema-scene.is-active img {
    animation: cinema-kenburns 28s ease-in-out infinite alternate;
  }
  @keyframes cinema-kenburns {
    0%   { transform: scale(1.04) translate3d(0, 0, 0); }
    100% { transform: scale(1.10) translate3d(-1.5%, -1%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cinema-scene.is-active img { animation: none; transform: scale(1.04); }
    .cinema-scene { transition: opacity 0.2s linear; }
  }

  /* ── Scrim — two layers stacked.
     1. Vertical gradient: top kept light, dark phase pulled UP to 35% so the
        copy block (~50–80% down) sits on real shade, not photo.
     2. Bottom-left radial vignette: localised dark wash anchored under the
        copy column. Reads as natural light fall-off, keeps the rest of the
        photo bright, and bites legibility back without flattening the image.
     ──────────────────────────────────────────────────────────────────────── */
  .cinema__scrim {
    position: absolute; inset: 0; z-index: 1;
    pointer-events: none;
    background:
      /* localised vignette behind the copy */
      radial-gradient(
        ellipse 70% 75% at 22% 88%,
        rgba(0, 0, 0, 0.62) 0%,
        rgba(0, 0, 0, 0.32) 45%,
        transparent 75%
      ),
      /* vertical scrim — dark phase starts higher */
      linear-gradient(
        to bottom,
        rgba(20, 18, 16, 0.32) 0%,
        rgba(20, 18, 16, 0.05) 18%,
        rgba(20, 18, 16, 0.18) 35%,
        rgba(20, 18, 16, 0.58) 65%,
        rgba(20, 18, 16, 0.88) 100%
      );
