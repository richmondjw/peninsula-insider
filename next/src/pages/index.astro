---
/**
 * Homepage - v5 "Edition cover" rebuild (T-401).
 *
 * The v5 masthead lives in BaseLayout. This page renders the cover, one
 * temporal weekend module, three editorial plans, four interest doors,
 * three place starting points, one Journal feature and the Insider Note:
 *
 *   Cover statement (the single h1) and trip entry points
 *   This Weekend - three PI picks with Save and "+ Trip"
 *   Three plans to start with, plus a route preview and builder shortcuts
 *   Interest doors - Eat & Drink / Stay / Wine / Explore
 *   Place starting points - Mornington / Red Hill / Sorrento
 *   One flagship Journal feature
 *   The Insider Note
 *
 * Everything server-renders at build time, deterministic against the
 * content tree and published CMS image overrides. No reveal animations,
 * and no carousel of editorial content: the downstream modules stay static
 * and complete on the page.
 *
 * The one sanctioned exception is the cover photograph (block 2). It
 * cross-fades through a deck of Peninsula frames, with autoplay, arrows
 * and dots (2026-09-18, James). The rule it does not break: the copy is
 * fixed, so there is still one h1 and nothing moves under the reader.
 * Kill switch is SHOW_HOME_COVER_SLIDESHOW in src/lib/features.ts.
 * Title/meta/canonical are on the SEO protect list - unchanged from the
 * previous build.
 *
 * The previous "Edition" homepage (EditionCover + seven ed-* modules)
 * lives in git history at this path; its components remain under
 * src/components/edition/ untouched.
 */
import { agentDirectories } from '../lib/agent-guide.mjs';
import HomeCover from '../components/v5/home/HomeCover.astro';
import HomeWeekend from '../components/v5/home/HomeWeekend.astro';
import HomeDoors from '../components/v5/home/HomeDoors.astro';
import HomeOrientation from '../components/v5/home/HomeOrientation.astro';
import HomePlan from '../components/v5/home/HomePlan.astro';
import HomeJournalFeature from '../components/v5/home/HomeJournalFeature.astro';
import HomeAsk from '../components/v5/home/HomeAsk.astro';
import HomeDispatch from '../components/v5/home/HomeDispatch.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="Peninsula Insider, The Mornington Peninsula Guide"
  description="An editorial guide to the Mornington Peninsula - best restaurants, cellar doors, beaches, walks, and places to stay. Every pick earns its place. Every verdict has a reason."
  section="home"
  canonical="https://peninsulainsider.com.au"
>
  <HomeCover />
  <section class="home-name-directory container" aria-label="Find a published page by name"><p>Looking for a particular place or story? <a href="/site-index/">Browse selected places and stories</a>. For agents, choose a JSON name directory with text or HTML page links, then read the matching page.</p><ul>{agentDirectories.map((directory) => <li><span>{directory.title}:</span><a href={directory.href} aria-label={`${directory.title}: JSON directory of text page links`}>Text</a><a href={directory.htmlHref} aria-label={`${directory.title}: JSON directory of HTML page links`}>HTML</a></li>)}</ul></section>
  <HomeWeekend />
  <HomePlan />
  <HomeDoors />
  <HomeOrientation />
  <HomeJournalFeature />
  {/* TEMP (2026-07): Ask PI chat band hidden from the main screen per request.
      Code is preserved (HomeAsk.astro + import above are untouched); re-enable
      by restoring the <HomeAsk /> line below. */}
  {/* <HomeAsk /> */}
  <HomeDispatch />
</BaseLayout>

<style>
  .home-name-directory { padding-block: 1.5rem; color: var(--text); }
  .home-name-directory p { max-width: 70ch; margin: 0 0 .5rem; line-height: 1.65; }
  .home-name-directory ul { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; list-style: none; padding: 0; margin: 0; }
  .home-name-directory li { display: flex; align-items: baseline; flex-wrap: wrap; gap: .6rem; }
  .home-name-directory li span { font-weight: 600; }
  .home-name-directory a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; padding-block: .5rem; }
  .home-name-directory a:hover { text-decoration-thickness: 2px; }
  .home-name-directory a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>
