---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const allVenues = await getCollection('venues');
const venues = allVenues.filter((v) => v.data.type === 'brewery');

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Eat & Drink', href: '/eat/' },
  { label: 'Breweries' },
];
export const prerender = true;
---

<BaseLayout
  title="Breweries on the Mornington Peninsula · Peninsula Insider"
  description="The breweries worth a stop on the Mornington Peninsula, from taproom afternoons to brewpub dinners."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/breweries/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <h1 class="article__title">Breweries on the Mornington Peninsula</h1>
      <div class="prose">
        <p>Independent brewing is part of the Peninsula's drinks story alongside the wineries. These are the taprooms and brewpubs worth planning an afternoon or a dinner around.</p>
      </div>
    </div>
  </article>

  <section class="venues" id="breweries">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Peninsula breweries</p>
          <h2 class="venues__title">{venues.length} breweries on the Peninsula</h2>
          <p class="venues__sub">Taprooms and brewpubs, by where they sit on the Peninsula.</p>
        </div>
        <a href="/eat/" class="venues__link">All dining venues →</a>
      </div>
      <div class="venues__grid">
        {venues.map((venue) => <VenueCard venue={venue} hrefPrefix="/eat" />)}
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
