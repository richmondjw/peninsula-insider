---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PiSaveActions from '../../components/PiSaveActions.astro';
import { buildBreadcrumbSchema, buildItemListSchema, absUrl } from '../../lib/schema';
import { isListableVenue, routeSlug } from '../../lib/editorial';

const venues = (await getCollection('venues')).filter(isListableVenue).filter((v) => v.data.type === 'brewery');
const placeId = (v: typeof venues[number]) => String(v.data.place?.id ?? v.data.place ?? '');
const placeName = (id: string) => id.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
venues.sort((a, b) => placeId(a).localeCompare(placeId(b)) || a.data.name.localeCompare(b.data.name));
const places = [...new Set(venues.map(placeId))];
const notes: Record<string, { label: string; text: string; visit: string }> = {
  'jetty-road-brewery': { label: 'Menu, tap list and a table', text: 'The Dromana venue at 12–14 Brasser Avenue brings its food menu, beers on tap and table bookings together on one visiting page.', visit: 'https://www.jettyroad.com.au/dromana' },
  'two-bays-brewing': { label: 'Gluten-free beer and pizza', text: 'TWØBAYS describes its Dromana taproom as gluten-free, with wood-fired pizzas. Its visiting page lists the taproom at Unit 1, 2 Trewhitt Court.', visit: 'https://www.twobays.beer/pages/taproom' },
  'st-andrews-beach-brewery': { label: 'Former stables and a beer garden', text: 'The Fingal taproom occupies former horse-training stables, with indoor dining and a beer garden. The venue page explains the different spaces and booking options.', visit: 'https://standrewsbeachbrewery.com.au/fingal-brewery/' },
  'mornington-peninsula-brewery': { label: 'Beer, spirits and wood-fired pizza', text: 'A brewery and distillery at 72 Watt Road. Tar Barrel lists beer and spirit tasting paddles alongside wood-fired pizzas.', visit: 'https://tarbarrel.com.au/' },
  'red-hill-brewery': { label: 'A deck, beer garden and hop vines', text: 'Red Hill South’s brewery has outdoor spaces overlooking its hops. Check the kitchen arrangements as well as the bar hours before planning a late arrival.', visit: 'https://www.redhillbrewery.com.au/whats-on/' },
};
const cover = venues.find((v) => routeSlug(v) === 'st-andrews-beach-brewery')?.data.heroImage;
const hasCover = cover?.rightsStatus === 'recorded' && cover?.provenanceReview === 'verified' && cover?.depictionStatus === 'actual';
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Eat & Drink', href: '/eat/' }, { label: 'Breweries' }];
const breadcrumbSchema = buildBreadcrumbSchema([{ name: 'Home', url: absUrl('/') }, { name: 'Eat & Drink', url: absUrl('/eat/') }, { name: 'Breweries', url: absUrl('/eat/breweries/') }]);
const itemListSchema = buildItemListSchema({ name: 'Mornington Peninsula breweries', description: 'Brewery guides and direct visiting links, grouped by place.', listPath: '/eat/breweries', items: venues.map((v) => ({ name: v.data.name, path: `/wine/${routeSlug(v)}/`, itemType: 'Brewery' })) });
export const prerender = true;
---

<BaseLayout title="Breweries on the Mornington Peninsula · Peninsula Insider" description={`Explore ${venues.length} Mornington Peninsula breweries by place, with food, taproom and visiting information to help plan your stop.`} section="eat" canonical="https://peninsulainsider.com.au/eat/breweries/">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <Breadcrumbs items={breadcrumbItems} />
  <div class="brewery-guide">
    <section class="brew-cover container" aria-labelledby="brew-title">
      <div class="brew-cover__copy"><p class="brew-kicker">Eat & drink · Mornington Peninsula</p><h1 id="brew-title">Find your brewery afternoon.</h1><p class="brew-dek">A taproom, a beer garden or a table for lunch. Explore {venues.length} breweries and choose the stop that fits your day.</p><a class="pi-btn pi-btn--solid" href="#breweries">Find a brewery <span aria-hidden="true">↓</span></a><p class="brew-cover__note">Grouped by place, with direct links to current menus and visiting information.</p></div>
      {hasCover && <figure class="brew-cover__figure"><img src={cover.src} alt={cover.alt} width="2000" height="1334" fetchpriority="high" data-pi-responsive="(max-width: 700px) calc(100vw - 32px), 560px" /><figcaption>Food and beer at St Andrews Beach Brewery, Fingal. {cover.credit}. <a href="/photography/">Image credits</a></figcaption></figure>}
    </section>

    <section class="brew-browse container" id="breweries" aria-labelledby="brew-browse-title">
      <div class="brew-finder"><div class="brew-finder__intro"><p class="brew-kicker">Choose your patch</p><h2 id="brew-browse-title">{venues.length} breweries. {places.length} places.</h2><p>Jump to a place, or browse the full list below.</p></div><nav aria-label="Jump to breweries by place" class="brew-jumps">{places.map((place) => <a href={`#brew-${place}`}>{placeName(place)} <span>{venues.filter((v) => placeId(v) === place).length}</span><span aria-hidden="true">↓</span></a>)}</nav></div>
      {places.map((place) => <section class="brew-area" id={`brew-${place}`} aria-labelledby={`brew-heading-${place}`}><header class="brew-area__heading"><h2 id={`brew-heading-${place}`}>{placeName(place)}</h2><a href={`/explore/places/${place}/`}>Explore {placeName(place)} <span aria-hidden="true">↗</span></a></header><div class="brew-list">{venues.filter((v) => placeId(v) === place).map((venue) => {
        const slug = routeSlug(venue); const href = `/wine/${slug}/`; const note = notes[slug];
        return <article class="brew-card"><div class="brew-card__identity"><p class="brew-kicker">{note?.label ?? 'Brewery'}</p><h3><a href={href}>{venue.data.name}</a></h3></div><p class="brew-card__summary">{note?.text ?? 'Explore the brewery guide and use the official website for current visiting details.'}</p><div class="brew-card__actions"><div class="brew-card__links"><a href={href}>Read brewery guide <span aria-hidden="true">→</span></a>{(note?.visit ?? venue.data.website) && <a href={note?.visit ?? venue.data.website} rel="noopener noreferrer">Plan your visit <span aria-hidden="true">↗</span></a>}</div><PiSaveActions kind="venue" slug={slug} title={venue.data.name} href={href} dek={note?.text} floating={false} /></div></article>;
      })}</div></section>)}
      <a class="brew-all" href="/eat/">More places to eat & drink <span aria-hidden="true">→</span></a>
    </section>

    <section class="brew-plan container" aria-labelledby="brew-plan-title"><div class="brew-plan__intro"><p class="brew-kicker">Before you go</p><h2 id="brew-plan-title">Make one brewery your anchor.</h2></div><div class="brew-plan__details"><div><h3>Check the kitchen</h3><p>Bar and food service can finish at different times. Use the venue’s own menu and visiting page when planning a meal.</p></div><div><h3>Bring the right questions</h3><p>Confirm group bookings, access needs, dietary requirements and non-alcoholic options directly. Arrange transport before setting out.</p></div></div></section>
  </div>
</BaseLayout>

<style>
  .brewery-guide { color: var(--text); }
  .brewery-guide .container { max-width: 1200px; }
  .brew-kicker { color: var(--accent); font-size: var(--fs-100); font-weight: 700; letter-spacing: .09em; text-transform: uppercase; margin: 0 0 var(--space-4); line-height: 1.5; }
  .brew-cover { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); align-items: center; padding-block: var(--space-6) var(--space-8); }
  .brew-cover:not(:has(figure)) { grid-template-columns: 1fr; }
  .brew-cover h1 { font-size: var(--fs-800); line-height: 1.12; letter-spacing: -.035em; margin: 0 0 var(--space-5); max-width: 12ch; }
  .brew-dek { font-size: var(--fs-500); line-height: 1.5; margin: 0 0 var(--space-5); max-width: 46ch; }
  .brew-cover__note { font-size: var(--fs-300); line-height: 1.6; margin: var(--space-4) 0 0; max-width: 42ch; }
  .brew-cover__figure { margin: 0; min-width: 0; }
  .brew-cover__figure img { width: 100%; height: auto; aspect-ratio: 3/2; object-fit: cover; display: block; border-radius: var(--space-3); }
  .brew-cover__figure figcaption { font-size: var(--fs-200); line-height: 1.5; margin-top: var(--space-3); }
  .brewery-guide h2 { font-size: 2rem; line-height: 1.2; letter-spacing: -.025em; margin: 0; }
  .brewery-guide a:not(.pi-btn) { color: var(--accent); text-underline-offset: .22em; }
  .brewery-guide a:focus-visible, .brewery-guide :global(button:focus-visible) { outline: 3px solid var(--accent); outline-offset: 5px; }
  .brew-browse, .brew-area { scroll-margin-top: 130px; }
  .brew-finder { background: var(--bg-alt); border-block: 1px solid var(--border); padding: var(--space-6); display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--space-6); align-items: center; }
  .brew-finder__intro > p:last-child { font-size: var(--fs-400); margin: var(--space-4) 0 0; line-height: 1.6; }
  .brew-jumps { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .brew-jumps a { display: flex; align-items: center; gap: var(--space-3); min-height: 48px; border: 1px solid var(--border-control); border-radius: var(--space-2); padding: var(--space-3) var(--space-4); background: var(--white); font-size: var(--fs-300); font-weight: 600; text-decoration: none; }
  .brew-jumps a span:first-child { margin-left: auto; font-size: var(--fs-200); }
  .brew-area { padding-top: var(--space-7); }
  .brew-area__heading { display: flex; justify-content: space-between; align-items: center; gap: var(--space-5); margin-bottom: var(--space-5); }
  .brew-area__heading > a, .brew-all { display: inline-flex; align-items: center; min-height: 44px; gap: var(--space-3); font-size: var(--fs-300); font-weight: 600; }
  .brew-list { display: grid; gap: var(--space-4); }
  .brew-card { border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: var(--space-2); background: var(--white); display: grid; grid-template-columns: 1fr 1.3fr .9fr; gap: var(--space-6); padding: var(--space-6); min-width: 0; align-items: start; }
  .brew-card h3 { font-size: var(--fs-600); line-height: 1.3; margin: 0; }
  .brew-card h3 a { color: var(--text) !important; display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; }
  .brew-card h3 a:hover { text-decoration: underline; }
  .brew-card__summary { font-size: var(--fs-400); line-height: 1.65; margin: 0; }
  .brew-card__links { display: grid; gap: var(--space-2); margin-bottom: var(--space-4); }
  .brew-card__links a { min-height: 44px; display: flex; align-items: center; gap: var(--space-2); font-size: var(--fs-300); font-weight: 600; }
  .brew-card__actions :global(.pi-actions__btn) { width: auto; max-width: none; padding-inline: 12px; gap: 8px; }
  .brew-card__actions :global(.pi-actions__label) { opacity: 1; max-width: none; width: auto; overflow: visible; font-size: var(--fs-100); }
  .brew-all { margin-top: var(--space-6); }
  .brew-plan { border-top: 1px solid var(--border); margin-top: var(--space-7); padding-block: var(--space-7) var(--space-8); display: grid; grid-template-columns: 1fr 1.6fr; gap: var(--space-7); }
  .brew-plan__details { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  .brew-plan h3 { font-size: 1.0625rem; line-height: 1.4; margin: 0 0 var(--space-3); }
  .brew-plan__details p { font-size: var(--fs-400); line-height: 1.65; margin: 0; }
  @media (max-width: 900px) {
    .brew-card { grid-template-columns: 1fr 1.3fr; }
    .brew-card__actions { grid-column: 1/-1; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); border-top: 1px solid var(--border); padding-top: var(--space-4); }
    .brew-card__links { display: flex; flex-wrap: wrap; gap: var(--space-4); margin: 0; }
    .brew-finder { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .brew-cover { grid-template-columns: 1fr; padding-block: var(--space-4) var(--space-6); gap: var(--space-5); }
    .brew-cover h1 { font-size: 2rem; max-width: 14ch; }
    .brew-dek { font-size: var(--fs-400); }
    .brewery-guide h2 { font-size: 1.75rem; }
    .brew-finder { padding: var(--space-5); }
    .brew-jumps { grid-template-columns: 1fr; }
    .brew-area__heading { display: block; }
    .brew-area__heading > a { margin-top: var(--space-3); }
    .brew-card { grid-template-columns: 1fr; padding: var(--space-5); gap: var(--space-5); }
    .brew-card__actions { display: block; }
    .brew-card__links { display: grid; margin-bottom: var(--space-4); gap: var(--space-2); }
    .brew-plan, .brew-plan__details { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
