---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const allVenues = await getCollection('venues');
const venues = allVenues.filter((v) => v.data.type === 'distillery');

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Eat & Drink', href: '/eat/' },
  { label: 'Distilleries' },
];
export const prerender = true;
---

<BaseLayout
  title="Distilleries on the Mornington Peninsula · Peninsula Insider"
  description="Gin and spirits made on the Mornington Peninsula, with cellar-door tastings worth the detour."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/distilleries/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <h1 class="article__title">Distilleries on the Mornington Peninsula</h1>
      <div class="prose">
        <p>Small-batch gin and spirits are a quiet part of the Peninsula's drinks scene. These are the distilleries with a tasting room worth the detour.</p>
      </div>
    </div>
  </article>

  <section class="venues" id="distilleries">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Peninsula distilleries</p>
          <h2 class="venues__title">Distilleries on the Peninsula</h2>
          <p class="venues__sub">Tasting rooms for gin and spirits made on the Peninsula.</p>
        </div>
        <a href="/eat/" class="venues__link">All dining venues →</a>
      </div>
      <div class="venues__grid">
        {venues.map((venue) => <VenueCard venue={venue} hrefPrefix="/eat" />)}
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
