---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const allVenues = await getCollection('venues');
const venues = allVenues.filter((v) => v.data.type === 'providore');

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Eat & Drink', href: '/eat/' },
  { label: 'Providores' },
];
export const prerender = true;
---

<BaseLayout
  title="Providores on the Mornington Peninsula · Peninsula Insider"
  description="Farmgate shops, cheesemongers, fishmongers, and produce stores on the Mornington Peninsula, the makers selling direct."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/providores/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <h1 class="article__title">Providores on the Mornington Peninsula</h1>
      <div class="prose">
        <p>The farmgate shops, cheesemongers, fishmongers, and produce stores selling direct. This is where the Peninsula pantry actually comes from.</p>
      </div>
    </div>
  </article>

  <section class="venues" id="providores">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Peninsula providores</p>
          <h2 class="venues__title">{venues.length} providores on the Peninsula</h2>
          <p class="venues__sub">Cheesemongers, fishmongers, and farmgate stores, by what they sell.</p>
        </div>
        <a href="/eat/" class="venues__link">All dining venues →</a>
      </div>
      <div class="venues__grid">
        {venues.map((venue) => <VenueCard venue={venue} hrefPrefix="/eat" />)}
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
