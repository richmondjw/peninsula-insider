---
import { pageImage } from '../../lib/page-images';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import GuideChoices from '../../components/GuideChoices.astro';
import opportunityEvidence from '../../data/search-opportunity-evidence.json';
import { routeSlug, venueHref, isListableVenue } from '../../lib/editorial';
import { buildBreadcrumbSchema, absUrl } from '../../lib/schema';

const eatTypes = ['restaurant', 'cafe', 'winery'];
const dinnerCheckedDate = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Sydney' }).format(new Date(opportunityEvidence.dinnerSessions.checkedOn));
const venues = (await getCollection('venues'))
  .filter((v) => eatTypes.includes(v.data.type))
  .filter(isListableVenue)
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

// Top 15 by editorial authority (hats descending)
const topVenues = venues.slice(0, 15);
const top3Names = topVenues.slice(0, 3).map((v) => v.data.name);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Restaurants Mornington Peninsula',
  description: 'The editorial ranked list of the best restaurants on the Mornington Peninsula, ordered from most authoritative to most approachable.',
  url: 'https://peninsulainsider.com.au/eat/best-restaurants/',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: topVenues.length,
  itemListElement: topVenues.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: v.data.name,
    url: absUrl(venueHref(v)),
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What are the best restaurants on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `The strongest rooms right now are ${top3Names.join(', ')}. All three offer serious food in the vineyard-dining tradition the Peninsula does best - long lunches, estate-grown produce, and wine lists anchored by Mornington Pinot.`,
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to book restaurants on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Choose your dining session before booking. A cellar-door reservation does not reserve a restaurant table, and a winery open for tastings may not serve dinner. Use the restaurant booking page to check the date, menu and seating area. Mention dietary needs and any dog when requesting a table.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the best area for restaurants on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Red Hill plateau - including Main Ridge and Red Hill South - has the highest concentration of serious dining. Mornington town has the strongest casual dining scene. Sorrento and Portsea dominate in summer for atmosphere. For wine-paired lunches, stick to the ridge.',
      },
    },
  ],
};

const dinnerChoices = [
  {
    title: 'The Rocks Mornington', href: '/eat/the-rocks-mornington/', label: 'Dinner in Mornington town',
    body: 'Choose a meal on Schnapper Point Drive when you want to stay on the bay side rather than drive inland for dinner.',
    note: 'The operator lists dinner from 5.30pm to 9pm, Wednesday to Monday. Tuesday is closed, with an additional Sunday-evening closure in winter. Confirm your date before booking.',
    source: { href: 'https://www.therocksmornington.com.au/contact-us/', label: 'Check dinner hours and book with The Rocks' },
  },
  {
    title: 'Many Little, Red Hill South', href: '/eat/many-little/', label: 'Dinner on the ridge',
    body: 'Choose the ridge for a Sri Lankan-influenced dining menu. Red Hill South is a different location from Mornington town; organise the journey home before settling in.',
    note: 'The operator lists restaurant dinner Thursday to Sunday from 5pm. Its weekend bar is walk-in only; that is a different service from a restaurant booking.',
    source: { href: 'https://www.manylittle.com.au/contact', label: 'Check dining sessions and book with Many Little' },
  },
].filter(choice => venues.some(venue => routeSlug(venue) === choice.href.split('/')[2]));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Eat & Drink', href: '/eat/' },
  { label: 'Best Restaurants' },
];
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: absUrl('/') },
  { name: 'Eat & Drink', url: absUrl('/eat/') },
  { name: 'Best Restaurants', url: absUrl('/eat/best-restaurants/') },
]);
export const prerender = true;
---

<BaseLayout
  title="Best Restaurants Mornington Peninsula · Peninsula Insider"
  description="Compare Mornington Peninsula restaurants for dinner, a winery lunch or a special occasion, with dining sessions, booking advice and guides by area."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/best-restaurants"
  ogImage={pageImage('best-restaurants').src}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
  title="The Best Restaurants on the Mornington Peninsula"
  category="Best Restaurants"
  heroImage={pageImage('best-restaurants').src}
  imageAlt={pageImage('best-restaurants').alt}
  imageCaption={pageImage('best-restaurants').caption}
  imageCredit={pageImage('best-restaurants').credit}
  entitySlug="eat/best-restaurants"
  entityType="page"
>
  <div class="prose">
    <p>Start with the meal you want: dinner in Mornington town, a destination restaurant on the ridge, or a winery lunch. The location and dining session matter as much as the name above the door. There is no paid placement in this list.</p>
    <p><a href="#dinner">Compare dinner options</a> · <a href="#rankings">Browse the dining shortlist</a> · <a href="/journal/dog-friendly-cafes-pubs-wineries-mornington-peninsula/">Eating out with a dog</a></p>
  </div>
</SubpageHero>

  <GuideChoices id="dinner" title="Where to go for dinner on the Mornington Peninsula" intro="Two starting points with published evening sessions. These are dinner options, not a new ranking of every restaurant. Check the operator's booking calendar for your date." choices={dinnerChoices} checkedNote={`These two venues' published dinner sessions were checked on ${dinnerCheckedDate}. The wider shortlist retains each venue's existing verification date.`} />

  <section class="venues" id="rankings">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Editorial ranking · {new Date().getFullYear()}</p>
          <h2 class="venues__title">The top {topVenues.length} dining rooms, by authority</h2>
          <p class="venues__sub">Ordered by editorial weight. Rooms with a hat rating first, then the places doing the strongest quiet work.</p>
        </div>
        <a href="/eat/" class="venues__link">All {venues.length} venues →</a>
      </div>
      <div class="venues__grid venues__grid--ranked">
        {topVenues.map((venue) => <VenueCard venue={venue} href={venueHref(venue)} />)}
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="prose">
        <h2>Frequently asked questions</h2>
        {faqSchema.mainEntity.map((item) => (
          <><h3>{item.name}</h3><p>{item.acceptedAnswer.text}</p></>
        ))}
      </div>
    </div>
  </section>


  <section class="venues venues--plain">
    <div class="container">
      <div class="venues__header"><div><p class="label label--accent">Go deeper</p><h2 class="venues__title">Browse by category</h2></div></div>
      <div class="venues__grid venues__grid--links">
        <div class="pi-card"><div class="pi-card__body"><h3 class="pi-card__title"><a href="/eat/hatted-restaurants/">Hatted Restaurants</a></h3><p class="pi-card__dek">Good Food Guide hat table with booking realities for every venue.</p><div class="pi-card__actions"><a href="/eat/hatted-restaurants/" class="pi-btn pi-btn--solid">See the list →</a></div></div></div>
        <div class="pi-card"><div class="pi-card__body"><h3 class="pi-card__title"><a href="/eat/long-lunch/">Long Lunch</a></h3><p class="pi-card__dek">The rooms that carry a whole afternoon - two to three hours at the table.</p><div class="pi-card__actions"><a href="/eat/long-lunch/" class="pi-btn pi-btn--solid">See the list →</a></div></div></div>
        <div class="pi-card"><div class="pi-card__body"><h3 class="pi-card__title"><a href="/eat/fine-dining/">Fine Dining</a></h3><p class="pi-card__dek">Destination dining rooms worth planning a whole Peninsula day around.</p><div class="pi-card__actions"><a href="/eat/fine-dining/" class="pi-btn pi-btn--solid">See the list →</a></div></div></div>
      </div>
    </div>
  </section>
  <NewsletterBlock />
</BaseLayout>
