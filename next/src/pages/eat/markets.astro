---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { routeSlug, isListableVenue } from '../../lib/editorial';
import ProvenanceLine from '../../components/ProvenanceLine.astro';

const allVenues = (await getCollection('venues')).filter(isListableVenue);
const venues=allVenues.filter(v=>v.data.type==='market').sort((a,b)=>(a.data.name??'').localeCompare(b.data.name??''));

const breadcrumbItems=[{label:'Home',href:'/'},{label:'Eat & Drink',href:'/eat/'},{label:'Markets'}];
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Best Markets Mornington Peninsula',description:'Current Peninsula markets, with the original Red Hill Community Market closure and separate Hill and Ridge market explained.',url:'https://peninsulainsider.com.au/eat/markets/',breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{position:1,name:'Home',item:'https://peninsulainsider.com.au/'},{position:2,name:'Eat & Drink',item:'https://peninsulainsider.com.au/eat/'},{position:3,name:'Markets',item:'https://peninsulainsider.com.au/eat/markets/'}].map(e=>({'@type':'ListItem',...e}))},mainEntity:{'@type':'ItemList',itemListOrder:'https://schema.org/ItemListOrderDescending',numberOfItems:venues.length,itemListElement:venues.map((v,i)=>({'@type':'ListItem',position:i+1,name:v.data.name,url:`https://peninsulainsider.com.au/eat/${routeSlug(v)}/`}))}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
  {'@type':'Question',name:'Is the original Red Hill Market open?',acceptedAnswer:{'@type':'Answer',text:'No. Craft Markets Australia says the original Red Hill Community Market is temporarily closed until a new location is found.'}},
  {'@type':'Question',name:'What runs at Red Hill Recreation Reserve?',acceptedAnswer:{'@type':'Answer',text:'Hill and Ridge Community Market is a separate market there on first Saturdays from September to May, 9am to 2pm. Check its organiser for the latest date and weather notices.'}},
  {'@type':'Question',name:'Are Peninsula markets dog-friendly?',acceptedAnswer:{'@type':'Answer',text:'Check each organiser directly before bringing a dog.'}}
]};
export const prerender = true;
---
<BaseLayout title="Best Markets Mornington Peninsula · Peninsula Insider" description="A guide to current Peninsula markets, including Hill and Ridge, Mornington Farmers Market, and Balnarring." section="eat" canonical="https://peninsulainsider.com.au/eat/markets/" modifiedTime="2026-09-23">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Breadcrumbs items={breadcrumbItems} />
  <SubpageHero
  title="Best Markets on the Mornington Peninsula"
  category="Markets"
  heroImage="/images/sourced/article-red-hill-saturday-01.webp"
  imageAlt="Red Hill hinterland, Mornington Peninsula"
  imageCaption="Red Hill hinterland"
  entitySlug="eat/markets"
  entityType="page"
>
  <div class="prose">
    <p>The original Red Hill Community Market is temporarily closed. The separate <a href="/whats-on/hill-ridge-community-market-september-2026-restart/">Hill &amp; Ridge Community Market</a> runs at Red Hill Recreation Reserve on first Saturdays from September to May, 9am to 2pm; check the organiser for weather cancellations. Mornington Farmers Market and Balnarring Farmers Market offer other Peninsula market options.</p><ProvenanceLine style="font-size:0.8rem;color:var(--soft)" records={venues} type="venues" noun="venue" /></div>
  </div>
</SubpageHero>
  <section class="venues" id="rankings"><div class="container"><div class="venues__header"><div><p class="label label--accent">Peninsula markets</p><h2 class="venues__title">All {venues.length} Peninsula food markets</h2><p class="venues__sub">Current Peninsula markets; check organiser schedules before visiting.</p></div><a href="/eat/" class="venues__link">All dining venues →</a></div><div class="venues__grid">{venues.map(v=><VenueCard venue={v} hrefPrefix="/eat" />)}</div></div></section>
  <section class="faq-section"><div class="container"><div class="prose"><h2>Frequently asked questions</h2><h3>Is the original Red Hill Market open?</h3><p>No. Craft Markets Australia says the original Red Hill Community Market is temporarily closed until a new location is found.</p><h3>What runs at Red Hill Recreation Reserve?</h3><p>Hill &amp; Ridge Community Market is a separate market there on first Saturdays from September to May, 9am to 2pm. Check its organiser for the latest date and weather notices.</p><h3>Are Peninsula markets dog-friendly?</h3><p>Check each organiser directly before bringing a dog.</p></div></div></section>
  <NewsletterBlock />
</BaseLayout>
