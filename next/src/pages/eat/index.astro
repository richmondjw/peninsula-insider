---
/**
 * /eat/ - v5 hub rebuild (page-redesigns.md section 2; wireframes #eat).
 *
 * Verdict first, catalogue underneath, one job: a confident shortlist for a
 * specific occasion in under a minute. Structure: breadcrumbless h1 + Editor
 * stand-first in a compact band that also holds the intent chips + FilterBar
 * (ONE filter state governs The Six AND the directory), The Six, the full
 * directory as compact rows (server-rendered, SEO), the shorter guide lists
 * beside a What's On callout, From the Journal, FAQ (in-DOM, mirrors schema).
 *
 * SEO: URL, title, meta, canonical and both schemas unchanged (protect
 * list). Wineries are excluded from this surface entirely (HUB-01): eatTypes
 * has never included 'winery', so the page never held one. The Winery
 * kitchens bridge module that used to sit above the directory was removed
 * 2026-09-13 (PI-009); it filtered `venuesAll` for a type that filter had
 * already excluded, so it always rendered an empty shell while its container
 * div carried data-facets and inflated the result count by one. The
 * reciprocal module on /wine/ still points here.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubStandfirst from '../../components/v5/hub/HubStandfirst.astro';
import TheSix from '../../components/v5/hub/TheSix.astro';
import type { SixItem } from '../../components/v5/hub/TheSix.astro';
import DirectoryRows from '../../components/v5/hub/DirectoryRows.astro';
import type { DirectoryRowItem } from '../../components/v5/hub/DirectoryRows.astro';
import JournalModule from '../../components/v5/hub/JournalModule.astro';
import type { JournalItem } from '../../components/v5/hub/JournalModule.astro';
import AskBand from '../../components/v5/hub/AskBand.astro';
import CategoryBrowse from '../../components/v5/hub/CategoryBrowse.astro';
import PlanningHelp from '../../components/v5/hub/PlanningHelp.astro';
import { informationCheckedOn } from '../../lib/verification-date.mjs';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import FilterBar from '../../components/v5/FilterBar.astro';
import { routeSlug, resolveHeroSrc, hasOwnHeroImage, eatTypes, isListableVenue } from '../../lib/editorial';
import { getFacets } from '../../lib/facets';
import { loadOverrides } from '../../lib/inline-edit/overrides';
import { loadLiveEvents } from '../whats-on/_data';

// ── Data ──────────────────────────────────────────────────────────────────────
const venuesAll = (await getCollection('venues'))
  .filter((venue) => eatTypes.includes(venue.data.type))
  .filter(isListableVenue)
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

// eatTypes (lib/editorial) excludes 'winery', so venuesAll holds none: this
// is a defensive second pass, not a split (one venue, one URL; HUB-01).
const venues = venuesAll.filter((v) => v.data.type !== 'winery');
const viralFoodFestival = (await loadLiveEvents(new Date())).find(
  (event) => event.slug === 'viral-food-festival-mornington-2026',
);

const placesAll = await getCollection('places');
const placeNameBySlug = new Map<string, string>(
  placesAll.map((p) => [p.id ?? p.data.slug, p.data.name]),
);
const placeLabel = (v: any): string => {
  const slug = typeof v.data.place === 'string' ? v.data.place : v.data.place?.id ?? '';
  return placeNameBySlug.get(slug) ?? slug.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
};

const typeLabel: Record<string, string> = {
  restaurant: 'Restaurant',
  cafe: 'Cafe',
  bakery: 'Bakery',
  pub: 'Pub',
  market: 'Market',
  brewery: 'Brewery',
  distillery: 'Distillery',
  providore: 'Providore',
  winery: 'Winery',
};

/** Card image: CMS override first, then the venue's own hero. Text-only when
 *  the venue has no photo of its own (compact-row tolerates that). */
async function cardImage(venue: any): Promise<{ src: string; alt: string; caption?: string } | undefined> {
  const hero = await resolveHero('venue', routeSlug(venue), venue.data);
  if (!hero.hasPhoto) return undefined;
  const status = !hero.override ? venue.data.heroImage?.depictionStatus : undefined;
  return { src: hero.src, alt: hero.alt, caption: status === 'illustrative' ? 'Illustrative image' : status === 'unverified' ? 'Image subject unverified' : undefined };
}

/** lastVerified arrives as a Date via z.coerce; Card wants an ISO string. */
function isoDate(v: unknown): string | undefined {
  if (v instanceof Date) return v.toISOString();
  return typeof v === 'string' ? v : undefined;
}

/** Directory verdict line: the signature's first sentence when it fits the
 *  25-word Critic budget; otherwise the row runs meta-only (copy is never
 *  truncated or rewritten at render time). */
function verdictLine(signature?: string): string | undefined {
  if (!signature) return undefined;
  const first = signature.split(/(?<=[.?])\s+/)[0]?.trim();
  if (!first) return undefined;
  return first.split(/\s+/).length <= 25 ? first : undefined;
}

// ── The Six: editorially pinned by the desk. Each pick shows the venue's
//    one canonical line, the same verdictLine(signature) its directory row
//    below carries, so a venue never reads two different blurbs on one page.
const sixPicks: Array<{ slug: string }> = [
  { slug: 'tedesca-osteria' },
  { slug: 'commonfolk-coffee' },
  { slug: 'merricks-general-wine-store' },
  { slug: 'doot-doot-doot' },
  { slug: 'barragunda-dining' },
  { slug: 'portsea-hotel' },
];

const sixItems: SixItem[] = [];
for (const pick of sixPicks) {
  const venue = venues.find((v) => routeSlug(v) === pick.slug);
  if (!venue) continue;
  sixItems.push({
    title: venue.data.name,
    href: `/eat/${routeSlug(venue)}/`,
    entityType: 'venue',
    entitySlug: routeSlug(venue),
    image: await cardImage(venue),
    verdict: verdictLine(venue.data.signature),
    meta: [placeLabel(venue), typeLabel[venue.data.type] ?? venue.data.type],
    priceBand: venue.data.priceBand,
    freshness: isoDate(informationCheckedOn(venue.data)),
    facets: getFacets('venue', venue.data),
    saveSection: 'eat',
  });
}

// ── Best-of rail: at most 6 links into the strongest guide lanes. ─────────────
const bestOfRail = [
  { href: '/eat/best-restaurants/', label: 'Best restaurants' },
  { href: '/eat/long-lunch/', label: 'Long lunch' },
  { href: '/eat/cellar-door-lunch/', label: 'Cellar-door lunch' },
  { href: '/eat/fine-dining/', label: 'Fine dining' },
  { href: '/eat/no-booking/', label: 'No booking' },
  { href: '/eat/bakeries/', label: 'Bakeries' },
];

// ── Directory rows: every non-winery venue, server-rendered in full. ─────────
const directoryItems: DirectoryRowItem[] = [];
for (const venue of venues) {
  directoryItems.push({
    title: venue.data.name,
    href: `/eat/${routeSlug(venue)}/`,
    entityType: 'venue',
    entitySlug: routeSlug(venue),
    image: await cardImage(venue),
    verdict: verdictLine(venue.data.signature),
    meta: [placeLabel(venue), typeLabel[venue.data.type] ?? venue.data.type],
    priceBand: venue.data.priceBand,
    facets: getFacets('venue', venue.data),
    partnerLabel: venue.data.featuredPartner ? 'Sponsored placement' : undefined,
  });
}

// ── From the Journal (3 maximum). Keep this seasonal selection current. ────
const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const articleJournalItem = (slug: string, verdict: string, displayTitle?: string): JournalItem | null => {
  const article = articlesAll.find((a) => routeSlug(a) === slug);
  if (!article) return null;
  return {
    title: displayTitle ?? article.data.title,
    href: `/journal/${routeSlug(article)}/`,
    entitySlug: routeSlug(article),
    image: article.data.heroImage?.src
      ? { src: article.data.heroImage.src, alt: article.data.heroImage.alt ?? article.data.title }
      : undefined,
    verdict,
    byline: article.data.houseByline
      ? 'Peninsula Insider editors'
      : typeof article.data.author === 'string'
        ? article.data.author
        : article.data.author?.id,
    readTime: article.data.readingTimeMinutes ? `${article.data.readingTimeMinutes} min read` : undefined,
    dateISO: article.data.publishedAt?.toISOString?.(),
  };
};

const journalItems = [
  articleJournalItem(
    'the-spring-peninsula',
    'New leaf, quieter cellar doors, and the case for a slow Spring weekend before the summer rush.',
  ),
  articleJournalItem(
    'the-long-lunch',
    'Three hatted restaurants, a bay view, and the case for letting Sunday lunch run long.',
  ),
  articleJournalItem(
    'the-seafood-list',
    'The Peninsula seafood story, from fishmongers near the pier to the bay-view dining rooms worth booking.',
  ),
].filter((item): item is JournalItem => Boolean(item));

// ── Schemas (unchanged: protect-list page) ────────────────────────────────────
const pillarSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Where to Eat on the Mornington Peninsula',
  description: 'Browse places to eat on the Mornington Peninsula by area and occasion, including restaurants, winery lunches, cafes and bakeries.',
  url: 'https://peninsulainsider.com.au/eat/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What are the best restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Good Food Guide awarded 15 hats across 11 Peninsula venues. The four two-hat restaurants, Barragunda Dining, Laura at Pt. Leo Estate, Tedesca Osteria, and Ten Minutes by Tractor, are the clearest destination dining choices.' } },
    { '@type': 'Question', name: 'Do I need to book restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Book ahead for destination restaurants and weekend lunches. Some casual venues accept walk-ins; Foxeys Hangout operates without bookings according to our venue record. Check the restaurant directly for current hours, group limits and availability before travelling.' } },
    { '@type': 'Question', name: 'What is the best area for food on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Red Hill plateau, including Main Ridge and Red Hill South, has the highest concentration of serious dining. Mornington town has the strongest casual eating scene. Sorrento and Portsea have the best waterfront and atmosphere-first dining. For wine-paired long lunches, stick to the ridge.' } },
    { '@type': 'Question', name: 'When is the best time to visit the Mornington Peninsula for food?',
      acceptedAnswer: { '@type': 'Answer', text: 'Winter (June to August) is the insider season: fires are lit, the best tables are more bookable, and menus lean into braises, roots and slow cooking. Autumn remains the peak vintage season; spring is a close second.' } },
    { '@type': 'Question', name: 'Are there dog-friendly restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, outdoor seating options at cafes, village pub beer gardens, and a small number of winery casual dining areas permit dogs. Commonfolk Coffee (back courtyard), The Rocks Mornington (outdoor deck), Portsea Hotel (beer garden), and Green Olive at Red Hill (garden) are listed as dog-friendly in PI venue records. Verify directly before visiting.' } },
    { '@type': 'Question', name: 'What is the signature food experience on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The long lunch, a two-to-three-hour table at a vineyard restaurant with estate wine and unhurried service. In winter the format sharpens: wood ovens, fires, estate Pinot Noir, and menus built for cold weather.' } },
  ],
};

// The count is stated once, in the directory heading. 'Town' is not a
// visible chip (it lives behind More filters), so the copy does not promise it.
const standfirst = 'Choose a destination lunch, a casual table or a coffee stop. Browse places by occasion, or start with our editorial choices.';

// The visible accordion drops the place name every question repeats (the
// page is already about the Peninsula); the JSON-LD keeps the full question.
const faqShort = (q: string): string => q.replace(/ on the Mornington Peninsula(?=\?)/, '');

export const prerender = true;
---

<BaseLayout
  title="Where to Eat on the Mornington Peninsula · Peninsula Insider"
  description="Find where to eat on the Mornington Peninsula: browse restaurants, winery lunches, cafes and bakeries by area and occasion, with links to our dining shortlists."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/"
  modifiedTime="2026-07-30"
  ogImage="/images/sourced/venue-tedesca-osteria-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(pillarSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- 1. Orient: h1 + Editor stand-first (content-guidelines example 1).
       The compact band contains the page's one filter strip: jump links, the
       FilterBar and the planning help link, so hero to first pick is one
       bounded block with no stacked rules. -->
  <HubStandfirst
    eyebrow="Eat & Drink"
    title="Where to eat on the Mornington Peninsula"
    standfirst={standfirst}
    compact
  >
    <CategoryBrowse directory="directory" noun="places to eat" contained={false}>
      <FilterBar surface="eat" noun="places" label="Filter places to eat" facets={['cat', 'place', 'mood', 'price', 'party']} />
      <PlanningHelp />
    </CategoryBrowse>
  </HubStandfirst>

  <div data-category-editorial>
  <!-- 2. The verdict layer -->
  <TheSix
    id="the-six"
    eyebrow="The dining shortlist"
    heading="A table for the kind of day you want"
    sub="Start with a long lunch, a coffee stop or an easy village meal. Check opening times, menus and bookings with the venue."
    surface="eat"
    items={sixItems}
  />
  </div>

  <!-- 3. The catalogue layer: every non-winery venue, one render, in-DOM.
       ONE state governs The Six AND the directory (URL-persisted;
       restoration per pi:restore:v1 contract); the FilterBar lives in the
       hero band and the editorial layer yields to this list when filtering. -->
  <DirectoryRows
    id="directory"
    eyebrow="The full list"
    heading={`All ${directoryItems.length} places to eat`}
    sub="Use the occasion filters above to make your shortlist."
    noun="places"
    surface="eat"
    items={directoryItems}
    topLink={{ label: 'Our fifteen best tables', href: '/eat/best-restaurants/' }}
    emptyHeading="Nothing matches those filters yet"
    emptyBody="Loosen one and the list comes back."
  >
  </DirectoryRows>

  <!-- 4. After the list: the shorter guide lists as plain text links (pills
       are for filters only) beside a slim What's On callout. -->
  <section class="eat-more" aria-label="Shorter lists and events">
    <div class="container eat-more__inner">
      <nav class="eat-rail" aria-labelledby="eat-rail-heading">
        <p class="pi-eyebrow" id="eat-rail-heading">Shorter lists</p>
        <ul class="eat-rail__list">
          {bestOfRail.map((item) => (
            <li>
              <a href={item.href} class="eat-rail__link">{item.label} <span aria-hidden="true">→</span></a>
            </li>
          ))}
        </ul>
      </nav>
      <aside class="eat-whatson" aria-labelledby="eat-whatson-heading">
        <p class="pi-eyebrow" id="eat-whatson-heading">Also this month</p>
        <p class="eat-whatson__line">
          Food and wine events coming up on the Peninsula.
          {viralFoodFestival && <> <a href={viralFoodFestival.href}>VIRAL Food Festival at Mornington Racecourse, 18–20 September</a>.</>}
        </p>
        <a class="pi-section-link" href="/whats-on/">See What&rsquo;s On <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <!-- 5. From the Journal (3 maximum) -->
  <JournalModule
    id="journal"
    heading="From the Journal"
    items={journalItems}
    moreHref="/journal/"
    surface="eat"
  />

  <!-- 6. FAQ: in-DOM, mirrors faqSchema (visible questions drop the
       repeated place name; the schema keeps it) -->
  <section class="hub-faq pi-section" aria-labelledby="eat-faq-heading">
    <div class="container">
      <div class="pi-section-head">
        <div class="pi-section-head__text">
          <p class="pi-eyebrow">Frequently asked</p>
          <h2 class="pi-h2" id="eat-faq-heading">Six honest answers before you plan the day</h2>
        </div>
      </div>
      <div class="hub-faq__list">
        {faqSchema.mainEntity.map((item) => (
          <details class="hub-faq__item">
            <summary class="hub-faq__q">{faqShort(item.name)}</summary>
            <div class="hub-faq__a"><p>{item.acceptedAnswer.text}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Ask PI band hidden (bug fix in progress) -->
</BaseLayout>

<style>
  /* A quiet band between the list and the Journal: one full-frame rule, the
     guide links on the left, the What's On callout on the right. */
  .eat-more {
    padding-block: var(--space-6, 2rem);
  }
  .eat-more__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-6, 2rem) var(--space-8, 4rem);
    align-items: start;
    border-top: 1px solid var(--border);
    padding-top: var(--space-6, 2rem);
  }
  .eat-rail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 0 var(--space-6, 2rem);
  }
  .eat-rail__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: var(--fs-400, 1.0625rem);
    font-weight: 600;
    color: var(--harbour, #10527E);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color var(--dur-fast, 120ms) var(--ease, ease);
  }
  .eat-rail__link:hover {
    color: var(--harbour-h, #0C4166);
  }
  .eat-rail__link:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }

  .eat-whatson {
    border: 1px solid var(--border);
    border-radius: var(--radius-s, 8px);
    padding: var(--space-4, 1rem);
    background: var(--white);
  }
  .eat-whatson__line {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300, 0.9375rem);
    line-height: 1.6;
    color: var(--soft);
    text-wrap: pretty;
  }
  .eat-whatson__line a {
    color: var(--harbour, #10527E);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 767px) {
    .eat-more__inner { grid-template-columns: minmax(0, 1fr); }
    .eat-rail__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
