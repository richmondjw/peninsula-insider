---
/**
 * /eat/ - v5 hub rebuild (page-redesigns.md section 2; wireframes #eat).
 *
 * Verdict first, catalogue underneath, one job: a confident shortlist for a
 * specific occasion in under a minute. Structure: breadcrumbless h1 + Editor
 * stand-first, intent chips + FilterBar (ONE filter state governs The Six
 * AND the directory), The Six, best-of rail, full non-winery directory as
 * compact rows (server-rendered, SEO), Winery kitchens bridge module,
 * From the Journal, FAQ (in-DOM, mirrors schema), Ask band.
 *
 * SEO: URL, title, meta, canonical and both schemas unchanged (protect
 * list). Wineries are excluded from the directory (HUB-01); their links
 * move to /wine/ via the Winery kitchens module.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubStandfirst from '../../components/v5/hub/HubStandfirst.astro';
import TheSix from '../../components/v5/hub/TheSix.astro';
import type { SixItem } from '../../components/v5/hub/TheSix.astro';
import DirectoryRows from '../../components/v5/hub/DirectoryRows.astro';
import type { DirectoryRowItem } from '../../components/v5/hub/DirectoryRows.astro';
import JournalModule from '../../components/v5/hub/JournalModule.astro';
import AskBand from '../../components/v5/hub/AskBand.astro';
import FilterBar from '../../components/v5/FilterBar.astro';
import { routeSlug, resolveHeroSrc, hasOwnHeroImage } from '../../lib/editorial';
import { getFacets } from '../../lib/facets';
import { loadOverrides } from '../../lib/inline-edit/overrides';

// ── Data ──────────────────────────────────────────────────────────────────────
const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
const venuesAll = (await getCollection('venues'))
  .filter((venue) => eatTypes.includes(venue.data.type))
  .filter((v) => v.data.status !== 'permanently_closed')
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

// Wineries are excluded from the /eat/ directory (one venue, one URL; HUB-01)
// and bridge to /wine/ via the Winery kitchens module below.
const wineries = venuesAll.filter((v) => v.data.type === 'winery');
const venues = venuesAll.filter((v) => v.data.type !== 'winery');

const placesAll = await getCollection('places');
const placeNameBySlug = new Map<string, string>(
  placesAll.map((p) => [p.id ?? p.data.slug, p.data.name]),
);
const placeLabel = (v: any): string => {
  const slug = typeof v.data.place === 'string' ? v.data.place : v.data.place?.id ?? '';
  return placeNameBySlug.get(slug) ?? slug.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
};

const typeLabel: Record<string, string> = {
  restaurant: 'Restaurant',
  cafe: 'Cafe',
  bakery: 'Bakery',
  pub: 'Pub',
  market: 'Market',
  winery: 'Winery',
};

/** Card image: CMS override first, then the venue's own hero. Text-only when
 *  the venue has no photo of its own (compact-row tolerates that). */
async function cardImage(venue: any): Promise<{ src: string; alt: string } | undefined> {
  const slug = routeSlug(venue);
  const overrides = await loadOverrides('venue', slug);
  const heroOverride = overrides.image['heroImage'];
  if (heroOverride?.src) {
    return { src: heroOverride.src, alt: heroOverride.alt ?? venue.data.name };
  }
  if (!hasOwnHeroImage(venue.data)) return undefined;
  return { src: resolveHeroSrc(venue.data), alt: venue.data.heroImage?.alt ?? venue.data.name };
}

/** lastVerified arrives as a Date via z.coerce; Card wants an ISO string. */
function isoDate(v: unknown): string | undefined {
  if (v instanceof Date) return v.toISOString();
  return typeof v === 'string' ? v : undefined;
}

/** Directory verdict line: the signature's first sentence when it fits the
 *  25-word Critic budget; otherwise the row runs meta-only (copy is never
 *  truncated or rewritten at render time). */
function verdictLine(signature?: string): string | undefined {
  if (!signature) return undefined;
  const first = signature.split(/(?<=[.?])\s+/)[0]?.trim();
  if (!first) return undefined;
  return first.split(/\s+/).length <= 25 ? first : undefined;
}

// ── The Six: editorially pinned monthly. Verdicts are Critic voice, 25 words
//    maximum, distilled from each venue's own editorial copy. ─────────────────
const sixPicks: Array<{ slug: string; verdict: string }> = [
  {
    slug: 'tedesca-osteria',
    verdict: 'The long lunch, settled: one set menu, wood oven running all service. Books out four to eight weeks ahead.',
  },
  {
    slug: 'laura-pt-leo',
    verdict: 'Ten courses threaded through the produce garden. Take the counter seat: better view, faster pace, and the kingfish is the order.',
  },
  {
    slug: 'barragunda-dining',
    verdict: 'The occasion booking: a farm dining room on a thousand regenerative acres at Cape Schanck. Plan the whole day around it.',
  },
  {
    slug: 'rare-hare',
    verdict: 'The walk-in long lunch: wood fire, vineyard views, plates built for sharing. Arrive from two on weekends and take the afternoon.',
  },
  {
    slug: 'portsea-hotel',
    verdict: 'The front-row pub on Port Phillip, still the cleanest family lunch at the tip. Come April or October and the view is yours.',
  },
  {
    slug: 'commonfolk-coffee',
    verdict: 'The quick one done properly: the most serious roaster on the Peninsula. Come before ten and order the egg sandwich.',
  },
];

const sixItems: SixItem[] = [];
for (const pick of sixPicks) {
  const venue = venues.find((v) => routeSlug(v) === pick.slug);
  if (!venue) continue;
  sixItems.push({
    title: venue.data.name,
    href: `/eat/${routeSlug(venue)}`,
    entityType: 'venue',
    entitySlug: routeSlug(venue),
    image: await cardImage(venue),
    verdict: pick.verdict,
    meta: [placeLabel(venue), typeLabel[venue.data.type] ?? venue.data.type],
    priceBand: venue.data.priceBand,
    freshness: isoDate(venue.data.lastVerified),
    facets: getFacets('venue', venue.data),
    saveSection: 'eat',
  });
}

// ── Best-of rail: at most 6 links into the strongest guide lanes. ─────────────
const bestOfRail = [
  { href: '/eat/best-restaurants/', label: 'Best restaurants' },
  { href: '/eat/long-lunch/', label: 'Long lunch' },
  { href: '/eat/waterfront/', label: 'Waterfront' },
  { href: '/eat/brunch/', label: 'Best brunch' },
  { href: '/eat/bakeries/', label: 'Bakeries' },
  { href: '/eat/date-night/', label: 'Date night' },
];

// ── Directory rows: every non-winery venue, server-rendered in full. ─────────
const directoryItems: DirectoryRowItem[] = [];
for (const venue of venues) {
  directoryItems.push({
    title: venue.data.name,
    href: `/eat/${routeSlug(venue)}`,
    entityType: 'venue',
    entitySlug: routeSlug(venue),
    image: await cardImage(venue),
    verdict: verdictLine(venue.data.signature),
    meta: [placeLabel(venue), typeLabel[venue.data.type] ?? venue.data.type],
    priceBand: venue.data.priceBand,
    facets: getFacets('venue', venue.data),
    partnerLabel: venue.data.featuredPartner ? 'Partner venue' : undefined,
  });
}

// ── Winery kitchens: the bridge to /wine/ (spec block 18). Kitchens first
//    (lunch-attached facet), then every remaining cellar door link. ───────────
const wineryKitchens = wineries.filter((v) =>
  (getFacets('venue', v.data).mood ?? []).includes('lunch-attached'),
);
const wineryOther = wineries.filter((v) => !wineryKitchens.includes(v));

// ── From the Journal (3 maximum, contextual). ────────────────────────────────
const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const journalPicks: Array<{ slug: string; verdict: string }> = [
  {
    slug: 'where-to-eat-mornington-peninsula',
    verdict: 'The full picture: where to book, what to order, and the one restaurant that recently changed hands.',
  },
  {
    slug: 'hatted-restaurants-mornington-peninsula-2025',
    verdict: 'Four two-hat venues, seven one-hat tables, and the February debut. Booking realities included.',
  },
  {
    slug: 'waterfront-restaurants-mornington-peninsula',
    verdict: 'Three genuine waterfront positions on Port Phillip, what each actually is, and when each one makes sense.',
  },
];

const journalItems = journalPicks
  .map((pick) => {
    const article = articlesAll.find((a) => routeSlug(a) === pick.slug);
    if (!article) return null;
    return {
      title: article.data.title,
      href: `/journal/${routeSlug(article)}/`,
      entitySlug: routeSlug(article),
      image: article.data.heroImage?.src
        ? { src: article.data.heroImage.src, alt: article.data.heroImage.alt ?? article.data.title }
        : undefined,
      verdict: pick.verdict,
      dateISO: article.data.publishedAt?.toISOString?.(),
    };
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

// ── Schemas (unchanged: protect-list page) ────────────────────────────────────
const pillarSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Where to Eat on the Mornington Peninsula',
  description: 'The best restaurants, long lunches, cellar door dining, cafes, bakeries, and waterfront dining on the Mornington Peninsula.',
  url: 'https://peninsulainsider.com.au/eat/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What are the best restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Good Food Guide awarded 15 hats across 11 Peninsula venues. The four two-hat restaurants, Barragunda Dining, Laura at Pt. Leo Estate, Tedesca Osteria, and Ten Minutes by Tractor, are the clearest destination dining choices.' } },
    { '@type': 'Question', name: 'Do I need to book restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most serious restaurants require bookings, especially on weekends. Hatted venues can book out weeks or months in advance. Walk-in options exist: Montalto Piazza (daily), Foxeys Hangout (no bookings taken), Rare Hare at Willow Creek (walk-in from 2pm weekends), and most cafes and bakeries.' } },
    { '@type': 'Question', name: 'What is the best area for food on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Red Hill plateau, including Main Ridge and Red Hill South, has the highest concentration of serious dining. Mornington town has the strongest casual eating scene. Sorrento and Portsea have the best waterfront and atmosphere-first dining. For wine-paired long lunches, stick to the ridge.' } },
    { '@type': 'Question', name: 'When is the best time to visit the Mornington Peninsula for food?',
      acceptedAnswer: { '@type': 'Answer', text: 'Autumn (March to May) is the peak dining season, vintage is running on the ridge, fires are lit in cellar door dining rooms, and the summer crowds have thinned enough that the best tables are actually bookable. Spring is a close second.' } },
    { '@type': 'Question', name: 'Are there dog-friendly restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, outdoor seating options at cafes, village pub beer gardens, and a small number of winery casual dining areas permit dogs. Commonfolk Coffee (back courtyard), The Rocks Mornington (outdoor deck), Portsea Hotel (beer garden), and Green Olive at Red Hill (garden) are confirmed dog-friendly as of April 2026. Verify directly before visiting.' } },
    { '@type': 'Question', name: 'What is the signature food experience on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The long lunch, a two-to-three-hour table at a vineyard restaurant with estate wine and unhurried service. The Peninsula does this better than almost anywhere else in Victoria. Montalto, Laura, Polperro, and Ten Minutes by Tractor are the definitive versions of the format.' } },
  ],
};

const standfirst =
  'The Peninsula has more hatted rooms, cellar door restaurants and long-lunch tables ' +
  'than any region within ninety minutes of Melbourne. The best restaurants, long lunches, ' +
  'cafes and bakeries are all here: six tables worth planning around this month first, ' +
  `then all ${venues.length} places we cover, filterable by occasion and town.`;

export const prerender = true;
---

<BaseLayout
  title="Where to Eat on the Mornington Peninsula · Peninsula Insider"
  description="The best restaurants, long lunches, cellar door dining, cafes, and bakeries on the Mornington Peninsula, editorial picks, not a directory. Updated April 2026."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/"
  modifiedTime="2026-04-30"
  ogImage="/images/sourced/venue-italian-dining-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(pillarSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- 1. Orient: h1 + Editor stand-first (content-guidelines example 1) -->
  <HubStandfirst
    eyebrow="Eat & Drink"
    title="Where to eat on the Mornington Peninsula"
    standfirst={standfirst}
    image={{ src: '/images/sourced/venue-italian-dining-01.webp', alt: 'A Peninsula dining room set for a long lunch' }}
  />

  <!-- 2. Decide: intent chips + filters. ONE state governs The Six AND the
       directory (URL-persisted; restoration per pi:restore:v1 contract). -->
  <div class="container">
    <FilterBar surface="eat" noun="places" label="Filter places to eat" sticky>
    </FilterBar>
  </div>

  <!-- 3. The verdict layer -->
  <TheSix
    id="the-six"
    eyebrow="The Six · this month"
    heading="Six tables worth planning around this month"
    surface="eat"
    items={sixItems}
  />

  <!-- Best-of rail: the strongest guide lanes, 6 maximum -->
  <nav class="eat-rail" aria-label="Best-of guides">
    <div class="container">
      <ul class="eat-rail__list">
        {bestOfRail.map((item) => (
          <li>
            <a href={item.href} class="eat-rail__link">{item.label} &rarr;</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- 4. The catalogue layer: every non-winery venue, one render, in-DOM -->
  <DirectoryRows
    id="directory"
    eyebrow="The full list"
    heading={`All ${directoryItems.length} places to eat`}
    sub="Ordered by editorial weight. The filters above reshape this list."
    noun="places"
    surface="eat"
    items={directoryItems}
    topLink={{ label: 'Ranked top 15', href: '/eat/best-restaurants/' }}
    emptyHeading="Nothing matches those filters yet"
    emptyBody="Loosen one and the list comes back. Or tell PI the occasion."
  >
    <div
      slot="before-list"
      class="eat-winery-kitchens"
      data-facets='{"cat":["winery"]}'
      data-title="Winery kitchens"
    >
      <h3 class="eat-winery-kitchens__heading">Winery kitchens</h3>
      <p class="eat-winery-kitchens__sub">
        The vineyard dining rooms live with their wineries, one page per venue.
      </p>
      <ul class="eat-winery-kitchens__list">
        {wineryKitchens.map((venue) => (
          <li>
            <a href={`/wine/${routeSlug(venue)}/`} class="eat-winery-kitchens__link">{venue.data.name}</a>
          </li>
        ))}
      </ul>
      {wineryOther.length > 0 && (
        <p class="eat-winery-kitchens__more">
          Plus {wineryOther.length} more cellar doors without a kitchen:
          <a href="/wine/">all wineries on /wine/ &rarr;</a>
        </p>
      )}
    </div>
  </DirectoryRows>

  <!-- What's On, one line + link (spec block 18: strip becomes a line) -->
  <p class="eat-whatson container">
    Food and wine events coming up on the Peninsula:
    <a href="/whats-on/">see What&rsquo;s On &rarr;</a>
  </p>

  <!-- 5. From the Journal (3 maximum) -->
  <JournalModule
    id="journal"
    heading="From the Journal"
    items={journalItems}
    moreHref="/journal/"
    surface="eat"
  />

  <!-- 6. FAQ: in-DOM, mirrors faqSchema (retained verbatim from v4) -->
  <section class="hub-faq" aria-label="Frequently asked questions">
    <div class="container">
      <div class="hub-faq__intro">
        <p class="label label--accent">Frequently asked</p>
        <h2 class="hub-faq__title">Six honest answers before you plan the day</h2>
      </div>
      <div class="hub-faq__list">
        <details class="hub-faq__item">
          <summary class="hub-faq__q">What are the best restaurants on the Peninsula?</summary>
          <div class="hub-faq__a"><p>The Good Food Guide awarded 15 hats across 11 venues. The four two-hat restaurants, Barragunda Dining, Laura at Pt. Leo, Tedesca Osteria, and Ten Minutes by Tractor, are the clearest destination dining choices. For long lunch without the hatted commitment: Montalto, Polperro, and Paringa Estate.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Do I need to book?</summary>
          <div class="hub-faq__a"><p>Most serious restaurants require bookings, especially on weekends. Hatted venues book weeks or months ahead. Walk-in options: Montalto Piazza (daily), Foxeys Hangout (no bookings taken), Rare Hare at Willow Creek (from 2pm weekends), and most cafes and bakeries.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">What is the best area for food?</summary>
          <div class="hub-faq__a"><p>The Red Hill plateau has the highest concentration of serious dining. Mornington has the strongest casual eating scene. For wine-paired long lunches, stay on the ridge, Main Ridge and Red Hill South are where the best rooms are.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">When is the best time to visit for food?</summary>
          <div class="hub-faq__a"><p>Autumn (March–May), vintage running, summer crowds thinned, best tables actually bookable. Spring is a close second. Winter cellar door lunches with fires are underrated.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Are there dog-friendly dining options?</summary>
          <div class="hub-faq__a"><p>Yes, outdoor seating at cafes, village pub beer gardens, and a small number of winery casual areas. Commonfolk (back courtyard), Portsea Hotel (beer garden), The Rocks Mornington (outdoor deck), and Green Olive at Red Hill (garden) are confirmed as of April 2026. Verify before visiting.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">What is the Peninsula's signature food experience?</summary>
          <div class="hub-faq__a"><p>The long lunch. A two-to-three-hour table at a vineyard restaurant with estate wine and unhurried service. The Peninsula does this better than almost anywhere else in Victoria. Montalto, Laura, Polperro, and Ten Minutes by Tractor are the definitive versions.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- 7. One next step (P9) -->
  <AskBand
    heading="Can't decide? Ask PI"
    body="Tell PI the occasion, the town and who is coming. It answers from our reviews."
    prompts={[
      'Where should we eat for a long lunch?',
      'Date night near Sorrento?',
      'Lunch with kids today?',
    ]}
    surface="eat"
  />
</BaseLayout>

<style>
  .eat-rail {
    padding: var(--space-4, 1rem) 0 var(--space-6, 2rem);
  }
  .eat-rail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
  }
  .eat-rail__link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-4, 1rem);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-pill, 999px);
    background: var(--white);
    font-family: var(--font-ui);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .eat-rail__link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .eat-rail__link:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }

  .eat-winery-kitchens {
    border: 1px solid var(--border);
    border-radius: var(--radius-l, 28px);
    background: var(--bg-alt);
    padding: var(--space-6, 2rem);
    margin-bottom: var(--space-6, 2rem);
  }
  .eat-winery-kitchens__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-600, 1.4rem);
    font-weight: var(--fw-display, 600);
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .eat-winery-kitchens__sub {
    margin: var(--space-2, 0.5rem) 0 var(--space-3, 0.75rem);
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-200, 0.8125rem);
    color: var(--soft);
  }
  .eat-winery-kitchens__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-1, 0.25rem) var(--space-4, 1rem);
  }
  .eat-winery-kitchens__link {
    display: inline-block;
    padding: var(--space-1, 0.25rem) 0;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }
  .eat-winery-kitchens__link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .eat-winery-kitchens__link:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .eat-winery-kitchens__more {
    margin: var(--space-3, 0.75rem) 0 0;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-200, 0.8125rem);
    color: var(--soft);
  }
  .eat-winery-kitchens__more a {
    color: var(--accent);
  }

  .eat-whatson {
    margin: 0 auto var(--space-5, 1.5rem);
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    color: var(--soft);
  }
  .eat-whatson a {
    color: var(--accent);
  }
</style>
