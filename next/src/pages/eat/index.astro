---
/**
 * /eat/ - v5 hub rebuild (page-redesigns.md section 2; wireframes #eat).
 *
 * Verdict first, catalogue underneath, one job: a confident shortlist for a
 * specific occasion in under a minute. Structure: breadcrumbless h1 + Editor
 * stand-first, intent chips + FilterBar (ONE filter state governs The Six
 * AND the directory), The Six, best-of rail, the full directory as compact
 * rows (server-rendered, SEO), From the Journal, FAQ (in-DOM, mirrors
 * schema), Ask band.
 *
 * SEO: URL, title, meta, canonical and both schemas unchanged (protect
 * list). Wineries are excluded from this surface entirely (HUB-01): eatTypes
 * has never included 'winery', so the page never held one. The Winery
 * kitchens bridge module that used to sit above the directory was removed
 * 2026-09-13 (PI-009); it filtered `venuesAll` for a type that filter had
 * already excluded, so it always rendered an empty shell while its container
 * div carried data-facets and inflated the result count by one. /wine/ links
 * here from its What's On line.
 *
 * Phase 5 (2026-11-10, say it once): the hero finder's type/town selects
 * duplicated the directory filters, so only its search survives, beside the
 * filter bar (EatSearch). The Six shows all six picks as equal cards; the
 * guide-lane rail is one line of links; the Save/Trip explainer is gone; the
 * check date is said once at the head of the list, not on every row.
 */
import { categoryHero } from '../../lib/category-heroes';
import { pageImage } from '../../lib/page-images';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EatEntry from '../../components/v5/hub/EatEntry.astro';
import SortControl from '../../components/v5/SortControl.astro';
import TheSix from '../../components/v5/hub/TheSix.astro';
import type { SixItem } from '../../components/v5/hub/TheSix.astro';
import DirectoryRows from '../../components/v5/hub/DirectoryRows.astro';
import type { DirectoryRowItem } from '../../components/v5/hub/DirectoryRows.astro';
import JournalModule from '../../components/v5/hub/JournalModule.astro';
import type { JournalItem } from '../../components/v5/hub/JournalModule.astro';
import { resolveJournalImage } from '../../lib/journal-image';
import CategoryBrowse from '../../components/v5/hub/CategoryBrowse.astro';
import EatSearch from '../../components/v5/hub/EatSearch.astro';
import { freshnessLabel } from '../../lib/freshness';
import { informationCheckedOn } from '../../lib/verification-date.mjs';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import { hasWebsitePhotoEvidence } from '../../lib/media-provenance';
import { cleanCaption, isArtwork } from '../../lib/image-caption.mjs';
import FilterBar from '../../components/v5/FilterBar.astro';
import { routeSlug, eatTypes, isListableVenue } from '../../lib/editorial';
import { getFacets } from '../../lib/facets';
import { loadLiveEvents } from '../whats-on/_data';

// ── Data ──────────────────────────────────────────────────────────────────────
const venuesAll = (await getCollection('venues'))
  .filter((venue) => eatTypes.includes(venue.data.type))
  .filter(isListableVenue)
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

// eatTypes (lib/editorial) excludes 'winery', so venuesAll holds none: this
// is a defensive second pass, not a split (one venue, one URL; HUB-01).
const venues = venuesAll.filter((v) => v.data.type !== 'winery');
const viralFoodFestival = (await loadLiveEvents(new Date())).find(
  (event) => event.slug === 'viral-food-festival-mornington-2026',
);

const placesAll = await getCollection('places');
const placeNameBySlug = new Map<string, string>(
  placesAll.map((p) => [p.id ?? p.data.slug, p.data.name]),
);
const placeLabel = (v: any): string => {
  const slug = typeof v.data.place === 'string' ? v.data.place : v.data.place?.id ?? '';
  return placeNameBySlug.get(slug) ?? slug.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
};

const typeLabel: Record<string, string> = {
  restaurant: 'Restaurant',
  cafe: 'Cafe',
  bakery: 'Bakery',
  pub: 'Pub',
  market: 'Market',
  brewery: 'Brewery',
  distillery: 'Distillery',
  providore: 'Providore',
  winery: 'Winery',
};

/** Directory and Six cards may show only images with their own recorded
 *  subject and rights evidence. CMS replacements have no per-image permission
 *  fields; a different frontmatter photo cannot lend them its provenance. */
async function cardImage(venue: any): Promise<{ src: string; alt: string; caption?: string; credit?: string } | undefined> {
  const image = venue.data.heroImage;
  if (!hasWebsitePhotoEvidence(image)) return undefined;
  const hero = await resolveHero('venue', routeSlug(venue), venue.data, 'heroImage', { ignoreOverride: true });
  if (!hero.hasPhoto) return undefined;
  const art = isArtwork(image);
  return {
    src: hero.src,
    alt: hero.alt,
    caption: art ? undefined : cleanCaption(image.caption) || undefined,
    credit: art ? undefined : image.credit,
  };
}

/** lastVerified arrives as a Date via z.coerce; Card wants an ISO string. */
function isoDate(v: unknown): string | undefined {
  if (v instanceof Date) return v.toISOString();
  return typeof v === 'string' ? v : undefined;
}

/** Directory verdict line: the signature's first sentence when it fits the
 *  25-word Critic budget; otherwise the row runs meta-only (copy is never
 *  truncated or rewritten at render time). */
function verdictLine(signature?: string): string | undefined {
  if (!signature) return undefined;
  // Protect place abbreviations such as "Pt. Leo" before splitting the first sentence.
  const protectedCopy = signature.replace(/\b(Pt|St|Mr|Mrs|Dr)\./g, (_match, prefix) => prefix + '\uE000');
  const first = protectedCopy.split(/(?<=[.!?])\s+/)[0]?.replace(/\uE000/g, '.').trim();
  if (!first) return undefined;
  return first.split(/\s+/).length <= 25 ? first : undefined;
}

// ── The Six: editorially pinned by the desk. Verdicts are Critic
//    voice, 25 words maximum, distilled from each venue's own editorial copy.
const sixPicks: Array<{ slug: string; verdict: string; plateLabel?: string; planning: string; source: string }> = [
  {
    slug: 'merricks-general-wine-store',
    planning: 'Breakfast and lunch; reserve online',
    source: 'https://merricksstore.com.au/reservations/',
    plateLabel: 'A village lunch',
    verdict: 'Breakfast or lunch in Merricks, with local wines and fireside or deck tables. A village stop before exploring the ridge.',
  },
  {
    slug: 'commonfolk-coffee',
    planning: 'Walk-ins or limited reservations',
    source: 'https://www.commonfolkcoffee.com.au/pages/locations/mornington',
    verdict: 'A Mornington cafe beside its roastery, with a full menu and dog-friendly courtyard. Useful for coffee, brunch or a casual family stop.',
  },

  {
    slug: 'tedesca-osteria',
    planning: 'Allow 3½–4 hours; no vegan menu',
    source: 'https://www.tedesca.com.au/book-tedesca',
    plateLabel: 'The long lunch',
    verdict: 'A fixed-menu farm lunch in Red Hill. Plan a long sitting and tell the kitchen about dietary needs when booking.',
  },

  {
    slug: 'doot-doot-doot',
    planning: 'Evening dining; check availability',
    source: 'https://jackalopehotels.com/drink-dine/',
    verdict: 'Jackalope’s dining room offers a multi-course tasting menu to guests and visitors. Choose this for an evening occasion.',
  },
  {
    slug: 'barragunda-dining',
    planning: 'Four-course set menu; reserve ahead',
    source: 'https://www.barragunda.com.au/dining/',
    verdict: 'A four-course farm menu in Cape Schanck, built around estate produce. Choose this for a planned farm-to-table meal; reserve ahead.',
  },
  {
    slug: 'portsea-hotel',
    planning: 'Pub dining; check table availability',
    source: 'https://portseahotel.com.au/',
    verdict: 'A seaside pub with dining areas overlooking Port Phillip Bay. Choose it for a coastal meal, then check the calendar for live music.',
  },
];

const sixItems: SixItem[] = [];
for (const pick of sixPicks) {
  const venue = venues.find((v) => routeSlug(v) === pick.slug);
  if (!venue) continue;
  sixItems.push({
    title: venue.data.name,
    href: `/eat/${routeSlug(venue)}/`,
    entityType: 'venue',
    entitySlug: routeSlug(venue),
    image: await cardImage(venue),
    plateLabel: pick.plateLabel,
    verdict: pick.verdict,
    meta: [placeLabel(venue), typeLabel[venue.data.type] ?? venue.data.type],
    // The practical line joins the card's one meta line. The operator link
    // (pick.source, the evidence for that line) lives on the venue page: the
    // whole card is the way in, with no second outbound action on it.
    planningNote: pick.planning,
    facets: getFacets('venue', venue.data),
    saveSection: 'eat',
  });
}

// ── Best-of rail: at most 6 links into the strongest guide lanes. ─────────────
const bestOfRail = [
  { href: '/eat/best-restaurants/', label: 'Restaurants & dinner' },
  { href: '/eat/long-lunch/', label: 'Long lunch' },
  { href: '/eat/cellar-door-lunch/', label: 'Cellar-door lunch' },
  { href: '/eat/fine-dining/', label: 'Fine dining' },
  { href: '/eat/no-booking/', label: 'No booking' },
  { href: '/eat/bakeries/', label: 'Bakeries' },
];

// ── Directory rows: every non-winery venue, server-rendered in full. Rows are
//    text (one row style across the hubs): no thumbnail, so no credit line
//    per row. The six picks above are marked `featured`, so the list does not
//    repeat them until a filter or search asks for every match. ─────────────
const sixSlugs = new Set(sixItems.map((item) => item.entitySlug));
const directoryItems: DirectoryRowItem[] = [];
for (const venue of venues) {
  directoryItems.push({
    title: venue.data.name,
    href: `/eat/${routeSlug(venue)}/`,
    entityType: 'venue',
    entitySlug: routeSlug(venue),
    featured: sixSlugs.has(routeSlug(venue)),
    verdict: verdictLine(venue.data.signature),
    meta: [placeLabel(venue), typeLabel[venue.data.type] ?? venue.data.type],
    facets: getFacets('venue', venue.data),
    partnerLabel: venue.data.featuredPartner ? 'Sponsored placement' : undefined,
  });
}

/** Say the check date once, at the head of the list, instead of on every row. */
function checkedSpan(dates: Array<string | undefined>): string {
  const sorted = dates.filter((d): d is string => Boolean(d)).sort();
  const first = freshnessLabel(sorted[0])?.replace('Reviewed ', '');
  const last = freshnessLabel(sorted[sorted.length - 1])?.replace('Reviewed ', '');
  if (!first || !last) return '';
  const lead = sorted.length === dates.length ? 'Details checked' : 'Most details checked';
  if (first === last) return `${lead} ${first}`;
  const [fm, fy] = first.split(' ');
  return `${lead} between ${fy === last.split(' ')[1] ? fm : first} and ${last}`;
}
const directoryChecked = checkedSpan(venues.map((venue) => isoDate(informationCheckedOn(venue.data))));

// ── From the Journal (3 maximum). Keep this seasonal selection current. ────
const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const articleJournalItem = async (slug: string, verdict: string, displayTitle?: string): Promise<JournalItem | null> => {
  const article = articlesAll.find((a) => routeSlug(a) === slug);
  if (!article) return null;
  const image = await resolveJournalImage(routeSlug(article), article.data);
  return {
    title: displayTitle ?? article.data.title,
    href: `/journal/${routeSlug(article)}/`,
    entitySlug: routeSlug(article),
    image: {src:image.src, alt:image.alt, caption:image.caption, credit:image.credit},
    verdict,
    byline: article.data.houseByline
      ? 'Peninsula Insider editors'
      : typeof article.data.author === 'string'
        ? article.data.author
        : article.data.author?.id,
    readTime: article.data.readingTimeMinutes ? `${article.data.readingTimeMinutes} min read` : undefined,
    dateISO: article.data.publishedAt?.toISOString?.(),
  };
};

const journalItems = (await Promise.all([
  articleJournalItem(
    'the-spring-peninsula',
    'New leaf, quieter cellar doors, and the case for a slow Spring weekend before the summer rush.',
  ),
  articleJournalItem(
    'the-long-lunch',
    'A lunch on the ridge, a bay view, and the case for leaving the afternoon open.',
  ),
  articleJournalItem(
    'the-seafood-list',
    'The Peninsula seafood story, from fishmongers near the pier to the bay-view dining rooms worth booking.',
  ),
])).filter((item): item is JournalItem => Boolean(item));

// ── Schemas (unchanged: protect-list page) ────────────────────────────────────
const pillarSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Where to Eat on the Mornington Peninsula',
  description: 'Browse places to eat on the Mornington Peninsula by area and occasion, including restaurants, winery lunches, cafes and bakeries.',
  url: 'https://peninsulainsider.com.au/eat/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What are the best restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Start with our editorial shortlist for different kinds of day, or open the restaurant guide for a longer comparison. The right choice depends on your town, occasion and appetite. Check current menus and booking availability with the operator.' } },
    { '@type': 'Question', name: 'Do I need to book restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'For a planned restaurant lunch or celebration, check booking availability before travelling. Our no-booking guide is a starting point for a more spontaneous day, but it does not guarantee a table. Confirm current hours, group limits and walk-in arrangements with the venue.' } },
    { '@type': 'Question', name: 'What is the best area for food on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Choose your town in the finder to see the places in our current directory. Compare Red Hill and Merricks for the ridge, Mornington for the bay side, or Sorrento and Portsea for the southern Peninsula. The map helps you choose a stop that fits the rest of your day.' } },
    { '@type': 'Question', name: 'When is the best time to visit the Mornington Peninsula for food?',
      acceptedAnswer: { '@type': 'Answer', text: 'Build the visit around the meal you want and the venue’s current opening days. Menus, service times and availability change with the season. Use the venue’s own website to confirm the day before you make the drive.' } },
    { '@type': 'Question', name: 'Are there dog-friendly restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Use the Dog-friendly party filter to find possibilities recorded in our directory. Ask the venue about its current pet policy, the area where dogs are permitted and any restrictions before visiting. A filter match is a planning aid, not a guarantee.' } },
    { '@type': 'Question', name: 'What is the signature food experience on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'A long lunch is one way into the Peninsula’s dining scene. Our long-lunch and cellar-door-lunch guides give you a starting shortlist. For tasting-led visits rather than a meal, continue to the Wine guide.' } },
  ],
};


export const prerender = true;
---

<BaseLayout
  title="Where to Eat on the Mornington Peninsula · Peninsula Insider"
  description="Find where to eat on the Mornington Peninsula: browse restaurants, winery lunches, cafes and bakeries by area and occasion, with links to our dining shortlists."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/"
  modifiedTime="2026-10-08"
  ogImage={categoryHero('eat').src}
>
  <script type="application/ld+json" set:html={JSON.stringify(pillarSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- 1. Orient: h1 + Editor stand-first (content-guidelines example 1) -->
  <EatEntry count={venues.length} image={pageImage('eat-hero')} />
  <CategoryBrowse directory="directory" count={directoryItems.length} noun="places to eat" showLinks={false} />

  <div data-category-editorial>
  <!-- 2. The verdict layer: six equal cards, all visible. Picks without a
       rights-cleared photograph are text cards; nothing stands in for one. -->
  <TheSix
    id="the-six"
    heading="Six starting points. Six different days."
    surface="eat"
    items={sixItems}
    trip={false}
    suppressImageHydration
    lockImageEditing
  />
  </div>

  <!-- 4. The catalogue layer: every non-winery venue, one render, in-DOM.
       Search, filters and sort sit together above the list they change.
       ONE URL-persisted state still governs The Six AND the directory. -->
  <DirectoryRows
    id="directory"
    heading={`All ${directoryItems.length} places to eat`}
    sub={`${directoryChecked ? `${directoryChecked}. ` : ''}Confirm hours with the venue before you go.`}
    noun="places"
    surface="eat"
    items={directoryItems}
    fullVerdicts
    desktopColumns={2}
    initialLimit={8}
    emptyHeading="Nothing matches those filters yet"
    emptyBody="Loosen one and the list comes back."
  >
    <Fragment slot="before-list"><EatSearch /><FilterBar surface="eat" noun="places" label="Filter places to eat" facets={['cat', 'place', 'mood', 'party']} pinnedMore sticky><SortControl /></FilterBar></Fragment>
    <p slot="after-list" class="eat-correction">Something changed at one of these places? <a href="/corrections/">Tell us</a></p>
  </DirectoryRows>

  <!-- What's On, one line + link (spec block 18: strip becomes a line) -->
  <p class="eat-whatson container">
    Food and wine events coming up on the Peninsula:{' '}
    {viralFoodFestival && <><a href={viralFoodFestival.href}>VIRAL Food Festival at Mornington Racecourse, 18–20 September</a>. For the wider edit,{' '}</>}
    <a href="/whats-on/">see What&rsquo;s On &rarr;</a>
  </p>

  <!-- 5. From the Journal (3 maximum) -->
  <div class="eat-reading"><JournalModule
    id="journal"
    heading="From the Journal"
    items={journalItems}
    moreHref="/journal/"
    surface="eat"
  /></div>

  <!-- 6. FAQ: in-DOM, mirrors faqSchema -->
  <section class="hub-faq" aria-label="Frequently asked questions">
    <div class="container">
      <div class="hub-faq__intro">
        <h2 class="hub-faq__title">Six honest answers before you plan the day</h2>
      </div>
      <div class="hub-faq__list">
        {faqSchema.mainEntity.map((item) => (
          <details class="hub-faq__item">
            <summary class="hub-faq__q">{item.name}</summary>
            <div class="hub-faq__a"><p>{item.acceptedAnswer.text}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Guide lanes: one quiet line beside the questions they answer. -->
  <nav class="container hub-guides" aria-label="Eat guides">
    <span>Guides:</span>
    {bestOfRail.map((item, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}<a href={item.href}>{item.label}</a></>))}
  </nav>

  <!-- 7. Ask PI band hidden (bug fix in progress) -->
</BaseLayout>

<style>
  /* Guide lanes: one quiet line of links after the FAQ, no rules. */
  .hub-guides{display:flex;flex-wrap:wrap;align-items:center;gap:0 .35rem;padding-block:0 var(--space-7);font:400 var(--fs-300)/1.5 var(--font-ui);color:var(--soft)}
  .hub-guides > span:first-child{margin-inline-end:.25rem}
  .hub-guides a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent);font-weight:600;text-underline-offset:.2em}
  .hub-guides a:focus-visible,.eat-correction a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .eat-correction{margin:var(--space-5) 0 0;font:400 var(--fs-300)/1.5 var(--font-ui);color:var(--soft)}
  .eat-correction a{color:var(--accent);font-weight:600;text-underline-offset:.2em}

  .eat-whatson {
    margin: 0 auto var(--space-5, 1.5rem);
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    color: var(--soft);
  }
  .eat-whatson a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
</style>
