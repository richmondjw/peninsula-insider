---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueDetailTemplate from '../../components/VenueDetailTemplate.astro';
import EventStrip from '../../components/EventStrip.astro';
import { routeSlug, typeLabel, titleize, isUpcoming } from '../../lib/editorial';
import { sanityReadEnabled } from '../../lib/sanity/client';
import { fetchVenueFromSanity } from '../../lib/sanity/venue-adapter';

export async function getStaticPaths() {
  const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
  const venues = await getCollection('venues');
  return venues
    .filter((venue) => eatTypes.includes(venue.data.type))
    .filter((venue) => venue.data.status !== 'permanently_closed')
    .map((venue) => ({
      params: { slug: routeSlug(venue) },
      props: { venue },
    }));
}

const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
let { venue } = Astro.props;
const slug = routeSlug(venue);

// Dual-read: when the venues flag is on, swap the focused venue for the
// Sanity-sourced equivalent. If Sanity returns null (doc unpublished or
// missing), the JSON-loaded venue stays in place. Related/article/event
// lookups below remain on JSON until their own phase migrates.
// Preview mode: when an editor opens the page inside Studio's
// Presentation iframe, Astro.locals.sanityPreview is true (set by
// middleware) and the adapter switches to the stega-encoded preview
// client so the Visual Editing overlay can attach clickable hotspots.
const previewMode = (Astro.locals as Record<string, unknown>).sanityPreview === true;
if (sanityReadEnabled('venues')) {
  const sanityVenue = await fetchVenueFromSanity(slug, {preview: previewMode});
  if (sanityVenue) venue = sanityVenue as any;
}

const allVenues = await getCollection('venues');
const related = allVenues
  .filter((entry) => routeSlug(entry) !== slug)
  .filter((entry) => eatTypes.includes(entry.data.type))
  .filter((entry) => String(entry.data.place?.id ?? entry.data.place) === String(venue.data.place?.id ?? venue.data.place))
  .slice(0, 3);

// Cross-link articles that reference this venue
const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .filter((article) =>
    article.data.relatedVenues.some((entry) => String(entry.id ?? entry) === slug)
  )
  .slice(0, 3);

// Cross-link itineraries that include this venue as a stop
const itineraries = (await getCollection('itineraries'))
  .filter((itinerary) =>
    itinerary.data.stops.some((stop) => String(stop.venue?.id ?? stop.venue ?? '') === slug)
  )
  .slice(0, 2);

// Events at this venue: only render the strip when at least one event has
// a clean venue ref pointing at this venue. Renders nothing for venues
// that exist only as dining destinations (no event programme).
const venueEvents = (await getCollection('events'))
  .filter((event) => String(event.data.venue?.id ?? event.data.venue ?? '') === slug)
  .filter((event) => {
    if (['weekly', 'monthly', 'ongoing'].includes(event.data.recurrence)) return true;
    return isUpcoming(event.data.endDate ?? event.data.startDate);
  })
  .sort((a, b) => (b.data.visitorAppealScore ?? 0) - (a.data.visitorAppealScore ?? 0))
  .slice(0, 3);

const venuePlaceName = titleize(String(venue.data.place?.id ?? venue.data.place ?? ''));
const venueTypeLabel = typeLabel[venue.data.type] ?? titleize(venue.data.type);
// SEO description: prefer signature if it's substantive (>=90 chars);
// otherwise fall back to the first paragraph of editorNote, trimmed to ~155 chars.
const sigDesc = (venue.data.signature ?? '').trim();
const editorLead = (venue.data.editorNote ?? '').split(/\n\s*\n/)[0].replace(/\s+/g, ' ').trim();
const description = sigDesc.length >= 90 ? sigDesc : (editorLead || sigDesc).slice(0, 158);
// Wineries get a /wine/{slug}/ page as their canonical home (see
// next/src/lib/editorial.ts venueHrefPrefix). They also get a /eat/{slug}/
// page emitted from this template because wineries serve food too. To stop
// Google from indexing both URLs as competing duplicates, we set the
// canonical on /eat/{winery-slug}/ to the /wine/{winery-slug}/ URL.
// Pre-fix data showed kerri-greens, polperro, and others indexed at both
// URLs. See ops/reports/seo/experiments.md experiment 2026-05-05-03.
const canonical = venue.data.type === 'winery'
  ? `https://peninsulainsider.com.au/wine/${slug}/`
  : `https://peninsulainsider.com.au/eat/${slug}/`;
const ogImage = venue.data.heroImage?.src && !venue.data.heroImage.src.includes('placeholder')
  ? venue.data.heroImage.src
  : '/images/sourced/home-cover.webp';

// JSON-LD: map venue type to schema.org type
const schemaTypeMap: Record<string, string> = {
  restaurant: 'Restaurant',
  cafe: 'CafeOrCoffeeShop',
  bakery: 'Bakery',
  pub: 'BarOrPub',
  market: 'LocalBusiness',
  winery: 'Winery',
};
const schemaType = schemaTypeMap[venue.data.type] ?? 'LocalBusiness';

const venueSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: venue.data.name,
  description: venue.data.signature,
  address: {
    '@type': 'PostalAddress',
    streetAddress: venue.data.address,
    addressRegion: 'VIC',
    addressCountry: 'AU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: venue.data.coordinates?.lat,
    longitude: venue.data.coordinates?.lng,
  },
  ...(venue.data.website ? { url: venue.data.website } : {}),
  ...(venue.data.phone ? { telephone: venue.data.phone } : {}),
  // priceRange intentionally omitted (BRAND-PI 2026-05-15: no pricing on site).
};
export const prerender = true;
---

<BaseLayout
  title={`${venue.data.name}, ${venuePlaceName} · Peninsula Insider`}
  description={description}
  section="eat"
  canonical={canonical}
  ogImage={ogImage}
  noindex={venue.data.sitemapExclude === true}
>
  <script type="application/ld+json" set:html={JSON.stringify(venueSchema)} />
  <VenueDetailTemplate venue={venue} section="eat" related={related} articles={articles} itineraries={itineraries} />

  <EventStrip
    events={venueEvents}
    eyebrow="On the calendar here"
    heading={`${venue.data.name} is also a real event venue`}
    intro={`Upcoming events at ${venue.data.name}, with editorial notes when we have them.`}
    moreHref="/whats-on/"
    moreLabel="All events"
    variant="alt"
  />
</BaseLayout>
