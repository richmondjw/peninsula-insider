---
/**
 * /alerts/ — event alert subscriptions (Phase 4 WS4B).
 *
 * Reader-configurable alerts for events matching their criteria. Local
 * storage is the source of truth for anonymous users; signed-in users
 * sync to pi.event_alerts via the existing CloudSync pattern.
 *
 * Browser Notifications API for in-session delivery (when permission
 * granted). Email digest delivery handled by an out-of-repo cron worker
 * that joins pi.event_alerts against pi.events weekly.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHero from '../components/SectionHero.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import CloudSyncIndicatorScript from '../components/CloudSyncIndicatorScript.astro';

const places = await getCollection('places');
const placeOptions = places
  .filter((p) => !p.data.sitemapExclude)
  .map((p) => ({ slug: p.id ?? p.data.slug, name: p.data.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const categoryOptions = [
  { value: 'food-wine',       label: 'Food & wine' },
  { value: 'market',          label: 'Markets' },
  { value: 'cellar-door',     label: 'Cellar door' },
  { value: 'live-music',      label: 'Live music' },
  { value: 'wellness',        label: 'Wellness' },
  { value: 'family-programs', label: 'Family programs' },
  { value: 'arts',            label: 'Arts' },
  { value: 'exhibition',      label: 'Exhibitions' },
  { value: 'festival',        label: 'Festivals' },
  { value: 'racing-sport',    label: 'Racing & sport' },
  { value: 'nature',          label: 'Nature' },
  { value: 'writers-ideas',   label: 'Writers & ideas' },
];

const lensOptions = [
  { value: 'weekend-pick',    label: "Editor's weekend picks" },
  { value: 'family-saturday', label: 'Family Saturday A-grade' },
  { value: 'rainy-day',       label: 'Rainy-day' },
  { value: 'worth-the-drive', label: 'Worth the drive' },
  { value: 'free',            label: 'Free events' },
  { value: 'date-idea',       label: 'Date ideas' },
  { value: 'locals-know',     label: 'Locals-know' },
];

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Alerts' },
];
export const prerender = true;
---

<BaseLayout
  title="Event Alerts · Peninsula Insider"
  description="Tell us what kind of Peninsula events you want to hear about — markets in Red Hill, cellar door release weekends, family Saturdays — and we'll notify you when one matches."
  section="whats-on"
  noindex={true}
  searchExclude={true}
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Event alerts"
    subEyebrow="Tell us when to nudge you"
    title="Don't miss the <em>good</em> ones."
    dek="Pick a category, a town, or one of our editorial lenses. We'll watch the events feed for you and tell you when something matches — by email digest, or as a browser notification when you're on the site."
    gradient="journal"
    visualLabel="Peninsula Insider · alerts"
  />

  <section class="alerts-page">
    <div class="container">
      <p class="cloud-sync-indicator" data-cloud-sync-status="anonymous" hidden>
        <span class="cloud-sync-indicator__dot" aria-hidden="true"></span>
        <span class="cloud-sync-indicator__text"></span>
      </p>

      <div class="alerts-empty" data-alerts-empty>
        <p class="alerts-empty__title">No alerts set up yet.</p>
        <p class="alerts-empty__body">Add your first below. Mix and match — if you want every cellar-door event in Red Hill, set the category to "Cellar door" and the town to "Red Hill". Leave a field blank to mean "any".</p>
      </div>

      <div class="alerts-toolbar" data-alerts-toolbar hidden>
        <p class="alerts-toolbar__count" data-alerts-count></p>
        <button type="button" class="alerts-toolbar__action" data-alerts-permission>Enable browser notifications</button>
      </div>

      <ul class="alerts-list" data-alerts-list></ul>

      <form class="alert-form" data-alert-form aria-label="Add a new alert">
        <p class="alert-form__heading">Add an alert</p>

        <div class="alert-form__grid">
          <label class="alert-form__field">
            <span>Category</span>
            <select name="category">
              <option value="">Any category</option>
              {categoryOptions.map((c) => <option value={c.value}>{c.label}</option>)}
            </select>
          </label>

          <label class="alert-form__field">
            <span>Town</span>
            <select name="place_slug">
              <option value="">Any town</option>
              {placeOptions.map((p) => <option value={p.slug}>{p.name}</option>)}
            </select>
          </label>

          <label class="alert-form__field">
            <span>Lens</span>
            <select name="lens">
              <option value="">Any lens</option>
              {lensOptions.map((l) => <option value={l.value}>{l.label}</option>)}
            </select>
          </label>
        </div>

        <fieldset class="alert-form__delivery">
          <legend>Tell me by</legend>
          <label><input type="checkbox" name="email" checked /> Email digest (weekly Sunday)</label>
          <label><input type="checkbox" name="browser" /> Browser notification (next site visit)</label>
        </fieldset>

        <button type="submit" class="alert-form__submit">Save alert</button>
      </form>
    </div>
  </section>

  <NewsletterBlock />
  <CloudSyncIndicatorScript />
</BaseLayout>

<script is:inline>
  /* /alerts/ controller. Local-storage primary; CloudSync mirrors to
     pi.event_alerts when authenticated.
     Browser Notifications API used opportunistically for in-session
     delivery; the weekly digest is handled by an out-of-repo cron. */
  (function () {
    var KEY = 'pi:alerts:v1';

    function read() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return { version: 1, items: [] };
        var p = JSON.parse(raw);
        return { version: 1, items: Array.isArray(p && p.items) ? p.items : [] };
      } catch (_e) { return { version: 1, items: [] }; }
    }
    function write(s) { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (_e) {} }

    function makeId() {
      return 'a-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6);
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    var listEl = document.querySelector('[data-alerts-list]');
    var emptyEl = document.querySelector('[data-alerts-empty]');
    var toolbarEl = document.querySelector('[data-alerts-toolbar]');
    var countEl = document.querySelector('[data-alerts-count]');
    var permissionBtn = document.querySelector('[data-alerts-permission]');
    var form = document.querySelector('[data-alert-form]');

    function describe(item) {
      var bits = [];
      if (item.category) bits.push('Category: ' + item.category);
      if (item.place_slug) bits.push('Town: ' + item.place_slug.replace(/-/g, ' '));
      if (item.lens) bits.push('Lens: ' + item.lens);
      if (bits.length === 0) bits.push('Any event');
      return bits.join(' · ');
    }

    function deliveryDescribe(item) {
      var ds = [];
      if (item.email) ds.push('email');
      if (item.browser) ds.push('browser');
      return ds.length ? ds.join(' + ') : 'no delivery set';
    }

    function render() {
      var s = read();
      var n = s.items.length;
      if (n === 0) {
        if (listEl) listEl.innerHTML = '';
        if (emptyEl) emptyEl.removeAttribute('hidden');
        if (toolbarEl) toolbarEl.setAttribute('hidden', '');
        return;
      }
      if (emptyEl) emptyEl.setAttribute('hidden', '');
      if (toolbarEl) toolbarEl.removeAttribute('hidden');
      if (countEl) countEl.textContent = n + ' alert' + (n === 1 ? '' : 's') + ' active';
      if (listEl) {
        listEl.innerHTML = s.items.map(function (it) {
          return ''
            + '<li class="alert-item" data-alert-id="' + escapeHtml(it.id) + '">'
            +   '<div class="alert-item__body">'
            +     '<p class="alert-item__criteria">' + escapeHtml(describe(it)) + '</p>'
            +     '<p class="alert-item__delivery">Notify by ' + escapeHtml(deliveryDescribe(it)) + '</p>'
            +   '</div>'
            +   '<button type="button" class="alert-item__remove" data-alert-remove="' + escapeHtml(it.id) + '">Remove</button>'
            + '</li>';
        }).join('');
      }
      bindRemove();
    }

    function persist() {
      var s = read();
      write(s); // round-trip ensures we don't lose the structure
      window.dispatchEvent(new CustomEvent('pi:alerts-changed', { detail: { source: 'local' } }));
    }

    function bindRemove() {
      document.querySelectorAll('[data-alert-remove]').forEach(function (btn) {
        if (btn._piAlertRemoveBound) return;
        btn._piAlertRemoveBound = true;
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-alert-remove');
          var s = read();
          s.items = s.items.filter(function (x) { return x.id !== id; });
          write(s);
          persist();
          render();
        });
      });
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var fd = new FormData(form);
        var item = {
          id: makeId(),
          category: String(fd.get('category') || ''),
          place_slug: String(fd.get('place_slug') || ''),
          lens: String(fd.get('lens') || ''),
          email: !!fd.get('email'),
          browser: !!fd.get('browser'),
          created_at: Date.now(),
        };
        var s = read();
        s.items.push(item);
        write(s);
        persist();
        form.reset();
        // Default email back on after reset
        var emailInput = form.querySelector('input[name="email"]');
        if (emailInput) emailInput.checked = true;
        render();
      });
    }

    if (permissionBtn) {
      permissionBtn.addEventListener('click', function () {
        if (!('Notification' in window)) {
          permissionBtn.textContent = 'Browser notifications not supported here';
          permissionBtn.setAttribute('disabled', '');
          return;
        }
        Notification.requestPermission().then(function (perm) {
          if (perm === 'granted') {
            permissionBtn.textContent = 'Browser notifications enabled';
            permissionBtn.setAttribute('disabled', '');
          } else {
            permissionBtn.textContent = 'Browser notifications declined';
          }
        });
      });
      // Initial state
      if ('Notification' in window) {
        if (Notification.permission === 'granted') {
          permissionBtn.textContent = 'Browser notifications enabled';
          permissionBtn.setAttribute('disabled', '');
        } else if (Notification.permission === 'denied') {
          permissionBtn.textContent = 'Browser notifications blocked (browser setting)';
          permissionBtn.setAttribute('disabled', '');
        }
      }
    }

    render();

    // Re-render after cloud-pull events (CloudSync may have replaced our store).
    window.addEventListener('pi:alerts-changed', function (e) {
      var detail = (e && e.detail) || {};
      if (detail.source === 'cloud-pull') render();
    });
  })();
</script>
