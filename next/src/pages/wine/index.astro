---
/**
 * /wine/ - v5 Wine hub (T-502, page-redesigns-hubs.md section 4 + wireframes #wine).
 *
 * The sole home of wine. Structure: stand-first, experience chips
 * (CHIP_PRESETS.wine), The Six, Winery kitchens reciprocal module (bridge to
 * /eat/), best-of rail, full directory (every wine venue as a server-rendered
 * compact row with data-facets), one Journal module, retained FAQ, Ask band.
 *
 * Protect-list page: <title>, meta description, canonical and FAQ schema are
 * UNCHANGED from v4. No venue pages touched, no redirects added here.
 *
 * Shared hub modules (HubStandfirst, TheSix, DirectoryRows, JournalModule,
 * AskBand) are the EAT agent's, at components/v5/hub/; props here match the
 * shipped module APIs (each module renders its own .container).
 */
import { getCollection } from 'astro:content';
import { informationCheckedOn } from '../../lib/verification-date.mjs';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import FilterBar from '../../components/v5/FilterBar.astro';
import SortControl from '../../components/v5/SortControl.astro';
import HubStandfirst from '../../components/v5/hub/HubStandfirst.astro';
import TheSix from '../../components/v5/hub/TheSix.astro';
import DirectoryRows from '../../components/v5/hub/DirectoryRows.astro';
import JournalModule from '../../components/v5/hub/JournalModule.astro';
import CategoryBrowse from '../../components/v5/hub/CategoryBrowse.astro';
import PlanningHelp from '../../components/v5/hub/PlanningHelp.astro';
import WineVisitChooser from '../../components/v5/hub/WineVisitChooser.astro';
import { routeSlug, isListableVenue } from '../../lib/editorial';
import { getFacets, FACET_OPTIONS } from '../../lib/facets';

export const prerender = true;

// ── Corpus ────────────────────────────────────────────────────────────────
const wineTypes = ['winery', 'producer', 'brewery', 'distillery'];

// visiting.bookingRequired (walk-in/appointment badge), restaurant (kitchens
// module) and editorVerdict (short verdicts) are all declared in the venues
// schema now, so entry.data carries them. The raw-JSON glob that used to work
// around the schema stripping them is gone (2026-07-25).

const score = (v: any) => Number(v.data.authority?.hallidayScore ?? 0);
const hatCount = (v: any) => Number(v.data.authority?.hats ?? 0);

// Editor's order: picks first, then authority, then name. This is the
// server-rendered default the SortControl treats as 'editors'.
const venues = (await getCollection('venues'))
  .filter(isListableVenue)
  .filter((v) => wineTypes.includes(v.data.type))
  .sort(
    (a, b) =>
      Number(b.data.editorPick === true) - Number(a.data.editorPick === true) ||
      score(b) - score(a) ||
      hatCount(b) - hatCount(a) ||
      a.data.name.localeCompare(b.data.name),
  );

const venueImages = new Map(await Promise.all(venues.map(async (venue) => {
  const slug = routeSlug(venue);
  const hero = await resolveHero('venue', slug, venue.data);
  const status = !hero.override ? venue.data.heroImage?.depictionStatus : undefined;
  return [slug, { src: hero.src, alt: hero.alt, caption: status === 'illustrative' ? 'Illustrative image' : status === 'unverified' ? 'Image subject unverified' : undefined }] as const;
})));

// ── Copy helpers (Critic verdicts <= 25 words, from existing frontmatter) ──
const wordCount = (s: string) => s.trim().split(/\s+/).filter(Boolean).length;

const firstSentence = (s?: unknown): string | null => {
  if (typeof s !== 'string' || !s.trim()) return null;
  const m = s.trim().match(/^[^.?]{10,}?[.?]/);
  return m ? m[0].trim() : s.trim();
};

function verdictFor(data: any): string | undefined {
  const candidates = [
    typeof data.whyWeGo === 'string' ? data.whyWeGo.trim() : null,
    typeof data.signature === 'string' ? data.signature.trim() : null,
    firstSentence(data.editorVerdict),
    firstSentence(data.editorNote),
  ].filter((c): c is string => Boolean(c));
  const fit = candidates.find((c) => wordCount(c) <= 25);
  if (fit) return fit;
  const first = candidates[0];
  if (!first) return undefined;
  return data.type === 'winery' ? 'Choose your tasting format, then check current hours and booking arrangements with the producer.' : 'Check the current visitor offering and opening days before planning a stop.';
}

const placeLabel = new Map(FACET_OPTIONS.place.map((o) => [o.value, o.label]));
const areaOf = (data: any): string | null =>
  placeLabel.get(typeof data.place === 'string' ? data.place : data.place?.id) ?? null;

// Walk-in / appointment badge on 100% of winery cards (acceptance 31).
const badgeFor = (data: any): string | null => {
  if (data.type !== 'winery') return null;
  const required = data.visiting?.bookingRequired;
  if (required === true) return 'By appointment';
  if (required === false) return 'Walk-in welcome';
  return 'Check ahead';
};

const hasKitchen = (data: any): boolean =>
  Boolean(data.restaurant && (data.restaurant.name || data.restaurant.description));

const typeLabels: Record<string, string> = {
  winery: 'Cellar door',
  brewery: 'Brewery',
  distillery: 'Distillery',
  producer: 'Producer',
};

const iso = (d: unknown): string | undefined => {
  if (d instanceof Date) return d.toISOString().slice(0, 10);
  if (typeof d === 'string' && d) return d;
  return undefined;
};

// ── Card item builder (SixItem / DirectoryRowItem shape from the hub modules) ──
function venueItem(v: any) {
  const data = v.data;
  const slug = routeSlug(v);
  const meta = [areaOf(data), badgeFor(data) ?? typeLabels[data.type]].filter(Boolean) as string[];
  if (data.type === 'winery' && hasKitchen(data) && meta.length < 3) meta.push('Kitchen on site');
  return {
    title: data.name as string,
    href: `/wine/${slug}/`,
    entityType: 'venue' as const,
    entitySlug: slug,
    image: venueImages.get(slug),
    verdict: verdictFor(data),
    meta,
    priceBand: typeof data.priceBand === 'string' ? data.priceBand : undefined,
    // A sourced factual check is distinct from a legacy review or publication date.
    freshness: iso(informationCheckedOn(data)),
    freshnessKind: 'checked' as const,
    facets: getFacets('venue', data),
    sortTitle: data.name as string,
  };
}

// ── The Six: cellar doors worth planning the month around ─────────────────
const sixSource = [
  ...venues.filter((v) => v.data.type === 'winery' && v.data.editorPick === true),
  ...venues.filter((v) => v.data.type === 'winery' && v.data.editorPick !== true),
].slice(0, 6);
const theSixItems = sixSource.map((v) => venueItem(v));
const sixSlugs = new Set(sixSource.map((v) => routeSlug(v)));

// ── Winery kitchens: reciprocal module, the HUB-01 bridge with /eat/ ──────
// A winery already pinned in The Six is not shown again here: the same card
// twice in two adjacent modules read as repetition, not curation.
const kitchens = venues
  .filter((v) => v.data.type === 'winery' && hasKitchen(v.data) && !sixSlugs.has(routeSlug(v)))
  .sort(
    (a, b) =>
      Number(b.data.restaurant?.hats ?? 0) - Number(a.data.restaurant?.hats ?? 0) ||
      score(b) - score(a),
  )
  .slice(0, 6);
const kitchenItems = kitchens.map((v) => {
  const item = venueItem(v);
  const dining = firstSentence(v.data.restaurant?.description);
  return {
    ...item,
    verdict: dining && wordCount(dining) <= 25 ? dining : item.verdict,
    meta: [areaOf(v.data), 'Tasting + restaurant'].filter(Boolean) as string[],
  };
});

// ── Directory: every wine venue, one row each, server-rendered ────────────
const directoryItems = venues.map((v) => venueItem(v));

// One noun for the page ("producers"), stated with its count once, in the
// directory heading. The kinds are read from the corpus so the heading stays
// true as venues are added ("a distillery" becomes "distilleries").
const typeCount = (type: string) => venues.filter((v) => v.data.type === type).length;
const kindPhrase = (n: number, one: string, many: string) => (n === 1 ? `a ${one}` : many);
const kinds = [
  typeCount('winery') ? 'cellar doors' : null,
  typeCount('brewery') ? kindPhrase(typeCount('brewery'), 'brewery', 'breweries') : null,
  typeCount('distillery') ? kindPhrase(typeCount('distillery'), 'distillery', 'distilleries') : null,
].filter((k): k is string => Boolean(k));
const kindList = kinds.length > 1 ? `${kinds.slice(0, -1).join(', ')} and ${kinds[kinds.length - 1]}` : kinds[0];
const directoryHeading = `All ${venues.length} producers${kindList ? `: ${kindList}` : ''}`;

// ── Best-of rail (canonical guides only; absorbed dupes not linked) ───────
const bestOfRail = [
  {
    title: 'Best cellar doors',
    href: '/wine/best-cellar-doors/',
    entitySlug: 'wine-best-cellar-doors',
    verdict: 'The ranked list, argued honestly. If you only read one wine page, read this one.',
  },
  {
    title: 'Appointment producers',
    href: '/wine/appointment-producers/',
    entitySlug: 'wine-appointment-producers',
    verdict: 'The bookings that repay the effort: smaller pours, longer conversations, back vintages on the bench.',
  },
  {
    title: 'Peninsula pinot noir',
    href: '/wine/pinot-noir/',
    entitySlug: 'wine-pinot-noir',
    verdict: 'Why the ridge grows the country’s most consistent cool-climate pinot, and whose to buy.',
  },
  {
    title: 'The chardonnay case',
    href: '/wine/chardonnay/',
    entitySlug: 'wine-chardonnay',
    verdict: 'Who is making the benchmark bottles right now, and what they cellar like.',
  },
  {
    title: 'Dog-friendly cellar doors',
    href: '/journal/dog-friendly-wineries-mornington-peninsula/',
    entitySlug: 'wine-dog-friendly',
    verdict: 'The rooms that welcome the dog as readily as the driver.',
  },
  {
    title: 'Understanding the region',
    href: '/wine/wine-region/',
    entitySlug: 'wine-wine-region',
    verdict: 'How the region fits together: soils, subregions and the drives between them.',
  },
];

// ── Journal module (ONE, <= 3 cards, down from two sections). Verdicts are
//    page-written (module rule: never pipe long frontmatter deks through). ──
const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published')).sort(
  (a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);
const journalVerdicts: Record<string, string> = {
  'the-chardonnay-case': 'The case for Peninsula chardonnay, argued bottle by bottle.',
  'the-cellar-door-short-list': 'The shortlist behind The Six: how we pick the rooms worth the drive.',
  'how-to-build-a-red-hill-saturday': 'One ridge, one day: a suggested Saturday route around Red Hill.',
};
const journalItems = Object.keys(journalVerdicts)
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .slice(0, 3)
  .map((a) => ({
    title: a.data.title as string,
    href: `/journal/${routeSlug(a)}/`,
    entitySlug: routeSlug(a),
    image: a.data.heroImage?.src
      ? { src: a.data.heroImage.src, alt: a.data.heroImage.alt ?? a.data.title }
      : undefined,
    verdict: journalVerdicts[routeSlug(a)],
    dateISO: iso(a.data.publishedAt),
  }));

// ── Stand-first (<= 80 words, carries cellar-door SEO phrases + the
//    walk-in/appointment orientation line) ─────────────────────────────────
//    The "check with the producer" caveat is stated once, under the
//    directory heading, so the stand-first no longer repeats it. ──────────
const standfirst =
  'Explore Mornington Peninsula wineries from Red Hill and Main Ridge to Merricks and the bay. Choose a tasting, a long lunch or an appointment.';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Wine Country' }];

// One FAQ source for visible answers and structured data.
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What wine is the Mornington Peninsula known for?',
      acceptedAnswer: { '@type': 'Answer', text: 'Pinot Noir and Chardonnay are the benchmark varieties, the cool maritime climate and basalt soils of the Red Hill plateau produce some of Australia\'s most consistent cool-climate examples. The region also has a growing reputation for Pinot Gris and Shiraz. Over 50 cellar doors are open to visitors, concentrated on the ridge between Red Hill and Main Ridge.' } },
    { '@type': 'Question', name: 'Do I need to book cellar door visits on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Booking arrangements differ by winery and tasting. Main Ridge Estate requires a booking. Ten Minutes by Tractor recommends reservations and accepts walk-ins subject to availability; Paringa Estate recommends bookings. Restaurant bookings are separate from cellar-door tastings. Confirm current arrangements directly before travelling.' } },
    { '@type': 'Question', name: 'How many wineries are on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Mornington Peninsula has over 200 vineyards and approximately 50–60 cellar doors open to visitors. Most are concentrated on the Red Hill plateau between Dromana, Red Hill, and Main Ridge. The region is compact, you can visit three cellar doors in an afternoon without rushing if you stay on the ridge.' } },
  ],
};
---

<BaseLayout
  title="Mornington Peninsula Wine & Wineries · Peninsula Insider"
  description="Explore Mornington Peninsula wine country: wineries by area, Pinot Noir and Chardonnay, cellar door visits, and winery dining. Start planning your wine-country trip."
  section="wine"
  canonical="https://peninsulainsider.com.au/wine/"
  ogImage="/images/sourced/article-cellar-door-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <!-- 1. Stand-first: h1 + <= 80-word Editor case, run as the documented
       photo cover (bottom-up harbour scrim, white Sora title) so the hub no
       longer opens on a flat band with an empty right half. The image is
       the section's existing wine hub hero, interim until James confirms or
       replaces it. -->
  <HubStandfirst
    title="Mornington Peninsula wine country"
    standfirst={standfirst}
    image={{ src: '/images/sourced/wine-hub-hero-01.webp', alt: 'Pinot noir grapes ripening on the vine' }}
    imagePosition="50% 45%"
  />

  <!-- One toolbar under the cover: jump links and the chip row. The
       planning help is a note under the full list, where saving starts. -->
  <CategoryBrowse directory="wine-directory" noun="producers" mapHref="/map/?cat=winery">
    <FilterBar surface="wine" noun="producers" label="Filter producers" facets={['place', 'cat', 'price', 'mood', 'party']} />
  </CategoryBrowse>

  <div data-category-editorial>
  <WineVisitChooser />

  <!-- 2. The Six. The eyebrow names the shortlist; the caveat the old sub
       carried now appears once, under the directory heading. -->
  <TheSix
    id="the-six"
    eyebrow="The cellar-door shortlist"
    heading="Cellar doors to build a day around"
    surface="wine"
    items={theSixItems}
  />

  <!-- 4. Winery kitchens: reciprocal module, fixes HUB-01 both directions.
       Every kitchen is also a row in the directory below, so this module
       filters but does not count (countable={false}). -->
  <DirectoryRows
    id="winery-kitchens"
    eyebrow="Winery dining"
    heading="Winery kitchens"
    sub="Pair a tasting with a meal at the same estate. Check the dining room’s current service days and book the meal separately where required."
    surface="wine"
    noun="winery kitchens"
    items={kitchenItems}
    topLink={{ label: 'More winery restaurants in Eat & Drink', href: '/eat/' }}
    countable={false}
  />

  <!-- 5. Best-of rail (canonical guides; cellar-doors + best-wineries
       absorb into best-cellar-doors per the sitemap, handled elsewhere) -->
  <section class="wine-rail pi-section" aria-labelledby="wine-rail-h">
    <div class="container">
      <div class="pi-section-head">
        <div class="pi-section-head__text">
          <p class="pi-eyebrow">The guides</p>
          <h2 id="wine-rail-h" class="pi-h2">Read before you book</h2>
        </div>
      </div>
      {/* The section eyebrow reads "The guides"; the cards drop the
          per-card GUIDE stamp. Text-only rail, so no media fallback. */}
      <CardGrid label="Wine guides" layout="grid" maxCols={3}>
        {bestOfRail.map((guide, i) => (
          <Card
            variant="guide"
            title={guide.title}
            href={guide.href}
            entityType="page"
            entitySlug={guide.entitySlug}
            showEyebrow={false}
            verdict={guide.verdict}
            surface="wine"
            position={i + 1}
          />
        ))}
      </CardGrid>

      <!-- Events: one line + link, not a strip (spec point 17) -->
      <p class="wine-events-line">
        Release weekends and winemaker dinners <span class="nowrap">live in <a class="pi-section-link" href="/whats-on/">What&rsquo;s On<span aria-hidden="true">→</span></a></span>
      </p>
    </div>
  </section>

  </div>

  <!-- 6. Directory: every wine venue as a server-rendered compact row with
       data-facets. Breweries and distilleries are type facets in the sheet,
       not separate one-card grids (HUB-13). Sort sits under the heading of
       the list it reorders. -->
  <DirectoryRows
    id="wine-directory"
    eyebrow="The full list"
    heading={directoryHeading}
    sub="Hours and bookings change; check with the producer before you go."
    surface="wine"
    noun="producers"
    items={directoryItems}
    emptyHeading="Nothing matches those filters"
    emptyBody="Clear one and the ridge reopens."
  >
    <div slot="before-list" class="wine-list-tools">
      <SortControl />
    </div>
    <div slot="after-list" class="wine-list-help">
      <PlanningHelp />
    </div>
  </DirectoryRows>

  <!-- 7. From the Journal: ONE module, <= 3 cards (down from two sections) -->
  <JournalModule
    heading="The wine arguments worth reading"
    moreHref="/journal/"
    moreLabel="All in the Journal"
    surface="wine"
    items={journalItems}
  />

  <!-- 8. FAQ: retained in-DOM, copy unchanged (protect-list) -->
  <section class="hub-faq pi-section" aria-labelledby="wine-faq-heading">
    <div class="container">
      <div class="pi-section-head">
        <div class="pi-section-head__text">
          <p class="pi-eyebrow">Frequently asked</p>
          <h2 class="pi-h2" id="wine-faq-heading">Three honest answers before you book</h2>
        </div>
      </div>
      <div class="hub-faq__list">
        {faqSchema.mainEntity.map((item) => (
          <details class="hub-faq__item">
            <summary class="hub-faq__q">{item.name}</summary>
            <div class="hub-faq__a"><p>{item.acceptedAnswer.text}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Ask band hidden (bug fix in progress) -->
</BaseLayout>

<style>
  /* Events one-liner, closing the guides band. The link is the shared
     .pi-section-link, so "What's On", "All in the Journal" and the kitchens
     link read as one harbour text-link style. */
  /* A plain sentence: the link runs inline, and "live in What's On →"
     travels as one unit, so the link never lands alone on a line. Inline
     padding keeps its 44px hit area without opening the line box. */
  .wine-events-line {
    display: block;
    margin: var(--space-6, 2rem) 0 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300, 0.9375rem);
    line-height: var(--lh-body, 1.65);
    color: var(--soft);
    text-wrap: pretty;
  }
  .wine-events-line .nowrap {
    white-space: nowrap;
  }
  .wine-events-line .pi-section-link {
    display: inline;
    padding-block: 0.75rem;
  }
  /* Only the label is underlined; the arrow sits clean beside it. */
  .wine-events-line .pi-section-link > [aria-hidden] {
    display: inline-block;
    margin-left: 0.3em;
    text-decoration: none;
  }
  .wine-events-line a:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  /* The planning note closes the full list. */
  .wine-list-help {
    margin-top: var(--space-3, 0.75rem);
  }
  /* Sort acts on the list, so it sits under the list heading it reorders. */
  .wine-list-tools {
    display: flex;
    justify-content: flex-start;
    margin-bottom: var(--space-4, 1rem);
  }
</style>
