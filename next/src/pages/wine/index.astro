---
/**
 * /wine/ - v5 Wine hub (T-502, page-redesigns-hubs.md section 4 + wireframes #wine).
 *
 * The sole home of wine. Structure: stand-first, experience chips
 * (CHIP_PRESETS.wine), The Six, Winery kitchens reciprocal module (bridge to
 * /eat/), best-of rail, full directory (every wine venue as a server-rendered
 * compact row with data-facets), one Journal module, retained FAQ, Ask band.
 *
 * Protect-list page: <title>, meta description, canonical and FAQ schema are
 * UNCHANGED from v4. No venue pages touched, no redirects added here.
 *
 * Shared hub modules (HubStandfirst, TheSix, DirectoryRows, JournalModule,
 * AskBand) are the EAT agent's, at components/v5/hub/; props here match the
 * shipped module APIs (each module renders its own .container).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import FilterBar from '../../components/v5/FilterBar.astro';
import SortControl from '../../components/v5/SortControl.astro';
import MapToggle from '../../components/v5/MapToggle.astro';
import HubStandfirst from '../../components/v5/hub/HubStandfirst.astro';
import TheSix from '../../components/v5/hub/TheSix.astro';
import DirectoryRows from '../../components/v5/hub/DirectoryRows.astro';
import JournalModule from '../../components/v5/hub/JournalModule.astro';
import AskBand from '../../components/v5/hub/AskBand.astro';
import { routeSlug } from '../../lib/editorial';
import { getFacets, FACET_OPTIONS } from '../../lib/facets';

export const prerender = true;

// ── Corpus ────────────────────────────────────────────────────────────────
const wineTypes = ['winery', 'producer', 'brewery', 'distillery'];

// The venues Zod schema strips fields the wine hub needs (visiting.bookingRequired
// for the walk-in/appointment badge, restaurant for the kitchens module,
// editorVerdict for short verdicts). Read the raw JSON alongside the collection
// so those fields survive; schema-validated data still wins where both exist.
const rawVenueModules = import.meta.glob('../../content/venues/*.json', { eager: true });
const rawVenueBySlug = new Map<string, any>();
for (const mod of Object.values(rawVenueModules)) {
  const raw = (mod as any).default ?? mod;
  if (raw && typeof raw.slug === 'string') rawVenueBySlug.set(raw.slug, raw);
}

const score = (v: any) => Number(v.data.authority?.hallidayScore ?? 0);
const hatCount = (v: any) => Number(v.data.authority?.hats ?? 0);

// Editor's order: picks first, then authority, then name. This is the
// server-rendered default the SortControl treats as 'editors'.
const venues = (await getCollection('venues'))
  .filter((v) => wineTypes.includes(v.data.type))
  .sort(
    (a, b) =>
      Number(b.data.editorPick === true) - Number(a.data.editorPick === true) ||
      score(b) - score(a) ||
      hatCount(b) - hatCount(a) ||
      a.data.name.localeCompare(b.data.name),
  );

// ── Copy helpers (Critic verdicts <= 25 words, from existing frontmatter) ──
const wordCount = (s: string) => s.trim().split(/\s+/).filter(Boolean).length;

const firstSentence = (s?: unknown): string | null => {
  if (typeof s !== 'string' || !s.trim()) return null;
  const m = s.trim().match(/^[^.?]{10,}?[.?]/);
  return m ? m[0].trim() : s.trim();
};

function verdictFor(data: any): string | undefined {
  const candidates = [
    typeof data.whyWeGo === 'string' ? data.whyWeGo.trim() : null,
    typeof data.signature === 'string' ? data.signature.trim() : null,
    firstSentence(data.editorVerdict),
    firstSentence(data.editorNote),
  ].filter((c): c is string => Boolean(c));
  const fit = candidates.find((c) => wordCount(c) <= 25);
  if (fit) return fit;
  const first = candidates[0];
  if (!first) return undefined;
  return `${first.split(/\s+/).slice(0, 24).join(' ').replace(/[,;:]+$/, '')}.`;
}

const placeLabel = new Map(FACET_OPTIONS.place.map((o) => [o.value, o.label]));
const areaOf = (data: any): string | null =>
  typeof data.place === 'string' ? (placeLabel.get(data.place) ?? null) : null;

// Walk-in / appointment badge on 100% of winery cards (acceptance 31).
const badgeFor = (data: any): string | null => {
  if (data.type !== 'winery') return null;
  const required = data.visiting?.bookingRequired;
  if (required === true) return 'By appointment';
  if (required === false) return 'Walk-in welcome';
  return 'Check ahead';
};

const hasKitchen = (data: any): boolean =>
  Boolean(data.restaurant && (data.restaurant.name || data.restaurant.description));

const typeLabels: Record<string, string> = {
  winery: 'Cellar door',
  brewery: 'Brewery',
  distillery: 'Distillery',
  producer: 'Producer',
};

const iso = (d: unknown): string | undefined => {
  if (d instanceof Date) return d.toISOString().slice(0, 10);
  if (typeof d === 'string' && d) return d;
  return undefined;
};

/** Schema data merged over the raw JSON, so stripped fields are readable. */
function fullData(v: any): any {
  const raw = rawVenueBySlug.get(routeSlug(v)) ?? {};
  return { ...raw, ...v.data };
}

// ── Card item builder (SixItem / DirectoryRowItem shape from the hub modules) ──
function venueItem(v: any) {
  const data = fullData(v);
  const slug = routeSlug(v);
  const meta = [areaOf(data), badgeFor(data) ?? typeLabels[data.type]].filter(Boolean) as string[];
  if (data.type === 'winery' && hasKitchen(data) && meta.length < 3) meta.push('Kitchen on site');
  return {
    title: data.name as string,
    href: `/wine/${slug}/`,
    entityType: 'venue' as const,
    entitySlug: slug,
    image: data.heroImage?.src ? { src: data.heroImage.src, alt: data.heroImage.alt ?? data.name } : undefined,
    verdict: verdictFor(data),
    meta,
    priceBand: typeof data.priceBand === 'string' ? data.priceBand : undefined,
    freshness: iso(data.lastVerified ?? data.lastFactVerified ?? data.publishedAt),
    facets: getFacets('venue', data),
    sortTitle: data.name as string,
  };
}

// ── The Six: cellar doors worth planning the month around ─────────────────
const sixSource = [
  ...venues.filter((v) => v.data.type === 'winery' && v.data.editorPick === true),
  ...venues.filter((v) => v.data.type === 'winery' && v.data.editorPick !== true),
].slice(0, 6);
const theSixItems = sixSource.map((v) => venueItem(v));

// ── Winery kitchens: reciprocal module, the HUB-01 bridge with /eat/ ──────
const kitchens = venues
  .filter((v) => v.data.type === 'winery' && hasKitchen(fullData(v)))
  .sort(
    (a, b) =>
      Number(fullData(b).restaurant?.hats ?? 0) - Number(fullData(a).restaurant?.hats ?? 0) ||
      score(b) - score(a),
  )
  .slice(0, 6);
const kitchenItems = kitchens.map((v) => {
  const item = venueItem(v);
  const dining = firstSentence(fullData(v).restaurant?.description);
  return {
    ...item,
    verdict: dining && wordCount(dining) <= 25 ? dining : item.verdict,
    meta: [areaOf(v.data), 'Tasting + restaurant'].filter(Boolean) as string[],
  };
});

// ── Directory: every wine venue, one row each, server-rendered ────────────
const directoryItems = venues.map((v) => venueItem(v));

// ── Best-of rail (canonical guides only; absorbed dupes not linked) ───────
const bestOfRail = [
  {
    title: 'Best cellar doors',
    href: '/wine/best-cellar-doors/',
    entitySlug: 'wine-best-cellar-doors',
    verdict: 'The ranked list, argued honestly. If you only read one wine page, read this one.',
  },
  {
    title: 'Appointment producers',
    href: '/wine/appointment-producers/',
    entitySlug: 'wine-appointment-producers',
    verdict: 'The bookings that repay the effort: smaller pours, longer conversations, back vintages on the bench.',
  },
  {
    title: 'Peninsula pinot noir',
    href: '/wine/pinot-noir/',
    entitySlug: 'wine-pinot-noir',
    verdict: 'Why the ridge grows the country’s most consistent cool-climate pinot, and whose to buy.',
  },
  {
    title: 'The chardonnay case',
    href: '/wine/chardonnay/',
    entitySlug: 'wine-chardonnay',
    verdict: 'Who is making the benchmark bottles right now, and what they cellar like.',
  },
  {
    title: 'Dog-friendly cellar doors',
    href: '/wine/dog-friendly/',
    entitySlug: 'wine-dog-friendly',
    verdict: 'The rooms that welcome the dog as readily as the driver.',
  },
  {
    title: 'Understanding the region',
    href: '/wine/wine-region/',
    entitySlug: 'wine-wine-region',
    verdict: 'How the region fits together: soils, subregions and the drives between them.',
  },
];

// ── Journal module (ONE, <= 3 cards, down from two sections). Verdicts are
//    page-written (module rule: never pipe long frontmatter deks through). ──
const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published')).sort(
  (a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);
const journalVerdicts: Record<string, string> = {
  'the-chardonnay-case': 'The case for Peninsula chardonnay, argued bottle by bottle.',
  'the-cellar-door-short-list': 'The shortlist behind The Six: how we pick the rooms worth the drive.',
  'how-to-build-a-red-hill-saturday': 'One ridge, one day: the Saturday route we actually drive.',
};
const journalItems = Object.keys(journalVerdicts)
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .slice(0, 3)
  .map((a) => ({
    title: a.data.title as string,
    href: `/journal/${routeSlug(a)}/`,
    entitySlug: routeSlug(a),
    image: a.data.heroImage?.src
      ? { src: a.data.heroImage.src, alt: a.data.heroImage.alt ?? a.data.title }
      : undefined,
    verdict: journalVerdicts[routeSlug(a)],
    dateISO: iso(a.data.publishedAt),
  }));

// ── Stand-first (<= 80 words, carries cellar-door SEO phrases + the
//    walk-in/appointment orientation line) ─────────────────────────────────
const standfirst =
  'Pinot noir and chardonnay built on basalt, and more than forty cellar doors within twenty minutes of each other on the Red Hill ridge. This is every winery, brewery and distillery we rate, with the six worth planning a day around this month. One thing decides the shape of the day before you leave home: walk-in cellar doors take you as you come, appointment producers reward the booking. Check each row before you drive.';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Wine Country' }];

// FAQ schema: UNCHANGED from v4 (protect-list, acceptance 27).
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What wine is the Mornington Peninsula known for?',
      acceptedAnswer: { '@type': 'Answer', text: 'Pinot Noir and Chardonnay are the benchmark varieties, the cool maritime climate and basalt soils of the Red Hill plateau produce some of Australia\'s most consistent cool-climate examples. The region also has a growing reputation for Pinot Gris and Shiraz. Over 50 cellar doors are open to visitors, concentrated on the ridge between Red Hill and Main Ridge.' } },
    { '@type': 'Question', name: 'Do I need to book cellar door visits on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Some cellar doors operate by appointment only (Ten Minutes by Tractor, Main Ridge Estate, Paringa Estate). Others welcome walk-ins (Montalto, Polperro, Red Hill Estate). Check before you drive, appointment-only cellar doors are common on the plateau and the experience is better when expected. Weekend afternoons are busiest.' } },
    { '@type': 'Question', name: 'How many wineries are on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Mornington Peninsula has over 200 vineyards and approximately 50–60 cellar doors open to visitors. Most are concentrated on the Red Hill plateau between Dromana, Red Hill, and Main Ridge. The region is compact, you can visit three cellar doors in an afternoon without rushing if you stay on the ridge.' } },
  ],
};
---

<BaseLayout
  title="Best Cellar Doors on the Mornington Peninsula 2026 Guide"
  description="The cellar doors worth the appointment, the Pinot worth the cellar, and the producers you should know in 2026. The Peninsula's honest wine guide."
  section="wine"
  canonical="https://peninsulainsider.com.au/wine"
  modifiedTime="2026-05-17"
  ogImage="/images/sourced/article-cellar-door-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <!-- 1. Stand-first: h1 + <= 80-word Editor case (replaces hero dek,
       EditorialSurface, CompareBlock and the 232-word essay) -->
  <HubStandfirst title="The Peninsula's best bottles start on the ridge" standfirst={standfirst} />

  <div class="wine-controls container">
    <!-- 2. Experience chips: CHIP_PRESETS.wine. ONE FilterBar; one filter
         state governs The Six, the kitchens rows and the directory. -->
    <FilterBar surface="wine" noun="cellar doors" sticky={true}>
      <SortControl />
      <MapToggle />
    </FilterBar>

    <!-- Walk-in vs appointment: depth kept behind one interaction (P7).
         Carries the CompareBlock's SEO-load-bearing names and phrases. -->
    <details class="wine-orientation">
      <summary>Walk-in or appointment? How to shape the day</summary>
      <div class="wine-orientation__body">
        <p>
          Walk-in rooms (Montalto, Polperro, Pt. Leo Estate, Red Hill Estate, Foxeys Hangout,
          Paringa Estate) suit a first visit: taste at the bar, then a long lunch in the dining
          room. Cellar doors take you as you come; the restaurants book 2 to 6 weeks ahead for
          weekends.
        </p>
        <p>
          Appointment producers (Ten Minutes by Tractor, Main Ridge Estate, Dexter Wines, Quealy
          Winemakers, Eldridge Estate, Garagiste) pour smaller, talk longer and often open the
          back vintages. Book 1 to 3 weeks ahead. The right call when the wine is genuinely the
          point of the trip.
        </p>
      </div>
    </details>
  </div>

  <!-- 3. The Six -->
  <TheSix
    id="the-six"
    heading="Where to actually go this month"
    sub="Six cellar doors, Critic verdicts, checked dates. Save them or add them to a trip."
    surface="wine"
    items={theSixItems}
  />

  <!-- 4. Winery kitchens: reciprocal module, fixes HUB-01 both directions.
       /eat/ carries the mirror module pointing here. -->
  <DirectoryRows
    id="winery-kitchens"
    heading="Winery kitchens"
    sub="Six wineries whose dining rooms justify the booking on their own. The wineries live here; restaurants proper live in Eat & Drink."
    surface="wine"
    noun="winery kitchens"
    items={kitchenItems}
    topLink={{ label: 'Restaurants, in Eat & Drink', href: '/eat/' }}
  />

  <div class="wine-mid container">
    <!-- 5. Best-of rail (canonical guides; cellar-doors + best-wineries
         absorb into best-cellar-doors per the sitemap, handled elsewhere) -->
    <section class="wine-rail" aria-labelledby="wine-rail-h">
      <p class="wine-rail__eyebrow">The guides</p>
      <h2 id="wine-rail-h" class="wine-rail__heading">Read before you book</h2>
      <CardGrid label="Wine guides" layout="grid" maxCols={3}>
        {bestOfRail.map((guide, i) => (
          <Card
            variant="guide"
            title={guide.title}
            href={guide.href}
            entityType="page"
            entitySlug={guide.entitySlug}
            verdict={guide.verdict}
            surface="wine"
            position={i + 1}
          />
        ))}
      </CardGrid>
    </section>

    <!-- Events: one line + link, not a strip (spec point 17) -->
    <p class="wine-events-line">
      Release weekends and winemaker dinners live in <a href="/whats-on/">What&rsquo;s On</a>.
    </p>
  </div>

  <!-- 6. Directory: every wine venue as a server-rendered compact row with
       data-facets. Breweries and distilleries are type facets in the sheet,
       not separate one-card grids (HUB-13). -->
  <DirectoryRows
    id="wine-directory"
    heading={`All ${venues.length} cellar doors, breweries and distilleries`}
    sub="Every producer we track, one URL each. Narrow with the chips above; sort by name or town."
    surface="wine"
    noun="cellar doors"
    items={directoryItems}
    emptyHeading="Nothing matches those filters"
    emptyBody="Clear one and the ridge reopens."
  />

  <!-- 7. From the Journal: ONE module, <= 3 cards (down from two sections) -->
  <JournalModule
    heading="The wine arguments worth reading"
    moreHref="/journal/"
    moreLabel="All in the Journal"
    surface="wine"
    items={journalItems}
  />

  <!-- 8. FAQ: retained in-DOM, copy unchanged (protect-list) -->
  <section class="hub-faq" aria-label="Frequently asked questions">
    <div class="container">
      <div class="hub-faq__intro">
        <p class="label label--accent">Frequently asked</p>
        <h2 class="hub-faq__title">Three honest answers before you book</h2>
      </div>
      <div class="hub-faq__list">
        <details class="hub-faq__item">
          <summary class="hub-faq__q">What wine is the Peninsula known for?</summary>
          <div class="hub-faq__a"><p>Pinot Noir and Chardonnay are the benchmark varieties, the cool maritime climate and basalt soils of the Red Hill plateau produce some of Australia's most consistent cool-climate examples. The region also has a growing reputation for Pinot Gris and Shiraz. Over 50 cellar doors are open to visitors, concentrated on the ridge between Red Hill and Main Ridge.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Do I need to book cellar door visits?</summary>
          <div class="hub-faq__a"><p>Some cellar doors operate by appointment only (Ten Minutes by Tractor, Main Ridge Estate, Paringa Estate). Others welcome walk-ins (Montalto, Polperro, Red Hill Estate). Check before you drive, appointment-only cellar doors are common on the plateau and the experience is better when expected. Weekend afternoons are busiest.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">How many wineries are on the Peninsula?</summary>
          <div class="hub-faq__a"><p>Over 200 vineyards and approximately 50–60 cellar doors open to visitors. Most are concentrated on the Red Hill plateau between Dromana, Red Hill, and Main Ridge. The region is compact, you can visit three cellar doors in an afternoon without rushing if you stay on the ridge.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- 9. Ask band (the page's one Ask placement; Dispatch lives in the
       footer only, per exactly-one-instance acceptance) -->
  <AskBand
    surface="wine"
    heading="Still deciding? Ask PI"
    body="Tell PI the day you want and it answers from our cellar-door reviews."
    prompts={[
      'Walk-in cellar doors near Red Hill',
      'A winery lunch for six',
      'Small tastings with the winemaker',
    ]}
  />
</BaseLayout>

<style>
  .wine-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    padding-top: var(--space-3, 0.75rem);
  }

  .wine-mid {
    display: flex;
    flex-direction: column;
    gap: var(--space-5, 1.5rem);
    padding: var(--space-6, 2rem) 0;
  }

  /* One-interaction walk-in/appointment disclosure (P7) */
  .wine-orientation {
    border: 1px solid var(--border);
    border-radius: var(--radius-m, 10px);
    background: var(--bg-alt);
    max-width: var(--measure-prose, 68ch);
  }
  .wine-orientation summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    font-family: var(--font-ui, 'Outfit', system-ui, sans-serif);
    font-weight: var(--fw-semibold, 600);
    font-size: var(--fs-300, 0.9375rem);
    color: var(--text);
  }
  .wine-orientation summary:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wine-orientation__body {
    padding: 0 1rem 1rem;
  }
  .wine-orientation__body p {
    margin: 0 0 0.75rem;
    font-size: var(--fs-300, 0.9375rem);
    line-height: var(--lh-body, 1.6);
    color: var(--text);
    max-width: var(--measure-prose, 68ch);
  }
  .wine-orientation__body p:last-child {
    margin-bottom: 0;
  }

  /* Best-of rail */
  .wine-rail__eyebrow {
    margin: 0 0 0.25rem;
    font-family: var(--font-ui, 'Outfit', system-ui, sans-serif);
    font-size: var(--fs-100, 0.75rem);
    font-weight: var(--fw-semibold, 600);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .wine-rail__heading {
    margin: 0 0 var(--space-5, 1.5rem);
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: var(--fs-700, clamp(1.75rem, 1.5rem + 1.2vw, 2.25rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.2);
    color: var(--text);
  }

  /* Events one-liner */
  .wine-events-line {
    margin: 0;
    font-family: var(--font-ui, 'Outfit', system-ui, sans-serif);
    font-size: var(--fs-300, 0.9375rem);
    color: var(--soft);
  }
  .wine-events-line a {
    color: var(--accent);
    text-underline-offset: 2px;
  }
  .wine-events-line a:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
</style>
