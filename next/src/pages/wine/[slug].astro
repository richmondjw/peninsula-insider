---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueDetailTemplate from '../../components/VenueDetailTemplate.astro';
import EventStrip from '../../components/EventStrip.astro';
import { routeSlug, typeLabel, titleize, isUpcoming } from '../../lib/editorial';
import {
  buildWinerySchema,
  buildRestaurantSchema,
  buildAccommodationSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';
import { fetchAllVenuesFromSanity, fetchVenueFromSanity } from '../../lib/sanity/venue-adapter';
import { fetchAllItinerariesFromSanity } from '../../lib/sanity/itinerary-adapter';
import { fetchAllEventsFromSanity } from '../../lib/sanity/event-adapter';

export async function getStaticPaths() {
  const wineTypes = ['winery', 'producer', 'brewery', 'distillery'];
  const [allVenuesSanity, allItineraries, allEvents] = await Promise.all([
    fetchAllVenuesFromSanity(),
    fetchAllItinerariesFromSanity(),
    fetchAllEventsFromSanity(),
  ]);
  const wineVenues = allVenuesSanity.filter((v) => wineTypes.includes(v.data.type));
  return wineVenues.map((venue) => {
    const related = wineVenues.filter((v) => v.slug !== venue.slug).slice(0, 3);
    return {
      params: { slug: venue.slug },
      props: { venue, related, allItineraries, allEvents },
    };
  });
}

const wineTypes = ['winery', 'producer', 'brewery', 'distillery'];
let { venue, related, allItineraries, allEvents } = Astro.props as any;
const slug = venue.slug;

// Preview mode: refetch from drafts perspective when inside Studio's iframe.
const previewMode = (Astro.locals as Record<string, unknown>).sanityPreview === true;
if (previewMode) {
  const previewVenue = await fetchVenueFromSanity(slug, {preview: true});
  if (previewVenue) venue = previewVenue;
}

// Cross-link articles that reference this venue
const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .filter((article) =>
    article.data.relatedVenues.some((entry) => String(entry.id ?? entry) === slug)
  )
  .slice(0, 3);

// Cross-link itineraries that include this venue as a stop — from getStaticPaths props
const itineraries = allItineraries
  .filter((itinerary: any) =>
    itinerary.data.stops.some((stop: any) => String(stop.venue?.id ?? stop.venue ?? '') === slug)
  )
  .slice(0, 2);

// Events at this venue — from getStaticPaths props, gated on a clean venue ref.
const venueEvents = allEvents
  .filter((event: any) => String(event.data.venue?.id ?? event.data.venue ?? '') === slug)
  .filter((event: any) => {
    if (['weekly', 'monthly', 'ongoing'].includes(event.data.recurrence)) return true;
    return isUpcoming(event.data.endDate ?? event.data.startDate);
  })
  .sort((a: any, b: any) => (b.data.visitorAppealScore ?? 0) - (a.data.visitorAppealScore ?? 0))
  .slice(0, 3);

const venuePlaceName = titleize(String(venue.data.place?.id ?? venue.data.place ?? ''));
const venueTypeLabel = typeLabel[venue.data.type] ?? titleize(venue.data.type);
const sigDesc = (venue.data.signature ?? '').trim();
const editorLead = (venue.data.editorNote ?? '').split(/\n\s*\n/)[0].replace(/\s+/g, ' ').trim();
const description = sigDesc.length >= 90 ? sigDesc : (editorLead || sigDesc).slice(0, 158);
const canonical = `https://peninsulainsider.com.au/wine/${slug}/`;
const ogImage = venue.data.heroImage?.src && !venue.data.heroImage.src.includes('placeholder')
  ? venue.data.heroImage.src
  : '/images/sourced/home-cover.webp';

const isVerified = Boolean(venue.data.lastFactVerified);

const schemas: any[] = [
  buildWinerySchema(venue.data, slug),
];
if (venue.data.restaurant) schemas.push(buildRestaurantSchema(venue.data, slug));
if (venue.data.accommodation) schemas.push(buildAccommodationSchema(venue.data, slug));
if (venue.data.faq?.length) schemas.push(buildFaqSchema(venue.data.faq));
schemas.push(
  buildBreadcrumbSchema([
    { name: 'Home', url: 'https://peninsulainsider.com.au' },
    { name: 'Wine Country', url: 'https://peninsulainsider.com.au/wine' },
    { name: venue.data.name },
  ])
);
export const prerender = true;
---

<BaseLayout
  title={`${venue.data.name}, ${venuePlaceName} · Peninsula Insider`}
  description={description}
  section="wine"
  canonical={canonical}
  ogImage={ogImage}
  noindex={venue.data.sitemapExclude === true || venue.data.status === 'closed'}
>
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <VenueDetailTemplate venue={venue} section="wine" related={related} articles={articles} itineraries={itineraries} />

  <EventStrip
    events={venueEvents}
    eyebrow="On the calendar here"
    heading={`${venue.data.name} is also a real event venue`}
    intro={`Upcoming events at ${venue.data.name}, with editorial notes when we have them.`}
    moreHref="/whats-on/"
    moreLabel="All events"
    variant="alt"
  />
</BaseLayout>
