---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SubpageHero from '../../../components/SubpageHero.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import BfAnalytics from '../../../components/BfAnalytics.astro';
import { buildCharterOperatorSchema } from '../../../lib/schema';
import { buildBfUtm, formatVerifiedStamp } from '../../../lib/bf';

export async function getStaticPaths() {
  const charters = await getCollection('fishingCharters', ({ data }) => data.status === 'published');
  return charters.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const lastVerifiedStamp = formatVerifiedStamp(data.lastVerified);
const charterSchema = buildCharterOperatorSchema(data);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Fishing', href: '/fishing/' },
  { label: 'Charters', href: '/fishing/charters/' },
  { label: data.name },
];

// Resolve the species this operator targets so we can render the species
// rail with the operator's price band alongside.
const allSpecies = await getCollection('species', ({ data: d }) => d.status === 'published');
const targetedSpecies = allSpecies.filter((s) => data.targetSpecies.includes(s.data.slug));

// Resolve the comparable charters (other published charters that share at
// least one target species) for the bottom-of-page comparison rail.
const allCharters = await getCollection('fishingCharters', ({ data: d }) => d.status === 'published');
const otherCharters = allCharters
  .filter((c) => c.data.slug !== data.slug)
  .filter((c) => c.data.targetSpecies.some((s: string) => data.targetSpecies.includes(s)))
  .slice(0, 4);

// Booking URL with PI UTM scheme. Affiliate link preferred; falls back to the
// operator website. Charter pages without either render no CTA.
const bookingDestination = data.affiliateUrl ?? data.operatorWebsite;
const primaryBookingUrl = bookingDestination
  ? buildBfUtm({
      destination: bookingDestination,
      campaign: `${data.slug}-charter`,
      medium: 'charter-page',
      content: 'hero-primary',
    })
  : null;

const licenceLabel: Record<string, string> = {
  covered: 'Licence covered for the day',
  byo: 'BYO licence required',
  unconfirmed: 'Confirm at booking',
};
---

<BaseLayout
  title={`${data.name} · Peninsula Insider`}
  description={data.metaDescription}
  section="fishing"
  canonical={`https://peninsulainsider.com.au/fishing/charters/${data.slug}/`}
  modifiedTime={data.lastVerified.toISOString().split('T')[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(charterSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow="Fishing · Charters"
    title={data.name}
    dek={data.intro}
  />

  <article class="venue-detail" data-bf-article>
    <div class="container">
      <div class="prose">
        <p class="prose__verified">
          Last fact-verified {lastVerifiedStamp}
          {data.operatorWebsite ? <> · <a href={data.operatorWebsite} rel="external">Operator website</a></> : null}
        </p>

        {primaryBookingUrl ? (
          <p>
            <a
              href={primaryBookingUrl}
              class="venue-card__cta"
              rel="external sponsored"
              data-bf-event="bf_charter_click"
              data-bf-operator={data.slug}
              data-bf-position="hero"
            >Book {data.name} &rarr;</a>
          </p>
        ) : null}

        <h2>Key facts</h2>
        <table>
          <tbody>
            {/* Price row intentionally omitted. BRAND-PI rule (2026-05-15):
                "No pricing on site. Ever." Book direct with the operator. */}
            {data.vesselType ? <tr><td>Vessel</td><td>{data.vesselName ? `${data.vesselName} — ` : ''}{data.vesselType}</td></tr> : null}
            {data.capacityMax ? <tr><td>Capacity</td><td>{data.capacityMin ? `${data.capacityMin} to ` : 'Up to '}{data.capacityMax} passengers</td></tr> : null}
            {data.departurePoints.length > 0 ? (
              <tr>
                <td>Departure points</td>
                <td>{data.departurePoints.map((dp, idx) => (
                  <>
                    {dp.includes('-boat-ramp') ? (
                      <a href={`/boating/ramps/${dp}/`}>{dp.replace(/-/g, ' ').replace(' boat ramp', '')}</a>
                    ) : dp}
                    {idx < data.departurePoints.length - 1 ? ', ' : null}
                  </>
                ))}</td>
              </tr>
            ) : null}
            {data.targetSpecies.length > 0 ? (
              <tr>
                <td>Target species</td>
                <td>{data.targetSpecies.map((s, idx) => (
                  <>
                    <a href={`/fishing/species/${s}/`}>{s.replace(/-/g, ' ')}</a>
                    {idx < data.targetSpecies.length - 1 ? ', ' : null}
                  </>
                ))}</td>
              </tr>
            ) : null}
            <tr><td>Fishing licence</td><td><strong>{licenceLabel[data.licenceCovered]}</strong></td></tr>
            {data.seasonalityNote ? <tr><td>Operating season</td><td>{data.seasonalityNote}</td></tr> : null}
          </tbody>
        </table>

        <h2>Who this suits</h2>
        <p>{data.whoSuits}</p>

        <h2>Who it doesn't suit</h2>
        <p>{data.whoDoesnt}</p>

        <Content />

        {targetedSpecies.length > 0 ? (
          <>
            <h2>Species this charter targets</h2>
            <ul>
              {targetedSpecies.map((s) => (
                <li>
                  <a href={`/fishing/species/${s.data.slug}/`}>{s.data.commonName}</a>
                  {' · '}{s.data.peakSeason}
                </li>
              ))}
            </ul>
          </>
        ) : null}

        {data.faq.length > 0 ? (
          <>
            <h2>Frequently asked questions</h2>
            {data.faq.map((f) => (
              <>
                <h3>{f.question}</h3>
                <p>{f.answer}</p>
              </>
            ))}
          </>
        ) : null}

        {primaryBookingUrl ? (
          <p>
            <a
              href={primaryBookingUrl}
              class="venue-card__cta"
              rel="external sponsored"
              data-bf-event="bf_charter_click"
              data-bf-operator={data.slug}
              data-bf-position="footer"
            >Book {data.name} &rarr;</a>
          </p>
        ) : null}

        {otherCharters.length > 0 ? (
          <>
            <h2>Compare other Peninsula charters</h2>
            <ul>
              {otherCharters.map((c) => (
                <li>
                  <a
                    href={`/fishing/charters/${c.data.slug}/`}
                    data-bf-event="bf_comparison_click"
                    data-bf-from={data.slug}
                    data-bf-to={c.data.slug}
                  >{c.data.name}</a>
                  {c.data.licenceCovered === 'covered' ? ' · Licence covered' : c.data.licenceCovered === 'byo' ? ' · BYO licence' : ''}
                </li>
              ))}
            </ul>
            <p>
              Browse all <a href="/fishing/charters/">Peninsula fishing charters</a>, or
              the <a href="/tour/fishing-tours/" data-bf-event="bf_cross_vertical_click" data-bf-target="tour-fishing-tours">fishing tours hub</a>
              for charter-as-curated-experience options.
            </p>
          </>
        ) : null}
      </div>
    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>
