---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHero from '../../../components/SectionHero.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import BfAnalytics from '../../../components/BfAnalytics.astro';
import { buildBfHubSchema, buildBreadcrumbSchema } from '../../../lib/schema';
import { formatVerifiedStamp, BF_CHARTERS_P5 } from '../../../lib/bf';

const lastVerifiedISO = '2026-04-30';
const lastVerifiedStamp = formatVerifiedStamp(lastVerifiedISO);

const allCharters = await getCollection('fishingCharters', ({ data }) => data.status === 'published');

// Anchor + Featured tier first; everyone else after.
const orderIdx = (slug: string) => {
  const i = (BF_CHARTERS_P5 as readonly string[]).indexOf(slug);
  return i === -1 ? 999 : i;
};
const ordered = [...allCharters].sort((a, b) => orderIdx(a.data.slug) - orderIdx(b.data.slug));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Fishing', href: '/fishing/' },
  { label: 'Charters' },
];

const hubSchema = buildBfHubSchema({
  name: 'Mornington Peninsula fishing charters',
  description:
    "Peninsula fishing charters compared editorially. Operator profiles with species and season specialty, departure points, vessel details, and licence cover status.",
  path: '/fishing/charters/',
  dateModified: lastVerifiedISO,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Fishing', path: '/fishing/' },
    { name: 'Charters' },
  ],
  items: ordered.map((c) => ({
    name: c.data.name,
    path: `/fishing/charters/${c.data.slug}/`,
    description: c.data.intro,
    itemType: 'LocalBusiness',
  })),
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Fishing', url: 'https://peninsulainsider.com.au/fishing/' },
  { name: 'Charters', url: 'https://peninsulainsider.com.au/fishing/charters/' },
]);
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula fishing charters · Peninsula Insider"
  description="Peninsula fishing charters editorially compared. Operator profiles, species and season specialty, departure points, vessels, and licence cover status."
  section="fishing"
  canonical="https://peninsulainsider.com.au/fishing/charters/"
  modifiedTime={lastVerifiedISO}
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Fishing · Charters"
    title="Peninsula fishing charters, <em>compared</em>"
    dek="The buyer's guide. Each operator profile names the species they actually target, the departure points they use, the vessel, the price band, and whether the licence is covered for the day."
    gradient="vineyard"
  entitySlug="fishing-charters"
  />

  <section class="experience-index">
    <div class="container">
      {ordered.length === 0 ? (
        <div class="prose">
          <p>Charter operator profiles are being verified before publish. The Anchor and Featured tier (I'm Hooked Fishing Charters, Proline Charters, Reel Time Fishing Charters, Western Port Fishing Charters) ships in the next wave.</p>
          <p>Until then, browse <a href="/tour/fishing-tours/">fishing experiences in the tour vertical</a> if you are looking to book a charter as a curated experience.</p>
        </div>
      ) : (
        <div class="venues__grid venues__grid--links">
          {ordered.map((c) => (
            <article class="pi-card"><div class="pi-card__body">
              <h2 class="venue-card__name">
                <a href={`/fishing/charters/${c.data.slug}/`}>{c.data.name}</a>
              </h2>
              <p class="pi-card__meta">
                {c.data.licenceCovered === 'covered' ? 'Licence covered' : c.data.licenceCovered === 'byo' ? 'BYO licence' : ''}
              </p>
              <p class="pi-card__dek">{c.data.intro}</p>
              <div class="pi-card__actions"><a href={`/fishing/charters/${c.data.slug}/`} class="pi-btn pi-btn--solid">Operator profile &rarr;</a></div>
            </div></article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="experience-index experience-index--plain">
    <div class="container prose">
      <p class="label label--accent">Cross-link</p>
      <h2>Looking to book a charter as a curated experience?</h2>
      <p>
        The <a href="/tour/fishing-tours/">fishing tour theme hub</a> aggregates
        operator-led fishing experiences in the same network as the rest of
        the Peninsula's day tours and packages. The two paths overlap on
        operators but separate on intent: this page owns "I want to compare
        charter operators by species, season, and departure point". The tour
        path owns "I want to book a fishing day as part of a curated trip".
      </p>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
