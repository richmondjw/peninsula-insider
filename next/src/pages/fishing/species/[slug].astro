---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SubpageHero from '../../../components/SubpageHero.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import BfAnalytics from '../../../components/BfAnalytics.astro';
import { buildSpeciesPageSchema } from '../../../lib/schema';
import { BF_EXTERNAL, REGION_LABEL, formatVerifiedStamp } from '../../../lib/bf';

export async function getStaticPaths() {
  const species = await getCollection('species', ({ data }) => data.status === 'published');
  return species.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const lastVerifiedStamp = formatVerifiedStamp(data.lastVerified);
const speciesSchema = buildSpeciesPageSchema(data);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Fishing', href: '/fishing/' },
  { label: 'Species', href: '/fishing/species/' },
  { label: data.commonName },
];

// Charters that target this species — looked up by the species's
// charterSlugs frontmatter array. The Section 9 "operators that target
// this species" rail in the pack anatomy.
const allCharters = await getCollection('fishingCharters', ({ data: d }) => d.status === 'published');
const speciesCharters = allCharters.filter((c) => data.charterSlugs.includes(c.data.slug));

// Locations that hold this species. Pulls from species.locationSlugs first;
// falls back to any published location whose primarySpecies includes this slug.
const allLocations = await getCollection('fishingLocations', ({ data: d }) => d.status === 'published');
const explicit = allLocations.filter((l) => data.locationSlugs.includes(l.data.slug));
const reverse = allLocations.filter(
  (l) => l.data.primarySpecies.includes(data.slug) && !data.locationSlugs.includes(l.data.slug),
);
const speciesLocations = [...explicit, ...reverse];
---

<BaseLayout
  title={`${data.commonName} on the Mornington Peninsula · Peninsula Insider`}
  description={data.metaDescription}
  section="fishing"
  canonical={`https://peninsulainsider.com.au/fishing/species/${data.slug}/`}
  modifiedTime={data.lastVerified.toISOString().split('T')[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(speciesSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow={`Fishing · Species · ${REGION_LABEL[data.primaryRegion]}`}
    title={`${data.commonName} on the Mornington Peninsula`}
    dek={data.intro}
  />

  <article class="venue-detail" data-bf-article>
    <div class="container">
      <div class="prose">
        <p class="prose__verified">
          Last fact-verified {lastVerifiedStamp} against
          <a href={data.vfaCitationUrl} rel="external" data-bf-event="bf_licence_click" data-bf-source={`species-${data.slug}`}>Victorian Fisheries Authority</a>.
          If any bag limit, size limit, or licence requirement on this page differs from current VFA advice, VFA's current guidance takes precedence.
        </p>

        <h2>Quick facts</h2>
        <table>
          <tbody>
            <tr><td>Common name</td><td>{data.commonName}</td></tr>
            <tr><td>Scientific name</td><td><em>{data.scientificName}</em></td></tr>
            {data.aliases.length > 0 ? <tr><td>Also known as</td><td>{data.aliases.join(', ')}</td></tr> : null}
            <tr><td>Bag limit</td><td>{data.bagLimit}</td></tr>
            <tr><td>Minimum size limit</td><td>{data.sizeLimit}</td></tr>
            {data.closedSeason ? <tr><td>Closed season</td><td>{data.closedSeason}</td></tr> : null}
            <tr><td>Season</td><td>{data.peakSeason}</td></tr>
            <tr><td>Primary water</td><td>{REGION_LABEL[data.primaryRegion]}{data.secondaryRegions.length > 0 ? ` (also ${data.secondaryRegions.map((r: string) => REGION_LABEL[r as keyof typeof REGION_LABEL]).join(', ')})` : ''}</td></tr>
            <tr>
              <td>Licence required</td>
              <td>
                {data.licenceRequired ? (
                  <>Yes. <a href={BF_EXTERNAL.vfaLicence} rel="external" data-bf-event="bf_licence_click" data-bf-source={`species-${data.slug}`}>Victorian Recreational Fishing Licence</a> required.</>
                ) : 'No licence required.'}
              </td>
            </tr>
          </tbody>
        </table>

        <p>
          Source for bag limit, size limit, and closed season:
          <a href={data.vfaCitationUrl} rel="external" data-bf-event="bf_licence_click" data-bf-source={`species-${data.slug}`}>VFA species page</a>.
          Last fact-verified {lastVerifiedStamp}.
        </p>

        <Content />

        {speciesLocations.length > 0 ? (
          <>
            <h2>Where to catch {data.commonName.toLowerCase()} on the Peninsula</h2>
            <ul>
              {speciesLocations.map((loc) => (
                <li>
                  <a href={`/fishing/locations/${loc.data.slug}/`}>{loc.data.name}</a>
                  {' · '}{REGION_LABEL[loc.data.region]}
                  {loc.data.bestSeason ? ` · ${loc.data.bestSeason}` : ''}
                </li>
              ))}
            </ul>
          </>
        ) : null}

        {speciesCharters.length > 0 ? (
          <>
            <h2>Charter operators that target {data.commonName.toLowerCase()}</h2>
            <ul>
              {speciesCharters.map((c) => (
                <li>
                  <a
                    href={`/fishing/charters/${c.data.slug}/`}
                    data-bf-event="bf_comparison_click"
                    data-bf-species={data.slug}
                    data-bf-operator={c.data.slug}
                  >{c.data.name}</a>
                  {c.data.priceLow != null ? ` · From $${c.data.priceLow} per person` : ''}
                  {c.data.licenceCovered === 'covered' ? ' · Licence covered' : c.data.licenceCovered === 'byo' ? ' · BYO licence' : ''}
                </li>
              ))}
            </ul>
            <p>
              Operators are listed because they demonstrably target {data.commonName.toLowerCase()},
              not as a default reference. Browse <a href="/fishing/charters/">all Peninsula charters</a>
              to compare across species and seasons.
            </p>
          </>
        ) : null}

        {data.eatLinks.length > 0 ? (
          <>
            <h2>Where to cook your catch</h2>
            <ul>
              {data.eatLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    data-bf-event="bf_eat_cross_link"
                    data-bf-species={data.slug}
                  >{l.label}</a>
                </li>
              ))}
            </ul>
          </>
        ) : null}

        {data.faq.length > 0 ? (
          <>
            <h2>Frequently asked questions</h2>
            {data.faq.map((f) => (
              <>
                <h3>{f.question}</h3>
                <p>{f.answer}</p>
              </>
            ))}
          </>
        ) : null}

        <h2>Verified stamp</h2>
        <p class="prose__verified">
          Key facts last verified {lastVerifiedStamp} against the
          <a href={BF_EXTERNAL.vfa} rel="external">Victorian Fisheries Authority</a>.
          If any bag limit, size limit, or licence requirement on this page differs from
          <a href={data.vfaCitationUrl} rel="external">VFA's current guidance</a>, VFA's current
          guidance takes precedence. Regulations change. Confirm before fishing.
        </p>
      </div>
    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>
