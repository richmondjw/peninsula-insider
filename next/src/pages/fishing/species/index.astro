---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHero from '../../../components/SectionHero.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import BfAnalytics from '../../../components/BfAnalytics.astro';
import { buildBfHubSchema, buildBreadcrumbSchema } from '../../../lib/schema';
import { BF_EXTERNAL, BF_SPECIES_ORDER, REGION_LABEL, formatVerifiedStamp } from '../../../lib/bf';

const lastVerifiedISO = '2026-04-30';
const lastVerifiedStamp = formatVerifiedStamp(lastVerifiedISO);

const allSpecies = await getCollection('species', ({ data }) => data.status === 'published');
// Editorial order from the pack — flagship species first, secondary later.
const orderIdx = (slug: string) => {
  const i = (BF_SPECIES_ORDER as readonly string[]).indexOf(slug);
  return i === -1 ? 999 : i;
};
const ordered = [...allSpecies].sort((a, b) => orderIdx(a.data.slug) - orderIdx(b.data.slug));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Fishing', href: '/fishing/' },
  { label: 'Species' },
];

const hubSchema = buildBfHubSchema({
  name: 'Mornington Peninsula fishing species',
  description:
    'Twelve species pages for Peninsula fishing. VFA-verified bag and size limits, Peninsula-specific tide and season editorial, location matrix, and charter cross-links.',
  path: '/fishing/species/',
  dateModified: lastVerifiedISO,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Fishing', path: '/fishing/' },
    { name: 'Species' },
  ],
  items: ordered.map((s) => ({
    name: s.data.commonName,
    path: `/fishing/species/${s.data.slug}/`,
    description: s.data.intro,
    itemType: 'Article',
  })),
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Fishing', url: 'https://peninsulainsider.com.au/fishing/' },
  { name: 'Species', url: 'https://peninsulainsider.com.au/fishing/species/' },
]);
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula fishing species · Peninsula Insider"
  description="Twelve species pages for Peninsula fishing. VFA-verified bag limits, size limits, Peninsula-specific seasons, locations, and charter cross-links."
  section="fishing"
  canonical="https://peninsulainsider.com.au/fishing/species/"
  modifiedTime={lastVerifiedISO}
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Fishing · Species"
    title="The 12 species that <em>actually</em> fish on the Peninsula"
    dek="Bag and size limits cite the Victorian Fisheries Authority verbatim. The editorial layer covers Peninsula-specific tide windows, where the species reliably runs, and which charters target it."
    gradient="vineyard"
  entitySlug="fishing-species"
  />

  <p class="affiliate-disclosure container">
    Bag and size limits sourced from the
    <a href={BF_EXTERNAL.vfa} rel="external">Victorian Fisheries Authority</a>.
    Last fact-verified {lastVerifiedStamp}. Regulations change — confirm with
    VFA before fishing.
  </p>

  <section class="experience-index">
    <div class="container">
      {ordered.length === 0 ? (
        <div class="prose">
          <p>Species pages are being prepared. Check back soon, or browse <a href="/fishing/">the fishing hub</a> in the meantime.</p>
        </div>
      ) : (
        <div class="venues__grid venues__grid--links">
          {ordered.map((s) => (
            <article class="venue-card">
              <h2 class="venue-card__name">
                <a href={`/fishing/species/${s.data.slug}/`}>{s.data.commonName}</a>
              </h2>
              <p class="venue-card__meta">
                {s.data.scientificName} · Primary water: {REGION_LABEL[s.data.primaryRegion]} · Peak: {s.data.peakSeason}
              </p>
              <p class="venue-card__signature">{s.data.intro}</p>
              <a href={`/fishing/species/${s.data.slug}/`} class="venue-card__cta">Read species guide &rarr;</a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
