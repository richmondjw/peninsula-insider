---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SubpageHero from '../../../components/SubpageHero.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import BfAnalytics from '../../../components/BfAnalytics.astro';
import AlertBlock from '../../../components/AlertBlock.astro';
import { buildFishingLocationSchema } from '../../../lib/schema';
import { BF_EXTERNAL, REGION_LABEL, formatVerifiedStamp } from '../../../lib/bf';

export async function getStaticPaths() {
  const locations = await getCollection('fishingLocations', ({ data }) => data.status === 'published');
  return locations.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const lastVerifiedStamp = formatVerifiedStamp(data.lastVerified);
const locationSchema = buildFishingLocationSchema(data);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Fishing', href: '/fishing/' },
  { label: 'Locations', href: '/fishing/locations/' },
  { label: data.name },
];

// Reverse-lookup the species this location holds. Pulls from
// data.primarySpecies (slugs) and resolves to published species entries.
const allSpecies = await getCollection('species', ({ data: d }) => d.status === 'published');
const locationSpecies = allSpecies.filter((s) => data.primarySpecies.includes(s.data.slug));

// Resolve nearest ramp by slug for the cross-link block.
let nearestRamp: any = null;
if (data.nearestRampSlug) {
  const allRamps = await getCollection('boatRamps', ({ data: d }) => d.status === 'published');
  nearestRamp = allRamps.find((r) => r.data.slug === data.nearestRampSlug)?.data ?? null;
}

const locationTypeLabel: Record<string, string> = {
  pier: 'Pier',
  jetty: 'Jetty',
  beach: 'Beach',
  'rock-platform': 'Rock platform',
  inlet: 'Inlet',
  foreshore: 'Foreshore',
};
export const prerender = true;
---

<BaseLayout
  title={`${data.name} fishing · Peninsula Insider`}
  description={data.metaDescription}
  section="fishing"
  canonical={`https://peninsulainsider.com.au/fishing/locations/${data.slug}/`}
  modifiedTime={data.lastVerified.toISOString().split('T')[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(locationSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow={`Fishing · Locations · ${REGION_LABEL[data.region]}`}
    title={data.name}
    dek={data.intro}
  />

  <article class="venue-detail" data-bf-article>
    <div class="container">
      <div class="prose">
        {data.accessNotice ? (
          <AlertBlock type="danger" heading={data.accessNotice.status === 'closed' ? 'Public access closed' : 'Access restricted'}>
            <p>{data.accessNotice.summary}</p>
            <p>
              Access notice checked {formatVerifiedStamp(data.accessNotice.checkedOn)}.
              {' '}<a href={data.accessNotice.sourceUrl} rel="external">Read the current authority notice</a> before travelling.
            </p>
          </AlertBlock>
        ) : null}
        <p class="prose__verified">
          Last fact-verified {lastVerifiedStamp}
        </p>

        <h2>Quick facts</h2>
        <dl class="location-facts">
          <div class="location-facts__row"><dt>Type</dt><dd>{locationTypeLabel[data.locationType] ?? data.locationType}</dd></div>
          <div class="location-facts__row"><dt>Water body</dt><dd>{REGION_LABEL[data.region]}</dd></div>
          {data.bestSeason ? <div class="location-facts__row"><dt>Best season</dt><dd>{data.bestSeason}</dd></div> : null}
          {data.parking ? <div class="location-facts__row"><dt>Parking</dt><dd>{data.parking}</dd></div> : null}
          {data.tideStation ? <div class="location-facts__row"><dt>Tide reference station</dt><dd>{data.tideStation}</dd></div> : null}
          {data.publicToilets != null ? <div class="location-facts__row"><dt>Public toilets</dt><dd>{data.publicToilets ? 'Yes' : 'No'}</dd></div> : null}
          {data.accessibility ? <div class="location-facts__row"><dt>Accessibility</dt><dd>{data.accessibility}</dd></div> : null}
          {data.primarySpecies.length > 0 ? (
            <div class="location-facts__row">
              <dt>Top species</dt>
              <dd>{data.primarySpecies.slice(0, 4).map((species, idx) => (
                <>
                  <a href={`/fishing/species/${species}/`}>{species.replace(/-/g, ' ')}</a>
                  {idx < Math.min(data.primarySpecies.length, 4) - 1 ? ', ' : null}
                </>
              ))}</dd>
            </div>
          ) : null}
        </dl>

        {data.tideNotes ? (
          <aside class="alert-block">
            <strong>Tide note.</strong> {data.tideNotes}
            {' '}Use <a href={BF_EXTERNAL.willyweather} rel="external" data-bf-event="bf_tide_lookup" data-bf-source={`location-${data.slug}`}>Willyweather</a>
            {' '}or <a href={BF_EXTERNAL.bom} rel="external" data-bf-event="bf_tide_lookup" data-bf-source={`location-${data.slug}`}>BOM tidal predictions</a>
            {' '}for the {data.tideStation || 'relevant'} reference station.
          </aside>
        ) : null}

        {data.safetyNotes ? (
          <aside class="alert-block">
            <strong>Safety note.</strong> {data.safetyNotes}
          </aside>
        ) : null}

        <Content />

        {locationSpecies.length > 0 ? (
          <>
            <h2>Species this location holds</h2>
            <ul>
              {locationSpecies.map((s) => (
                <li>
                  <a href={`/fishing/species/${s.data.slug}/`}>{s.data.commonName}</a>
                  {' · '}{s.data.peakSeason}
                  {' · '}{s.data.bagLimit.split(',')[0]}
                </li>
              ))}
            </ul>
          </>
        ) : null}

        {nearestRamp ? (
          <>
            <h2>Nearby launching</h2>
            <p>
              Nearest ramp: <a href={`/boating/ramps/${nearestRamp.slug}/`}>{nearestRamp.name}</a>.
              {nearestRamp.tideDependence === 'all-tide' ? ' All-tide.' : ` Tide-${nearestRamp.tideDependence === 'high-tide-only' ? 'dependent (high tide only).' : nearestRamp.tideDependence + '.'}`}
              {nearestRamp.fee ? ` ${nearestRamp.fee}` : ''}
            </p>
          </>
        ) : null}

        {data.faq.length > 0 ? (
          <>
            <h2>Frequently asked questions</h2>
            {data.faq.map((f) => (
              <>
                <h3>{f.question}</h3>
                <p>{f.answer}</p>
              </>
            ))}
          </>
        ) : null}

        <h2>Related</h2>
        <ul>
          <li><a href="/fishing/">Fishing hub</a></li>
          <li><a href="/fishing/locations/">All Peninsula fishing locations</a></li>
          <li><a href={`/fishing/locations/?region=${data.region}`}>{REGION_LABEL[data.region]} locations</a></li>
        </ul>

        <p class="prose__verified">
          Bag limits, size limits, and licensing are sourced from the
          <a href={BF_EXTERNAL.vfa} rel="external" data-bf-event="bf_licence_click" data-bf-source={`location-${data.slug}`}>Victorian Fisheries Authority</a>.
          Confirm with VFA before fishing.
        </p>
      </div>
    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>

<style>
  .location-facts {
    margin: 1.5rem 0 2.25rem;
    border-top: 1px solid var(--border);
  }
  .location-facts__row {
    display: grid;
    grid-template-columns: minmax(9rem, 30%) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
  }
  .location-facts dt {
    font-weight: 600;
    color: var(--dark);
  }
  .location-facts dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .location-facts__row { display: block; }
    .location-facts dt { margin-bottom: 0.2rem; }
  }
</style>
