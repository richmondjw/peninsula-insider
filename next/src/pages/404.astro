---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import AskPICTA from '../components/AskPICTA.astro';
export const prerender = true;
---

<BaseLayout
  title="Page not found  -  Peninsula Insider"
  description="The page you're looking for doesn't exist. Try the homepage or browse our sections."
  section="home"
  noindex={true}
>
  <section class="not-found">
    <div class="container">
      <div class="not-found__inner">

        <!-- PI's editorial 404 - from BRAND-PI.md -->
        <div class="not-found__pi" aria-hidden="true">
          <span class="not-found__avatar">
            <span class="not-found__avatar-fallback">PI</span>
            <img src="/images/pi-concierge.svg" alt="" width="72" height="72" onerror="this.remove()" />
          </span>
        </div>

        <p class="not-found__code">404 <span class="not-found__code-mark" aria-hidden="true">⁂</span></p>
        <h1 class="not-found__title">The Insider hasn't been here yet.</h1>
        <p class="not-found__body">
          The URL might be wrong, the page might have moved, or it was never here to begin with. The Peninsula is big enough to get lost in. The website shouldn't be.
        </p>

        <AskPICTA
          variant="inline"
          label="Tell me what you were looking for"
          hint="I'll find you the right thing instead."
          prefill=""
        />

        <nav class="not-found__nav" aria-label="Recovery links">
          <p class="not-found__nav-label"><span>Or try one of these</span></p>
          <a href="/" class="not-found__link">← Back to the homepage</a>
          <a href="/journal/" class="not-found__link">Browse the Journal</a>
          <a href="/eat/" class="not-found__link">Eat &amp; Drink</a>
          <a href="/explore/" class="not-found__link">Explore</a>
          <a href="/explore/places/" class="not-found__link">Places</a>
          <a href="/contact/" class="not-found__link">Report a broken link</a>
        </nav>
      </div>
    </div>
  </section>

  <NewsletterBlock
    title="While you're here  -  the newsletter is real."
    body="Weekly Peninsula coverage with honest picks, new openings, and the cellar doors worth knowing."
  />
</BaseLayout>

<style is:global>
  .not-found__pi {
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }
  .not-found__avatar {
    position: relative;
    width: 88px; height: 88px;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 30% 30%, #FBF1DE 0%, #F0E2C7 70%, #E5D2AF 100%);
    border: 1px solid rgba(139, 78, 59, 0.22);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 24px rgba(34, 24, 16, 0.1);
  }
  .not-found__avatar img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .not-found__avatar-fallback {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    color: #8B4E3B;
    font-size: 1.4rem;
    line-height: 1;
  }
  .not-found__code-mark {
    color: #8B4E3B;
    font-size: 0.6em;
    margin-left: 0.4em;
    letter-spacing: 0.4em;
  }
  .not-found__nav-label {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 2rem 0 1.1rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #8B4E3B;
  }
  .not-found__nav-label::before,
  .not-found__nav-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139, 78, 59, 0.32), transparent);
  }
  .not-found__nav-label > span { white-space: nowrap; }
</style>
