---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/SectionHero.astro';
import TourCard from '../../components/TourCard.astro';
import TourPackageCard from '../../components/TourPackageCard.astro';
import TourOperatorCard from '../../components/TourOperatorCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { buildCollectionPageSchema, buildItemListSchema, buildBreadcrumbSchema } from '../../lib/schema';

const allTours = (await getCollection('tours'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const allPackages = (await getCollection('tourPackages'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const allOperators = (await getCollection('tourOperators'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const allOperatorsMap = Object.fromEntries(allOperators.map(op => [op.data.slug, op.data]));

const featuredTours = allTours.slice(0, 6);
const featuredPackages = allPackages.slice(0, 3);
const featuredOperators = allOperators.slice(0, 4);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tours' },
];

const collectionPageSchema = buildCollectionPageSchema({
  name: 'Mornington Peninsula Tours',
  description: 'Verified operator-led tours on the Mornington Peninsula, wine tours, hot springs, wildlife, private charters, and multi-day packages.',
  path: '/tour/',
  dateModified: '2026-04-29',
});

const itemListSchema = buildItemListSchema({
  name: 'Mornington Peninsula Tours',
  listPath: '/tour/',
  items: allTours.map(t => ({
    name: t.data.name,
    path: `/tour/${t.data.slug}/`,
    description: t.data.intro,
    itemType: 'TouristTrip',
  })),
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Tours', url: 'https://peninsulainsider.com.au/tour/' },
]);
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Tours · Peninsula Insider"
  description="Operator-led tours on the Mornington Peninsula, wine tours, hot springs, wildlife, private charters, and verified multi-day packages. Honest editorial assessments."
  section="tour"
  canonical="https://peninsulainsider.com.au/tour/"
  modifiedTime="2026-04-29"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Tours"
    title="Operator-led experiences on the <em>Mornington Peninsula</em>"
    dek="Peninsula Insider covers every guided tour and operator-led experience on the Peninsula. Verified facts, honest comparison, and the editorial call on who each tour actually suits."
    gradient="vineyard"
    heroImage="/images/sourced/wine-hub-hero-01.webp"
    entitySlug="tour"
    entityType="page"
  />

  {featuredTours.length > 0 && (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="split-intro">
          <div>
            <p class="label label--accent">Featured tours</p>
            <h2 class="split-intro__title">Operator-led Peninsula experiences worth booking</h2>
          </div>
          <p class="split-intro__body">Each entry is verified against the operator's current product. We note who each tour suits and who it doesn't.</p>
        </div>
        <div class="tour-grid">
          {featuredTours.map((tour) => (
            <TourCard tour={tour} operatorName={allOperatorsMap[tour.data.operatorSlug]?.name} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="experience-index">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Browse by experience</p>
          <h2 class="venues__title">Find tours by what you want to do</h2>
        </div>
      </div>
      <div class="tour-filter-chips">
        <a href="/tour/wine-tours/" class="tour-filter-chip">Wine &amp; Cellar Door</a>
        <a href="/tour/hot-springs-tours/" class="tour-filter-chip">Hot Springs</a>
        <a href="/tour/fishing-tours/" class="tour-filter-chip">Fishing</a>
        <a href="/tour/private-tours/" class="tour-filter-chip">Private &amp; Bespoke</a>
        <a href="/tour/small-group-tours/" class="tour-filter-chip">Small Group</a>
        <a href="/tour/full-day-tours/" class="tour-filter-chip">Full Day</a>
        <a href="/tour/for-couples/" class="tour-filter-chip">For Couples</a>
        <a href="/tour/for-families/" class="tour-filter-chip">For Families</a>
        <a href="/tour/operators/" class="tour-filter-chip">All Operators</a>
      </div>
    </div>
  </section>

  {featuredPackages.length > 0 && (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Multi-day packages</p>
            <h2 class="venues__title">Curated combinations worth building a weekend around</h2>
            <p class="venues__sub">Each package pairs verified tours with a curated anchor stay. The combination is editorial, not sponsored.</p>
          </div>
          <a href="/tour-packages/" class="venues__link">All packages &rarr;</a>
        </div>
        <div class="package-grid">
          {featuredPackages.map((pkg) => <TourPackageCard pkg={pkg} />)}
        </div>
      </div>
    </section>
  )}

  {featuredOperators.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Verified operators</p>
            <h2 class="venues__title">Who runs tours on the Peninsula</h2>
            <p class="venues__sub">Each operator listed here has been assessed against our vetting criteria: product accuracy, guest experience, and affiliate transparency.</p>
          </div>
          <a href="/tour/operators/" class="venues__link">All operators &rarr;</a>
        </div>
        <div class="operator-grid">
          {featuredOperators.map((op) => <TourOperatorCard operator={op} />)}
        </div>
      </div>
    </section>
  )}

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Planning your visit</p>
          <h2 class="venues__title">Self-drive versus operator-led</h2>
        </div>
      </div>
      <div class="venues__grid venues__grid--links">
        <div class="pi-card"><div class="pi-card__body">
          <h3 class="pi-card__title"><a href="/plans/">Self-drive itineraries</a></h3>
          <p class="pi-card__dek">Prefer to drive yourself? Our escape itineraries map the Peninsula in detail, sequence, timing, and the anchors that make a weekend feel intentional.</p>
          <div class="pi-card__actions"><a href="/plans/" class="pi-btn pi-btn--solid">Browse itineraries &rarr;</a></div>
        </div></div>
        <div class="pi-card"><div class="pi-card__body">
          <h3 class="pi-card__title"><a href="/tour/wine-tours/">Peninsula wine tours</a></h3>
          <p class="pi-card__dek">A guided wine day removes the logistics of driving between cellar doors. We compare operators so you pick the one that fits your group.</p>
          <div class="pi-card__actions"><a href="/tour/wine-tours/" class="pi-btn pi-btn--solid">Compare wine tours &rarr;</a></div>
        </div></div>
        <div class="pi-card"><div class="pi-card__body">
          <h3 class="pi-card__title"><a href="/tour/private-tours/">Private and bespoke tours</a></h3>
          <p class="pi-card__dek">For groups who want a custom itinerary, a single vehicle, and a guide who adapts to what you actually want on the day.</p>
          <div class="pi-card__actions"><a href="/tour/private-tours/" class="pi-btn pi-btn--solid">Private tour options &rarr;</a></div>
        </div></div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="prose">
        <h2>Frequently asked questions</h2>
        <h3>Are Mornington Peninsula wine tours worth it?</h3>
        <p>For visitors who want to cover multiple cellar doors without driving, yes. A guided wine tour removes the logistics and lets everyone in the group drink. The trade-off is pace: most small-group tours run to a schedule. If you want extended time at a single estate, a private charter or self-drive itinerary is usually better.</p>
        <h3>How much does a Mornington Peninsula tour cost?</h3>
        <p>Confirm pricing directly with each operator. Costs vary by tour length, group size, and whether transport and lunch are included. Most operators publish current rates on their booking pages.</p>
        <h3>What is the best time of year for a Peninsula tour?</h3>
        <p>October through April is peak season: the weather is best and the cellar doors are fully staffed. Vintage (March to April) is a particularly good time to visit wineries. Winter tours are quieter, but check that your preferred cellar doors are open before you book.</p>
        <h3>Do tours depart from Melbourne or from the Peninsula?</h3>
        <p>Most small-group tours and commercial operators depart from Melbourne CBD. Some premium and private operators offer Peninsula-side pickups from Mornington, Sorrento, or Red Hill. Check pickup options when booking.</p>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
