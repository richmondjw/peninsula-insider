---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/SectionHero.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import BfAnalytics from '../../components/BfAnalytics.astro';
import { buildBfHubSchema, buildBreadcrumbSchema } from '../../lib/schema';
import { formatVerifiedStamp } from '../../lib/bf';

// /tour/ ↔ /fishing/charters/ bidirectional rail. This page is the "I want
// to book a fishing experience as a curated tour" intent surface; it pairs
// with /fishing/charters/ which owns the "I want to compare operators by
// species, season, and departure point" intent. Both list the same operators
// but framed differently.

const lastVerifiedISO = '2026-04-30';
const lastVerifiedStamp = formatVerifiedStamp(lastVerifiedISO);
const path = '/tour/fishing-tours/';

const allCharters = await getCollection('fishingCharters', ({ data }) => data.status === 'published');

// Existing /tour/ entries with cruise-sailing, surf-water, or wildlife-nature
// experience type that touch fishing intent - surfaced here as adjacent options.
const allTours = await getCollection('tours');
const adjacentTours = allTours.filter((t) =>
  ['cruise-sailing', 'surf-water'].includes(t.data.experienceType),
);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tours', href: '/tour/' },
  { label: 'Fishing tours' },
];

const hubSchema = buildBfHubSchema({
  name: 'Mornington Peninsula fishing tours',
  description:
    'Operator-led fishing experiences on the Mornington Peninsula. Charter sessions framed as bookable tours; for the editorial comparison by species and season, see the /fishing/charters/ hub.',
  path,
  dateModified: lastVerifiedISO,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Tours', path: '/tour/' },
    { name: 'Fishing tours' },
  ],
  items: allCharters.map((c) => ({
    name: c.data.name,
    path: `/fishing/charters/${c.data.slug}/`,
    description: c.data.intro,
    itemType: 'LocalBusiness',
  })),
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Tours', url: 'https://peninsulainsider.com.au/tour/' },
  { name: 'Fishing tours', url: `https://peninsulainsider.com.au${path}` },
]);
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula fishing tours · Peninsula Insider"
  description="Fishing tours on the Mornington Peninsula. Operator-led charter sessions for snapper, whiting, squid, and Western Port species. The booking-first view; the editorial comparison lives at /fishing/charters/."
  section="tour"
  canonical={`https://peninsulainsider.com.au${path}`}
  modifiedTime={lastVerifiedISO}
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Tours · Fishing"
    title="<em>Fishing tours</em> on the Mornington Peninsula"
    dek="Operator-led fishing as a bookable experience. Snapper-season charters, Western Port whiting and flathead, mid-size group bookings, and Bass Strait offshore. The booking-first view; the editorial comparison lives at /fishing/charters/."
    gradient="vineyard"
    heroImage="/images/sourced/explore-portsea-front-beach-01.webp"
  />

  <section class="experience-index" data-bf-article>
    <div class="container prose">
      <p class="label label--accent">Two paths, one operator network</p>
      <h2>This hub or the fishing-charters hub?</h2>
      <p>
        Peninsula Insider runs two surfaces for fishing-charter intent. This
        page (in the <a href="/tour/">Tours</a> vertical) is the booking-first
        view: every operator we cover, framed as a bookable experience.
        The <a href="/fishing/charters/">fishing-charters hub</a> is the
        editorial-comparison view: the same operators framed by target species,
        season, departure point, and licence-cover status. They share the same
        operator network. Pick whichever framing matches your decision.
      </p>
    </div>
  </section>

  <section class="experience-index">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Operators</p>
          <h2 class="venues__title">Peninsula fishing-charter operators</h2>
          <p class="venues__sub">Each operator is editorially profiled with the species they target, the departure ramps they use, the vessel detail, and price band. Select any operator to read the full profile.</p>
        </div>
        <a href="/fishing/charters/" class="venues__link">Editorial comparison &rarr;</a>
      </div>
      <div class="venues__grid venues__grid--links">
        {allCharters.length === 0 ? (
          <p>Operator profiles are being verified. Check back soon.</p>
        ) : (
          allCharters.map((c) => (
            <article class="pi-card"><div class="pi-card__body">
              <h3 class="pi-card__title">
                <a
                  href={`/fishing/charters/${c.data.slug}/`}
                  data-bf-event="bf_cross_vertical_click"
                  data-bf-from="tour-fishing-tours"
                  data-bf-operator={c.data.slug}
                >{c.data.name}</a>
              </h3>
              <p class="pi-card__meta">
                {c.data.licenceCovered === 'covered' ? 'Licence covered' : c.data.licenceCovered === 'byo' ? 'BYO licence' : ''}
              </p>
              <p class="pi-card__dek">{c.data.intro}</p>
              <div class="pi-card__actions"><a href={`/fishing/charters/${c.data.slug}/`} class="pi-btn pi-btn--solid" data-bf-event="bf_cross_vertical_click" data-bf-from="tour-fishing-tours" data-bf-operator={c.data.slug}>Operator profile &rarr;</a></div>
            </div></article>
          ))
        )}
      </div>
    </div>
  </section>

  {adjacentTours.length > 0 && (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Adjacent water tours</p>
            <h2 class="venues__title">Boat-based experiences that aren't fishing</h2>
            <p class="venues__sub">Cruise, sailing, kayak, and surf-water tours that share the operator-led-on-the-water frame without the fishing focus.</p>
          </div>
          <a href="/tour/" class="venues__link">All tours &rarr;</a>
        </div>
        <div class="venues__grid venues__grid--links">
          {adjacentTours.slice(0, 6).map((t) => (
            <article class="pi-card"><div class="pi-card__body">
              <h3 class="pi-card__title"><a href={`/tour/${t.data.slug}/`}>{t.data.name}</a></h3>
              <p class="pi-card__dek">{t.data.intro}</p>
              <div class="pi-card__actions"><a href={`/tour/${t.data.slug}/`} class="pi-btn pi-btn--solid">Tour profile &rarr;</a></div>
            </div></article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="experience-index">
    <div class="container prose">
      <p class="label label--accent">First time?</p>
      <h2>Your first Peninsula fishing charter</h2>
      <p>
        New to fishing charters? The <a href="/fishing/charters/first-charter-guide/" data-bf-event="bf_cross_vertical_click" data-bf-from="tour-fishing-tours">first-charter guide</a>
        covers operator selection, what's included, what to bring, what to expect on the day, and the FAQ that
        every first-time guest asks. Then come back here to book.
      </p>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
