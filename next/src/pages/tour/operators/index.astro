---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SubpageHero from '../../../components/SubpageHero.astro';
import TourOperatorCard from '../../../components/TourOperatorCard.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';

const allOperators = (await getCollection('tourOperators'))
  .sort((a, b) => {
    // Vetted operators first, then alphabetical
    if (a.data.vetted && !b.data.vetted) return -1;
    if (!a.data.vetted && b.data.vetted) return 1;
    return a.data.name.localeCompare(b.data.name);
  });

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tours', href: '/tour/' },
  { label: 'Operators' },
];
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Tour Operators · Peninsula Insider"
  description="Verified tour operators running guided experiences on the Mornington Peninsula. Editorial assessments of who each operator suits and what they deliver."
  section="tour"
  canonical="https://peninsulainsider.com.au/tour/operators/"
  modifiedTime="2026-04-29"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow="Tours"
    category="Operators"
    title="Mornington Peninsula Tour Operators"
    heroImage="/images/sourced/place-mornington-01.webp"
    imageAlt="Mornington township - Peninsula tour operators guide"
    imageCaption="Sorrento"
  entitySlug="tour/operators"
  entityType="page"
  >
    <div class="prose">
      <p>Peninsula Insider vets every operator listed here against a consistent set of criteria: product accuracy, guest experience track record, and affiliate transparency. We note which operator type each one is, what they are genuinely good at, and where they fall short.</p>
      <p>If an operator is listed as vetted, we have assessed their product directly. If not yet vetted, the listing is based on publicly available information and will be updated once assessed.</p>
    </div>
  </SubpageHero>

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">All operators</p>
          <h2 class="venues__title">{allOperators.length} tour {allOperators.length === 1 ? 'operator' : 'operators'} on the Peninsula</h2>
          <p class="venues__sub">Sorted by vetting status, then alphabetically.</p>
        </div>
        <a href="/tour/" class="venues__link">All tours &rarr;</a>
      </div>

      {allOperators.length > 0 ? (
        <div class="operator-grid">
          {allOperators.map((op) => <TourOperatorCard operator={op} />)}
        </div>
      ) : (
        <div class="prose">
          <p>Operator listings are being compiled. Check back soon, or <a href="/tour/">browse all tours</a>.</p>
        </div>
      )}
    </div>
  </section>

  <section class="experience-index">
    <div class="container">
      <div class="prose">
        <h2>How we vet operators</h2>
        <p>Our vetting process checks four things: whether the advertised product matches what guests actually receive; whether the operator is transparent about pricing and inclusions; whether they have a genuine track record on the Peninsula; and whether any affiliate or commercial relationship is disclosed clearly.</p>
        <p>We do not accept payment for operator listings. All editorial assessments are independent. Where we have a commercial affiliate relationship with an operator, this is disclosed on the relevant operator page.</p>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
