---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SubpageHero from '../../../components/SubpageHero.astro';
import TourCard from '../../../components/TourCard.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import CorrectionNote from '../../../components/CorrectionNote.astro';
import { buildOperatorProfileSchema } from '../../../lib/schema';
import InlinePhoto from '../../../components/InlinePhoto.astro';
import { photoPlan } from '../../../lib/photo-set';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { formatHeroCredit } from '../../../lib/editorial';

export async function getStaticPaths() {
  const operators = await getCollection('tourOperators');
  return operators.map((operator) => ({
    params: { slug: operator.id ?? operator.data.slug },
    props: { operator },
  }));
}

const { operator } = Astro.props;
const data = operator.data;
// Credit only the content record's own photograph; an editor's CMS upload
// replaces it and carries no credit of its own here.
const heroResolved = await resolveHero('tour-operator', operator.id ?? data.slug, data);
const heroCredit = !heroResolved.override && data.heroImage?.credit ? formatHeroCredit(data.heroImage.credit) : '';
// The photograph rule (src/lib/photo-set.ts). The About block reads as three
// short paragraphs: intro, strengths, limits.
const photoSet = photoPlan(data, { override: Boolean(heroResolved.override), paragraphs: 3 });
const slug = operator.id ?? data.slug;

const allTours = await getCollection('tours');
const operatorTours = allTours.filter(t => t.data.operatorSlug === data.slug);

const operatorSchema = buildOperatorProfileSchema(data, operatorTours.map(t => t.data));

const typeLabel: Record<string, string> = {
  'volume': 'Group Tour Operator',
  'wine-specialist': 'Wine Specialist',
  'premium-private': 'Premium Private Operator',
  'activity-specialist': 'Activity Specialist',
};

const websiteWithUtm = data.website
  ? `${data.website}${data.website.includes('?') ? '&' : '?'}utm_source=peninsula-insider&utm_medium=tour-vertical&utm_campaign=${slug}&utm_content=operator-profile`
  : null;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tours', href: '/tour/' },
  { label: 'Operators', href: '/tour/operators/' },
  { label: data.name },
];
export const prerender = true;
---

<BaseLayout
  title={`${data.name} · Tour Operator · Peninsula Insider`}
  description={data.intro}
  section="tour"
  canonical={`https://peninsulainsider.com.au/tour/operators/${slug}/`}
  modifiedTime={data.lastVerified?.toISOString().split('T')[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(operatorSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow="Tours"
    category={typeLabel[data.operatorType] ?? data.operatorType}
    title={data.name}
    heroImage={data.heroImage.src}
    imageAlt={data.heroImage.alt}
    entityType="tour-operator"
    entitySlug={slug}
    photos={photoSet.photos}
  >
    <div class="prose">
      <p>{data.intro}</p>
    </div>
  </SubpageHero>
  {heroCredit && !photoSet.stage && (
    <div class="container"><p class="tour-operator__hero-credit">{heroCredit}</p></div>
  )}

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="prose">
        <h2>About {data.name}</h2>
        <p>{data.intro}</p>
        {photoSet.stage && photoSet.afterFirst !== null && <InlinePhoto photos={photoSet.photos} indexes={[photoSet.afterFirst]} subject={data.name} />}

        <h3>What they are good at</h3>
        <p>{data.whatGoodAt}</p>

        <h3>Not suited for</h3>
        <p>{data.notSuitedFor}</p>
      </div>

      {websiteWithUtm && (
        <div class="tour-cta-block">
          <h3 class="tour-cta-block__title">Visit {data.name} directly</h3>
          <p>Pricing, seasonal departures, and group bookings are managed on the operator's own website.</p>
          <a href={websiteWithUtm} target="_blank" rel="noopener noreferrer" class="tour-cta-primary pi-btn pi-btn--solid">
            Visit {data.name} &rarr;
          </a>
        </div>
      )}
    </div>
  </section>

  {operatorTours.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Tours by {data.name}</p>
            <h2 class="venues__title">{operatorTours.length} {operatorTours.length === 1 ? 'tour' : 'tours'} listed</h2>
          </div>
        </div>
        <div class="tour-grid">
          {operatorTours.map((tour) => <TourCard tour={tour} operatorName={data.name} />)}
        </div>
      </div>
    </section>
  )}

  {operatorTours.length === 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="prose">
          <p>Tour listings for this operator are being compiled. <a href="/tour/">Browse all Peninsula tours</a> in the meantime.</p>
        </div>
      </div>
    </section>
  )}

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Related</p>
          <h2 class="venues__title">Other ways to explore the Peninsula</h2>
        </div>
      </div>
      <div class="venues__grid venues__grid--links">
        <div class="pi-card"><div class="pi-card__body">
          <h3 class="pi-card__title"><a href="/tour/operators/">All operators</a></h3>
          <p class="pi-card__dek">Compare every tour operator we have assessed on the Peninsula.</p>
          <div class="pi-card__actions"><a href="/tour/operators/" class="pi-btn pi-btn--solid">Browse operators &rarr;</a></div>
        </div></div>
        <div class="pi-card"><div class="pi-card__body">
          <h3 class="pi-card__title"><a href="/tour-packages/">Tour packages</a></h3>
          <p class="pi-card__dek">Curated multi-experience Peninsula weekends with an anchor stay recommendation.</p>
          <div class="pi-card__actions"><a href="/tour-packages/" class="pi-btn pi-btn--solid">Browse packages &rarr;</a></div>
        </div></div>
      </div>
    </div>
  </section>

  <div class="container">
    <CorrectionNote surface="tour-operator" />
  </div>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* Photo credit for the hero, required beside licensed photographs. */
  .tour-operator__hero-credit {
    margin: .6rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
    text-align: right;
  }
</style>
