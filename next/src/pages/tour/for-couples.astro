---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import TourCard from '../../components/TourCard.astro';
import TourPackageCard from '../../components/TourPackageCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const allTours = await getCollection('tours');
const allOperators = await getCollection('tourOperators');
const operatorMap = Object.fromEntries(allOperators.map(op => [op.data.slug, op.data]));

const couplesTours = allTours.filter(t => t.data.audience === 'couples');

const allPackages = await getCollection('tourPackages');
const couplesPackages = allPackages.filter(p =>
  p.data.audience === 'couples' ||
  p.data.occasion === 'anniversary'
).slice(0, 3);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tours', href: '/tour/' },
  { label: 'For Couples' },
];
export const prerender = true;
---

<BaseLayout
  title="Couples Tours Mornington Peninsula · Peninsula Insider"
  description="Guided tours for couples on the Mornington Peninsula - wine, private charters, wellness, and multi-day packages designed for two."
  section="tour"
  canonical="https://peninsulainsider.com.au/tour/for-couples/"
  modifiedTime="2026-04-29"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow="Tours"
    category="For Couples"
    title="Couples Tours on the Mornington Peninsula"
    heroImage="/images/sourced/article-picnic-01.webp"
    imageAlt="Picnic among the vineyards on the Mornington Peninsula - tours for couples"
    imageCaption="Red Hill Plateau"
  entitySlug="tour/for-couples"
  entityType="page"
  >
    <div class="prose">
      <p>The Peninsula's guided tour options for couples concentrate around wine and private charters. A small-group wine tour is the practical starting point - you cover multiple cellar doors in a single day, no one has to drive, and the format is comfortable for two people joining a shared group.</p>
      <p>Private charters suit couples who want a more intimate experience or who are marking a specific occasion. The guide adjusts to your pace and the itinerary can be built around what you actually want to see.</p>
    </div>
  </SubpageHero>

  {couplesTours.length > 0 ? (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Tours for couples</p>
            <h2 class="venues__title">{couplesTours.length} Peninsula {couplesTours.length === 1 ? 'tour' : 'tours'} for couples</h2>
          </div>
        </div>
        <div class="tour-grid">
          {couplesTours.map((tour) => (
            <TourCard tour={tour} operatorName={operatorMap[tour.data.operatorSlug]?.name} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="prose">
          <p>More couples tour listings coming soon. <a href="/tour/">Browse all Peninsula tours</a>.</p>
        </div>
      </div>
    </section>
  )}

  {couplesPackages.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Packages for couples</p>
            <h2 class="venues__title">Multi-day Peninsula weekends for two</h2>
            <p class="venues__sub">Tour plus anchor stay, packaged into a complete escape.</p>
          </div>
          <a href="/tour-packages/" class="venues__link">All packages &rarr;</a>
        </div>
        <div class="package-grid">
          {couplesPackages.map((pkg) => <TourPackageCard pkg={pkg} />)}
        </div>
      </div>
    </section>
  )}

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="venues__grid venues__grid--links">
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/plans/">Couples itineraries</a></h3>
          <p class="venue-card__signature">Self-drive Peninsula weekends for two - our editorial itineraries handle the sequencing and the anchor stay.</p>
          <a href="/plans/" class="venue-card__cta">Browse itineraries &rarr;</a>
        </div>
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/tour/">All tours</a></h3>
          <p class="venue-card__signature">The full guided tour catalogue - by experience type, duration, and budget.</p>
          <a href="/tour/" class="venue-card__cta">All tours &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
