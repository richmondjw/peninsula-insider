---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { buildTourSchema } from '../../lib/schema';
import { editableText } from '../../lib/inline-edit/attrs';
import { sanityReadEnabled } from '../../lib/sanity/client';
import { fetchTourFromSanity } from '../../lib/sanity/phase5-adapters';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({
    params: { slug: tour.id ?? tour.data.slug },
    props: { tour },
  }));
}

let { tour } = Astro.props;

// Dual-read.
if (sanityReadEnabled('tours')) {
  const slug = tour.id ?? tour.data.slug;
  const previewMode = (Astro.locals as Record<string, unknown>).sanityPreview === true;

  const sanityTour = await fetchTourFromSanity(slug, {preview: previewMode});
  if (sanityTour) tour = sanityTour as any;
}
const data = tour.data;

const allOperators = await getCollection('tourOperators');
const operator = allOperators.find(op => op.data.slug === data.operatorSlug);
const operatorData = operator?.data ?? null;

const tourSchema = buildTourSchema(data, operatorData);

const experienceTypeLabel: Record<string, string> = {
  'food-wine': 'Food & Wine',
  'wildlife-nature': 'Wildlife & Nature',
  'history-heritage': 'History & Heritage',
  'kayak-paddle': 'Kayak & Paddle',
  'cycling': 'Cycling',
  'walking-hiking': 'Walking & Hiking',
  'scenic-sightseeing': 'Scenic Sightseeing',
  'cruise-sailing': 'Cruise & Sailing',
  'art-culture': 'Art & Culture',
  'surf-water': 'Surf & Water',
  'private-charter': 'Private Charter',
  'wellness': 'Wellness',
};

const durationLabel: Record<string, string> = {
  'under-2h': 'Under 2 hours',
  'half-day': 'Half day',
  'full-day': 'Full day',
  'multi-2n': '2 nights',
  'multi-3n': '3 nights',
  'multi-extended': 'Extended',
};

const budgetLabel: Record<string, string> = {
  'budget': 'Budget',
  'moderate': 'Moderate',
  'mid-range': 'Mid-range',
  'premium': 'Premium',
  'luxury': 'Luxury',
};

const groupSizeLabel: Record<string, string> = {
  'intimate': 'Intimate (2-4)',
  'small-group': 'Small group (up to 24)',
  'large-group': 'Large group',
  'private-charter': 'Private charter',
};

const categoryLabel = experienceTypeLabel[data.experienceType] ?? data.experienceType;
const slug = tour.id ?? data.slug;

const primaryBookingUrl = data.bookingUrl
  ? `${data.bookingUrl}${data.bookingUrl.includes('?') ? '&' : '?'}utm_source=peninsula-insider&utm_medium=tour-vertical&utm_campaign=${slug}&utm_content=hero`
  : data.aggregatorGYG
  ? `${data.aggregatorGYG}${data.aggregatorGYG.includes('?') ? '&' : '?'}utm_source=peninsula-insider&utm_medium=tour-vertical&utm_campaign=${slug}&utm_content=hero`
  : null;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tours', href: '/tour/' },
  { label: data.name },
];
---

<BaseLayout
  title={`${data.name} · Peninsula Insider`}
  description={data.intro}
  section="tour"
  canonical={`https://peninsulainsider.com.au/tour/${slug}/`}
  modifiedTime={data.lastVerified?.toISOString().split('T')[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(tourSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow="Tours"
    category={categoryLabel}
    title={data.name}
    heroImage={data.heroImage.src}
    imageAlt={data.heroImage.alt}
    imageCaption={data.departsFrom ?? undefined}
    entityType="tour"
    entitySlug={slug}
  >
    <div class="prose">
      <p {...editableText({
        entityType: 'tour', entitySlug: slug, fieldPath: 'intro',
        label: `${data.name} — intro`,
      })}>{data.intro}</p>
      <p class="venues__sub" style="font-size:0.8rem;color:var(--soft)">Last verified: {data.lastVerified?.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    </div>
  </SubpageHero>

  <section class="experience-index experience-index--plain">
    <div class="container">
      <h2 class="venues__title" style="margin-bottom:1rem">At a glance</h2>
      <div class="at-a-glance">
        <div class="at-a-glance__row">
          <div class="at-a-glance__label">Duration</div>
          <div class="at-a-glance__value">
            {durationLabel[data.duration] ?? data.duration}
            {data.durationHours ? ` (approx. ${data.durationHours} hours)` : ''}
          </div>
        </div>
        {data.departsFrom && (
          <div class="at-a-glance__row">
            <div class="at-a-glance__label">Departs from</div>
            <div class="at-a-glance__value">{data.departsFrom}</div>
          </div>
        )}
        <div class="at-a-glance__row">
          <div class="at-a-glance__label">Group size</div>
          <div class="at-a-glance__value">
            {groupSizeLabel[data.groupSize] ?? data.groupSize}
            {data.maxGroupSize ? ` — max ${data.maxGroupSize} guests` : ''}
          </div>
        </div>
        <div class="at-a-glance__row">
          <div class="at-a-glance__label">Price band</div>
          <div class="at-a-glance__value">
            {budgetLabel[data.budgetBand] ?? data.budgetBand}
          </div>
        </div>
        {data.languages?.length > 0 && (
          <div class="at-a-glance__row">
            <div class="at-a-glance__label">Languages</div>
            <div class="at-a-glance__value">{data.languages.join(', ').toUpperCase()}</div>
          </div>
        )}
        {data.accessibility && (
          <div class="at-a-glance__row">
            <div class="at-a-glance__label">Accessibility</div>
            <div class="at-a-glance__value">{data.accessibility}</div>
          </div>
        )}
        {data.cancellationPolicy && (
          <div class="at-a-glance__row">
            <div class="at-a-glance__label">Cancellation</div>
            <div class="at-a-glance__value">{data.cancellationPolicy}</div>
          </div>
        )}
      </div>
    </div>
  </section>

  {primaryBookingUrl && (
    <div class="container">
      <div class="tour-cta-block">
        <h3 class="tour-cta-block__title">Check availability{operatorData?.name ? ` — ${operatorData.name}` : ''}</h3>
        <p>Pricing and availability are managed directly by the operator. Booking through the link below confirms your place directly with {operatorData?.name ?? 'the operator'}.</p>
        <a href={primaryBookingUrl} target="_blank" rel="noopener noreferrer" class="tour-cta-primary">
          Book this tour &rarr;
        </a>
        {data.aggregatorGYG && !data.bookingUrl && (
          <p style="font-size:0.8rem;margin-top:0.75rem;color:var(--body-light)">Booking via GetYourGuide. Prices shown include the aggregator booking fee.</p>
        )}
      </div>
    </div>
  )}

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="prose">
        <h2>What happens on this tour</h2>
        <p>{data.whatHappens}</p>
      </div>
    </div>
  </section>

  <section class="experience-index">
    <div class="container">
      <div class="prose">
        <h2>Who this suits</h2>
        <p>{data.whoSuits}</p>
        <h3>Who should look elsewhere</h3>
        <p>{data.whoDoesnt}</p>
      </div>
    </div>
  </section>

  {data.bookingIntelligence && (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="prose">
          <h2>Booking intelligence</h2>
          <p>{data.bookingIntelligence}</p>
        </div>
      </div>
    </section>
  )}

  {data.faq?.length > 0 && (
    <section class="faq-section">
      <div class="container">
        <div class="prose">
          <h2>Frequently asked questions</h2>
          {data.faq.map((item: { question: string; answer: string }) => (
            <div>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Related planning</p>
          <h2 class="venues__title">Build this into a longer trip</h2>
        </div>
      </div>
      <div class="venues__grid venues__grid--links">
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/tour-packages/">Tour packages</a></h3>
          <p class="venue-card__signature">We pair this and similar tours with an anchor stay to create complete Peninsula weekends. Browse multi-day packages built around operator-led experiences.</p>
          <a href="/tour-packages/" class="venue-card__cta">Browse packages &rarr;</a>
        </div>
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/stay/">Where to stay</a></h3>
          <p class="venue-card__signature">The right base changes the whole trip. Our stay guide covers the Peninsula's best properties by location, budget, and mood.</p>
          <a href="/stay/" class="venue-card__cta">Find a stay &rarr;</a>
        </div>
        {operatorData && (
          <div class="venue-card">
            <h3 class="venue-card__name"><a href={`/tour/operators/${data.operatorSlug}/`}>{operatorData.name}</a></h3>
            <p class="venue-card__signature">View all tours from this operator, including seasonal departures and private charter options.</p>
            <a href={`/tour/operators/${data.operatorSlug}/`} class="venue-card__cta">All {operatorData.name} tours &rarr;</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
