---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import TourCard from '../../components/TourCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const allTours = await getCollection('tours');
const allOperators = await getCollection('tourOperators');
const operatorMap = Object.fromEntries(allOperators.map(op => [op.data.slug, op.data]));

const privateTours = allTours.filter(t =>
  t.data.groupSize === 'private-charter' ||
  t.data.budgetBand === 'premium' ||
  t.data.budgetBand === 'luxury'
);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tours', href: '/tour/' },
  { label: 'Private Tours' },
];
---

<BaseLayout
  title="Private Tours Mornington Peninsula · Peninsula Insider"
  description="Private and bespoke guided tours on the Mornington Peninsula — custom itineraries, dedicated vehicles, and operators who adapt to your group."
  section="tour"
  canonical="https://peninsulainsider.com.au/tour/private-tours/"
  modifiedTime="2026-04-29"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow="Tours"
    category="Private &amp; Bespoke"
    title="Private Tours — Mornington Peninsula"
    heroImage="/images/sourced/spa-treatment-room-rose-01.webp"
    imageAlt="Private spa experience on the Mornington Peninsula — bespoke private tours"
    imageCaption="Mornington Peninsula"
  >
    <div class="prose">
      <p>Private tours give you a dedicated vehicle, a guide working only for your group, and an itinerary that you shape. The cost is higher than a small-group day, but if you fill the vehicle — typically four to eight guests — the per-person difference is often modest.</p>
      <p>The value of a private tour is control: you spend longer at the estates you like, skip the ones that don't interest you, and eat where you want. For corporate groups, milestone celebrations, or anyone who finds the pace of a shared bus frustrating, it is usually the right call.</p>
    </div>
  </SubpageHero>

  {privateTours.length > 0 ? (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Private and premium tours</p>
            <h2 class="venues__title">{privateTours.length} Peninsula private {privateTours.length === 1 ? 'tour' : 'tours'}</h2>
            <p class="venues__sub">Private charters and premium-band guided experiences.</p>
          </div>
        </div>
        <div class="tour-grid">
          {privateTours.map((tour) => (
            <TourCard tour={tour} operatorName={operatorMap[tour.data.operatorSlug]?.name} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="prose">
          <p>More private tour listings coming soon. <a href="/tour/">Browse all Peninsula tours</a> for available options.</p>
        </div>
      </div>
    </section>
  )}

  <section class="experience-index">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Related</p>
          <h2 class="venues__title">Plan the full trip</h2>
        </div>
      </div>
      <div class="venues__grid venues__grid--links">
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/tour-packages/">Tour packages</a></h3>
          <p class="venue-card__signature">Pair a private tour with an anchor stay recommendation. Our packages handle the combination so you just book.</p>
          <a href="/tour-packages/" class="venue-card__cta">Browse packages &rarr;</a>
        </div>
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/tour/operators/">All operators</a></h3>
          <p class="venue-card__signature">View all verified Peninsula tour operators, including those who specialise in premium private experiences.</p>
          <a href="/tour/operators/" class="venue-card__cta">Browse operators &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
