---
/**
 * /map/ - The Insider Map, v5 (page-redesigns-hubs.md section 9).
 *
 * The destination instance of the ONE MapView component: full-height map,
 * shared facet chip bar (FACET_OPTIONS cat + place), URL-persisted filter
 * state per the v5 filter contract, clustered self-hosted Leaflet pins, a
 * keyboard-navigable list panel as the accessible path, and a peek card
 * (Save, + Trip, View) replacing the old mouse-only Leaflet popups.
 *
 * Every coordinate-bearing venue, experience and place is serialised at
 * build time; facets come from getFacets() so a reader arriving from
 * /eat/?mood=long-lunch&place=red-hill sees the same result set here
 * (the state contract that ends the map-as-silo, spec block 20).
 *
 * Pin verdicts use the same editorial fields the cards read (signature /
 * editorNote / intro), trimmed to 25 words (spec block 14). No geolocation.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MapView, { type MapViewItem } from '../components/v5/MapView.astro';
import { getFacets } from '../lib/facets';
import { routeSlug, venueHref } from '../lib/editorial';

const venuesAll = await getCollection('venues');
const experiencesAll = await getCollection('experiences');
const placesAll = await getCollection('places');

const placeNameBySlug = new Map<string, string>(
  placesAll.map((p) => [p.id ?? p.data.slug, p.data.name]),
);

/** Pin colour group; grouping only, filtering uses the shared facets. */
function venueGroup(type: string): MapViewItem['group'] {
  if (['winery', 'brewery', 'distillery', 'producer'].includes(type)) return 'wine';
  if (['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'].includes(type)) return 'stay';
  return 'eat';
}

function typeLabel(type: string): string {
  const t = String(type || '').replace(/-/g, ' ');
  return t.charAt(0).toUpperCase() + t.slice(1);
}

/** Verdict line: same source field as the cards, capped at 25 words. */
function verdictLine(text: unknown): string {
  if (typeof text !== 'string' || !text.trim()) return '';
  const words = text.trim().split(/\s+/);
  return words.length <= 25 ? words.join(' ') : words.slice(0, 25).join(' ') + '…';
}

function placeRef(ref: unknown): string {
  if (typeof ref === 'string') return ref;
  if (ref && typeof ref === 'object' && typeof (ref as any).id === 'string') return (ref as any).id;
  return '';
}

const venueItems: MapViewItem[] = venuesAll
  .filter((v) => v.data.status !== 'permanently_closed')
  .filter((v) => v.data.coordinates && Number.isFinite(v.data.coordinates.lat))
  .map((v) => {
    const slug = routeSlug(v);
    const placeName = placeNameBySlug.get(placeRef(v.data.place)) ?? '';
    const priceBand = typeof v.data.priceBand === 'string' ? v.data.priceBand : '';
    return {
      id: `venue:${slug}`,
      kind: 'venue',
      slug,
      title: v.data.name,
      href: venueHref(v),
      lat: v.data.coordinates!.lat,
      lng: v.data.coordinates!.lng,
      verdict: verdictLine(v.data.signature),
      meta: [typeLabel(v.data.type), placeName, priceBand].filter(Boolean),
      group: venueGroup(v.data.type),
      facets: getFacets('venue', v.data),
    };
  });

const experienceItems: MapViewItem[] = experiencesAll
  .filter((e) => e.data.coordinates && Number.isFinite(e.data.coordinates.lat))
  .filter((e) => !e.data.sitemapExclude)
  .map((e) => {
    const slug = routeSlug(e);
    const placeName = placeNameBySlug.get(placeRef(e.data.place)) ?? '';
    return {
      id: `experience:${slug}`,
      kind: 'experience',
      slug,
      title: e.data.name,
      href: `/explore/${slug}/`,
      lat: e.data.coordinates!.lat,
      lng: e.data.coordinates!.lng,
      verdict: verdictLine(e.data.editorNote),
      meta: [typeLabel(e.data.type), placeName].filter(Boolean),
      group: 'do' as const,
      facets: getFacets('experience', e.data),
    };
  });

const placeItems: MapViewItem[] = placesAll
  .filter((p) => p.data.coordinates && Number.isFinite(p.data.coordinates.lat))
  .filter((p) => !p.data.sitemapExclude)
  .map((p) => {
    const slug = p.id ?? p.data.slug;
    return {
      id: `place:${slug}`,
      kind: 'place',
      slug,
      title: p.data.name,
      href: `/explore/places/${slug}/`,
      lat: p.data.coordinates!.lat,
      lng: p.data.coordinates!.lng,
      verdict: verdictLine(p.data.intro),
      meta: [typeLabel(p.data.kind)].filter(Boolean),
      group: 'place' as const,
      facets: getFacets('place', { slug }),
    };
  });

const allItems: MapViewItem[] = [...placeItems, ...venueItems, ...experienceItems];

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'The Insider Map' }];
export const prerender = true;
---

<BaseLayout
  title="The Insider Map · Peninsula Insider"
  description="The whole Mornington Peninsula on one map. Cellar doors, restaurants, stays, walks, beaches, towns - researched and editorially reviewed, all on one screen."
  section="map"
  canonical="https://peninsulainsider.com.au/map/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="v5-map-page">
    <div class="container">
      <header class="v5-map-page__intro">
        <h1 class="v5-map-page__title">The Insider Map</h1>
        <p class="v5-map-page__sub">Everything we cover, on one screen, filtered exactly like the list you came from.</p>
      </header>
    </div>

    <MapView items={allItems} standalone noun="pins" surface="map" label="The Insider Map" />
  </section>
</BaseLayout>

<style>
  .v5-map-page {
    padding-bottom: var(--space-6, 2rem);
  }
  .v5-map-page__intro {
    padding: var(--space-4, 1rem) 0 var(--space-3, 0.75rem);
  }
  .v5-map-page__title {
    margin: 0 0 0.25rem;
    font-family: var(--font-display, var(--font-display));
    font-size: var(--fs-800, clamp(2.125rem, 1.5rem + 2.8vw, 3rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.2);
    color: var(--text);
  }
  .v5-map-page__sub {
    margin: 0;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-400, 1.0625rem);
    color: var(--soft);
    max-width: var(--measure-dek, 52ch);
  }
</style>
