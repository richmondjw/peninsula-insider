---
/* /quick-note/[slug]/ → /notebook/[slug]/ redirect.
   Canonical URLs moved to /notebook/ May 2026. */
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('quickNotes', ({ data }) => data.status === 'published');
  return notes.map((note) => ({
    params: { slug: note.id.replace(/\.md$/, '') },
    props: { slug: note.id.replace(/\.md$/, '') },
  }));
}

const { slug } = Astro.props;
const notebookUrl = `/notebook/${slug}/`;
---
<meta http-equiv="refresh" content={`0;url=${notebookUrl}`} />
<link rel="canonical" href={`https://peninsulainsider.com.au${notebookUrl}`} />
<script define:vars={{ notebookUrl }}>window.location.replace(notebookUrl);</script>
<p>Redirecting to <a href={notebookUrl}>The Notebook</a>…</p>
