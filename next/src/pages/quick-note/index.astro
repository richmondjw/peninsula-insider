---
/* /quick-note/, daily-cadence editorial briefs.
   2026-11-10 (Phase 5 "say it once"): one column under the date.
   - Briefs from the last 24 hours: the newest leads, the rest are grouped
     by section. Older briefs still inside their window follow as
     "Earlier this week". Briefs auto-archive after expiresAt.
   - When nothing is live, the page says so in one line and offers the
     newest Journal stories already published on the site, plus one next
     step, instead of dead-ending. Nothing is invented: every item listed
     is an existing published note or article. */

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { routeSlug } from '../../lib/editorial';
import { isJournalDiscovery } from '../../lib/journal-curation.mjs';

const all = await getCollection('quickNotes', ({ data }) => data.status === 'published');
const now = new Date();
const TZ = 'Australia/Melbourne';
const live = all.filter((n) => n.data.expiresAt > now);

// Sort by published date, newest first
live.sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const HOUR = 60 * 60 * 1000;
const dayAgo = new Date(now.getTime() - 24 * HOUR);

const recent = live.filter((n) => n.data.publishedAt >= dayAgo);
const tierWeek = live.filter((n) => n.data.publishedAt < dayAgo);
const [lead, ...rest] = recent;

const SECTION_LABEL: Record<string, string> = {
  eat: 'Eat & Drink',
  stay: 'Stay',
  wine: 'Wine Country',
  explore: 'Explore',
  spa: 'Spa & Wellness',
  golf: 'Golf',
  'whats-on': "What's On",
  weather: 'Weather',
  note: 'Editor',
};

const TAG_LABEL: Record<string, string> = {
  'opening-window': 'Booking window',
  'menu-change': 'Menu',
  'closure': 'Closure',
  'event': 'Event',
  'weather': 'Weather',
  'editor-note': 'Editor',
  'pricing': 'Pricing',
  'safety': 'Safety',
};

function relTime(d: Date): string {
  const diff = now.getTime() - d.getTime();
  if (diff < 60 * 1000) return 'just now';
  if (diff < 60 * 60 * 1000) return `${Math.floor(diff / 60000)}m ago`;
  if (diff < 24 * 60 * 60 * 1000) return `${Math.floor(diff / 3600000)}h ago`;
  if (diff < 7 * 24 * 60 * 60 * 1000) return `${Math.floor(diff / 86400000)}d ago`;
  return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
}

const dateline = now.toLocaleDateString('en-AU', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: TZ,
});

// Group the rest of the last 24 hours by section.
const sections = ['note', 'weather', 'eat', 'wine', 'stay', 'explore', 'spa', 'whats-on'];
const restBySection: Record<string, typeof live> = {};
rest.forEach((n) => {
  const s = n.data.section;
  if (!restBySection[s]) restBySection[s] = [];
  restBySection[s].push(n);
});
const otherSections = Object.keys(restBySection).filter((s) => !sections.includes(s));

// Quiet-desk fallback: the newest published Journal stories.
const latestStories = live.length > 0 ? [] : (await getCollection('articles', ({ data }) => isJournalDiscovery(data)))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

function noteHref(n: any): string {
  return `/quick-note/${n.id.replace(/\.md$/, '')}/`;
}
export const prerender = true;
---

<BaseLayout
  title={`Quick Note, ${dateline} · Peninsula Insider`}
  description="Daily Peninsula briefs: openings, menu changes, booking windows, weather, and one editor's note. Refreshed every morning."
  section="home"
  ogType="website"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Quick Note' }]} />

  <div class="qn">
    <header class="qn__head">
      <div class="container">
        <p class="qn__eyebrow">Quick Note</p>
        <h1 class="qn__dateline">{dateline}</h1>
        <p class="qn__sub">Short daily briefs on openings, menu changes, booking windows and weather. Each one archives after seven days.</p>
      </div>
    </header>

    <div class="container qn__body">
      {lead && (
        <a href={noteHref(lead)} class="qn__brief qn__brief--lead">
          {lead.data.image?.src && (
            <div class="qn__brief-image" role="img" aria-label={lead.data.image.alt ?? ''} style={`background-image: url(${lead.data.image.src})`}></div>
          )}
          <div class="qn__brief-meta">
            <span class="qn__brief-section">{SECTION_LABEL[lead.data.section] ?? lead.data.section}</span>
            <span class="qn__brief-tag">{TAG_LABEL[lead.data.tag] ?? lead.data.tag}</span>
            <time class="qn__brief-time" datetime={lead.data.publishedAt.toISOString()}>{relTime(lead.data.publishedAt)}</time>
          </div>
          <h2 class="qn__brief-headline">{lead.data.headline}</h2>
          {lead.data.dek && <p class="qn__brief-dek">{lead.data.dek}</p>}
          {lead.data.verdict && <p class="qn__brief-verdict">{lead.data.verdict}</p>}
          {lead.data.verifiedBy && (
            <p class="qn__brief-byline">Verified {relTime(lead.data.verifiedAt ?? lead.data.publishedAt)} by {lead.data.verifiedBy}</p>
          )}
        </a>
      )}

      {[...sections, ...otherSections].filter((s) => restBySection[s]?.length).map((s) => (
        <section class="qn__sect" aria-label={SECTION_LABEL[s] ?? s}>
          <p class="qn__sect-label">{SECTION_LABEL[s] ?? s}</p>
          <div class="qn__sect-grid">
            {restBySection[s].map((n) => (
              <a href={noteHref(n)} class="qn__brief qn__brief--row">
                <div class="qn__brief-meta">
                  <span class="qn__brief-tag">{TAG_LABEL[n.data.tag] ?? n.data.tag}</span>
                  <time class="qn__brief-time" datetime={n.data.publishedAt.toISOString()}>{relTime(n.data.publishedAt)}</time>
                </div>
                <h2 class="qn__brief-headline">{n.data.headline}</h2>
                {n.data.dek && <p class="qn__brief-dek">{n.data.dek}</p>}
                {n.data.verdict && <p class="qn__brief-verdict">{n.data.verdict}</p>}
              </a>
            ))}
          </div>
        </section>
      ))}

      {tierWeek.length > 0 && (
        <section class="qn__week" aria-labelledby="qn-week-title">
          <h2 class="qn__band-title" id="qn-week-title">Earlier this week</h2>
          <ul class="qn__week-list" role="list">
            {tierWeek.map((n) => (
              <li>
                <a href={noteHref(n)} class="qn__brief qn__brief--row">
                  <div class="qn__brief-meta">
                    <span class="qn__brief-section">{SECTION_LABEL[n.data.section] ?? n.data.section}</span>
                    <time class="qn__brief-time" datetime={n.data.publishedAt.toISOString()}>{relTime(n.data.publishedAt)}</time>
                  </div>
                  <h3 class="qn__brief-headline">{n.data.headline}</h3>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {live.length === 0 && (
        <section class="qn__empty" aria-labelledby="qn-empty-title">
          <h2 class="qn__empty-title" id="qn-empty-title">No new notes yet this morning.</h2>
          {latestStories.length > 0 && (
            <>
              <p class="qn__empty-copy">While the desk is quiet, here is the latest from the Journal.</p>
              <ul class="qn__week-list" role="list">
                {latestStories.map((a) => (
                  <li>
                    <a href={`/journal/${routeSlug(a)}/`} class="qn__brief qn__brief--row">
                      <div class="qn__brief-meta">
                        <span class="qn__brief-section">Journal</span>
                        <time class="qn__brief-time" datetime={a.data.publishedAt.toISOString()}>{a.data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric', timeZone: TZ })}</time>
                      </div>
                      <h3 class="qn__brief-headline">{a.data.title}</h3>
                      {a.data.dek && <p class="qn__brief-dek">{a.data.dek}</p>}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
          <p class="qn__next"><a class="pi-btn pi-btn--solid" href="/journal/">Read the Journal</a></p>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .qn { background: var(--bg); padding-bottom: clamp(3rem, 6vw, 5rem); }

  .qn__head { padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(1.5rem, 3vw, 2.5rem); }
  .qn__eyebrow {
    display: inline-block;
    font-size: var(--fs-100);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow, .1em);
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.7rem;
  }
  .qn__dateline {
    font-family: var(--font-display);
    font-size: var(--fs-800);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--dark);
    margin: 0 0 0.8rem;
    text-wrap: balance;
  }
  .qn__sub {
    max-width: 56ch;
    font-size: var(--fs-400);
    line-height: 1.55;
    color: var(--soft);
    margin: 0;
  }

  /* One reading column on the same left edge as the date. */
  .qn__body > * { max-width: 48rem; }

  .qn__band-title {
    font-family: var(--font-display);
    font-size: var(--fs-600);
    font-weight: 500;
    margin: 0 0 1rem;
    color: var(--dark);
    letter-spacing: -0.018em;
  }

  /* Lead brief: the newest note, no box. */
  .qn__brief--lead { padding-bottom: 2rem; }
  .qn__brief--lead .qn__brief-headline { font-size: var(--fs-700); line-height: 1.12; }
  .qn__brief-image {
    aspect-ratio: 16 / 9;
    margin-bottom: 1.2rem;
    border-radius: var(--radius-m);
    background-size: cover;
    background-position: center;
    background-color: var(--bg-alt);
  }

  .qn__sect { padding: 1.2rem 0; }
  .qn__sect-label {
    font-size: var(--fs-100);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow, .1em);
    text-transform: uppercase;
    color: var(--soft);
    margin: 0 0 0.6rem;
  }
  .qn__sect-grid { display: grid; gap: 1.2rem; }

  .qn__week { padding-top: 2.5rem; }
  .qn__week-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; }

  .qn__empty { padding-top: 0.5rem; }
  .qn__empty-title {
    font-family: var(--font-display);
    font-size: var(--fs-600);
    font-weight: 500;
    color: var(--dark);
    margin: 0 0 0.4rem;
  }
  .qn__empty-copy {
    font-size: var(--fs-400);
    color: var(--soft);
    line-height: 1.55;
    margin: 0 0 1.6rem;
  }
  .qn__next { margin: 2rem 0 0; }

  /* Brief, base */
  .qn__brief {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .qn__brief:hover .qn__brief-headline { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .15em; }
  .qn__brief:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }

  .qn__brief-meta {
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.8rem;
    font-size: var(--fs-200);
    margin: 0 0 0.4rem;
    align-items: baseline;
    color: var(--soft);
  }
  .qn__brief-section { font-weight: 600; color: var(--soft); }
  .qn__brief-tag { color: var(--soft); }
  .qn__brief-time { color: var(--soft); font-variant-numeric: tabular-nums; }
  .qn__brief-headline {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 0.4rem;
    color: var(--dark);
    font-size: var(--fs-500);
  }
  .qn__brief-dek {
    font-size: var(--fs-300);
    line-height: 1.55;
    color: var(--soft);
    margin: 0 0 0.4rem;
  }
  .qn__brief-verdict {
    font-size: var(--fs-300);
    line-height: 1.45;
    color: var(--text);
    margin: 0 0 0.4rem;
  }
  .qn__brief-byline { font-size: var(--fs-200); color: var(--soft); margin: 0; }
</style>
