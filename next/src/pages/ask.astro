---
/**
 * /ask — Peninsula Insider Concierge
 * "PI's Notebook": editorial chat with dropcap prose, postcard tiles,
 * filed-under tags. Designed as a magazine column, not a chatbot.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const API_URL = import.meta.env.PUBLIC_CONCIERGE_API_URL || 'http://localhost:8787';
export const prerender = true;
---

<BaseLayout
  title="Ask The Insider — Your Peninsula Concierge"
  description="Ask Peninsula Insider anything about the Mornington Peninsula. Cellar doors, dining, stays, rainy days, dog-friendly spots. Local knowledge, editorial taste."
>

  <main class="ask-page">

    <!-- Hero -->
    <section class="ask-hero">
      <div class="ask-hero__inner">
        <div class="ask-hero__avatar" aria-hidden="true">
          <span class="pi-avatar pi-avatar--xl">
            <span class="pi-avatar__fallback">PI</span>
            <img src="/images/pi-concierge.svg" alt="" onerror="this.remove()" />
          </span>
        </div>
        <p class="ask-hero__eyebrow">Peninsula Insider · Field notes</p>
        <h1 class="ask-hero__heading">Ask <em>The Insider</em></h1>
        <p class="ask-hero__sub">
          The local who's been everywhere on the Peninsula and has opinions about all of it. Tell me what you're after.
        </p>
      </div>
    </section>

    <!-- Chat dialog: PI's open notebook -->
    <section class="ask-chat-section">
      <div class="ask-dialog" role="region" aria-label="Conversation with PI">

        <!-- Notebook header -->
        <div class="ask-dialog__header">
          <div class="ask-dialog__id">
            <span class="pi-avatar pi-avatar--md" aria-hidden="true">
              <span class="pi-avatar__fallback">PI</span>
              <img src="/images/pi-concierge.svg" alt="" onerror="this.remove()" />
            </span>
            <div class="ask-dialog__id-text">
              <p class="ask-dialog__name">The Insider <span class="ask-dialog__name-mark" aria-hidden="true">✦</span></p>
              <p class="ask-dialog__status">
                <span class="ask-dialog__pulse" aria-hidden="true"></span>
                Local · usually responds in seconds
              </p>
            </div>
          </div>
          <button type="button" class="ask-dialog__reset" id="ask-reset" aria-label="Start over" hidden>
            New chat
          </button>
        </div>

        <!-- Notebook body — paper grain, editorial column width -->
        <!-- data-lenis-prevent: keep native scroll inside the chat (Lenis runs page-level) -->
        <div class="ask-dialog__body" id="ask-thread" aria-live="polite" data-lenis-prevent>

          <!-- Greeting -->
          <article class="ask-msg ask-msg--pi">
            <div class="ask-msg__byline">
              <span class="pi-avatar pi-avatar--sm" aria-hidden="true">
                <span class="pi-avatar__fallback">PI</span>
                <img src="/images/pi-concierge.svg" alt="" onerror="this.remove()" />
              </span>
              <span class="ask-msg__byline-name">The Insider</span>
              <span class="ask-msg__byline-rule" aria-hidden="true"></span>
            </div>
            <div class="ask-msg__prose ask-msg__prose--greeting">
              <p>Tell me what you're after. A long lunch, a hatted dinner, a dog-friendly café, a rainy Sunday with kids. The more specific you are, the sharper my answer.</p>
            </div>
            <div class="ask-msg__followup" id="ask-suggestions-wrap">
              <p class="ask-msg__followup-label">
                <span>Try one of these</span>
              </p>
              <div class="ask-msg__chips" id="ask-suggestions">
                <button class="pi-chip" data-query="Quiet wineries open this weekend">
                  <span class="pi-chip__bullet" aria-hidden="true">♦</span>
                  <span>Quiet wineries this weekend</span>
                </button>
                <button class="pi-chip" data-query="Rainy day long lunch on the Peninsula">
                  <span class="pi-chip__bullet" aria-hidden="true">♦</span>
                  <span>Rainy-day long lunch</span>
                </button>
                <button class="pi-chip" data-query="One-night winter escape from Melbourne">
                  <span class="pi-chip__bullet" aria-hidden="true">♦</span>
                  <span>One-night winter escape</span>
                </button>
                <button class="pi-chip" data-query="Midweek Peninsula itinerary, two days">
                  <span class="pi-chip__bullet" aria-hidden="true">♦</span>
                  <span>Midweek Peninsula itinerary</span>
                </button>
                <button class="pi-chip" data-query="Dog-friendly beaches near Sorrento">
                  <span class="pi-chip__bullet" aria-hidden="true">♦</span>
                  <span>Dog-friendly beaches near Sorrento</span>
                </button>
                <button class="pi-chip" data-query="Best cellar door lunch near Red Hill">
                  <span class="pi-chip__bullet" aria-hidden="true">♦</span>
                  <span>Cellar door lunch, Red Hill</span>
                </button>
              </div>
            </div>
          </article>

        </div>

        <!-- Composer -->
        <form class="ask-dialog__composer" id="ask-form" autocomplete="off">
          <textarea
            id="ask-input"
            class="ask-composer__input"
            placeholder="Ask The Insider…"
            rows="1"
            maxlength="500"
            aria-label="Your question"
          ></textarea>
          <a
            href="/contact/"
            class="ask-composer__contact"
            target="_blank"
            rel="noopener"
            aria-label="Get in touch with the Peninsula Insider editors"
            title="Get in touch with a human editor"
          >
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="2.5" y="4.5" width="15" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 5l7 5.5L17 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <button type="submit" class="ask-composer__send" id="ask-send" aria-label="Send message">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M2 10L18 2L12 18L10 11L2 10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>

        <p class="ask-dialog__disclaimer">
          The Insider works from Peninsula Insider editorial research. Verify hours and bookings before you go.
        </p>

      </div>
    </section>

  </main>

</BaseLayout>


<script define:vars={{ API_URL }}>
  const form = document.getElementById('ask-form');
  const input = document.getElementById('ask-input');
  const sendBtn = document.getElementById('ask-send');
  const thread = document.getElementById('ask-thread');
  const greetingWrap = document.getElementById('ask-suggestions-wrap');
  const resetBtn = document.getElementById('ask-reset');

  const sessionId = `pi-${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
  let askInFlight = false;

  // ---------- Helpers ----------
  const escapeHtml = (s) => String(s ?? '')
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

  const titleCase = (s) => String(s ?? '').replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());

  const VENUE_TYPE_LABEL = {
    restaurant: 'Restaurant', winery: 'Cellar Door', cafe: 'Café',
    bakery: 'Bakery', pub: 'Pub', brewery: 'Brewery',
    distillery: 'Distillery', producer: 'Producer', market: 'Market',
    accommodation: 'Stay', hotel: 'Hotel', spa: 'Spa',
    experience: 'Experience',
  };

  // Avatar markup with graceful fallback. Explicit width/height attrs
  // prevent the SVG rendering at its intrinsic (huge) size before CSS lands.
  const AVATAR_PX = { xl: 96, md: 42, sm: 22 };
  function avatarMarkup(size) {
    const px = AVATAR_PX[size] || 22;
    return `
      <span class="pi-avatar pi-avatar--${size}" aria-hidden="true">
        <span class="pi-avatar__fallback">PI</span>
        <img src="/images/pi-concierge.svg" alt="" width="${px}" height="${px}" onerror="this.remove()" />
      </span>
    `;
  }

  // ---------- Composer behaviour ----------
  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 130) + 'px';
  }
  input.addEventListener('input', autoGrow);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  // ---------- Render ----------
  function appendUserMessage(text) {
    const el = document.createElement('article');
    el.className = 'ask-msg ask-msg--user';
    el.innerHTML = `
      <div class="ask-msg__meta">You</div>
      <div class="ask-msg__bubble">${escapeHtml(text)}</div>
    `;
    thread.appendChild(el);
    scrollToBottom();
  }

  function appendTyping() {
    const el = document.createElement('article');
    el.className = 'ask-msg ask-msg--pi ask-msg--typing';
    el.id = 'ask-typing-indicator';
    el.innerHTML = `
      <div class="ask-msg__byline">
        ${avatarMarkup('sm')}
        <span class="ask-msg__byline-name">The Insider is writing</span>
        <span class="ask-msg__byline-rule"></span>
      </div>
      <div class="ask-msg__prose">
        <div class="ask-typing"><span></span><span></span><span></span></div>
      </div>
    `;
    thread.appendChild(el);
    scrollToBottom();
  }

  function removeTyping() {
    const el = document.getElementById('ask-typing-indicator');
    if (el) el.remove();
  }

  function appendPiMessage(data) {
    const el = document.createElement('article');
    el.className = 'ask-msg ask-msg--pi';

    // Split answer into paragraphs (LLM should produce 2-3)
    const paragraphs = String(data.answer || '').split(/\n\s*\n+/).filter(Boolean);
    const paragraphsHtml = paragraphs.map((p) => `<p>${escapeHtml(p)}</p>`).join('');

    // Recommendation rail
    let railHtml = '';
    if (Array.isArray(data.recommendations) && data.recommendations.length > 0) {
      const tiles = data.recommendations.map((rec, i) => renderTile(rec, i + 1, i)).join('');
      railHtml = `
        <div class="ask-rail" role="list" aria-label="Peninsula Insider recommendations">
          ${tiles}
        </div>
      `;
    }

    // Follow-on filed-under tags
    let followupHtml = '';
    if (Array.isArray(data.follow_on) && data.follow_on.length > 0) {
      const chips = data.follow_on.map((q) => `
        <button class="pi-chip" data-query="${escapeHtml(q)}">
          <span class="pi-chip__bullet" aria-hidden="true">♦</span>
          <span>${escapeHtml(q)}</span>
        </button>
      `).join('');
      followupHtml = `
        <div class="ask-msg__followup">
          <p class="ask-msg__followup-label"><span>More from The Insider's notebook</span></p>
          <div class="ask-msg__chips">${chips}</div>
        </div>
      `;
    }

    el.innerHTML = `
      <div class="ask-msg__byline">
        ${avatarMarkup('sm')}
        <span class="ask-msg__byline-name">The Insider</span>
        <span class="ask-msg__byline-rule"></span>
      </div>
      <div class="ask-msg__prose">${paragraphsHtml}</div>
      ${railHtml}
      ${followupHtml}
    `;
    thread.appendChild(el);
    // Land the reader at the TOP of PI's response, not the bottom (chips/recs).
    scrollMsgToTop(el);
  }

  function renderTile(rec, rank, idx) {
    const heroSrc = rec.hero_image ? escapeHtml(rec.hero_image) : null;
    const heroStyle = heroSrc ? `background-image: url('${heroSrc}')` : '';
    const heroClass = heroSrc ? 'ask-tile__hero' : 'ask-tile__hero ask-tile__hero--placeholder';
    const priceHtml = rec.price_band ? `<span class="ask-tile__price">${escapeHtml(rec.price_band)}</span>` : '';
    const typeLabel = VENUE_TYPE_LABEL[rec.venue_type] || titleCase(rec.venue_type || rec.category || 'Pick');
    const region = rec.region ? titleCase(rec.region) : '';
    const href = escapeHtml(rec.href || rec.slug || '#');
    const why = escapeHtml(rec.why || '');
    const signature = rec.signature ? escapeHtml(rec.signature) : '';

    return `
      <a href="${href}" class="ask-tile" role="listitem" style="--idx:${idx};">
        <div class="${heroClass}" style="${heroStyle}" aria-hidden="true">
          <span class="ask-tile__rank">${rank}</span>
          ${priceHtml}
        </div>
        <div class="ask-tile__body">
          <div class="ask-tile__top">
            <span class="ask-tile__type">${escapeHtml(typeLabel)}</span>
            ${region ? `<span class="ask-tile__region">${escapeHtml(region)}</span>` : ''}
          </div>
          <h3 class="ask-tile__name">${escapeHtml(rec.title || 'Untitled')}</h3>
          ${why ? `<p class="ask-tile__why">${why}</p>` : ''}
          ${signature ? `<p class="ask-tile__signature">${signature}</p>` : ''}
          <span class="ask-tile__cta">
            <span>Read PI's notes</span>
            <span class="ask-tile__cta-arrow" aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    `;
  }

  function appendErrorMessage(message) {
    const el = document.createElement('article');
    el.className = 'ask-msg ask-msg--pi ask-msg--error';
    el.innerHTML = `
      <div class="ask-msg__byline">
        ${avatarMarkup('sm')}
        <span class="ask-msg__byline-name">The Insider</span>
        <span class="ask-msg__byline-rule"></span>
      </div>
      <div class="ask-msg__prose">
        <p>${escapeHtml(message)}</p>
      </div>
    `;
    thread.appendChild(el);
    scrollMsgToTop(el);
  }

  function scrollToBottom() {
    requestAnimationFrame(() => {
      thread.scrollTop = thread.scrollHeight;
    });
  }

  /**
   * Scroll a newly-added message so its TOP sits at the top of the visible
   * chat area. Used for PI responses so long answers read top-to-bottom
   * naturally instead of dropping the user at the chips/recs at the bottom.
   */
  function scrollMsgToTop(messageEl) {
    if (!messageEl) return;
    requestAnimationFrame(() => {
      const threadRect = thread.getBoundingClientRect();
      const msgRect = messageEl.getBoundingClientRect();
      const target = msgRect.top - threadRect.top + thread.scrollTop - 12;
      thread.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
    });
  }

  // ---------- Streaming SSE parser ----------
  // Parses an SSE response one event at a time. Yields { event, data } pairs.
  // Tolerates partial chunks across network reads.
  async function* parseSSE(response) {
    if (!response.body) throw new Error('No response body');
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buf = '';
    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        let idx;
        while ((idx = buf.indexOf('\n\n')) !== -1) {
          const block = buf.slice(0, idx);
          buf = buf.slice(idx + 2);
          if (!block.trim()) continue;
          let evt = 'message';
          let dataStr = '';
          for (const line of block.split('\n')) {
            if (line.startsWith('event: ')) evt = line.slice(7).trim();
            else if (line.startsWith('data: ')) dataStr += line.slice(6);
          }
          if (!dataStr) continue;
          let payload;
          try { payload = JSON.parse(dataStr); }
          catch { continue; }
          yield { event: evt, data: payload };
        }
      }
    } finally {
      try { reader.releaseLock(); } catch {}
    }
  }

  // Replace the typing indicator with a streaming PI message and return the
  // <p> we'll append text deltas into. The post-stream meta event will swap
  // this for the final tile rail + chips.
  function startStreamingPiMessage() {
    removeTyping();
    const el = document.createElement('article');
    el.className = 'ask-msg ask-msg--pi ask-msg--streaming';
    el.id = 'ask-streaming-message';
    el.innerHTML = `
      <div class="ask-msg__byline">
        ${avatarMarkup('sm')}
        <span class="ask-msg__byline-name">The Insider</span>
        <span class="ask-msg__byline-rule"></span>
      </div>
      <div class="ask-msg__prose ask-msg__prose--streaming">
        <p class="ask-stream-prose"></p>
      </div>
    `;
    thread.appendChild(el);
    scrollMsgToTop(el);
    return el.querySelector('.ask-stream-prose');
  }

  function finaliseStreamingMessage(composite) {
    const streaming = document.getElementById('ask-streaming-message');
    if (streaming) streaming.remove();
    appendPiMessage(composite);
  }

  // ---------- Submit ----------
  async function ask(query) {
    if (!query || query.length < 3 || askInFlight) return;
    askInFlight = true;

    if (greetingWrap) greetingWrap.style.display = 'none';
    resetBtn.hidden = false;

    appendUserMessage(query);
    input.value = '';
    autoGrow();
    sendBtn.disabled = true;
    appendTyping();

    let accumulatedText = '';
    let metaPayload = null;
    let proseEl = null;
    let streamErrored = false;

    try {
      const res = await fetch(`${API_URL}/concierge/ask/stream`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'text/event-stream',
          'X-Session-Id': sessionId,
        },
        body: JSON.stringify({ query }),
      });

      if (!res.ok) {
        let msg = 'Something went wrong. Try again in a moment.';
        try {
          const ct = res.headers.get('content-type') || '';
          if (ct.includes('application/json')) {
            const errJson = await res.json();
            if (errJson && errJson.error) msg = errJson.error;
          }
        } catch {}
        removeTyping();
        appendErrorMessage(msg);
        return;
      }

      for await (const { event, data } of parseSSE(res)) {
        if (event === 'text' && data && typeof data.delta === 'string') {
          if (!proseEl) proseEl = startStreamingPiMessage();
          accumulatedText += data.delta;
          proseEl.textContent = accumulatedText;
        } else if (event === 'meta' && data) {
          metaPayload = data;
        } else if (event === 'error') {
          streamErrored = true;
          removeTyping();
          const streaming = document.getElementById('ask-streaming-message');
          if (streaming) streaming.remove();
          appendErrorMessage((data && data.message) || 'Something went wrong mid-response.');
          break;
        } else if (event === 'done') {
          break;
        }
        // 'ack' is informational; no UI effect.
      }

      if (!streamErrored) {
        const composite = {
          answer: accumulatedText,
          recommendations: (metaPayload && metaPayload.recommendations) || [],
          follow_on: (metaPayload && metaPayload.follow_on) || [],
          provenance_footer: (metaPayload && metaPayload.provenance_footer) || '',
        };
        finaliseStreamingMessage(composite);
      }
    } catch (err) {
      removeTyping();
      const streaming = document.getElementById('ask-streaming-message');
      if (streaming) streaming.remove();
      appendErrorMessage("I couldn't reach the server. Mind trying that again?");
    } finally {
      askInFlight = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    ask(input.value.trim());
  });

  // Auto-fire if the URL has a `?q=…` (used as a fallback path from CTA links)
  (function() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q && q.length >= 3) {
      input.value = q;
      autoGrow();
      ask(q);
    }
  })();

  // Delegated chip clicks (handles greeting + follow-on chips)
  document.addEventListener('click', (e) => {
    const chip = e.target.closest('.pi-chip');
    if (!chip) return;
    const q = chip.dataset.query;
    if (q) {
      input.value = q;
      ask(q);
    }
  });

  // Reset
  resetBtn.addEventListener('click', () => {
    const greeting = thread.querySelector('.ask-msg');
    thread.innerHTML = '';
    if (greeting) thread.appendChild(greeting);
    if (greetingWrap) greetingWrap.style.display = '';
    resetBtn.hidden = true;
    input.value = '';
    input.focus();
  });
</script>
