---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ASK_GUIDE_ON } from '../lib/features';
export const prerender = true;
---

{ASK_GUIDE_ON ? (
<BaseLayout
  title="Ask PI"
  description="Ask PI where to eat, stay or walk on the Mornington Peninsula, or what is on. She answers from Peninsula Insider's published guides."
>
  {/* The chat docks beside this page on arrival (PiChat.astro). Its column is
      reserved before first paint, on the same two conditions the chat itself
      uses, so the page does not jump sideways when the chat script runs. */}
  <script slot="head" is:inline>
    try {
      if (window.matchMedia('(min-width: 80em)').matches && localStorage.getItem('pi-chat-mode') !== 'float') {
        document.documentElement.classList.add('pi-chat-docked');
      }
    } catch (e) { /* storage blocked: the chat script decides */ }
  </script>
  <main class="ask-page container">
    <header class="ask-page__head">
      <h1>Ask PI</h1>
      <p class="ask-page__dek">Tell her who’s coming and what you’re in the mood for. She’ll make the call from our published guides, and put a day in order if you want one.</p>
    </header>
    <section class="ask-page__panel" aria-label="Ask PI">
      <p class="ask-page__open"><a class="pi-btn pi-btn--solid" href="/ask/">Talk to PI</a></p>
      <noscript>
        <p class="ask-page__plain">PI’s chat needs JavaScript. You can still search the guides.</p>
        <form class="ask-page__form" action="/search/" method="get" role="search" aria-label="Search Peninsula Insider" data-ask-guide-form>
          <label for="ask-page-q">What are you looking for?</label>
          <div class="ask-page__field">
            <input id="ask-page-q" name="q" type="search" maxlength="500" autocomplete="off" enterkeyhint="search" />
            <button class="pi-btn pi-btn--solid" type="submit">Search</button>
          </div>
        </form>
      </noscript>
    </section>
    <nav class="ask-page__browse" aria-label="Browse Peninsula Insider">
      <h2>Or browse the guides</h2>
      <ul role="list">
        <li><a href="/eat/">Eat &amp; Drink</a></li>
        <li><a href="/stay/">Stay</a></li>
        <li><a href="/wine/">Wine</a></li>
        <li><a href="/explore/">Explore</a></li>
        <li><a href="/explore/plans/">Plans</a></li>
        <li><a href="/whats-on/">What's On</a></li>
      </ul>
    </nav>
  </main>
</BaseLayout>
) : (

<BaseLayout
  title="Ask PI is being improved"
  description="Ask PI is temporarily paused while Peninsula Insider improves how every recommendation is sourced. Search the site for places, plans and stories."
>
  <main class="ask-safe container">
    <header class="ask-safe__head">
      <p class="ask-safe__status">Temporarily paused</p>
      <h1>Ask PI is being improved.</h1>
      <p class="ask-safe__dek">We paused generated recommendations while we strengthen how every detail is checked and linked to our editorial sources.</p>
    </header>

    <section class="ask-safe__search" aria-labelledby="ask-safe-search-title">
      <h2 id="ask-safe-search-title">Find it in Peninsula Insider</h2>
      <p>Search our published places, plans and stories. Your question stays in the field so you can refine it.</p>
      <form action="/search/" method="get" role="search" aria-label="Search Peninsula Insider">
        <label for="ask-safe-q">What are you looking for?</label>
        <div class="ask-safe__field">
          <input id="ask-safe-q" name="q" type="search" maxlength="500" autocomplete="off" enterkeyhint="search" placeholder="Red Hill lunch, coastal walk or rainy day" />
          <button class="pi-btn pi-btn--solid" type="submit">Search</button>
        </div>
      </form>
    </section>

    <nav class="ask-safe__browse" aria-label="Browse Peninsula Insider">
      <h2>Or browse by what you need</h2>
      <ul role="list">
        <li><a href="/eat/">Eat &amp; Drink <span aria-hidden="true">→</span></a></li>
        <li><a href="/stay/">Stay <span aria-hidden="true">→</span></a></li>
        <li><a href="/wine/">Wine <span aria-hidden="true">→</span></a></li>
        <li><a href="/explore/">Explore <span aria-hidden="true">→</span></a></li>
        <li><a href="/explore/plans/">Plans <span aria-hidden="true">→</span></a></li>
        <li><a href="/whats-on/">What's On <span aria-hidden="true">→</span></a></li>
      </ul>
    </nav>

    <p class="ask-safe__note">Ask PI will return only when recommendation details can be traced to current editorial evidence. Until then, search and the published guides are the reliable path.</p>
  </main>
</BaseLayout>
)}

<script>
  // This route is prerendered, so a visitor's query is only available in the browser.
  const initialized = new WeakSet<HTMLInputElement>();
  function prefillAskSearch() {
    const input = document.querySelector<HTMLInputElement>('#ask-safe-q');
    if (!input || initialized.has(input)) return;
    initialized.add(input);
    if (input.value) return;
    const query = new URLSearchParams(location.search).get('q')?.trim() ?? '';
    input.value = query.slice(0, input.maxLength);
  }
  prefillAskSearch();
  document.addEventListener('astro:page-load', prefillAskSearch);
</script>

<style>
  .ask-page { max-width: 46rem; padding-block: var(--space-8) var(--space-9); }
  .ask-page h1 { max-width: none; }
  .ask-page__dek { margin: var(--space-3) 0 0; max-width: 58ch; color: var(--soft); font: 400 var(--fs-500)/var(--lh-body) var(--font-ui); text-wrap: pretty; }
  .ask-page__panel { margin-top: var(--space-6); }
  .ask-page__open { margin: 0; }
  .ask-page__plain { margin: var(--space-5) 0 var(--space-3); color: var(--soft); font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); }
  .ask-page__field { display: flex; gap: var(--space-3); }
  .ask-page__browse { margin-top: var(--space-8); }
  .ask-page__browse ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin: var(--space-3) 0 0; padding: 0; list-style: none; }
  .ask-page__browse a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); font: 600 var(--fs-400)/var(--lh-ui) var(--font-ui); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 47.99em) { .ask-page { padding-block: var(--space-6) var(--space-8); } }
  .ask-safe { max-width: 58rem; padding-block: var(--space-8) var(--space-9); }
  .ask-safe__head { max-width: var(--measure-prose); }
  .ask-safe__status { margin: 0 0 var(--space-3); color: var(--sand-text); font: 600 var(--fs-300)/var(--lh-ui) var(--font-ui); }
  h1 { margin: 0; max-width: 15ch; color: var(--text); font: var(--fw-display) var(--fs-800)/var(--lh-heading) var(--font-display); letter-spacing: var(--ls-display); text-wrap: balance; }
  .ask-safe__dek { margin: var(--space-4) 0 0; max-width: 58ch; color: var(--soft); font: 400 var(--fs-500)/var(--lh-body) var(--font-ui); text-wrap: pretty; }
  .ask-safe__search { margin-top: var(--space-8); padding: var(--space-6); background: var(--bg-alt); border-radius: var(--radius-m); }
  h2 { margin: 0; color: var(--text); font: 600 var(--fs-600)/var(--lh-heading) var(--font-display); text-wrap: balance; }
  .ask-safe__search > p { margin: var(--space-2) 0 var(--space-5); max-width: 62ch; color: var(--soft); font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); }
  label { display: block; margin-bottom: var(--space-2); color: var(--text); font: 600 var(--fs-300)/var(--lh-ui) var(--font-ui); }
  .ask-safe__field { display: flex; gap: var(--space-3); }
  input { flex: 1 1 auto; min-width: 0; min-height: 52px; padding: 0 var(--space-4); border: 1px solid var(--border-control); border-radius: var(--radius-s); background: var(--white); color: var(--text); font: 400 var(--fs-400)/1.4 var(--font-ui); }
  input::placeholder { color: var(--soft); opacity: 1; }
  input:focus-visible, a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .ask-safe__field button { min-height: 52px; padding-inline: var(--space-6); }
  .ask-safe__browse { margin-top: var(--space-8); }
  .ask-safe__browse ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: var(--space-4) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--border); }
  .ask-safe__browse li { border-bottom: 1px solid var(--border); }
  .ask-safe__browse li:nth-child(odd) { padding-right: var(--space-4); }
  .ask-safe__browse li:nth-child(even) { padding-left: var(--space-4); }
  .ask-safe__browse a { display: flex; justify-content: space-between; align-items: center; min-height: 58px; color: var(--text); font: 600 var(--fs-400)/var(--lh-ui) var(--font-ui); text-decoration: none; }
  .ask-safe__browse a:hover { color: var(--accent); }
  .ask-safe__note { margin: var(--space-7) 0 0; max-width: 65ch; color: var(--soft); font: 400 var(--fs-300)/var(--lh-body) var(--font-ui); }
  @media (max-width: 47.99em) {
    .ask-safe { padding-block: var(--space-6) var(--space-8); }
    .ask-safe__search { margin-inline: calc(-1 * var(--space-4)); padding: var(--space-5) var(--space-4); border-radius: 0; }
    .ask-safe__field { flex-direction: column; }
    .ask-safe__field button { width: 100%; }
    .ask-safe__browse ul { grid-template-columns: 1fr; }
    .ask-safe__browse li:nth-child(n) { padding-inline: 0; }
  }
</style>
