---
/**
 * /ask - Ask PI (2026-11-12 rebuild for the simplified site).
 *
 * One question, one answer. The answer comes from the concierge API
 * (peninsula-insider-platform, Cohere), which retrieves from PI's own
 * reviews and guides. The page keeps the site's grammar: a plain title,
 * one input with a control edge, one solid button, prose at reading
 * measure, then the places as text rows with one hairline between them.
 *
 * Links are checked against /ask/pages.json (every public URL, written
 * after the build by scripts/generate-ask-pages.mjs), so an answer can
 * never send a reader to a retired page; a stale path is corrected by its
 * slug, otherwise the row is dropped.
 *
 * ?q= asks on load, so search, hubs and plans can hand a question over.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONCIERGE_API_URL as API_URL } from '../lib/concierge-config';
export const prerender = true;

const examples = [
  'A long lunch in Red Hill that works with kids',
  'Somewhere dog friendly for breakfast near Sorrento',
  'A rainy Sunday for two with no driving after lunch',
  'Where to stay for a quiet anniversary weekend',
];
---

<BaseLayout
  title="Ask PI"
  description="Ask a question about the Mornington Peninsula. PI answers from Peninsula Insider's own reviews and guides, and links you to the places."
>
  <div class="ask container" data-ask data-api={API_URL}>
    <header class="ask__head">
      <h1 class="ask__title">Ask PI</h1>
      <p class="ask__dek">Ask a question about the Peninsula. PI answers from our own reviews and guides, and links you to the places.</p>
    </header>

    <form class="ask__form" action="/ask/" method="get" data-ask-form>
      <label class="ask__label" for="ask-q">Your question</label>
      <div class="ask__field">
        <input id="ask-q" name="q" type="text" maxlength="500" autocomplete="off" enterkeyhint="send"
          placeholder="A long lunch or a rainy day" required minlength="3" data-ask-input />
        <button class="pi-btn pi-btn--solid ask__submit" type="submit" data-ask-submit>Ask</button>
      </div>
    </form>

    <section class="ask__examples" aria-labelledby="ask-examples-title" data-ask-examples>
      <h2 class="ask__subhead" id="ask-examples-title">Try asking</h2>
      <ul class="ask__example-list" role="list">
        {examples.map((q) => (
          <li><a class="ask__example" href={`/ask/?q=${encodeURIComponent(q)}`} data-ask-example={q}>{q}</a></li>
        ))}
      </ul>
    </section>

    <article class="ask__answer" data-ask-answer hidden aria-labelledby="ask-question">
      <h2 class="ask__question" id="ask-question" tabindex="-1" data-ask-question></h2>
      <p class="ask__status" role="status" aria-live="polite" data-ask-status hidden></p>
      <div class="ask__prose" data-ask-prose></div>

      <section class="ask__places" data-ask-places hidden aria-labelledby="ask-places-title">
        <h3 class="ask__subhead" id="ask-places-title">Where to go</h3>
        <ol class="ask__place-list" role="list" data-ask-place-list></ol>
      </section>

      <section class="ask__next" data-ask-next hidden aria-labelledby="ask-next-title">
        <h3 class="ask__subhead" id="ask-next-title">Ask next</h3>
        <ul class="ask__example-list" role="list" data-ask-next-list></ul>
      </section>

      <p class="ask__note">Answers come from Peninsula Insider's reviews and guides. Opening hours and bookings change, so check with the place before you go. Prefer to browse? <a href="/search/" data-ask-search-link>Search the site</a>.</p>
    </article>
  </div>
</BaseLayout>

<script>
  type Rec = { title?: string; slug?: string; href?: string; why?: string; region?: string };

  const SECTIONS: Record<string, string> = {
    eat: 'Eat & Drink', stay: 'Stay', wine: 'Wine', explore: 'Explore', plans: 'Plans',
    'whats-on': "What's On", events: "What's On", journal: 'Journal', places: 'Explore', escape: 'Plans',
  };

  // Back/forward between questions. Registered once at module scope (listener
  // hygiene gate); boot() points it at the current page's handler.
  let onPop: (() => void) | null = null;
  window.addEventListener('popstate', () => onPop?.());

  function boot() {
    const root = document.querySelector<HTMLElement>('[data-ask]');
    if (!root || root.dataset.booted) return;
    root.dataset.booted = '1';
    const api = root.dataset.api || '';
    const form = root.querySelector<HTMLFormElement>('[data-ask-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-ask-input]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-ask-submit]')!;
    const examples = root.querySelector<HTMLElement>('[data-ask-examples]')!;
    const status = root.querySelector<HTMLElement>('[data-ask-status]')!;
    const answer = root.querySelector<HTMLElement>('[data-ask-answer]')!;
    const question = root.querySelector<HTMLElement>('[data-ask-question]')!;
    const prose = root.querySelector<HTMLElement>('[data-ask-prose]')!;
    const places = root.querySelector<HTMLElement>('[data-ask-places]')!;
    const placeList = root.querySelector<HTMLElement>('[data-ask-place-list]')!;
    const next = root.querySelector<HTMLElement>('[data-ask-next]')!;
    const nextList = root.querySelector<HTMLElement>('[data-ask-next-list]')!;
    const searchLink = root.querySelector<HTMLAnchorElement>('[data-ask-search-link]')!;

    let sessionId = '';
    try {
      sessionId = sessionStorage.getItem('pi-ask-session') || '';
      if (!sessionId) { sessionId = crypto.randomUUID(); sessionStorage.setItem('pi-ask-session', sessionId); }
    } catch { sessionId = crypto.randomUUID(); }

    // Every public path, so links in an answer are always live pages.
    let pages: Promise<Set<string>> | null = null;
    const loadPages = () => (pages ??= fetch('/ask/pages.json').then((r) => (r.ok ? r.json() : [])).then((l: string[]) => new Set(l)).catch(() => new Set<string>()));

    function resolveHref(rec: Rec, known: Set<string>): string | null {
      const raw = (rec.href || '').trim();
      const path = raw.startsWith('/') ? raw.replace(/[?#].*$/, '').replace(/\/?$/, '/') : '';
      if (path && known.has(path)) return path;
      const slug = (path.split('/').filter(Boolean).pop() || rec.slug || '').toLowerCase();
      if (!slug) return null;
      const matches = [...known].filter((p) => p.endsWith(`/${slug}/`));
      return matches.length === 1 ? matches[0] : null;
    }

    let controller: AbortController | null = null;

    function setStatus(text: string) {
      status.textContent = text;
      status.hidden = !text;
    }

    function paragraphs(text: string) {
      prose.replaceChildren(...text.split(/\n{2,}/).map((t) => t.trim()).filter(Boolean).map((t) => {
        const p = document.createElement('p');
        p.textContent = t;
        return p;
      }));
    }

    async function renderPlaces(recs: Rec[]) {
      const known = await loadPages();
      const rows: HTMLElement[] = [];
      const seen = new Set<string>();
      for (const rec of recs) {
        const href = known.size ? resolveHref(rec, known) : null;
        if (!href || seen.has(href) || !rec.title) continue;
        seen.add(href);
        const li = document.createElement('li');
        li.className = 'ask__place';
        const a = document.createElement('a');
        a.className = 'ask__place-link';
        a.href = href;
        a.textContent = rec.title;
        li.append(a);
        if (rec.why) {
          const why = document.createElement('p');
          why.className = 'ask__place-why';
          why.textContent = rec.why;
          li.append(why);
        }
        const section = SECTIONS[href.split('/').filter(Boolean)[0] || ''];
        if (section) {
          const meta = document.createElement('p');
          meta.className = 'ask__place-meta';
          meta.textContent = section;
          li.append(meta);
        }
        rows.push(li);
      }
      placeList.replaceChildren(...rows.slice(0, 5));
      places.hidden = rows.length === 0;
    }

    function renderNext(items: string[]) {
      nextList.replaceChildren(...items.slice(0, 3).map((q) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'ask__example';
        a.href = `/ask/?q=${encodeURIComponent(q)}`;
        a.dataset.askExample = q;
        a.textContent = q;
        li.append(a);
        return li;
      }));
      next.hidden = items.length === 0;
    }

    async function* sse(res: Response) {
      const reader = res.body!.getReader();
      const decoder = new TextDecoder();
      let buf = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        let i;
        while ((i = buf.indexOf('\n\n')) >= 0) {
          const block = buf.slice(0, i);
          buf = buf.slice(i + 2);
          let event = 'message';
          let data = '';
          for (const line of block.split('\n')) {
            if (line.startsWith('event:')) event = line.slice(6).trim();
            else if (line.startsWith('data:')) data += line.slice(5).trim();
          }
          try { yield { event, data: data ? JSON.parse(data) : {} }; } catch { /* skip malformed */ }
        }
      }
    }

    const STAGES: Record<string, string> = {
      received: 'Reading your question…', retrieving: 'Looking through our guides…', reranking: 'Choosing the best fits…',
      generating: 'Writing an answer…', enriching: 'Checking the links…',
    };

    async function ask(q: string, push = true) {
      const query = q.trim();
      if (query.length < 3) return;
      controller?.abort();
      controller = new AbortController();
      input.value = query;
      if (push) history.pushState({ q: query }, '', `/ask/?q=${encodeURIComponent(query)}`);
      document.title = `${query} - Ask PI - Peninsula Insider`;
      searchLink.href = `/search/?q=${encodeURIComponent(query)}`;

      examples.hidden = true;
      answer.hidden = false;
      answer.setAttribute('aria-busy', 'true');
      question.textContent = query;
      prose.replaceChildren();
      places.hidden = true;
      next.hidden = true;
      submit.disabled = true;
      setStatus(STAGES.received);
      loadPages();

      let text = '';
      try {
        const res = await fetch(`${api}/concierge/ask/stream`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream', 'X-Session-Id': sessionId, 'X-Current-Page': location.pathname },
          body: JSON.stringify({ query }),
          signal: controller.signal,
        });
        if (res.status === 429) throw new Error("You've asked a lot in the last hour. Try again later, or search the site.");
        if (!res.ok || !res.body) throw new Error('');
        for await (const { event, data } of sse(res)) {
          if (event === 'status' && STAGES[data.stage]) setStatus(STAGES[data.stage]);
          else if (event === 'text' && typeof data.delta === 'string') {
            if (!text) setStatus('');
            text += data.delta;
            paragraphs(text);
          } else if (event === 'meta') {
            await renderPlaces(Array.isArray(data.recommendations) ? data.recommendations : []);
            renderNext(Array.isArray(data.follow_on) ? data.follow_on : []);
          } else if (event === 'error') {
            throw new Error(typeof data.message === 'string' ? data.message : '');
          }
        }
        if (!text) throw new Error('');
        setStatus('');
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
        const msg = (err as Error).message || "Ask PI can't answer right now. Try search, or ask again in a minute.";
        prose.replaceChildren();
        const p = document.createElement('p');
        p.className = 'ask__error';
        p.textContent = msg;
        prose.append(p);
        setStatus('');
      } finally {
        answer.removeAttribute('aria-busy');
        submit.disabled = false;
      }
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
    root.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-ask-example]');
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      ask(link.dataset.askExample || '');
      question.focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start' });
    });
    onPop = () => {
      if (!root.isConnected) return;
      const q = new URLSearchParams(location.search).get('q');
      if (q) ask(q, false);
      else { controller?.abort(); answer.hidden = true; examples.hidden = false; setStatus(''); input.value = ''; }
    };

    const initial = new URLSearchParams(location.search).get('q') || new URLSearchParams(location.hash.slice(1)).get('q');
    if (initial) ask(initial, false);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<!-- Global (every selector is under .ask): the answer, places and follow-ons
     are created by script, so Astro's scoped attribute never reaches them. -->
<style is:global>
  .ask { max-width: 46rem; padding-block: var(--space-8) var(--space-9); }
  .ask__head { margin-bottom: var(--space-6); }
  .ask__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-800);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--text);
  }
  .ask__dek { margin: var(--space-3) 0 0; max-width: 38rem; color: var(--soft); font: 400 var(--fs-500)/var(--lh-body) var(--font-ui); text-wrap: pretty; }

  .ask__label { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .ask__field { display: flex; gap: var(--space-3); }
  .ask__field input {
    flex: 1 1 auto; min-width: 0; min-height: 52px; padding: 0 var(--space-4);
    background: var(--white); border: 1px solid var(--border-control); border-radius: var(--radius-s);
    color: var(--text); font: 400 var(--fs-400)/1.4 var(--font-ui);
  }
  .ask__field input::placeholder { color: var(--soft); }
  .ask__field input:focus-visible, .ask a:focus-visible, .ask__question:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .ask__submit { min-height: 52px; padding-inline: var(--space-6); }
  .ask__submit:disabled { opacity: .6; cursor: progress; }

  .ask__subhead { margin: 0 0 var(--space-3); color: var(--text); font: 600 var(--fs-300)/var(--lh-ui) var(--font-ui); }
  .ask__examples { margin-top: var(--space-7); }
  .ask__example-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .ask__example {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--accent); font: 400 var(--fs-400)/1.4 var(--font-ui);
    text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: .25em;
  }
  .ask__example:hover { text-decoration-color: currentColor; }

  .ask__status { margin: 0 0 var(--space-4); color: var(--soft); font: 400 var(--fs-300)/var(--lh-ui) var(--font-ui); }

  .ask__answer { margin-top: var(--space-7); }
  .ask__answer[aria-busy="true"] .ask__note { visibility: hidden; }
  .ask__question {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-600);
    line-height: var(--lh-heading);
    color: var(--text);
    text-wrap: balance;
  }
  .ask__prose { max-width: 38rem; }
  .ask__prose p { margin: 0 0 var(--space-4); color: var(--text); font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); text-wrap: pretty; }
  .ask__error { color: var(--soft); }

  .ask__places { margin-top: var(--space-7); }
  .ask__place-list { list-style: none; margin: 0; padding: 0; }
  .ask__place { padding: var(--space-4) 0; }
  .ask__place + .ask__place { border-top: 1px solid var(--border); }
  .ask__place-link {
    display: inline-block; color: var(--text); text-decoration: none;
    font: 600 var(--fs-500)/1.25 var(--font-display);
  }
  .ask__place-link:hover { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  .ask__place-why { margin: var(--space-1) 0 0; max-width: 38rem; color: var(--soft); font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); }
  .ask__place-meta { margin: var(--space-1) 0 0; color: var(--soft); font: 400 var(--fs-300)/var(--lh-ui) var(--font-ui); }

  .ask__next { margin-top: var(--space-7); }
  .ask__note { margin: var(--space-8) 0 0; max-width: 38rem; color: var(--soft); font: 400 var(--fs-300)/var(--lh-body) var(--font-ui); }
  .ask__note a { color: var(--accent); }

  @media (max-width: 47.99em) {
    .ask { padding-block: var(--space-6) var(--space-8); }
    .ask__title { font-size: var(--fs-700); }
    .ask__dek { font-size: var(--fs-400); }
    .ask__field { flex-direction: column; }
    .ask__submit { width: 100%; }
  }
</style>
