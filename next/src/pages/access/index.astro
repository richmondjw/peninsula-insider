---
/**
 * Temporary password gate — remove once ready for public launch.
 * Password: peninsula
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Peninsula Insider</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Georgia', serif;
      background: #f7f5f0;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .gate {
      width: 100%;
      max-width: 380px;
      text-align: center;
    }
    .gate__logo {
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: #1a1a1a;
      margin-bottom: 0.25rem;
    }
    .gate__logo em {
      font-style: italic;
      color: #A0541F;
    }
    .gate__sub {
      font-family: 'Outfit', system-ui, sans-serif;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 2.5rem;
    }
    .gate__label {
      font-family: 'Outfit', system-ui, sans-serif;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #555;
      display: block;
      margin-bottom: 0.6rem;
      text-align: left;
    }
    .gate__input {
      width: 100%;
      padding: 0.85rem 1rem;
      font-family: 'Georgia', serif;
      font-size: 1rem;
      border: 1.5px solid #d0ccc4;
      background: #fff;
      color: #1a1a1a;
      border-radius: 4px;
      outline: none;
      margin-bottom: 1rem;
      transition: border-color 0.2s;
    }
    .gate__input:focus { border-color: #A0541F; }
    .gate__btn {
      width: 100%;
      padding: 0.85rem 1rem;
      background: #1a1a1a;
      color: #fff;
      font-family: 'Outfit', system-ui, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .gate__btn:hover { background: #A0541F; }
    .gate__error {
      font-family: 'Outfit', system-ui, sans-serif;
      font-size: 0.8rem;
      color: #c0392b;
      margin-top: 0.75rem;
      display: none;
    }
    .gate__error.visible { display: block; }
  </style>
</head>
<body>
  <div class="gate">
    <p class="gate__logo">Peninsula <em>Insider</em></p>
    <p class="gate__sub">An editorial guide</p>
    <label class="gate__label" for="pw">Access</label>
    <input
      id="pw"
      class="gate__input"
      type="password"
      placeholder="Enter password"
      autocomplete="current-password"
      autofocus
    />
    <button class="gate__btn" id="btn">Enter →</button>
    <p class="gate__error" id="err">Incorrect password</p>
  </div>

  <script is:inline>
    (function () {
      var KEY  = 'pi-access-v1';
      var PASS = 'peninsula';
      var params = new URLSearchParams(window.location.search);
      var redirect = params.get('r') || '/';

      function tryEnter() {
        var val = document.getElementById('pw').value.trim().toLowerCase();
        if (val === PASS) {
          sessionStorage.setItem(KEY, '1');
          window.location.replace(redirect);
        } else {
          document.getElementById('err').classList.add('visible');
          document.getElementById('pw').focus();
        }
      }

      document.getElementById('btn').addEventListener('click', tryEnter);
      document.getElementById('pw').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') tryEnter();
      });
    })();
  </script>
</body>
</html>
