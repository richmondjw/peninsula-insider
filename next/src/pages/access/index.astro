---
/**
 * Temporary password gate.
 * Password: peninsula
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Peninsula Insider - Coming Soon</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      background: #EEF1F1;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.5rem;
    }
    .gate {
      width: 100%;
      max-width: 420px;
      text-align: center;
      padding: 0 0.25rem;
    }
    @media (max-width: 480px) {
      body { padding: 2rem 1.25rem; }
    }
    .gate__logo-img {
      display: block;
      width: 100px;
      height: auto;
      margin: 0 auto 0.75rem;
    }
    .gate__logo-text {
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      font-size: 1.25rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: #12211E;
      margin-bottom: 2rem;
    }
    .gate__logo-text em {
      font-style: italic;
      color: #26997e;
    }

    /* Teaser strip */
    .gate__teaser {
      background: #fff;
      border: 1px solid #D6DDDB;
      border-radius: 6px;
      padding: 1.75rem 1.5rem 1.5rem;
      margin-bottom: 2rem;
      text-align: left;
    }
    .gate__teaser-eyebrow {
      font-family: var(--font-ui);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #26997e;
      display: block;
      margin-bottom: 0.75rem;
    }
    .gate__teaser-heading {
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      font-size: 1.2rem;
      font-weight: 400;
      line-height: 1.4;
      color: #12211E;
      margin-bottom: 0.65rem;
    }
    .gate__teaser-heading em {
      font-style: italic;
      color: #26997e;
    }
    .gate__teaser-body {
      font-family: var(--font-ui);
      font-size: 0.88rem;
      line-height: 1.6;
      color: #555;
      margin-bottom: 1.25rem;
    }
    .gate__subscribe-row {
      display: flex;
      gap: 0.4rem;
    }
    .gate__subscribe-input {
      flex: 1;
      min-width: 0;
      padding: 0.7rem 0.85rem;
      font-family: var(--font-ui);
      font-size: 0.88rem;
      border: 1.5px solid #D6DDDB;
      background: #EEF1F1;
      color: #12211E;
      border-radius: 4px;
      outline: none;
      transition: border-color 0.2s;
    }
    .gate__subscribe-input:focus { border-color: #26997e; }
    .gate__subscribe-btn {
      padding: 0.7rem 1rem;
      background: #26997e;
      color: #fff;
      font-family: var(--font-ui);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
    }
    .gate__subscribe-btn:hover { background: #12211E; }
    .gate__subscribe-btn:disabled { opacity: 0.6; cursor: progress; }
    .gate__subscribe-status {
      font-family: var(--font-ui);
      font-size: 0.8rem;
      color: #555;
      margin-top: 0.6rem;
      min-height: 1.2em;
    }
    .gate__subscribe-status.success { color: #2f6e3a; }
    .gate__subscribe-status.error { color: #c0392b; }

    /* Divider */
    .gate__divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      color: #aaa;
    }
    .gate__divider::before,
    .gate__divider::after {
      content: '';
      flex: 1;
      border-top: 1px solid #D6DDDB;
    }
    .gate__divider span {
      font-family: var(--font-ui);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* Password gate */
    .gate__label {
      font-family: var(--font-ui);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #555;
      display: block;
      margin-bottom: 0.6rem;
      text-align: left;
    }
    .gate__input {
      width: 100%;
      padding: 0.85rem 1rem;
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      font-size: 1rem;
      border: 1.5px solid #D6DDDB;
      background: #fff;
      color: #12211E;
      border-radius: 4px;
      outline: none;
      margin-bottom: 1rem;
      transition: border-color 0.2s;
    }
    .gate__input:focus { border-color: #26997e; }
    .gate__btn {
      width: 100%;
      padding: 0.85rem 1rem;
      background: #12211E;
      color: #fff;
      font-family: var(--font-ui);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .gate__btn:hover { background: #26997e; }
    .gate__error {
      font-family: var(--font-ui);
      font-size: 0.8rem;
      color: #c0392b;
      margin-top: 0.75rem;
      display: none;
    }
    .gate__error.visible { display: block; }
  </style>
</head>
<body>
  <div class="gate">
    <img class="gate__logo-img" src="/images/pi-logo-new.svg" alt="Peninsula Insider" />
    <p class="gate__logo-text">Peninsula <em>Insider</em></p>

    <label class="gate__label" for="pw">Access</label>
    <input
      id="pw"
      class="gate__input"
      type="password"
      placeholder="Enter password"
      autocomplete="current-password"
      autofocus
    />
    <button class="gate__btn" id="btn">Enter →</button>
    <p class="gate__error" id="err">Incorrect password</p>

    <div class="gate__divider"><span>Not yet an insider?</span></div>

    <!-- Teaser + subscribe -->
    <div class="gate__teaser">
      <span class="gate__teaser-eyebrow">Coming soon</span>
      <h1 class="gate__teaser-heading">Something good is coming <em>to the Peninsula.</em></h1>
      <p class="gate__teaser-body">We're putting together the guide this place deserves. Be the first to know.</p>
      <div class="gate__subscribe-row">
        <input
          id="sub-email"
          class="gate__subscribe-input"
          type="email"
          placeholder="your@email.com"
          autocomplete="email"
          aria-label="Email address"
        />
        <button class="gate__subscribe-btn" id="sub-btn">Notify me</button>
      </div>
      <p class="gate__subscribe-status" id="sub-status"></p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var KEY  = 'pi-access-v1';
      var PASS = 'peninsula';
      var params = new URLSearchParams(window.location.search);
      var redirect = params.get('r') || '/';

      function tryEnter() {
        var val = document.getElementById('pw').value.trim().toLowerCase();
        if (val === PASS) {
          localStorage.setItem(KEY, '1');
          window.location.replace(redirect);
        } else {
          document.getElementById('err').classList.add('visible');
          document.getElementById('pw').focus();
        }
      }

      document.getElementById('btn').addEventListener('click', tryEnter);
      document.getElementById('pw').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') tryEnter();
      });

      // Subscribe form
      var ENDPOINT = 'https://tjjhpvslpysfklwpqmgz.supabase.co/functions/v1/pi-newsletter-subscribe';
      var subBtn = document.getElementById('sub-btn');
      var subEmail = document.getElementById('sub-email');
      var subStatus = document.getElementById('sub-status');

      function setStatus(msg, kind) {
        subStatus.textContent = msg;
        subStatus.className = 'gate__subscribe-status ' + (kind || '');
      }

      async function handleSubscribe() {
        var email = subEmail.value.trim();
        if (!email || !email.includes('@')) {
          setStatus('Please enter a valid email.', 'error');
          return;
        }
        subBtn.disabled = true;
        setStatus('Saving…', '');
        try {
          var res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, source: 'access-gate' })
          });
          if (res.ok) {
            setStatus("You're on the list. We'll be in touch.", 'success');
            subEmail.value = '';
          } else {
            setStatus('Something went wrong - try again.', 'error');
            subBtn.disabled = false;
          }
        } catch (e) {
          setStatus('Something went wrong - try again.', 'error');
          subBtn.disabled = false;
        }
      }

      subBtn.addEventListener('click', handleSubscribe);
      subEmail.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') handleSubscribe();
      });
    })();
  </script>
</body>
</html>
