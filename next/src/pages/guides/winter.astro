    font-size: 14pt;
    font-weight: 500;
    margin: 0 0 1mm;
    color: #a77637;
  }
  .guide__plan-list p {
    font-size: 10.5pt;
    line-height: 1.55;
    color: #2a1f12;
    margin: 0;
  }
