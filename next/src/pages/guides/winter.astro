    content: counter(shortlist-step) '. ';
    color: #a77637;
    font-weight: 500;
  }
  .guide__list-meta {
    font-size: 9pt;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a77637;
    margin: 0 0 2mm;
  }
  .guide__list-signature {
    font-size: 10.5pt;
    line-height: 1.5;
    color: #5b4f3f;
    margin: 0;
  }
  .guide__plan {
    page-break-after: always;
  }
  .guide__plan-list {
