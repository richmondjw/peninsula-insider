---
import BaseLayout from '../layouts/BaseLayout.astro';
import InsiderPlans from '../components/InsiderPlans.astro';
import Masthead from '../components/Masthead.astro';
---

<BaseLayout
  title="Preview: Insider Plans Block — Peninsula Insider"
  description="Design preview — Start with an Insider Plan homepage section"
  noindex={true}
>
  <Masthead />

  <!-- Spacer to show context above the block -->
  <div style="background: var(--paper, #F5F0E8); padding: 3rem var(--container-pad, 1.25rem) 0; max-width: 900px; margin: 0 auto;">
    <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #999; margin: 0 0 0.5rem;">Preview only — not live on homepage</p>
    <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; line-height: 1.1; margin: 0 0 0.75rem; color: #1A1208;">
      What are you doing this weekend?
    </h1>
    <p style="font-size: 1.1rem; color: #6E655C; margin: 0 0 2rem;">This section would sit directly under the hero — above all editorial content.</p>
  </div>

  <!-- The component being tested -->
  <InsiderPlans />

  <!-- Context below -->
  <div style="background: #f0ece2; padding: 3rem var(--container-pad, 1.25rem); max-width: 900px; margin: 0 auto; color: #6E655C; font-size: 0.85rem;">
    <p><strong>For James:</strong> This is the "Start with an Insider Plan" conversion block Emma has briefed. Cards link to existing itinerary pages. Mobile swipe works on device. Desktop drag-scroll enabled.</p>
    <p>Approve to add to homepage, or share feedback and we'll iterate.</p>
  </div>
</BaseLayout>
