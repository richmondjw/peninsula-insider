---
/* Single Notebook entry detail page — /notebook/[slug]/ */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const notes = await getCollection('quickNotes', ({ data }) => data.status === 'published');
  return notes.map((note) => ({
    params: { slug: note.id.replace(/\.md$/, '') },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const SECTION_LABEL: Record<string, string> = {
  eat: 'Eat & Drink', stay: 'Stay', wine: 'Wine Country',
  explore: 'Explore', spa: 'Spa & Wellness', golf: 'Golf',
  'whats-on': "What's On", weather: 'Weather', note: 'Editor',
};
const TAG_LABEL: Record<string, string> = {
  'opening-window': 'Booking window', 'menu-change': 'Menu',
  'closure': 'Closure', 'event': 'Event', 'weather': 'Weather',
  'editor-note': "Editor's note", 'pricing': 'Pricing', 'safety': 'Safety',
};

const publishedFmt = note.data.publishedAt.toLocaleString('en-AU', {
  weekday: 'long', day: 'numeric', month: 'long',
  hour: 'numeric', minute: '2-digit', hour12: true,
});
const expiresFmt = note.data.expiresAt.toLocaleDateString('en-AU', {
  day: 'numeric', month: 'long',
});
---

<BaseLayout
  title={`${note.data.headline} | The Notebook — Peninsula Insider`}
  description={note.data.dek ?? note.data.headline}
  section="notebook"
  canonical={`https://peninsulainsider.com.au/notebook/${note.id.replace(/\.md$/, '')}/`}
  ogType="article"
  publishedTime={note.data.publishedAt.toISOString()}
>
  <Breadcrumbs items={[
    { label: 'Home', href: '/' },
    { label: 'The Notebook', href: '/notebook/' },
    { label: note.data.headline },
  ]} />

  <main class="qn-detail">
    <article class="container">
      <div class="qn-detail__meta">
        <span class="qn-detail__section">{SECTION_LABEL[note.data.section] ?? note.data.section}</span>
        <span class="qn-detail__tag">{TAG_LABEL[note.data.tag] ?? note.data.tag}</span>
        <time class="qn-detail__time" datetime={note.data.publishedAt.toISOString()}>{publishedFmt}</time>
      </div>

      <h1 class="qn-detail__headline">{note.data.headline}</h1>
      {note.data.dek && <p class="qn-detail__dek">{note.data.dek}</p>}

      {note.data.verdict && (
        <p class="qn-detail__verdict">{note.data.verdict}</p>
      )}

      <div class="qn-detail__body">
        <Content />
      </div>

      {note.data.sources?.length > 0 && (
        <div class="qn-detail__sources">
          <p class="qn-detail__sources-label">Sources</p>
          <ul>
            {note.data.sources.map((s: any) => (
              <li>
                <span class="qn-detail__source-kind">{s.kind}</span>
                {s.url && <a href={s.url} target="_blank" rel="noopener noreferrer">{s.url}</a>}
                {s.note && <span class="qn-detail__source-note">— {s.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="qn-detail__foot">
        <p>
          Published {publishedFmt}
          {note.data.verifiedBy && <> · Verified by {note.data.verifiedBy}</>}
          · Note expires {expiresFmt}
        </p>
        <p><a href="/notebook/">← Back to The Notebook</a></p>
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .qn-detail { padding: clamp(2rem, 5vw, 4rem) 0; min-height: 60vh; background: var(--paper, #FAF7F0); }
  .qn-detail .container { max-width: 44rem; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); }

  .qn-detail__meta {
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.8rem;
    font-size: 0.7rem;
    margin: 0 0 1rem;
    align-items: baseline;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
  }
  .qn-detail__section {
    font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ochre, #A0541F);
  }
  .qn-detail__tag {
    font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    background: var(--paper-warm, #F3EDDE);
    padding: 0.18rem 0.5rem; border-radius: 2px;
  }
  .qn-detail__time {
    color: var(--ink-muted, #6E655C);
    font-size: 0.78rem;
    margin-left: auto;
  }
  .qn-detail__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--dark);
    margin: 0 0 0.7rem;
  }
  .qn-detail__dek {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--soft);
    margin: 0 0 1.4rem;
  }
  .qn-detail__verdict {
    background: var(--bg-alt, #F5EFE4);
    border-left: 2px solid var(--accent);
    padding: 0.85rem 1.1rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text);
    margin: 0 0 1.4rem;
    font-style: italic;
  }
  .qn-detail__body { font-size: 0.95rem; line-height: 1.75; color: var(--text); }
  .qn-detail__body p { margin: 0 0 1rem; }
  .qn-detail__sources { margin: 2rem 0 0; border-top: 1px solid var(--border); padding-top: 1rem; }
  .qn-detail__sources-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--soft); margin: 0 0 0.5rem; }
  .qn-detail__sources ul { list-style: none; padding: 0; margin: 0; font-size: 0.8rem; }
  .qn-detail__sources li { display: flex; gap: 0.5rem; padding: 0.25rem 0; }
  .qn-detail__source-kind { text-transform: uppercase; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--soft); flex-shrink: 0; padding-top: 0.1rem; }
  .qn-detail__sources a { color: var(--accent); word-break: break-all; }
  .qn-detail__foot { margin: 2rem 0 0; border-top: 1px solid var(--border); padding-top: 1rem; font-size: 0.82rem; color: var(--soft); }
  .qn-detail__foot a { color: var(--accent); text-decoration: none; }
  .qn-detail__foot a:hover { text-decoration: underline; }
</style>
