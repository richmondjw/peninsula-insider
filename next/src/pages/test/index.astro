---
/**
 * /test/ — Sunday-magazine-style stripped homepage preview.
 *
 * Built 2026-05-17 as a live preview of a quieter editorial register
 * inspired by The Age's Sunday magazine layout. Reuses the live homepage
 * data sources so editorial swaps elsewhere flow through here too.
 * Not linked from nav. Not indexed.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { routeSlug } from '../../lib/editorial';

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Cover essay — match the live homepage's current spotlight.
const cover = {
  label: 'The slow side',
  image: '/images/sourced/explore-bushrangers-bay-walk-01.webp',
  imageAlt: 'Bushrangers Bay headland and Bass Strait below Cape Schanck',
  headline: 'The other Peninsula weekend.',
  dek: 'When Red Hill is booked out and Sorrento feels like a queue, there is another version of the Peninsula weekend, south of everything, closer to the ocean, and slower on purpose.',
  href: '/journal/a-flinders-weekend/',
  linkLabel: 'Read the essay',
};

// Three secondary picks — match "also in this issue" slots from index.astro.
const alsoInIssue = [
  {
    label: 'The walk',
    image: '/images/sourced/home-cover-back-beach-horses-01.jpg',
    imageAlt: 'Horses on a Peninsula ocean back beach',
    headline: 'When the light starts improving.',
    href: '/journal/the-peninsulas-best-late-afternoon-walks/',
  },
  {
    label: 'The cover story',
    image: '/images/sourced/category-restaurant-01.webp',
    imageAlt: 'Warm Peninsula dining room with a marble bar and low lighting',
    headline: 'The Hatted Restaurants of the Peninsula.',
    href: '/journal/hatted-restaurants-mornington-peninsula-2025/',
  },
  {
    label: 'The complete guide',
    image: '/images/sourced/explore-cape-schanck-lighthouse-01.webp',
    imageAlt: 'Cape Schanck lighthouse above the basalt coastline',
    headline: 'The lighthouse at the edge of everything.',
    href: '/journal/cape-schanck-guide/',
  },
];

// Three alternating story pairs below the cover spread. These are the
// kind of pieces Sunday surfaces one at a time — a long-read essay, a
// reported personal piece, a service story.
const pairs = [
  {
    label: 'Wine',
    image: '/images/sourced/category-winery-01.webp',
    imageAlt: 'Cool-climate Pinot vineyard on the Red Hill ridge',
    headline: 'The case for the Peninsula chardonnay.',
    dek: 'Twelve cellar doors, two decades of vintages, and the conversation that finally settled what cool-climate chardonnay is doing better than anywhere else in Australia.',
    href: '/journal/the-chardonnay-case/',
  },
  {
    label: 'Long lunch',
    image: '/images/sourced/category-restaurant-01.webp',
    imageAlt: 'Long communal table set for an afternoon Peninsula lunch',
    headline: 'Three Italian dinners, one Peninsula weekend.',
    dek: 'A small, opinionated route through the three Italian rooms worth planning a weekend around, in the order they ought to be eaten.',
    href: '/journal/three-italian-dinners/',
  },
  {
    label: 'Springs',
    image: '/images/sourced/spa-peninsula-hot-springs-hilltop-01.webp',
    imageAlt: 'Steam rising from a thermal pool at dusk',
    headline: 'The thermal springs weekend, done properly.',
    dek: 'Which pools to book, what to skip, and the small adjustments that turn a Peninsula hot-springs visit from a queue into a quiet evening.',
    href: '/journal/the-thermal-springs-weekend/',
  },
];
---

<BaseLayout
  title="Test layout · Peninsula Insider"
  description="Preview of a quieter editorial layout, modelled on Sunday magazine."
  section="home"
  canonical="https://peninsulainsider.com.au/test/"
  noindex={true}
>
  <p class="t-flag">Preview layout · not linked from nav</p>

  {/* ── Cover spread ───────────────────────────────────────────────── */}
  <section class="t-cover" aria-label="Cover essay">
    <div class="t-container t-cover__inner">
      <div class="t-cover__type">
        <p class="t-eyebrow">{cover.label}</p>
        <h1 class="t-cover__headline">{cover.headline}</h1>
        <p class="t-cover__dek">{cover.dek}</p>
        <a class="t-link" href={cover.href}>{cover.linkLabel} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="t-cover__visual">
        <img src={cover.image} alt={cover.imageAlt} loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  {/* ── Also in this issue ─────────────────────────────────────────── */}
  <section class="t-also" aria-label="Also in this issue">
    <div class="t-container">
      <p class="t-section-label">Also in this issue</p>
      <div class="t-also__grid">
        {alsoInIssue.map((item) => (
          <a class="t-also__item" href={item.href}>
            <div class="t-also__thumb">
              <img src={item.image} alt={item.imageAlt} loading="lazy" />
            </div>
            <h3 class="t-also__headline">{item.headline}</h3>
            <p class="t-also__eyebrow">{item.label}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Alternating image/text pairs ───────────────────────────────── */}
  <section class="t-pairs" aria-label="In this issue">
    <div class="t-container">
      {pairs.map((p, i) => (
        <article class={`t-pair ${i % 2 === 1 ? 't-pair--flip' : ''}`}>
          <a class="t-pair__visual" href={p.href} aria-hidden="true" tabindex="-1">
            <img src={p.image} alt="" loading="lazy" />
          </a>
          <div class="t-pair__type">
            <p class="t-eyebrow t-eyebrow--quiet">{p.label}</p>
            <h2 class="t-pair__headline">
              <a href={p.href}>{p.headline}</a>
            </h2>
            <p class="t-pair__dek">{p.dek}</p>
            <a class="t-link t-link--small" href={p.href}>Read <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* ── Foot ───────────────────────────────────────────────────────── */}
  <section class="t-foot">
    <div class="t-container t-foot__inner">
      <p class="t-foot__line">Peninsula Insider · May 2026</p>
      <p class="t-foot__hint">
        Comparing the live <a href="/">homepage</a> · feedback to the editors.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Scoped to this preview only. Deliberately verbose so it doesn't lean
     on any global helpers — anything we like can be lifted into the real
     homepage in a follow-up. */
  .t-container {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  .t-flag {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.45);
    text-align: center;
    margin: 1rem 0 0;
  }

  /* ── Type primitives ───────────────────────────────────────────── */
  .t-eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.7);
    margin: 0 0 1.5rem;
  }
  .t-eyebrow--quiet {
    color: rgba(23, 20, 19, 0.55);
    margin-bottom: 1rem;
  }
  .t-section-label {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.6);
    text-align: center;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  }
  .t-link {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1.15rem;
    color: #171413;
    text-decoration: none;
    border-bottom: 1px solid rgba(23, 20, 19, 0.4);
    padding-bottom: 2px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .t-link:hover {
    color: #A0541F;
    border-bottom-color: #A0541F;
  }
  .t-link--small { font-size: 1rem; }

  /* ── Cover spread ──────────────────────────────────────────────── */
  .t-cover {
    background: #FFFFFF;
    padding: clamp(3rem, 7vw, 7rem) 0 clamp(4rem, 8vw, 8rem);
  }
  .t-cover__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }
  .t-cover__type {
    padding-top: clamp(0.5rem, 2vw, 2rem);
  }
  .t-cover__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.018em;
    color: #171413;
    margin: 0 0 1.75rem;
    max-width: 14ch;
  }
  .t-cover__dek {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.55;
    color: rgba(23, 20, 19, 0.78);
    margin: 0 0 2.25rem;
    max-width: 40ch;
  }
  .t-cover__visual {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .t-cover__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Also in this issue ───────────────────────────────────────── */
  .t-also {
    background: #FFFFFF;
    padding: clamp(4rem, 8vw, 8rem) 0 clamp(5rem, 9vw, 9rem);
    border-top: 1px solid rgba(23, 20, 19, 0.08);
  }
  .t-also__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .t-also__item {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .t-also__thumb {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin: 0 0 1.25rem;
  }
  .t-also__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .t-also__item:hover .t-also__thumb img { transform: scale(1.03); }
  .t-also__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.35rem, 1.8vw, 1.7rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: #171413;
    margin: 0 0 0.6rem;
  }
  .t-also__eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.55);
    margin: 0;
  }

  /* ── Alternating pairs ─────────────────────────────────────────── */
  .t-pairs { background: #FFFFFF; padding: 0 0 clamp(5rem, 9vw, 9rem); }
  .t-pair {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding: clamp(3.5rem, 7vw, 7rem) 0;
    border-top: 1px solid rgba(23, 20, 19, 0.08);
  }
  .t-pair--flip > .t-pair__visual { order: 2; }
  .t-pair--flip > .t-pair__type { order: 1; }
  .t-pair__visual {
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }
  .t-pair__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .t-pair__visual:hover img { transform: scale(1.03); }
  .t-pair__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.012em;
    margin: 0 0 1.25rem;
    max-width: 16ch;
  }
  .t-pair__headline a {
    color: #171413;
    text-decoration: none;
  }
  .t-pair__headline a:hover { color: #A0541F; }
  .t-pair__dek {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(23, 20, 19, 0.75);
    margin: 0 0 1.75rem;
    max-width: 42ch;
  }

  /* ── Foot ──────────────────────────────────────────────────────── */
  .t-foot {
    background: #FFFFFF;
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(4rem, 7vw, 7rem);
    border-top: 1px solid rgba(23, 20, 19, 0.08);
  }
  .t-foot__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .t-foot__line {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.6);
    margin: 0;
  }
  .t-foot__hint {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    color: rgba(23, 20, 19, 0.55);
    margin: 0;
  }
  .t-foot__hint a {
    color: rgba(23, 20, 19, 0.75);
    border-bottom: 1px solid rgba(23, 20, 19, 0.3);
    text-decoration: none;
  }
  .t-foot__hint a:hover { color: #A0541F; border-bottom-color: #A0541F; }

  /* ── Stack on narrow viewports ────────────────────────────────── */
  @media (max-width: 820px) {
    .t-cover__inner,
    .t-pair,
    .t-pair--flip {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .t-pair--flip > .t-pair__visual { order: 0; }
    .t-pair--flip > .t-pair__type { order: 0; }
    .t-also__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
