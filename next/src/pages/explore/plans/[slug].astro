---
/**
 * /explore/plans/[slug] - itinerary detail page + section:plans article pages
 *
 * Handles two entry types:
 *   - itineraries collection: renders the full 11-section anatomy
 *   - articles with section:plans: renders a simpler article layout
 *
 * The conversion architecture (anchor stay 3-placement rule) lives here:
 *   1. Hero CTA above the fold - "Stay at {anchor}"
 *   2. Day-N "where you sleep tonight" block at end of each day except last
 *   3. Footer rail - anchor + alt stays
 */
import PhotoStage from '../../../components/PhotoStage.astro';
import { photoPlan } from '../../../lib/photo-set';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import VenueCard from '../../../components/VenueCard.astro';
import ExperienceCard from '../../../components/ExperienceCard.astro';
import ItineraryCard from '../../../components/ItineraryCard.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import PiArticleActions from '../../../components/PiArticleActions.astro';
import PiForkPlanButton from '../../../components/PiForkPlanButton.astro';
import { informationCheckedOn } from '../../../lib/verification-date.mjs';
import {
  routeSlug,
  isStayVenue,
  titleize,
  venueHref,
  venueHrefPrefix,
  heroBackgroundStyle,
  formatLabel,
} from '../../../lib/editorial';
import {
  audienceDisplay,
  budgetLabel,
  buildEscapeItinerarySchema,
  deriveDuration,
  durationLabel,
  occasionLabel,
  seasonLabel,
  themeLabel,
} from '../../../lib/escape';
import { editableText, editableImage } from '../../../lib/inline-edit/attrs';
import { isListableVenue } from '../../../lib/editorial';
import { loadOverrides } from '../../../lib/inline-edit/overrides';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';

const timeOfDayLabel: Record<string, string> = {
  morning: 'Morning',
  midday: 'Midday',
  afternoon: 'Afternoon',
  evening: 'Evening',
  night: 'Night',
};

const moodLabel: Record<string, string> = {
  slow: 'Slow',
  indulgent: 'Indulgent',
  wellness: 'Wellness',
  adventure: 'Adventure',
  'food-wine': 'Food & Wine',
  mixed: 'Mixed',
  quick: 'Quick',
};

export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries');
  const plansArticles = await getCollection('articles', ({ data }) =>
    data.section === 'plans' && data.status === 'published'
  );
  const itineraryPaths = itineraries.map((itinerary) => ({
    params: { slug: routeSlug(itinerary) },
    props: { itinerary, articleData: null as any },
  }));
  const articlePaths = plansArticles.map((article) => ({
    params: { slug: routeSlug(article) },
    props: { itinerary: null as any, articleData: article },
  }));
  return [...itineraryPaths, ...articlePaths];
}

const { itinerary, articleData } = Astro.props;

// ─── Plans-article branch data ─────────────────────────────────────────────
const isArticle = articleData != null;
const renderedArticle = isArticle ? await render(articleData) : null;
const ArticleContent = renderedArticle?.Content ?? (null as any);
const articleHeadings = renderedArticle?.headings ?? [];

const ad = isArticle ? articleData.data : null;
const articleSlug = isArticle ? routeSlug(articleData) : null;
const resolvedArticleHero = isArticle ? await resolveHero('article', articleSlug!, ad, 'heroImage') : null;
const incompleteArticleOverride = resolvedArticleHero?.override &&
  (!resolvedArticleHero.override.alt?.trim() || !resolvedArticleHero.override.credit?.trim());
const creditedArticleSource = ad?.heroImage?.src && ad?.heroImage?.alt?.trim() &&
  ad?.heroImage?.credit?.trim() && ad?.heroImage?.rightsStatus === 'recorded';
if (incompleteArticleOverride && creditedArticleSource) {
  console.warn(`[PlanArticle] ${articleSlug} editor image lacks alt or credit; using its credited source photograph`);
}
const articleHero = incompleteArticleOverride && creditedArticleSource && resolvedArticleHero
  ? { ...resolvedArticleHero, src: ad.heroImage.src, alt: ad.heroImage.alt, style: heroBackgroundStyle(ad), override: undefined }
  : resolvedArticleHero;
const articlePhotoCaption = articleHero?.override
  ? articleHero.override.caption
  : ad?.planShape === 'one-night' && ad?.heroImage?.depictionStatus === 'illustrative' && ad?.heroImage?.caption
    ? `${ad.heroImage.caption} One of three suggested bases.`
    : ad?.heroImage?.caption;
const articlePhotoCredit = articleHero?.override ? articleHero.override.credit : ad?.heroImage?.credit;
const isOneNightGuide = isArticle && ad?.planShape === 'one-night';
const articleFactReviewLabel = isOneNightGuide && ad?.lastVerified
  ? ad.lastVerified.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
const articleEyebrow = ad?.planEyebrow ??
  (isOneNightGuide ? 'One night, well spent' : ad?.planShape === 'two-night' ? 'Two-night plan' : ad?.planShape === 'day-trip' ? 'Day plan' : (formatLabel[ad?.format] ?? 'A Peninsula plan'));
const hasPlanQuickChoices = Boolean(ad?.planQuickChoices?.length);
const articlePrimaryHref = isOneNightGuide ? '#choose-your-base' : hasPlanQuickChoices ? '#plan-start' : '#plan-guide';
const articlePrimaryText = isOneNightGuide ? 'Choose your base' : hasPlanQuickChoices ? (ad?.planPrimaryAction ?? 'Explore the options') : 'Read the guide';
const articleSecondaryHref = isOneNightGuide || hasPlanQuickChoices ? '#plan-guide' : '/explore/plans/';
const articleSecondaryText = isOneNightGuide || hasPlanQuickChoices ? 'Read the full guide' : 'Browse all plans';
const planNewsletterBody = isOneNightGuide
  ? 'The Insider Note brings you independent picks and selected guides from across the Peninsula. An occasional email for your next trip.'
  : articleSlug === 'the-couples-weekend'
    ? 'Planning another weekend together? Get occasional independent Peninsula picks and selected guides for the next place you go, meal you book or event you catch.'
    : articleSlug === 'the-thermal-springs-weekend'
      ? 'For your next slower Peninsula weekend, get occasional independent picks and selected guides to places, food and things worth doing.'
      : articleSlug === 'the-point-nepean-half-day'
        ? 'Keep another Peninsula day out in mind with occasional independent weekend picks and selected guides from across the region.'
        : undefined;
const articleSectionLinks = articleHeadings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ label: heading.text, href: `#${heading.slug}` }));
const oneNightBases = isOneNightGuide ? [
  { number: '01', place: 'Sorrento', mood: 'Town life', stay: 'InterContinental Sorrento', stayHref: '/stay/the-continental-sorrento/', dinner: 'Book dinner near the main street', sunday: 'Breakfast and Back Beach if conditions suit', check: 'Town and dinner on foot; check Back Beach conditions.', prefix: 'Base one:' },
  { number: '02', place: 'Red Hill', mood: 'Country house', stay: 'Lindenderry', stayHref: '/stay/lindenderry/', dinner: 'Book dinner on the estate', sunday: 'Slow breakfast and garden time', check: 'Stay on the estate, or drive to an early Montalto tasting.', prefix: 'Base two:' },
  { number: '03', place: 'Flinders', mood: 'Quiet coast', stay: 'Flinders Hotel', stayHref: '/stay/flinders-hotel/', dinner: 'Book dinner in the village', sunday: 'Breakfast and a local walk', check: 'Walk the village and pier; King Street beach access is closed.', prefix: 'Base three:' },
].map((base) => ({
  ...base,
  href: `#${articleHeadings.find((heading) => heading.depth === 3 && heading.text.startsWith(base.prefix))?.slug ?? 'plan-guide'}`,
})) : [];

// Resolve related venues/experiences for article branch
const allVenuesRaw = (await getCollection('venues')).filter(isListableVenue);
const allExperiencesRaw = await getCollection('experiences');
const venueMapBase = new Map(allVenuesRaw.map((v: any) => [routeSlug(v), v]));
const expMapBase = new Map(allExperiencesRaw.map((e: any) => [routeSlug(e), e]));

const articleRelatedVenues = isArticle
  ? (ad.relatedVenues ?? [])
      .map((r: any) => venueMapBase.get(String(r?.id ?? r ?? '')))
      .filter(Boolean)
      .slice(0, 3)
  : [];

const articleFaqSchema = isArticle && ad.faq && ad.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ad.faq.map(({ question, answer }: any) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;

const aCanonical = isArticle ? `https://peninsulainsider.com.au/explore/plans/${articleSlug}/` : '';
const aOgImage = isArticle ? (articleHero?.src ?? '/images/sourced/home-cover.webp') : '';
const aBreadcrumbs = isArticle
  ? [{ label: 'Home', href: '/' }, { label: 'Plans', href: '/explore/plans/' }, { label: ad.title }]
  : [];
const articleSchema = isArticle ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: ad.title,
  description: ad.dek,
  mainEntityOfPage: aCanonical,
  datePublished: ad.publishedAt.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: 'Peninsula Insider' },
  publisher: { '@type': 'Organization', name: 'Peninsula Insider' },
  image: aOgImage.startsWith('http') ? aOgImage : `https://peninsulainsider.com.au${aOgImage}`,
} : null;
const articleBreadcrumbSchema = isArticle ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Plans', item: 'https://peninsulainsider.com.au/explore/plans/' },
    { '@type': 'ListItem', position: 3, name: ad.title, item: aCanonical },
  ],
} : null;

// ─── Itinerary branch data ─────────────────────────────────────────────────
const data = isArticle ? null : itinerary.data;
const slug = isArticle ? '' : routeSlug(itinerary);

// CMS override consult for the itinerary hero - baked at SSR so the
// editor's uploaded image ships in the static HTML.
const itineraryOverrides = !isArticle && slug ? await loadOverrides('itinerary', slug) : null;
const requestedItineraryHeroOverride = itineraryOverrides?.image['heroImage'] ?? itineraryOverrides?.image['hero'];
const incompleteItineraryOverride = requestedItineraryHeroOverride?.src &&
  (!requestedItineraryHeroOverride.alt?.trim() || !requestedItineraryHeroOverride.credit?.trim());
if (incompleteItineraryOverride) {
  console.warn('[PlanItinerary] ' + slug + ' editor image lacks alt or credit; using its credited source photographs');
}
const itineraryHeroOverride = incompleteItineraryOverride ? undefined : requestedItineraryHeroOverride;
// Verified source photographs open the plan unless a complete editor image
// replaces the hero. Keep the image, alt, caption and credit together.
const itineraryPhotos = data ? photoPlan(data, { override: Boolean(itineraryHeroOverride?.src) }) : null;

const allItineraries = isArticle ? [] : await getCollection('itineraries');
const allVenues = isArticle ? allVenuesRaw : allVenuesRaw;
const allExperiences = isArticle ? allExperiencesRaw : allExperiencesRaw;
const allPlaces = isArticle ? [] : await getCollection('places');
const articles = isArticle ? [] : await getCollection('articles', ({ data: a }) => a.status === 'published');

const venueMap = new Map(allVenues.map((venue: any) => [routeSlug(venue), venue]));
const experienceMap = new Map(allExperiences.map((experience: any) => [routeSlug(experience), experience]));
const placeMap = new Map(allPlaces.map((place: any) => [routeSlug(place), place]));

// ─── Resolve venue/experience references on stops ─────────────────────────
const venueSlugs = data
  ? data.stops.map((stop: any) => String(stop.venue?.id ?? stop.venue ?? '')).filter(Boolean)
  : [];
const experienceSlugs = data
  ? data.stops.map((stop: any) => String(stop.experience?.id ?? stop.experience ?? '')).filter(Boolean)
  : [];
const highlightedVenues = Array.from(new Set(venueSlugs))
  .map((key) => venueMap.get(key))
  .filter(Boolean);
const highlightedExperiences = Array.from(new Set(experienceSlugs))
  .map((key) => experienceMap.get(key))
  .filter(Boolean);

// ─── Anchor stay (conversion architecture) ────────────────────────────────
const anchorStaySlug = data ? String((data as any).anchorStay?.id ?? (data as any).anchorStay ?? '') : '';
const anchorStay = anchorStaySlug ? venueMap.get(anchorStaySlug) : undefined;
const fallbackStay = highlightedVenues.find((v: any) => isStayVenue(v));
const effectiveStay: any = anchorStay ?? fallbackStay;
const effectiveStayHref = effectiveStay
  ? venueHref(effectiveStay)
  : undefined;

const altStaySlugs: string[] = data
  ? ((data as any).altStays ?? []).map((entry: any) => String(entry?.id ?? entry ?? '')).filter(Boolean)
  : [];
const altStays = altStaySlugs.map((s) => venueMap.get(s)).filter(Boolean) as any[];
// The stay rail is resolved after the day groups, so a scheduled second
// night's accommodation never appears as an alternative.

// ─── Anchor town label ─────────────────────────────────────────────────────
const anchorTownSlug = data ? String((data as any).anchorTown?.id ?? (data as any).anchorTown ?? '') : '';
const anchorTown = anchorTownSlug ? placeMap.get(anchorTownSlug) : undefined;

// ─── Day-by-day grouping ──────────────────────────────────────────────────
type ItineraryStop = CollectionEntry<'itineraries'>['data']['stops'][number];
type ResolvedStop = ItineraryStop & {
  entry: CollectionEntry<'venues'> | CollectionEntry<'experiences'> | null | undefined;
  href: string | undefined;
  label: string;
};
const dayNumbers = data
  ? Array.from(new Set<number>(data.stops.map((stop: ItineraryStop) => stop.day))).sort((a, b) => a - b)
  : [];
const groupedStops = dayNumbers.map((day) => {
  const stops: ResolvedStop[] = data!.stops
    .filter((stop: any) => stop.day === day)
    .sort((a: any, b: any) => a.order - b.order)
    .map((stop: ItineraryStop): ResolvedStop => {
      const vSlug = String(stop.venue?.id ?? stop.venue ?? '');
      const eSlug = String(stop.experience?.id ?? stop.experience ?? '');
      const venue = vSlug ? venueMap.get(vSlug) : null;
      const experience = eSlug ? experienceMap.get(eSlug) : null;
      const entry = venue ?? experience;
      const href = venue
        ? venueHref(venue)
        : experience
        ? `/explore/${routeSlug(experience)}/`
        : undefined;
      const label = (venue as any)?.data?.name ?? (experience as any)?.data?.name ?? 'Stop';
      return { ...stop, entry, href, label };
    });
  return { day, stops };
});
const routePreview = groupedStops.length > 1
  ? groupedStops.map((group, index) => ({
      number: String(index + 1).padStart(2, '0'),
      title: data?.dayLabels?.[index] ?? `Day ${group.day}`,
      detail: group.stops.slice(0, 2).map((stop) => stop.label).join(' · '),
      href: `#day-${group.day}`,
    }))
  : (groupedStops[0]?.stops.slice(0, 3).map((stop, index) => ({
      number: String(index + 1).padStart(2, '0'),
      title: stop.label,
      detail: timeOfDayLabel[stop.timeOfDay] ?? titleize(stop.timeOfDay),
      href: `#stop-${groupedStops[0].day}-${stop.order}`,
    })) ?? []);

// A venue can also be a dinner stop. Use the editor's explicit overnight
// sequence when available, with the original anchor as a legacy fallback.
if (data?.nightStays?.length && data.nightStays.length !== groupedStops.length - 1) {
  throw new Error("[plans] " + slug + " needs one nightStays entry for every overnight day");
}
const overnightStays = groupedStops.slice(0, -1).map((group, index) => {
  const ref: any = data?.nightStays?.[index];
  const key = String(ref?.id ?? ref ?? '');
  const explicitStay = key ? venueMap.get(key) : undefined;
  if (key && !explicitStay) throw new Error("[plans] " + slug + " has an unavailable night stay: " + key);
  const stay = explicitStay ?? effectiveStay;
  return { day: group.day, stay, href: stay ? venueHref(stay) : undefined };
});
const scheduledStayKeys = new Set(
  overnightStays.filter((night) => night.stay).map((night) => routeSlug(night.stay))
);
const scheduledOtherStays = overnightStays
  .map((night) => night.stay)
  .filter((stay, index, stays) => stay && routeSlug(stay) !== routeSlug(effectiveStay) &&
    stays.findIndex((candidate) => candidate && routeSlug(candidate) === routeSlug(stay)) === index);
const inferredAltStays = data?.nightStays?.length ? [] : highlightedVenues
  .filter((venue: any) => isStayVenue(venue) && !scheduledStayKeys.has(routeSlug(venue)))
  .slice(0, 2);
const stayRail = [
  ...scheduledOtherStays,
  ...altStays.filter((stay: any) => !scheduledStayKeys.has(routeSlug(stay))),
  ...inferredAltStays,
].slice(0, 2);
const hasMultipleStayBases = scheduledOtherStays.length > 0;

// ─── Related content ──────────────────────────────────────────────────────
const relatedArticles = articles
  .filter(
    (article: any) =>
      article.data.relatedVenues.some((entry: any) => venueSlugs.includes(String(entry.id ?? entry))) ||
      article.data.relatedExperiences.some((entry: any) => experienceSlugs.includes(String(entry.id ?? entry)))
  )
  .slice(0, 2);
const relatedItineraries = allItineraries
  .filter((entry: any) =>
    routeSlug(entry) !== slug &&
    entry.data.audience === data?.audience &&
    entry.data.lengthNights > 0 &&
    data?.lengthNights > 0
  )
  .sort((a: any, b: any) => {
    const relevance = (entry: any) =>
      ((entry.data.theme ?? []).filter((theme: string) => (data?.theme ?? []).includes(theme)).length * 3) +
      (entry.data.lengthNights === data?.lengthNights ? 2 : 0) +
      (entry.data.mood === data?.mood ? 1 : 0);
    return relevance(b) - relevance(a) || a.data.title.localeCompare(b.data.title, 'en-AU');
  })
  .slice(0, 3);

// The same sequenced stop payload is used by the hub and detail import.
const forkPlan = {
  slug, title: data?.title ?? '', entityType: 'itinerary',
  stops: groupedStops.flatMap((group) => group.stops.map((stop) => ({
    day: group.day,
    kind: stop.entry ? (stop.venue ? 'venue' : 'experience') : undefined,
    slug: stop.entry ? routeSlug(stop.entry as any) : undefined,
    title: stop.label === 'Stop' ? (stop.note || 'Unscheduled stop') : stop.label,
    href: stop.href, note: stop.note,
  }))),
};

// ─── Display labels ───────────────────────────────────────────────────────
const duration = data ? deriveDuration(data) : null;
const audienceText = data ? (audienceDisplay[data.audience] ?? titleize(data.audience)) : '';
const themeText = data
  ? ((data as any).theme ?? []).map((t: string) => themeLabel[t] ?? t).filter(Boolean).join(' · ')
  : '';
const occasionText = data ? (occasionLabel[(data as any).occasion ?? 'none'] || '') : '';
const seasonText = data ? ((data as any).bestSeasonNote || seasonLabel[(data as any).season ?? 'year-round'] || '') : '';
const budgetText = data ? (budgetLabel[(data as any).budget ?? 'mixed'] || '') : '';
const nightsLabel = data ? `${data.lengthNights} night${data.lengthNights === 1 ? '' : 's'}` : '';
const durationText = duration ? durationLabel[duration] ?? duration : nightsLabel;

// ─── Anatomy gates (only render the section if data exists) ───────────────
const showEditorialFrame = data ? Boolean((data as any).editorialFrame) : false;
const showVariations = data ? Array.isArray((data as any).variations) && (data as any).variations.length > 0 : false;
const showSkipThese = data ? Boolean((data as any).skipThese) : false;
const showCostBreakdown = data ? Boolean((data as any).costBreakdown) : false;
const showChecklist = data ? Array.isArray((data as any).bookingChecklist) && (data as any).bookingChecklist.length > 0 : false;
const showFaq = data ? Array.isArray((data as any).faq) && (data as any).faq.length > 0 : false;

// ─── Schema (TouristTrip + FAQPage + BreadcrumbList) ──────────────────────
const schemaDays = groupedStops.map((g) => ({
  name: `Day ${g.day}`,
  stops: g.stops
    .filter((s) => s.label && s.href)
    .map((s) => ({
      name: s.label,
      path: s.href!,
      stopType: s.entry && isStayVenue(s.entry)
        ? 'LodgingBusiness'
        : (s.entry as any)?.data?.type === 'restaurant' || (s.entry as any)?.data?.type === 'cafe'
        ? 'FoodEstablishment'
        : 'TouristAttraction',
    })),
}));

const lastVerified = informationCheckedOn(data)?.toISOString().slice(0, 10);

const { tripSchema, breadcrumbSchema, faqSchema } = data
  ? buildEscapeItinerarySchema({
      slug,
      title: data.title,
      description: data.dek,
      audienceLabels: [audienceText],
      days: schemaDays,
      anchorStayPath: effectiveStayHref,
      datePublished: data.publishedAt instanceof Date ? data.publishedAt.toISOString().slice(0, 10) : undefined,
      dateModified: lastVerified,
      faq: showFaq ? (data as any).faq : undefined,
    })
  : { tripSchema: null, breadcrumbSchema: null, faqSchema: null };

const lastVerifiedLabel = lastVerified
  ? new Date(lastVerified).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

// ─── Misc ─────────────────────────────────────────────────────────────────
const breadcrumbItems = data
  ? [{ label: 'Home', href: '/' }, { label: 'Plans', href: '/explore/plans/' }, { label: data.title }]
  : [];
const canonical = data ? `https://peninsulainsider.com.au/explore/plans/${slug}/` : '';
const ogImage = data
  ? (itineraryHeroOverride?.src ?? (data.heroImage?.src && !data.heroImage.src.includes('placeholder') ? data.heroImage.src : '/images/sourced/home-cover.webp'))
  : '';
export const prerender = true;
---

{isArticle ? (
<BaseLayout
  title={`${ad.title} · Peninsula Insider`}
  description={ad.dek}
  section="explore"
  canonical={aCanonical}
  ogImage={aOgImage}
>
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {articleBreadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(articleBreadcrumbSchema)} />}
  {articleFaqSchema && <script type="application/ld+json" set:html={JSON.stringify(articleFaqSchema)} />}

  {/* ── 2026-05-17: Sunday-magazine redesign for section=plans articles.
       Replaces the generic .article-hero / .article-summary / .article-faq
       chrome (and an undefined .article-faq / .article-summary CSS class
       that was rendering near-default browser styles) with a quieter,
       editorial register: split-grid cover, numbered "at a glance" card,
       hairline-separated FAQ, "read alongside" cluster rail, and a venue
       grid below. All inline-edit hooks and JSON-LD schema preserved.
       Lifts ~20 plans articles, not just /explore/plans/the-thermal-springs-weekend/. */}

  <div class="pl-breadcrumbs">
    <Breadcrumbs items={aBreadcrumbs} />
  </div>

  <article class:list={['pl-article', isOneNightGuide && 'pl-article--one-night', hasPlanQuickChoices && 'pl-article--quick-choices']}>
    {/* ── Cover spread ──────────────────────────────────────────────── */}
    <header class="pl-cover" aria-label="Cover">
      <div class="pl-container pl-cover__inner">
        <div class="pl-cover__type">
          <p class="pl-eyebrow">{articleEyebrow}</p>
          <h1
            class:list={['pl-cover__headline', ad.title.length > 60 && 'pl-cover__headline--long', isOneNightGuide && 'pl-cover__headline--one-night', articleSlug === 'the-thermal-springs-weekend' && 'pl-cover__headline--springs-weekend']}
            {...editableText({
              entityType: 'article', entitySlug: articleSlug!, fieldPath: 'title',
              label: `${ad.title} - title`,
            })}
          >{ad.title}</h1>
          <p
            class="pl-cover__dek"
            {...editableText({
              entityType: 'article', entitySlug: articleSlug!, fieldPath: 'dek',
              label: `${ad.title} - dek`,
            })}
          >{ad.dek}</p>
          <div class="pl-cover__actions">
            <a class="pl-action pl-action--primary" href={articlePrimaryHref}>{articlePrimaryText} <span aria-hidden="true">↗</span></a>
            <a class="pl-action pl-action--quiet" href={articleSecondaryHref}>{articleSecondaryText} <span aria-hidden="true">→</span></a>
          </div>
          <p class="pl-cover__byline">
            <span>Peninsula Insider</span>
            <span class="pl-cover__sep" aria-hidden="true">·</span>
            <span>{ad.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </p>
        </div>
        <figure class="pl-cover__visual">
          <div class="pl-cover__frame">
            <img
              class="pl-cover__image"
              src={articleHero?.src ?? ad.heroImage.src}
              alt={articleHero?.alt ?? ad.heroImage.alt}
              width="1200"
              height="960"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-pi-responsive={articleHero?.src?.includes('/images/generated/coastal-punch-')
                ? '(max-width: 820px) 100vw, 1200px'
                : '(max-width: 820px) calc(100vw - 3rem), 500px'}
              data-pi-requires-image-metadata="true"
              data-pi-no-hydrate={incompleteArticleOverride && creditedArticleSource ? 'true' : undefined}
              {...editableImage({
                entityType: 'article', entitySlug: articleSlug!, fieldPath: 'heroImage',
                label: `${ad.title} hero`, purpose: 'hero',
              })}
            />
          </div>
          {(articlePhotoCaption || articlePhotoCredit) && (
            <figcaption class="pl-cover__caption">
              {articlePhotoCaption && <span>{articlePhotoCaption}{articlePhotoCredit && ' '}</span>}
              {articlePhotoCredit && <span>{articlePhotoCredit}</span>}
            </figcaption>
          )}
        </figure>
          <div class="pl-cover__reader-tools">
            <PiArticleActions
              kind="article"
              slug={articleSlug!}
              section="plans"
              title={ad.title}
              href={`/explore/plans/${articleSlug}/`}
              dek={ad.dek}
              imageUrl={articleHero?.src ?? ad.heroImage?.src}
            />
          </div>
      </div>
    </header>

    {ad.planQuickChoices && ad.planQuickChoices.length > 0 && (
      <section class="pl-decision" id="plan-start" aria-labelledby="pl-decision-title">
        <div class="pl-container">
          <div class="pl-decision__intro">
            <p class="pl-eyebrow">Start here</p>
            <h2 id="pl-decision-title">Choose a starting point</h2>
          </div>
          <div class="pl-decision__grid">
            {ad.planQuickChoices.map((choice, index) => (
              <a class="pl-decision__choice" href={choice.href}>
                <span class="pl-decision__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="pl-decision__copy">
                  <strong>{choice.label}</strong>
                  <span>{choice.detail}</span>
                </span>
                <span class="pl-decision__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          {ad.aiSummary && ad.aiSummary.length > 0 && (
            <details class="pl-decision__notes">
              <summary>More planning notes <span aria-hidden="true">+</span></summary>
              <ol>{ad.aiSummary.map((note) => <li>{note}</li>)}</ol>
            </details>
          )}
        </div>
      </section>
    )}

    {/* ── At-a-glance card - replaces "The short version" block ──────── */}
    {isOneNightGuide && (
      <section class="pl-choices" id="choose-your-base" aria-labelledby="pl-choices-title">
        <div class="pl-container">
          <div class="pl-choices__head">
            <p class="pl-eyebrow">Make one choice first</p>
            <h2 id="pl-choices-title">Which one-night escape feels like yours?</h2>
            <p>Keep the room, dinner and next morning in one area. The rest of the Peninsula can wait.</p>
          </div>
          <div class="pl-choices__grid">
            {oneNightBases.map((base) => (
              <div class="pl-choices__card">
                <span class="pl-choices__num">{base.number} / 03</span>
                <span class="pl-choices__place">{base.place}</span>
                <span class="pl-choices__mood">{base.mood}</span>
                <dl class="pl-choices__outline">
                  <div><dt>Stay</dt><dd>{base.stay}</dd></div>
                  <div><dt>Dinner</dt><dd>{base.dinner}</dd></div>
                  <div><dt>Sunday</dt><dd>{base.sunday}</dd></div>
                  <div><dt>Route</dt><dd>{base.check}</dd></div>
                </dl>
                <div class="pl-choices__actions">
                  <a class="pl-choices__stay" href={base.stayHref}>Explore {base.stay} <span aria-hidden="true">↗</span></a>
                  <a class="pl-choices__link" href={base.href}>See {base.place} plan <span aria-hidden="true">↗</span></a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

      {/* Keep bookable stay choices close to the route comparison. */}
    {isOneNightGuide && articleRelatedVenues.length > 0 && (
      <section class:list={["pl-venues", isOneNightGuide && "pl-venues--one-night"]}>
        <div class="pl-container">
          <header class="pl-venues__head">
            <p class="pl-eyebrow">Places in this plan</p>
            <h2 class="pl-venues__title">Stay in the base you choose.</h2>
          </header>
          <div class="pl-venues__grid">
            {articleRelatedVenues.map((venue: any) => (
              <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />
            ))}
          </div>
        </div>
      </section>
    )}


    {ad.aiSummary && ad.aiSummary.length > 0 && !ad.planQuickChoices?.length && (
      <section class="pl-glance" aria-label="At a glance">
        <div class="pl-container pl-glance__inner">
          <p class="pl-eyebrow pl-glance__eyebrow">At a glance</p>
          <div class="pl-glance__body">
            <ol class="pl-glance__list">
              {ad.aiSummary.slice(0, 3).map((item: string, i: number) => (
                <li class="pl-glance__item">
                  <span class="pl-glance__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="pl-glance__text">{item}</span>
                </li>
              ))}
            </ol>
            {isOneNightGuide && (
              <div class="pl-glance__next">
                <p><strong>Book first:</strong> one room and one dinner near it. Confirm availability, Sunday breakfast hours, walk access and weather for your dates; add a thermal session only if it fits the route.</p>
                <a href="/explore/plans/#build">Build your own trip <span aria-hidden="true">&rarr;</span></a>
              </div>
            )}
            {isOneNightGuide && (
              <details class="pl-glance__more pl-glance__sources">
                <summary>Plan facts and access links reviewed {articleFactReviewLabel} <span aria-hidden="true">+</span></summary>
                <p>We checked these operator and park pages for the options above:</p>
                <ul>
                  <li>Sorrento: <a href="https://sorrento.intercontinental.com/">InterContinental Sorrento</a>, <a href="https://thecontinentalsorrento.com.au/">The Continental precinct</a>, <a href="https://auroraspa.com.au/faqs/">Aurora</a> and <a href="https://www.parks.vic.gov.au/places-to-see/sites/sorrento-back-beach">Sorrento Back Beach</a></li>
                  <li>Red Hill: <a href="https://lancemore.com.au/hotels/lancemore-lindenderry-red-hill/">Lindenderry</a>, <a href="https://montalto.com.au/pages/cellar-door">Montalto</a> and <a href="https://www.tedesca.com.au/osteria-tedesca">Tedesca</a> for an extended Sunday</li>
                  <li>Flinders: <a href="https://flindershotel.com.au/">Flinders Hotel</a>, <a href="https://www.flinderssourdough.com.au/">Flinders Sourdough</a>, <a href="https://www.parks.vic.gov.au/projects/greater-melbourne/flinders-pier-project">Flinders Pier</a> and <a href="https://www.parks.vic.gov.au/projects/greater-melbourne/Flinders-Ocean-Beach-Car-Park-and-Track-Project">King Street access notice</a></li>
                  <li>Optional bath: <a href="https://albathermalsprings.com.au/alba-experiences/hot-springs/weekend-bathing/">Alba weekend bathing</a> and its <a href="https://albathermalsprings.com.au/faqs/">visitor FAQs</a></li>
                </ul>
                <p>Hours, availability and access can change. Confirm them for your travel dates.</p>
              </details>
            )}
            {ad.aiSummary.length > 3 && (
              <details class="pl-glance__more">
                <summary>More planning notes <span aria-hidden="true">+</span></summary>
                <ol class="pl-glance__list pl-glance__list--more" start="4">
                  {ad.aiSummary.slice(3, 5).map((item: string, i: number) => (
                    <li class="pl-glance__item">
                      <span class="pl-glance__num">{String(i + 4).padStart(2, '0')}</span>
                      <span class="pl-glance__text">{item}</span>
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </div>
        </div>
      </section>
    )}

    {/* The article keeps its editorial voice, with quick section links for readers planning on the move. */}
    <section class="pl-essay" id="plan-guide">
      <div class="pl-container pl-essay__inner">
        {articleSectionLinks.length > 2 && (
          <nav class="pl-contents" aria-label="In this guide">
            <p class="pl-eyebrow">In this guide</p>
            <div class="pl-contents__links">
              {articleSectionLinks.map((item) => <a href={item.href}>{item.label} <span aria-hidden="true">↗</span></a>)}
            </div>
          </nav>
        )}
        <div class="prose pl-prose has-drop-cap">
          <ArticleContent />
        </div>
      </div>
    </section>

    {isOneNightGuide && (
      <section class="pl-takeaway" aria-labelledby="pl-takeaway-title">
        <div class="pl-container pl-takeaway__inner">
          <div>
            <p class="pl-eyebrow">Take the trip</p>
            <h2 id="pl-takeaway-title">One room. One dinner. One slow morning.</h2>
            <p>Choose your area, reserve the stay and dinner, then check the current opening hours and conditions before you leave.</p>
            <p class="pl-takeaway__follow">Want another weekend idea later? <a href="#newsletter">Get The Insider Note</a>, our occasional email with picks from across the Peninsula. <a href="/whats-on/this-weekend/archive/">Read past picks</a>.</p>
          </div>
          <a class="pl-action pl-action--primary" href="/explore/plans/#build">Find a plan for your trip <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    )}

    {isOneNightGuide && <NewsletterBlock body={planNewsletterBody} />}

    {/* ── FAQ - hairline-separated open Q/A. No <details> by default;
         every question is visible because they are short and answer
         intent that brought the reader here. */}
    {ad.faq && ad.faq.length > 0 && (
      <section class="pl-faq" aria-labelledby="pl-faq-title">
        <div class="pl-container pl-faq__inner">
          <header class="pl-faq__header">
            <p class="pl-eyebrow">Questions readers actually ask</p>
            <h2 id="pl-faq-title" class="pl-faq__title">A few practical answers.</h2>
          </header>
          <dl class="pl-faq__list">
            {ad.faq.map((item: any) => (
              <div class="pl-faq__item">
                <dt class="pl-faq__q">{item.question}</dt>
                <dd class="pl-faq__a">{item.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {/* ── Read alongside - cluster links rail, quiet serif list ────── */}
    {ad.clusterLinks && ad.clusterLinks.length > 0 && (
      <section class="pl-cluster" aria-label="Read alongside">
        <div class="pl-container pl-cluster__inner">
          <p class="pl-eyebrow">Read alongside</p>
          <ul class="pl-cluster__list">
            {ad.clusterLinks.map((link: any) => (
              <li class="pl-cluster__item">
                <a class="pl-cluster__link" href={link.href}>
                  <span class="pl-cluster__label">{link.label}</span>
                  <span class="pl-cluster__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>

  {/* ── Places in this plan - venue grid, kept but re-scoped so it
       reads as a continuation of the editorial, not a fresh band. */}
  {!isOneNightGuide && articleRelatedVenues.length > 0 && (
    <section class:list={["pl-venues", isOneNightGuide && "pl-venues--one-night"]}>
      <div class="pl-container">
        <header class="pl-venues__head">
          <p class="pl-eyebrow">Places in this plan</p>
          <h2 class="pl-venues__title">Worth knowing before you go.</h2>
        </header>
        <div class="pl-venues__grid">
          {articleRelatedVenues.map((venue: any) => (
            <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />
          ))}
        </div>
      </div>
    </section>
  )}

  {!isOneNightGuide && <NewsletterBlock body={planNewsletterBody} />}
</BaseLayout>
) : (
<BaseLayout
  title={`${data!.title} - Mornington Peninsula Weekend Escape · Peninsula Insider`}
  description={data!.dek}
  section="explore"
  canonical={canonical}
  ogImage={ogImage}
  noindex={(data as any).sitemapExclude === true}
>
  <script type="application/ld+json" set:html={JSON.stringify(tripSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="itinerary-detail__breadcrumb"><Breadcrumbs items={breadcrumbItems} /></div>

  {/* ─── 1. Hero ──────────────────────────────────────────────────────── */}
  <section class="itinerary-detail">
    <div class="container">
      <div class="itinerary-detail__cover">
        <div class="itinerary-detail__intro">
      <div class="itinerary-detail__meta">
        <a href="/explore/plans/" class="itinerary-detail__back">Plans</a>
        <span class="itinerary-detail__dot" aria-hidden="true"></span>
        <span class="itinerary-detail__nights">{durationText}</span>
        {anchorTown && (
          <>
            <span class="itinerary-detail__dot" aria-hidden="true"></span>
            <a href={`/explore/places/${routeSlug(anchorTown)}/`} class="itinerary-detail__back">{(anchorTown as any).data.name}</a>
          </>
        )}
      </div>

      <h1 class="itinerary-detail__title" {...editableText({
        entityType: 'itinerary', entitySlug: slug, fieldPath: 'title',
        label: `${data!.title} - title`,
      })}>{data!.title}</h1>
      <p class="itinerary-detail__dek" {...editableText({
        entityType: 'itinerary', entitySlug: slug, fieldPath: 'dek',
        label: `${data!.title} - dek`,
      })}>{data!.dek}</p>

      <div class="itinerary-detail__chips">
        <span>{audienceText}</span>
        {themeText && <span>{themeText}</span>}
        {!themeText && <span>{moodLabel[data!.mood] ?? data!.mood}</span>}
        {occasionText && <span>{occasionText}</span>}
        {seasonText && seasonText !== 'Year-round' && <span>{seasonText}</span>}
        {data!.totalDriveMinutes && <span>About {data!.totalDriveMinutes} min driving (editorial estimate)</span>}
      </div>

      {/* The stay decision and My Trip action sit together. Multi-base
          routes lead to the full stay sequence below. */}
      <div class="itinerary-detail__cta-row">
        {hasMultipleStayBases ? (
          <a class="pi-btn pi-btn--solid" href="#where-to-stay">See both stays →</a>
        ) : effectiveStay && effectiveStayHref && (
          <a
            href={`${effectiveStayHref}?utm_source=peninsula-insider&utm_medium=escape&utm_campaign=${slug}&utm_content=hero`}
            class="pi-btn pi-btn--solid"
            data-event="escape_hero_anchor_stay_cta_click"
            data-itinerary={slug}
          >
            {slug === 'sorrento-off-season-weekend' ? 'Stay in Sorrento →' : 'Stay at ' + (effectiveStay as any).data.name + ' →'}
          </a>
        )}
        <PiForkPlanButton plan={forkPlan} variant={effectiveStay && effectiveStayHref ? "ghost" : "solid"} />
      </div>
      <nav class="itinerary-detail__jumps" aria-label="On this plan">
        <a href="#day-by-day">Day by day</a>
        {showChecklist && <a href="#booking-checklist">Before you book</a>}
        {(effectiveStay || stayRail.length > 0) && <a href="#where-to-stay">Where to stay</a>}
      </nav>
        </div>
        <div class="itinerary-detail__cover-media">
      {itineraryPhotos?.stage ? (
        <div data-pi-no-hydrate={incompleteItineraryOverride ? 'true' : undefined} {...editableImage({ entityType: 'itinerary', entitySlug: slug, fieldPath: 'heroImage', label: `${data!.title} hero`, purpose: 'hero' })}>
          <PhotoStage photos={itineraryPhotos.photos} subject={data!.title} id="photos" stageCaption="caption" />
        </div>
      ) : (
        <>
          <div
            class="itinerary-detail__hero feature__image-block feature__image-block--sand"
            role="img"
            aria-label={itineraryHeroOverride?.alt ?? data!.heroImage.alt}
            data-pi-no-hydrate={incompleteItineraryOverride ? 'true' : undefined}
            style={itineraryHeroOverride?.src
              ? `background-image: url('${itineraryHeroOverride.src.replace(/["\\]/g, (m: string) => `\\${m}`)}'); background-size: cover; background-position: center;`
              : heroBackgroundStyle(data!)}
            {...editableImage({
              entityType: 'itinerary', entitySlug: slug, fieldPath: 'heroImage',
              label: `${data!.title} hero`, purpose: 'hero',
            })}
          >
            <div class="itinerary-detail__hero-fog"></div>
            <span class="itinerary-detail__hero-label">{itineraryHeroOverride?.alt ?? data!.heroImage.alt}</span>
          </div>
          {(itineraryHeroOverride?.credit || data!.heroImage.credit) && (
            <p class="itinerary-detail__image-credit">
              {itineraryHeroOverride?.caption ?? data!.heroImage.caption ?? ''}
              {' · '}
              {itineraryHeroOverride?.credit ?? data!.heroImage.credit}
            </p>
          )}
          {(itineraryPhotos?.photos.length ?? 0) >= 3 && <PhotoStage photos={itineraryPhotos!.photos} subject={data!.title} id="photos" variant="strip" />}
        </>
      )}
        </div>
      </div>

      <nav class="itinerary-route" id="route-overview" aria-label="Route overview">
        <div class="itinerary-route__heading">
          <p class="itinerary-route__eyebrow">Your route</p>
          <h2>{groupedStops.length === 1 ? 'A day in sequence' : `${groupedStops.length} days, one connected journey`}</h2>
        </div>
        <ol class="itinerary-route__list">
          {routePreview.map((step) => (
            <li>
              <a href={step.href}>
                <span class="itinerary-route__number">{step.number}</span>
                <span class="itinerary-route__copy"><strong>{step.title}</strong><small>{step.detail}</small></span>
                <span class="itinerary-route__arrow" aria-hidden="true">↓</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="itinerary-detail__grid">
        {/* ─── 2. At-a-glance facts box ────────────────────────────── */}
        <aside class="facts">
          <p class="facts__title">At a glance</p>
          <p>Use this as a route, then confirm bookings, park access and weather for your dates. My Trip drive times cover mapped stops, excluding your journey here and home.</p>
          <dl>
            <dt>Duration</dt>
            <dd>{durationText}</dd>

            <dt>Best for</dt>
            <dd>{audienceText}{occasionText ? ` · ${occasionText}` : ''}</dd>

            {themeText && (
              <>
                <dt>Theme</dt>
                <dd>{themeText}</dd>
              </>
            )}

            {anchorTown && (
              <>
                <dt>{hasMultipleStayBases ? 'Starting base' : 'Base town'}</dt>
                <dd>{(anchorTown as any).data.name}</dd>
              </>
            )}

            {seasonText && (
              <>
                <dt>Best season</dt>
                <dd>{seasonText}</dd>
              </>
            )}

            {(data as any).walkingIntensity && (
              <>
                <dt>Walking</dt>
                <dd>{titleize((data as any).walkingIntensity)}</dd>
              </>
            )}

            {(data as any).drivingDistanceKm && (
              <>
                <dt>Driving</dt>
                <dd>{(data as any).drivingDistanceKm} km on-Peninsula</dd>
              </>
            )}

            {!(data as any).drivingDistanceKm && data!.totalDriveMinutes && (
              <>
                <dt>Driving</dt>
                <dd>About {data!.totalDriveMinutes} min (editorial estimate)</dd>
              </>
            )}

            {hasMultipleStayBases ? overnightStays.map((night) => night.stay && night.href && (
              <>
                <dt>Night {night.day}</dt>
                <dd><a href={night.href}>{(night.stay as any).data.name}</a></dd>
              </>
            )) : effectiveStay && effectiveStayHref && (
              <>
                <dt>Anchor stay</dt>
                <dd><a href={effectiveStayHref}>{(effectiveStay as any).data.name}</a></dd>
              </>
            )}

            {(data as any).budgetRangeAud && (
              <>
                <dt>Budget</dt>
                <dd>{(data as any).budgetRangeAud}</dd>
              </>
            )}

            {!((data as any).budgetRangeAud) && budgetText && (
              <>
                <dt>Budget</dt>
                <dd>{budgetText}</dd>
              </>
            )}

            <dt>Stops</dt>
            <dd>{data!.stops.length} sequenced stops</dd>
          </dl>

          {effectiveStayHref ? (
            <a
              class="facts__cta pi-btn pi-btn--ghost pi-btn--block"
              href={`${effectiveStayHref}?utm_source=peninsula-insider&utm_medium=escape&utm_campaign=${slug}&utm_content=facts`}
              data-event="escape_facts_anchor_stay_click"
              data-itinerary={slug}
            >
              {hasMultipleStayBases ? 'See first stay →' : 'Stay here →'}
            </a>
          ) : (
            <a class="facts__cta pi-btn pi-btn--ghost pi-btn--block" href="#day-by-day">Follow the route →</a>
          )}

          {lastVerifiedLabel && (
            <p class="facts__verified">Information checked {lastVerifiedLabel}</p>
          )}
        </aside>

        <div class="itinerary-detail__main">
          {/* ─── 3. Editorial frame ──────────────────────────────────── */}
          {showEditorialFrame && (
            <div class="prose itinerary-detail__editor-note">
              {(data as any).editorialFrame.split(/\n\n+/).map((paragraph: string) => (
                <p>{paragraph}</p>
              ))}
            </div>
          )}

          {/* Editor's note (legacy field - treat as supporting paragraphs) */}
          <div class="prose itinerary-detail__editor-note">
            {data!.editorNote.split(/\n\n+/).map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {/* ─── 5–6. Day-by-day plan ────────────────────────────────── */}
          <div class="stop-list" id="day-by-day">
            {groupedStops.map((group, idx) => {
              const isLastDay = idx === groupedStops.length - 1;
              const nightStay = overnightStays[idx];
              const nightVenue = nightStay?.stay;
              const nightHref = nightStay?.href;
              return (
                <section class="stop-day" id={`day-${group.day}`}>
                  <h2 class="stop-day__heading">
                    <span>Day {group.day}</span>
                    {data!.dayLabels?.[idx] && <span class="stop-day__label">{data!.dayLabels[idx]}</span>}
                  </h2>
                  <ol class="stop-day__stops">
                    {group.stops.map((stop) => (
                      <li class="stop-item" id={`stop-${group.day}-${stop.order}`}>
                        <div class="stop-item__time">
                          {stop.timeRange ?? (timeOfDayLabel[stop.timeOfDay] ?? titleize(stop.timeOfDay))}
                        </div>
                        <div>
                          <h3 class="stop-item__name">
                            {stop.href ? <a href={stop.href}>{stop.label}</a> : stop.label}
                          </h3>
                          {stop.note && <p class="stop-item__note">{stop.note}</p>}
                          {stop.practical && (
                            <p class="stop-item__practical"><em>{stop.practical}</em></p>
                          )}
                          {stop.driveMinutesToNext && (
                            <p class="stop-item__drive">About {stop.driveMinutesToNext} min drive to next stop (editorial estimate)</p>
                          )}
                        </div>
                      </li>
                    ))}
                  </ol>

                  {!isLastDay && nightVenue && nightHref && (
                    <aside class="where-you-sleep">
                      <p class="where-you-sleep__label">Night {group.day} · Where you sleep</p>
                      <p class="where-you-sleep__body">
                        {idx > 0 && overnightStays[idx - 1]?.stay &&
                          routeSlug(overnightStays[idx - 1].stay) === routeSlug(nightVenue)
                          ? 'Return to ' + (nightVenue as any).data.name + ' for your next night. Confirm dinner separately for your date.'
                          : 'Stay at ' + (nightVenue as any).data.name + ' tonight. Confirm check-in and dinner for your date before you travel.'}
                      </p>
                      <a
                        href={`${nightHref}?utm_source=peninsula-insider&utm_medium=escape&utm_campaign=${slug}&utm_content=inflow`}
                        class="pi-btn pi-btn--text"
                        data-event="escape_inflow_anchor_stay_click"
                        data-itinerary={slug}
                      >
                        See {(nightVenue as any).data.name} →
                      </a>
                    </aside>
                  )}
                </section>
              );
            })}
          </div>

          {/* ─── 6. Variations ───────────────────────────────────────── */}
          {showVariations && (
            <section class="variations">
              <h2 class="variations__heading">Variations</h2>
              <div class="variations__grid">
                {(data as any).variations.map((variation: any) => (
                  <article class="variation">
                    <h3 class="variation__label">{variation.label}</h3>
                    <p class="variation__body">{variation.body}</p>
                    {variation.relatedItinerary && (
                      <a class="variation__link" href={`/explore/plans/${variation.relatedItinerary}/`}>
                        See the full version →
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )}

          {/* ─── 7. Worth knowing before you plan ─────────────────────── */}
          {showSkipThese && (
            <section class="skip-these">
              <h2 class="skip-these__heading">Worth knowing before you plan</h2>
              <p class="skip-these__body">{(data as any).skipThese}</p>
            </section>
          )}

          {/* ─── 8. Cost band ────────────────────────────────────────── */}
          {showCostBreakdown && (
            <section class="cost-band">
              <h2 class="cost-band__heading">What this costs</h2>
              <dl class="cost-band__grid">
                {Object.entries((data as any).costBreakdown).map(([k, v]) =>
                  v ? (
                    <>
                      <dt>{k.charAt(0).toUpperCase() + k.slice(1)}</dt>
                      <dd>{v as string}</dd>
                    </>
                  ) : null
                )}
              </dl>
              {(data as any).budgetRangeAud && (
                <p class="cost-band__total">{(data as any).budgetRangeAud}</p>
              )}
            </section>
          )}

          {/* ─── 9. Booking checklist ────────────────────────────────── */}
          {showChecklist && (
            <section class="checklist" id="booking-checklist">
              <h2 class="checklist__heading">Booking checklist</h2>
              <ol class="checklist__list">
                {(data as any).bookingChecklist.map((row: any) => (
                  <li class={`checklist__item checklist__item--${row.priority}`}>
                    <span class="checklist__priority">{row.priority}</span>
                    <span class="checklist__text">{row.item}</span>
                    {row.windowWeeksAhead && (
                      <span class="checklist__window">{row.windowWeeksAhead} weeks ahead</span>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )}

          {/* ─── 10. FAQ ─────────────────────────────────────────────── */}
          {showFaq && (
            <section class="faq">
              <h2 class="faq__heading">Common questions</h2>
              <dl class="faq__list">
                {(data as any).faq.map((entry: any) => (
                  <div class="faq__item">
                    <dt class="faq__question">{entry.question}</dt>
                    <dd class="faq__answer">{entry.answer}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
        </div>


      </div>
    </div>
  </section>

  {/* ─── 9b. The scheduled stay or stays, followed by any alternatives */}
  {(effectiveStay || stayRail.length > 0) && (
    <section class="venues" id="where-to-stay">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Sleep here</p>
            <h2 class="venues__title">{hasMultipleStayBases ? 'Your two overnight bases' : 'Your base for this escape'}</h2>
          </div>
          <a href="/stay/" class="venues__link">All stays →</a>
        </div>
        <div class="venues__grid">
          {effectiveStay && <VenueCard venue={effectiveStay} hrefPrefix={venueHrefPrefix((effectiveStay as any).data.type)} />}
          {stayRail.map((venue: any) => (
            <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />
          ))}
        </div>
      </div>
    </section>
  )}

  {highlightedExperiences.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Move the trip outside</p>
            <h2 class="venues__title">Explore stops inside this plan</h2>
          </div>
          <a href="/explore/" class="venues__link">Explore →</a>
        </div>
        <div class="experience-grid">
          {highlightedExperiences.slice(0, 3).map((experience: any) => <ExperienceCard experience={experience} />)}
        </div>
      </div>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section class="venues venues--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Further reading</p>
            <h2 class="venues__title">Journal pieces that sharpen this version of the Peninsula</h2>
          </div>
          <a href="/journal/" class="venues__link">Journal →</a>
        </div>
        <div class="venues__grid venues__grid--two">
          {relatedArticles.map((article: any) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  {/* ─── 11. Related itineraries ─────────────────────────────────── */}
  {relatedItineraries.length > 0 && (
    <section class="escape-callout">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Try another shape</p>
            <h2 class="venues__title">More ways to explore the Peninsula</h2>
          </div>
          <a href="/explore/plans/" class="venues__link">All plans →</a>
        </div>
        <div class="itinerary-grid">
          {relatedItineraries.map((entry: any) => <ItineraryCard itinerary={entry} />)}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />
</BaseLayout>
)}

{/* ─────────────────────────────────────────────────────────────────────────
   Plans-article (Sunday-magazine) scoped styles. All selectors prefixed
   with .pl- so they cannot leak into the itinerary branch above or other
   global surfaces. .pl-prose overrides only happen within .pl-essay so
   the global .prose used by /journal/ etc remains untouched.
   ───────────────────────────────────────────────────────────────────── */}
<style is:global>
  .pl-container {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  /* Breadcrumbs sit on cream, quiet */
  .pl-breadcrumbs {
    background: var(--bg, #FFFFFF);
    padding-top: clamp(0.75rem, 2vw, 1.25rem);
  }
  .pl-breadcrumbs .breadcrumbs,
  .pl-breadcrumbs > div { max-width: 1180px; margin: 0 auto; padding-inline: clamp(1.5rem, 5vw, 4.5rem); }

  /* Type primitives shared across the plans-article */
  .pl-eyebrow {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(20, 32, 42, 0.7);
    margin: 0 0 1.5rem;
  }

  /* ── Cover spread ─────────────────────────────────────────────── */
  .pl-cover {
    background: #F2EFEA;
    padding: clamp(2.25rem, 4vw, 3.5rem) 0 clamp(3rem, 6vw, 5.5rem);
  }
  .pl-cover__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 5vw, 5.25rem);
    align-items: center;
  }
  .pl-cover__type { padding-block: clamp(0.5rem, 2vw, 2rem); }
  .pl-cover__headline {
    font-family: var(--font-display);
    font-size: clamp(2.45rem, 4.5vw, 4.35rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #0B2E4A;
    margin: 0 0 1.25rem;
    max-width: 18ch;
    text-wrap: balance;
  }
  .pl-cover__headline--long { font-size: clamp(2.2rem, 3.35vw, 3.3rem); max-width: 23ch; }
  @media (min-width: 821px) { .pl-cover__headline.pl-cover__headline--one-night { font-size: clamp(2.5rem, 4vw, 3.75rem); } }
  @media (min-width: 821px) { .pl-cover__headline.pl-cover__headline--springs-weekend { font-size: clamp(2.5rem, 4.15vw, 3.5rem); } }
  .pl-cover__headline em { font-style: normal; font-weight: 500; }
  .pl-cover__dek {
    font-family: var(--font-ui);
    font-style: normal;
    font-size: clamp(1.12rem, 1.45vw, 1.3rem);
    line-height: 1.5;
    color: #314858;
    margin: 0 0 1.65rem;
    max-width: 43ch;
  }
  .pl-cover__byline {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #455965;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .pl-cover__sep { color: rgba(20, 32, 42, 0.3); }
  .pl-cover__reader-tools { grid-column: 2; margin-top: 0.2rem; padding-top: 0.65rem; border-top: 1px solid rgba(11, 46, 74, 0.18); }
  .pl-cover__reader-tools .pi-article-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; width: 100%; }
  .pl-cover__reader-tools .pi-article-actions__hint { margin-right: auto; white-space: nowrap; color: #455965; }
  .pl-cover__reader-tools .text-scale { padding-left: 0.4rem; border-left: 1px solid rgba(11, 46, 74, 0.18); }
  .pl-cover__visual { margin: 0; }
  .pl-cover__frame { aspect-ratio: 5 / 4; overflow: hidden; background: #D7E3E9; }
  .pl-cover__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.01);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pl-cover__visual:hover .pl-cover__image { transform: scale(1.04); }
  .pl-venues--one-night .venue-card .venue-card__signature { display: block; -webkit-line-clamp: unset; line-clamp: unset; overflow: visible; min-height: 0; }
  .pl-venues--one-night .venue-card .venue-card__photo-credit { font-size: .84rem; line-height: 1.5; }
  .pl-venues--one-night .venue-card .venue-card__type { font-size: .76rem; letter-spacing: .12em; }
  .pl-cover__caption {
    display: flex;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    flex-wrap: wrap;
    padding-top: 0.65rem;
    font: 500 0.72rem/1.4 var(--font-ui);
    color: #49606D;
  }
  .pl-cover__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem 1.2rem; margin: 0 0 1.6rem; }
  .pl-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.75rem 1rem;
    font: 700 0.86rem/1.2 var(--font-ui);
    text-decoration: none;
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }
  .pl-action:hover { transform: translateY(-2px); }
  .pl-action--primary { background: #0B2E4A; color: #FFFFFF; border: 1px solid #0B2E4A; border-radius: 5px; }
  .pl-action--primary:hover { background: #10527E; color: #FFFFFF; }
  .pl-action--quiet { color: #0B2E4A; border-bottom: 1px solid #0B2E4A; }
  .pl-action--quiet:hover { color: #10527E; }

  /* ── A reader's first choice on service guides ────────────── */
  .pl-decision { background: #FFFFFF; padding: clamp(2rem, 4vw, 3rem) 0; border-bottom: 1px solid #DCE3E5; scroll-margin-top: 7rem; }
  .pl-decision__intro { margin-bottom: 1.4rem; }
  .pl-decision__intro .pl-eyebrow { margin-bottom: .4rem; }
  .pl-decision__intro h2 { margin: 0; font: 600 clamp(1.55rem, 2.3vw, 2rem)/1.16 var(--font-display); color: #0B2E4A; letter-spacing: -.02em; }
  .pl-decision__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .pl-decision__choice { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr) auto; align-items: start; gap: .7rem; min-height: 7.5rem; padding: 1rem .15rem; border-top: 1px solid #BACBD1; color: #14202A; text-decoration: none; }
  .pl-decision__choice:hover .pl-decision__arrow { transform: translate(2px, -2px); }
  .pl-decision__choice:focus-visible, .pl-decision__notes summary:focus-visible { outline: 3px solid #10527E; outline-offset: 3px; }
  .pl-decision__num { padding-top: .25rem; font: 700 .67rem/1.3 var(--font-ui); letter-spacing: .1em; color: #10527E; }
  .pl-decision__copy { display: grid; gap: .4rem; }
  .pl-decision__copy strong { font: 600 1.02rem/1.3 var(--font-display); color: #0B2E4A; }
  .pl-decision__copy > span { font: 400 .92rem/1.48 var(--font-ui); color: #3E5361; }
  .pl-decision__arrow { color: #10527E; font-size: 1.1rem; transition: transform .2s ease; }
  .pl-decision__notes { margin-top: .75rem; border-top: 1px solid #DCE3E5; }
  .pl-decision__notes summary { display: flex; align-items: center; justify-content: space-between; min-height: 44px; color: #10527E; cursor: pointer; font: 700 .85rem/1.3 var(--font-ui); list-style: none; }
  .pl-decision__notes summary::-webkit-details-marker { display: none; }
  .pl-decision__notes[open] summary span { transform: rotate(45deg); }
  .pl-decision__notes ol { margin: .25rem 0 0; padding: 0 0 0 1.3rem; columns: 2; column-gap: 2rem; }
  .pl-decision__notes li { break-inside: avoid; margin: 0 0 .65rem; font: 400 .9rem/1.5 var(--font-ui); color: #3E5361; }

  /* ── At-a-glance card ────────────────────────────────────────── */
  .pl-glance {
    background: #F2EFEA;
    padding: clamp(3rem, 6vw, 5.5rem) 0;
    border-top: 1px solid rgba(20, 32, 42, 0.08);
    border-bottom: 1px solid rgba(20, 32, 42, 0.08);
  }
  .pl-glance__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .pl-glance__eyebrow { margin: 0; padding-top: 0.4rem; }
  .pl-glance__body { min-width: 0; }
  .pl-glance__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .pl-glance__list--more { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.2rem; }
  .pl-glance__more { margin-top: 1.4rem; border-top: 1px solid rgba(20, 32, 42, 0.18); }
  .pl-glance__more summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 44px; cursor: pointer; color: #10527E; font: 700 .84rem/1.3 var(--font-ui); list-style: none; }
  .pl-glance__more summary::-webkit-details-marker { display: none; }
  .pl-glance__more[open] summary span { transform: rotate(45deg); }
  .pl-glance__sources p, .pl-glance__sources li { font: 400 .86rem/1.55 var(--font-ui); color: #3E5361; }
  .pl-glance__sources p { margin: .45rem 0 .65rem; }
  .pl-glance__sources ul { margin: 0 0 .65rem; padding-left: 1.3rem; }
  .pl-glance__sources li { margin: .3rem 0; }
  .pl-glance__sources a { color: #10527E; text-underline-offset: .18em; }
  .pl-glance__sources a:focus-visible { outline: 3px solid #10527E; outline-offset: 2px; }
  .pl-glance__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    align-content: start;
    border-top: 1px solid rgba(20, 32, 42, 0.18);
    padding-top: 1rem;
  }
  .pl-glance__num {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: #10527E;
  }
  .pl-glance__text {
    font-family: var(--font-ui);
    font-size: clamp(1.02rem, 1.12vw, 1.1rem);
    line-height: 1.55;
    color: rgba(20, 32, 42, 0.82);
  }

  /* ── Essay typography ────────────────────────────────────────── */
  .pl-glance__next { margin-top: 1.5rem; border-top: 1px solid rgba(20, 32, 42, 0.18); padding-top: 1rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1.5rem; }
  .pl-glance__next p { margin: 0; max-width: 55ch; font: 400 .92rem/1.5 var(--font-ui); color: #243746; }
  .pl-glance__next strong { color: #0B2E4A; }
  .pl-glance__next a { display: inline-flex; align-items: center; min-height: 44px; gap: .35rem; color: #10527E; font: 700 .84rem/1.3 var(--font-ui); text-underline-offset: .2em; }
  .pl-essay {
    background: #FFFFFF;
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(3rem, 6vw, 5rem);
    scroll-margin-top: 7rem;
  }
  .pl-essay__inner { display: block; }
  .pl-prose {
    max-width: 36rem;
    margin: 0 auto;
    font-family: var(--font-ui);
    font-size: clamp(1.08rem, 1.2vw, 1.18rem);
    line-height: 1.72;
    color: #243746;
    font-weight: 400;
  }
  .pl-prose h2[id], .pl-prose h3[id] { scroll-margin-top: 7rem; }
  .pl-prose p { margin: 0 0 1.25rem; }
  .pl-prose h2 {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 2.8vw, 2.4rem);
    font-weight: 500;
    line-height: 1.1;
    color: #14202A;
    letter-spacing: -0.012em;
    margin: clamp(3rem, 5vw, 4.5rem) 0 1.25rem;
    max-width: 24ch;
    text-wrap: balance;
  }
  .pl-prose h3 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.8vw, 1.6rem);
    font-weight: 500;
    color: #14202A;
    margin: 2.5rem 0 1rem;
  }
  .pl-prose strong { font-weight: 600; color: #14202A; }
  .pl-prose em { font-style: normal; }
  .pl-prose a {
    color: #14202A;
    text-decoration: none;
    border-bottom: 1px solid rgba(20, 32, 42, 0.35);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .pl-prose a:hover {
    color: #10527E;
    border-bottom-color: #10527E;
  }
  .pl-prose a:focus-visible, .pl-contents a:focus-visible, .pl-choices__actions a:focus-visible, .pl-action:focus-visible {
    outline: 3px solid #10527E;
    outline-offset: 3px;
  }
  .pl-prose blockquote {
    border-left: none;
    margin: 2.5rem 0;
    padding: 0;
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(1.4rem, 2vw, 1.65rem);
    line-height: 1.45;
    color: rgba(20, 32, 42, 0.78);
    text-align: center;
    max-width: 28ch;
    margin-inline: auto;
  }
  .pl-prose ul,
  .pl-prose ol {
    margin: 0 0 1.5rem;
    padding-left: 1.4rem;
  }
  .pl-prose li {
    margin: 0 0 0.65rem;
    line-height: 1.6;
  }
  /* Drop cap upgrade - slightly larger to match the heavier serif body */
  .pl-prose.has-drop-cap > p:first-of-type::first-letter {
    font-size: 5.4em;
    color: #14202A;
    font-weight: 500;
    padding: 0.14em 0.18em 0 0;
  }
  /* Tables inside plans articles inherit the global treatment which
     already looks clean - keep them on a sans face for tabular legibility. */
  .pl-prose table {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.55;
    color: #243746;
    margin: 2rem 0 2.75rem;
    border-collapse: collapse;
    width: 100%;
  }
  .pl-prose table thead th {
    text-align: left;
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(20, 32, 42, 0.65);
    padding: 0.4rem 1rem 0.85rem;
    border-bottom: 1.5px solid #14202A;
  }
  .pl-prose table tbody td {
    padding: 0.95rem 1rem;
    border-bottom: 1px solid rgba(20, 32, 42, 0.1);
    vertical-align: top;
  }
  .pl-prose table thead th:first-child,
  .pl-prose table tbody td:first-child { padding-left: 0; }
  .pl-prose table thead th:last-child,
  .pl-prose table tbody td:last-child { padding-right: 0; }

  .pl-choices { background: #0B2E4A; color: #FFFFFF; padding: clamp(3.5rem, 6vw, 5rem) 0; scroll-margin-top: 7rem; }
  .pl-choices .pl-eyebrow { color: #F5C177; margin-bottom: 0.85rem; }
  .pl-choices__head { max-width: 42rem; margin-bottom: 2rem; }
  .pl-choices__head h2 { font: 700 clamp(2rem, 3vw, 2.7rem)/1.13 var(--font-display); color: #FFFFFF; letter-spacing: -.025em; margin: 0 0 1rem; text-wrap: balance; }
  .pl-choices__head p:last-child { font: 400 1.1rem/1.55 var(--font-ui); color: #D9E6EC; max-width: 55ch; margin: 0; }
  .pl-choices__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .pl-choices__card { display: flex; flex-direction: column; min-height: 20rem; padding: clamp(1.4rem, 2vw, 2rem); color: #14202A; background: #F2EFEA; }
  .pl-choices__num { font: 700 .68rem/1 var(--font-ui); letter-spacing: .16em; color: #10527E; margin-bottom: 1.2rem; }
  .pl-choices__place { font: 700 clamp(1.45rem, 2.2vw, 1.9rem)/1.16 var(--font-display); margin-bottom: .35rem; }
  .pl-choices__mood { font: 700 .8rem/1.3 var(--font-ui); color: #8B561C; text-transform: uppercase; letter-spacing: .1em; }
  .pl-choices__outline { margin: 1.15rem 0 1.25rem; border-top: 1px solid #B9C6C8; }
  .pl-choices__outline div { display: grid; grid-template-columns: 4.2rem minmax(0, 1fr); gap: .5rem; padding: .48rem 0; border-bottom: 1px solid #D0D8D8; }
  .pl-choices__outline dt { font: 700 .82rem/1.4 var(--font-ui); text-transform: uppercase; letter-spacing: .08em; color: #10527E; }
