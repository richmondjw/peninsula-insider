---
import { pageImage } from '../../../lib/page-images';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlanContextEngine from '../../../components/v5/plans/PlanContextEngine.astro';
import PlanBuilder from '../../../components/v5/plans/PlanBuilder.astro';
import PlanIndexRows from '../../../components/v5/plans/PlanIndexRows.astro';
import PlanFinderGuide from '../../../components/v5/plans/PlanFinderGuide.astro';
import PlanNextStep from '../../../components/v5/plans/PlanNextStep.astro';
import { buildPlansModel } from '../../../components/v5/plans/plans-data';
import HubEntry from '../../../components/v5/hub/HubEntry.astro';
import { spanOf } from '../../../lib/checked-span';
const model = await buildPlansModel();
const itineraries = model.plans.filter(plan => plan.kind === 'itinerary').sort((a,b) => b.editorialPriority - a.editorialPriority);
const pick = itineraries[0];
const planChecked = spanOf(itineraries.map(plan => plan.verifiedAt));
const catalogue = [
  ...model.plans.filter(plan => plan.kind === 'itinerary').sort((a,b) => b.editorialPriority - a.editorialPriority),
  ...model.plans.filter(plan => plan.kind === 'guide').sort((a,b) => a.displayTitle.localeCompare(b.displayTitle)),
];
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Mornington Peninsula itineraries and planning guides',
  numberOfItems: model.plans.length,
  itemListElement: catalogue.map((plan,i) => ({
    '@type': 'ListItem', position:i+1, name:plan.title, url:`https://peninsulainsider.com.au${plan.href}`,
  })),
};
export const prerender = true;
---
<BaseLayout title="Mornington Peninsula Plans and Plan Finder · Peninsula Insider" description="Filter Mornington Peninsula plans by trip length, who’s coming and what you’re into, or pick one of our editors’ ready-made days and weekends and make it yours in My Trip." section="explore" canonical="https://peninsulainsider.com.au/explore/plans/" ogImage={pageImage('plans-hub').src}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <!-- One opening (headline, standfirst, matcher, editor's pick), then the other itineraries, guides, the finder said plainly as a table, and a quiet close. -->
  {pick?.image ? <HubEntry
    kicker="Plans"
    title="Don’t plan. Pick one of ours."
    dek={`Ready-made days and weekends with the stops in order. Our first-visit pick runs from the Red Hill ridge to Point Nepean${pick.dayCount ? ` over ${pick.dayCount} days` : ''}.`}
    primary={{ label: `See the ${pick.displayTitle} plan`, href: pick.href }}
    secondary={{ label: `Browse all plans`, href: '#all-plans', arrow: 'down' }}
    trust={planChecked ? `Every plan ${planChecked}. Chosen by our editors, never paid for.` : 'Chosen by our editors, never paid for.'}
    image={pageImage('plans-hero')}
    focal={{ desktop: '50% 70%', mobile: '50% 72%' }}
    headingId="plans-title"
  /> : <h1 class="container">Don’t plan. Pick one of ours.</h1>}
  <PlanIndexRows model={model} pickInGrid={Boolean(pick?.image)}>
    <PlanBuilder slot="matcher" model={model} />
    <PlanContextEngine model={model} />
  </PlanIndexRows>
  <PlanFinderGuide model={model} />
  <PlanNextStep />
</BaseLayout>
<style>
  h1{font-weight:500;line-height:1.05;font-family:var(--font-display);letter-spacing:-.035em;margin:0;max-width:17ch}
  .plans-intro{max-width:44ch;margin:var(--space-4) 0 var(--space-2);font:var(--fs-400)/1.6 var(--font-ui);color:var(--text)}
  /* Phones: the trust line already says what the page holds; the editor's pick and its button reach the first screen. */
  @media(max-width:45rem){.plans-intro{display:none}}
</style>
