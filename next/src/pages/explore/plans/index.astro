---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlanContextEngine from '../../../components/v5/plans/PlanContextEngine.astro';
import PlanBuilder from '../../../components/v5/plans/PlanBuilder.astro';
import PlanIndexRows from '../../../components/v5/plans/PlanIndexRows.astro';
import PlanNextStep from '../../../components/v5/plans/PlanNextStep.astro';
import { buildPlansModel } from '../../../components/v5/plans/plans-data';
const model = await buildPlansModel();
const catalogue = [
  ...model.plans.filter(plan => plan.kind === 'itinerary').sort((a,b) => b.editorialPriority - a.editorialPriority),
  ...model.plans.filter(plan => plan.kind === 'guide').sort((a,b) => a.displayTitle.localeCompare(b.displayTitle)),
];
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Mornington Peninsula itineraries and planning guides',
  numberOfItems: model.plans.length,
  itemListElement: catalogue.map((plan,i) => ({
    '@type': 'ListItem', position:i+1, name:plan.title, url:`https://peninsulainsider.com.au${plan.href}`,
  })),
};
export const prerender = true;
---
<BaseLayout title="Mornington Peninsula Plans · Peninsula Insider" description="Choose a Peninsula day or weekend, with editorial itineraries, clear routes and practical planning guides. Use an itinerary in My Trip and make it yours." section="explore" canonical="https://peninsulainsider.com.au/explore/plans/" ogImage="/images/sourced/article-sunset-01.webp">
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <header class="plans-hero">
    <div class="container">
      <p class="plans-hero__eyebrow">The Peninsula, already considered</p>
      <div class="plans-hero__row">
        <h1>Don’t plan.<br />Pick one of ours.</h1>
        <div class="plans-hero__intro"><p>A good day starts with a few good decisions. We’ve put the stops in order. Choose the one that suits you, then make it your own.</p><a href="#all-plans">Browse the itineraries <span aria-hidden="true">↓</span></a></div>
      </div>
    </div>
  </header>
  <PlanBuilder model={model} />
  <PlanContextEngine model={model} />
  <PlanIndexRows model={model} />
  <PlanNextStep />
</BaseLayout>
<style>
  .plans-hero{padding:clamp(2rem,5vw,4rem) 0 2.5rem}
  .plans-hero__eyebrow{font:600 .7rem/1.5 var(--font-ui);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 1.15rem}
  .plans-hero__row{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:2rem;align-items:end}
  h1{font:500 clamp(2.5rem,5.4vw,4.8rem)/1.05 var(--font-display);letter-spacing:-.055em;margin:0;max-width:17ch}
  .plans-hero__intro{max-width:39ch;padding-bottom:.25rem}
  .plans-hero__intro p{font:1.05rem/1.7 var(--font-ui);margin:0 0 1rem;color:var(--soft)}
  .plans-hero__intro a{font-size:.85rem;font-weight:600;text-underline-offset:.2em}
  @media(max-width:45rem){.plans-hero{padding:1.6rem 0 1.7rem}.plans-hero__row{grid-template-columns:1fr;gap:1.1rem}.plans-hero__eyebrow{font-size:.62rem;margin-bottom:.8rem}h1{font-size:2.65rem}.plans-hero__intro{max-width:43ch}.plans-hero__intro p{font-size:.95rem;margin-bottom:.8rem}}
</style>
