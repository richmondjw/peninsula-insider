---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideHero from '../../components/GuideHero.astro';
import CompareBlock from '../../components/CompareBlock.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import {
  buildCollectionPageSchema,
  buildItemListSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';
import { routeSlug } from '../../lib/editorial';

// ── Editorial-card hero lookup ────────────────────────────────────────────────
// Cards in section 8 ("Golf editorial") all link to journal articles. Their
// background image is bound to each article's heroImage so editors can change
// the card art by editing the article's frontmatter, with the hardcoded path
// retained as a build-time fallback.
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
async function resolveArticleHero(slug: string, fallback: string): Promise<string> {
  const local = allArticles.find((a) => routeSlug(a) === slug);
  return (local?.data as any)?.heroImage?.src ?? fallback;
}
const heroGolfGuide = await resolveArticleHero(
  'mornington-peninsula-golf-guide',
  '/images/sourced/golf-rye-sunrise-01.webp',
);
const heroGolfTier = await resolveArticleHero(
  'best-golf-courses-mornington-peninsula',
  '/images/sourced/golf-rye-sunrise-01.webp',
);
const heroGolfStayPlay = await resolveArticleHero(
  'mornington-peninsula-golf-stay-and-play',
  '/images/sourced/article-sorrento-weekend-01.webp',
);
const heroStAndrews = await resolveArticleHero(
  'st-andrews-beach-golf-course',
  '/images/sourced/place-cape-schanck-01.webp',
);

// ── Load golf courses from experiences collection ─────────────────────────────
const allExperiences = await getCollection('experiences');
const golfCourses = allExperiences.filter(e => e.data.type === 'golf-course');

// Cape Schanck / Fingal cluster - editorial order
const capeOrder = [
  'moonah-links',
  'st-andrews-beach-golf-course',
  'the-national-golf-club',
  'racv-cape-schanck-golf-course',
];
const capeCourses = capeOrder
  .map(s => golfCourses.find(e => (e.data.slug ?? e.id) === s))
  .filter(Boolean) as typeof golfCourses;

// Bay Corridor - editorial order
const bayOrder = [
  'flinders-golf-club',
  'eagle-ridge-golf-course',
  'the-dunes-golf-links',
  'mornington-golf-club',
  'rosebud-country-club',
  'sorrento-golf-club',
  'portsea-golf-club',
];
const bayCourses = bayOrder
  .map(s => golfCourses.find(e => (e.data.slug ?? e.id) === s))
  .filter(Boolean) as typeof golfCourses;

// ── Helpers ───────────────────────────────────────────────────────────────────
function accessLabel(access: string) {
  const map: Record<string, string> = {
    public: 'Public green fees',
    'semi-private': 'Semi-private',
    private: 'Private - members',
  };
  return map[access] ?? access;
}
function accessMod(access: string) {
  const map: Record<string, string> = {
    public: 'golf-badge--public',
    'semi-private': 'golf-badge--semi',
    private: 'golf-badge--private',
  };
  return map[access] ?? '';
}
function tierLabel(tier: string) {
  const map: Record<string, string> = {
    'tier-1': 'Tier 1',
    'tier-2': 'Tier 2',
    'tier-3': 'Tier 3',
  };
  return map[tier] ?? '';
}
function tierMod(tier: string) {
  const map: Record<string, string> = {
    'tier-1': 'golf-tier--1',
    'tier-2': 'golf-tier--2',
    'tier-3': 'golf-tier--3',
  };
  return map[tier] ?? '';
}
// Return first N sentences of a string
function firstSentences(text: string, n = 3): string {
  if (!text) return '';
  const sentences = text.match(/[^.!?]+[.!?]+/g) ?? [];
  return sentences.slice(0, n).join(' ').trim();
}
function hasRanking(course: (typeof golfCourses)[0]): boolean {
  const rankings = course.data.golf?.rankings;
  return Array.isArray(rankings) && rankings.length > 0;
}

// ── JSON-LD schemas ───────────────────────────────────────────────────────────
const collectionSchema = buildCollectionPageSchema({
  name: 'Mornington Peninsula Golf Courses - Peninsula Insider',
  description: 'All 11 Mornington Peninsula golf courses ranked. Public vs private, what to book, best value, best views.',
  path: '/explore/golf',
  dateModified: '2026-04-30',
});
const itemListSchema = buildItemListSchema({
  name: 'Mornington Peninsula Golf Courses',
  description: '11 Mornington Peninsula golf courses ranked by editorial value.',
  listPath: '/explore/golf',
  items: [
    { name: 'Moonah Links', path: '/explore/moonah-links', itemType: 'GolfCourse', addressLocality: 'Fingal' },
    { name: 'St Andrews Beach Golf Course', path: '/explore/st-andrews-beach-golf-course', itemType: 'GolfCourse', addressLocality: 'Fingal' },
    { name: 'The National Golf Club', path: '/explore/the-national-golf-club', itemType: 'GolfCourse', addressLocality: 'Cape Schanck' },
    { name: 'RACV Cape Schanck Resort Golf Course', path: '/explore/racv-cape-schanck-golf-course', itemType: 'GolfCourse', addressLocality: 'Cape Schanck' },
    { name: 'Flinders Golf Club', path: '/explore/flinders-golf-club', itemType: 'GolfCourse', addressLocality: 'Flinders' },
    { name: 'Eagle Ridge Golf Course', path: '/explore/eagle-ridge-golf-course', itemType: 'GolfCourse', addressLocality: 'Merricks North' },
    { name: 'The Dunes Golf Links', path: '/explore/the-dunes-golf-links', itemType: 'GolfCourse', addressLocality: 'Rye' },
    { name: 'Mornington Golf Club', path: '/explore/mornington-golf-club', itemType: 'GolfCourse', addressLocality: 'Mornington' },
    { name: 'Rosebud Country Club', path: '/explore/rosebud-country-club', itemType: 'GolfCourse', addressLocality: 'Rosebud' },
    { name: 'Sorrento Golf Club', path: '/explore/sorrento-golf-club', itemType: 'GolfCourse', addressLocality: 'Sorrento' },
    { name: 'Portsea Golf Club', path: '/explore/portsea-golf-club', itemType: 'GolfCourse', addressLocality: 'Portsea' },
  ],
});
const faqSchema = buildFaqSchema([
  {
    q: 'What is the best golf course on the Mornington Peninsula?',
    a: "Moonah Links Open Course for championship pedigree and public access. St Andrews Beach for Tom Doak architecture and world-ranking credentials at a public green fee. The National Ocean Course for prestige - the most cited, most photographed, and most expensive.",
  },
  {
    q: 'Can you play golf on the Mornington Peninsula without a club membership?',
    a: 'Yes. Moonah Links, St Andrews Beach, RACV Cape Schanck, Eagle Ridge, The Dunes, Mornington, and Rosebud Country Club all accept visitor green fees. Flinders and Sorrento accept visitors on non-competition days - call ahead.',
  },
  {
    q: 'How much does golf cost on the Mornington Peninsula?',
    a: 'Green fees vary significantly by course and season. The National and St Andrews Beach are at the premium end. Mornington Golf Club, Rosebud Country Club, and The Dunes are the most accessible options for budget-conscious visitors.',
  },
  {
    q: 'Is there accommodation near the Peninsula golf courses?',
    a: 'RACV Cape Schanck Resort is on-site. Moonah Links has on-property accommodation with stay-and-play packages. For the bay corridor clubs, Mornington and Sorrento both have accommodation within 15 minutes of most courses.',
  },
  {
    q: 'What is the difference between the Cape Schanck and bay corridor courses?',
    a: 'The Cape Schanck / Fingal cluster contains the Peninsula\'s world-ranked courses - St Andrews Beach, Moonah Links, and The National. The bay corridor runs from Mornington to Portsea, with more accessible public clubs, different terrain, and generally lower green fees. Both are worth playing; they serve different trips.',
  },
]);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Golf' },
]);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore' },
  { label: 'Golf' },
];
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Golf - 11 Courses Ranked · Peninsula Insider"
  description="All 11 Mornington Peninsula golf courses assessed - Cape Schanck cluster, bay corridor, public green fees, stay-and-play options, and which course suits your game."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/golf/"
  ogImage="/images/sourced/golf-rye-sunrise-01.webp"
  modifiedTime="2026-04-30"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <!-- ═══════════════════════════════════════════════════════════════
       1. CINEMATIC HERO
       ═══════════════════════════════════════════════════════════════ -->
  <GuideHero
    eyebrow="Explore guide"
    title="Mornington Peninsula <em>Golf</em>"
    dek="Australia's most concentrated cluster of serious public-access golf. Three world-ranked courses within 10 minutes of each other, all within 90 minutes of Melbourne."
    meta={[{ label: '3 world-ranked' }, { label: '12 min read' }]}
    heroImage="/images/sourced/golf-rye-sunrise-01.webp"
    imageAlt="Coastal golf landscape on the Mornington Peninsula at sunrise"
    imageCredit="Peninsula Insider"
    entitySlug="explore/golf"
  />

  <!-- ═══════════════════════════════════════════════════════════════
       2. ORIENTATION: Cape Schanck vs Bay Corridor
       ═══════════════════════════════════════════════════════════════ -->
  <CompareBlock
    eyebrow="Two distinct golf corridors"
    heading="Cape Schanck or the Bay Corridor"
    dek="Both are worth a day. They are not interchangeable. The frame that matters before you book."
    left={{
      label: 'Cape Schanck / Fingal',
      title: 'World-ranked. Exposed. Worth the drive to the tip.',
      rows: [
        { label: 'Flagship courses', value: 'St Andrews Beach (Tom Doak), Moonah Links (Peter Thomson), The National (Trent Jones Jr, Thomson, Greg Norman) - three of The National\'s four courses sit here; the fourth, Long Island, is at Frankston.' },
        { label: 'Access', value: 'St Andrews Beach and Moonah Links are fully public. The National\'s four courses are private members-only across both the Cape Schanck and Long Island sites.' },
        { label: 'Conditions', value: 'Coastal duneland. Exposed to Bass Strait wind. The same course plays differently on every visit.' },
        { label: 'Best for', value: 'Serious golfers. Destination weekends. Groups who want the bucket-list round. Stay-and-play packages.' },
        { label: 'Combine with', value: 'Peninsula Hot Springs (15 min). Cape Schanck boardwalk. Fingal or Flinders for lunch.' },
      ],
    }}
    right={{
      label: 'Bay Corridor - Mornington to Portsea',
      title: 'Accessible. Views. A round without the expedition.',
      rows: [
        { label: 'Standout courses', value: 'Flinders Golf Club (clifftop nine over Bass Strait, still under-visited), The Dunes (Tony Cashmore links design), Eagle Ridge (Red Hill hinterland)' },
        { label: 'Access', value: 'Mostly public or semi-private. Mornington, Eagle Ridge, The Dunes, and Rosebud all take visitor green fees without calling ahead.' },
        { label: 'Conditions', value: 'Mixed terrain - clifftop views at Flinders, genuine links dunes at Rye, parkland at Merricks. More sheltered than the Cape.' },
        { label: 'Best for', value: 'Day trips from Melbourne. Pairing with a Red Hill winery lunch. Social and high-handicap groups who want a good day without a premium price.' },
        { label: 'Combine with', value: 'Red Hill and Main Ridge wineries. Flinders Hotel or the Mornington foreshore. Rosebud for affordable replay.' },
      ],
    }}
  />

  <!-- ═══════════════════════════════════════════════════════════════
       3. CAPE SCHANCK / FINGAL CLUSTER
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index" aria-label="Cape Schanck golf courses">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Cape Schanck / Fingal cluster</p>
          <h2 class="venues__title">The world-class courses</h2>
          <p class="venues__sub">Four courses within 15 minutes of each other at the Peninsula's southern tip. Two of the four are world-ranked. Three accept public green fees.</p>
        </div>
      </div>
      <div class="golf-grid golf-grid--cape">
        {capeCourses.map((course) => {
          const d = course.data;
          const g = d.golf ?? {};
          const slug = d.slug ?? course.id;
          const designers = Array.isArray(g.designers) ? g.designers.join(', ') : null;
          const ranked = hasRanking(course);
          return (
            <article class="golf-card">
              <div class="golf-card__header">
                <div class="golf-card__badges">
                  <span class={`golf-badge golf-badge--access ${accessMod(g.access)}`}>{accessLabel(g.access)}</span>
                  {g.tier && <span class={`golf-badge golf-badge--tier ${tierMod(g.tier)}`}>{tierLabel(g.tier)}</span>}
                  {ranked && <span class="golf-badge golf-badge--ranked">✦ Ranked</span>}
                </div>
                <div class="golf-card__holes">{g.holes ? `${g.holes} holes` : ''}</div>
              </div>
              <div class="golf-card__body">
                <h3 class="golf-card__name">
                  <a href={`/explore/${slug}/`}>{d.name}</a>
                </h3>
                <p class="golf-card__meta">
                  {d.address?.split(',')[1]?.trim() ?? d.place}
                  {designers && <span class="golf-card__designers"> · {designers}</span>}
                </p>
                {ranked && g.rankings && (
                  <p class="golf-card__ranking">{g.rankings[0]}</p>
                )}
                <p class="golf-card__note">{firstSentences(d.editorNote, 3)}</p>
                {g.localRead && (
                  <p class="golf-card__local"><span class="golf-card__local-tag">Insider read</span>{g.localRead}</p>
                )}
              </div>
              <div class="golf-card__footer">
                <a href={`/explore/${slug}/`} class="golf-card__cta">Course guide →</a>
                {g.bookingUrl && g.access !== 'private' && (
                  <a href={g.bookingUrl} class="golf-card__book" target="_blank" rel="noopener">Book a round →</a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       4. BAY CORRIDOR
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index experience-index--plain" aria-label="Bay corridor golf courses">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Bay corridor · Mornington to Portsea</p>
          <h2 class="venues__title">The accessible round</h2>
          <p class="venues__sub">Seven courses running the length of the bay side. Clifftop views at Flinders, links dunes at Rye, parkland at Merricks. Mostly public access, mostly lower green fees.</p>
        </div>
      </div>
      <div class="golf-grid golf-grid--bay">
        {bayCourses.map((course) => {
          const d = course.data;
          const g = d.golf ?? {};
          const slug = d.slug ?? course.id;
          const designers = Array.isArray(g.designers) ? g.designers.join(', ') : null;
          const ranked = hasRanking(course);
          return (
            <article class="golf-card golf-card--bay">
              <div class="golf-card__header">
                <div class="golf-card__badges">
                  <span class={`golf-badge golf-badge--access ${accessMod(g.access)}`}>{accessLabel(g.access)}</span>
                  {g.tier && <span class={`golf-badge golf-badge--tier ${tierMod(g.tier)}`}>{tierLabel(g.tier)}</span>}
                  {ranked && <span class="golf-badge golf-badge--ranked">✦ Ranked</span>}
                </div>
                <div class="golf-card__holes">{g.holes ? `${g.holes} holes` : ''}</div>
              </div>
              <div class="golf-card__body">
                <h3 class="golf-card__name">
                  <a href={`/explore/${slug}/`}>{d.name}</a>
                </h3>
                <p class="golf-card__meta">
                  {d.address?.split(',')[1]?.trim() ?? d.place}
                  {designers && <span class="golf-card__designers"> · {designers}</span>}
                </p>
                {ranked && g.rankings && (
                  <p class="golf-card__ranking">{g.rankings[0]}</p>
                )}
                <p class="golf-card__note">{firstSentences(d.editorNote, 2)}</p>
                {g.localRead && (
                  <p class="golf-card__local"><span class="golf-card__local-tag">Insider read</span>{g.localRead}</p>
                )}
              </div>
              <div class="golf-card__footer">
                <a href={`/explore/${slug}/`} class="golf-card__cta">Course guide →</a>
                {g.bookingUrl && g.access !== 'private' && (
                  <a href={g.bookingUrl} class="golf-card__book" target="_blank" rel="noopener">Book a round →</a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       5. FOR YOUR GAME - handicap-based decision guide
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index" aria-label="Golf course selector">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Course selector</p>
          <h2 class="venues__title">For your game</h2>
          <p class="venues__sub">Not every course suits every golfer. Here is how we'd route a visitor based on what they actually want from the round.</p>
        </div>
      </div>
      <div class="game-guide">

        <div class="game-panel game-panel--low">
          <div class="game-panel__header">
            <span class="game-panel__hcp">Single figures</span>
            <h3 class="game-panel__heading">The serious rounds</h3>
            <p class="game-panel__dek">Golfers who want architectural challenge, exposure, and a course that holds up on replay.</p>
          </div>
          <ul class="game-panel__list">
            <li>
              <strong>St Andrews Beach</strong>
              <span>Tom Doak design. World-ranked. Best architecture on the Peninsula at a public green fee.</span>
            </li>
            <li>
              <strong>Moonah Links - Open Course</strong>
              <span>Peter Thomson's championship layout. Hosted the Australian Open. Rewards intelligent play over power.</span>
            </li>
            <li>
              <strong>The National - Ocean Course</strong>
              <span>The most prestigious public round on the Peninsula. Exposed clifftop holes over Bass Strait. Book well ahead.</span>
            </li>
            <li>
              <strong>Flinders Golf Club</strong>
              <span>9 holes with some of the most dramatic views from any Australian tee box. Wildly underrated. Pairs with a Flinders lunch.</span>
            </li>
          </ul>
        </div>

        <div class="game-panel game-panel--mid">
          <div class="game-panel__header">
            <span class="game-panel__hcp">Mid-handicap</span>
            <h3 class="game-panel__heading">A great day out</h3>
            <p class="game-panel__dek">Courses that deliver real quality without punishing the round. Good enough that you'll want to come back.</p>
          </div>
          <ul class="game-panel__list">
            <li>
              <strong>Moonah Links - Legends Course</strong>
              <span>The Open Course's more forgiving sibling. Still championship quality; much more enjoyable for the 14–22 handicap range.</span>
            </li>
            <li>
              <strong>The Dunes Golf Links</strong>
              <span>Tony Cashmore's links design near Rye. Genuine dune terrain, genuine links feel, and public access at accessible pricing.</span>
            </li>
            <li>
              <strong>Eagle Ridge Golf Course</strong>
              <span>Hinterland parkland near the Red Hill wineries. Plays differently in all four seasons. Natural and well-maintained.</span>
            </li>
            <li>
              <strong>RACV Cape Schanck</strong>
              <span>Ocean views, accessible layout, on-site accommodation. The resort package that lets the non-golfer have an equally good day.</span>
            </li>
          </ul>
        </div>

        <div class="game-panel game-panel--social">
          <div class="game-panel__header">
            <span class="game-panel__hcp">Social / casual</span>
            <h3 class="game-panel__heading">The good-day round</h3>
            <p class="game-panel__dek">High handicappers, occasional players, groups where golf is part of the day rather than the whole day.</p>
          </div>
          <ul class="game-panel__list">
            <li>
              <strong>Mornington Golf Club</strong>
              <span>Closest Peninsula course to Melbourne. Bay-side position. Relaxed club atmosphere. The easiest Peninsula round to organise on short notice.</span>
            </li>
            <li>
              <strong>Rosebud Country Club</strong>
              <span>27-hole mix-and-match format. Three nine-hole courses you can combine however suits the group. Most-played Peninsula course for a reason.</span>
            </li>
            <li>
              <strong>The Dunes - midweek</strong>
              <span>Midweek pricing makes this one of the best-value rounds on the Peninsula. The links feel is genuine even if you're not attacking it.</span>
            </li>
            <li>
              <strong>Sorrento Golf Club</strong>
              <span>Parkland at the Peninsula's tip. Call ahead for availability. Best for those staying in Sorrento or Portsea who want a morning round within walking distance.</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       6. COURSE ARCHITECTS
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index experience-index--plain" aria-label="Course architects">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">The architects</p>
          <h2 class="venues__title">Five designers, one peninsula</h2>
          <p class="venues__sub">The Peninsula's concentration of serious course architecture is not accidental. Here is who built it and what they were trying to do.</p>
        </div>
      </div>
      <div class="architects-grid">

        <article class="architect-card">
          <div class="architect-card__name">Tom Doak</div>
          <div class="architect-card__course">St Andrews Beach Golf Course</div>
          <p class="architect-card__note">Regarded by most serious course architecture critics as one of the three or four best designers working today. Doak's philosophy - restore the land, resist the ornamental, reward strategic play - is fully present at St Andrews Beach. His only Australian design. The course improves on every visit because the design rewards you for understanding it.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Peter Thomson</div>
          <div class="architect-card__course">Moonah Links (Open + Legends Courses); The National Moonah Course</div>
          <p class="architect-card__note">Five-time Open Champion and arguably the most important figure in Australian golf. Thomson's course design philosophy followed his playing philosophy: intelligence over power, precision over length. The Moonah Links Open Course is his most publicly accessible Peninsula work. His National Moonah Course is private, and by most accounts the more architecturally interesting of his two Peninsula commissions.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Greg Norman</div>
          <div class="architect-card__course">The National Gunnamatta Course</div>
          <p class="architect-card__note">The Shark's only Peninsula course. Dramatically exposed, with clifftop stretches above Bass Strait that have no equivalent in Australian public golf. Private access only - members and reciprocal guests. If you have the access, it is the most visually theatrical round on the Peninsula.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Robert Trent Jones Jr</div>
          <div class="architect-card__course">The National Old Course; The National Long Island; RACV Cape Schanck Resort</div>
          <p class="architect-card__note">The global modernist. RTJ Jr's Peninsula footprint runs from the Cape Schanck headland north to Frankston, covering two of The National's four courses (the Old at Cape Schanck and the Long Island course at Frankston) plus the RACV resort layout. His Old Course at The National is the grandest of the four National layouts, designed for a club that was always intended to rival the best in the world. The RACV design is more accessible and suits the resort context it was built for.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Tony Cashmore</div>
          <div class="architect-card__course">The Dunes Golf Links</div>
          <p class="architect-card__note">Australian public golf specialist. The Dunes is his most discussed work, built into genuine sand dune country near Rye and consistently ranked among Australia's best public-access courses. Where Doak and Thomson work at the prestige end, Cashmore built the Peninsula's most accessible championship-quality public round - and it holds up.</p>
