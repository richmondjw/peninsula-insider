    document.querySelectorAll('a[href="#choose-your-round"]').forEach((link) => {
      link.addEventListener('click', () => {
        const target = document.querySelector('#choose-your-round');
        if (!target) return;
        requestAnimationFrame(() => target.focus({ preventScroll: true }));
      });
    });
    document.querySelectorAll('.golf-open-comparison').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const target = document.querySelector('#course-comparison');
        if (!target) return;
        target.open = true;
        history.replaceState(null, '', '#course-comparison');
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        requestAnimationFrame(() => target.querySelector('summary')?.focus({ preventScroll: true }));
      });
    });
    document.querySelectorAll('.golf-compare__row[href^="#course-"], .golf-shortlist__item[href^="#course-"], .golf-pick__links a[href^="#course-"]').forEach((link) => {
      link.addEventListener('click', () => {
        const target = document.querySelector(link.getAttribute('href'));
        if (!target) return;
        requestAnimationFrame(() => target.focus({ preventScroll: true }));
      });
    });
  </script>
