---
import { pageImage } from '../../lib/page-images';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideHero from '../../components/GuideHero.astro';
import PhotoStage from '../../components/PhotoStage.astro';
import { verifiedPhotos } from '../../lib/photo-set';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import {
  buildCollectionPageSchema,
  buildItemListSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';
import ProvenanceLine from '../../components/ProvenanceLine.astro';
import { golfVisitorInfo, golfVisitorAccessChecked } from '../../lib/golf-visitor-info';

// ── Load golf courses from experiences collection ─────────────────────────────
const allExperiences = await getCollection('experiences');
const golfCourses = allExperiences.filter(e => e.data.type === 'golf-course');

// The hub's filmstrip: verified photographs of the courses themselves, two per
// course taken in turn so no one course fills the strip, never the hero again.
const golfHeroSrc = pageImage('golf-hub').src;
const golfPhotoSets = golfCourses.map(c => verifiedPhotos(c.data).filter(p => p.src !== golfHeroSrc).slice(0, 2)).filter(set => set.length);
const golfPhotos = [0, 1].flatMap(i => golfPhotoSets.map(set => set[i]).filter(Boolean)).slice(0, 12);

// Cape Schanck / Fingal cluster - editorial order
const capeOrder = [
  'moonah-links',
  'st-andrews-beach-golf-course',
  'the-national-golf-club',
  'racv-cape-schanck-golf-course',
];
const capeCourses = capeOrder
  .map(s => golfCourses.find(e => (e.data.slug ?? e.id) === s))
  .filter(Boolean) as typeof golfCourses;

// Other Peninsula courses - editorial order
const bayOrder = [
  'flinders-golf-club',
  'eagle-ridge-golf-course',
  'the-dunes-golf-links',
  'mornington-golf-club',
  'rosebud-country-club',
  'sorrento-golf-club',
  'portsea-golf-club',
];
const bayCourses = bayOrder
  .map(s => golfCourses.find(e => (e.data.slug ?? e.id) === s))
  .filter(Boolean) as typeof golfCourses;

// Visitor rules change. Keep dated, direct club sources beside these claims.
const visitorInfo = golfVisitorInfo;

const courseComparison = [
  { slug: 'st-andrews-beach-golf-course', name: 'St Andrews Beach', character: 'Strategic dunes', access: 'Public green fees', town: 'Fingal' },
  { slug: 'moonah-links', name: 'Moonah Links', character: 'Two resort courses', access: 'Public green fees', town: 'Fingal' },
  { slug: 'the-national-golf-club', name: 'The National', character: 'Private multi-course club', access: 'Eligibility rules apply', town: 'Cape Schanck' },
  { slug: 'the-dunes-golf-links', name: 'The Dunes', character: 'Links and nine-hole option', access: 'Public green fees', town: 'Rye' },
  { slug: 'racv-cape-schanck-golf-course', name: 'RACV Cape Schanck', character: 'Resort course', access: 'Public green fees', town: 'Cape Schanck' },
  { slug: 'eagle-ridge-golf-course', name: 'Eagle Ridge', character: 'Inland public course', access: 'Public green fees', town: 'Boneo' },
  { slug: 'mornington-golf-club', name: 'Mornington', character: 'Bay-side parkland', access: 'Public green fees', town: 'Mornington' },
  { slug: 'rosebud-country-club', name: 'Rosebud', character: 'Two 18-hole courses', access: 'Public green fees', town: 'Rosebud' },
  { slug: 'flinders-golf-club', name: 'Flinders', character: 'Clifftop coastal course', access: 'Visitor windows', town: 'Flinders' },
  { slug: 'sorrento-golf-club', name: 'Sorrento', character: 'Private parkland', access: 'Limited visitor times', town: 'Sorrento' },
  { slug: 'portsea-golf-club', name: 'Portsea', character: 'Coastal dunes and Moonah', access: 'Visitor windows', town: 'Portsea' },
];

const courseShortlist = [
  { slug: 'st-andrews-beach-golf-course', cue: 'Public architecture', reason: 'Strategic dunes · Public green fees · Fingal' },
  { slug: 'moonah-links', cue: 'Two-course resort', reason: 'Open and Legends courses · Public green fees · Fingal' },
  { slug: 'flinders-golf-club', cue: 'Clifftop coast', reason: 'Coastal course · Visitor windows · Flinders' },
  { slug: 'portsea-golf-club', cue: 'Southern bayside', reason: 'Coastal dunes and Moonah · Visitor windows · Portsea' },
].map((item) => ({ ...item, course: courseComparison.find((course) => course.slug === item.slug)! }));

// ── Helpers ───────────────────────────────────────────────────────────────────
function accessLabel(access: string, slug: string) {
  if (slug === 'the-national-golf-club') return 'Private · visitor requests';
  if (slug === 'sorrento-golf-club') return 'Limited visitor times';
  const map: Record<string, string> = {
    public: 'Public green fees',
    'semi-private': 'Semi-private',
    private: 'Private - members',
  };
  return map[access] ?? access;
}
function accessMod(access: string) {
  const map: Record<string, string> = {
    public: 'golf-badge--public',
    'semi-private': 'golf-badge--semi',
    private: 'golf-badge--private',
  };
  return map[access] ?? '';
}
// Return first N sentences of a string
function firstSentences(text: string, n = 3): string {
  if (!text) return '';
  const sentences = text.match(/[^.!?]+[.!?]+/g) ?? [];
  return sentences.slice(0, n).join(' ').trim();
}
// ── JSON-LD schemas ───────────────────────────────────────────────────────────
const collectionSchema = buildCollectionPageSchema({
  name: 'Mornington Peninsula Golf Courses - Peninsula Insider',
  description: 'Compare 11 Mornington Peninsula golf venues by visitor access, location and playing style.',
  path: '/explore/golf/',
  dateModified: '2026-11-02',
});
const itemListSchema = buildItemListSchema({
  name: 'Mornington Peninsula Golf Venues',
  description: '11 Mornington Peninsula golf venues grouped by location and visitor access.',
  listPath: '/explore/golf',
  items: [
    { name: 'Moonah Links', path: '/explore/moonah-links/', itemType: 'GolfCourse', addressLocality: 'Fingal' },
    { name: 'St Andrews Beach Golf Course', path: '/explore/st-andrews-beach-golf-course/', itemType: 'GolfCourse', addressLocality: 'Fingal' },
    { name: 'The National Golf Club', path: '/explore/the-national-golf-club/', itemType: 'GolfCourse', addressLocality: 'Cape Schanck' },
    { name: 'RACV Cape Schanck Resort Golf Course', path: '/explore/racv-cape-schanck-golf-course/', itemType: 'GolfCourse', addressLocality: 'Cape Schanck' },
    { name: 'Flinders Golf Club', path: '/explore/flinders-golf-club/', itemType: 'GolfCourse', addressLocality: 'Flinders' },
    { name: 'Eagle Ridge Golf Course', path: '/explore/eagle-ridge-golf-course/', itemType: 'GolfCourse', addressLocality: 'Boneo' },
    { name: 'The Dunes Golf Links', path: '/explore/the-dunes-golf-links/', itemType: 'GolfCourse', addressLocality: 'Rye' },
    { name: 'Mornington Golf Club', path: '/explore/mornington-golf-club/', itemType: 'GolfCourse', addressLocality: 'Mornington' },
    { name: 'Rosebud Country Club', path: '/explore/rosebud-country-club/', itemType: 'GolfCourse', addressLocality: 'Rosebud' },
    { name: 'Sorrento Golf Club', path: '/explore/sorrento-golf-club/', itemType: 'GolfCourse', addressLocality: 'Sorrento' },
    { name: 'Portsea Golf Club', path: '/explore/portsea-golf-club/', itemType: 'GolfCourse', addressLocality: 'Portsea' },
  ],
});
const faqSchema = buildFaqSchema([
  {
    q: 'What is the best golf course on the Mornington Peninsula?',
    a: "Moonah Links Open Course for championship pedigree and public access. St Andrews Beach for Tom Doak architecture at a public green fee. The National is a private club at Cape Schanck; eligible visitors should confirm access with the club before planning a round.",
  },
  {
    q: 'Can you play golf on the Mornington Peninsula without a club membership?',
    a: "Yes. Moonah Links, St Andrews Beach, RACV Cape Schanck, Eagle Ridge, The Dunes, Mornington, and Rosebud Country Club all accept visitor green fees. Flinders welcomes visitors seven days in published time windows; Portsea lists limited visitor green-fee times. Check each club's current tee-time rules.",
  },
  {
    q: 'How much does golf cost on the Mornington Peninsula?',
    a: "Green fees vary by course, season and tee time. Check each club's current rate and visitor eligibility before booking; several courses publish separate midweek and weekend prices.",
  },
  {
    q: 'Is there accommodation near the Peninsula golf courses?',
    a: 'RACV Cape Schanck Resort is on-site. Moonah Links has on-property accommodation with stay-and-play packages. For the remaining courses, choose a base close to the club you plan to play and check actual travel time.',
  },
  {
    q: 'How do the Cape Schanck and other Peninsula courses differ?',
    a: 'The Cape Schanck and Fingal cluster has exposed coastal courses with a mix of public and private access. Other courses span Boneo, Rye, Flinders, Mornington and southern bayside towns; check access rules and location before choosing a base.',
  },
]);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Golf' },
]);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore/' },
  { label: 'Golf' },
];
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Golf - Compare 11 Venues · Peninsula Insider"
  description="Compare 11 Mornington Peninsula golf venues by visitor access, location and playing style, with course guides and stay ideas."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/golf/"
  ogImage={pageImage('golf-hub').src}
  modifiedTime="2026-11-02"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <!-- ═══════════════════════════════════════════════════════════════
       1. CINEMATIC HERO
       ═══════════════════════════════════════════════════════════════ -->
  <GuideHero
    eyebrow="Explore guide"
    title="Mornington Peninsula <em>Golf</em>"
    dek="A rare mix of visitor-bookable coastal courses and private-club architecture, all within reach of a Peninsula weekend."
    meta={[{ label: '11 golf venues' }, { label: 'Public and private access' }]}
    primaryAction={{ label: 'Choose your round', href: '#choose-your-round' }}
    heroImage={pageImage('golf-hub').src}
    imageAlt={pageImage('golf-hub').alt}
    imageCredit={pageImage('golf-hub').credit}
    entitySlug="explore/golf"
  />

  <section class="golf-fit" id="choose-your-round" aria-labelledby="golf-fit-title" tabindex="-1">
    <div class="container">
      <div class="golf-fit__intro">
        <p class="label label--accent">Compare the courses</p>
        <h2 id="golf-fit-title">Choose by course character, access and location</h2>
        <p>Start with four distinct fits, or compare all 11 venues before opening the course details and current visitor-access source.</p>
      </div>
      <div class="golf-shortlist" aria-label="Four useful starting points">
        {courseShortlist.map(({ cue, reason, course }) => (
          <a href={`#course-${course.slug}`} class="golf-shortlist__item">
            <span>{cue}</span>
            <strong>{course.name}</strong>
            <small>{reason}</small>
          </a>
        ))}
      </div>
      <details class="golf-compare-disclosure" id="course-comparison">
        <summary class="golf-compare-disclosure__summary">
          <span>Compare all 11 courses</span>
          <small>Course character · visitor access · town</small>
        </summary>
        <div class="golf-compare" aria-label="Compare Mornington Peninsula golf venues">
          <div class="golf-compare__header" aria-hidden="true">
            <span>Course</span>
            <span>Course character</span>
            <span>Visitor access</span>
            <span>Town</span>
            <span></span>
          </div>
          {courseComparison.map((course) => (
            <a class="golf-compare__row" href={`#course-${course.slug}`}>
              <strong>{course.name}</strong>
              <span data-label="Course character">{course.character}</span>
              <span data-label="Visitor access">{course.access}</span>
              <span data-label="Town">{course.town}</span>
              <span class="golf-compare__arrow" aria-hidden="true">↓</span>
            </a>
          ))}
        </div>
      </details>
    </div>
  </section>

  {golfPhotos.length >= 3 && (
    <div class="container golf-photos">
      <PhotoStage photos={golfPhotos} subject="Mornington Peninsula golf courses" id="golf-photos" variant="strip" />
    </div>
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       3. CAPE SCHANCK / FINGAL CLUSTER
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index" id="cape-courses" aria-label="Cape Schanck golf courses">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Cape Schanck / Fingal cluster</p>
          <h2 class="venues__title">Cape Schanck and Fingal courses</h2>
          <p class="venues__sub">Four southern Peninsula golf venues with different access rules and playing styles.</p>
        </div>
      </div>
      <div class="golf-grid golf-grid--cape">
        {capeCourses.map((course) => {
          const d = course.data;
          const g = d.golf ?? {};
          const slug = d.slug ?? course.id;
          const visitor = visitorInfo[slug];
          const designers = Array.isArray(g.designers) ? g.designers.join(', ') : null;
          return (
            <article class="golf-card" id={"course-" + slug} tabindex="-1">
              <div class="golf-card__header">
                <div class="golf-card__badges">
                  <span class={`golf-badge golf-badge--access ${accessMod(g.access)}`}>{accessLabel(g.access, slug)}</span>
                </div>
                <div class="golf-card__holes">{slug === 'the-national-golf-club' ? '54 Cape Schanck + 18 Frankston' : slug === 'the-dunes-golf-links' ? '18 + 9 holes' : slug === 'rosebud-country-club' ? '2 x 18 holes' : g.holes ? `${g.holes} holes` : ''}</div>
              </div>
              <div class="golf-card__body">
                <h3 class="golf-card__name">
                  <a href={`/explore/${slug}/`}>{d.name}</a>
                </h3>
                <p class="golf-card__meta">
                  {d.address?.split(',')[1]?.trim() ?? d.place}
                  {designers && <span class="golf-card__designers"> · {designers}</span>}
                </p>
                <div class="golf-card__actions">
                  <a href={`/explore/${slug}/`} class="pi-btn pi-btn--text" aria-label={"Course guide \u2192 for " + d.name}>Course guide →</a>
                  {g.bookingUrl && g.access !== 'private' && (!visitor || visitor.teeTimes) && (
                    <a href={g.bookingUrl} class="golf-card__book" target="_blank" rel="noopener" data-pi-entity-type="golf-course" data-pi-entity-slug={slug} data-pi-surface="golf-card" aria-label={"Check tee times \u2197 for " + d.name + ", opens in a new tab"}>Check tee times ↗</a>
                  )}
                </div>
                <p class="golf-card__note">{firstSentences(d.editorNote, 1)}</p>
                {visitor && <p class="golf-card__access-note">{visitor.summary} <a href={visitor.url} target="_blank" rel="noopener" aria-label={(visitor.linkLabel ?? "Club details") + " \u2197 for " + d.name + ", opens in a new tab"}>{visitor.linkLabel ?? 'Club details'} ↗</a> <span>Visitor access checked {golfVisitorAccessChecked}</span></p>}
                {g.localRead && (
                  <p class="golf-card__local"><span class="golf-card__local-tag">Insider read</span>{g.localRead}</p>
                )}
              </div>
            </article>
          );
        })}
      </div>
      <p class="golf-back"><a href="#course-comparison" class="golf-open-comparison">Back to the course comparison ↑</a></p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       4. OTHER PENINSULA COURSES
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index experience-index--plain" id="across-courses" aria-label="Golf courses across the Peninsula">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Across the Peninsula</p>
          <h2 class="venues__title">More ways to play</h2>
          <p class="venues__sub">Seven golf venues across several towns and coastlines. Compare visitor access and check the drive from your base before choosing a round.</p>
        </div>
      </div>
      <div class="golf-grid golf-grid--bay">
        {bayCourses.map((course) => {
          const d = course.data;
          const g = d.golf ?? {};
          const slug = d.slug ?? course.id;
          const visitor = visitorInfo[slug];
          const designers = Array.isArray(g.designers) ? g.designers.join(', ') : null;
          return (
            <article class="golf-card golf-card--bay" id={"course-" + slug} tabindex="-1">
              <div class="golf-card__header">
                <div class="golf-card__badges">
                  <span class={`golf-badge golf-badge--access ${accessMod(g.access)}`}>{accessLabel(g.access, slug)}</span>
                </div>
                <div class="golf-card__holes">{slug === 'the-dunes-golf-links' ? '18 + 9 holes' : slug === 'rosebud-country-club' ? '2 x 18 holes' : g.holes ? `${g.holes} holes` : ''}</div>
              </div>
              <div class="golf-card__body">
                <h3 class="golf-card__name">
                  <a href={`/explore/${slug}/`}>{d.name}</a>
                </h3>
                <p class="golf-card__meta">
                  {d.address?.split(',')[1]?.trim() ?? d.place}
                  {designers && <span class="golf-card__designers"> · {designers}</span>}
                </p>
                <div class="golf-card__actions">
                  <a href={`/explore/${slug}/`} class="pi-btn pi-btn--text" aria-label={"Course guide \u2192 for " + d.name}>Course guide →</a>
                  {g.bookingUrl && g.access !== 'private' && (!visitor || visitor.teeTimes) && (
                    <a href={g.bookingUrl} class="golf-card__book" target="_blank" rel="noopener" data-pi-entity-type="golf-course" data-pi-entity-slug={slug} data-pi-surface="golf-card" aria-label={"Check tee times \u2197 for " + d.name + ", opens in a new tab"}>Check tee times ↗</a>
                  )}
                </div>
                <p class="golf-card__note">{firstSentences(d.editorNote, 1)}</p>
                {visitor && <p class="golf-card__access-note">{visitor.summary} <a href={visitor.url} target="_blank" rel="noopener" aria-label={(visitor.linkLabel ?? "Club details") + " \u2197 for " + d.name + ", opens in a new tab"}>{visitor.linkLabel ?? 'Club details'} ↗</a> <span>Visitor access checked {golfVisitorAccessChecked}</span></p>}
                {g.localRead && (
                  <p class="golf-card__local"><span class="golf-card__local-tag">Insider read</span>{g.localRead}</p>
                )}
              </div>
            </article>
          );
        })}
      </div>
      <p class="golf-back"><a href="#course-comparison" class="golf-open-comparison">Back to the course comparison ↑</a></p>
    </div>
  </section>

  <!-- The earlier playing-style selector replaces the former duplicate handicap guide. -->

  <!-- ═══════════════════════════════════════════════════════════════
       6. COURSE ARCHITECTS
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index experience-index--plain" aria-label="Course architects">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">The architects</p>
          <h2 class="venues__title">Five designers, one peninsula</h2>
          <p class="venues__sub">The Peninsula's concentration of serious course architecture is not accidental. Here is who built it and what they were trying to do.</p>
        </div>
      </div>
      <div class="architects-grid">

        <article class="architect-card">
          <div class="architect-card__name">Tom Doak</div>
          <div class="architect-card__course">St Andrews Beach Golf Course; The National Gunnamatta Course</div>
          <p class="architect-card__note">Doak designed St Andrews Beach and redesigned The National's private Gunnamatta Course in 2019. Both use the existing land to reward strategic shot choices.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Peter Thomson</div>
          <div class="architect-card__course">Moonah Links Open Course</div>
          <p class="architect-card__note">Five-time Open Champion Peter Thomson designed the Moonah Links Open Course. It is the Peninsula's visitor-bookable Thomson layout.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Greg Norman</div>
          <div class="architect-card__course">The National Moonah Course</div>
          <p class="architect-card__note">Greg Norman and Bob Harrison designed The National's private Moonah Course. Victorian nonmembers must be invited and play with a member; interstate and overseas visitors can request tee times directly.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Robert Trent Jones Jr</div>
          <div class="architect-card__course">The National Old Course; RACV Cape Schanck Resort</div>
          <p class="architect-card__note">Robert Trent Jones Jr designed The National's private Old Course and the separate visitor-bookable RACV Cape Schanck course.</p>
        </article>

        <article class="architect-card">
          <div class="architect-card__name">Tony Cashmore</div>
          <div class="architect-card__course">The Dunes Golf Links</div>
          <p class="architect-card__note">Tony Cashmore designed The Dunes, an 18-hole public links course built through Rye's dune country.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       7. GOLF + NON-GOLFERS - the pairing question
       ═══════════════════════════════════════════════════════════════ -->
  <section class="experience-index" aria-label="Golf and non-golfer pairings">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">The mixed group question</p>
          <h2 class="venues__title">When one person plays, what does everyone else do?</h2>
          <p class="venues__sub">The Peninsula solves this better than almost anywhere else in Australia. The non-golfer's day can be as good as the golfer's - if you plan it properly.</p>
        </div>
      </div>
      <div class="pairing-grid">
        <div class="pairing-card">
          <h3 class="pairing-card__heading">Cape Schanck / Fingal golf</h3>
          <p class="pairing-card__sub">While the golfer plays Moonah Links, St Andrews Beach, or The National:</p>
          <ul class="pairing-card__list">
            <li><a href="/journal/peninsula-hot-springs-vs-alba/">Peninsula Hot Springs</a> - A bathing session can fill the time of a golf round. Check the route from the chosen course before booking both.</li>
            <li><a href="/explore/cape-schanck-boardwalk/">Cape Schanck boardwalk</a> - A clifftop walk towards Pulpit Rock with exposed coastal views. Match the walk to the weather and available daylight.</li>
            <li><a href="/explore/places/flinders/">Flinders town</a> - Coffee, the Flinders Hotel beer garden, and a proper lunch. Check the live route from the course before agreeing on a meeting time.</li>
          </ul>
        </div>
        <div class="pairing-card">
          <h3 class="pairing-card__heading">Golf beyond Cape Schanck</h3>
          <p class="pairing-card__sub">While the golfer plays Flinders, Eagle Ridge, The Dunes, or Mornington:</p>
          <ul class="pairing-card__list">
            <li><a href="/wine/">Red Hill and Main Ridge wineries</a> - A self-guided cellar-door morning that can pair with a post-round lunch. Confirm opening times and the live route from Eagle Ridge.</li>
            <li><a href="/explore/places/mornington/">Mornington town</a> - Main Street, the foreshore, and Mornington Racecourse if timing aligns. Full morning agenda for a non-golfer.</li>
            <li><a href="/explore/plans/mornington-peninsula-stay-and-soak/">Peninsula Hot Springs</a> - A bathing option for groups based in the mid-Peninsula corridor. Check the live route for the day and tee time.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       9. STAY & PLAY FEATURE
       ═══════════════════════════════════════════════════════════════ -->
