---
/**
 * /dog-friendly/ consolidation stub.
 *
 * Duplicate render behind noindex + foreign canonical.
 * Emitting the Redirect `consolidate` shim instead of a full render keeps the
 * URL alive for existing inbound links while removing it from the crawl budget:
 * Googlebot had to fetch the entire page just to read a canonical pointing away.
 * See scripts/audit-link-graph.mjs - this class is asserted at 0 in CI.
 */
import Redirect from "../../components/Redirect.astro";
---
<Redirect to="/dog-friendly/" consolidate />
