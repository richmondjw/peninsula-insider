---
import { schemaImage } from '../../lib/photo-set';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import ItineraryCard from '../../components/ItineraryCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { placeLabel, routeSlug, titleize, venueHrefPrefix, isListableVenue, clipExcerpt, formatHeroCredit } from '../../lib/editorial';
import PhotoStage from '../../components/PhotoStage.astro';
import InlinePhoto from '../../components/InlinePhoto.astro';
import { photoPlan, paragraphsOf } from '../../lib/photo-set';
import { editableText, editableImage } from '../../lib/inline-edit/attrs';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import MediaProvenanceNote from '../../components/MediaProvenanceNote.astro';
import { primarySchemaType } from '../../lib/schema';
import { golfVisitorInfo, golfVisitorAccessChecked } from '../../lib/golf-visitor-info';

const difficultyLabel: Record<string, string> = {
  easy: 'Easy',
  moderate: 'Moderate',
  hard: 'Hard',
};

const typeLabel: Record<string, string> = {
  walk: 'Walk',
  beach: 'Beach',
  wellness: 'Wellness',
  tour: 'Tour',
  attraction: 'Attraction',
  gallery: 'Gallery',
  park: 'Park',
  lookout: 'Lookout',
  market: 'Market',
  workshop: 'Workshop',
  'golf-course': 'Golf Course',
};

const heroVariant: Record<string, string> = {
  walk: 'feature__image-block--hinterland',
  park: 'feature__image-block--hinterland',
  beach: 'feature__image-block--bay',
  lookout: 'feature__image-block--bay',
  market: 'feature__image-block--sand',
  gallery: 'feature__image-block--sand',
  attraction: 'feature__image-block--sand',
  wellness: 'feature__image-block--hinterland',
};

export async function getStaticPaths() {
  const STATIC_EXPLORE_OVERRIDES = new Set(['bushrangers-bay', 'mornington-peninsula-walk']);
  const experiences = await getCollection('experiences');
  return experiences
    .filter((experience) => !STATIC_EXPLORE_OVERRIDES.has(routeSlug(experience)))
    .map((experience) => ({
      params: { slug: routeSlug(experience) },
      props: { experience },
    }));
}

const { experience } = Astro.props;
const allExperiences = await getCollection('experiences');
const venues = (await getCollection('venues')).filter(isListableVenue);
const itineraries = await getCollection('itineraries');
const articles = await getCollection('articles', ({ data }) => data.status === 'published');

const slug = routeSlug(experience);
const placeSlug = String(experience.data.place?.id ?? experience.data.place);
const experiencePlace = placeLabel(experience.data.place);
const relatedExperiences = allExperiences
  .filter((entry) => routeSlug(entry) !== slug)
  .filter((entry) => String(entry.data.place?.id ?? entry.data.place) === placeSlug || entry.data.zone === experience.data.zone)
  .slice(0, 3);
const nearbyVenues = venues
  .filter((venue) => String(venue.data.place?.id ?? venue.data.place) === placeSlug)
  .slice(0, 3);
const relatedItineraries = itineraries
  .filter((itinerary) => itinerary.data.stops.some((stop) => String(stop.experience?.id ?? stop.experience ?? '') === slug))
  .slice(0, 2);
const relatedArticles = articles
  .filter((article) => article.data.relatedExperiences.some((entry) => String(entry.id ?? entry) === slug) || article.data.tags.includes(placeSlug))
  .slice(0, 2);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore/' },
  ...(experience.data.type === 'golf-course' ? [{ label: 'Golf', href: '/explore/golf/' }] : []),
  { label: experience.data.name },
];

const seasonBest = experience.data.seasonBest?.length
  ? experience.data.seasonBest.map((entry: string) => titleize(entry)).join(' · ')
  : null;
/* Humanised duration: nobody thinks in "600 min". */
function formatDuration(m: number): string {
  if (m < 60) return `${m} min`;
  const whole = Math.floor(m / 60);
  return m % 60 >= 30 ? `${whole}.5 h` : `${whole} h`;
}
const duration = experience.data.durationMinutes ? formatDuration(experience.data.durationMinutes) : null;
const difficulty = experience.data.difficulty ? difficultyLabel[experience.data.difficulty] ?? titleize(experience.data.difficulty) : null;
const heroClass = heroVariant[experience.data.type] ?? 'feature__image-block--hinterland';

const hero = await resolveHero('experience', slug, experience.data);
const heroStyle = hero.style;
// Override-aware, the same way the venue and place templates are. Before
// this the experience hero showed an editor's uploaded photograph and
// disclosed - and labelled - the content record's stand-in instead.
const heroProvenance = hero.override ? null : experience.data.heroImage;
// Credit the photograph actually shown: an editor's upload carries no record
// here, so only the content record's own image is credited.
const heroCredit = heroProvenance?.credit ? formatHeroCredit(heroProvenance.credit) : '';
// The photograph rule (src/lib/photo-set.ts).
const editorParagraphs = paragraphsOf(experience.data.editorNote);
const photoSet = photoPlan(experience.data, { override: Boolean(hero.override), paragraphs: editorParagraphs.length });
const golfVisitor = experience.data.type === 'golf-course' ? golfVisitorInfo[slug] : null;
const golfBookingUrl = experience.data.type === 'golf-course' ? (experience.data as any).golf?.bookingUrl : null;
const golfActionUrl = golfVisitor?.teeTimes && golfBookingUrl ? golfBookingUrl : golfVisitor?.url;
const golfActionLabel = golfVisitor?.detailActionLabel ?? (golfVisitor?.teeTimes && golfBookingUrl ? 'Check tee times' : 'Club visitor information');


const canonical = `https://peninsulainsider.com.au/explore/${slug}/`;
const ogImage = hero.src;

// Truncate editor note to ~155 chars, at a word boundary (T-EXP-CARD-1 class bug).
const description = experience.data.editorNote
  ? clipExcerpt(experience.data.editorNote, 152)
  : '';

// Schema.org type mapping: specific types get richer markup
const schemaTypeMap: Record<string, string | string[]> = {
  'golf-course': ['GolfCourse', 'SportsActivityLocation', 'TouristAttraction'],
  'walk': 'TouristAttraction',
  'beach': 'Beach',
  'park': 'Park',
  'gallery': 'ArtGallery',
  'market': 'LocalBusiness',
  'wellness': ['HealthAndBeautyBusiness', 'TouristAttraction'],
  'attraction': 'TouristAttraction',
  'lookout': 'TouristAttraction',
  'tour': 'TouristAttraction',
  'workshop': 'LocalBusiness',
};
const schemaType = schemaTypeMap[experience.data.type] ?? 'TouristAttraction';
const primaryType = primarySchemaType(schemaType);

const experienceSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${canonical}#${primaryType}`,
  name: experience.data.name,
  description: experience.data.editorNote,
  ...schemaImage(experience.data),
  address: {
    '@type': 'PostalAddress',
    streetAddress: experience.data.address ?? undefined,
    addressLocality: experiencePlace,
    addressRegion: 'VIC',
    addressCountry: 'AU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: experience.data.coordinates?.lat,
    longitude: experience.data.coordinates?.lng,
  },
  url: canonical,
  ...(placeSlug
    ? {
        containedInPlace: {
          '@type': 'TouristDestination',
          '@id': `https://peninsulainsider.com.au/explore/places/${placeSlug}/#TouristDestination`,
          name: experiencePlace,
          url: `https://peninsulainsider.com.au/explore/places/${placeSlug}/`,
        },
      }
    : {}),
  ...(experience.data.website ? { sameAs: [experience.data.website] } : {}),
};

// Golf-course-specific enrichments
if (experience.data.type === 'golf-course') {
  const golfData = (experience.data as any).golf;
  if (golfData?.holes) (experienceSchema as any).numberOfHoles = golfData.holes;
  if (golfData?.access) {
    (experienceSchema as any).publicAccess = golfData.access === 'public';
  }
}
export const prerender = true;
---

<BaseLayout
  title={`${experience.data.name}, ${experiencePlace} · Peninsula Insider`}
  description={description}
  section="explore"
  canonical={canonical}
  ogImage={ogImage}
  searchImage={ogImage}
  noindex={experience.data.sitemapExclude === true}
>
  <script type="application/ld+json" set:html={JSON.stringify(experienceSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <section class="experience-detail">
    <div class="container">
      <div class="experience-detail__meta">
        <a href={experience.data.type === 'golf-course' ? '/explore/golf/' : '/explore/'} class="experience-detail__type">{experience.data.type === 'golf-course' ? 'Compare golf courses' : (typeLabel[experience.data.type] ?? titleize(experience.data.type))}</a>
        <span class="experience-detail__dot" aria-hidden="true"></span>
        <a href={`/explore/places/${placeSlug}/`} class="experience-detail__place">{experiencePlace}</a>
        {duration && (
          <>
            <span class:list={['experience-detail__dot', { 'experience-detail__golf-duration': experience.data.type === 'golf-course' }]} aria-hidden="true"></span>
            <span class:list={['experience-detail__place', { 'experience-detail__golf-duration': experience.data.type === 'golf-course' }]}>{duration}</span>
          </>
        )}
      </div>

      <h1 class="experience-detail__title" {...editableText({
        entityType: 'experience', entitySlug: slug, fieldPath: 'name',
        label: `${experience.data.name} - name`,
      })}>{experience.data.name}</h1>

      {golfVisitor && golfActionUrl && (
        <div class="experience-detail__golf-visit">
          <div class="experience-detail__golf-visit-copy">
            <h2>Plan your round</h2>
            <p>{golfVisitor.summary}</p>
            <span>Visitor access checked {golfVisitorAccessChecked}; confirm current conditions with the club.</span>
            {golfVisitor.detailSourceActionLabel && (
              <a class="experience-detail__golf-visit-source" href={golfVisitor.url} target="_blank" rel="noopener" aria-label={golfVisitor.detailSourceActionLabel + ' for ' + experience.data.name + ', opens in a new tab'}>{golfVisitor.detailSourceActionLabel} <span aria-hidden="true">↗</span></a>
            )}
          </div>
          <a
            class="experience-detail__golf-visit-action"
            href={golfActionUrl}
            target="_blank"
            rel="noopener"
            aria-label={golfActionLabel + ' for ' + experience.data.name + ', opens in a new tab'}
            data-pi-entity-type="golf-course"
            data-pi-entity-slug={slug}
            data-pi-surface="golf-detail"
          >{golfActionLabel} <span aria-hidden="true">↗</span></a>
        </div>
      )}

      {photoSet.stage ? (
        <div {...editableImage({ entityType: 'experience', entitySlug: slug, fieldPath: 'heroImage', label: `${experience.data.name} hero`, purpose: 'hero' })}>
          <PhotoStage photos={photoSet.photos} subject={experience.data.name} id="photos" />
        </div>
      ) : (
        <>
          <div class={`experience-detail__hero feature__image-block ${heroClass}`} aria-hidden="true" style={heroStyle} {...editableImage({
            entityType: 'experience', entitySlug: slug, fieldPath: 'heroImage',
            label: `${experience.data.name} hero`, purpose: 'hero',
          })}>
            <div class="experience-detail__hero-fog"></div>
            {hero.alt && (
              <span class="experience-detail__hero-label">{hero.alt}</span>
            )}
          </div>
          {heroCredit && <p class="experience-detail__hero-credit">{heroCredit}</p>}
          <MediaProvenanceNote
            image={heroProvenance}
            subject={experience.data.name}
            class="experience-detail__hero-provenance"
          />
          {photoSet.photos.length >= 3 && <PhotoStage photos={photoSet.photos} subject={experience.data.name} id="photos" variant="strip" />}
        </>
      )}

      <div class="experience-detail__grid">
        <div>
          <div class="prose">
            {editorParagraphs.map((paragraph: string, i: number) => (
              <>
                <p>{paragraph}</p>
                {i === 0 && photoSet.afterFirst !== null && <InlinePhoto photos={photoSet.photos} indexes={[photoSet.afterFirst]} subject={experience.data.name} />}
                {i === 2 && photoSet.pair && <InlinePhoto photos={photoSet.photos} indexes={photoSet.pair} subject={experience.data.name} />}
              </>
            ))}
          </div>
        </div>

        <aside class="facts">
          <p class="facts__title">At a glance</p>
          <dl>
            <dt>Place</dt>
            <dd><a href={`/explore/places/${placeSlug}/`}>{experiencePlace}</a></dd>

            <dt>Type</dt>
            <dd>{typeLabel[experience.data.type] ?? titleize(experience.data.type)}</dd>

            {duration && (
              <>
                <dt>Timing</dt>
                <dd>{duration}</dd>
              </>
            )}

            {difficulty && (
              <>
                <dt>Difficulty</dt>
                <dd>{difficulty}</dd>
              </>
            )}

            {seasonBest && (
              <>
                <dt>Best in</dt>
                <dd>{seasonBest}</dd>
              </>
            )}

            {experience.data.address && (
              <>
                <dt>{experience.data.type === 'golf-course' ? 'Address' : 'Access'}</dt>
                <dd>{experience.data.address}</dd>
              </>
            )}

            {experience.data.website && (
              <>
                <dt>Website</dt>
                <dd><a href={experience.data.website}>{experience.data.website.replace(/^https?:\/\//, '')}</a></dd>
              </>
            )}
          </dl>

          <a class="facts__cta pi-btn pi-btn--ghost pi-btn--block" href={`/explore/places/${placeSlug}/`}>Open place hub</a>
        </aside>
      </div>
    </div>
  </section>

  {nearbyVenues.length > 0 && (
    <section class="venues">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Pair it with a booking</p>
            <h2 class="venues__title">Where to eat, drink, or stay nearby</h2>
            <p class="venues__sub">The best explore pages should lead somewhere next.</p>
          </div>
          <a href={`/explore/places/${placeSlug}/`} class="venues__link">See {experiencePlace} →</a>
        </div>
        <div class="venues__grid">
          {nearbyVenues.map((venue) => <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />)}
        </div>
      </div>
    </section>
  )}

  {relatedItineraries.length > 0 && (
    <section class="escape-callout">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Use it in a weekend</p>
            <h2 class="venues__title">Plans that already sequence this stop properly</h2>
          </div>
          <a href="/explore/plans/" class="venues__link">All plans →</a>
        </div>
        <div class="itinerary-grid">
          {relatedItineraries.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
        </div>
      </div>
    </section>
  )}

  {relatedExperiences.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Keep going</p>
            <h2 class="venues__title">More ways to use this side of the Peninsula</h2>
          </div>
          <a href="/explore/" class="venues__link">Explore more →</a>
        </div>
        <div class="experience-grid">
          {relatedExperiences.map((entry) => <ExperienceCard experience={entry} />)}
        </div>
      </div>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section class="venues venues--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Further reading</p>
            <h2 class="venues__title">Journal pieces that deepen this stop</h2>
          </div>
          <a href="/journal/" class="venues__link">Journal →</a>
        </div>
        <div class="venues__grid venues__grid--two">
          {relatedArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />
</BaseLayout>

<style>
  .experience-detail__golf-visit {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem 1.5rem; margin: -1rem 0 1.5rem; padding: 1rem 1.2rem;
    border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: var(--radius-m); background: var(--bg-alt);
  }
  .experience-detail__golf-visit-copy { min-width: 0; }
  .experience-detail__golf-visit h2 {
    margin: 0 0 0.25rem; color: var(--dark); font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.22rem); line-height: 1.2;
  }
  .experience-detail__golf-visit p { margin: 0; color: var(--text); font-size: 0.9rem; line-height: 1.45; }
  .experience-detail__golf-visit-copy > span { display: block; margin-top: 0.4rem; color: var(--soft); font-size: 0.76rem; line-height: 1.4; }
  .experience-detail__golf-visit-source {
    display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px;
    color: var(--accent); font-size: 0.82rem; font-weight: 700;
    text-decoration: underline; text-underline-offset: 0.18em;
  }
  .experience-detail__golf-visit-source:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .experience-detail__golf-visit-action {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    flex-shrink: 0; min-height: 44px; padding: 0.7rem 1rem;
    border-radius: var(--radius-s); background: var(--dark); color: #fff;
    font-family: var(--font-ui); font-size: 0.85rem; font-weight: 700; text-align: center;
  }
  .experience-detail__golf-visit-action:hover { background: var(--accent); color: #fff; }
  .experience-detail__golf-visit-action:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 700px) {
    .experience-detail__golf-visit { flex-direction: column; align-items: stretch; padding: 1rem; }
    .experience-detail__golf-visit-action { width: 100%; }
  }
  @media (max-width: 360px) {
    .experience-detail__golf-duration { display: none; }
  }
  /* Photo credit under the hero, sitting in the hero's bottom margin, as the
     venue template does. Required beside licensed photographs. */
  .experience-detail__hero-credit {
    margin: calc(-1 * clamp(2.5rem, 5vw, 4rem) + .6rem) 0 clamp(2rem, 4vw, 3rem);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
    text-align: right;
  }
</style>
