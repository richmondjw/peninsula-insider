---
/**
 * /explore/hot-springs/ - key SEO landing page, redesigned 2026-05-17.
 *
 * Editorial cover treatment in the Sunday register: hero spread, two operator
 * panels with alternating image/text rhythm, a magazine-style comparison
 * panel, a "pair with a soak" rail, then the FAQ as quiet prose. All
 * schema (CollectionPage, ItemList, FAQPage, BreadcrumbList) preserved.
 * Headings (h1/h2/h3) and internal links unchanged so SEO position holds.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import {
  buildCollectionPageSchema,
  buildItemListSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';

const collectionSchema = buildCollectionPageSchema({
  name: 'Mornington Peninsula Hot Springs - Peninsula Insider Guide',
  description: 'Peninsula Hot Springs vs Alba: when to go, how to book, what to pair with your soak. The editorial guide to thermal springs on the Mornington Peninsula.',
  path: '/explore/hot-springs',
  dateModified: '2026-05-17',
});

const itemListSchema = buildItemListSchema({
  name: 'Mornington Peninsula Hot Springs',
  description: 'Thermal springs operators on the Mornington Peninsula - Peninsula Hot Springs and Alba Thermal Springs.',
  listPath: '/explore/hot-springs',
  items: [
    { name: 'Peninsula Hot Springs', path: '/stay/peninsula-hot-springs', itemType: 'TouristAttraction', addressLocality: 'Fingal' },
    { name: 'Alba Thermal Springs', path: '/stay/alba-thermal-springs', itemType: 'TouristAttraction', addressLocality: 'Fingal' },
  ],
});

const faqs = [
  {
    q: 'Do I need to book Peninsula Hot Springs in advance?',
    a: 'Yes. Same-day booking on weekends is almost impossible in peak season (December to February, July school holidays). Book 1 to 2 weeks ahead for weekends. Midweek is easier.',
  },
  {
    q: 'Can you visit Peninsula Hot Springs without booking ahead?',
    a: 'Occasionally midweek in low season, but the risk of turning up to a full site is real. The website shows real-time availability.',
  },
  {
    q: 'What is the difference between Peninsula Hot Springs and Alba?',
    a: 'Peninsula Hot Springs is larger, older, and has more pool variety but is significantly busier on weekends. Alba is smaller, quieter, and easier to book. Full comparison at <a href="/journal/peninsula-hot-springs-vs-alba/">Peninsula Hot Springs vs Alba</a>.',
  },
  {
    q: 'Are hot springs suitable in summer?',
    a: 'Yes. Many pools sit at 38 to 40 degrees year-round. Winter soaks in open air are the most atmospheric, but the springs operate every day.',
  },
  {
    q: 'Is there anything else near Peninsula Hot Springs to visit on the same day?',
    a: 'Cape Schanck (a few minutes south) for the boardwalk and lighthouse before the soak. Gunnamatta back beach (10 minutes north) for a surf-and-soak combination.',
  },
];

const faqSchema = buildFaqSchema(faqs.map((f) => ({
  q: f.q,
  a: f.a.replace(/<[^>]+>/g, ''),
})));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Hot Springs' },
]);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore' },
  { label: 'Hot Springs' },
];

const pairWith = [
  {
    label: 'The walk',
    title: 'Cape Schanck boardwalk',
    href: '/explore/cape-schanck-boardwalk/',
    image: '/images/sourced/explore-cape-schanck-boardwalk-01.webp',
    alt: 'Cape Schanck boardwalk descending toward the Bass Strait coastline',
    dek: 'A 45-minute boardwalk descent to a basalt platform, fifteen minutes south of Fingal. The opening act for an afternoon soak.',
  },
  {
    label: 'The headland',
    title: 'Bushrangers Bay walk',
    href: '/explore/bushrangers-bay-walk/',
    image: '/images/sourced/explore-bushrangers-bay-walk-01.webp',
    alt: 'Bushrangers Bay headland and Bass Strait below Cape Schanck',
    dek: 'A longer southern coastal walk to a cove almost no one else reaches. Earn the second drink, then the soak.',
  },
  {
    label: 'The treatment',
    title: 'Day spas of the Peninsula',
    href: '/explore/spas-and-wellness/',
    image: '/images/sourced/spa-treatment-room-rose-01.webp',
    alt: 'A candle-lit Peninsula spa treatment room',
    dek: 'Pair a thermal soak with a treatment at one of the Peninsula day spas. The full reset, in one afternoon.',
  },
];

const lastVerified = '17 May 2026';
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Hot Springs - Peninsula Hot Springs vs Alba · Peninsula Insider"
  description="Peninsula Hot Springs vs Alba Thermal Springs: when to go, how to book, what to pair with your soak. The complete editorial guide to thermal springs on the Mornington Peninsula."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/hot-springs/"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  {/* ── Hero spread ───────────────────────────────────────────────── */}
  <section class="hs-hero" aria-label="Hot springs guide">
    <div class="hs-container hs-hero__inner">
      <div class="hs-hero__type">
        <p class="hs-eyebrow">Mornington Peninsula · The thermal guide</p>
        <h1 class="hs-hero__headline">The Peninsula's hot springs, decided.</h1>
        <p class="hs-hero__dek">
          Two operators sit above the same geothermal aquifer. One is the
          original and the most crowded, the other is the quieter, newer
          alternative. Here is which one to book, when to go, and what to
          pair with the soak.
        </p>
        <div class="hs-hero__links">
          <a class="hs-link" href="#compare">Skip to the comparison <span aria-hidden="true">→</span></a>
          <a class="hs-link hs-link--quiet" href="/journal/peninsula-hot-springs-vs-alba/">Read the full essay <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="hs-hero__visual">
        <img
          src="/images/sourced/spa-peninsula-hot-springs-hilltop-01.webp"
          alt="Steam rising from a Peninsula Hot Springs hilltop pool at dusk"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  {/* ── Quick answer panel ───────────────────────────────────────── */}
  <section class="hs-answer" aria-label="In short">
    <div class="hs-container">
      <p class="hs-section-label">The short answer</p>
      <ul class="hs-answer__list">
        <li>
          <span class="hs-answer__num">01</span>
          <span class="hs-answer__text">Two operators, both at Fingal: <a href="/stay/peninsula-hot-springs/">Peninsula Hot Springs</a> and the newer <a href="/stay/alba-thermal-springs/">Alba Thermal Springs</a>.</span>
        </li>
        <li>
          <span class="hs-answer__num">02</span>
          <span class="hs-answer__text">Peninsula Hot Springs is larger, older and more crowded. Book one to two weeks ahead on weekends, year-round.</span>
        </li>
        <li>
          <span class="hs-answer__num">03</span>
          <span class="hs-answer__text">Alba is smaller, newer, quieter and easier to book. It suits visitors who find Peninsula Hot Springs too busy.</span>
        </li>
        <li>
          <span class="hs-answer__num">04</span>
          <span class="hs-answer__text">Both operate in all weather. The wet, cold days are, counter-intuitively, the best time to visit.</span>
        </li>
      </ul>
    </div>
  </section>

  {/* ── Operator panels (alternating Sunday-style) ───────────────── */}
  <section class="hs-operators" aria-label="The operators">
    <div class="hs-container">

      {/* Intro */}
      <div class="hs-intro">
        <p>The Mornington Peninsula sits above a geothermal aquifer that the Peninsula Hot Springs complex has been tapping since 2005. The thermal springs have become the Peninsula's most-booked paid experience, and the opening of <a href="/stay/alba-thermal-springs/">Alba Thermal Springs</a> a few minutes down the road at Fingal gave visitors a genuine alternative for the first time.</p>
      </div>

      {/* Peninsula Hot Springs */}
      <article class="hs-pair">
        <div class="hs-pair__visual">
          <img
            src="/images/sourced/spa-peninsula-hot-springs-hilltop-01.webp"
            alt="Peninsula Hot Springs hilltop pool, terraced into the Fingal hillside"
            loading="lazy"
          />
        </div>
        <div class="hs-pair__type">
          <p class="hs-eyebrow hs-eyebrow--quiet">The original</p>
          <h2 class="hs-pair__headline">Peninsula Hot Springs</h2>
          <p class="hs-pair__location">Springs Lane, Fingal · 20km south of Dromana via Boneo Road · car access only.</p>
          <p class="hs-pair__dek">
            The Peninsula's flagship thermal experience. Over sixty bathing
            experiences cover a Fingal hillside, with pools at varied
            temperatures, a bathhouse, a day spa, glamping accommodation
            and a café. The scale is unique in Victoria, and so are the
            queues on a summer Saturday.
          </p>

          <dl class="hs-stats">
            <div><dt>Pools</dt><dd>60+ across temperatures</dd></div>
            <div><dt>Temperature</dt><dd>38–42°C, main thermal</dd></div>
            <div><dt>Best window</dt><dd>Midweek, early morning, winter</dd></div>
            <div><dt>Avoid</dt><dd>Saturday afternoons in summer</dd></div>
          </dl>

          <a class="hs-link" href="/stay/peninsula-hot-springs/">Read the full profile <span aria-hidden="true">→</span></a>
        </div>
      </article>

      {/* Alba */}
      <article class="hs-pair hs-pair--flip">
        <div class="hs-pair__visual">
          <img
            src="/images/sourced/spa-alba-thermal-springs-01.webp"
            alt="Alba Thermal Springs at Fingal - quieter, more design-led"
            loading="lazy"
          />
        </div>
        <div class="hs-pair__type">
          <p class="hs-eyebrow hs-eyebrow--quiet">The quieter alternative</p>
          <h2 class="hs-pair__headline">Alba Thermal Springs</h2>
          <p class="hs-pair__location">Browns Road, Fingal · a few minutes from Peninsula Hot Springs.</p>
          <p class="hs-pair__dek">
            Alba opened after Peninsula Hot Springs and positioned itself
            deliberately as the quieter, more design-focused option. Fewer
            pools, fewer people. The site is smaller, which is its primary
            advantage: even peak weekends are more manageable, and a
            midweek visit feels almost private.
          </p>

          <dl class="hs-stats">
            <div><dt>Pools</dt><dd>A curated selection</dd></div>
            <div><dt>Temperature</dt><dd>Comparable thermal range</dd></div>
            <div><dt>Best for</dt><dd>Return visitors, smaller crowds</dd></div>
            <div><dt>Booking</dt><dd>Easier across all weekends</dd></div>
          </dl>

          <a class="hs-link" href="/stay/alba-thermal-springs/">Read the full profile <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>

  {/* ── Comparison ───────────────────────────────────────────────── */}
  <section id="compare" class="hs-compare" aria-label="Side by side comparison">
    <div class="hs-container">
      <p class="hs-section-label">Side by side</p>
      <h2 class="hs-compare__title">Deciding between them.</h2>
      <p class="hs-compare__dek">Peninsula Hot Springs is the place to understand what the fuss is about. Alba is the place to return to once you've ticked the main experience.</p>

      <table class="hs-table">
        <thead>
          <tr>
            <th scope="col" class="hs-table__row-label"></th>
            <th scope="col">Peninsula Hot Springs</th>
            <th scope="col">Alba</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">Scale</th><td>Large (60+ pools)</td><td>Small (curated selection)</td></tr>
          <tr><th scope="row">Crowd level</th><td>High on weekends</td><td>Lower, even on weekends</td></tr>
          <tr><th scope="row">Booking</th><td>Hard (weekends)</td><td>Easier</td></tr>
          <tr><th scope="row">Atmosphere</th><td>Variable, calm to crowded</td><td>Consistently calmer</td></tr>
          <tr><th scope="row">Best for</th><td>First-timers, maximum variety</td><td>Return visitors, peace</td></tr>
        </tbody>
      </table>

      <p class="hs-compare__more"><a class="hs-link" href="/journal/peninsula-hot-springs-vs-alba/">Read the full editorial comparison <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  {/* ── Pair with a soak ─────────────────────────────────────────── */}
  <section class="hs-pairings" aria-label="Pair with a soak">
    <div class="hs-container">
      <p class="hs-section-label">Pair with a soak</p>
      <div class="hs-pairings__grid">
        {pairWith.map((p) => (
          <a class="hs-card" href={p.href}>
            <div class="hs-card__thumb">
              <img src={p.image} alt={p.alt} loading="lazy" />
            </div>
            <p class="hs-eyebrow hs-eyebrow--quiet">{p.label}</p>
            <h3 class="hs-card__title">{p.title}</h3>
            <p class="hs-card__dek">{p.dek}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Verification line ────────────────────────────────────────── */}
  <p class="hs-verified">Last fact-verified {lastVerified} by the Peninsula Insider editors.</p>

  {/* ── FAQ ──────────────────────────────────────────────────────── */}
  <section class="hs-faq" aria-label="Frequently asked questions">
    <div class="hs-container">
      <p class="hs-section-label">Frequently asked</p>
      <h2 class="hs-faq__title">The questions we get most.</h2>
      <dl class="hs-faq__list">
        {faqs.map((f) => (
          <div class="hs-faq__item">
            <dt class="hs-faq__q"><h3>{f.q}</h3></dt>
            <dd class="hs-faq__a" set:html={f.a} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* ─────────────────────────────────────────────────────────────────
     /explore/hot-springs/ - scoped to this page only.
     Same type system as /test/: Cormorant Garamond display, Outfit
     small-caps eyebrows, italic-serif links, hairline rules, generous
     vertical air. No buttons, no chips. The image is the colour.
     ─────────────────────────────────────────────────────────────── */
  .hs-container {
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  /* Type primitives */
  .hs-eyebrow {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.7);
    margin: 0 0 1.5rem;
  }
  .hs-eyebrow--quiet {
    color: rgba(23, 20, 19, 0.55);
    margin-bottom: 1rem;
  }
  .hs-section-label {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.6);
    text-align: center;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }
  .hs-link {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: #171413;
    text-decoration: none;
    border-bottom: 1px solid rgba(23, 20, 19, 0.4);
    padding-bottom: 2px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .hs-link:hover { color: #26997e; border-bottom-color: #26997e; }
  .hs-link--quiet { font-size: 1rem; color: rgba(23, 20, 19, 0.65); }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .hs-hero {
    background: #FFFFFF;
    padding: clamp(2.5rem, 6vw, 6rem) 0 clamp(4rem, 8vw, 8rem);
  }
  .hs-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .hs-hero__headline {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.4vw, 4.8rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.018em;
    color: #171413;
    margin: 0 0 1.75rem;
    max-width: 13ch;
  }
  .hs-hero__dek {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.55;
    color: rgba(23, 20, 19, 0.78);
    margin: 0 0 2.25rem;
    max-width: 44ch;
  }
  .hs-hero__links {
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .hs-hero__visual {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .hs-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Quick answer panel ───────────────────────────────────────── */
  .hs-answer {
    background: #F6F1E8;
    padding: clamp(3.5rem, 6vw, 6rem) 0;
    border-block: 1px solid rgba(23, 20, 19, 0.08);
  }
  .hs-answer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
    max-width: 880px;
    margin: 0 auto;
  }
  .hs-answer__list li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }
  .hs-answer__num {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #26997e;
  }
  .hs-answer__text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.45;
    color: #171413;
  }
  .hs-answer__text a {
    color: #171413;
    border-bottom: 1px solid rgba(23, 20, 19, 0.35);
    text-decoration: none;
  }
  .hs-answer__text a:hover { color: #26997e; border-bottom-color: #26997e; }

  /* ── Operator panels ─────────────────────────────────────────── */
  .hs-operators { background: #FFFFFF; padding: clamp(4rem, 8vw, 8rem) 0 clamp(2rem, 4vw, 4rem); }
  .hs-intro {
    max-width: 36rem;
    margin: 0 auto clamp(4rem, 7vw, 6.5rem);
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.5vw, 1.4rem);
    line-height: 1.55;
    color: rgba(23, 20, 19, 0.78);
  }
  .hs-intro a { color: #171413; border-bottom: 1px solid rgba(23, 20, 19, 0.35); text-decoration: none; }
  .hs-intro a:hover { color: #26997e; border-bottom-color: #26997e; }

  .hs-pair {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding: clamp(3.5rem, 6vw, 5rem) 0;
    border-top: 1px solid rgba(23, 20, 19, 0.08);
  }
  .hs-pair:last-child { border-bottom: 1px solid rgba(23, 20, 19, 0.08); }
  .hs-pair--flip > .hs-pair__visual { order: 2; }
  .hs-pair--flip > .hs-pair__type { order: 1; }
  .hs-pair__visual {
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }
  .hs-pair__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hs-pair__visual:hover img { transform: scale(1.025); }
  .hs-pair__headline {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.012em;
    color: #171413;
    margin: 0 0 0.5rem;
  }
  .hs-pair__location {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: rgba(23, 20, 19, 0.55);
    margin: 0 0 1.5rem;
  }
  .hs-pair__dek {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(23, 20, 19, 0.78);
    margin: 0 0 1.75rem;
    max-width: 42ch;
  }
  .hs-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem 1.5rem;
    margin: 0 0 1.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(23, 20, 19, 0.12);
    border-bottom: 1px solid rgba(23, 20, 19, 0.12);
  }
  .hs-stats div { display: flex; flex-direction: column; gap: 0.2rem; }
  .hs-stats dt {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.55);
  }
  .hs-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.35;
    color: #171413;
  }

  /* ── Comparison ──────────────────────────────────────────────── */
  .hs-compare {
    background: #F6F1E8;
    padding: clamp(4rem, 7vw, 7rem) 0;
    border-block: 1px solid rgba(23, 20, 19, 0.08);
  }
  .hs-compare__title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    color: #171413;
    margin: 0 0 1rem;
    text-align: center;
  }
  .hs-compare__dek {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(23, 20, 19, 0.7);
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    max-width: 48ch;
    text-align: center;
  }
  .hs-table {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    border-collapse: collapse;
    background: #FFFFFF;
  }
  .hs-table thead th {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.7);
    text-align: left;
    padding: 1.4rem 1.5rem;
    border-bottom: 1px solid rgba(23, 20, 19, 0.16);
  }
  .hs-table tbody th {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(23, 20, 19, 0.55);
    text-align: left;
    padding: 1.4rem 1.5rem;
    border-bottom: 1px solid rgba(23, 20, 19, 0.08);
    width: 30%;
  }
  .hs-table tbody td {
