---
import RainyDayBody from '../../components/relationship-guides/RainyDayBody.astro';
import { staticRelationshipGuides } from '../../lib/static-relationship-guides.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import {
  buildCollectionPageSchema,
  buildItemListSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';

const collectionSchema = buildCollectionPageSchema({
  name: 'Rainy Day Things to Do on the Mornington Peninsula',
  description: 'Indoor and weather-proof activities on the Mornington Peninsula - hot springs, cellar doors, galleries, and indoor dining.',
  path: '/explore/rainy-day/',
  dateModified: '2026-04-23',
});

const itemListSchema = buildItemListSchema({
  name: 'Rainy Day Activities on the Mornington Peninsula',
  description: 'Weather-proof and indoor activities on the Mornington Peninsula.',
  listPath: '/explore/rainy-day',
  items: [
    { name: 'Peninsula Hot Springs', path: '/explore/hot-springs/', itemType: 'TouristAttraction', addressLocality: 'Fingal' },
    { name: 'Alba Thermal Springs', path: '/explore/spas-and-wellness/#alba-thermal-springs', itemType: 'TouristAttraction', addressLocality: 'Rye' },
    { name: 'Montalto winery lunch', path: '/wine/montalto/', itemType: 'TouristAttraction', addressLocality: 'Red Hill' },
    { name: 'Ten Minutes by Tractor winery lunch', path: '/wine/ten-minutes-by-tractor/', itemType: 'TouristAttraction', addressLocality: 'Main Ridge' },
    { name: 'Spa by Jackalope', path: '/explore/spas-and-wellness/#spa-by-jackalope', itemType: 'SportsActivityLocation', addressLocality: 'Merricks North' },
    { name: 'Endota Spa Mornington', path: '/explore/spas-and-wellness/#endota-spa-mornington', itemType: 'SportsActivityLocation', addressLocality: 'Mornington' },
    { name: 'Mornington Peninsula Regional Gallery', path: '/explore/places/mornington/', itemType: 'TouristAttraction', addressLocality: 'Mornington' },
  ],
});

const faqSchema = buildFaqSchema([
  {
    q: 'What is there to do on the Mornington Peninsula on a rainy day?',
    a: 'Hot springs (Peninsula Hot Springs, Alba), cellar-door lunches at covered winery restaurants, spa treatments, and the Mornington Peninsula Regional Gallery.',
  },
  {
    q: 'Are Peninsula Hot Springs good in the rain?',
    a: 'Yes. Cold rain + 40°C thermal pools = the whole point of hot springs. Both Peninsula Hot Springs and Alba operate in all weather.',
  },
  {
    q: 'Can you still enjoy the Mornington Peninsula if it rains the whole weekend?',
    a: 'Comfortably, if you plan around indoor and weather-proof activities. A hot springs visit, a winery lunch, a spa treatment, and a long dinner cover a full two days in the rain without any sacrifice.',
  },
  {
    q: 'What should I avoid on the Mornington Peninsula on a rainy day?',
    a: 'Ocean-beach walks in heavy rain and strong south-westerlies are miserable and potentially dangerous. Outdoor markets in heavy rain are thin. Long drives between open-air attractions add friction.',
  },
]);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Rainy Day' },
]);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore/' },
  { label: 'Rainy Day' },
];
export const prerender = true;
---

<BaseLayout
  title="Rainy Day Things to Do on the Mornington Peninsula · Peninsula Insider"
  description="Indoor and weather-proof activities on the Mornington Peninsula - hot springs, cellar-door lunches, spa treatments, and galleries for when the weather turns."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/rainy-day/"
  ogImage="/images/sourced/article-rainy-day-01.webp"
  searchImage="/images/sourced/article-rainy-day-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <h1 class="article__title">{staticRelationshipGuides.find(g=>g.href==='/explore/rainy-day/').title}</h1>

      <RainyDayBody />
    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>
