</style>

<script>
  import { commit, isEmptyState, parseFilters } from '../../lib/v5-filter-state';

  const NOUN = 'experiences';

  function setBrowseHidden(hide: boolean) {
    document
      .querySelectorAll<HTMLElement>('[data-browse-layer]')
      .forEach((el) => el.toggleAttribute('hidden', hide));
  }

  let bound = false;

  function init() {
    // Server renders everything visible; the browse layer yields to the
    // filtered directory whenever any facet is active (URL or interaction).
    setBrowseHidden(!isEmptyState(parseFilters(window.location.search)));
    if (bound) return;
    bound = true;

    document.addEventListener('pi:filters-changed', ((e: CustomEvent) => {
      setBrowseHidden(!isEmptyState(e.detail?.filters ?? {}));
    }) as EventListener);

    // Shelf "All N" links: apply the preset in page (one commit, no fetch)
    // and jump to the directory. Without JS the href performs a real
    // ?param#directory navigation and initFilterState applies it on load.
    document.querySelectorAll<HTMLAnchorElement>('[data-shelf-all]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        let filters;
        try {
          filters = JSON.parse(link.dataset.filters || '{}');
        } catch {
          return; // malformed preset: let the href navigate
        }
        ev.preventDefault();
        commit(filters, { source: 'chip', noun: NOUN });
        document.getElementById('directory')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // EmptyState's "Clear filters" primary action.
    document.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('[data-action="clear-filters"]');
      if (btn) commit({}, { source: 'clear', noun: NOUN });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
