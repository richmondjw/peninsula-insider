<script>
  import { commit, isEmptyState, parseFilters } from '../../lib/v5-filter-state';

  const NOUN = 'experiences';

  function setBrowseHidden(hide: boolean) {
    document
      .querySelectorAll<HTMLElement>('[data-browse-layer]')
      .forEach((el) => el.toggleAttribute('hidden', hide));
  }

  // Both document listeners are registered here rather than from init(),
  // which re-runs on every astro:page-load. The `bound` flag used to hold
  // that line; module scope runs exactly once, so it no longer has to. Both
  // handlers resolve their targets at fire time and so need nothing from the
  // page that was current when they were registered.
  // Towns and the directory open on their first dozen rows. Opening one
  // reveals every row in place and hands focus to the first new one.
  function expand(list: HTMLElement, moveFocus: boolean) {
    if (!list.hasAttribute('data-collapsed')) return;
    const firstHidden = list.querySelector<HTMLElement>('[data-overflow]');
    list.removeAttribute('data-collapsed');
    list.querySelectorAll('[data-expand]').forEach((b) => b.setAttribute('aria-expanded', 'true'));
    if (moveFocus) firstHidden?.querySelector<HTMLElement>('a[href]')?.focus();
  }

  // A filter always searches the full directory, so any active facet opens it.
  function openDirectoryForFilters(filters: Record<string, unknown>) {
    if (isEmptyState(filters as any)) return;
    document
      .querySelectorAll<HTMLElement>('[data-collapse-on-filter]')
      .forEach((list) => expand(list, false));
  }

  document.addEventListener('pi:filters-changed', ((e: CustomEvent) => {
    const filters = e.detail?.filters ?? {};
    setBrowseHidden(!isEmptyState(filters));
    openDirectoryForFilters(filters);
  }) as EventListener);

  document.addEventListener('click', (ev) => {
    const target = ev.target as HTMLElement;
    // EmptyState's "Clear filters" primary action.
    if (target.closest('[data-action="clear-filters"]')) {
      commit({}, { source: 'clear', noun: NOUN });
      return;
    }
    const more = target.closest<HTMLElement>('[data-expand]');
    const list = more?.closest<HTMLElement>('.x-expandable');
    if (list) expand(list, true);
  });

  let bound = false;

  function init() {
    // Server renders everything visible; the browse layer yields to the
    // filtered directory whenever any facet is active (URL or interaction).
    const initial = parseFilters(window.location.search);
    setBrowseHidden(!isEmptyState(initial));
    openDirectoryForFilters(initial as Record<string, unknown>);
    if (bound) return;
    bound = true;

    // Shelf "All N" links: apply the preset in page (one commit, no fetch)
    // and jump to the directory. Without JS the href performs a real
    // ?param#directory navigation and initFilterState applies it on load.
    document.querySelectorAll<HTMLAnchorElement>('[data-shelf-all]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        let filters;
        try {
          filters = JSON.parse(link.dataset.filters || '{}');
        } catch {
          return; // malformed preset: let the href navigate
        }
        ev.preventDefault();
        commit(filters, { source: 'chip', noun: NOUN });
        document.getElementById('directory')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
