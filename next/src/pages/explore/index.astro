  .x-directory__disclosure > summary, .x-picks__advice > summary, .x-faq__q { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 48px; padding: 0.9rem 0; color: var(--text); cursor: pointer; list-style: none; font: 600 var(--fs-400)/1.45 var(--font-ui); }
  :is(.x-directory__disclosure, .x-picks__advice) > summary::-webkit-details-marker, .x-faq__q::-webkit-details-marker { display: none; }
  .x-directory__disclosure > summary span { color: var(--accent); font-size: var(--fs-600); font-weight: 400; line-height: 1; }
  .x-directory__disclosure[open] > summary span { transform: rotate(45deg); }
  .x-picks__advice > summary::after, .x-faq__q::after { content: '+'; color: var(--accent); font-size: var(--fs-600); font-weight: 400; line-height: 1; }
  .x-picks__advice[open] > summary::after, .x-faq__item[open] .x-faq__q::after { transform: rotate(45deg); }
  :is(.x-directory__disclosure, .x-picks__advice) > summary:focus-visible, .x-faq__q:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .x-directory :global(.v5-card-grid--rows) { display: grid; grid-template-columns: 1fr; gap: 0 2.5rem; margin: 0; padding: 0 0 1rem; }
  .x-directory__row { list-style: none; min-width: 0; }
  @media (min-width: 64em) { .x-directory :global(.v5-card-grid--rows) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .x-picks__advice { max-width: 72ch; margin: 1rem 0 0; color: var(--soft); font-size: var(--fs-300); line-height: 1.6; }
  .x-picks__advice > summary { font-size: var(--fs-300); }
