  .x-shelf__all { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; color: var(--accent); font: 600 var(--fs-300)/1.3 var(--font-ui); text-decoration: underline; text-underline-offset: 0.25em; }
