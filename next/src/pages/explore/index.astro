---
/**
 * Explore hub (v5 redesign, T-504) - page-redesigns-hubs.md section 5.
 *
 * The old page rendered the 44-experience corpus twice (14,903 words) with
 * zero filter controls (HUB-04/05). This build: stand-first, FilterBar
 * (CHIP_PRESETS.explore), curated shelves (<=6 each, deduped, >=3 guard per
 * HUB-13), towns text index (37 places), verticals rail (6 links), then ONE
 * server-rendered directory of all experiences as compact rows carrying
 * data-facets. The A-to-Z dump is gone; every experience URL survives in the
 * directory rows.
 *
 * Filter model: one URL-persisted state (lib/v5-filter-state). Directory rows
 * carry data-facets and data-filter-countable (this list is the page's whole
 * result set, so its rows are what the counts describe); the curated browse
 * layer (shelves/towns/verticals)
 * yields to the filtered directory whenever any facet is active, so the
 * live count ("Showing N of 44 experiences") always matches one render of
 * the corpus. Shelf "All N" links apply the preset in page (no fetch) and
 * fall back to a real ?param#directory navigation without JS.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import FilterBar from '../../components/v5/FilterBar.astro';
import EmptyState from '../../components/v5/EmptyState.astro';
import TrustNote from '../../components/v5/hub/TrustNote.astro';
import HubStandfirst from '../../components/v5/hub/HubStandfirst.astro';
import CategoryBrowse from '../../components/v5/hub/CategoryBrowse.astro';
import PlanningHelp from '../../components/v5/hub/PlanningHelp.astro';
import { exploreSummary, effortLabel, durationLabel } from '../../components/v5/hub/explore-summaries.mjs';
import { informationCheckedOn } from '../../lib/verification-date.mjs';
import { getFacets, type FacetKey } from '../../lib/facets';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import { routeSlug, seasonBlurb, placeLabel, titleize, venueHref, isListableVenue } from '../../lib/editorial';
import { getAustralianSeasonLower } from '../../lib/season';
import { buildCollectionPageSchema, buildFaqSchema, buildBreadcrumbSchema } from '../../lib/schema';

// ── Copy helpers ──────────────────────────────────────────────────────────────
// Trailing words that read as unfinished if a clip lands on them. English
// function words are a closed class, so this is enumerated in full rather
// than grown one live defect at a time: the first pass listed only 25 of
// them and shipped four broken cards anyway (Arthurs Seat "...dangling
// over…", Greens Bush "...one-way through…", St Andrews "...extend
// out…"). Articles, determiners, coordinators, subordinators,
// prepositions and bare copulas all read as mid-thought.
const DANGLING_TAIL_WORDS = new Set([
  // articles + determiners
  'a', 'an', 'the', 'its', 'this', 'that', 'these', 'those', 'their', 'his',
  'her', 'our', 'your', 'some', 'any', 'every', 'each', 'both', 'either',
  // coordinators + subordinators
  'and', 'or', 'but', 'so', 'yet', 'nor', 'if', 'then', 'than', 'because',
  'though', 'although', 'while', 'whilst', 'when', 'where', 'which', 'who',
  'whom', 'whose', 'what', 'whether', 'unless', 'until', 'since', 'as',
  // prepositions
  'to', 'of', 'with', 'without', 'within', 'for', 'in', 'into', 'on', 'onto',
  'at', 'from', 'by', 'via', 'per', 'over', 'under', 'above', 'below',
  'beneath', 'between', 'among', 'amid', 'through', 'throughout', 'across',
  'along', 'around', 'about', 'after', 'before', 'during', 'near', 'toward',
  'towards', 'against', 'beyond', 'beside', 'besides', 'behind', 'upon',
  'up', 'out', 'off', 'down', 'onto', 'past', 'like', 'unlike', 'despite',
  // bare copulas / auxiliaries a clip can land on
  'is', 'are', 'was', 'were', 'be', 'been', 'being', 'has', 'have', 'had',
  'will', 'would', 'can', 'could', 'should', 'may', 'might', 'must', 'does',
  'do', 'did',
]);

// Punctuation a clip can land on that carries no meaning of its own. The
// dash forms matter: Sorrento Ocean Baths read "...reputation suggests -…"
// because only [,;:] was stripped.
const TRAILING_PUNCT = /[,;:\u2010-\u2015-]+$/u;

/**
 * First sentence, clipped to a word budget. Was previously "clipped at a
 * clause boundary" by hunting for the last comma inside the word window,
 * then always appending a period, e.g. Bushrangers Bay's real editorNote
 * clipped to "...from Cape Schanck - and, remarkably." (T-EXP-CARD-1): a
 * comma landing right after a filler word produced a fragment dressed up
 * as a finished sentence. Clip on the word budget instead, drop any
 * trailing filler word the cut lands on, and signal truncation honestly
 * with an ellipsis rather than a fabricated full stop.
 */
function clipLine(text: string | undefined | null, maxWords = 25): string | undefined {
  if (!text) return undefined;
  const sentence = text.trim().split(/(?<=[.!?])\s+/)[0] ?? text.trim();
  const words = sentence.split(/\s+/);
  if (words.length <= maxWords) return sentence;
  const cut = words.slice(0, maxWords);
  // Drop trailing tokens that read as mid-thought, alternating between bare
  // punctuation and function words. Interleaving matters: "...and -" needs
  // two passes, and stripping the dash first is what exposes the "and".
  while (cut.length > 1) {
    const bare = cut[cut.length - 1].replace(/[.!?]+$/, '').replace(TRAILING_PUNCT, '');
    if (!bare) { cut.pop(); continue; }
    if (DANGLING_TAIL_WORDS.has(bare.toLowerCase())) { cut.pop(); continue; }
    break;
  }
  return cut.join(' ').replace(/[.!?]+$/, '').replace(TRAILING_PUNCT, '').trimEnd() + '…';
}

const TYPE_LABEL: Record<string, string> = {
  walk: 'Walk',
  beach: 'Beach',
  'golf-course': 'Golf course',
  lookout: 'Lookout',
  gallery: 'Gallery',
  attraction: 'Attraction',
  park: 'Park',
  tour: 'Tour',
  market: 'Market',
  spa: 'Springs & spa',
  wellness: 'Wellness',
};

// ── Data ──────────────────────────────────────────────────────────────────────
const experiences = (await getCollection('experiences')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

type Row = {
  slug: string;
  name: string;
  href: string;
  facets: Partial<Record<FacetKey, string[]>>;
  verdict: string | undefined;
  /** The type label ('Walk', 'Beach'), rendered as the card's type mark. */
  type: string;
  /** Meta tokens after the type: place, duration, effort. Each is its own
      token, so the card draws every separator the same way (never a
      literal ' · ' inside one token). At most 3, the Card limit. */
  meta: string[];
  data: any;
};

const rows: Row[] = experiences.map((e) => {
  const slug = routeSlug(e);
  return {
    slug,
    name: e.data.name,
    href: `/explore/${slug}/`,
    facets: getFacets('experience', e.data),
    verdict: exploreSummary(slug, e.data),
    type: TYPE_LABEL[e.data.type] ?? titleize(e.data.type ?? ''),
    meta: [
      placeLabel(e.data.place),
      durationLabel(e.data.durationMinutes),
      effortLabel(e.data),
    ].filter((m): m is string => Boolean(m)).slice(0, 3),
    data: e.data,
  };
});

// Markets and day spas are Explore subjects whose records live in the venues
// collection, so their detail pages route to /eat/ and /stay/ via
// venueHrefPrefix. The directory is the one place every Explore subject is
// listed, and CHIP_PRESETS.explore offers Markets and Springs & spa chips, so
// sourcing them here is what makes those two chips match anything at all.
const EXPLORE_VENUE_TYPES = ['market', 'spa'];
const exploreVenues = (await getCollection('venues')).filter(
  (v) => isListableVenue(v) && EXPLORE_VENUE_TYPES.includes(v.data.type),
);

const venueRows: Row[] = exploreVenues.map((v) => {
  const slug = routeSlug(v);
  return {
    slug,
    name: v.data.name,
    href: venueHref(v),
    facets: getFacets('venue', v.data),
    verdict: exploreSummary(slug, v.data),
    type: TYPE_LABEL[v.data.type] ?? titleize(v.data.type ?? ''),
    meta: [placeLabel(v.data.place)].filter((m): m is string => Boolean(m)),
    data: v.data,
  };
});

// Shelves stay experience-only, keeping the "at most one shelf plus one
// directory row" rule. The directory carries the whole Explore corpus, so
// every count and every filter result is drawn from this list.
const directoryRows: Row[] = [...rows, ...venueRows].sort((a, b) =>
  a.name.localeCompare(b.name),
);

const season = getAustralianSeasonLower();
const blurb = seasonBlurb[season];

// Live-count parity with lib/v5-filter-state itemMatches: AND across facet
// keys, OR within a key. "All N" always equals what the filter will show.
type FilterPreset = Partial<Record<FacetKey, string[]>>;
const matches = (r: Row, preset: FilterPreset) =>
  Object.entries(preset).every(([key, vals]) =>
    (r.facets[key as FacetKey] ?? []).some((v) => (vals as string[]).includes(v)),
  );
// Counted over the directory, not the shelf pool: "All N" has to equal what
// the filter will actually show once applied.
const countLive = (preset: FilterPreset) =>
  directoryRows.filter((r) => matches(r, preset)).length;

// Shelf assembly: an experience appears in at most ONE shelf (plus its single
// directory row), enforcing the corpus <=2x-per-entry acceptance (spec 30).
const shelved = new Set<string>();
function pickShelf(pool: Row[], n = 6): Row[] {
  const picked = pool.filter((r) => !shelved.has(r.slug)).slice(0, n);
  for (const r of picked) shelved.add(r.slug);
  return picked;
}

const explicitSeason = rows.filter((r) => (r.data.seasonBest ?? []).includes(season));
const looseSeason = rows.filter(
  (r) => (r.facets.date ?? []).includes('this-season') && !(r.data.seasonBest ?? []).includes(season),
);
const hasCat = (r: Row, vals: string[]) => (r.facets.cat ?? []).some((v) => vals.includes(v));

const CULTURE_CATS = ['gallery', 'attraction', 'park', 'tour', 'lookout'];

interface Shelf {
  id: string;
  eyebrow: string;
  heading: string;
  preset: FilterPreset;
  total: number;
  items: (Row & { hero: { src: string; alt: string; override?: unknown } })[];
}

async function buildShelf(
  id: string,
  eyebrow: string,
  heading: string,
  pool: Row[],
  preset: FilterPreset,
): Promise<Shelf> {
  const picked = pickShelf(pool);
  const items = await Promise.all(
    picked.map(async (r) => ({ ...r, hero: await resolveHero('experience', r.slug, r.data) })),
  );
  // Duplicate-photo guard. Two shelved experiences resolving to one image
  // file print the same photograph twice on the page. The fix belongs in
  // the records, so the build names both slugs rather than silently
  // reshuffling the curation.
  for (const item of items) {
    const first = shelfImageOwner.get(item.hero.src);
    if (first && first !== item.slug) {
      console.warn(`[explore] ${first} and ${item.slug} share the image ${item.hero.src}; give one of them its own photograph.`);
    } else {
      shelfImageOwner.set(item.hero.src, item.slug);
    }
  }
  return { id, eyebrow, heading, preset, total: countLive(preset), items };
}
const shelfImageOwner = new Map<string, string>();

const shelfSeasonal = await buildShelf(
  'best-right-now',
  blurb.label,
  `${titleize(season)} ideas for the day`,
  [...explicitSeason, ...looseSeason],
  { date: ['this-season'] },
);
const shelfWalks = await buildShelf(
  'walks',
  'Coastal walks',
  'The walks that reset the weekend',
  rows.filter((r) => hasCat(r, ['walk'])),
  { cat: ['walk'] },
);
const shelfBeaches = await buildShelf(
  'beaches',
  'Beaches',
  'Which beach, and why',
  rows.filter((r) => hasCat(r, ['beach'])),
  { cat: ['beach'] },
);
const shelfGolf = await buildShelf(
  'golf',
  'Golf',
  'Choose your kind of round',
  rows.filter((r) => hasCat(r, ['golf'])),
  { cat: ['golf'] },
);
const shelfCulture = await buildShelf(
  'culture',
  'Galleries & attractions',
  'The indoor and culture layer',
  rows.filter((r) => hasCat(r, CULTURE_CATS)),
  { cat: CULTURE_CATS },
);

// HUB-13 guard: a shelf renders only when it holds at least 3 items.
const shelves = [shelfSeasonal, shelfWalks, shelfBeaches, shelfGolf, shelfCulture].filter(
  (s) => s.items.length >= 3,
);

const presetHref = (preset: FilterPreset) =>
  '/explore/?' +
  Object.entries(preset)
    .map(([k, vals]) => `${k}=${(vals as string[]).join(',')}`)
    .join('&') +
  '#directory';

// Shelf intro copy (<=40 words each), carrying the lane-page links the old
// 16-tile grid held (HUB-07 folded into intros + basics line + verticals).
// Intros are editorial lines only: how the filter works is not reader copy.
const shelfIntros: Record<string, string> = {
  'best-right-now': blurb.line,
  walks: `Cape Schanck, Bushrangers Bay, the Two Bays. The ranked list lives at <a href="/explore/walks/">the Peninsula's best walks</a>.`,
  beaches: `Bay calm or back-beach surf: pick the water that matches the wind, not the closest car park. The full case for each is in <a href="/explore/beaches/">the beach guide</a>.`,
  golf: `From friendly country clubs to the ranked links at Cape Schanck and St Andrews Beach. Compared properly in <a href="/explore/golf/">the golf guide</a>.`,
  culture: `Galleries, sculpture parks, gardens, and the national park at the tip. When the forecast turns, start with <a href="/explore/rainy-day/">rainy-day plans</a> or <a href="/explore/hot-springs/">the hot springs</a>.`,
};

// Shelf links name where they lead (the directory, filtered to the shelf's
// lane), never a bare count.
const shelfLinkLabel: Record<string, string> = {
  'best-right-now': `More ${season} ideas`,
  walks: 'All walks',
  beaches: 'All beaches',
  golf: 'All golf courses',
  culture: 'All galleries and attractions',
};

// ── Towns index (37 places, links not cards) ─────────────────────────────────
// Each line is the record's own first sentence, whole. A line is never cut
// mid-clause; a record with no short sentence to offer shows its name only.
const firstSentence = (text: string | undefined | null) =>
  text ? (text.trim().split(/(?<=[.!?])\s+/)[0] ?? '').trim() : '';
const wordCount = (text: string) => text.split(/\s+/).filter(Boolean).length;
const places = (await getCollection('places')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const towns = places.map((p) => {
  const candidates = [firstSentence(p.data.signature), firstSentence(p.data.factualLede)];
  const line = candidates.find((s) => s && wordCount(s) <= 25);
  return { slug: routeSlug(p), name: p.data.name, line };
});
// The list opens on its first dozen; the rest stay in the page (and in the
// crawl) behind "Show all".
const TOWNS_OPEN = 12;
const DIRECTORY_OPEN = 12;

// ── Verticals rail (6 text links to existing URLs) ───────────────────────────
const verticals = [
  { href: '/explore/golf/', label: 'Golf', sub: 'All courses, ranked' },
  { href: '/explore/spas-and-wellness/', label: 'Spa & springs', sub: 'Thermal water, treatments' },
  { href: '/dog-friendly/', label: 'Dog-friendly', sub: 'Beaches, walks, cafes' },
  { href: '/fishing/', label: 'Fishing', sub: 'Jetties, charters, seasons' },
  { href: '/boating/', label: 'Boating', sub: 'Ramps, hire, moorings' },
  { href: '/tour/', label: 'Tours', sub: 'Guided days and operators' },
];

const basics = [
  { href: '/explore/getting-here/', label: 'Getting here' },
  { href: '/explore/getting-around/', label: 'Getting around' },
  { href: '/stay/best-accommodation/', label: 'Where to base yourself' },
  { href: '/explore/things-to-do/', label: 'Things to do, ranked' },
  { href: '/explore/day-trips/', label: 'Day trips' },
  { href: '/explore/weekend-trips/', label: 'Weekend trips' },
  { href: '/explore/family-friendly/', label: 'With kids' },
  { href: '/journal/free-things-to-do-mornington-peninsula/', label: 'Free things to do' },
  { href: '/explore/markets/', label: 'Markets' },
  { href: '/explore/rainy-day/', label: 'Rainy day' },
];

// ── From the Journal (<=3) ───────────────────────────────────────────────────
const articlesAll = await getCollection('articles', ({ data }) => data.status === 'published');
const journalSlugs = [
  'the-peninsula-with-kids',
  'the-rainy-day-peninsula-without-a-booking',
  'the-market-saturday',
];
const journal = await Promise.all(
  journalSlugs
    .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
    .filter((a): a is NonNullable<typeof a> => Boolean(a))
    .slice(0, 3)
    .map(async (a) => {
      const slug = routeSlug(a);
      return {
        slug,
        href: a.data.section === 'plans'
          ? `/explore/plans/${slug}/`
          : `/journal/${slug}/`,
        title: a.data.title,
        verdict: clipLine(a.data.dek, 25),
        readTime: a.data.readingTimeMinutes ? `${a.data.readingTimeMinutes} min read` : undefined,
        dateISO: a.data.publishedAt ? a.data.publishedAt.toISOString() : undefined,
        hero: await resolveHero('article', slug, a.data),
      };
    }),
);

// ── Schema (title/meta unchanged from the previous build) ────────────────────
const collectionSchema = buildCollectionPageSchema({
  name: 'Explore the Mornington Peninsula, Peninsula Insider',
  description: 'Browse Mornington Peninsula activities and places by category and area, with links to walks, beaches, hot springs, golf and cultural experiences.',
  path: '/explore/',
});
const faqSchema = buildFaqSchema([
  { q: 'What is the Mornington Peninsula?',
    a: 'The Mornington Peninsula is a peninsula and local government area in Victoria, Australia, beginning roughly 40 km south of Melbourne\'s CBD and extending to the tip at Point Nepean. Its bay side (Port Phillip) is calm water; its ocean side (Bass Strait, via the Mornington Peninsula National Park) is surf and cliff. The hinterland, Red Hill, Main Ridge, Merricks, is wine and food country.' },
  { q: 'How far is the Mornington Peninsula from Melbourne?',
    a: 'The peninsula begins around 40–50 km from central Melbourne. Mornington town is about 60 km by road (50–60 min). Sorrento is 110 km by road (1 hr 20 min without traffic) or reachable via the Searoad Ferry from Queenscliff.' },
  { q: 'What is there to do on the Mornington Peninsula?',
    a: 'Hot springs, beaches (bay and ocean), coastal walks, golf, winery lunches, day spas, surf, markets, lookouts, and whale-watching in season.' },
  { q: 'When is the best time to visit the Mornington Peninsula?',
    a: 'Summer (December–February) is peak beach season and most crowded. Autumn (March–May) is the best eating and drinking season and the most comfortable for hinterland visits. Winter is quiet, atmospheric, and ideal for hot springs. Spring is underrated, especially for wildflowers and walking.' },
  { q: 'Is a car necessary to visit the Mornington Peninsula?',
    a: 'For most itineraries, yes. Public transport connects Melbourne to Frankston and a limited bus network extends further, but the hinterland, beaches, and most attractions are car-dependent.' },
]);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
]);
export const prerender = true;
---

<BaseLayout
  title="Explore the Mornington Peninsula · Activities & Places"
  description="Explore the Mornington Peninsula by activity and area: coastal walks, beaches, hot springs, golf and cultural places. Find an experience and plan your visit."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/"
  ogImage="/images/sourced/explore-cape-schanck-lighthouse-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <HubStandfirst
    compact
    title="Things to do on the Mornington Peninsula"
    standfirst="Choose a walk, a beach, an indoor afternoon or a longer outing. Start with the time and effort you have, then check the details for your day."
    image={{ src: '/images/sourced/explore-cape-schanck-lighthouse-01.webp', alt: 'Cape Schanck lighthouse and the Peninsula coastline' }}
    imagePosition="50% 25%"
  />

  <!-- 2. Filters: the page's ONE FilterBar (chips from CHIP_PRESETS.explore) -->
  <CategoryBrowse directory="directory" count={directoryRows.length} noun="experiences">
    <FilterBar
      surface="explore"
      noun="experiences"
      label="Filter experiences"
      facets={['cat', 'place', 'party', 'price']}
    />
    <TrustNote surface="explore" />
    <PlanningHelp />
  </CategoryBrowse>

  <section class="x-practical container" aria-labelledby="practical-heading">
    <h2 class="pi-eyebrow x-practical__label" id="practical-heading">Choose the shape of your day</h2>
    <nav class="x-practical__links" aria-label="Plan an activity">
      <a href="/explore/walks/">Compare walks →</a>
      <a href="/explore/rainy-day/">Plan for rain →</a>
      <a href="/explore/places/">Choose an area →</a>
      <a href="/explore/plans/">Use a ready-made day →</a>
    </nav>
    <details>
      <summary class="x-disclosure">Check conditions and practical access before you go</summary>
      <p>Times below are guide estimates, not live conditions. Walking effort is shown where recorded; it is not an accessibility assessment. Terrain, step-free access, toilets, shade and dog rules need checking for your chosen stop.</p>
      <p>Use <a href="https://www.parks.vic.gov.au/places-to-see/parks/mornington-peninsula-national-park">Parks Victoria’s park notices and access information</a>, <a href="https://www.emergency.vic.gov.au/">VicEmergency warnings</a> and <a href="https://www.beachsafe.org.au/">Beachsafe beach and patrol information</a>. Check the operator or land manager for facilities and dog restrictions. These links do not confirm that a route or beach is suitable on your day.</p>
    </details>
  </section>

  <!-- 3-5. Browse layer: shelves, towns index, verticals. Yields to the
       filtered directory whenever any facet is active. -->
  <div data-browse-layer>
    {shelves.map((shelf) => (
      <section class="x-shelf pi-section" aria-labelledby={`shelf-${shelf.id}`}>
        <div class="container">
          <div class="pi-section-head x-head">
            <div class="pi-section-head__text">
              <h2 class="pi-h2" id={`shelf-${shelf.id}`}>{shelf.heading}</h2>
              <p class="pi-section-dek x-shelf__intro" set:html={shelfIntros[shelf.id]} />
            </div>
            <a
              class="pi-section-link"
              href={presetHref(shelf.preset)}
              data-shelf-all
              data-filters={JSON.stringify(shelf.preset)}
              data-evt="filter_apply"
              data-shelf={shelf.id}
            >
              {shelfLinkLabel[shelf.id] ?? 'See all'} <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="x-shelf__row" aria-label={shelf.heading}>
            {shelf.items.map((item, i) => (
              <Card
                variant="venue"
                title={item.name}
                href={item.href}
                entityType="experience"
                entitySlug={item.slug}
                image={{ src: item.hero.src, alt: item.hero.alt, caption: !item.hero.override && item.data.heroImage?.depictionStatus === 'illustrative' ? 'Illustrative image' : !item.hero.override && item.data.heroImage?.depictionStatus === 'unverified' ? 'Image subject unverified' : undefined }}
                typeMark={item.type}
                verdict={item.verdict}
                meta={item.meta}
                freshness={informationCheckedOn(item.data)?.toISOString()}
                freshnessKind="checked"
                surface={`explore-shelf-${shelf.id}`}
                position={i + 1}
                saveSection="explore"
              />
            ))}
          </ul>
        </div>
      </section>
    ))}

    <!-- Towns text index: 37 places, links not cards -->
    <section class="x-towns" aria-labelledby="towns-heading">
      <div class="container">
        <div class="pi-section-head x-head">
          <div class="pi-section-head__text">
            <h2 class="pi-h2" id="towns-heading">Every town, its own page</h2>
            <p class="pi-section-dek">
              Browse {towns.length} towns and localities to put your day in context, with places to eat, stay and explore in each area.
            </p>
          </div>
          <a class="pi-section-link" href="/explore/places/">All towns <span aria-hidden="true">→</span></a>
