---
import { pageImage } from '../../lib/page-images';
/**
 * Explore hub (v5 redesign, T-504) - page-redesigns-hubs.md section 5.
 *
 * The old page rendered the 44-experience corpus twice (14,903 words) with
 * zero filter controls (HUB-04/05). This build: stand-first, FilterBar
 * (CHIP_PRESETS.explore), curated shelves (<=6 each, deduped, >=3 guard per
 * HUB-13), towns text index (37 places), verticals rail (6 links), then ONE
 * server-rendered directory of all experiences as compact rows carrying
 * data-facets. The A-to-Z dump is gone; every experience URL survives in the
 * directory rows.
 *
 * Filter model: one URL-persisted state (lib/v5-filter-state). Directory rows
 * carry data-facets and data-filter-countable (this list is the page's whole
 * result set, so its rows are what the counts describe); the curated browse
 * layer (shelves/towns/verticals)
 * yields to the filtered directory whenever any facet is active, so the
 * live count ("Showing N of 44 experiences") always matches one render of
 * the corpus. Shelf "All N" links apply the preset in page (no fetch) and
 * fall back to a real ?param#directory navigation without JS.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import FilterBar from '../../components/v5/FilterBar.astro';
import EmptyState from '../../components/v5/EmptyState.astro';
import TrustNote from '../../components/v5/hub/TrustNote.astro';
import CategoryBrowse from '../../components/v5/hub/CategoryBrowse.astro';
import PlanningHelp from '../../components/v5/hub/PlanningHelp.astro';
import { exploreSummary, effortLabel, durationLabel } from '../../components/v5/hub/explore-summaries.mjs';
import { informationCheckedOn } from '../../lib/verification-date.mjs';
import { getFacets, type FacetKey } from '../../lib/facets';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import { routeSlug, seasonBlurb, placeLabel, titleize, venueHref, isListableVenue } from '../../lib/editorial';
import { getAustralianSeasonLower } from '../../lib/season';
import { buildCollectionPageSchema, buildFaqSchema, buildBreadcrumbSchema } from '../../lib/schema';

// ── Copy helpers ──────────────────────────────────────────────────────────────
// Trailing words that read as unfinished if a clip lands on them. English
// function words are a closed class, so this is enumerated in full rather
// than grown one live defect at a time: the first pass listed only 25 of
// them and shipped four broken cards anyway (Arthurs Seat "...dangling
// over…", Greens Bush "...one-way through…", St Andrews "...extend
// out…"). Articles, determiners, coordinators, subordinators,
// prepositions and bare copulas all read as mid-thought.
const DANGLING_TAIL_WORDS = new Set([
  // articles + determiners
  'a', 'an', 'the', 'its', 'this', 'that', 'these', 'those', 'their', 'his',
  'her', 'our', 'your', 'some', 'any', 'every', 'each', 'both', 'either',
  // coordinators + subordinators
  'and', 'or', 'but', 'so', 'yet', 'nor', 'if', 'then', 'than', 'because',
  'though', 'although', 'while', 'whilst', 'when', 'where', 'which', 'who',
  'whom', 'whose', 'what', 'whether', 'unless', 'until', 'since', 'as',
  // prepositions
  'to', 'of', 'with', 'without', 'within', 'for', 'in', 'into', 'on', 'onto',
  'at', 'from', 'by', 'via', 'per', 'over', 'under', 'above', 'below',
  'beneath', 'between', 'among', 'amid', 'through', 'throughout', 'across',
  'along', 'around', 'about', 'after', 'before', 'during', 'near', 'toward',
  'towards', 'against', 'beyond', 'beside', 'besides', 'behind', 'upon',
  'up', 'out', 'off', 'down', 'onto', 'past', 'like', 'unlike', 'despite',
  // bare copulas / auxiliaries a clip can land on
  'is', 'are', 'was', 'were', 'be', 'been', 'being', 'has', 'have', 'had',
  'will', 'would', 'can', 'could', 'should', 'may', 'might', 'must', 'does',
  'do', 'did',
]);

// Punctuation a clip can land on that carries no meaning of its own. The
// dash forms matter: Sorrento Ocean Baths read "...reputation suggests -…"
// because only [,;:] was stripped.
const TRAILING_PUNCT = /[,;:‐-―-]+$/u;

/**
 * First sentence, clipped to a word budget. Was previously "clipped at a
 * clause boundary" by hunting for the last comma inside the word window,
 * then always appending a period, e.g. Bushrangers Bay's real editorNote
 * clipped to "...from Cape Schanck - and, remarkably." (T-EXP-CARD-1): a
 * comma landing right after a filler word produced a fragment dressed up
 * as a finished sentence. Clip on the word budget instead, drop any
 * trailing filler word the cut lands on, and signal truncation honestly
 * with an ellipsis rather than a fabricated full stop.
 */
function clipLine(text: string | undefined | null, maxWords = 25): string | undefined {
  if (!text) return undefined;
  const sentence = text.trim().split(/(?<=[.!?])\s+/)[0] ?? text.trim();
  const words = sentence.split(/\s+/);
  if (words.length <= maxWords) return sentence;
  const cut = words.slice(0, maxWords);
  // Drop trailing tokens that read as mid-thought, alternating between bare
  // punctuation and function words. Interleaving matters: "...and -" needs
  // two passes, and stripping the dash first is what exposes the "and".
  while (cut.length > 1) {
    const bare = cut[cut.length - 1].replace(/[.!?]+$/, '').replace(TRAILING_PUNCT, '');
    if (!bare) { cut.pop(); continue; }
    if (DANGLING_TAIL_WORDS.has(bare.toLowerCase())) { cut.pop(); continue; }
    break;
  }
  return cut.join(' ').replace(/[.!?]+$/, '').replace(TRAILING_PUNCT, '').trimEnd() + '…';
}

const TYPE_LABEL: Record<string, string> = {
  walk: 'Walk',
  beach: 'Beach',
  'golf-course': 'Golf course',
  lookout: 'Lookout',
  gallery: 'Gallery',
  attraction: 'Attraction',
  park: 'Park',
  tour: 'Tour',
  market: 'Market',
  spa: 'Springs & spa',
  wellness: 'Wellness',
};

// ── Data ──────────────────────────────────────────────────────────────────────
const experiences = (await getCollection('experiences')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

type Row = {
  slug: string;
  name: string;
  href: string;
  facets: Partial<Record<FacetKey, string[]>>;
  verdict: string | undefined;
  /** The type label ('Walk', 'Beach'), rendered as the card's type mark. */
  type: string;
  /** Meta tokens after the type: place, duration, effort. Each is its own
      token, so the card draws every separator the same way (never a
      literal ' · ' inside one token). At most 3, the Card limit. */
  meta: string[];
  data: any;
};

const rows: Row[] = experiences.map((e) => {
  const slug = routeSlug(e);
  return {
    slug,
    name: e.data.name,
    href: `/explore/${slug}/`,
    facets: getFacets('experience', e.data),
    verdict: exploreSummary(slug, e.data),
    type: TYPE_LABEL[e.data.type] ?? titleize(e.data.type ?? ''),
    meta: [
      placeLabel(e.data.place),
      durationLabel(e.data.durationMinutes),
      effortLabel(e.data),
    ].filter((m): m is string => Boolean(m)).slice(0, 3),
    data: e.data,
  };
});

// Markets and day spas are Explore subjects whose records live in the venues
// collection, so their detail pages route to /eat/ and /stay/ via
// venueHrefPrefix. The directory is the one place every Explore subject is
// listed, and CHIP_PRESETS.explore offers Markets and Springs & spa chips, so
// sourcing them here is what makes those two chips match anything at all.
const EXPLORE_VENUE_TYPES = ['market', 'spa'];
const exploreVenues = (await getCollection('venues')).filter(
  (v) => isListableVenue(v) && EXPLORE_VENUE_TYPES.includes(v.data.type),
);

const venueRows: Row[] = exploreVenues.map((v) => {
  const slug = routeSlug(v);
  return {
    slug,
    name: v.data.name,
    href: venueHref(v),
    facets: getFacets('venue', v.data),
    verdict: exploreSummary(slug, v.data),
    type: TYPE_LABEL[v.data.type] ?? titleize(v.data.type ?? ''),
    meta: [placeLabel(v.data.place)].filter((m): m is string => Boolean(m)),
    data: v.data,
  };
});

// Shelves stay experience-only, keeping the "at most one shelf plus one
// directory row" rule. The directory carries the whole Explore corpus, so
// every count and every filter result is drawn from this list.
const directoryRows: Row[] = [...rows, ...venueRows].sort((a, b) =>
  a.name.localeCompare(b.name),
);

const season = getAustralianSeasonLower();
const blurb = seasonBlurb[season];

// Live-count parity with lib/v5-filter-state itemMatches: AND across facet
// keys, OR within a key. "All N" always equals what the filter will show.
type FilterPreset = Partial<Record<FacetKey, string[]>>;
const matches = (r: Row, preset: FilterPreset) =>
  Object.entries(preset).every(([key, vals]) =>
    (r.facets[key as FacetKey] ?? []).some((v) => (vals as string[]).includes(v)),
  );
// Counted over the directory, not the shelf pool: "All N" has to equal what
// the filter will actually show once applied.
const countLive = (preset: FilterPreset) =>
  directoryRows.filter((r) => matches(r, preset)).length;

// Shelf assembly: an experience appears in at most ONE shelf (plus its single
// directory row), enforcing the corpus <=2x-per-entry acceptance (spec 30).
const shelved = new Set<string>();
function pickShelf(pool: Row[], n = 3): Row[] {
  const picked = pool.filter((r) => !shelved.has(r.slug)).slice(0, n);
  for (const r of picked) shelved.add(r.slug);
  return picked;
}

const explicitSeason = rows.filter((r) => (r.data.seasonBest ?? []).includes(season));
const looseSeason = rows.filter(
  (r) => (r.facets.date ?? []).includes('this-season') && !(r.data.seasonBest ?? []).includes(season),
);
const hasCat = (r: Row, vals: string[]) => (r.facets.cat ?? []).some((v) => vals.includes(v));

const CULTURE_CATS = ['gallery', 'attraction', 'park', 'tour', 'lookout'];

interface Shelf {
  id: string;
  eyebrow: string;
  heading: string;
  preset: FilterPreset;
  total: number;
  items: (Row & { hero: { src: string; alt: string; override?: unknown } })[];
}

async function buildShelf(
  id: string,
  eyebrow: string,
  heading: string,
  pool: Row[],
  preset: FilterPreset,
): Promise<Shelf> {
  const picked = pickShelf(pool);
  const items = await Promise.all(
    picked.map(async (r) => ({ ...r, hero: await resolveHero('experience', r.slug, r.data) })),
  );
  // Duplicate-photo guard. Two shelved experiences resolving to one image
  // file print the same photograph twice on the page. The fix belongs in
  // the records, so the build names both slugs rather than silently
  // reshuffling the curation.
  for (const item of items) {
    const first = shelfImageOwner.get(item.hero.src);
    if (first && first !== item.slug) {
      console.warn(`[explore] ${first} and ${item.slug} share the image ${item.hero.src}; give one of them its own photograph.`);
    } else {
      shelfImageOwner.set(item.hero.src, item.slug);
    }
  }
  return { id, eyebrow, heading, preset, total: countLive(preset), items };
}
const shelfImageOwner = new Map<string, string>();

const shelfSeasonal = await buildShelf(
  'best-right-now',
  blurb.label,
  `${titleize(season)} ideas for the day`,
  [...explicitSeason, ...looseSeason],
  { date: ['this-season'] },
);
const shelfWalks = await buildShelf(
  'walks',
  'Coastal walks',
  'The walks that reset the weekend',
  rows.filter((r) => hasCat(r, ['walk'])),
  { cat: ['walk'] },
);
const shelfBeaches = await buildShelf(
  'beaches',
  'Beaches',
  'Which beach, and why',
  rows.filter((r) => hasCat(r, ['beach'])),
  { cat: ['beach'] },
);
const shelfGolf = await buildShelf(
  'golf',
  'Golf',
  'Choose your kind of round',
  rows.filter((r) => hasCat(r, ['golf'])),
  { cat: ['golf'] },
);
const shelfCulture = await buildShelf(
  'culture',
  'Galleries & attractions',
  'The indoor and culture layer',
  rows.filter((r) => hasCat(r, CULTURE_CATS)),
  { cat: CULTURE_CATS },
);

// HUB-13 guard: a shelf renders only when it holds at least 3 items.
const shelves = [shelfSeasonal, shelfWalks, shelfBeaches, shelfCulture, shelfGolf].filter(
  (s) => s.items.length >= 3,
);

const presetHref = (preset: FilterPreset) =>
  '/explore/?' +
  Object.entries(preset)
    .map(([k, vals]) => `${k}=${(vals as string[]).join(',')}`)
    .join('&') +
  '#directory';

// Shelf intro copy (<=40 words each), carrying the lane-page links the old
// 16-tile grid held (HUB-07 folded into intros + basics line + verticals).
// Intros are editorial lines only: how the filter works is not reader copy.
const shelfIntros: Record<string, string> = {
  'best-right-now': blurb.line,
  walks: `Cape Schanck, Bushrangers Bay, the Two Bays. The ranked list lives at <a href="/explore/walks/">the Peninsula's best walks</a>.`,
  beaches: `Bay calm or back-beach surf: pick the water that matches the wind, not the closest car park. The full case for each is in <a href="/explore/beaches/">the beach guide</a>.`,
  golf: `From friendly country clubs to the ranked links at Cape Schanck and St Andrews Beach. Compared properly in <a href="/explore/golf/">the golf guide</a>.`,
  culture: `Galleries, sculpture parks, gardens, and the national park at the tip. When the forecast turns, start with <a href="/explore/rainy-day/">rainy-day plans</a> or <a href="/explore/hot-springs/">the hot springs</a>.`,
};

// Shelf links name where they lead (the directory, filtered to the shelf's
// lane), never a bare count.
const shelfLinkLabel: Record<string, string> = {
  'best-right-now': `More ${season} ideas`,
  walks: 'All walks',
  beaches: 'All beaches',
  golf: 'All golf courses',
  culture: 'All galleries and attractions',
};

// ── Towns index (37 places, links not cards) ─────────────────────────────────
// Each line is the record's own first sentence, whole. A line is never cut
// mid-clause; a record with no short sentence to offer shows its name only.
const firstSentence = (text: string | undefined | null) =>
  text ? (text.trim().split(/(?<=[.!?])\s+/)[0] ?? '').trim() : '';
const wordCount = (text: string) => text.split(/\s+/).filter(Boolean).length;
const places = (await getCollection('places')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const towns = places.map((p) => {
  const candidates = [firstSentence(p.data.signature), firstSentence(p.data.factualLede)];
  const line = candidates.find((s) => s && wordCount(s) <= 25);
  return { slug: routeSlug(p), name: p.data.name, line };
});

// ── Verticals rail (6 text links to existing URLs) ───────────────────────────
const verticals = [
  { href: '/explore/golf/', label: 'Golf', sub: 'All courses, ranked' },
  { href: '/explore/spas-and-wellness/', label: 'Spa & springs', sub: 'Thermal water, treatments' },
  { href: '/dog-friendly/', label: 'Dog-friendly', sub: 'Beaches, walks, cafes' },
  { href: '/fishing/', label: 'Fishing', sub: 'Jetties, charters, seasons' },
  { href: '/boating/', label: 'Boating', sub: 'Ramps, hire, moorings' },
  { href: '/tour/', label: 'Tours', sub: 'Guided days and operators' },
];

const basics = [
  { href: '/explore/getting-here/', label: 'Getting here' },
  { href: '/explore/getting-around/', label: 'Getting around' },
  { href: '/stay/best-accommodation/', label: 'Where to base yourself' },
  { href: '/explore/things-to-do/', label: 'Things to do, ranked' },
  { href: '/explore/day-trips/', label: 'Day trips' },
  { href: '/explore/weekend-trips/', label: 'Weekend trips' },
  { href: '/explore/family-friendly/', label: 'With kids' },
  { href: '/journal/free-things-to-do-mornington-peninsula/', label: 'Free things to do' },
  { href: '/explore/markets/', label: 'Markets' },
  { href: '/explore/rainy-day/', label: 'Rainy day' },
];

// ── From the Journal (<=3) ───────────────────────────────────────────────────
const articlesAll = await getCollection('articles', ({ data }) => data.status === 'published');
const journalSlugs = [
  'the-peninsula-with-kids',
  'the-rainy-day-peninsula-without-a-booking',
  'the-market-saturday',
];
const journal = await Promise.all(
  journalSlugs
    .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
    .filter((a): a is NonNullable<typeof a> => Boolean(a))
    .slice(0, 3)
    .map(async (a) => {
      const slug = routeSlug(a);
      return {
        slug,
        href: a.data.section === 'plans'
          ? `/explore/plans/${slug}/`
          : `/journal/${slug}/`,
        title: a.data.title,
        verdict: clipLine(a.data.dek, 25),
        readTime: a.data.readingTimeMinutes ? `${a.data.readingTimeMinutes} min read` : undefined,
        dateISO: a.data.publishedAt ? a.data.publishedAt.toISOString() : undefined,
        hero: await resolveHero('article', slug, a.data),
      };
    }),
);

// ── Schema (title/meta unchanged from the previous build) ────────────────────
const collectionSchema = buildCollectionPageSchema({
  name: 'Explore the Mornington Peninsula, Peninsula Insider',
  description: 'Browse Mornington Peninsula activities and places by category and area, with links to walks, beaches, hot springs, golf and cultural experiences.',
  path: '/explore/',
  dateModified: '2026-10-01',
});
const faqSchema = buildFaqSchema([
  { q: 'What is the Mornington Peninsula?',
    a: 'The Mornington Peninsula is a peninsula and local government area in Victoria, Australia, beginning roughly 40 km south of Melbourne\'s CBD and extending to the tip at Point Nepean. Its bay side (Port Phillip) is calm water; its ocean side (Bass Strait, via the Mornington Peninsula National Park) is surf and cliff. The hinterland, Red Hill, Main Ridge, Merricks, is wine and food country.' },
  { q: 'How far is the Mornington Peninsula from Melbourne?',
    a: 'The peninsula begins around 40–50 km from central Melbourne. Mornington town is about 60 km by road (50–60 min). Sorrento is 110 km by road (1 hr 20 min without traffic) or reachable via the Searoad Ferry from Queenscliff.' },
  { q: 'What is there to do on the Mornington Peninsula?',
    a: 'Hot springs, beaches (bay and ocean), coastal walks, golf, winery lunches, day spas, surf, markets, lookouts, and whale-watching in season.' },
  { q: 'When is the best time to visit the Mornington Peninsula?',
    a: 'Summer (December–February) is peak beach season and most crowded. Autumn (March–May) is the best eating and drinking season and the most comfortable for hinterland visits. Winter is quiet, atmospheric, and ideal for hot springs. Spring is underrated, especially for wildflowers and walking.' },
  { q: 'Is a car necessary to visit the Mornington Peninsula?',
    a: 'For most itineraries, yes. Public transport connects Melbourne to Frankston and a limited bus network extends further, but the hinterland, beaches, and most attractions are car-dependent.' },
]);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
]);
export const prerender = true;
---

<BaseLayout
  title="Explore the Mornington Peninsula · Activities & Places"
  description="Explore the Mornington Peninsula by activity and area: coastal walks, beaches, hot springs, golf and cultural places. Find an experience and plan your visit."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/"
  ogImage={pageImage('explore-hub').src}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <header class="x-hero" aria-labelledby="explore-title">
    <div class="container x-hero__grid">
      <div class="x-hero__copy">
        <h1 id="explore-title">Things to do on the Mornington Peninsula</h1>
        <p>Walk, beach or indoor day? Start with your time and effort, then check the details before you go.</p>
        <nav class="x-hero__actions" aria-label="Start exploring">
          <a class="x-hero__primary" href="#choose-day">Choose your day <span class="x-hero__arrow" aria-hidden="true"></span></a>
          <a class="x-hero__secondary" href="#directory" data-open-directory>Browse every experience <span class="x-hero__arrow x-hero__arrow--down" aria-hidden="true"></span></a>
        </nav>
      </div>
      <figure class="x-hero__media">
        <img src="/images/sourced/explore-cape-schanck-lighthouse-01.webp" alt="Cape Schanck lighthouse above coastal scrub at dusk" width="800" height="1200" loading="eager" fetchpriority="high" decoding="async" data-pi-responsive="50vw" />
        <figcaption>Cape Schanck lighthouse</figcaption>
      </figure>
    </div>
  </header>

  <section class="x-discovery" aria-labelledby="explore-filter-heading">
    <div class="container x-discovery__head">
      <h2 id="explore-filter-heading">Find a specific outing</h2>
      <p>Filter the complete guide, or open the map and choose a place.</p>
    </div>
    <div class="container x-discovery__filter">
      <FilterBar
        surface="explore"
        noun="experiences"
        label="Filter experiences"
        facets={['cat', 'place', 'party', 'price']}
      />
    </div>
    <CategoryBrowse directory="directory" count={directoryRows.length} noun="experiences">
      <TrustNote surface="explore" />
      <PlanningHelp />
    </CategoryBrowse>
  </section>

  <section class="x-choices" id="choose-day" data-browse-layer aria-labelledby="choose-day-heading">
    <div class="container">
      <div class="pi-section-head x-head">
        <div class="pi-section-head__text">
          <h2 class="pi-h2" id="choose-day-heading">What kind of day are you after?</h2>
          <p class="pi-section-dek">Start with an idea, then compare the practical details.</p>
        </div>
      </div>
      <nav class="x-choices__grid" aria-label="Choose an outing">
        <a href="/explore/walks/"><span class="x-choices__name">Take a walk</span><span class="x-choices__line">Coastal tracks and longer routes</span><span class="x-choices__arrow" aria-hidden="true"></span></a>
        <a href="/explore/beaches/"><span class="x-choices__name">Find a beach</span><span class="x-choices__line">Bay calm or open coast</span><span class="x-choices__arrow" aria-hidden="true"></span></a>
        <a href="/explore/rainy-day/"><span class="x-choices__name">Go indoors</span><span class="x-choices__line">Galleries and rainy-day ideas</span><span class="x-choices__arrow" aria-hidden="true"></span></a>
        <a href="/explore/places/"><span class="x-choices__name">Pick a town</span><span class="x-choices__line">Find a base for the day</span><span class="x-choices__arrow" aria-hidden="true"></span></a>
      </nav>
      <details class="x-choices__advice">
        <summary class="x-disclosure">Before you go: times, access and conditions</summary>
        <p>Times are guide estimates, not live conditions. Walking effort is shown where recorded; it is not an accessibility assessment. Check terrain, step-free access, toilets, shade and dog rules for your chosen stop.</p>
        <p>Use <a href="https://www.parks.vic.gov.au/places-to-see/parks/mornington-peninsula-national-park">Parks Victoria’s park notices</a>, <a href="https://www.emergency.vic.gov.au/">VicEmergency warnings</a> and <a href="https://www.beachsafe.org.au/">Beachsafe beach and patrol information</a>. These links do not confirm that a route or beach is suitable on your day.</p>
      </details>
    </div>
  </section>

  <!-- 3-5. Browse layer: shelves, towns index, verticals. Yields to the
       filtered directory whenever any facet is active. -->
  <div data-browse-layer>
    {shelves.map((shelf) => (
      <section class="x-shelf pi-section" aria-labelledby={`shelf-${shelf.id}`}>
        <div class="container">
          <div class="pi-section-head x-head">
            <div class="pi-section-head__text">
              <h2 class="pi-h2" id={`shelf-${shelf.id}`}>{shelf.heading}</h2>
              <p class="pi-section-dek x-shelf__intro" set:html={shelfIntros[shelf.id]} />
            </div>
            <a
              class="pi-section-link"
              href={presetHref(shelf.preset)}
              data-shelf-all
              data-filters={JSON.stringify(shelf.preset)}
              data-evt="filter_apply"
              data-shelf={shelf.id}
            >
              {shelfLinkLabel[shelf.id] ?? 'See all'} <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="x-shelf__row" aria-label={shelf.heading}>
            {shelf.items.map((item, i) => (
              <Card
                variant="venue"
                title={item.name}
                href={item.href}
                entityType="experience"
                entitySlug={item.slug}
                image={{ src: item.hero.src, alt: item.hero.alt, caption: !item.hero.override && item.data.heroImage?.depictionStatus === 'illustrative' ? 'Illustrative image' : !item.hero.override && item.data.heroImage?.depictionStatus === 'unverified' ? 'Image subject unverified' : undefined }}
                typeMark={item.type}
                verdict={item.verdict}
                meta={item.meta}
                freshness={informationCheckedOn(item.data)?.toISOString()}
                freshnessKind="checked"
                surface={`explore-shelf-${shelf.id}`}
                position={i + 1}
                saveSection="explore"
              />
            ))}
          </ul>
        </div>
      </section>
    ))}

    <!-- Every place URL remains in the server-rendered town index. -->
    <section class="x-towns pi-section is-dark" aria-labelledby="towns-heading">
      <div class="container x-towns__layout">
        <div class="x-towns__intro-block">
          <h2 class="pi-h2" id="towns-heading">Find your part of the Peninsula</h2>
          <p class="pi-section-dek">Browse {towns.length} towns and localities, with places to eat, stay and explore in each area.</p>
          <a class="pi-section-link x-towns__map" href="/explore/places/">Explore all towns <span aria-hidden="true">→</span></a>
        </div>
        <details class="x-towns__details">
          <summary>Open the town index <span aria-hidden="true">+</span></summary>
          <ul class="x-towns__list">
            {towns.map((t) => (
              <li class="x-towns__item">
                <a href={`/explore/places/${t.slug}/`}>{t.name}</a>
                {t.line && <span class="x-towns__line">{t.line}</span>}
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>

    <!-- Verticals rail: 6 text links to existing URLs -->
    <section class="x-verticals pi-section" aria-labelledby="verticals-heading">
      <div class="container">
        <div class="pi-section-head x-head">
          <div class="pi-section-head__text">
            <h2 class="pi-h2" id="verticals-heading">Go deeper into an interest</h2>
          </div>
        </div>
        <ul class="x-verticals__rail">
          {verticals.map((v) => (
            <li class="x-verticals__cell">
              <a href={v.href} class="x-verticals__link">
                <span class="x-verticals__label">{v.label} →</span>
                <span class="x-verticals__sub">{v.sub}</span>
              </a>
            </li>
          ))}
        </ul>
        <nav class="x-basics" aria-labelledby="basics-heading">
          <p class="pi-eyebrow" id="basics-heading">Planning basics</p>
          <ul class="x-basics__list">
            {basics.map((b) => (
              <li><a href={b.href}>{b.label}</a></li>
            ))}
            <li class="x-basics__note">
              Markets, exhibitions, and family programs run most weekends. The live calendar is at
              <a href="/whats-on/">What's On</a>.
            </li>
          </ul>
        </nav>
      </div>
    </section>
  </div>

  <!-- The complete corpus stays server-rendered and countable, with a concise arrival state. -->
  <section class="x-directory pi-section" id="directory" aria-labelledby="directory-heading">
    <div class="container">
      <div class="pi-section-head x-head">
        <div class="pi-section-head__text">
          <h2 class="pi-h2" id="directory-heading">All {directoryRows.length} experiences</h2>
          <p class="pi-section-dek">Walks, beaches, golf, galleries, lookouts, markets and day spas. Filter the guide above or open the full list.</p>
        </div>
      </div>
      <details class="x-directory__disclosure" data-directory-disclosure>
        <summary>Browse the complete directory <span aria-hidden="true">+</span></summary>
        <CardGrid label={`All ${directoryRows.length} experiences`} layout="rows">
          {directoryRows.map((r, i) => (
            <li
              data-facets={JSON.stringify(r.facets)}
              data-filter-countable
              data-title={r.name}
              class="x-directory__row"
            >
              <Card
                as="div"
                variant="compact-row"
                title={r.name}
                href={r.href}
                entityType={EXPLORE_VENUE_TYPES.includes(r.data.type) ? 'venue' : 'experience'}
                entitySlug={r.slug}
                typeMark={r.type}
                verdict={r.verdict}
                meta={r.meta}
                surface="explore-directory"
                position={i + 1}
                saveSection="explore"
              />
            </li>
          ))}
        </CardGrid>
        <div data-filter-empty hidden>
          <EmptyState variant="filter-zero" surface="explore" />
        </div>
      </details>
      <p class="x-note x-directory__plans">
        Turn it into a weekend: our <a href="/explore/plans/">escape plans</a> sequence these
        with the right lunch and the right bed.
      </p>
    </div>
  </section>

  <!-- 7. From the Journal (<=3) -->
  {journal.length > 0 && (
    <section class="x-journal pi-section" aria-labelledby="journal-heading">
      <div class="container">
        <div class="pi-section-head x-head">
          <div class="pi-section-head__text">
            <h2 class="pi-h2" id="journal-heading">Stories for the day ahead</h2>
          </div>
          <a class="pi-section-link" href="/journal/">All in the Journal <span aria-hidden="true">→</span></a>
        </div>
        {/* Section eyebrow already reads "From the Journal"; the per-card
            ARTICLE stamp is redundant, so showEyebrow is off below. */}
        <CardGrid label="From the Journal">
          {journal.map((a, i) => (
            <Card
              variant="article"
              title={a.title}
              href={a.href}
              entityType="article"
              entitySlug={a.slug}
              fieldPath="hero"
              image={{ src: a.hero.src, alt: a.hero.alt }}
              verdict={a.verdict}
              showEyebrow={false}
              readTime={a.readTime}
              dateISO={a.dateISO}
              surface="explore-journal"
              position={i + 1}
              saveSection="journal"
            />
          ))}
        </CardGrid>
      </div>
    </section>
  )}

  <!-- 8. FAQ (retained, schema unchanged) -->
  <section class="x-faq pi-section" aria-labelledby="faq-heading">
    <div class="container">
      <div class="pi-section-head x-head">
        <div class="pi-section-head__text">
          <h2 class="pi-h2" id="faq-heading">Five honest answers about Peninsula geography and access</h2>
        </div>
      </div>
      <div class="x-faq__list">
        {faqSchema.mainEntity.map((item) => (
          <details class="x-faq__item">
            <summary class="x-faq__q x-disclosure">{item.name}</summary>
            <div class="x-faq__a"><p>{item.acceptedAnswer.text}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Search band: the one harbour-deep feature band
       (was the Ask PI band; Ask PI replaced with search 2026-07-24) -->
  <section class="x-ask" aria-labelledby="ask-heading">
    <div class="container x-ask__inner">
      <div>
        <h2 class="x-ask__heading" id="ask-heading">Not sure which way to point the day?</h2>
        <p class="x-ask__line">
          Every walk, beach, spring, and back road on these pages is searchable.
          Start with a place, a mood, or the time you have.
        </p>
      </div>
      <a class="pi-btn pi-btn--inverse pi-btn--solid" href="/search/" data-open-search data-evt="search_open" data-surface="explore">Search Peninsula Insider</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Headings use the site display face (Sora, var(--font-display)); the
     page no longer reaches for an undefined editorial token that fell back
     to Georgia. Section heads use the site canon (.pi-section-head, .pi-h2,
     .pi-section-dek, .pi-section-link in global.css). On phones the head
     stacks: heading, dek, then the link at the gutter, each at full width. */
  @media (max-width: 47.99em) {
    .x-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
  .x-shelf__intro :global(a),
  .x-note a,
  .x-faq__a a {
    color: var(--harbour);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* ---- disclosures: one chevron marker for the text <summary>s ----
     The native triangle is replaced by a harbour chevron in its own
     column, so wrapped text hangs clear of it and it turns when open.
     The two full-width disclosure bars (town index, directory) keep
     their own plus marker. */
  .x-disclosure {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    column-gap: var(--space-4);
    align-items: start;
    min-height: 48px;
    padding-block: var(--space-3);
    cursor: pointer;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--text);
  }
  .x-disclosure::-webkit-details-marker { display: none; }
  .x-disclosure::after {
    content: '';
    justify-self: center;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.45em;
    border-right: 2px solid var(--harbour);
    border-bottom: 2px solid var(--harbour);
    transform: rotate(45deg);
    transition: transform var(--dur-fast, 120ms) var(--ease, ease);
  }
  details[open] > .x-disclosure::after { transform: rotate(-135deg); }
  .x-disclosure:hover { color: var(--harbour); }
  .x-disclosure:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .x-disclosure::after { transition: none; }
  }

  /* ---- hero ---- */
  .x-hero { background: var(--paper, #f2efea); }
  .x-hero__grid { display: grid; grid-template-columns: minmax(0, 0.93fr) minmax(0, 1.07fr); gap: clamp(2rem, 5vw, 5rem); height: clamp(32rem, 42vw, 39rem); }
  .x-hero__copy { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: clamp(3rem, 6vw, 6rem) 0; }
  .x-hero h1 { max-width: 16ch; margin: 0; color: var(--text); font: 600 clamp(3rem, 4.5vw, 4.85rem)/1.04 var(--font-display); letter-spacing: var(--ls-display, -0.02em); text-wrap: balance; }
  .x-hero__copy > p { max-width: 47ch; margin: 1.5rem 0 0; color: var(--soft); font: 400 clamp(1.05rem, 1.35vw, 1.2rem)/1.55 var(--font-ui); }
  .x-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem; }
  .x-hero__actions a { display: inline-flex; align-items: center; justify-content: center; gap: 0.85rem; min-height: 48px; font-family: var(--font-ui); font-weight: 700; text-decoration: none; }
  .x-hero__primary { padding: 0.75rem 1.25rem; background: var(--accent); color: var(--white); border-radius: var(--radius-s); }
  .x-hero__primary:hover { background: var(--harbour-hover, #0c4166); }
  .x-hero__secondary { color: var(--accent); text-decoration: underline !important; text-underline-offset: 0.25em; }
  .x-hero__actions a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .x-hero__arrow { position: relative; display: inline-block; width: 1rem; height: 1rem; flex: 0 0 1rem; }
  .x-hero__arrow::before { content: ''; position: absolute; left: 0; top: calc(50% - 1px); width: 0.82rem; height: 2px; background: currentColor; }
  .x-hero__arrow::after { content: ''; position: absolute; right: 0.08rem; top: 0.24rem; width: 0.48rem; height: 0.48rem; border-top: 2px solid currentColor; border-right: 2px solid currentColor; transform: rotate(45deg); }
  .x-hero__arrow--down { transform: rotate(90deg); }
  .x-hero__media { position: relative; height: 100%; min-height: 0; margin: 0; overflow: hidden; background: var(--bg-dark); }
  .x-hero__media img { display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .x-hero__media figcaption { position: absolute; right: 1rem; bottom: 1rem; padding: 0.35rem 0.6rem; color: var(--white); background: rgba(11, 46, 74, 0.88); font: 600 0.75rem/1.3 var(--font-ui); }

  /* ---- choose your day ---- */
  .x-choices { padding: clamp(3rem, 5vw, 5rem) 0 2.25rem; scroll-margin-top: 5rem; }
  .x-discovery__head h2 { margin: 0; color: var(--text); font: 600 var(--h2-size)/var(--lh-heading, 1.14) var(--font-display); letter-spacing: var(--ls-display, -0.02em); text-wrap: balance; }
  .x-discovery__head p { max-width: 30ch; margin: 0; color: var(--soft); font-size: 1rem; line-height: 1.5; }
  .x-choices__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--border); }
  .x-choices__grid a { position: relative; display: flex; flex-direction: column; gap: 0.35rem; min-height: 9rem; padding: 1.35rem 2rem 1.35rem 1rem; color: var(--text); text-decoration: none; border-right: 1px solid var(--border); transition: background var(--dur-fast, 120ms) ease; }
  .x-choices__grid a:first-child { padding-left: 0; }
  .x-choices__grid a:last-child { border-right: 0; }
  .x-choices__grid a:hover { background: var(--paper, #f2efea); }
  .x-choices__name { font: 600 clamp(1.25rem, 1.8vw, 1.6rem)/1.2 var(--font-display); }
  .x-choices__line { max-width: 19ch; color: var(--soft); font: 400 0.9rem/1.45 var(--font-ui); }
  .x-choices__arrow { position: absolute; top: 1.25rem; right: 0.85rem; width: 0.85rem; height: 0.85rem; color: var(--accent); }
  .x-choices__arrow::before { content: ''; position: absolute; right: 0; top: 0; width: 0.5rem; height: 0.5rem; border-top: 2px solid currentColor; border-right: 2px solid currentColor; }
  .x-choices__arrow::after { content: ''; position: absolute; right: 0.08rem; top: 0.38rem; width: 0.82rem; height: 2px; background: currentColor; transform: rotate(-45deg); transform-origin: right center; }
  .x-choices__advice { max-width: 72ch; margin-top: 1rem; color: var(--soft); font-size: 0.9rem; line-height: 1.6; }
  .x-choices__advice summary { color: var(--accent); font-weight: 700; }
  .x-choices__advice p { margin: 0 0 0.75rem; }
  .x-choices__advice a { color: var(--accent); text-underline-offset: 0.2em; }
  .x-choices a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .x-discovery { padding: clamp(2.5rem, 4vw, 4rem) 0 2.5rem; background: var(--paper, #f2efea); border-block: 1px solid var(--border); }
  .x-discovery__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem 3rem; margin-bottom: 0.5rem; }
  .x-discovery :global(.category-browse__links) { margin-bottom: 0.5rem; }
  .x-discovery :global(.v5-filterbar) { background: transparent; }

  /* ---- shelves ---- */
  .x-shelf { scroll-margin-top: 4rem; }
  .x-shelf:nth-of-type(even) { background: var(--bg-alt); }
  /* The choices block already opens this run of content; the first shelf
     follows it at a smaller interval so the first photographs land sooner. */
  .x-shelf:first-of-type { padding-top: var(--space-7); }

  /* Phones: a horizontal scroller whose track bleeds to the viewport edge,
     so the peeking card runs cleanly off-screen instead of being cut at
     the gutter. The shelves and the Journal row share this one pattern.
     public/assets/mobile-fixes.css clips every .container (overflow-x:
     clip), which cut the bleed off at the 16px gutter; these containers
     let it through, and the full-width section still clips the page.
     Tablet keeps a contained scroller (three cards per shelf would leave a
     2-up grid with an orphan); desktop sets the three cards in one row,
     on the frame edges. */
  .x-shelf__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-5);
  }
  .x-shelf__row > :global(li) {
    flex: 0 0 min(80%, 20rem);
    min-width: 0;
    scroll-snap-align: start;
  }
  .x-shelf__row :global(.pi-card__media) { aspect-ratio: 16 / 10; }
  @media (max-width: 47.99em) {
    .x-shelf > .container,
    .x-journal > .container { overflow-x: visible; }
    .x-shelf__row,
    .x-journal :global(.v5-card-grid) {
      display: flex;
      gap: var(--space-5);
      margin-inline-end: -16px;
      padding: 2px 16px 2px 2px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline-start: 2px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .x-shelf__row::-webkit-scrollbar,
    .x-journal :global(.v5-card-grid::-webkit-scrollbar) { display: none; }
    .x-journal :global(.v5-card-grid > li) {
      flex: 0 0 min(80%, 20rem);
      scroll-snap-align: start;
    }
  }
  @media (min-width: 48em) and (max-width: 63.99em) {
    .x-shelf__row {
      padding: 2px 2px 0.5rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .x-shelf__row::-webkit-scrollbar { display: none; }
    .x-shelf__row > :global(li) { flex-basis: min(42vw, 21rem); }
  }
  @media (min-width: 64em) {
    .x-shelf__row { display: grid; grid-template-columns: 1.16fr 1fr 1fr; }
    .x-shelf__row > :global(li) { flex: initial; }
  }

  /* ---- towns index: the dark band, canon head on the left ---- */
  .x-towns { background: var(--bg-deep); color: var(--white); }
  .x-towns__layout { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .x-towns__map { margin-top: var(--space-5); }
  .x-towns__details { border-block: 1px solid rgba(255,255,255,0.4); }
  .x-towns__details summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; cursor: pointer; list-style: none; color: var(--white); font: 700 1.05rem/1.35 var(--font-ui); }
  .x-towns__details summary::-webkit-details-marker { display: none; }
  .x-towns__details[open] summary span { transform: rotate(45deg); }
  .x-towns__details summary span { color: var(--sand, #f5c177); font-size: 1.7rem; font-weight: 400; line-height: 1; }
  /* A row-major grid, not CSS columns: each row of towns shares one track,
     so the hairlines line up across the columns and the columns end
     together, however long one line runs. */
  .x-towns__list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
  }
  .x-towns__item { padding: var(--space-3) 0; border-top: 1px solid rgba(255,255,255,0.2); font-size: var(--fs-300); }
  .x-towns__item a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
  }
  .x-towns__item a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .x-towns__line { display: block; color: var(--soft-inverse); font-size: var(--fs-300); line-height: 1.5; text-wrap: pretty; }
  .x-towns :is(a, summary):focus-visible { outline: 2px solid var(--sand, #f5c177); outline-offset: 3px; }

  /* ---- verticals ---- */
  .x-verticals { background: var(--bg-alt); }
  .x-verticals__rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 48em) {
    .x-verticals__rail { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 64em) {
    .x-verticals__rail { grid-template-columns: repeat(6, 1fr); }
  }
  /* The tile fills its stretched cell, so every tile in a row shares one
     height whatever its subline does. */
  .x-verticals__rail > li { display: flex; }
  .x-verticals__link {
    flex: 1;
    display: block;
    height: 100%;
    padding: var(--space-4);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-m, 16px);
    text-decoration: none;
    min-height: 48px;
    transition: border-color var(--dur-fast, 120ms) var(--ease, ease);
  }
  .x-verticals__link:hover { border-color: var(--harbour); }
  .x-verticals__link:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .x-verticals__label {
    display: block;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--text);
  }
  .x-verticals__link:hover .x-verticals__label { color: var(--harbour); }
  .x-verticals__sub {
    display: block;
    font-size: var(--fs-200);
    color: var(--soft);
    margin-top: var(--space-1);
  }

  /* Planning basics: a labelled link list, not a dot-joined run. The grid
     is sized to the ten links (two full rows of five on desktop, five rows
     of two below), and the What's On line closes the list as its own
     full-width row, tied to it by a hairline instead of floating under it. */
  .x-basics { margin-top: var(--space-7); }
  .x-basics__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-5);
  }
  @media (min-width: 64em) {
    .x-basics__list { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  .x-basics__list > .x-basics__note {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    line-height: var(--lh-ui, 1.5);
    color: var(--soft);
    max-width: none;
    text-wrap: pretty;
  }
  /* The note's link sits in its sentence (as before), styled like the
     sibling links but inline rather than a 44px cell. */
  .x-basics__list .x-basics__note a { display: inline; min-height: 0; }
  .x-basics__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: 600;
    color: var(--harbour);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: rgb(16 82 126 / 0.35);
    text-underline-offset: 0.2em;
  }
  .x-basics__list a:hover {
    color: var(--harbour-h);
    text-decoration-color: currentColor;
  }
  .x-basics__list a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .x-note {
    margin: var(--space-5) 0 0;
    font-size: var(--fs-300);
    color: var(--soft);
    max-width: 60ch;
    text-wrap: pretty;
  }

  /* ---- directory: one disclosure bar holding the complete list ---- */
  .x-directory { scroll-margin-top: 4rem; }
  /* With the browse layer gone (a filter is active) the directory follows
     the filter band on the same white ground, so it takes a frame rule;
     otherwise the band change above already separates it. */
  [data-browse-layer][hidden] + .x-directory > .container {
    border-top: 1px solid var(--border);
    padding-top: var(--space-6);
  }
  .x-directory__disclosure { background: var(--white); border: 1px solid var(--border); }
  .x-directory__disclosure summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.25rem; padding: 0.9rem 1.25rem; color: var(--text); cursor: pointer; list-style: none; font: 700 1rem/1.4 var(--font-ui); }
  .x-directory__disclosure summary::-webkit-details-marker { display: none; }
  .x-directory__disclosure summary span { color: var(--accent); font-size: 1.5rem; font-weight: 400; }
  .x-directory__disclosure[open] summary span { transform: rotate(45deg); }
  .x-directory__disclosure summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .x-directory :global(.v5-card-grid--rows) { display: grid; grid-template-columns: 1fr; gap: 0; margin: 0; padding: 0 1.25rem 1rem; }
  @media (min-width: 64em) {
    .x-directory :global(.v5-card-grid--rows) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-7);
    }
  }
  .x-directory__row {
    list-style: none;
    min-width: 0;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .x-directory__plans { margin-top: var(--space-6); }

  /* ---- journal ---- */
  .x-journal { background: var(--bg-alt); }

  /* ---- FAQ ---- */
  .x-faq__list { max-width: 55rem; border-top: 1px solid var(--border); }
  .x-faq__item { border-bottom: 1px solid var(--border); }
  .x-faq__q {
    font-size: var(--fs-400);
    padding-block: var(--space-4);
  }
  .x-faq__a {
    padding: 0 0 var(--space-4);
    color: var(--soft);
    max-width: 70ch;
  }
  .x-faq__a p { margin: 0; }

  /* ---- search band: harbour-deep ground, harbour-only lift ---- */
  .x-ask {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    background: var(--bg-deep);
    color: var(--white);
  }
  .x-ask::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(90% 120% at 100% 0%, rgb(16 82 126 / 0.35), transparent 60%);
  }
  .x-ask__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6, 2rem); }
  .x-ask__heading {
    max-width: 20ch;
    margin: 0 0 var(--space-3, 0.75rem);
    font-family: var(--font-display);
    font-size: var(--h2-size);
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.14);
    letter-spacing: var(--ls-display, -0.02em);
    color: var(--white);
    text-wrap: balance;
  }
  /* Dek at about 80% white; the CTA is the inverse solid (sand fill, ink
     label), which separates from the harbour-deep ground where the harbour
     solid did not (about 1.7:1). */
  .x-ask__line {
    max-width: 50ch;
    margin: 0;
    font-family: var(--font-ui);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.82);
    text-wrap: pretty;
  }

  @media (max-width: 63.99em) {
    .x-choices__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .x-choices__grid a:nth-child(2) { border-right: 0; }
    .x-choices__grid a:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    .x-choices__grid a:nth-child(3) { padding-left: 0; }
  }
  @media (max-width: 47.99em) {
    .x-hero { position: relative; isolation: isolate; overflow: hidden; background: var(--bg-deep); }
    .x-hero__grid { display: block; height: auto; min-height: 24rem; }
    .x-hero__copy { position: relative; z-index: 1; min-height: 24rem; padding: 1.5rem 0 1.25rem; justify-content: flex-end; }
    .x-hero h1 { max-width: 13ch; color: var(--white); font-size: clamp(2.5rem, 8.6vw, 3.65rem); }
    .x-hero__copy > p { margin-top: 1.1rem; color: var(--white); font-size: 1rem; line-height: 1.5; }
    .x-hero__media { position: absolute; inset: 0; z-index: 0; min-height: 0; }
    .x-hero__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(11, 31, 47, 0.96) 8%, rgba(11, 31, 47, 0.69) 62%, rgba(11, 31, 47, 0.25)); }
    .x-hero__media img { object-position: 50% 36%; }
    .x-hero__media figcaption { display: none; }
    .x-hero__primary { background: var(--sand, #f5c177); color: var(--bg-deep); }
    .x-hero__primary:hover { background: var(--white); }
    .x-hero__secondary { color: var(--white); }
    .x-hero__actions a:focus-visible { outline-color: var(--sand, #f5c177); }
    .x-discovery__head { display: block; }
    .x-discovery { padding-top: 0.5rem; }
    .x-discovery__head { margin-bottom: 0.5rem; }
    .x-discovery__head h2 { font-size: 1.5rem; line-height: 1.2; }
    .x-discovery__head p { display: none; }
    .x-towns__layout { grid-template-columns: 1fr; }
    .x-towns__list { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 24em) {
    .x-hero__copy { min-height: 0; padding: 1rem 0; }
    .x-hero h1 { font-size: 2.25rem; }
    .x-hero__copy > p { margin-top: 0.75rem; }
    .x-hero__actions { margin-top: 0.75rem; }
    .x-hero__actions { display: block; }
    .x-hero__actions a { margin: 0 0 0.35rem; }
    .x-choices__grid { grid-template-columns: 1fr; }
    .x-choices__grid a { min-height: 6.5rem; padding-left: 0 !important; border-right: 0; border-bottom: 1px solid var(--border); }
    .x-choices__grid a:last-child { border-bottom: 0; }
  }
</style>

<script>
  import { commit, isEmptyState, parseFilters } from '../../lib/v5-filter-state';

  const NOUN = 'experiences';

  function setBrowseHidden(hide: boolean) {
    document
      .querySelectorAll<HTMLElement>('[data-browse-layer]')
      .forEach((el) => el.toggleAttribute('hidden', hide));
    const directory = document.querySelector<HTMLDetailsElement>('[data-directory-disclosure]');
    if (directory) directory.open = hide;
  }

  // Both document listeners are registered here rather than from init(),
  // which re-runs on every astro:page-load. The `bound` flag used to hold
  // that line; module scope runs exactly once, so it no longer has to. Both
  // handlers resolve their targets at fire time and so need nothing from the
  // page that was current when they were registered.
  document.addEventListener('pi:filters-changed', ((e: CustomEvent) => {
    setBrowseHidden(!isEmptyState(e.detail?.filters ?? {}));
  }) as EventListener);

  // Delegation survives Astro navigation and opens the server-rendered list
  // before a same-page anchor scrolls to its summary.
  document.addEventListener('click', (ev) => {
    if (!(ev.target as HTMLElement).closest('a[href="#directory"]')) return;
    const directory = document.querySelector<HTMLDetailsElement>('[data-directory-disclosure]');
    if (directory) directory.open = true;
  });
  window.addEventListener('hashchange', () => {
    if (window.location.hash !== '#directory') return;
    const directory = document.querySelector<HTMLDetailsElement>('[data-directory-disclosure]');
    if (directory) directory.open = true;
  });

  // EmptyState's "Clear filters" primary action.
  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('[data-action="clear-filters"]');
    if (btn) commit({}, { source: 'clear', noun: NOUN });
  });

  let bound = false;

  function init() {
    // Server renders everything visible; the browse layer yields to the
    // filtered directory whenever any facet is active (URL or interaction).
    setBrowseHidden(!isEmptyState(parseFilters(window.location.search)));
    if (window.location.hash === '#directory') {
      const directory = document.querySelector<HTMLDetailsElement>('[data-directory-disclosure]');
      if (directory) directory.open = true;
    }
    if (bound) return;
    bound = true;

    // Shelf "All N" links: apply the preset in page (one commit, no fetch)
    // and jump to the directory. Without JS the href performs a real
    // ?param#directory navigation and initFilterState applies it on load.
    document.querySelectorAll<HTMLAnchorElement>('[data-shelf-all]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        let filters;
        try {
          filters = JSON.parse(link.dataset.filters || '{}');
        } catch {
          return; // malformed preset: let the href navigate
        }
        ev.preventDefault();
        commit(filters, { source: 'chip', noun: NOUN });
        document.getElementById('directory')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
