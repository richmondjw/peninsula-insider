---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import PiSaveActions from '../../components/PiSaveActions.astro';
import { editableImage } from '../../lib/inline-edit/attrs';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import {
  buildCollectionPageSchema,
  buildItemListSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';

/* The ranking is the page. Each entry is the editorial call - rank, tier,
   facts, verdict - and joins its experience record (by slug) for the photo,
   the detail link, and Save/Share. The experience collection supplies
   imagery; the ranking stays the single source of truth for what we say
   about each walk on this page. */

interface RankedWalk {
  rank: number;
  slug: string;
  name: string;
  locality: string;
  distance: string;
  time: string;
  effort: string;
  start: string;
  verdict: string;
  bestFor: string;
}

interface Tier {
  title: string;
  standfirst: string;
  walks: RankedWalk[];
}

const tiers: Tier[] = [
  {
    title: 'Tier 1: High payoff, low-to-moderate effort',
    standfirst: 'Start here. These four give you the most for the least.',
    walks: [
      {
        rank: 1,
        slug: 'cape-schanck-boardwalk',
        name: 'Cape Schanck boardwalk',
        locality: 'Cape Schanck',
        distance: '1.5 km return',
        time: '40 min',
        effort: 'Easy',
        start: 'Cape Schanck lighthouse car park',
        verdict:
          'The boardwalk descends from the lighthouse precinct to a basalt wave platform with blowholes, sea stacks, and serious Southern Ocean surge. Twenty minutes each way and entirely accessible. The best short coastal experience on the Peninsula by a margin.',
        bestFor: 'Families, first-timers, those with limited mobility.',
      },
      {
        rank: 2,
        slug: 'bushrangers-bay-walk',
        name: 'Bushrangers Bay walk',
        locality: 'Cape Schanck',
        distance: '6 km return',
        time: '2 h',
        effort: 'Moderate',
        start: 'Bushrangers Bay car park off Boneo Road',
        verdict:
          'Through coastal scrub and cliff-edge heath to an isolated cove. The bay itself is small, protected, and sees far fewer visitors than any equivalent. Moderate fitness required; no navigation difficulty.',
        bestFor: 'Walkers wanting genuine solitude; strong views on the descent.',
      },
      {
        rank: 3,
        slug: 'greens-bush-two-bays-section',
        name: 'Two Bays Walking Track: Greens Bush section',
        locality: 'Rosebud / Dromana',
        distance: '8 km return',
        time: '2.5 h',
        effort: 'Moderate',
        start: 'Greens Bush picnic area',
        verdict:
          'The best standalone section of the Two Bays track. Old-growth manna gum, wallabies in numbers, and quiet - genuinely quiet - for a place this close to Melbourne. Do this before the full track commitment.',
        bestFor: 'Those wanting a longer walk with bush character.',
      },
      {
        rank: 4,
        slug: 'point-nepean-fort-walk',
        name: 'Point Nepean fort walk',
        locality: 'Portsea',
        distance: '10 km return',
        time: '2.5 to 3 h',
        effort: 'Easy-moderate',
        start: 'Point Nepean Visitor Centre, Portsea',
        verdict:
          "The walk to Fort Nepean at the peninsula's tip, through decommissioned military land with intact fortifications, historic plaques, and unobstructed views across the Bass Strait entry to Port Phillip.",
        bestFor: 'History-focused walkers; those wanting the full end-of-land experience.',
      },
    ],
  },
  {
    title: 'Tier 2: Moderate effort, strong payoff',
    standfirst: 'Proper walks. Worth the extra commitment when you have the time.',
    walks: [
      {
        rank: 5,
        slug: 'cape-schanck-lighthouse-walk',
        name: 'Cape Schanck lighthouse walk',
        locality: 'Cape Schanck',
        distance: '3.5 km circuit',
        time: '1.5 h',
        effort: 'Moderate',
        start: 'Cape Schanck lighthouse car park',
        verdict:
          'Extends the boardwalk experience into a loop above the cliffs. Better for those wanting a proper walk rather than a stroll to the platform. The return via the lighthouse precinct adds context.',
        bestFor: 'Those combining the boardwalk with a longer circuit.',
      },
      {
        rank: 6,
        slug: 'two-bays-walking-track',
        name: 'Two Bays Walking Track: full route',
        locality: 'Dromana to Cape Schanck',
        distance: '26 km point-to-point',
        time: 'Full day',
        effort: 'Demanding',
        start: 'Dromana',
        verdict:
          "The Peninsula's flagship long walk - from Port Phillip Bay to Bass Strait, crossing the hinterland through Greens Bush. Most visitors tackle the 8–10 km sections near either end.",
        bestFor: 'Experienced day-walkers; multi-section visits.',
      },
      {
        rank: 7,
        slug: 'summit-circuit-arthurs-seat',
        name: 'Arthurs Seat summit circuit',
        locality: 'Arthurs Seat',
        distance: '2.5 km circuit',
        time: '1 h',
        effort: 'Moderate',
        start: 'Arthurs Seat State Park summit car park',
        verdict:
          'If you drive to the summit (or take the gondola), this circuit delivers the full 360-degree view sequence - bay, hinterland, ocean. Short but steep in places.',
        bestFor: 'Those combining with the Arthurs Seat Eagle; families.',
      },
      {
        rank: 8,
        slug: 'coppins-track',
        name: 'Coppins Track',
        locality: 'Sorrento',
        distance: '4 km return',
        time: '1.5 h',
        effort: 'Easy-moderate',
        start: 'Sullivan Bay, Sorrento',
        verdict:
          "A cliff-edge track connecting Sorrento's bay to its back beach through tea-tree heath. One of the few walks that meaningfully crosses the Peninsula's two-face geography.",
        bestFor: 'Sorrento-based visitors; those wanting bay-to-ocean connection.',
      },
    ],
  },
  {
    title: 'Tier 3: Good walks, specific contexts',
    standfirst: 'Right walk, right day. Each earns its place for a particular reader.',
    walks: [
      {
        rank: 9,
        slug: 'mornington-foreshore-walk',
        name: 'Mornington foreshore walk',
        locality: 'Mornington',
        distance: '4 km one-way',
        time: '1 h',
        effort: 'Easy',
        start: 'Mornington Harbour',
        verdict:
          'A pleasant bay-side foreshore path from the harbour to Mills Beach. Better as a morning or evening walk framing a visit to the town than as a destination walk.',
        bestFor: 'Town visitors; easy morning walks; families with prams.',
      },
      {
        rank: 10,
        slug: 'farnsworth-track',
        name: 'Farnsworth Track',
        locality: 'Point Nepean',
        distance: '5 km circuit',
        time: '1.5 h',
        effort: 'Easy-moderate',
        start: 'Point Nepean Visitor Centre',
        verdict:
          'A quieter alternative to the main fort walk, through ti-tree and banksia coastal heath. Better for wildlife than the military-heritage route.',
        bestFor: 'Wildlife-focused walkers; those wanting a quieter Point Nepean experience.',
      },
      {
        rank: 11,
        slug: 'coastal-walk-cape-schanck',
        name: 'Coastal walk at Cape Schanck',
        locality: 'Cape Schanck to Tootgarook',
        distance: '13 km one-way',
        time: 'Half day',
        effort: 'Moderate',
        start: 'Cape Schanck lighthouse car park',
        verdict:
          'The longer coastal walk north from Cape Schanck toward Rye - a section of the full 26 km Cape Schanck to London Bridge coastal route. Good cliff scenery, less visited than the boardwalk sections, requires transport coordination at the far end.',
        bestFor: 'Experienced walkers; those wanting a full coastal half-day.',
      },
    ],
  },
];

const allRanked = tiers.flatMap((t) => t.walks);

/* Join each ranked walk to its experience record for hero + save metadata. */
const experiences = await getCollection('experiences');
const bySlug = new Map(experiences.map((e) => [e.data.slug ?? e.id.replace(/\.json$/, ''), e]));

const heroes = new Map<string, { src: string; alt: string }>();
for (const w of allRanked) {
  const exp = bySlug.get(w.slug);
  const hero = exp ? await resolveHero('experience', w.slug, exp.data) : null;
  if (hero) heroes.set(w.slug, { src: hero.src, alt: hero.alt });
}

/* FAQ: one array feeds both the visible block and the JSON-LD, so the
   structured data can never say something the page does not. */
const faqs = [
  {
    q: 'What is the best walk on the Mornington Peninsula?',
    a: 'Cape Schanck boardwalk for the best effort-to-payoff ratio. Bushrangers Bay for the best uncrowded experience. Two Bays Walking Track for the best full-day walk.',
  },
  {
    q: 'Is the Two Bays Walking Track a full day?',
    a: 'The complete 26 km route is a full day for fit walkers. Most visitors do one of the standalone sections - Greens Bush at the Dromana end, or the Cape Schanck sections at the ocean end. Each section can be done in 2–4 hours.',
  },
  {
    q: 'Do I need to pay to walk at Point Nepean?',
    a: 'Parks Victoria charges entry fees for Point Nepean National Park. Most walkers park at the visitor centre and either walk or take the fee-based troop carrier toward the fort.',
  },
  {
    q: 'Are there easy walks suitable for families and young children?',
    a: 'Yes. Cape Schanck boardwalk is accessible and short. Mornington foreshore walk is flat and pram-friendly. Arthurs Seat summit circuit is manageable for children 5+ with adult supervision.',
  },
  {
    q: 'What is the best walk in the Mornington Peninsula National Park?',
    a: 'The Bushrangers Bay walk and the Cape Schanck boardwalk are both within or adjacent to the national park. The Bushrangers Bay walk has better scenery per effort unit for experienced walkers.',
  },
];

const collectionSchema = buildCollectionPageSchema({
  name: 'Best Walks on the Mornington Peninsula',
  description: "Ranked editorial guide to the Peninsula's best walks - coastal, hinterland, and national park. Effort, distance, and payoff rated.",
  path: '/explore/walks/',
  dateModified: '2026-08-09',
});

const itemListSchema = buildItemListSchema({
  name: 'Best Walks on the Mornington Peninsula',
  description: "Ranked editorial guide to the Peninsula's best walks - coastal, hinterland, and national park.",
  listPath: '/explore/walks',
  items: allRanked.map((w) => ({
    name: w.name,
    path: `/explore/${w.slug}/`,
    itemType: 'TouristAttraction',
    addressLocality: w.locality.split(' / ')[0].split(' to ')[0],
  })),
});

const faqSchema = buildFaqSchema(faqs);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Walks' },
]);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore/' },
  { label: 'Walks' },
];
export const prerender = true;
---

<BaseLayout
  title="Best Walks on the Mornington Peninsula · Peninsula Insider"
  description="Ranked editorial guide to the Peninsula's best walks - coastal, hinterland, and national park. Effort, distance, and payoff rated for 11 walks."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/walks/"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <h1 class="article__title">The best walks on the Mornington Peninsula</h1>

      <div class="prose">
        <blockquote>
          <p><strong>TL;DR</strong></p>
          <ul>
            <li>Eleven ranked walks below, from a 20-minute boardwalk to a 26 km full-day track.</li>
            <li><a href="#cape-schanck-boardwalk">Cape Schanck boardwalk</a> is the best effort-to-payoff ratio on the Peninsula.</li>
            <li><a href="#two-bays-walking-track">Two Bays Walking Track</a> (26 km) is the Peninsula's flagship long walk; most visitors do sections.</li>
            <li><a href="#bushrangers-bay-walk">Bushrangers Bay</a> has some of the best coastal scenery and the least foot traffic of any good walk here.</li>
            <li>All walks are accessible without specialist equipment; none require permits.</li>
          </ul>
        </blockquote>

        <p>The Mornington Peninsula has one of the most varied walking menus of any coastal region in Victoria. Bay-side foreshore paths. Clifftop boardwalks over Bass Strait. National park bush trails. A 26 km coast-to-coast route. And hinterland ridge-top paths through old-growth manna gum that see almost nobody outside school holidays. This hub ranks 11 walks by effort and payoff - the combination of physical demand and the quality of what you get for it.</p>
      </div>

      <nav class="wr-index" aria-label="The ranking at a glance">
        {tiers.map((tier) => (
          <div class="wr-index__tier">
            <p class="wr-index__tier-name">{tier.title.split(':')[0]}</p>
            <ol class="wr-index__list" start={tier.walks[0].rank}>
              {tier.walks.map((w) => (
                <li>
                  <a href={`#${w.slug}`}>
                    <span class="wr-index__name">{w.name}</span>
                    <span class="wr-index__time">{w.time}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </nav>
    </div>
  </article>

  <section class="wr-ranking">
    <div class="container">
      {tiers.map((tier) => (
        <section class="wr-tier">
          <header class="wr-tier__head">
            <h2 class="wr-tier__title">{tier.title}</h2>
            <p class="wr-tier__standfirst">{tier.standfirst}</p>
          </header>

          {tier.walks.map((w) => {
            const hero = heroes.get(w.slug);
            return (
              <article class="wr" id={w.slug}>
                {hero && (
                  <a class="wr__media" href={`/explore/${w.slug}/`} tabindex="-1">
                    <img
                      src={hero.src}
                      alt={hero.alt}
                      loading={w.rank === 1 ? 'eager' : 'lazy'}
                      fetchpriority={w.rank === 1 ? 'high' : undefined}
                      decoding="async"
                      width="800"
                      height="600"
                      sizes="(max-width: 760px) 92vw, 380px"
                      {...editableImage({
                        entityType: 'experience',
                        entitySlug: w.slug,
                        fieldPath: 'heroImage',
                        label: `${w.name} hero`,
                        purpose: 'hero',
                      })}
                    />
                  </a>
                )}
                <div class="wr__body">
                  <h3 class="wr__name">
                    <span class="wr__rank" aria-hidden="true">{w.rank}</span>
                    <a href={`/explore/${w.slug}/`}>{w.name}</a>
                  </h3>
                  <p class="wr__place">{w.locality}</p>
                  <ul class="wr__meta">
                    <li>{w.distance}</li>
                    <li>{w.time}</li>
                    <li>{w.effort}</li>
                  </ul>
                  <p class="wr__verdict">{w.verdict}</p>
                  <p class="wr__bestfor"><strong>Best for:</strong> {w.bestFor}</p>
                  <p class="wr__start">Start: {w.start}</p>
                </div>
                <PiSaveActions
                  kind="experience"
                  slug={w.slug}
                  title={w.name}
                  href={`/explore/${w.slug}/`}
                  dek={w.verdict}
                  imageUrl={hero?.src}
                />
              </article>
            );
          })}
        </section>
      ))}
      <p class="wr-ranking__return"><a href="#top">Back to the top of the ranking</a></p>
    </div>
  </section>

  <section class="article wr-notes">
    <div class="container">
      <div class="prose">
        <h2>What to bring</h2>
        <p>No walk on this list requires specialist equipment. For any walk over 5 km: water (1 L minimum), sunscreen, a hat, and footwear with grip. Ocean-side tracks can be slippery when wet.</p>

        <h2>FAQ</h2>
        <div class="wr-faq">
          {faqs.map((f) => (
            <details class="wr-faq__item">
              <summary class="wr-faq__q">{f.q}</summary>
              <p class="wr-faq__a">{f.a}</p>
            </details>
          ))}
        </div>

        <h2>Further reading</h2>
        <ul>
          <li><a href="/journal/two-bays-walk-mornington-peninsula/">Two Bays Walk deep guide</a></li>
          <li><a href="/journal/walks-bushrangers-bay-walk-guide/">Bushrangers Bay walk guide</a></li>
          <li><a href="/journal/the-peninsulas-best-late-afternoon-walks/">Best late-afternoon walks on the Peninsula</a></li>
          <li><a href="/explore/">All Peninsula experiences</a></li>
        </ul>

        <p><em>Last fact-verified 23 April 2026</em></p>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* ── The ranking at a glance ── */
  .wr-index {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5) var(--space-6);
    margin: var(--space-7) 0 var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .wr-index__tier-name {
    font-family: var(--font-display);
    font-size: var(--fs-300);
    font-weight: var(--fw-semibold);
    color: var(--dark);
    margin-bottom: var(--space-3);
  }
  .wr-index__list {
    margin: 0;
    padding-left: 1.4rem;
  }
  .wr-index__list li + li { margin-top: var(--space-1); }
  .wr-index__list li::marker {
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: var(--fw-semibold);
    color: var(--accent);
  }
  .wr-index__list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-1) 0;
    font-size: var(--fs-300);
    line-height: var(--lh-ui);
    color: var(--text);
    text-decoration: none;
  }
  .wr-index__list a:hover .wr-index__name { color: var(--accent); }
  .wr-index__name {
    border-bottom: 1px solid var(--border);
    transition: color var(--dur-fast) var(--ease-enter);
  }
  .wr-index__time {
    flex-shrink: 0;
    font-size: var(--fs-200);
    color: var(--soft);
    font-variant-numeric: tabular-nums;
  }

  /* ── Ranked entries ── */
  .wr-ranking { padding-bottom: var(--space-7); }
  .wr-tier__head {
    margin: var(--space-8) 0 var(--space-5);
    max-width: var(--measure-prose);
  }
  .wr-tier:first-of-type .wr-tier__head { margin-top: var(--space-6); }
  .wr-tier__title {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display);
    line-height: var(--lh-heading);
    color: var(--dark);
    margin-bottom: var(--space-2);
  }
  .wr-tier__standfirst {
    font-size: var(--fs-500);
    line-height: var(--lh-dek);
    color: var(--soft);
    max-width: var(--measure-dek);
  }

  .wr {
    position: relative;
    display: grid;
    grid-template-columns: minmax(240px, 360px) 1fr;
    gap: var(--space-5) var(--space-6);
    padding: var(--space-6) 0 var(--space-7);
    border-top: 1px solid var(--border);
    scroll-margin-top: 6rem;
  }
  .wr__media {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--bg-alt);
  }
  .wr__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-enter);
  }
  .wr:hover .wr__media img { transform: scale(1.025); }
  @media (prefers-reduced-motion: reduce) {
    .wr:hover .wr__media img { transform: none; }
  }

  .wr__body {
    max-width: var(--measure-prose);
    /* Reserve the bottom-right zone for the floating Save/Share pills. */
    padding-bottom: var(--space-2);
  }
  .wr__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-600);
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    line-height: var(--lh-heading);
    color: var(--dark);
    margin: 0 0 var(--space-1);
  }
  .wr__name a { color: inherit; text-decoration: none; }
  .wr__name a:hover { color: var(--accent); }
  .wr__rank {
    flex-shrink: 0;
    font-size: var(--fs-600);
    font-weight: var(--fw-bold);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .wr__place {
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    color: var(--soft);
    margin: 0 0 var(--space-4);
  }
  .wr__meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
  }
  .wr__meta li {
    font-family: var(--font-ui);
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    line-height: var(--lh-label);
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.75rem;
  }
  .wr__verdict {
    font-size: var(--fs-400);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 var(--space-4);
  }
  .wr__bestfor {
    font-size: var(--fs-300);
    line-height: var(--lh-ui);
    color: var(--text);
    margin: 0 0 var(--space-2);
  }
  .wr__bestfor strong { font-weight: var(--fw-semibold); color: var(--dark); }
  .wr__start {
    font-size: var(--fs-300);
    line-height: var(--lh-ui);
    color: var(--soft);
    margin: 0;
  }
  .wr-ranking__return {
    margin-top: var(--space-6);
    font-size: var(--fs-300);
  }
  .wr-ranking__return a { color: var(--accent); }

  .wr-notes { padding-top: var(--space-2); }

  /* ── FAQ ── */
  .wr-faq { margin: var(--space-4) 0 var(--space-6); }
  .wr-faq__item {
    border-top: 1px solid var(--border);
  }
  .wr-faq__item:last-child { border-bottom: 1px solid var(--border); }
  .wr-faq__q {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: var(--fs-400);
    font-weight: var(--fw-semibold);
    color: var(--dark);
  }
  .wr-faq__q::-webkit-details-marker { display: none; }
  .wr-faq__q::after {
    content: '+';
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-weight: var(--fw-body);
    font-size: var(--fs-500);
    color: var(--accent);
    line-height: 1;
    transition: transform var(--dur-med) var(--ease-enter);
  }
  .wr-faq__item[open] .wr-faq__q::after { transform: rotate(45deg); }
  .wr-faq__a {
    margin: 0;
    padding: 0 0 var(--space-5);
    max-width: var(--measure-prose);
    color: var(--text);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .wr-index { grid-template-columns: 1fr; gap: var(--space-5); }
