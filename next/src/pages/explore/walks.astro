---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import PiSaveActions from '../../components/PiSaveActions.astro';
import { editableImage } from '../../lib/inline-edit/attrs';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import ProvenanceLine from '../../components/ProvenanceLine.astro';
import CorrectionNote from '../../components/CorrectionNote.astro';
import {
  buildCollectionPageSchema,
  buildItemListSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';

/* The ranking is the page. Each entry is the editorial call (rank, tier,
   facts, verdict) and joins its experience record (by slug) for the photo,
   the detail link, and Save/Share. The experience collection supplies
   imagery; the ranking stays the single source of truth for what we say
   about each walk on this page. */

interface RankedWalk {
  rank: number;
  slug: string;
  name: string;
  locality: string;
  distance: string;
  time: string;
  effort: string;
  start: string;
  verdict: string;
  bestFor: string;
}

interface Tier {
  title: string;
  standfirst: string;
  walks: RankedWalk[];
}

const tiers: Tier[] = [
  {
    title: 'Start here',
    standfirst: 'High payoff, low-to-moderate effort. These four give you the most for the least.',
    walks: [
      {
        rank: 1,
        slug: 'cape-schanck-boardwalk',
        name: 'Cape Schanck boardwalk',
        locality: 'Cape Schanck',
        distance: '1.5 km return',
        time: '40 min',
        effort: 'Easy',
        start: 'Cape Schanck lighthouse car park',
        verdict:
          'The boardwalk descends from the lighthouse precinct to a basalt wave platform with blowholes, sea stacks, and serious Southern Ocean surge. Twenty minutes each way and entirely accessible. The best short coastal experience on the Peninsula by a margin.',
        bestFor: 'Families, first-timers, those with limited mobility.',
      },
      {
        rank: 2,
        slug: 'bushrangers-bay-walk',
        name: 'Bushrangers Bay walk',
        locality: 'Cape Schanck',
        distance: '6 km return',
        time: '2 h',
        effort: 'Moderate',
        start: 'Bushrangers Bay car park off Boneo Road',
        verdict:
          'Through coastal scrub and cliff-edge heath to an isolated cove. The bay itself is small, protected, and sees far fewer visitors than any equivalent. Moderate fitness required; no navigation difficulty.',
        bestFor: 'Walkers wanting genuine solitude; strong views on the descent.',
      },
      {
        rank: 3,
        slug: 'greens-bush-two-bays-section',
        name: 'Two Bays Walking Track: Greens Bush section',
        locality: 'Rosebud / Dromana',
        distance: '8 km return',
        time: '2.5 h',
        effort: 'Moderate',
        start: 'Greens Bush picnic area',
        verdict:
          'The best standalone section of the Two Bays track. Old-growth manna gum, wallabies in numbers, and quiet, genuinely quiet, for a place this close to Melbourne. Do this before the full track commitment.',
        bestFor: 'Those wanting a longer walk with bush character.',
      },
      {
        rank: 4,
        slug: 'point-nepean-fort-walk',
        name: 'Point Nepean fort walk',
        locality: 'Portsea',
        distance: '10 km return',
        time: '2.5 to 3 h',
        effort: 'Easy-moderate',
        start: 'Point Nepean Visitor Centre, Portsea',
        verdict:
          "The walk to Fort Nepean at the peninsula's tip, through decommissioned military land with intact fortifications, historic plaques, and unobstructed views across the Bass Strait entry to Port Phillip.",
        bestFor: 'History-focused walkers; those wanting the full end-of-land experience.',
      },
    ],
  },
  {
    title: 'Proper walks',
    standfirst: 'Moderate effort, strong payoff. Worth it when you have the time.',
    walks: [
      {
        rank: 5,
        slug: 'cape-schanck-lighthouse-walk',
        name: 'Cape Schanck lighthouse walk',
        locality: 'Cape Schanck',
        distance: '3.5 km circuit',
        time: '1.5 h',
        effort: 'Moderate',
        start: 'Cape Schanck lighthouse car park',
        verdict:
          'Extends the boardwalk experience into a loop above the cliffs. Better for those wanting a proper walk rather than a stroll to the platform. The return via the lighthouse precinct adds context.',
        bestFor: 'Those combining the boardwalk with a longer circuit.',
      },
      {
        rank: 6,
        slug: 'two-bays-walking-track',
        name: 'Two Bays Walking Track: full route',
        locality: 'Dromana to Cape Schanck',
        distance: '26 km point-to-point',
        time: 'Full day',
        effort: 'Demanding',
        start: 'Dromana',
        verdict:
          "The Peninsula's flagship long walk: from Port Phillip Bay to Bass Strait, crossing the hinterland through Greens Bush. Most visitors tackle the 8–10 km sections near either end.",
        bestFor: 'Experienced day-walkers; multi-section visits.',
      },
      {
        rank: 7,
        slug: 'summit-circuit-arthurs-seat',
        name: 'Arthurs Seat summit circuit',
        locality: 'Arthurs Seat',
        distance: '2.5 km circuit',
        time: '1 h',
        effort: 'Moderate',
        start: 'Arthurs Seat State Park summit car park',
        verdict:
          'If you drive to the summit (or take the gondola), this circuit delivers the full 360-degree view sequence: bay, hinterland, ocean. Short but steep in places.',
        bestFor: 'Those combining with the Arthurs Seat Eagle; families.',
      },
      {
        rank: 8,
        slug: 'coppins-track',
        name: 'Coppins Track',
        locality: 'Sorrento',
        distance: '4 km return',
        time: '1.5 h',
        effort: 'Easy-moderate',
        start: 'Sullivan Bay, Sorrento',
        verdict:
          "A cliff-edge track connecting Sorrento's bay to its back beach through tea-tree heath. One of the few walks that meaningfully crosses the Peninsula's two-face geography.",
        bestFor: 'Sorrento-based visitors; those wanting bay-to-ocean connection.',
      },
    ],
  },
  {
    title: 'Right walk, right day',
    standfirst: 'Good walks in specific contexts. Each earns its place for a particular reader.',
    walks: [
      {
        rank: 9,
        slug: 'mornington-foreshore-walk',
        name: 'Mornington foreshore walk',
        locality: 'Mornington',
        distance: '4 km one-way',
        time: '1 h',
        effort: 'Easy',
        start: 'Mornington Harbour',
        verdict:
          'A pleasant bay-side foreshore path from the harbour to Mills Beach. Better as a morning or evening walk framing a visit to the town than as a destination walk.',
        bestFor: 'Town visitors; easy morning walks; families with prams.',
      },
      {
        rank: 10,
        slug: 'farnsworth-track',
        name: 'Farnsworth Track',
        locality: 'Point Nepean',
        distance: '5 km circuit',
        time: '1.5 h',
        effort: 'Easy-moderate',
        start: 'Point Nepean Visitor Centre',
        verdict:
          'A quieter alternative to the main fort walk, through ti-tree and banksia coastal heath. Better for wildlife than the military-heritage route.',
        bestFor: 'Wildlife-focused walkers; those wanting a quieter Point Nepean experience.',
      },
      {
        rank: 11,
        slug: 'coastal-walk-cape-schanck',
        name: 'Coastal walk at Cape Schanck',
        locality: 'Cape Schanck to Tootgarook',
        distance: '13 km one-way',
        time: 'Half day',
        effort: 'Moderate',
        start: 'Cape Schanck lighthouse car park',
        verdict:
          'The longer coastal walk north from Cape Schanck toward Rye, a section of the full 26 km Cape Schanck to London Bridge coastal route. Good cliff scenery, less visited than the boardwalk sections, requires transport coordination at the far end.',
        bestFor: 'Experienced walkers; those wanting a full coastal half-day.',
      },
    ],
  },
];

const allRanked = tiers.flatMap((t) => t.walks);

/* Join each ranked walk to its experience record for hero + save metadata. */
const experiences = await getCollection('experiences');
const bySlug = new Map(experiences.map((e) => [e.data.slug ?? e.id.replace(/\.json$/, ''), e]));

const heroes = new Map<string, { src: string; alt: string }>();
for (const w of allRanked) {
  const exp = bySlug.get(w.slug);
  const hero = exp ? await resolveHero('experience', w.slug, exp.data) : null;
  if (hero) heroes.set(w.slug, { src: hero.src, alt: hero.alt });
}

/* Duplicate-photo guard. Two ranked walks resolving to one hero file print
   the same photograph twice on this page (coastal-walk-cape-schanck reuses
   the boardwalk frame). The fix is a new image in the record, so the build
   names both slugs rather than silently choosing between them. */
const heroOwner = new Map<string, string>();
for (const [slug, hero] of heroes) {
  const first = heroOwner.get(hero.src);
  if (first) {
    console.warn(`[walks] ${first} and ${slug} share the hero image ${hero.src}; give one of them its own photograph.`);
  } else {
    heroOwner.set(hero.src, slug);
  }
}

/* The provenance foot describes the eleven ranked walks, not the whole
   experiences collection, so its date is the date of what this page ranks. */
const rankedRecords = allRanked
  .map((w) => bySlug.get(w.slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

/* Cover art: the Cape Schanck storm-light shot. Static art direction for
   this page (the per-walk imagery below stays CMS-editable per entry). */
const cover = {
  src: '/images/sourced/home-cover-cape-schanck-rainbow-01.webp',
  alt: 'Storm light breaking over the Cape Schanck coastline, Mornington Peninsula',
};

/* FAQ: one array feeds both the visible block and the JSON-LD, so the
   structured data can never say something the page does not. */
const faqs = [
  {
    q: 'What is the best walk on the Mornington Peninsula?',
    a: 'Cape Schanck boardwalk for the best effort-to-payoff ratio. Bushrangers Bay for the best uncrowded experience. Two Bays Walking Track for the best full-day walk.',
  },
  {
    q: 'Is the Two Bays Walking Track a full day?',
    a: 'The complete 26 km route is a full day for fit walkers. Most visitors do one of the standalone sections: Greens Bush at the Dromana end, or the Cape Schanck sections at the ocean end. Each section can be done in 2–4 hours.',
  },
  {
    q: 'Do I need to pay to walk at Point Nepean?',
    a: 'Parks Victoria charges entry fees for Point Nepean National Park. Most walkers park at the visitor centre and either walk or take the fee-based troop carrier toward the fort.',
  },
  {
    q: 'Are there easy walks suitable for families and young children?',
    a: 'Yes. Cape Schanck boardwalk is accessible and short. Mornington foreshore walk is flat and pram-friendly. Arthurs Seat summit circuit is manageable for children 5+ with adult supervision.',
  },
  {
    q: 'What is the best walk in the Mornington Peninsula National Park?',
    a: 'The Bushrangers Bay walk and the Cape Schanck boardwalk are both within or adjacent to the national park. The Bushrangers Bay walk has better scenery per effort unit for experienced walkers.',
  },
];

const collectionSchema = buildCollectionPageSchema({
  name: 'Best Walks on the Mornington Peninsula',
  description: "Ranked editorial guide to the Peninsula's best walks: coastal, hinterland, and national park. Effort, distance, and payoff rated.",
  path: '/explore/walks/',
  dateModified: '2026-08-09',
});

const itemListSchema = buildItemListSchema({
  name: 'Best Walks on the Mornington Peninsula',
  description: "Ranked editorial guide to the Peninsula's best walks: coastal, hinterland, and national park.",
  listPath: '/explore/walks',
  items: allRanked.map((w) => ({
    name: w.name,
    path: `/explore/${w.slug}/`,
    itemType: 'TouristAttraction',
    addressLocality: w.locality.split(' / ')[0].split(' to ')[0],
  })),
});

const faqSchema = buildFaqSchema(faqs);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Walks' },
]);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore/' },
  { label: 'Walks' },
];
export const prerender = true;
---

<BaseLayout
  title="Best Walks on the Mornington Peninsula · Peninsula Insider"
  description="Ranked editorial guide to the Peninsula's best walks: coastal, hinterland, and national park. Effort, distance, and payoff rated for 11 walks."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/walks/"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <header class="wk-hero">
    <div class="container">
      <div class="wk-hero__cover">
        <img
          class="wk-hero__image"
          src={cover.src}
          alt={cover.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="wk-hero__content">
          <h1 class="wk-hero__title">The best walks on the Mornington Peninsula</h1>
          <p class="wk-hero__standfirst">
            Bay-side foreshore paths, clifftop boardwalks over Bass Strait, national-park
            bush and a 26&nbsp;km coast-to-coast route. Eleven walks, ranked by what they
            demand and what they give back.
          </p>
        </div>
      </div>
    </div>
  </header>

  <section class="wk-calls" id="ranking-index" aria-label="The short version">
    <div class="container">
      <div class="wk-calls__panel is-dark">
        <div class="wk-calls__lead">
          <h2 class="wk-calls__title">The short version</h2>
          <p class="pi-eyebrow wk-calls__eyebrow">Three to know, by rank</p>
          <ul class="wk-calls__list">
            <li>
              <span class="wk-calls__num"><span class="wk-calls__no">No.</span>1</span>
              <p><a href="#cape-schanck-boardwalk">Cape Schanck boardwalk</a> is the best effort-to-payoff ratio on the Peninsula. Forty minutes, fully accessible.</p>
            </li>
            <li>
              <span class="wk-calls__num"><span class="wk-calls__no">No.</span>2</span>
              <p><a href="#bushrangers-bay-walk">Bushrangers Bay</a> has the best coastal scenery with the least foot traffic of any good walk here.</p>
            </li>
            <li>
              <span class="wk-calls__num"><span class="wk-calls__no">No.</span>6</span>
              <p><a href="#two-bays-walking-track">Two Bays Walking Track</a> is the flagship: 26&nbsp;km, bay to ocean. Most people walk it in sections.</p>
            </li>
          </ul>
          <p class="wk-calls__note"><span>No permits, no specialist gear, walkable all year. Prams or limited mobility: start with the boardwalk or the Mornington foreshore.</span></p>
        </div>
        <nav class="wk-calls__index" aria-label="The full ranking">
          <p class="wk-calls__index-title">The full ranking</p>
          {tiers.map((tier, t) => (
            <div class="wk-index__group">
              <p class="pi-eyebrow wk-index__tier" id={`ranking-tier-${t + 1}`}>{tier.title}</p>
              <ol class="wk-index__list" start={tier.walks[0].rank} aria-labelledby={`ranking-tier-${t + 1}`}>
                {tier.walks.map((w) => (
                  <li>
                    <a href={`#${w.slug}`}>
                      <span class="wk-index__name">{w.name}</span>
                      <span class="wk-index__time">{w.time}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="wk-ranking">
    <div class="container">
      <p class="wk-ranking__intro">
        The Mornington Peninsula has one of the most varied walking menus of any coastal
        region in Victoria: foreshore paths on the bay, boardwalks over Bass Strait,
        national park bush trails, and hinterland ridge-tops through old-growth manna gum
        that see almost nobody outside school holidays. Every walk below is editorially
        reviewed, and the review date is stated at the foot of this
        page.
      </p>

      {tiers.map((tier) => (
        <section class="wk-tier">
          <header class="wk-tier__head">
            <span class="wk-tier__rule" aria-hidden="true"></span>
            <h2 class="wk-tier__title">{tier.title}</h2>
            <p class="wk-tier__standfirst">{tier.standfirst}</p>
          </header>

          {tier.walks.map((w) => {
            const hero = heroes.get(w.slug);
            return (
              <article class="wr" id={w.slug}>
                {hero && (
                  <a class="wr__media" href={`/explore/${w.slug}/`} tabindex="-1">
                    <img
                      src={hero.src}
                      alt={hero.alt}
                      loading={w.rank === 1 ? 'eager' : 'lazy'}
                      decoding="async"
                      width="800"
                      height="600"
                      sizes="(max-width: 760px) 92vw, 420px"
                      {...editableImage({
                        entityType: 'experience',
                        entitySlug: w.slug,
                        fieldPath: 'heroImage',
                        label: `${w.name} hero`,
                        purpose: 'hero',
                      })}
                    />
                    <span class="wr__fog" aria-hidden="true"></span>
                    <span class="wr__tag">{w.locality}</span>
                  </a>
                )}
                <div class="wr__body">
                  <h3 class="wr__name">
                    <span class="wr__rank" aria-hidden="true">{w.rank}</span>
                    <a href={`/explore/${w.slug}/`}>{w.name}</a>
                  </h3>
                  <ul class="wr__meta">
                    <li>{w.distance}</li>
                    <li>{w.time}</li>
                    <li>{w.effort}</li>
                  </ul>
                  <p class="wr__verdict">{w.verdict}</p>
                  <p class="wr__bestfor"><strong>Best for</strong> {w.bestFor}</p>
                  <div class="wr__start">
                    <p><strong>Start</strong> {w.start}</p>
                    <PiSaveActions
                      placement="inline"
                      kind="experience"
                      slug={w.slug}
                      title={w.name}
                      href={`/explore/${w.slug}/`}
                      dek={w.verdict}
                      imageUrl={hero?.src}
                    />
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      ))}
      <p class="wk-ranking__return"><a href="#ranking-index"><span aria-hidden="true">↑</span> Back to the top of the ranking</a></p>
    </div>
  </section>

  <section class="wk-notes">
    <div class="container">
      <div class="prose">
        <h2>What to bring</h2>
        <p>No walk on this list requires specialist equipment. For any walk over 5&nbsp;km: water (1 L minimum), sunscreen, a hat, and footwear with grip. Ocean-side tracks can be slippery when wet.</p>

        <h2>FAQ</h2>
        <div class="wk-faq">
          {faqs.map((f) => (
            <details class="wk-faq__item">
              <summary class="wk-faq__q">{f.q}</summary>
              <p class="wk-faq__a">{f.a}</p>
            </details>
          ))}
        </div>

        <h2>Further reading</h2>
        <ul class="wk-further">
          <li><a href="/journal/two-bays-walk-mornington-peninsula/">Two Bays Walk deep guide</a></li>
          <li><a href="/journal/walks-bushrangers-bay-walk-guide/">Bushrangers Bay walk guide</a></li>
          <li><a href="/journal/the-peninsulas-best-late-afternoon-walks/">Best late-afternoon walks on the Peninsula</a></li>
          <li><a href="/explore/">All Peninsula experiences</a></li>
        </ul>

        <ProvenanceLine records={rankedRecords} type="experiences" noun="walk" caption />
      </div>
    </div>
  </section>

  <div class="container">
    <CorrectionNote surface="walks-hub" />
  </div>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* ── Cover hero: the photograph opens the page; harbour-deep scrim
     guarantees the reversed type over any crop. ── */
  .wk-hero {
    padding: var(--space-4) 0 var(--space-6);
  }
  /* The cover is a grid whose content sits in flow at the bottom, so a
     long title grows the cover instead of being clipped by it. No
     overflow:hidden: the image and the text band carry the radius. */
  .wk-hero__cover {
    position: relative;
    display: grid;
    align-content: end;
    border-radius: var(--radius-l);
    aspect-ratio: 16 / 7;
    background: var(--bg-dark, #0B2E4A);
  }
  .wk-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }
  /* The scrim belongs to the text, not to the photograph: a harbour-deep
     band that holds at least .82 from the standfirst to 24px above the
     H1 cap height, however many lines the title takes, then fades out
     across --fade. The sky and headland above it stay clear. */
  .wk-hero__content {
    --fade: 7rem;
    position: relative;
    padding: var(--fade) clamp(1.5rem, 3.5vw, 3rem) clamp(1.5rem, 3.5vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-radius: 0 0 var(--radius-l) var(--radius-l);
    background: linear-gradient(
      to top,
      rgb(11 46 74 / 0.9) 0%,
      rgb(11 46 74 / 0.82) calc(100% - var(--fade) + 1.5rem),
      rgb(11 46 74 / 0.3) calc(100% - var(--fade) * 0.45),
      rgb(11 46 74 / 0) 100%
    );
  }
  .wk-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-900);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--white);
    max-width: 18ch;
    text-wrap: balance;
  }
  .wk-hero__standfirst {
    margin: 0;
    font-size: var(--fs-500);
    line-height: var(--lh-dek);
    color: rgba(237, 241, 245, 0.92);
    max-width: var(--measure-dek);
    text-wrap: pretty;
  }
  /* Phones: a 4:5 crop over a landscape frame left fog and a sliver of
     headland. The photograph now takes its own 4:3 frame, set right so the
     headland stays in shot, and the text band sits beneath it on the
     harbour-deep ground, fading up into the bottom of the image. */
  @media (max-width: 760px) {
    .wk-hero__cover {
      aspect-ratio: auto;
      align-content: start;
    }
    .wk-hero__image {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 4 / 3;
      object-position: 80% 50%;
      border-radius: var(--radius-l) var(--radius-l) 0 0;
    }
    .wk-hero__content {
      --fade: 4.5rem;
      margin-top: calc(-1 * var(--fade));
      padding-inline: var(--space-5);
      padding-bottom: var(--space-6);
    }
    .wk-hero__title { font-size: var(--fs-800); }
    .wk-hero__standfirst { font-size: var(--fs-400); }
  }

  /* ── The short version: verdict panel + full-ranking index ── */
  .wk-calls {
    padding: 0 0 var(--space-7);
  }
  .wk-calls__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    background: var(--bg-dark, #0B2E4A);
    border-radius: var(--radius-l);
    padding: clamp(1.75rem, 3.5vw, 3rem);
    color: var(--white);
  }
  /* Left column is a flex column so its practical note settles on the same
     baseline as the last line of the full ranking beside it. */
  .wk-calls__lead {
    display: flex;
    flex-direction: column;
  }
  .wk-calls__title {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--fs-700);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display);
    color: var(--white);
  }
  .wk-calls__list {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .wk-calls__eyebrow { margin-bottom: var(--space-4); }
  .wk-calls__list li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
  }
  /* The numerals are ranks, not a sequence: "No." says so, and a fixed
