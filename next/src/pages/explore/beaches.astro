---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import GuideHero from '../../components/GuideHero.astro';
import CompareBlock from '../../components/CompareBlock.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import {
  buildCollectionPageSchema,
  buildItemListSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';

const experiences = await getCollection('experiences');
const beaches = experiences
  .filter((e) => e.data.type === 'beach')
  .sort((a, b) => (b.data.durationMinutes ?? 0) - (a.data.durationMinutes ?? 0));

// Bay vs Ocean split for the index. Beaches whose place sits on Port
// Phillip get bay; the rest go to ocean. The split is defensive — if
// new beaches arrive without place metadata they fall through to ocean
// rather than landing in the wrong group silently.
const bayPlaces = new Set(['balnarring', 'mount-martha', 'safety-beach', 'dromana', 'portsea', 'sorrento']);
const baySlugs = new Set([
  'balnarring-beach',
  'mount-martha-beach',
  'safety-beach-foreshore',
  'dromana-beach',
  'portsea-front-beach',
  'sorrento-front-beach',
]);
const oceanSlugs = new Set([
  'sorrento-back-beach',
  'rye-ocean-beach',
  'gunnamatta-ocean-beach',
  'portsea-back-beach',
  'sorrento-ocean-baths',
  'bushrangers-bay',
]);
const isBayBeach = (entry: any) => baySlugs.has(entry.id ?? entry.data.slug) || bayPlaces.has(entry.data.place);
const bayBeaches = beaches.filter(isBayBeach);
const oceanBeaches = beaches.filter((b) => !isBayBeach(b));

const collectionSchema = buildCollectionPageSchema({
  name: 'Best Beaches on the Mornington Peninsula',
  description: "Ranked editorial guide to the Mornington Peninsula's best beaches — bay and ocean, family, surf, dog, and sunset.",
  path: '/explore/beaches',
  dateModified: '2026-04-23',
});

const itemListSchema = buildItemListSchema({
  name: 'Best Beaches on the Mornington Peninsula',
  description: "Ranked editorial guide to the Mornington Peninsula's best beaches.",
  listPath: '/explore/beaches',
  items: [
    { name: 'Balnarring Beach', path: '/explore/balnarring-beach', itemType: 'Beach', addressLocality: 'Balnarring' },
    { name: 'Mount Martha Beach', path: '/explore/mount-martha-beach', itemType: 'Beach', addressLocality: 'Mount Martha' },
    { name: 'Safety Beach foreshore', path: '/explore/safety-beach-foreshore', itemType: 'Beach', addressLocality: 'Safety Beach' },
    { name: 'Dromana Beach', path: '/explore/dromana-beach', itemType: 'Beach', addressLocality: 'Dromana' },
    { name: 'Portsea Front Beach', path: '/explore/portsea-front-beach', itemType: 'Beach', addressLocality: 'Portsea' },
    { name: 'Sorrento Back Beach', path: '/explore/sorrento-back-beach', itemType: 'Beach', addressLocality: 'Sorrento' },
    { name: 'Rye Ocean Beach', path: '/explore/rye-ocean-beach', itemType: 'Beach', addressLocality: 'Rye' },
    { name: 'Gunnamatta Ocean Beach', path: '/explore/gunnamatta-ocean-beach', itemType: 'Beach', addressLocality: 'Rye' },
  ],
});

const faqSchema = buildFaqSchema([
  {
    q: 'What is the difference between bay beaches and ocean beaches on the Mornington Peninsula?',
    a: 'Bay beaches (Port Phillip side) are calm, warm, and family-appropriate for swimming. Ocean beaches (Bass Strait side) face open water, have surf and rips, and are not recommended for swimming unless you have strong ocean experience and can identify rips. They are worth visiting for scenery and walking.',
  },
  {
    q: 'Which beach is best for families with young children?',
    a: 'Balnarring Beach and Mount Martha Beach. Both have shallow, calm bay water, easy parking, and low-pressure atmospheres. Safety Beach is a solid third option.',
  },
  {
    q: 'Which beach is best for surfing on the Mornington Peninsula?',
    a: 'Gunnamatta Ocean Beach for power and space. Sorrento Back Beach and Rye Ocean Beach for more accessible options. Gunnamatta has no patrol outside summer; experienced surfers only.',
  },
  {
    q: 'Are any beaches dog-friendly on the Mornington Peninsula?',
    a: 'Yes. Several beaches have designated off-leash foreshore sections. Policies are set by Mornington Peninsula Shire and change. Check the current map on the Shire website before visiting.',
  },
  {
    q: 'Is Sorrento Back Beach safe for swimming?',
    a: 'Generally not, without ocean swimming experience and rip recognition skills. It is a surf beach with significant rip activity. It is excellent for walking, sunset-watching, and photography.',
  },
]);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Beaches' },
]);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore' },
  { label: 'Beaches' },
];
---

<BaseLayout
  title="Best Beaches on the Mornington Peninsula · Peninsula Insider"
  description="Ranked editorial guide to the Mornington Peninsula's best beaches — bay swimming, ocean surf, family, dog-friendly, and sunset. Bay vs ocean, the differences that matter, and the beaches we recommend."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/beaches/"
  ogImage="/images/sourced/explore-gunnamatta-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <GuideHero
    eyebrow={`Explore guide · ${beaches.length} beaches · Last verified 23 Apr 2026`}
    title="Mornington Peninsula <em>Beaches</em>"
    dek="Two coasts, one peninsula. The bay side is calm, warm, and family-safe. The ocean side is wild, rip-heavy, and worth visiting only if you know which side you're on."
    meta={[
      { label: `${bayBeaches.length} bay beaches` },
      { label: `${oceanBeaches.length} ocean beaches` },
      { label: '8 min read' },
    ]}
    heroImage="/images/sourced/explore-gunnamatta-01.webp"
    imageAlt="Gunnamatta Ocean Beach — Bass Strait surf and dune ridges at the Peninsula's southern edge"
    imageCredit="Peninsula Insider"
  />

  <CompareBlock
    eyebrow="The frame that matters most"
    heading="Bay or ocean — the choice that decides everything else"
    dek="Knowing which side of the Peninsula you're on is the most important beach-planning decision you will make. Get this wrong and the day fails. Get it right and the rest is detail."
    left={{
      label: 'Bay',
      title: 'Calm. Family-safe. Year-round swimming.',
      rows: [
        { label: 'Water', value: 'Sheltered Port Phillip. Shallow entry. Warmer in summer than the open coast.' },
        { label: 'Best for', value: 'Families, toddlers, casual swimmers, sunrise walks.' },
        { label: 'Risk', value: 'Low. Rip activity is minimal. Patrols on major beaches in summer.' },
        { label: 'Vibe', value: 'Domestic, walkable, café-adjacent.' },
        { label: 'Where it runs', value: 'Mount Martha → Dromana → Sorrento → Portsea (eastern coast).' },
      ],
    }}
    right={{
      label: 'Ocean',
      title: 'Wild. Look, don’t swim. Worth the drive.',
      rows: [
        { label: 'Water', value: 'Open Bass Strait. Surf, rips, surge. Cold year-round.' },
        { label: 'Best for', value: 'Experienced surfers, walkers, photographers, sunset-chasers.' },
        { label: 'Risk', value: 'Real. Never swim unpatrolled. Rips can carry the strongest swimmer.' },
        { label: 'Vibe', value: 'Cinematic, exposed, sparsely built.' },
        { label: 'Where it runs', value: 'Rye → Gunnamatta → Sorrento Back → Cape Schanck (southern coast).' },
      ],
    }}
  />

  <section class="experience-index" aria-label="Bay beaches">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Bay side · Port Phillip</p>
          <h2 class="venues__title">Bay beaches — calm water, family-safe</h2>
          <p class="venues__sub">{bayBeaches.length} bay beaches we recommend, ordered by editorial weight. Each one is for swimming, not just looking.</p>
        </div>
      </div>
      <div class="experience-grid">
        {bayBeaches.map((beach) => <ExperienceCard experience={beach} />)}
      </div>
    </div>
  </section>

  <section class="experience-index" aria-label="Ocean beaches">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Ocean side · Bass Strait</p>
          <h2 class="venues__title">Ocean beaches — wild water, walk and look</h2>
          <p class="venues__sub">The Peninsula's southern coast. Surf, cliffs, dunes, and rips. Bring a camera and a windproof — leave the togs at the bay.</p>
        </div>
      </div>
      <aside class="container">
        <div class="guide-callout" role="note" aria-label="Swim safety">
          <p class="guide-callout__label">Before you swim</p>
          <p class="guide-callout__body">Ocean rips are the primary risk on every back beach. The rule: if in doubt, do not enter the water. Swim between the flags at any patrolled beach. Life-saving patrols operate on Rye Ocean Beach and Gunnamatta in summer only.</p>
        </div>
      </aside>
      <div class="experience-grid">
        {oceanBeaches.map((beach) => <ExperienceCard experience={beach} />)}
      </div>
    </div>
  </section>

  <article class="article">
    <div class="container">
      <div class="prose">
        <h2>Dog-friendly beaches</h2>
        <p>The Peninsula has several off-leash foreshore sections. Policies are set by Mornington Peninsula Shire and change seasonally — always check the current off-leash map before arriving. The full <a href="/journal/dog-friendly-mornington-peninsula/">dog-friendly Peninsula guide</a> has the working list.</p>
        <ul>
          <li><a href="/explore/balnarring-beach/">Balnarring Beach</a> — off-leash section at the north end</li>
          <li><a href="/explore/sorrento-back-beach/">Sorrento Back Beach</a> — off-leash areas in the national park foreshore (seasonally restricted in places)</li>
          <li><a href="/explore/mount-martha-beach/">Mount Martha Beach</a> — check the Shire's current off-leash zones</li>
        </ul>

        <h2>Also read</h2>
        <ul>
          <li><a href="/journal/mornington-peninsula-beach-guide/">The Peninsula beach swimming guide</a></li>
          <li><a href="/journal/dog-friendly-mornington-peninsula/">Dog-friendly Peninsula guide</a></li>
          <li><a href="/explore/walks/">Coastal walks and hinterland tracks</a> — many beaches connect to walks</li>
          <li><a href="/explore/family-friendly/">Family-friendly things to do</a></li>
        </ul>

        <p><em>Last fact-verified 23 April 2026</em></p>

        <h2>FAQ</h2>

        <h3>What is the difference between bay beaches and ocean beaches on the Mornington Peninsula?</h3>
        <p>Bay beaches (Port Phillip side) are calm, warm, and family-appropriate for swimming. Ocean beaches (Bass Strait side) face open water, have surf and rips, and are not recommended for swimming unless you have strong ocean experience and can identify rips. They are worth visiting for scenery and walking.</p>

        <h3>Which beach is best for families with young children?</h3>
        <p>Balnarring Beach and Mount Martha Beach. Both have shallow, calm bay water, easy parking, and low-pressure atmospheres. Safety Beach is a solid third option.</p>

        <h3>Which beach is best for surfing on the Mornington Peninsula?</h3>
        <p>Gunnamatta Ocean Beach for power and space. Sorrento Back Beach and Rye Ocean Beach for more accessible options. Gunnamatta has no patrol outside summer; experienced surfers only.</p>

        <h3>Are any beaches dog-friendly on the Mornington Peninsula?</h3>
        <p>Yes. Several beaches have designated off-leash foreshore sections. Policies are set by Mornington Peninsula Shire and change. Check the current map on the Shire website before visiting.</p>

        <h3>Is Sorrento Back Beach safe for swimming?</h3>
        <p>Generally not, without ocean swimming experience and rip recognition skills. It is excellent for walking, sunset-watching, and photography.</p>
      </div>
    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>
