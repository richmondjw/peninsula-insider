---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideHero from '../../components/GuideHero.astro';
import CompareBlock from '../../components/CompareBlock.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import ProvenanceLine from '../../components/ProvenanceLine.astro';
import { buildCollectionPageSchema, buildItemListSchema, buildFaqSchema, buildBreadcrumbSchema } from '../../lib/schema';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import { editableImage } from '../../lib/inline-edit/attrs';

// Keep this guide tied to current, source-checked records. The original Red Hill
// Community Market is closed and the Balnarring Village Green listing is paused.
const MARKET_ROUTES = [
  { route: 'mornington-main-street-market', venue: 'mornington-main-street-market' },
  { route: 'rye-beachside-market', venue: 'rye-beachside-market' },
  { route: 'mount-eliza-farmers-market', venue: 'mount-eliza-farmers-market' },
];
const marketVenues = await getCollection('venues', ({ data }) => data.type === 'market');
const markets = MARKET_ROUTES.map(({ route, venue }) => {
  const entry = marketVenues.find((v) => (v.data.slug ?? v.id) === venue);
  if (!entry) throw new Error(`explore/markets: missing venue ${venue}`);
  return { id: route, venueSlug: venue, data: entry.data };
});
const marketHeroBySlug = new Map();
await Promise.all(markets.map(async (market) => {
  marketHeroBySlug.set(market.id, await resolveHero('venue', market.venueSlug, market.data));
}));
const marketMeta = {
  'mornington-main-street-market': { cadence: 'Every Wednesday', hours: 'Check organiser for hours', focus: 'Town market', focusMod: 'mixed', insiderRead: 'Fold a browse into a Mornington town day.' },
  'rye-beachside-market': { cadence: 'First Saturday · monthly', hours: '8.30am–2pm', focus: 'Foreshore market', focusMod: 'craft', insiderRead: 'Pair the foreshore stalls with a Rye beach walk.' },
  'mount-eliza-farmers-market': { cadence: 'Fourth Sunday · monthly', hours: '9am–1pm', focus: 'Farmers market', focusMod: 'producer', insiderRead: 'A northern Peninsula market morning; check the organiser before travelling.' },
};
const focusBadgeClass = (mod) => mod === 'producer' ? 'market-badge--producer' : mod === 'craft' ? 'market-badge--craft' : 'market-badge--mixed';
const calendarRows = [
  { date: 'Wk 1', day: 'First Saturday', markets: [{ name: 'Hill & Ridge Community Market', mod: 'market-badge--mixed' }, { name: 'Rye Foreshore Market', mod: 'market-badge--craft' }] },
  { date: 'Weekly', day: 'Wednesday', markets: [{ name: 'Mornington Main Street Market', mod: 'market-badge--mixed' }] },
  { date: 'Wk 4', day: 'Fourth Sunday', markets: [{ name: 'Mount Eliza Farmers Market', mod: 'market-badge--producer' }] },
];
const faqItems = [
  { q: 'Is the original Red Hill Community Market open?', a: 'No. Its organiser says it is temporarily closed while looking for a new location. Hill & Ridge Community Market is a separate event at Red Hill Recreation Reserve.' },
  { q: 'When is Hill & Ridge Community Market?', a: 'The organiser confirms Saturday 3 October 2026, 9am–2pm, at Red Hill Recreation Reserve. Check the organiser before travelling: unsafe weather can cause cancellation without notice.' },
  { q: 'When are the other markets?', a: 'Mornington Main Street Market lists Wednesdays, Rye Foreshore Market lists the first Saturday of each month, and Mount Eliza Farmers Market lists the fourth Sunday. Confirm the current date with each organiser.' },
  { q: 'Is Balnarring Village Green Market running?', a: 'We could not verify its current schedule from a primary source. Its listing is paused. Emu Plains Market is a different Balnarring event; check its organiser for current dates.' },
];
const collectionSchema = buildCollectionPageSchema({
  name: 'Mornington Peninsula Markets - Current Guide',
  description: 'A source-checked guide to Hill & Ridge, Mornington Main Street, Rye Foreshore and Mount Eliza markets, with a calendar and organiser links.',
  path: '/explore/markets/',
  dateModified: '2026-09-23',
});
const itemListSchema = buildItemListSchema({
  name: 'Mornington Peninsula Markets',
  description: 'Current market guides and a confirmed Hill & Ridge event.',
  listPath: '/explore/markets',
  items: [
    { name: 'Hill & Ridge Community Market', path: '/whats-on/hill-ridge-community-market-september-2026-restart/', itemType: 'TouristAttraction', addressLocality: 'Red Hill' },
    ...markets.map((market) => ({ name: market.data.name, path: `/eat/${market.venueSlug}/`, itemType: 'TouristAttraction', addressLocality: String(market.data.place ?? '') })),
  ],
});
const faqSchema = buildFaqSchema(faqItems);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Explore', url: 'https://peninsulainsider.com.au/explore/' },
  { name: 'Markets' },
]);
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Explore', href: '/explore/' }, { label: 'Markets' }];
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Markets · Current Guide · Peninsula Insider"
  description="Compare current Mornington Peninsula markets, check the calendar, and follow organiser links before travelling. The original Red Hill Community Market is temporarily closed."
  section="explore"
  canonical="https://peninsulainsider.com.au/explore/markets/"
  ogImage="/images/sourced/place-red-hill-01.webp"
  modifiedTime="2026-09-23"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <GuideHero
    eyebrow="Explore guide"
    title="Mornington Peninsula <em>Markets</em>"
    dek="Choose a market by day and place, then confirm the latest details with its organiser. The original Red Hill Community Market is temporarily closed; Hill & Ridge is a separate market at the reserve."
    meta={[{ label: 'Updated 23 Sep 2026' }]}
    heroImage="/images/sourced/place-red-hill-01.webp"
    imageAlt="Vineyard rows in Red Hill"
    imageCredit="Peninsula Insider"
    entitySlug="explore/markets"
  />

  <section class="experience-index" aria-label="Market calendar at a glance">
    <div class="container">
      <div class="venues__header"><div>
        <p class="label label--accent">Month at a glance</p>
        <h2 class="venues__title">The market rhythm</h2>
        <p class="venues__sub">These are the organisers' usual days, not a guarantee of operation. Hill & Ridge is confirmed for 3 October 2026; check every organiser for changes before travelling.</p>
      </div></div>
      <ol class="market-calendar">
        {calendarRows.map((row) => (
          <li class="market-calendar__row">
            <span class="market-calendar__week">{row.date}</span>
            <span class="market-calendar__day">{row.day}</span>
            <span class="market-calendar__chips">{row.markets.map((mk) => <span class={`market-chip ${mk.mod}`}>{mk.name}</span>)}</span>
          </li>
        ))}
      </ol>
      <p class="market-calendar__legend"><span class="market-chip market-badge--producer">Farmers market</span><span class="market-chip market-badge--mixed">Community / town</span><span class="market-chip market-badge--craft">Foreshore</span></p>
    </div>
  </section>

  <CompareBlock
    eyebrow="First Saturday choices"
    heading="Red Hill or Rye"
    dek="Two distinct first-Saturday settings. Check the organiser before setting out, particularly when weather is uncertain."
    left={{
      label: 'Hill & Ridge · Red Hill',
      title: 'A community market at Red Hill Recreation Reserve.',
      rows: [
        { label: 'Next confirmed', value: 'Saturday 3 October 2026, 9am–2pm.' },
        { label: 'Place', value: 'Red Hill Recreation Reserve, 184 Arthurs Seat Road.' },
        { label: 'Plan around', value: 'A hinterland morning and a Red Hill lunch.' },
        { label: 'Check', value: 'Unsafe weather can cancel the market without notice. Check the Hill & Ridge organiser.' },
      ],
    }}
    right={{
      label: 'Rye Foreshore · Rye',
      title: 'A bayside market beside Rye Pier.',
      rows: [
        { label: 'Usual day', value: 'First Saturday of each month, 8.30am–2pm, per Mornington Peninsula Shire.' },
        { label: 'Place', value: 'Rye foreshore, opposite the Rye Hotel.' },
        { label: 'Plan around', value: 'A Rye foreshore walk or town stop.' },
        { label: 'Check', value: 'Confirm the current date on the Shire event page.' },
      ],
    }}
  />

  <section class="experience-index experience-index--plain" aria-label="Current Peninsula markets">
    <div class="container">
      <div class="venues__header"><div>
        <p class="label label--accent">Current market guides</p>
        <h2 class="venues__title">Four ways to build a market day</h2>
        <p class="venues__sub">Choose by location and organiser schedule. Each card links to details and a primary source.</p>
      </div><a href="/explore/" class="venues__link">All explore guides →</a></div>
      <div class="market-grid">
        <article class="market-card">
          <div class="market-card__rank">01</div>
          <div class="market-card__media" style="background-image: url('/images/sourced/place-red-hill-01.webp')" role="img" aria-label="Red Hill vineyard landscape"></div>
          <div class="market-card__body">
            <div class="market-card__badges"><span class="market-badge market-badge--mixed">Community market</span></div>
            <h3 class="market-card__name"><a href="/whats-on/hill-ridge-community-market-september-2026-restart/">Hill &amp; Ridge Community Market</a></h3>
            <p class="market-card__meta">Next confirmed: 3 Oct 2026 · 9am–2pm · Red Hill</p>
            <p class="market-card__note">A separate market from the temporarily closed original Red Hill Community Market.</p>
            <p class="market-card__insider"><span class="market-card__insider-tag">Before you go</span>Unsafe weather can cancel the event without notice.</p>
          </div>
          <div class="market-card__footer"><a href="/whats-on/hill-ridge-community-market-september-2026-restart/" class="pi-btn pi-btn--text">Event guide →</a><a href="https://www.hillandridgemarket.com.au/" class="market-card__site" target="_blank" rel="noopener">Official site →</a></div>
        </article>
        {markets.map((market, idx) => {
          const d = market.data;
          const meta = marketMeta[market.id];
          const detailHref = `/eat/${market.venueSlug}/`;
          return (
            <article class="market-card">
              <div class="market-card__rank">{String(idx + 2).padStart(2, '0')}</div>
              <div class="market-card__media" style={marketHeroBySlug.get(market.id)?.style ?? `background-image: url('${d.heroImage.src}')`} role="img" aria-label={marketHeroBySlug.get(market.id)?.alt ?? d.heroImage.alt} {...editableImage({ entityType: 'venue', entitySlug: market.venueSlug, fieldPath: 'heroImage', label: `${d.name} hero`, purpose: 'hero' })}></div>
              <div class="market-card__body">
                <div class="market-card__badges"><span class={`market-badge ${focusBadgeClass(meta.focusMod)}`}>{meta.focus}</span></div>
                <h3 class="market-card__name"><a href={detailHref}>{d.name}</a></h3>
                <p class="market-card__meta"><span class="market-card__when">{meta.cadence}</span><span class="market-card__sep"> · </span><span class="market-card__hours">{meta.hours}</span></p>
                <p class="market-card__note">{d.editorNote}</p>
                <p class="market-card__insider"><span class="market-card__insider-tag">Insider read</span>{meta.insiderRead}</p>
              </div>
              <div class="market-card__footer"><a href={detailHref} class="pi-btn pi-btn--text">Market guide →</a>{d.website && <a href={d.website} class="market-card__site" target="_blank" rel="noopener">Official site →</a>}</div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="experience-index" aria-label="Pair the market with the rest of the day">
    <div class="container">
      <div class="venues__header"><div><p class="label label--accent">Build the day around it</p><h2 class="venues__title">After the market</h2><p class="venues__sub">Keep the rest of the day near the market you choose.</p></div></div>
      <div class="pairing-grid">
        <div class="pairing-card"><h3 class="pairing-card__heading">Red Hill Saturday</h3><p class="pairing-card__sub">Hill &amp; Ridge, then a hinterland lunch.</p><ul class="pairing-card__list"><li><a href="/explore/places/red-hill/">Red Hill place guide</a> for nearby stops.</li><li><a href="/wine/">Red Hill cellar doors</a> for an afternoon option.</li><li>Check the <a href="https://www.hillandridgemarket.com.au/">Hill &amp; Ridge organiser</a> before travelling.</li></ul></div>
        <div class="pairing-card"><h3 class="pairing-card__heading">Rye Saturday</h3><p class="pairing-card__sub">Foreshore stalls, then a bayside walk.</p><ul class="pairing-card__list"><li><a href="/explore/places/rye/">Rye place guide</a> for a local plan.</li><li><a href="/eat/rye-beachside-market/">Rye Foreshore Market guide</a> for the source link.</li></ul></div>
        <div class="pairing-card"><h3 class="pairing-card__heading">Mornington Wednesday</h3><p class="pairing-card__sub">Market and a town day.</p><ul class="pairing-card__list"><li><a href="/explore/places/mornington/">Mornington town</a> after the stalls.</li><li><a href="/explore/mornington-foreshore-walk/">Mornington foreshore walk</a> nearby.</li></ul></div>
      </div>
    </div>
  </section>

  <section class="market-feature" aria-label="Market planning note"><div class="container"><div class="market-feature__inner"><div class="market-feature__body">
    <p class="label label--accent">Check before you travel</p>
    <h2 class="market-feature__heading">One calendar, different organisers</h2>
    <p class="market-feature__dek">The first Saturday offers two different markets: Hill &amp; Ridge in Red Hill and Rye Foreshore on the bay. Mornington gives you a Wednesday option, while Mount Eliza lists the fourth Sunday. Follow each organiser's current notice before planning a drive.</p>
    <p class="market-feature__dek">The original Red Hill Community Market is temporarily closed while its organiser looks for a new location. Hill &amp; Ridge is a separate event. The former Balnarring Village Green listing is paused because its schedule could not be confirmed. Emu Plains Market is a separate Balnarring market; check its organiser for current dates.</p>
  </div><div class="market-feature__aside"><div class="market-feature__fact"><span class="market-feature__fact-num">4</span><span class="market-feature__fact-label">current market guides</span></div><div class="market-feature__fact"><span class="market-feature__fact-num">3 Oct</span><span class="market-feature__fact-label">next confirmed Hill &amp; Ridge date</span></div></div></div></div></section>

  <section class="experience-index experience-index--plain" aria-label="Markets FAQ"><div class="container">
    <div class="venues__header"><div><p class="label label--accent">Common questions</p><h2 class="venues__title">FAQ</h2></div></div>
    <div class="market-faq">{faqItems.map((item) => <details class="market-faq__item"><summary class="market-faq__q">{item.q}</summary><div class="market-faq__a"><p>{item.a}</p></div></details>)}</div>
    <ProvenanceLine class="market-verified" records={markets.map((m) => marketVenues.find((v) => (v.data.slug ?? v.id) === m.venueSlug)!)} type="venues" noun="market" />
  </div></section>
  <NewsletterBlock />
</BaseLayout>

<style>
  /* ─────────────────────────────────────────────────────────────────
     MONTH-AT-A-GLANCE CALENDAR
     ───────────────────────────────────────────────────────────────── */
  .market-calendar {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid rgba(74, 90, 87, 0.14);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 8px 24px rgba(0, 40, 34, 0.05);
  }
  .market-calendar__row {
    display: grid;
    grid-template-columns: 5.5rem 12rem 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 1.4rem;
    border-bottom: 1px solid rgba(74, 90, 87, 0.09);
  }
  .market-calendar__row:last-child { border-bottom: none; }
  .market-calendar__row:nth-child(odd) { background: rgba(11, 90, 72, 0.025); }
  .market-calendar__week {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .market-calendar__day {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }
  .market-calendar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .market-calendar__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: 0.78rem;
    color: var(--soft);
    align-items: center;
  }
  @media (max-width: 700px) {
    .market-calendar__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 0.95rem 1.1rem;
    }
  }

  /* Shared chip + badge palette */
  .market-chip,
  .market-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 2rem;
    line-height: 1.45;
    border: 1px solid transparent;
  }
  .market-badge--producer {
    background: rgba(90, 140, 80, 0.12);
    color: #3d6e34;
    border-color: rgba(90, 140, 80, 0.25);
  }
  .market-badge--mixed {
    background: rgba(7, 158, 165, 0.15);
    color: #2a7a67;
    border-color: rgba(7, 158, 165, 0.3);
  }
  .market-badge--craft {
    background: rgba(11, 90, 72, 0.09);
    color: var(--accent);
    border-color: rgba(11, 90, 72, 0.22);
  }
  .market-badge--tier {
    background: transparent;
    color: var(--soft);
    border-color: var(--border);
    font-weight: 500;
  }
  .market-tier--1.market-badge--tier {
    color: var(--accent);
    background: rgba(11, 90, 72, 0.06);
    border-color: rgba(11, 90, 72, 0.3);
  }

  /* ─────────────────────────────────────────────────────────────────
     MARKET CARD GRID
     ───────────────────────────────────────────────────────────────── */
  .market-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 800px) { .market-grid { grid-template-columns: 1fr; } }

  .market-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, rgba(255,252,247,0.99) 0%, rgba(248,243,236,0.99) 100%);
    border: 1px solid rgba(74, 90, 87, 0.14);
    border-radius: 1.25rem;
    box-shadow: 0 12px 32px rgba(0, 40, 34, 0.06);
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .market-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 48px rgba(0, 40, 34, 0.11);
  }
  .market-card__rank {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgba(253, 252, 250, 0.92);
    backdrop-filter: blur(6px);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(0, 40, 34, 0.12);
  }
  .market-card__media {
    aspect-ratio: 16 / 8;
    background-size: cover;
    background-position: center;
    background-color: var(--bg-alt);
  }
  .market-card__body {
    padding: 1.25rem 1.4rem 0.75rem;
    flex: 1;
  }
  .market-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.7rem;
  }
  .market-card__name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.55rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.4rem;
  }
  .market-card__name a { color: var(--text); text-decoration: none; }
  .market-card__name a:hover { color: var(--accent); }
  .market-card__meta {
    font-size: 0.78rem;
    color: var(--soft);
    margin: 0 0 0.85rem;
    letter-spacing: 0.01em;
  }
  .market-card__when { font-weight: 600; color: var(--text); }
  .market-card__sep { opacity: 0.55; }
  .market-card__note {
    font-size: 0.88rem;
    color: #2b443e;
    line-height: 1.65;
    margin: 0;
  }
  .market-card__insider {
    font-size: 0.82rem;
    color: #385a52;
    line-height: 1.6;
    margin: 0.85rem 0 0;
    padding: 0.65rem 0.85rem;
    background: rgba(7, 158, 165, 0.09);
    border: 1px solid rgba(7, 158, 165, 0.18);
    border-radius: 0.35rem;
    font-style: normal;
  }
  .market-card__insider-tag {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2a7a67;
    font-style: normal;
    margin-right: 0.5rem;
  }
  .market-card__footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem 1.1rem;
    border-top: 1px solid rgba(74, 90, 87, 0.09);
    margin-top: auto;
  }
  .market-card__site {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--soft);
    text-decoration: none;
  }
  .market-card__site:hover { color: var(--text); }

  /* ─────────────────────────────────────────────────────────────────
     EDITORIAL ARTICLE CARDS (mirrors golf-article-card palette)
     ───────────────────────────────────────────────────────────────── */
  .market-articles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 700px) { .market-articles { grid-template-columns: 1fr; } }

  .market-article-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid rgba(74, 90, 87, 0.12);
    border-radius: 1.25rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 6px 20px rgba(0, 40, 34, 0.05);
    transition: transform 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .market-article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px rgba(0, 40, 34, 0.11);
  }
  .market-article-card__img {
    aspect-ratio: 16 / 7;
    background-size: cover;
    background-position: center;
    background-color: var(--bg-alt);
  }
  .market-article-card__body {
    padding: 1.4rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .market-article-card__tag {
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.45rem;
  }
  .market-article-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--text);
    margin-bottom: 0.6rem;
  }
  .market-article-card__dek {
    font-size: 0.85rem;
    color: var(--soft);
