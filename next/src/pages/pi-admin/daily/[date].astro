---
import BaseLayout from '../../../layouts/BaseLayout.astro';

type LinkedItem = { source: string; url?: string; score: string; band: string; note: string; item: string };
type Report = {
  date: string;
  title: string;
  generatedAt: string;
  runLabel?: string;
  method?: string;
  summary?: string;
  actToday: Array<{ title: string; score: string; band: string; source: string; observed?: string; url?: string; sourceLabel?: string; scores?: string; description: string; interpretation?: string; recommendation?: string }>;
  news: LinkedItem[];
  events: Array<{ event: string; when: string; score: string; band: string; recommendation: string }>;
  competitors: Array<{ name: string; note: string }>;
  opportunities: string[];
  rawCaptures: string[];
};

export function getStaticPaths() {
  const reports = import.meta.glob('../../../content/daily-insights/*.json', { eager: true, import: 'default' }) as Record<string, Report>;
  return Object.values(reports).map((report) => ({ params: { date: report.date }, props: { report } }));
}

const { report } = Astro.props as { report: Report };
const displayDate = new Intl.DateTimeFormat('en-AU', { dateStyle: 'full', timeZone: 'Australia/Melbourne' }).format(new Date(`${report.date}T12:00:00+10:00`));
const scoreClass = (band: string) => band.toLowerCase() === 'escalate' ? 'score score--escalate' : `score score--${band.toLowerCase()}`;
---

<BaseLayout
  title={`${report.title} · Peninsula Insider`}
  description="Internal Peninsula Insider competitive-listening and daily insights report."
  section="home"
  noindex={true}
  searchExclude={true}
>
  <main class="daily-report">
    <div class="container report-wrap">
      <header class="report-header">
        <p class="eyebrow">Peninsula Insider · Intelligence</p>
        <h1>Daily insights</h1>
        <p class="report-date">{displayDate}</p>
        <p class="meta">{report.runLabel && `Run ${report.runLabel}`} {report.method && ` · Method: ${report.method}`}</p>
        {report.summary && <p class="summary">{report.summary}</p>}
      </header>

      <section aria-labelledby="act-today"><h2 id="act-today">Act today</h2>
        {report.actToday.map((entry) => <article class="card">
          <h3>{entry.title} <span class={scoreClass(entry.band)}>{entry.score} · Band {entry.band}</span></h3>
          <p class="source">{entry.source}{entry.observed && ` · ${entry.observed}`}{entry.url && <> · <a href={entry.url}>{entry.sourceLabel || 'Source'}</a></>}{entry.scores && ` · Scores ${entry.scores}`}</p>
          <p>{entry.description}</p>
          {entry.interpretation && <aside class="interpretation"><strong>Interpretation</strong>{entry.interpretation}</aside>}
          {entry.recommendation && <p class="recommendation"><strong>Recommendation:</strong> {entry.recommendation}</p>}
        </article>)}
      </section>

      <section aria-labelledby="news"><h2 id="news">News worth knowing</h2>
        <div class="table-wrap"><table><thead><tr><th>Item</th><th>Source</th><th>Score</th><th>Note</th></tr></thead><tbody>
          {report.news.map((entry) => <tr><td>{entry.item}</td><td>{entry.url ? <a href={entry.url}>{entry.source}</a> : entry.source}</td><td><span class={scoreClass(entry.band)}>{entry.score} · {entry.band}</span></td><td>{entry.note}</td></tr>)}
        </tbody></table></div>
      </section>

      <section aria-labelledby="events"><h2 id="events">Events radar</h2>
        <div class="table-wrap"><table><thead><tr><th>Event</th><th>When</th><th>Score</th><th>Recommendation</th></tr></thead><tbody>
          {report.events.map((entry) => <tr><td>{entry.event}</td><td>{entry.when}</td><td><span class={scoreClass(entry.band)}>{entry.band === 'escalate' ? '⚠ ESCALATE' : `${entry.score} · ${entry.band}`}</span></td><td>{entry.recommendation}</td></tr>)}
        </tbody></table></div>
      </section>

      <section aria-labelledby="competitors"><h2 id="competitors">Competitor watch</h2><ul>{report.competitors.map((entry) => <li><strong>{entry.name}:</strong> {entry.note}</li>)}</ul></section>
      <section aria-labelledby="opportunities"><h2 id="opportunities">Opportunities</h2><ol>{report.opportunities.map((entry) => <li>{entry}</li>)}</ol></section>
      <section aria-labelledby="raw-captures"><h2 id="raw-captures">Raw captures (Band D)</h2><ul>{report.rawCaptures.map((entry) => <li>{entry}</li>)}</ul></section>
      <footer>Generated {new Intl.DateTimeFormat('en-AU', { dateStyle: 'medium', timeZone: 'Australia/Melbourne' }).format(new Date(report.generatedAt))} · Internal report · <a href="/">Peninsula Insider</a></footer>
    </div>
  </main>
</BaseLayout>

<style>
  .daily-report { padding: clamp(2.5rem, 5vw, 5rem) 0 6rem; background: var(--surface, #f7f5ef); color: var(--text, #172a36); }
  .report-wrap { max-width: 58rem; }
  .report-header { padding-bottom: 2rem; border-bottom: 3px solid currentColor; }
  .eyebrow, .meta, .source, footer { color: var(--soft, #58707b); font: 700 .75rem/1.45 var(--font-ui, sans-serif); letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, h3 { font-family: var(--font-display, Georgia, serif); color: var(--text, #172a36); }
  h1 { margin: .5rem 0 0; font-size: clamp(2.7rem, 6vw, 5rem); line-height: .95; }
  .report-date { margin: .8rem 0 0; font: 500 clamp(1.2rem, 2vw, 1.55rem)/1.3 var(--font-ui, sans-serif); }
  .meta { margin: .65rem 0 0; font-size: .68rem; }
  .summary { max-width: 44rem; margin: 1.25rem 0 0; color: var(--soft, #58707b); font: 400 1.05rem/1.5 var(--font-ui, sans-serif); }
  section { margin-top: 3.25rem; }
  h2 { margin: 0 0 1rem; padding: .7rem 1rem; background: #172a36; color: #e2f5eb; border-radius: .35rem; font-size: clamp(1.35rem, 2.5vw, 1.7rem); }
  h3 { margin: 0; font-size: 1.25rem; line-height: 1.2; }
  .card, .table-wrap { overflow: hidden; border: 1px solid color-mix(in srgb, var(--text, #172a36) 18%, transparent); border-radius: .6rem; background: #fff; }
  .card { padding: 1.4rem; margin-top: .9rem; }
  .card > p { margin: .9rem 0 0; font: 400 .98rem/1.55 var(--font-ui, sans-serif); }
  .source { margin-top: .5rem !important; font-size: .7rem !important; }
  a { color: inherit; text-underline-offset: .2em; }
  .score { display: inline-block; margin-left: .35rem; padding: .22rem .5rem; border-radius: 2rem; font: 700 .68rem/1 var(--font-ui, sans-serif); white-space: nowrap; vertical-align: middle; }
  .score--a { background: #cbeee0; color: #174734; }.score--b { background: #fff0bf; color: #725400; }.score--c, .score--d { background: #e8eaeb; color: #56636a; }.score--escalate { background: #f9dfdc; color: #8a3027; }
  .interpretation { margin-top: 1rem; padding: .8rem 1rem; border-left: 3px solid #31745d; background: #e8f5ef; font: 400 .94rem/1.5 var(--font-ui, sans-serif); }
  .interpretation strong { display: block; margin-bottom: .25rem; color: #246048; font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; }
  .recommendation strong { color: #246048; }
  table { width: 100%; border-collapse: collapse; font: 400 .9rem/1.45 var(--font-ui, sans-serif); } th, td { padding: .85rem .9rem; text-align: left; vertical-align: top; border-bottom: 1px solid #e5e7e7; } tr:last-child td { border-bottom: 0; } th { background: #f4f5f2; color: var(--soft, #58707b); font-size: .67rem; letter-spacing: .08em; text-transform: uppercase; } td .score { margin: 0; }
  section ul, section ol { margin: 0; padding-left: 1.3rem; font: 400 .98rem/1.6 var(--font-ui, sans-serif); } section li + li { margin-top: .55rem; }
  footer { margin-top: 4rem; padding-top: 1.2rem; border-top: 1px solid color-mix(in srgb, var(--text, #172a36) 18%, transparent); font-size: .67rem; }
  @media (max-width: 640px) { .table-wrap { overflow-x: auto; scrollbar-width: none; } .table-wrap::-webkit-scrollbar { display: none; } table { min-width: 38rem; } .card { padding: 1.1rem; } }
</style>
