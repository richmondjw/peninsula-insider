---
/**
 * /newsletter/ -> /dispatch/ permanent rename.
 * Keeps old links (and their UTM params) working; canonical content lives at
 * /dispatch/. Was hand-rolled before components/Redirect.astro existed -
 * migrated to the shared component so it gets query/hash preservation and
 * the standard consolidate-canonical treatment for a URL migration.
 */
import Redirect from '../components/Redirect.astro';
export const prerender = true;
---
<Redirect to="/dispatch/" consolidate />
