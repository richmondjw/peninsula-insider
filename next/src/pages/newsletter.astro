---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Newsletter' },
];
---

<BaseLayout
  title="The Insider's Dispatch · Subscribe, Peninsula Insider"
  description="The weekly dispatch from the Mornington Peninsula. One pick, one weather-proof backup, one thing to skip. Written by editors who live on the Peninsula."
  section="home"
  canonical="https://peninsulainsider.com.au/newsletter/"
  ogImage="/images/sourced/article-sorrento-weekend-01.webp"
>
  <!-- ═══════════════════════════════════════════════════════════════
       1. HERO, typographic publication front page.
          No photo, no scrim, no glass form. Type, voice, white card.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-hero" id="subscribe" aria-label="Subscribe to The Insider's Dispatch">
    <div class="container">
      <div class="news-hero__inner">
        <p class="news-hero__eyebrow">The Insider's Dispatch <span>·</span> Issue 04</p>
        <h1 class="news-hero__title">The <em>weekly</em><br/>dispatch lands.</h1>
        <p class="news-hero__dek">One pick. One weather-proof backup. One thing to skip. Written by editors who live on the Peninsula.</p>

        <div class="news-hero__form">
          <SubscribeForm variant="light" source="newsletter-page" />
        </div>

        <ul class="news-hero__proof">
          <li><strong>52</strong> dispatches a year</li>
          <li><strong>One email</strong> a week</li>
          <li><strong>One-click</strong> unsubscribe</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       2. SAMPLE DISPATCH, what they will actually receive.
          Specificity sells. This now sits second so the reader sees
          the product before any abstract bullet promises.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-sample" aria-label="Sample dispatch">
    <div class="container">
      <div class="news-sample__intro">
        <p class="label label--accent">What it actually looks like</p>
        <h2 class="news-sample__title">A recent dispatch</h2>
        <p class="news-sample__sub">Each week, in plain text. No banner ads, no sponsor blocks dressed as content, no auto-generated round-ups. The same email you'd get from a friend who lives on the ridge.</p>
      </div>

      <article class="news-sample__email">
        <header class="news-sample__email-head">
          <p class="news-sample__email-from">From: <strong>The Peninsula Insider</strong> &lt;dispatch@peninsulainsider.com.au&gt;</p>
          <p class="news-sample__email-subject">Peninsula This Weekend, 26 to 27 April</p>
          <p class="news-sample__email-preview">One pick · one weather-proof backup · one thing to skip…</p>
        </header>
        <div class="news-sample__email-body">
          <p><em>Reader,</em></p>
          <p>Vintage on the ridge is wrapping. The fruit is in, the cellar doors are quiet again, and Saturday looks like the first weekend in a month that does not feel like a queue. Three things shaping the weekend if you are coming down.</p>

          <h3>The pick, Foxeys Hangout, Saturday lunch</h3>
          <p>The new autumn menu landed mid-week. The pinot pairings are unusually generous this season, they have a back-vintage 2019 they are pouring by the glass through the weekend only. Book the 12:30 sitting, sit on the terrace, plan to be there for three hours.</p>

          <h3>The backup, Cape Schanck boardwalk if it rains</h3>
          <p>Forecast says a 40% chance Saturday afternoon. If it lands, the Cape Schanck boardwalk is the only Peninsula walk that genuinely improves in light rain, basalt cliffs darken, the Bass Strait spray goes vertical, and the lighthouse café is built for the weather.</p>

          <h3>Skip, the Sorrento Front Beach circus</h3>
          <p>Long weekend leftover. Carpark fills before 10am, the queue at the bakery is twenty deep by 11. Drive ten more minutes to Portsea Front Beach and skip the theatre.</p>

          <p>Until next time,<br/>The editors</p>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       3. WHAT YOU GET, four numbered promises
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-promise" aria-label="What you get">
    <div class="container">
      <div class="news-promise__intro">
        <p class="label label--accent">What's in the inbox</p>
        <h2 class="news-promise__title">Four things, every week</h2>
      </div>
      <ul class="news-promise__grid">
        <li class="news-promise__item">
          <span class="news-promise__num">01</span>
          <h3 class="news-promise__heading">Weekend Picker</h3>
          <p class="news-promise__body">Each week, for the weekend ahead. One pick, one weather-proof backup, one honest skip. The shortest editorial decision the week makes.</p>
        </li>
        <li class="news-promise__item">
          <span class="news-promise__num">02</span>
          <h3 class="news-promise__heading">New on the Peninsula</h3>
          <p class="news-promise__body">Openings, closures, vintage-release weekends, residency dinners. The things you would otherwise hear about three weeks late.</p>
        </li>
        <li class="news-promise__item">
          <span class="news-promise__num">03</span>
          <h3 class="news-promise__heading">Subscriber-only notes</h3>
          <p class="news-promise__body">Short editorial observations we do not publish on the site. The cellar door we would book again, the dish we keep ordering, the table to skip.</p>
        </li>
        <li class="news-promise__item">
          <span class="news-promise__num">04</span>
          <h3 class="news-promise__heading">Early access</h3>
          <p class="news-promise__body">New guides and long-form pieces land in the dispatch before they hit the site. Subscribers read them first.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       4. EDITORIAL PROMISES, trust + voice
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-trust" aria-label="Editorial promises">
    <div class="container">
      <div class="news-trust__intro">
        <p class="label label--accent">The promises we keep</p>
        <h2 class="news-trust__title">Independent · opinionated · once a week</h2>
      </div>
      <ul class="news-trust__grid">
        <li class="news-trust__item">
          <h3>One email a week</h3>
          <p>Once a week. We don't write when there is nothing to say. There is no daily list, no breaking-news ping, no auto-generated round-up.</p>
        </li>
        <li class="news-trust__item">
          <h3>Plain text and links</h3>
          <p>No banner ads, no native sponsorship dressed as editorial, no autoplay video. The dispatch reads like email, because it is email.</p>
        </li>
        <li class="news-trust__item">
          <h3>Recommendations are earned</h3>
          <p>Every venue mentioned has been visited by an editor. Skips are named. Disclosures are explicit. The 'Insider' name has to mean something.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       5. CLOSE, single button back to the form.
          One form, one decision. The close earns the conversion with
          a precise editorial line and bounces the reader to #subscribe.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-close" aria-label="Subscribe">
    <div class="container">
      <div class="news-close__inner">
        <p class="label label--accent">Ready</p>
        <h2 class="news-close__title">The next dispatch is already <em>drafting.</em></h2>
        <p class="news-close__dek">Add your email and you'll be on the next one. No confirmation gymnastics, one click to subscribe, one click to leave any time you stop wanting it.</p>
        <a href="#subscribe" class="news-close__cta">Subscribe</a>
      </div>
    </div>
  </section>
</BaseLayout>
