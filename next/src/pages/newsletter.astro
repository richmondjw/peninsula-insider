---
/**
 * /newsletter/ → /dispatch/ permanent redirect.
 * Keeps old links working; canonical content lives at /dispatch/.
 */
export const prerender = true;

const redirectUrl = '/dispatch/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content="0; url=/dispatch/" />
  <link rel="canonical" href="https://peninsulainsider.com.au/dispatch/" />
  <title>Redirecting…</title>
</head>
<body>
  <p>Redirecting to <a href="/dispatch/">The Insider Note</a>…</p>
  <script>window.location.replace('/dispatch/');</script>
</body>
</html>
