---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
export const prerender = true;
const items = [
  ['Weekend inspiration', "What's worth doing and where we'd go."],
  ['Seasonal picks', 'Places, openings and experiences worth knowing now.'],
  ['Local notes', 'Useful observations and things you might otherwise miss.'],
  ['From the Journal', 'Selected guides and stories worth reading.'],
];
---
<BaseLayout title="The Insider Note · Peninsula Insider" description="The Peninsula worth knowing. What's on, where we'd go and what's worth knowing next. Sent when there's something worth knowing." canonical="https://peninsulainsider.com.au/dispatch/">
  <div class="note-page container">
    <section class="note-hero" id="subscribe">
      <h1>The Insider Note</h1>
      <p class="note-tagline">The Peninsula worth knowing.</p>
      <p>What's on, where we'd go and what's worth knowing next.</p>
      <SubscribeForm variant="light" source="newsletter-page" disclaimer="Sent when there's something worth knowing. Unsubscribe any time." />
    </section>
    <section class="note-inside" aria-labelledby="note-inside-title">
      <h2 id="note-inside-title">What's inside</h2>
      <ul>{items.map(([title, description]) => <li><h3>{title}</h3><p>{description}</p></li>)}</ul>
    </section>
    <section class="note-close" aria-labelledby="note-close-title">
      <h2 id="note-close-title">Don't miss the next Note.</h2>
      <p class="note-tagline">The Peninsula worth knowing.</p>
      <SubscribeForm variant="light" source="newsletter-page" disclaimer="Unsubscribe any time." />
    </section>
  </div>
</BaseLayout>
<style>
  .note-page { max-width: 64rem; }
  section { padding: clamp(2.5rem, 6vw, 5rem) 0; }
  .note-hero, .note-close { max-width: 44rem; margin-inline: auto; }
  h1 { font: 500 clamp(2.8rem, 6vw, 4.8rem)/1.06 var(--font-display); letter-spacing: -.025em; margin: 0 0 1.4rem; }
  h2 { font: 500 clamp(1.8rem, 4vw, 2.6rem)/1.15 var(--font-display); margin: 0 0 1.5rem; }
  .note-tagline { font: 500 1.5rem/1.4 var(--font-display); }
  p { line-height: 1.6; max-width: 65ch; }
  .note-inside { border-block: 1px solid var(--border); }
  ul { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 3rem; list-style: none; padding: 0; margin: 0; }
  h3 { font: 500 1.3rem/1.3 var(--font-display); margin: 0 0 .5rem; }
  li p { margin: 0; color: var(--soft); }
  :global(.note-page .newsletter__form) { margin-top: 1.5rem; }
  @media (max-width: 40rem) { ul { grid-template-columns: 1fr; } }
</style>
