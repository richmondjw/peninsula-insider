---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Peninsula Dispatch' },
];
export const prerender = true;
---

<BaseLayout
  title="The Peninsula Dispatch · Peninsula Insider"
  description="Thoughtful Peninsula recommendations, seasonal notes and planning ideas — sent when they're genuinely worth opening."
  section="home"
  canonical="https://peninsulainsider.com.au/dispatch/"
  ogImage="/images/sourced/article-sorrento-weekend-01.webp"
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- ═══════════════════════════════════════════════════════════════
       1. HERO — publication front page.
          Type, voice, white card. Signup is secondary to editorial identity.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-hero" id="subscribe" aria-label="The Insider — Peninsula Insider Publication">
    <div class="container">
      <div class="news-hero__inner">
        <p class="news-hero__eyebrow">The Insider</p>
        <h1 class="news-hero__title">Thoughtful Peninsula notes <em>worth opening.</em></h1>
        <p class="news-hero__dek">Independent Peninsula recommendations and planning notes — sent when they're genuinely worth opening.</p>

        <div class="news-hero__form">
          <SubscribeForm variant="light" source="newsletter-page" />
        </div>

        <ul class="news-hero__proof">
          <li><strong>Curated</strong>, not scheduled</li>
          <li><strong>Editorial</strong> judgement, every send</li>
          <li><strong>One-click</strong> unsubscribe</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       2. EDITIONS — what the publication includes.
          Editorial rhythms within one publication, not newsletter categories.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-editions" aria-label="Editions">
    <div class="container">
      <div class="news-editions__inner">
        <p class="label label--accent">Inside the Dispatch</p>
        <ul class="news-editions__list">
          <li class="news-editions__item">Peninsula this weekend</li>
          <li class="news-editions__item">Seasonal recommendations</li>
          <li class="news-editions__item">New openings worth knowing</li>
          <li class="news-editions__item">Quiet Peninsula observations</li>
          <li class="news-editions__item">From the Journal</li>
        </ul>
        <p class="news-editions__note">Sent when there is something worth sending. One publication, multiple rhythms.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       3. SAMPLE ISSUE — what subscribers actually receive.
          Specificity sells. The reader sees the product before promises.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-sample" aria-label="Sample edition">
    <div class="container">
      <div class="news-sample__intro">
        <p class="label label--accent">What it actually looks like</p>
        <h2 class="news-sample__title">What the Dispatch sounds like</h2>
        <p class="news-sample__sub">Plain text. No banner ads, no sponsored content. The same email you'd get from a friend who lives on the ridge.</p>
      </div>

      <article class="news-sample__email">
        <header class="news-sample__email-head">
          <p class="news-sample__email-from">From: <strong>The Peninsula Insider</strong> &lt;dispatch@peninsulainsider.com.au&gt;</p>
          <p class="news-sample__email-subject">Peninsula This Weekend, 26 to 27 April</p>
          <p class="news-sample__email-preview">One pick · one weather-proof backup · one thing to skip…</p>
        </header>
        <div class="news-sample__email-body">
          <p><em>Reader,</em></p>
          <p>Vintage on the ridge is wrapping. The fruit is in, the cellar doors are quiet again, and Saturday looks like the first weekend in a month that does not feel like a queue. Three things shaping the weekend if you are coming down.</p>

          <h3>The pick, Foxeys Hangout, Saturday lunch</h3>
          <p>The new autumn menu landed mid-week. The pinot pairings are unusually generous this season, they have a back-vintage 2019 they are pouring by the glass through the weekend only. Book the 12:30 sitting, sit on the terrace, plan to be there for three hours.</p>

          <h3>The backup, Cape Schanck boardwalk if it rains</h3>
          <p>Forecast says a 40% chance Saturday afternoon. If it lands, the Cape Schanck boardwalk is the only Peninsula walk that genuinely improves in light rain, basalt cliffs darken, the Bass Strait spray goes vertical, and the lighthouse café is built for the weather.</p>

          <h3>Skip, the Sorrento Front Beach circus</h3>
          <p>Long weekend leftover. Carpark fills before 10am, the queue at the bakery is twenty deep by 11. Drive ten more minutes to Portsea Front Beach and skip the theatre.</p>

          <p>Until next time,<br/>The editors</p>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       4. WHAT YOU GET — four editorial promises
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-promise" aria-label="What you get">
    <div class="container">
      <div class="news-promise__intro">
        <p class="label label--accent">What's in the inbox</p>
        <h2 class="news-promise__title">Seasonal intelligence, not inbox noise.</h2>
      </div>
      <ul class="news-promise__grid">
        <li class="news-promise__item">
          <span class="news-promise__num">01</span>
          <h3 class="news-promise__heading">Weekend inspiration</h3>
          <p class="news-promise__body">A curated shortlist for the weekend ahead — the strongest events, the best timing, the planning notes that make the difference between a rushed trip and a good one.</p>
        </li>
        <li class="news-promise__item">
          <span class="news-promise__num">02</span>
          <h3 class="news-promise__heading">Seasonal recommendations</h3>
          <p class="news-promise__body">What to do as the Peninsula changes with the calendar. Vintage weekends, winter cellar doors, truffle season, the summer lunches worth the drive.</p>
        </li>
        <li class="news-promise__item">
          <span class="news-promise__num">03</span>
          <h3 class="news-promise__heading">Local observations</h3>
          <p class="news-promise__body">Short editorial notes we don't publish on the site. The cellar door we'd book again, the dish we keep ordering, the walk that's better in winter.</p>
        </li>
        <li class="news-promise__item">
          <span class="news-promise__num">04</span>
          <h3 class="news-promise__heading">New from the Peninsula</h3>
          <p class="news-promise__body">Openings, closures, new guides, and residency dinners. The things you'd otherwise hear about three weeks late.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       5. EDITORIAL PROMISES — trust + voice
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-trust" aria-label="Editorial promises">
    <div class="container">
      <div class="news-trust__intro">
        <p class="label label--accent">The promises we keep</p>
        <h2 class="news-trust__title">Independent · opinionated · when it's worth sending</h2>
      </div>
      <ul class="news-trust__grid">
        <li class="news-trust__item">
          <h3>Sent when it's worth sending</h3>
          <p>We don't write when there is nothing to say. No daily list, no auto-generated round-up. When it arrives, it's because it's worth your attention.</p>
        </li>
        <li class="news-trust__item">
          <h3>Plain text and links</h3>
          <p>Reads like email, because it is email. No banner ads, no sponsored placements.</p>
        </li>
        <li class="news-trust__item">
          <h3>Editorially independent</h3>
          <p>Recommendations are earned and editorially independent. Recommendations are grounded in firsthand experience, editorial judgement and ongoing Peninsula coverage.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       6. CLOSE — single CTA back to the form.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="news-close" aria-label="Join">
    <div class="container">
      <div class="news-close__inner">
        <p class="label label--accent">Join the Peninsula Dispatch</p>
        <h2 class="news-close__title">Join the <em>Peninsula Dispatch.</em></h2>
        <p class="news-close__dek">Thoughtful Peninsula recommendations, seasonal notes and planning ideas — sent when they're genuinely worth opening.</p>
        <a href="#subscribe" class="news-close__cta">Join the Dispatch →</a>
      </div>
    </div>
  </section>
</BaseLayout>
