---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicIntakeForm from '../../components/PublicIntakeForm.astro';
import {routeSlug,isListableVenue} from '../../lib/editorial';
const venues=(await getCollection('venues')).filter(isListableVenue).map(v=>({slug:routeSlug(v),name:v.data.name})).sort((a,b)=>a.name.localeCompare(b.name));
export const prerender=true;
---
<BaseLayout title="Manage my listing · Peninsula Insider" description="Send changes, links and photos for your existing Peninsula business listing." canonical="https://peninsulainsider.com.au/partners/update/">
 <div class="business-form-page container"><a href="/partners/">For Peninsula Businesses</a><h1>Manage my listing</h1><p>Send all your changes in one request. Listing updates are free and reviewed before publication.</p><PublicIntakeForm kind="listing-update" venues={venues}/><p>Not listed yet? <a href="/partners/add/">Add my business</a>.</p></div>
</BaseLayout>
<style>.business-form-page{max-width:54rem;padding-block:3rem}h1{font:500 clamp(2.5rem,5vw,4rem)/1.1 var(--font-display);margin:1.5rem 0}p{line-height:1.6;max-width:65ch}</style>
