---
/**
 * /partners/  -  Partner With Us
 *
 * Rewritten 2026-05-15 against Emma's "Partner With Us" brief and the
 * 2026-05-15 master strategy decision. Premium editorial partnership
 * invitation. No public pricing, no tier matrices, no deliverable
 * breakdowns - those live in the post-enquiry sales conversation.
 *
 * Backup of the prior page: /partners/_archive/index-pre-emma-2026-05-15.astro
 * (Astro ignores _-prefixed folders during compile.)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { editableText } from '../../lib/inline-edit/attrs';

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Partners", href: "/partners/" },
  { label: "Partner with Peninsula Insider" },
];
export const prerender = true;
---

<BaseLayout
  title="Partner with Peninsula Insider"
  description="Peninsula Insider helps quality Peninsula businesses become part of how people experience the region. We partner selectively with businesses whose atmosphere, quality, and values align with the editorial."
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="partners-page">

    <!-- HERO -->
    <section class="partners-hero">
      <div class="partners-hero__image-wrap">
        <img
          src="/images/sourced/article-vineyard-villa-01.webp"
          alt="Peninsula Insider · cellar door and vineyard, Mornington Peninsula"
          class="partners-hero__image"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="partners-hero__inner">
        <p class="partners-hero__eyebrow">Peninsula Insider</p>
        <h1 class="partners-hero__heading" {...editableText({ entityType: 'page', entitySlug: 'partners', fieldPath: 'hero.title', label: 'Partners - title' })}>Partner with Peninsula Insider</h1>
        <p class="partners-hero__sub" {...editableText({ entityType: 'page', entitySlug: 'partners', fieldPath: 'hero.dek', label: 'Partners - dek' })}>
          Become part of how people experience the Peninsula.
        </p>
        <p class="partners-hero__sub partners-hero__sub--second">
          Peninsula Insider is a trusted discovery and planning companion for
          people spending time on the Mornington Peninsula. We partner with
          a small number of businesses whose quality, atmosphere and values
          align with the editorial - helping them become part of how readers
          plan, decide, and experience the region.
        </p>
        <div class="partners-hero__actions">
          <a href="#enquire" class="partners-hero__cta">Enquire about partnerships</a>
        </div>
      </div>
    </section>

    <!-- WHY BUSINESSES PARTNER WITH US -->
    <section class="partners-section partners-pillars">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Why businesses partner with us</p>
        <h2 class="partners-section__heading">Trusted regional presence, not advertising placement</h2>

        <div class="partners-pillars__grid">

          <article class="partners-pillar">
            <h3 class="partners-pillar__title">Readers already planning</h3>
            <p class="partners-pillar__body">
              Peninsula Insider reaches people actively deciding where to eat,
              stay, and spend time on the Peninsula. The audience arrives with
              planning intent - and trust in what they find here.
            </p>
          </article>

          <article class="partners-pillar">
            <h3 class="partners-pillar__title">Seasonal and repeat readership</h3>
            <p class="partners-pillar__body">
              Readers return across seasons. Many visit the Peninsula multiple
              times a year and rely on Peninsula Insider for updated
              recommendations each time. Partnership presence compounds.
            </p>
          </article>

          <article class="partners-pillar">
            <h3 class="partners-pillar__title">Part of the discovery experience</h3>
            <p class="partners-pillar__body">
              Partners appear within the guides, recommendations, and planning
              surfaces readers use to make decisions - not alongside them.
              The placement feels like recommendation, not interruption.
            </p>
          </article>

          <article class="partners-pillar">
            <h3 class="partners-pillar__title">Long-term regional positioning</h3>
            <p class="partners-pillar__body">
              The strongest outcomes come from sustained presence within a
              trusted editorial environment - not a single campaign. Partners
              become part of how people think about the Peninsula.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- WHO WE WORK WITH -->
    <section class="partners-section partners-who">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Who we work with</p>
        <h2 class="partners-section__heading">Selective by category, premium by fit</h2>

        <p class="partners-who__intro">
          We typically partner with Peninsula businesses across these categories:
        </p>

        <ul class="partners-who__list">
          <li>Wineries and cellar doors</li>
          <li>Restaurants and dining venues</li>
          <li>Boutique accommodation</li>
          <li>Wellness and spa experiences</li>
          <li>Tours and attractions</li>
          <li>Premium local events</li>
          <li>Visitor experiences and destination businesses</li>
        </ul>

        <p class="partners-who__line">
          Coverage decisions are made on quality, atmosphere, local relevance and editorial fit.
        </p>
      </div>
    </section>

    <!-- PARTNERSHIP OPPORTUNITIES (types only, no pricing) -->
    <section class="partners-section partners-opportunities">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Partnership opportunities</p>
        <h2 class="partners-section__heading">Tailored to category, audience and season</h2>

        <ul class="partners-opportunities__list">
          <li><strong>Featured Partner Profiles.</strong> A considered editorial presence on the venue surfaces where we cover your category.</li>
          <li><strong>Seasonal Campaigns.</strong> Three-month editorial presence aligned to summer, autumn, winter or spring on the Peninsula.</li>
          <li><strong>Event Promotion.</strong> Editorial coverage around a specific cultural moment, festival or one-off.</li>
          <li><strong>Publication Partnerships.</strong> Inclusion in The Insider editorial editions and seasonal sends.</li>
          <li><strong>Offers and Experiences.</strong> Member-facing offers, bookable experiences and time-bound campaigns.</li>
          <li><strong>Destination and Category Sponsorships.</strong> Long-form curated guides built around a season or theme, with a single named partner.</li>
        </ul>

        <p class="partners-opportunities__line">
          Partnership opportunities are tailored based on category fit,
          audience alignment and seasonal relevance. Specifics are shared
          during the enquiry conversation.
        </p>
      </div>
    </section>

    <!-- EDITORIAL INDEPENDENCE -->
    <section class="partners-section partners-independence">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Editorial integrity</p>
        <h2 class="partners-section__heading">The editorial stays independent. Always.</h2>

        <div class="partners-independence__body">
          <p>
            Reader trust is the reason this audience is worth reaching. That
            trust depends on editorial independence - recommendations made on
            merit, not on commercial relationships. Peninsula Insider keeps
            that line firm.
          </p>
          <p>
            Three things that don't change:
          </p>
          <ul class="partners-independence__rules">
            <li><strong>Editorial rankings are not for sale.</strong> Partnerships provide visibility within the editorial environment - they don't direct coverage decisions or recommendation language.</li>
            <li><strong>Paid placements are always labelled.</strong> Readers can always tell the difference between editorial and a commercial partnership. That clarity is non-negotiable.</li>
            <li><strong>Only Peninsula businesses, always.</strong> Every partner is a Peninsula business. No off-region brands, no programmatic inventory, no generic advertising.</li>
          </ul>
          <p class="partners-independence__line">
            More on how we select recommendations and protect independence: <a href="/about/">About Peninsula Insider</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- SELECTIVE BY DESIGN -->
    <section class="partners-section partners-selective">
      <div class="partners-section__inner partners-selective__inner">
        <p class="partners-section__eyebrow">Selective by design</p>
        <h2 class="partners-section__heading">Quality over volume, by intention</h2>
        <p class="partners-selective__body">
          Peninsula Insider keeps partnership numbers intentionally small.
          The goal is not reach for its own sake - it is meaningful presence
          within a trusted editorial environment. Fewer partners means each
          one matters more.
        </p>
        <p class="partners-selective__body">
          The strongest partnerships are with businesses that Peninsula Insider
          would have written about anyway. The commercial relationship adds
          visibility; the editorial quality was already there.
        </p>
      </div>
    </section>

    <!-- ENQUIRY -->
    <section id="enquire" class="partners-section partners-enquiry">
      <div class="partners-section__inner partners-enquiry__inner">
        <p class="partners-section__eyebrow">Start the conversation</p>
        <h2 class="partners-section__heading">Every partnership begins with a conversation</h2>
        <p class="partners-enquiry__lede">
          Tell us about your business. We review fit and follow up with
          partnership information tailored to your category, season, and
          audience - not a generic media kit.
        </p>

        <form
          class="partners-enquiry__form"
          action="https://formspree.io/f/peninsula-insider-partners"
          method="POST"
          data-fallback-mailto="hello@peninsulainsider.com.au"
        >
          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Business name</span>
              <input type="text" name="business_name" required autocomplete="organization" />
            </label>
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Contact name</span>
              <input type="text" name="contact_name" required autocomplete="name" />
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Business category</span>
              <select name="business_category" required>
                <option value="" disabled selected>Select a category</option>
                <option value="winery-cellar-door">Winery or cellar door</option>
                <option value="restaurant-dining">Restaurant or dining venue</option>
                <option value="accommodation">Boutique accommodation</option>
                <option value="wellness-spa">Wellness or spa experience</option>
                <option value="tour-attraction">Tour or attraction</option>
                <option value="event">Premium local event</option>
                <option value="visitor-experience">Visitor experience or destination business</option>
                <option value="other">Other</option>
              </select>
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field partners-enquiry__field--full">
              <span class="partners-enquiry__label">Website or Instagram</span>
              <input type="text" name="website_or_instagram" placeholder="https:// or @handle" />
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field partners-enquiry__field--full">
              <span class="partners-enquiry__label">What are you interested in?</span>
              <select name="interest">
                <option value="" disabled selected>Select an area of interest (optional)</option>
                <option value="featured-profile">Featured Partner Profile</option>
                <option value="seasonal-campaign">Seasonal Campaign</option>
                <option value="event-promotion">Event Promotion</option>
                <option value="newsletter">Newsletter Partnership</option>
                <option value="offers-experiences">Offers and Experiences</option>
                <option value="sponsorship">Destination or Category Sponsorship</option>
                <option value="not-sure">Not sure yet, would like to talk</option>
              </select>
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field partners-enquiry__field--full">
              <span class="partners-enquiry__label">Notes (optional)</span>
              <textarea name="notes" rows="4" placeholder="Anything we should know - upcoming opening, season you want to target, audience you want to reach."></textarea>
            </label>
          </div>

          <div class="partners-enquiry__actions">
            <button type="submit" class="partners-enquiry__button">Send enquiry</button>
            <p class="partners-enquiry__fallback">Prefer email? <a href="mailto:hello@peninsulainsider.com.au?subject=Partnership%20enquiry%20-%20Peninsula%20Insider">hello@peninsulainsider.com.au</a></p>
          </div>
        </form>

        <p class="partners-enquiry__followup">
          After enquiry, we share the partnership materials privately, including
          the media kit, the commercial deck and additional partnership
          information where relevant.
        </p>
      </div>
    </section>

  </main>

  <NewsletterBlock />
</BaseLayout>

<script is:inline>
  /**
   * Partner enquiry form - graceful fallback.
   * Formspree endpoint placeholder; until wired, intercept submit and
   * open a structured mailto: with the form contents so enquiries never
   * fall through the floor.
   */
  (function () {
    var form = document.querySelector('.partners-enquiry__form');
    if (!form) return;
    var mailto = form.getAttribute('data-fallback-mailto');
    if (!mailto) return;

    form.addEventListener('submit', function (e) {
      // Quick reachability check on the Formspree endpoint - if it 404s
      // (because the endpoint isn't provisioned yet), fall back to mailto.
      // For now, default to mailto until the endpoint is configured.
      var ENDPOINT_LIVE = false; // flip to true once Formspree is provisioned
      if (ENDPOINT_LIVE) return;

      e.preventDefault();
      var data = new FormData(form);
      var lines = [];
      data.forEach(function (v, k) {
        if (!v) return;
        var label = k.replace(/_/g, ' ').replace(/^\w/, function (m) { return m.toUpperCase(); });
        lines.push(label + ': ' + v);
      });
      var subject = 'Partnership enquiry - ' + (data.get('business_name') || 'Peninsula Insider');
      var body = lines.join('\n');
      window.location.href = 'mailto:' + mailto +
        '?subject=' + encodeURIComponent(subject) +
        '&body=' + encodeURIComponent(body);
    });
  })();
</script>

<style>
  /* ============================================================
     PARTNERS LANDING PAGE  -  Peninsula Insider
     Rewritten 2026-05-15 against Emma's brief.
     Tokens: --bg, --text, --soft, --accent, --sage, --border, --bg-alt, --white
  ============================================================ */

  .partners-page { min-height: 100vh; background: var(--bg); }

  /* HERO */
  .partners-hero {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    overflow: hidden;
  }
  .partners-hero__image-wrap {
    width: 100%;
    height: 340px;
    overflow: hidden;
  }
  @media (min-width: 720px) {
    .partners-hero__image-wrap { height: 440px; }
  }
  .partners-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
  }
  .partners-hero__inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 4rem;
    text-align: center;
  }
  .partners-hero__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0 0 0.85rem;
  }
  .partners-hero__heading {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--text);
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }
  .partners-hero__sub {
    font-family: var(--font-ui);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 auto 1.25rem;
    max-width: 620px;
  }
  .partners-hero__sub--second {
    font-size: 1rem;
    color: var(--soft);
    margin-bottom: 2rem;
  }
  .partners-hero__actions {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .partners-hero__cta {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--white);
    background: var(--sage);
    border: none;
    border-radius: 3px;
    padding: 0.95rem 2.25rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .partners-hero__cta:hover { background: var(--text); }
  .partners-hero__link {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
    transition: color 0.15s ease;
  }
  .partners-hero__link:hover { color: var(--text); }

  /* SECTIONS */
  .partners-section { padding: 4rem 1.5rem; }
  .partners-section + .partners-section { border-top: 1px solid var(--border); }
  .partners-section__inner { max-width: 1040px; margin: 0 auto; }
  .partners-section__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sage);
    margin: 0 0 0.75rem;
  }
  .partners-section__heading {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
    margin: 0 0 2rem;
    letter-spacing: -0.01em;
  }

  /* PILLARS - four reasons businesses partner */
  .partners-pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  @media (min-width: 720px) {
    .partners-pillars__grid { grid-template-columns: 1fr 1fr; gap: 2.25rem; }
  }
  .partners-pillar {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }
  .partners-pillar__title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
    margin: 0 0 0.75rem;
    letter-spacing: -0.005em;
  }
  .partners-pillar__body {
    font-family: var(--font-ui);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--soft);
    margin: 0;
  }

  /* WHO WE WORK WITH */
  .partners-who__intro {
    font-family: var(--font-ui);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 1.5rem;
    max-width: 720px;
  }
  .partners-who__list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    max-width: 720px;
  }
  @media (min-width: 640px) {
    .partners-who__list { grid-template-columns: 1fr 1fr; gap: 0.6rem 2.5rem; }
  }
  .partners-who__list li {
    font-family: var(--font-ui);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text);
    padding-left: 1.25rem;
    position: relative;
  }
  .partners-who__list li::before {
    content: '·';
    position: absolute;
    left: 0;
    top: -0.15em;
    color: var(--sage);
    font-weight: 700;
    font-size: 1.6em;
    line-height: 1;
  }
  .partners-who__line {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--soft);
    max-width: 720px;
    margin: 0;
    font-style: normal;
  }

  /* PARTNERSHIP OPPORTUNITIES - curated, not service-list */
  .partners-opportunities__list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .partners-opportunities__list li {
    font-family: var(--font-ui);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--soft);
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .partners-opportunities__list li:first-child { border-top: 1px solid var(--border); }
  .partners-opportunities__list li strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.3rem;
    letter-spacing: -0.005em;
  }
  .partners-opportunities__line {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--soft);
    max-width: 720px;
    margin: 0;
    font-style: normal;
  }

  /* EDITORIAL INDEPENDENCE */
  .partners-independence { background: var(--bg-alt); }
  .partners-independence__body { max-width: 760px; }
  .partners-independence__body p {
    font-family: var(--font-ui);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .partners-independence__rules {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .partners-independence__rules li {
    font-family: var(--font-ui);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text);
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }
  .partners-independence__rules li:last-child { border-bottom: none; }
  .partners-independence__rules strong {
    color: var(--sage);
    font-weight: 600;
  }
  .partners-independence__line {
    font-family: var(--font-ui);
    font-size: 0.93rem;
    color: var(--soft);
  }
  .partners-independence__line a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* SELECTIVE BY DESIGN */
  .partners-selective__inner { max-width: 760px; }
  .partners-selective__body {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .partners-selective__body:last-child { color: var(--soft); }

  /* ENQUIRY FORM */
  .partners-enquiry { background: var(--bg-alt); }
  .partners-enquiry__inner { max-width: 680px; }
  .partners-enquiry__lede {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--soft);
    margin: 0 0 2.5rem;
  }
  .partners-enquiry__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .partners-enquiry__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .partners-enquiry__row { grid-template-columns: 1fr 1fr; }
    .partners-enquiry__field--full { grid-column: 1 / -1; }
  }
  .partners-enquiry__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .partners-enquiry__label {
    font-family: var(--font-ui);
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .partners-enquiry__field input,
  .partners-enquiry__field select,
  .partners-enquiry__field textarea {
    font-family: var(--font-ui);
    font-size: 0.97rem;
    line-height: 1.5;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.85rem 1rem;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
