---
/**
 * /partners/ - For Peninsula businesses
 *
 * Rewritten 2026-05-15 against Emma's "Partner With Us" brief and the
 * 2026-05-15 master strategy decision. Premium editorial partnership
 * invitation. No public pricing, no tier matrices, no deliverable
 * breakdowns - those live in the post-enquiry sales conversation.
 *
 * Backup of the prior page: /partners/_archive/index-pre-emma-2026-05-15.astro
 * (Astro ignores _-prefixed folders during compile.)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { editableText } from '../../lib/inline-edit/attrs';
import {
  BUSINESS_CATEGORIES,
  BUSINESS_CATEGORY_LABELS,
  ENQUIRY_INTERESTS,
  ENQUIRY_INTEREST_LABELS,
} from '../../lib/partner-enquiry';

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "For Peninsula businesses" },
];
export const prerender = true;
---

<BaseLayout
  title="For Peninsula businesses · Peninsula Insider"
  description="Correct or claim your Peninsula listing, send updated information, introduce an unlisted business, or enquire about an optional partnership. Factual corrections are free."
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="partners-page">

    <!-- HERO -->
    <section class="partners-hero">
      <div class="partners-hero__image-wrap">
        <img
          src="/images/sourced/article-vineyard-villa-01.webp"
          alt="Peninsula Insider · cellar door and vineyard, Mornington Peninsula"
          class="partners-hero__image"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="partners-hero__inner">
        <p class="partners-hero__eyebrow">Peninsula Insider</p>
        <h1 class="partners-hero__heading" {...editableText({ entityType: 'page', entitySlug: 'partners', fieldPath: 'hero.title', label: 'Partners - title' })}>For Peninsula businesses</h1>
        <p class="partners-hero__sub" {...editableText({ entityType: 'page', entitySlug: 'partners', fieldPath: 'hero.dek', label: 'Partners - dek' })}>
          Keep your listing accurate. Help readers plan their visit.
        </p>
        <p class="partners-hero__sub partners-hero__sub--second">
          Start with the details readers need: opening hours, location, booking links
          and what has changed. Factual corrections are free, with no account,
          claim or commercial relationship required.
        </p>
        <div class="partners-hero__actions">
          <a href="/corrections/" class="pi-btn pi-btn--solid">Correct a listing, free</a>
          <a href="/partners/claim/" class="pi-btn pi-btn--ghost">Claim your listing</a>
        </div>
      </div>
    </section>

    <section class="partners-section partners-pillars" aria-labelledby="business-help">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Your next step</p>
        <h2 id="business-help" class="partners-section__heading">How can we help your business?</h2>
        <div class="partners-pillars__grid">
          <article class="partners-pillar">
            <h3 class="partners-pillar__title">1. Correct a listing</h3>
            <p class="partners-pillar__body">Wrong hours, an old price or a broken booking link? Send the page, the correction and a source. Editorial checks factual corrections on the same basis for every business.</p>
            <p><a href="/corrections/">Report a correction, free →</a></p>
          </article>
          <article class="partners-pillar">
            <h3 class="partners-pillar__title">2. Claim your listing</h3>
            <p class="partners-pillar__body">If you own or manage a listed venue, sign in to request verified operator access. Editorial reviews your association with the venue. You can report a correction without claiming it.</p>
            <p><a href="/partners/claim/">Request a listing claim →</a></p>
          </article>
          <article class="partners-pillar">
            <h3 class="partners-pillar__title">3. Improve your presence</h3>
            <p class="partners-pillar__body">Send current photos, practical visiting details or an event proposal. These updates are free and reviewed by editorial; submitting information does not guarantee coverage or a recommendation.</p>
            <p><a href="/partners/update/">Send a listing update →</a></p>
          </article>
          <article class="partners-pillar">
            <h3 class="partners-pillar__title">4. Explore a partnership</h3>
            <p class="partners-pillar__body">Optional paid opportunities are described below. Commercial placements are labelled, and buying one does not influence factual corrections, editorial rankings or recommendations.</p>
            <p><a href="#partnerships">View partnership options →</a></p>
          </article>
        </div>
        <p class="partners-who__line">Not listed yet? <a href="/partners/update/#new-business">Introduce your business for editorial consideration</a>. It is free to submit, with no promise of inclusion and no partnership enquiry required.</p>
      </div>
    </section>

    <!-- WHO WE WORK WITH -->
    <section id="partnerships" class="partners-section partners-who">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Optional partnerships</p>
        <h2 class="partners-section__heading">Partnerships for Peninsula businesses</h2>

        <p class="partners-who__intro">
          We consider partnership enquiries from Peninsula businesses in these categories:
        </p>

        <ul class="partners-who__list">
          <li>Wineries and cellar doors</li>
          <li>Restaurants and dining venues</li>
          <li>Boutique accommodation</li>
          <li>Wellness and spa experiences</li>
          <li>Tours and attractions</li>
          <li>Premium local events</li>
          <li>Visitor experiences and destination businesses</li>
        </ul>

        <p class="partners-who__line">
          Coverage decisions are made on quality, atmosphere, local relevance and editorial fit.
        </p>
      </div>
    </section>

    <!-- PARTNERSHIP OPPORTUNITIES (types only, no pricing) -->
    <section class="partners-section partners-opportunities">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Partnership opportunities</p>
        <h2 class="partners-section__heading">Discuss the format, placement and season</h2>

        <ul class="partners-opportunities__list">
          <li><strong>Featured Partner Profiles.</strong> A clearly labelled commercial profile on relevant venue and planning surfaces.</li>
          <li><strong>Seasonal Campaigns.</strong> A clearly labelled three-month placement aligned to summer, autumn, winter or spring on the Peninsula.</li>
          <li><strong>Event Promotion.</strong> Clearly labelled promotion around a specific cultural moment, festival or one-off.</li>
          <li><strong>Publication Partnerships.</strong> Clearly labelled commercial inclusions in The Insider Note and seasonal sends.</li>
          <li><strong>Offers and Experiences.</strong> Member-facing offers, bookable experiences and time-bound campaigns.</li>
          <li><strong>Destination and Category Sponsorships.</strong> Long-form curated guides built around a season or theme, with a single named partner.</li>
        </ul>

        <p class="partners-opportunities__line">
          Partnership opportunities are tailored based on category fit,
          the proposed placement and seasonal relevance. Specifics are shared
          during the enquiry conversation.
        </p>
      </div>
    </section>

    <!-- EDITORIAL INDEPENDENCE -->
    <section class="partners-section partners-independence">
      <div class="partners-section__inner">
        <p class="partners-section__eyebrow">Editorial integrity</p>
        <h2 class="partners-section__heading">The editorial stays independent. Always.</h2>

        <div class="partners-independence__body">
          <p>
            Recommendations are made on editorial merit. A commercial
            relationship does not buy a ranking, a favourable verdict or
            faster treatment of a factual correction.
          </p>
          <p>
            Three things that don't change:
          </p>
          <ul class="partners-independence__rules">
            <li><strong>Editorial rankings are not for sale.</strong> Partnerships provide visibility within the editorial environment - they don't direct coverage decisions or recommendation language.</li>
            <li><strong>Paid placements are always labelled.</strong> Readers can always tell the difference between editorial and a commercial partnership. That clarity is non-negotiable.</li>
            <li><strong>Only Peninsula businesses, always.</strong> Every partner is a Peninsula business. No off-region brands, no programmatic inventory, no generic advertising.</li>
          </ul>
          <p class="partners-independence__line">
            More on how we select recommendations and protect independence: <a href="/about/">About Peninsula Insider</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="partners-section partners-selective">
      <div class="partners-section__inner partners-selective__inner">
        <p class="partners-section__eyebrow">Before you enquire</p>
        <h2 class="partners-section__heading">Agree the scope before making a commitment</h2>
        <p class="partners-selective__body">A proposal sets out the placement, duration, deliverables, price and any available reporting. We do not promise audience growth, bookings, sales or a particular commercial return.</p>
        <p class="partners-selective__body">Request current audience information during the enquiry conversation. Any figures supplied should identify the measurement period and source, with forecasts clearly distinguished from measured results.</p>
      </div>
    </section>

    <!-- ENQUIRY -->
    <section id="enquire" class="partners-section partners-enquiry">
      <div class="partners-section__inner partners-enquiry__inner">
        <p class="partners-section__eyebrow">Start the conversation</p>
        <h2 class="partners-section__heading">Every partnership begins with a conversation</h2>
        <p class="partners-enquiry__lede">
          Tell us about your business. We review fit and follow up with
          partnership information tailored to your category, season, and
          proposed placement. There is no obligation to proceed.
        </p>

        {/*
          No `action`, no `method`, and no endpoint flag. Until PI-015 this
          form POSTed to a Formspree placeholder behind a hardcoded
          `ENDPOINT_LIVE = false`, so every submit was turned into a `mailto:`
          handoff and nothing was ever recorded. It now writes to
          pi.partner_enquiries through the anon Supabase client, exactly as
          /corrections/ does, and the submit handler is the only path out.
        */}
        <form class="partners-enquiry__form" data-partner-enquiry-form aria-label="Partnership enquiry">
          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Business name</span>
              <input type="text" name="business_name" required maxlength="200" autocomplete="organization" />
            </label>
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Contact name</span>
              <input type="text" name="contact_name" required maxlength="200" autocomplete="name" />
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Email</span>
              <input type="email" name="email" required maxlength="240" autocomplete="email" />
            </label>
            <label class="partners-enquiry__field">
              <span class="partners-enquiry__label">Business category</span>
              <select name="business_category" required>
                <option value="" disabled selected>Select a category</option>
                {BUSINESS_CATEGORIES.map((value) => (
                  <option value={value}>{BUSINESS_CATEGORY_LABELS[value]}</option>
                ))}
              </select>
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field partners-enquiry__field--full">
              <span class="partners-enquiry__label">Website or Instagram</span>
              <input type="text" name="website_or_instagram" maxlength="300" placeholder="https:// or @handle" />
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field partners-enquiry__field--full">
              <span class="partners-enquiry__label">What are you interested in?</span>
              <select name="interest">
                <option value="" disabled selected>Select an area of interest (optional)</option>
                {ENQUIRY_INTERESTS.map((value) => (
                  <option value={value}>{ENQUIRY_INTEREST_LABELS[value]}</option>
                ))}
              </select>
            </label>
          </div>

          <div class="partners-enquiry__row">
            <label class="partners-enquiry__field partners-enquiry__field--full">
              <span class="partners-enquiry__label">Notes (optional)</span>
              <textarea name="notes" rows="4" maxlength="2000" placeholder="Anything we should know - upcoming opening, season you want to target, audience you want to reach."></textarea>
            </label>
          </div>

          {/*
            Spam control, and the whole of it: a honeypot and a timing check.
            No CAPTCHA, because a business enquiring about a commercial
            relationship should not be asked to identify traffic lights, and
            no third-party script, because that is the dependency this ticket
            exists to remove.

            The trap is off-screen rather than display:none, and carries a
            real label and autocomplete="off" so a password manager does not
            fill it in for a real person. tabindex="-1" keeps it out of the
            keyboard path and aria-hidden out of the screen-reader path; the
            only thing left that fills it is something reading the DOM.

            Both fields are SENT, and both are constrained by CHECK
            constraints on pi.partner_enquiries. That is the point of sending
            them: a bot posting straight at PostgREST never runs the script
            below, but it still has to satisfy the database.
          */}
          <div class="partners-enquiry__trap" aria-hidden="true">
            <label for="partner-enquiry-fax">Fax number (leave this field empty)</label>
            <input id="partner-enquiry-fax" type="text" name="bot_trap" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="compose_ms" value="" data-compose-ms />

          <div class="partners-enquiry__actions">
            <button type="submit" class="pi-btn pi-btn--solid">Send enquiry</button>
            <p class="partners-enquiry__fallback">Prefer email? <a href="mailto:hello@peninsulainsider.com.au?subject=Partnership%20enquiry%20-%20Peninsula%20Insider">hello@peninsulainsider.com.au</a></p>
          </div>

          {/*
            One status region for every outcome, including the ones that are
            not success. It is empty and hidden until a submit resolves, and
            what it says is decided by outcomeMessage() in lib/partner-enquiry.ts
            rather than here, so that the test asserting a non-success outcome
            can never read as a confirmation is actually testing the words the
            reader sees.
          */}
          <p class="partners-enquiry__status" data-partner-enquiry-status role="status" aria-live="polite" hidden></p>
        </form>

        <p class="partners-enquiry__followup">
          After enquiry, we share the partnership materials privately, including
          the media kit, the commercial deck and additional partnership
          information where relevant.
        </p>
      </div>
    </section>

  </div>

  <NewsletterBlock />
</BaseLayout>

<script>
  /**
   * Partner enquiry form (PI-015).
   *
   * WHAT THIS REPLACED. A `mailto:` interceptor sitting behind
   * `var ENDPOINT_LIVE = false`, in front of a Formspree endpoint that was
   * never provisioned. Nothing reached a server, nothing was recorded, and
   * once the browser handed off to a mail client this page could not tell
   * whether a message was composed, sent or abandoned. Where no mail handler
   * was configured, pressing Send did nothing and said nothing.
   *
   * The enquiry now goes to pi.partner_enquiries through the anon Supabase
   * client, the same way /corrections/ writes a correction. There is no
   * application server on this site: RLS is the gate, the reference is minted
   * here because the anon role cannot read the row back, and every decision
   * about what the reader is told comes from classifyOutcome() rather than
   * from this file, so it can be tested.
   *
   * NOT is:inline, unlike the script this replaces - it has to import the
   * shared rules, and a rule that only exists inside an inline page script is
   * a rule no test can hold.
   *
   * Schema: ops/migrations/2026-09-14-pi-partner-enquiries.sql
   * Rules and tests: src/lib/partner-enquiry.ts, src/lib/partner-enquiry.test.mjs
   */
  import { getSupabase, isAuthEnabled } from '../../lib/auth';
  import { partnerEnquiryShape } from '../../lib/analytics-contract';
  import {
    PARTNERSHIPS_EMAIL,
    buildContactRow,
    buildEnquiryRow,
    classifyOutcome,
    classifySubmission,
    describeMissingFields,
    generateEnquiryRef,
    missingRequiredFields,
    outcomeMessage,
  } from '../../lib/partner-enquiry';

  /** Light dedupe signal, same shape and same non-guarantee as /corrections/. */
  function clientToken(): string {
    try {
      const k = 'pi:partner-enquiry:client-token';
      let v = localStorage.getItem(k);
      if (!v) {
        v = (typeof crypto !== 'undefined' && crypto.randomUUID)
          ? crypto.randomUUID()
          : 'tok-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        localStorage.setItem(k, v);
      }
      return v;
    } catch {
      return 'tok-' + Math.random().toString(36).slice(2);
    }
  }

  /**
   * The enquiry id, minted here rather than by the database. The contact row
   * is keyed on it and the anon role cannot select the enquiry back, so the
   * client has to know the id before it writes either row.
   */
  function newEnquiryId(): string {
    if (typeof crypto !== 'undefined' && crypto.randomUUID) return crypto.randomUUID();
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (ch) => {
      const r = (Math.random() * 16) | 0;
      return (ch === 'x' ? r : (r & 0x3) | 0x8).toString(16);
    });
  }

  /**
   * Measurement shape. The envelope's sanitiser strips anything identifying
   * that slips past, but the reduction happens here first: partnerEnquiryShape
   * keeps the two closed-vocabulary selects, a has_website boolean and a note
   * length bucket, and drops business name, contact name and email entirely.
   *
   * bot_trap and compose_ms are removed BEFORE the reduction rather than
   * added to it. They are machinery, not answers: counting compose_ms as a
   * provided field would inflate fields_provided by one on every enquiry and
   * quietly move the baseline of a metric someone will later read as
   * "how much of the form do people fill in".
   */
  function measurableEntries(data: FormData): [string, unknown][] {
    const out: [string, unknown][] = [];
    for (const [key, value] of data.entries()) {
      if (key === 'bot_trap' || key === 'compose_ms') continue;
      out.push([key, typeof value === 'string' ? value : '']);
    }
    return out;
  }

  function init() {
    const form = document.querySelector('[data-partner-enquiry-form]') as HTMLFormElement | null;
    if (!form) return;

    // init() runs twice on a first load with the client router: once when
    // this module executes, and again when astro:page-load fires. Without
    // this guard the same form element carries two submit listeners and a
    // single press files the enquiry twice - two rows, two references, one
    // business, and the second insert is the one whose reference is shown.
    //
    // An element-level guard is the right instrument HERE, and only because
    // the listener is on the element: a view transition replaces the form, so
    // the guard and the listener are discarded together. The same guard on a
    // document-level listener would not work, which is what
    // scripts/client-listener-hygiene.test.mjs exists to catch.
    if (form.dataset.piEnquiryBound === '1') return;
    form.dataset.piEnquiryBound = '1';

    const status = form.querySelector('[data-partner-enquiry-status]') as HTMLParagraphElement | null;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const composeField = form.querySelector('[data-compose-ms]') as HTMLInputElement | null;

    /**
     * Stamped when the form becomes usable, not when the document parsed, and
     * re-stamped on every view-transition arrival. A timestamp left over from
     * a previous page view would make a genuine enquiry look implausibly
     * considered, which is harmless, but it would also mean the number
     * measures the wrong thing.
     */
    const readyAt = Date.now();

    function composeMs(): number {
      return Date.now() - readyAt;
    }

    function setStatus(kind: 'success' | 'error' | 'info', message: string) {
      if (!status) return;
      status.textContent = message;
      status.setAttribute('data-status-kind', kind);
      status.removeAttribute('hidden');
    }

    function track(event: string, payload: Record<string, unknown>) {
      const w = window as unknown as { piTrack?: (e: string, p: Record<string, unknown>, o?: unknown) => void };
      if (typeof w.piTrack === 'function') {
        w.piTrack(event, payload, { component: 'PartnerEnquiryForm' });
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const values: Record<string, string> = {};
      for (const [key, value] of data.entries()) {
        values[key] = typeof value === 'string' ? value : '';
      }

      const elapsed = composeMs();
      if (composeField) composeField.value = String(elapsed);

      const w = window as unknown as { piAnalytics?: { newId: () => string } };
      const attempt = w.piAnalytics ? w.piAnalytics.newId() : String(Date.now());
      const shape = partnerEnquiryShape(measurableEntries(data));
      shape.attempt_id = attempt;
      shape.surface = 'partners-page';
      track('partner_enquiry_started', shape);

      /** Report a non-delivery honestly, and never as a confirmation. */
      function fail(reason: string, message: string) {
        setStatus('error', message);
        track('partner_enquiry_failed', {
          attempt_id: attempt,
          surface: 'partners-page',
          reason,
          business_category: shape.business_category,
          interest: shape.interest,
        });
        if (button) {
          button.disabled = false;
          button.textContent = 'Send enquiry';
        }
      }

      // The browser has already enforced `required`; this catches what it
      // does not - whitespace-only fields, an address that cannot be one, a
      // category outside the vocabulary - and says what is outstanding in one
      // sentence instead of leaving the sender hunting for a focused control.
      const missing = missingRequiredFields(values);
      if (missing.length > 0) {
        fail('incomplete', describeMissingFields(missing));
        return;
      }

      // Honeypot and timing. Both are re-checked by the database; this copy
      // exists so a person who trips the timing floor is told so immediately
      // and can simply press Send again, rather than being handed a Postgres
      // constraint violation.
      const verdict = classifySubmission({ honeypot: values.bot_trap, composeMs: elapsed });
      if (verdict !== 'ok') {
        // 'no-timing' cannot be reached from this page - `elapsed` is always a
        // number here - but it is a verdict the classifier can return, and a
        // branch that falls through to the wrong sentence is how a message
        // starts lying. Each verdict gets its own words.
        const messages: Record<string, string> = {
          honeypot:
            'That submission was blocked as automated, so it was not sent. If you are a person, '
            + 'reload the page and try again, or email ' + PARTNERSHIPS_EMAIL + ' instead.',
          'too-fast':
            'That came through faster than a form can be filled in, so it was not sent. '
            + 'Wait a moment and press Send enquiry again, or email ' + PARTNERSHIPS_EMAIL + '.',
          'no-timing':
            'Something on this page did not load properly, so the enquiry was not sent. '
            + 'Reload and try again, or email ' + PARTNERSHIPS_EMAIL + '.',
        };
        fail(verdict, messages[verdict]);
        return;
      }

      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }
      setStatus('info', 'Sending…');

      const c = getSupabase();
      if (!c || !isAuthEnabled()) {
        fail(
          'unreachable',
          'The enquiry queue is not reachable from this page right now, so nothing was sent. Email '
            + PARTNERSHIPS_EMAIL + ' instead - same desk.',
        );
        return;
      }

      const session = (await c.auth.getSession()).data.session;
      const userId = session?.user?.id ?? null;

      const enquiryRef = generateEnquiryRef();
      const id = newEnquiryId();

      // Both writes are awaited and both results are READ. Nothing below
      // infers success from the absence of a thrown exception: supabase-js
      // returns errors, it does not throw them, so a `try` with no error check
      // is exactly how a form comes to congratulate someone on a failed
      // insert.
      let enquiryInserted = false;
      let contactInserted = false;

      try {
        const { error } = await c
          .from('partner_enquiries')
          .insert(buildEnquiryRow(values, {
            id,
            enquiryRef,
            composeMs: elapsed,
            userId,
            clientToken: clientToken(),
          }));
        if (error) console.warn('[partners] enquiry insert failed:', error.message);
        else enquiryInserted = true;
      } catch (err) {
        console.warn('[partners] enquiry insert threw:', err);
      }

      // Only attempted once the enquiry row exists: the contact row carries a
      // foreign key to it, so writing it first is not an option, and writing
      // it after a failed enquiry insert would fail anyway.
      if (enquiryInserted) {
        const contact = buildContactRow(values, id);
        if (contact) {
          try {
            const { error } = await c.from('partner_enquiry_contacts').insert(contact);
            if (error) console.warn('[partners] contact insert failed:', error.message);
            else contactInserted = true;
          } catch (err) {
            console.warn('[partners] contact insert threw:', err);
          }
        }
      }

      const outcome = classifyOutcome({ enquiryInserted, contactInserted });
      const message = outcomeMessage(outcome, enquiryRef);

      if (outcome === 'success') {
        form.reset();
        setStatus('success', message);
        track('partner_enquiry_submitted', {
          attempt_id: attempt,
          surface: 'partners-page',
          business_category: shape.business_category,
          interest: shape.interest,
        });
        if (button) {
          button.disabled = true;
          button.textContent = 'Enquiry sent';
        }
        return;
      }

      // 'unanswerable' is a partial: the enquiry is on the server, so the
      // form is NOT reset - retyping it would file it twice - but it is not
      // reported as a success either, because we cannot reply to it.
      fail(outcome === 'unanswerable' ? 'contact_not_saved' : 'insert_failed', message);
    });
