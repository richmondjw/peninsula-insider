---
/**
 * Sanity Visual Editing preview routes.
 *
 * These mirror the public detail pages (e.g. `/wine/pt-leo-estate/`) but
 * are SSR-rendered with the stega-encoded Sanity client so the
 * Presentation tool's click-to-edit overlay works. Public traffic still
 * hits the prerendered routes — these are editor-only.
 *
 * URL shape: `/preview/<section>/<slug>/`
 *   section ∈ {eat, wine, stay, journal, places, explore,
 *              whats-on, plans, tour, tour-operators, tour-packages}
 *
 * Studio's Presentation tool resolves canonical URLs to these via
 * `defineLocations` in `sanity.config.ts`.
 *
 * No `getStaticPaths`: these are dynamic SSR. `prerender = false` is
 * implicit under the hybrid build (PI_ADMIN_HYBRID=1).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VenueDetailTemplate from '../../../components/VenueDetailTemplate.astro';
import {fetchVenueFromSanity} from '../../../lib/sanity/venue-adapter';
import {fetchArticleFromSanity} from '../../../lib/sanity/article-adapter';
import {fetchEventFromSanity} from '../../../lib/sanity/event-adapter';
import {fetchPlaceFromSanity} from '../../../lib/sanity/place-adapter';
import {fetchItineraryFromSanity} from '../../../lib/sanity/itinerary-adapter';
import {
  fetchExperienceFromSanity,
  fetchTourFromSanity,
  fetchTourOperatorFromSanity,
  fetchTourPackageFromSanity,
} from '../../../lib/sanity/phase5-adapters';

export const prerender = false;

const {section, slug} = Astro.params as {section: string; slug: string};
const preview = true;

// Dispatch to the right adapter. Any unknown section → null → 404.
let entity: any = null;
let kind: 'venue' | 'article' | 'event' | 'place' | 'itinerary' | 'experience' | 'tour' | 'tour-operator' | 'tour-package' | null = null;

switch (section) {
  case 'eat':
  case 'wine':
  case 'stay':
    entity = await fetchVenueFromSanity(slug, {preview});
    kind = 'venue';
    break;
  case 'journal':
    entity = await fetchArticleFromSanity(slug, {preview});
    kind = 'article';
    break;
  case 'whats-on':
    entity = await fetchEventFromSanity(slug, {preview});
    kind = 'event';
    break;
  case 'places':
    entity = await fetchPlaceFromSanity(slug, {preview});
    kind = 'place';
    break;
  case 'plans':
    entity = await fetchItineraryFromSanity(slug, {preview});
    kind = 'itinerary';
    break;
  case 'explore':
    entity = await fetchExperienceFromSanity(slug, {preview});
    kind = 'experience';
    break;
  case 'tour':
    entity = await fetchTourFromSanity(slug, {preview});
    kind = 'tour';
    break;
  case 'tour-operators':
    entity = await fetchTourOperatorFromSanity(slug, {preview});
    kind = 'tour-operator';
    break;
  case 'tour-packages':
    entity = await fetchTourPackageFromSanity(slug, {preview});
    kind = 'tour-package';
    break;
}

if (!entity) {
  return new Response(`Preview: no ${section} matching "${slug}"`, {status: 404});
}

// Force preview mode on so BaseLayout renders the SanityVisualEditing overlay
// even if the cookie isn't set (Studio's iframe usually has the cookie via
// /api/preview/enable, but this is belt-and-braces).
(Astro.locals as Record<string, unknown>).sanityPreview = true;

const title = `[Preview] ${entity?.data?.name ?? entity?.data?.title ?? slug} · Peninsula Insider`;
---

<BaseLayout
  title={title}
  description="Sanity preview render — editors only."
  noindex={true}
>
  {kind === 'venue' && (
    <VenueDetailTemplate
      venue={entity}
      section={section === 'eat' || section === 'stay' || section === 'wine' ? section : 'eat'}
    />
  )}

  {kind !== 'venue' && (
    <div style="max-width:840px;margin:48px auto;padding:0 24px;">
      <p style="opacity:.6;font-size:13px;margin-bottom:8px;">Preview · {section} · {slug}</p>
      <h1 style="margin:0 0 16px;">{entity?.data?.name ?? entity?.data?.title ?? slug}</h1>
      <p style="font-size:18px;line-height:1.6;">
        {entity?.data?.dek ?? entity?.data?.signature ?? entity?.data?.summary ?? ''}
      </p>
      <p style="margin-top:32px;opacity:.5;font-size:13px;">
        Full preview template for this entity type is on the followup roadmap.
        Click any field above to edit it in Studio.
      </p>
    </div>
  )}
</BaseLayout>
