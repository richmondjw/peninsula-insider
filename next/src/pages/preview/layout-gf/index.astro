---
/**
 * Good Food-inspired layout preview — /preview/layout-gf/
 *
 * Staged page to evaluate a Good Food-influenced editorial structure:
 * split hero · event strip · journal lead+stack · 4-up eat grid ·
 * newsletter mid-page · dark worth-the-drive strip · plans · place rail.
 *
 * Self-contained page: all CSS lives in the <style> block below.
 * Uses existing card components (EventCard, VenueCard, etc.) unchanged.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EventCard from '../../../components/EventCard.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import VenueCard from '../../../components/VenueCard.astro';
import ItineraryCard from '../../../components/ItineraryCard.astro';
import PlaceCard from '../../../components/PlaceCard.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import { routeSlug, venueHrefPrefix, isUpcoming, formatLabel } from '../../../lib/editorial';
import { fetchVenueFromSanity } from '../../../lib/sanity/venue-adapter';
import { fetchArticleFromSanity } from '../../../lib/sanity/article-adapter';

export const prerender = true;

const allArticles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const allVenues  = await getCollection('venues');
const allEvents  = await getCollection('events');
const allItineraries = await getCollection('itineraries');
const allPlaces  = await getCollection('places');

// This Weekend — 3 highest-appeal upcoming events
const weekendEvents = allEvents
  .filter((e) => {
    if (['weekly', 'monthly', 'ongoing'].includes(e.data.recurrence)) return true;
    return isUpcoming(e.data.endDate ?? e.data.startDate);
  })
  .sort((a, b) => (b.data.visitorAppealScore ?? 0) - (a.data.visitorAppealScore ?? 0))
  .slice(0, 3);

// From the Journal — 1 featured lead + 2 supporting
// Hydrate hero images from Sanity so the lead card shows the production image.
const journalArticles = allArticles.filter((a) => a.data.format !== 'weekend-picker');
const leadArticleRaw = journalArticles.find((a) => a.data.featured) ?? journalArticles[0];
const supportArticles = journalArticles
  .filter((a) => routeSlug(a) !== routeSlug(leadArticleRaw))
  .slice(0, 2);

// Hydrate lead article hero from Sanity (falls back to local on error)
async function hydrateArticleHero(article: any): Promise<any> {
  try {
    const sanity = await fetchArticleFromSanity(routeSlug(article));
    if (sanity?.data?.heroImage?.src && !sanity.data.heroImage.src.includes('home-cover.webp')) {
      return { ...article, data: { ...article.data, heroImage: sanity.data.heroImage } };
    }
  } catch (_) {}
  return article;
}
const leadArticle = await hydrateArticleHero(leadArticleRaw);

// Eat & Drink — select top 4 from local collection (preserves hat-sorting),
// then hydrate each with its Sanity hero image for the production CDN photo.
const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
const eatVenuesLocal = allVenues
  .filter((v) => eatTypes.includes(v.data.type))
  .filter((v) => v.data.status !== 'permanently_closed')
  .sort((a, b) => (b.data.authority?.hats ?? 0) - (a.data.authority?.hats ?? 0))
  .slice(0, 4);

async function hydrateVenueHero(venue: any): Promise<any> {
  try {
    const sanity = await fetchVenueFromSanity(routeSlug(venue));
    if (sanity?.data?.heroImage?.src && !sanity.data.heroImage.src.includes('home-cover.webp')) {
      return { ...venue, data: { ...venue.data, heroImage: sanity.data.heroImage } };
    }
  } catch (_) {}
  return venue;
}
const eatVenues = await Promise.all(eatVenuesLocal.map(hydrateVenueHero));

// Worth the Drive — prefer worthTheDrive-flagged events, fall back to high-score
const worthDriveTagged = allEvents
  .filter((e) => (e.data as any).worthTheDrive === true)
  .filter((e) => {
    if (['weekly', 'monthly', 'ongoing'].includes(e.data.recurrence)) return true;
    return isUpcoming(e.data.endDate ?? e.data.startDate);
  })
  .sort((a, b) => (b.data.visitorAppealScore ?? 0) - (a.data.visitorAppealScore ?? 0))
  .slice(0, 3);

const usedEventSlugs = new Set(weekendEvents.map(routeSlug));
const worthDriveFinal = worthDriveTagged.length >= 2
  ? worthDriveTagged
  : allEvents
      .filter((e) => {
        if (['weekly', 'monthly', 'ongoing'].includes(e.data.recurrence)) return true;
        return isUpcoming(e.data.endDate ?? e.data.startDate);
      })
      .filter((e) => !usedEventSlugs.has(routeSlug(e)))
      .sort((a, b) => (b.data.visitorAppealScore ?? 0) - (a.data.visitorAppealScore ?? 0))
      .slice(0, 3);

// Plan Your Weekend — preferred slugs, fill from collection
const featuredPlanSlugs = ['ridge-to-sea-two-night-escape', 'wellness-weekend', 'sorrento-off-season-weekend'];
const featuredPlans = featuredPlanSlugs
  .map((s) => allItineraries.find((it) => routeSlug(it) === s))
  .filter(Boolean);
const fallbackPlans = allItineraries.filter((it) => !featuredPlanSlugs.includes(routeSlug(it)));
const planCards = [...featuredPlans, ...fallbackPlans].slice(0, 3) as typeof allItineraries;

// By Place — 8-destination horizontal rail
const featuredPlaceSlugs = ['sorrento', 'red-hill', 'flinders', 'arthurs-seat', 'rosebud', 'rye', 'portsea', 'mornington'];
const placeRail = featuredPlaceSlugs
  .map((s) => allPlaces.find((p) => routeSlug(p) === s))
  .filter(Boolean) as typeof allPlaces;

const leadSlug = routeSlug(leadArticle);
const leadBase = (leadArticle.data.section ?? 'journal') === 'plans' ? '/plans' : '/journal';
const leadHref = `${leadBase}/${leadSlug}`;
const leadFormat = formatLabel[leadArticle.data.format] ?? leadArticle.data.format;
---

<BaseLayout
  title="Peninsula Insider — Layout Preview"
  description="A staged layout exploration for Peninsula Insider, drawing on Good Food editorial design principles."
  section="home"
  noindex={true}
>

  <!-- ═══════════════════════════════════════════════════════
       STAGING BANNER
  ═══════════════════════════════════════════════════════ -->
  <div class="gf-staging-bar">
    <span>Layout preview — /preview/layout-gf/</span>
    <span>Not indexed · For editorial review only</span>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       HERO — split layout: image left 55%, editorial right 45%
  ═══════════════════════════════════════════════════════ -->
  <section class="gf-hero" aria-label="Homepage hero">
    <div
      class="gf-hero__image"
      role="img"
      aria-label="Bushrangers Bay, Mornington Peninsula"
      style="background-image: url('/images/sourced/home-cover.webp')"
    >
      <div class="gf-hero__image-scrim"></div>
    </div>
    <div class="gf-hero__content">
      <p class="gf-eyebrow gf-eyebrow--rust">Peninsula Insider</p>
      <h1 class="gf-hero__title">The other<br>Peninsula<br>weekend</h1>
      <p class="gf-hero__dek">Forget the drive you know. Here's the one that takes you somewhere different — past the cellar doors, through the ridge, down to the cape.</p>
      <div class="gf-hero__actions">
        <a href="/journal/" class="gf-hero__cta">Read the journal →</a>
        <a href="/explore/" class="gf-hero__cta gf-hero__cta--ghost">Explore the Peninsula</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 1 — This Weekend (cream bg)
  ═══════════════════════════════════════════════════════ -->
  {weekendEvents.length > 0 && (
    <section class="gf-section gf-section--cream">
      <div class="gf-container">
        <div class="gf-section-header">
          <div>
            <p class="gf-eyebrow gf-eyebrow--rust">On right now</p>
            <h2 class="gf-section-title">This Weekend</h2>
          </div>
          <a href="/whats-on/" class="gf-see-all">All events →</a>
        </div>
        <div class="gf-grid gf-grid--3">
          {weekendEvents.map((event) => <EventCard event={event} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════
       SECTION 2 — From the Journal: lead + 2 stack (white bg)
  ═══════════════════════════════════════════════════════ -->
  {leadArticle && (
    <section class="gf-section gf-section--white">
      <div class="gf-container">
        <div class="gf-section-header">
          <div>
            <p class="gf-eyebrow gf-eyebrow--rust">Writing worth keeping</p>
            <h2 class="gf-section-title">From the Journal</h2>
          </div>
          <a href="/journal/" class="gf-see-all">All journal →</a>
        </div>
        <div class="gf-journal-layout">
          <!-- Lead card: large image + editorial headline -->
          <a href={leadHref} class="gf-lead-card">
            {leadArticle.data.heroImage?.src && (
              <div
                class="gf-lead-card__image"
                style={`background-image: url(${leadArticle.data.heroImage.src})`}
                aria-hidden="true"
              ></div>
            )}
            <div class="gf-lead-card__body">
              <span class="gf-chip">{leadFormat}</span>
              <h3 class="gf-lead-card__title">{leadArticle.data.title}</h3>
              <p class="gf-lead-card__dek">{leadArticle.data.dek}</p>
              <span class="gf-lead-card__cta">Read →</span>
            </div>
          </a>
          <!-- Supporting stack: 2 compact article cards -->
          <div class="gf-journal-stack">
            {supportArticles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════
       SECTION 3 — Eat & Drink: 4-up venue grid (cream bg)
  ═══════════════════════════════════════════════════════ -->
  {eatVenues.length > 0 && (
    <section class="gf-section gf-section--cream">
      <div class="gf-container">
        <div class="gf-section-header">
          <div>
            <p class="gf-eyebrow gf-eyebrow--rust">Tables worth booking</p>
            <h2 class="gf-section-title">Eat &amp; Drink</h2>
          </div>
          <a href="/eat/" class="gf-see-all">All restaurants →</a>
        </div>
        <div class="gf-grid gf-grid--4">
          {eatVenues.map((venue) => (
            <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════
       MID-PAGE — Newsletter break
  ═══════════════════════════════════════════════════════ -->
  <NewsletterBlock source="layout-gf-preview" />

  <!-- ═══════════════════════════════════════════════════════
       SECTION 4 — Worth the Drive (dark bg)
  ═══════════════════════════════════════════════════════ -->
  {worthDriveFinal.length > 0 && (
    <section class="gf-section gf-section--dark">
      <div class="gf-container">
        <div class="gf-section-header">
          <div>
            <p class="gf-eyebrow gf-eyebrow--gold">Off the usual path</p>
            <h2 class="gf-section-title gf-section-title--light">Worth the Drive</h2>
          </div>
          <a href="/whats-on/" class="gf-see-all gf-see-all--light">All events →</a>
        </div>
        <div class="gf-grid gf-grid--3 gf-grid--dark-host">
          {worthDriveFinal.map((event) => <EventCard event={event} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════
       SECTION 5 — Plan Your Weekend: 3 itinerary cards (white)
  ═══════════════════════════════════════════════════════ -->
  {planCards.length > 0 && (
    <section class="gf-section gf-section--white">
      <div class="gf-container">
        <div class="gf-section-header">
          <div>
            <p class="gf-eyebrow gf-eyebrow--rust">Sequenced itineraries</p>
            <h2 class="gf-section-title">Plan Your Weekend</h2>
          </div>
          <a href="/plans/" class="gf-see-all">All plans →</a>
        </div>
        <div class="gf-grid gf-grid--3">
          {planCards.map((plan) => <ItineraryCard itinerary={plan} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════
       SECTION 6 — By Place: horizontal scroll rail (cream)
  ═══════════════════════════════════════════════════════ -->
  {placeRail.length > 0 && (
    <section class="gf-section gf-section--cream gf-section--no-overflow">
      <div class="gf-container">
        <div class="gf-section-header">
          <div>
            <p class="gf-eyebrow gf-eyebrow--rust">Know the terrain</p>
            <h2 class="gf-section-title">By Place</h2>
          </div>
          <a href="/places/" class="gf-see-all">All places →</a>
        </div>
      </div>
      <div class="gf-place-rail-wrapper">
        <div class="gf-place-rail">
          {placeRail.map((place) => (
            <PlaceCard place={place} showDetails={true} showActions={false} introMaxLength={90} />
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ─── Layout shell ────────────────────────────────────────────── */
  .gf-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }

  .gf-section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
  }

  .gf-section--cream  { background: #F5F0E8; }
  .gf-section--white  { background: #FFFFFF; }
  .gf-section--dark   { background: #1E1B18; }
  .gf-section--no-overflow { overflow: visible; }

  /* ─── Staging banner ──────────────────────────────────────────── */
  .gf-staging-bar {
    background: #1E1B18;
    color: #B69456;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.55rem clamp(1.25rem, 4vw, 2.5rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  /* ─── Typography primitives ───────────────────────────────────── */
  .gf-eyebrow {
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin: 0 0 0.6rem;
  }
  .gf-eyebrow--rust { color: #A0541F; }
  .gf-eyebrow--gold { color: #B69456; }

  /* ─── Section header ──────────────────────────────────────────── */
  .gf-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid #D9D1BE;
    padding-bottom: 1.1rem;
  }

  .gf-section-title {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: clamp(1.9rem, 3.5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #171413;
    margin: 0;
    font-variation-settings: 'opsz' 48;
  }
  .gf-section-title--light { color: #FAF7F0; }

  .gf-see-all {
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #A0541F;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    padding-bottom: 0.1rem;
    transition: color 0.2s ease;
  }
  .gf-see-all:hover { color: #171413; }
  .gf-see-all--light { color: #B69456; }
  .gf-see-all--light:hover { color: #FAF7F0; }

  /* ─── Grid systems ────────────────────────────────────────────── */
  .gf-grid {
    display: grid;
    gap: 1.75rem;
  }
  .gf-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .gf-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  @media (max-width: 1024px) {
    .gf-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .gf-grid--3,
    .gf-grid--4 { grid-template-columns: 1fr; }
  }

  /* ─── Hero — split layout ─────────────────────────────────────── */
  .gf-hero {
    display: grid;
    grid-template-columns: 55fr 45fr;
    min-height: min(86vh, 680px);
  }

  .gf-hero__image {
    position: relative;
    background-size: cover;
    background-position: center 35%;
    overflow: hidden;
  }

  .gf-hero__image-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.12), rgba(0,0,0,0.04));
  }

  .gf-hero__content {
    background: #FAF7F0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4.5rem);
  }

  .gf-hero__title {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: clamp(2.8rem, 5.5vw, 4.75rem);
    font-weight: 400;
    line-height: 0.97;
    letter-spacing: -0.03em;
    color: #171413;
    margin: 0 0 1.5rem;
    font-variation-settings: 'opsz' 72;
  }

  .gf-hero__dek {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: #3A3531;
    max-width: 42ch;
    margin: 0 0 2.25rem;
    font-variation-settings: 'opsz' 20;
  }

  .gf-hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .gf-hero__cta {
    display: inline-block;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.85rem 1.75rem;
    background: #1E1B18;
    color: #FAF7F0;
    border: 1px solid #1E1B18;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .gf-hero__cta:hover { background: #A0541F; border-color: #A0541F; }
  .gf-hero__cta--ghost {
    background: transparent;
    color: #1E1B18;
  }
  .gf-hero__cta--ghost:hover { background: #1E1B18; color: #FAF7F0; }

  @media (max-width: 900px) {
    .gf-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .gf-hero__image {
      height: 52vw;
      min-height: 260px;
      max-height: 460px;
    }
    .gf-hero__image-scrim { display: none; }
    .gf-hero__title { font-size: clamp(2.2rem, 8vw, 3.5rem); }
  }

  /* ─── Journal layout: lead + stack ───────────────────────────── */
  .gf-journal-layout {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .gf-journal-layout { grid-template-columns: 1fr; }
  }

  .gf-lead-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .gf-lead-card:hover .gf-lead-card__title { text-decoration: underline; }

  .gf-lead-card__image {
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    background-color: #D9D1BE;
    flex-shrink: 0;
    margin-bottom: 1.2rem;
  }

  .gf-lead-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .gf-chip {
    display: inline-block;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #A0541F;
    background: #F5F0E8;
    padding: 0.22rem 0.6rem;
    border-radius: 2px;
    align-self: flex-start;
  }

  .gf-lead-card__title {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #171413;
    margin: 0;
    font-variation-settings: 'opsz' 36;
  }

  .gf-lead-card__dek {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: 1rem;
    line-height: 1.6;
    color: #3A3531;
    margin: 0;
    font-variation-settings: 'opsz' 18;
  }

  .gf-lead-card__cta {
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    color: #A0541F;
    letter-spacing: 0.04em;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .gf-journal-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-left: 1px solid #D9D1BE;
    padding-left: 2.5rem;
  }

  @media (max-width: 860px) {
    .gf-journal-stack {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid #D9D1BE;
      padding-top: 2rem;
    }
  }

  /* ─── Dark section card overrides ────────────────────────────── */
  .gf-grid--dark-host :global(.event-card) {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .gf-grid--dark-host :global(.event-card__name a),
  .gf-grid--dark-host :global(.event-card__name) {
    color: #FAF7F0;
  }
  .gf-grid--dark-host :global(.event-card__category),
  .gf-grid--dark-host :global(.event-card__date) {
    color: rgba(250,247,240,0.55);
  }
  .gf-grid--dark-host :global(.event-card__place),
  .gf-grid--dark-host :global(.event-card__summary) {
    color: rgba(250,247,240,0.7);
  }
  .gf-grid--dark-host :global(.event-card__cta) {
    color: #B69456;
    border-color: rgba(182,148,86,0.4);
  }
  .gf-grid--dark-host :global(.event-card__cta:hover) {
    color: #FAF7F0;
    border-color: rgba(250,247,240,0.5);
  }

  /* ─── Place rail — horizontal scroll ─────────────────────────── */
  .gf-place-rail-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.25rem 0 0.5rem;
    margin-top: 0.5rem;
  }
  .gf-place-rail-wrapper::-webkit-scrollbar { display: none; }

  .gf-place-rail {
    display: flex;
    gap: 1.25rem;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
    width: max-content;
  }

