---
import BaseLayout from '../layouts/BaseLayout.astro';
import { editableText } from '../lib/inline-edit/attrs';
import { pageImage } from '../lib/page-images';
import editorialMethod from '../data/editorial-method.json';

export const prerender = true;

const coast = pageImage('about-hero');
const bay = pageImage('about-bay');
const methodReviewedLabel = new Date(`${editorialMethod.reviewedOn}T12:00:00Z`).toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="About Peninsula Insider"
  description="Peninsula Insider is an independent guide to the Mornington Peninsula. See what earns a recommendation, how each check works, and recent decisions with the sources behind them."
  canonical="https://peninsulainsider.com.au/about/"
  ogImage={coast.src}
>
  <article class="pi-about">
    <header class="pi-about__hero">
      <div class="container">
        <p class="pi-about__eyebrow"><span aria-hidden="true"></span> About Peninsula Insider</p>
        <div class="pi-about__hero-grid">
          <h1 {...editableText({entityType:'page',entitySlug:'about',fieldPath:'hero.title',label:'About title'})}>The Peninsula, with a point of view.</h1>
          <div class="pi-about__intro">
            <p class="pi-about__standfirst" {...editableText({entityType:'page',entitySlug:'about',fieldPath:'hero.dek',label:'About introduction'})}>We choose places worth your time, say who they suit and explain why they make the cut.</p>
            <p>A guide to eating, drinking, staying and exploring on the Mornington Peninsula.</p>
            <div class="pi-about__hero-actions">
              <a class="pi-btn pi-btn--solid" href="/explore/places/">Explore our picks</a>
              <a class="pi-about__text-link" href="#how-we-choose">Our editorial approach <span aria-hidden="true">↓</span></a>
            </div>
          </div>
        </div>
        <nav class="pi-about__jump" aria-label="On this page">
          <span>On this page</span>
          <a href="#how-we-choose">Editorial approach <span aria-hidden="true">↗</span></a>
          <a href="#independent-editorial">Our independence <span aria-hidden="true">↗</span></a>
          <a href="#keeping-current">Keeping current <span aria-hidden="true">↗</span></a>
        </nav>
        <figure class="pi-about__hero-photo">
          <img src={coast.src} alt={coast.alt} width="1280" height="710" loading="eager" decoding="async" fetchpriority="high" />
          <figcaption><span>{coast.caption}</span><span>Photography: {coast.credit}</span></figcaption>
        </figure>
      </div>
    </header>

    <section class="pi-about__method" id="how-we-choose" aria-labelledby="about-method-title">
      <div class="container pi-about__section-head">
        <p class="pi-about__eyebrow">Our editorial approach</p>
        <div>
          <h2 id="about-method-title">A reason to choose.</h2>
          <p>We look for what makes a Peninsula place distinctive, who it suits and when it works best. Our recommendations bring together official sources, local context and editorial judgement to help you plan your day.</p>
          <p>Practical details are checked against the operator or responsible authority. A source check is not a visit: we distinguish confirmed facts from our judgement and make material gaps clear. A whole-record review date shows when that check was completed, not a guarantee that nothing has changed.</p>
          <p class="pi-about__method-review"><strong>Method reviewed:</strong> <time datetime={editorialMethod.reviewedOn}>{methodReviewedLabel}</time>.</p>
        </div>
      </div>
      <div class="container">
        <h3 class="pi-about__subhead" id="what-earns-a-recommendation">What earns a recommendation</h3>
        <ol class="pi-about__questions">
          <li><span class="pi-about__number" aria-hidden="true">01</span><h4>A reason to go</h4><p>Something the place does that sets it apart on the Peninsula. A listing has to say what that is in plain words.</p></li>
          <li><span class="pi-about__number" aria-hidden="true">02</span><h4>A clear fit</h4><p>We say who it suits and when it works best. Where a place will not suit a reader, we say that too.</p></li>
          <li><span class="pi-about__number" aria-hidden="true">03</span><h4>Details that hold up</h4><p>Address, opening, booking and access details are traced to the operator or the responsible authority, not to another guide.</p></li>
          <li><span class="pi-about__number" aria-hidden="true">04</span><h4>No payment</h4><p>A business cannot buy a recommendation, a ranking or an Insider Pick. Paid work is labelled and kept apart.</p></li>
        </ol>

        <h3 class="pi-about__subhead" id="how-a-check-works">How a check works</h3>
        <ol class="pi-about__steps">
          <li><strong>Start with the source.</strong> We read the operator's own current pages: its website, booking page and published policies. For an event that is the organiser. For a park, pier or road it is the responsible authority.</li>
          <li><strong>Rank what disagrees.</strong> Where sources conflict, the operator or authority outranks listings sites, press and social posts.</li>
          <li><strong>Date the check.</strong> A checked date on a page is the day that source check was completed. It is not a visit, and it is not a promise that nothing has changed since.</li>
          <li><strong>Qualify, link or pause.</strong> If a material detail cannot be confirmed, we say so, point to the source, or take the listing down until it can be.</li>
        </ol>

        <h3 class="pi-about__subhead" id="decisions-on-the-record">Decisions on the record</h3>
        <p class="pi-about__lede">Four recent calls, with the source that settled each one.</p>
        <ul class="pi-about__decisions">
          <li><time datetime="2026-11-23">23 November 2026</time><p><strong>Tour listings withdrawn.</strong> We removed three tour listings and two operator profiles after the operators' own catalogues did not support them as bookable Peninsula trips. That is a statement about what we could confirm, not about the operators.</p></li>
          <li><time datetime="2026-11-17">17 November 2026</time><p><strong>A description corrected.</strong> Main Ridge Dairy's own site says goat tours and feeding are not currently offered, so we removed our description of animal viewing and corrected the producer guide that repeated it.</p></li>
          <li><time datetime="2026-11-17">17 November 2026</time><p><strong>A listing paused.</strong> We paused a cheese producer's listing while its current operator, location and offering are confirmed. A pause is not a claim that a business has closed.</p></li>
          <li><time datetime="2026-10-03">3 October 2026</time><p><strong>A closure reported.</strong> When Parks Victoria closed <a href="/fishing/locations/portsea-pier/">Portsea Pier</a> for maintenance, we replaced our fishing directions with a dated closure notice, the authority's link and places that were open.</p></li>
        </ul>
      </div>
    </section>

    <section class="pi-about__independence" id="independent-editorial" aria-labelledby="about-independence-title">
      <div class="container pi-about__independence-grid">
        <div>
          <p class="pi-about__eyebrow pi-about__eyebrow--light">Independent editorial</p>
          <h2 id="about-independence-title">Our judgement stays ours.</h2>
        </div>
        <div class="pi-about__independence-points">
          <div>
            <h3>Recommendations</h3>
            <p>Businesses cannot pay for a recommendation, ranking or Insider Pick.</p>
          </div>
          <div>
            <h3>Commercial work</h3>
            <p>We may work through advertising, sponsored content and partnerships. We identify that work clearly and keep it separate from our editorial choices.</p>
          </div>
          <div>
            <h3>Responsibility</h3>
            <p>Peninsula Insider was founded by <a href="https://www.linkedin.com/in/richmondjw" target="_blank" rel="me noopener noreferrer">James Richmond</a>. Our publisher is OptiFlows trading as Peninsula Insider. Our <a href="/terms/">terms</a> explain the commercial boundary, and our <a href="/partners/">partner information</a> explains how businesses can work with us.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pi-about__current" id="keeping-current" aria-labelledby="about-current-title">
      <div class="container pi-about__current-grid">
        <figure>
          <img src={bay.src} alt={bay.alt} width="2000" height="1332" loading="lazy" decoding="async" />
          <figcaption><span>{bay.caption}</span><span>Photography: {bay.credit}</span></figcaption>
        </figure>
        <div class="pi-about__current-copy">
          <p class="pi-about__eyebrow">Keeping things current</p>
          <h2 id="about-current-title">Places change. We keep checking.</h2>
          <p>Automated checks monitor public pages and source links after publication. Where a material detail cannot be confirmed, we qualify it, link to the responsible source or pause the listing. Report anything inaccurate or out of date through our correction form; it returns a case reference.</p>
          <a class="pi-about__text-link" href="/contact/?type=correction#correction">Report a correction <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="pi-about__next" aria-labelledby="about-next-title">
      <div class="container pi-about__next-grid">
        <div>
          <p class="pi-about__eyebrow">The Peninsula worth knowing</p>
          <h2 id="about-next-title">Go somewhere good next.</h2>
        </div>
        <div>
          <p>Find a place for your next day out, or let The Insider Note bring our latest picks to you.</p>
          <div class="pi-about__next-actions">
            <a class="pi-btn pi-btn--solid" href="/explore/places/">Explore places</a>
            <a class="pi-about__text-link" href="/dispatch/">Join The Insider Note <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .pi-about { color: var(--text); }
  .pi-about__hero { background: var(--bg-alt); padding: clamp(3.5rem, 6vw, 6rem) 0 clamp(3.5rem, 5vw, 5rem); }
  .pi-about__eyebrow { display: flex; align-items: center; gap: .85rem; margin: 0; color: var(--accent); font: 700 .76rem/1.4 var(--font-ui); letter-spacing: .16em; text-transform: uppercase; }
  .pi-about__eyebrow > span { width: 2rem; height: 2px; background: var(--gold-text); flex: none; }
  .pi-about__eyebrow--light { color: #c6dce9; }
  .pi-about__hero-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(19rem, .6fr); gap: clamp(2rem, 5vw, 5.5rem); align-items: end; margin-top: 2rem; }
  .pi-about__hero h1 { max-width: 12ch; margin: 0; font: 600 clamp(3.5rem, 6.5vw, 6.8rem)/1.04 var(--font-display); letter-spacing: -.035em; text-wrap: balance; }
  .pi-about__intro { padding: 0 0 .4rem clamp(1.5rem, 2.5vw, 2.75rem); border-left: 1px solid #b8c4c8; }
  .pi-about__intro p { max-width: 36ch; margin: 0; font: 400 1rem/1.65 var(--font-ui); color: var(--soft); }
  .pi-about__intro .pi-about__standfirst { margin-bottom: 1rem; color: var(--text); font: 600 clamp(1.2rem, 1.65vw, 1.55rem)/1.45 var(--font-display); letter-spacing: -.025em; }
  .pi-about__hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.3rem; margin-top: 1.5rem; }
  .pi-about__hero-actions .pi-btn { min-height: 44px; }
  .pi-about__jump { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem clamp(1.3rem, 3vw, 3rem); margin-top: clamp(3rem, 5vw, 5.5rem); padding: 1.15rem 0; border-block: 1px solid #c8d0d0; }
  .pi-about__jump > span { margin-right: auto; font: 700 .72rem/1.4 var(--font-ui); letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }
  .pi-about__jump a, .pi-about__text-link { color: var(--accent); font: 700 .95rem/1.4 var(--font-ui); text-decoration: none; text-underline-offset: .25em; display: inline-flex; align-items: center; min-height: 44px; }
  .pi-about__jump a:hover, .pi-about__text-link:hover { text-decoration: underline; }
  .pi-about__jump a { margin-inline: -.55rem; padding-inline: .55rem; border-radius: 999px; }
  .pi-about__jump a[aria-current="location"] { color: var(--text); background: #e4ecec; text-decoration: none; }
  .pi-about__jump a span, .pi-about__text-link span { display: inline-block; margin-left: .15rem; }
  .pi-about__hero-photo { margin: clamp(1.5rem, 3vw, 2.5rem) 0 0; }
  .pi-about__hero-photo img { display: block; width: 100%; height: auto; aspect-ratio: 2.15; object-fit: cover; object-position: center 55%; border-radius: .35rem; }
  .pi-about figcaption { display: flex; justify-content: space-between; gap: .5rem 1rem; margin-top: .7rem; color: var(--soft); font: 500 .78rem/1.45 var(--font-ui); }

  .pi-about__promise { background: #0b2e4a; color: #fff; padding: clamp(4rem, 6vw, 6rem) 0; }
  .pi-about__promise-grid { display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); gap: 3rem; }
  .pi-about__promise .pi-about__eyebrow { padding-top: .55rem; }
  .pi-about__promise h2 { max-width: 18ch; margin: 0; color: #fff; font: 600 clamp(2.4rem, 4.1vw, 4.7rem)/1.13 var(--font-display); letter-spacing: -.03em; text-wrap: balance; }
  .pi-about__promise p:last-child { max-width: 43ch; margin: 1.5rem 0 0; color: #d4e3ed; font: 400 clamp(1.05rem, 1.5vw, 1.3rem)/1.55 var(--font-ui); }

  .pi-about__method { padding: clamp(5rem, 8vw, 8.5rem) 0; scroll-margin-top: 8.25rem; }
  .pi-about__section-head { display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); gap: 3rem; align-items: start; }
  .pi-about__section-head .pi-about__eyebrow { padding-top: .5rem; }
  .pi-about__section-head h2, .pi-about__current h2, .pi-about__next h2 { margin: 0; font: 600 clamp(2.5rem, 4vw, 4.5rem)/1.13 var(--font-display); letter-spacing: -.03em; text-wrap: balance; }
  .pi-about__section-head > div > p:not(.pi-about__method-review) { max-width: 58ch; margin: 1.25rem 0 0; color: var(--soft); font: 400 clamp(1.1rem, 1.4vw, 1.3rem)/1.62 var(--font-ui); }
  .pi-about__subhead { margin: clamp(3.5rem, 6vw, 6rem) 0 0; font: 600 clamp(1.6rem, 2.4vw, 2.3rem)/1.2 var(--font-display); letter-spacing: -.025em; scroll-margin-top: 8.25rem; }
  .pi-about__subhead + .pi-about__questions { margin-top: 1.5rem; }
  .pi-about__steps { max-width: 68ch; margin: 1.5rem 0 0; padding-left: 1.4rem; color: var(--soft); font: 400 1.03rem/1.62 var(--font-ui); }
  .pi-about__steps li { padding: .45rem 0 .45rem .3rem; }
  .pi-about__steps strong, .pi-about__decisions strong { color: var(--text); }
  .pi-about__lede { max-width: 58ch; margin: .9rem 0 0; color: var(--soft); font: 400 1.03rem/1.62 var(--font-ui); }
  .pi-about__decisions { margin: 1.5rem 0 0; padding: 0; list-style: none; border-bottom: 1px solid #ccd6d9; }
  .pi-about__decisions li { display: grid; grid-template-columns: 11rem minmax(0, 1fr); column-gap: 2rem; padding: 1.3rem 0; border-top: 1px solid #ccd6d9; }
  .pi-about__decisions time { color: var(--gold-text); font: 700 .82rem/1.9 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; }
  .pi-about__decisions p { max-width: 62ch; margin: 0; color: var(--soft); font: 400 1.03rem/1.62 var(--font-ui); }
  .pi-about__decisions a { color: var(--accent); font-weight: 600; text-underline-offset: .2em; }
  .pi-about__questions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(3rem, 8vw, 9rem); margin: clamp(3.5rem, 6vw, 6rem) 0 0; padding: 0; list-style: none; border-bottom: 1px solid #ccd6d9; }
  .pi-about__questions li { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); column-gap: 1rem; align-content: start; padding: 1.8rem 0 2.5rem; border-top: 1px solid #ccd6d9; }
  .pi-about__number { grid-row: span 2; padding-top: .22rem; color: var(--gold-text); font: 700 .82rem/1.5 var(--font-ui); letter-spacing: .12em; }
  .pi-about__questions h3, .pi-about__questions h4 { margin: 0; font: 600 clamp(1.3rem, 2vw, 1.8rem)/1.25 var(--font-display); letter-spacing: -.02em; }
  .pi-about__questions p { grid-column: 2; max-width: 40ch; margin: .7rem 0 0; color: var(--soft); font: 400 1.03rem/1.62 var(--font-ui); }

  .pi-about__check-standard { margin-top: clamp(3rem, 5vw, 5rem); padding: clamp(2rem, 4vw, 3.5rem); color: #fff; background: #0b2e4a; border-radius: .35rem; }
  .pi-about__check-standard-head { display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); gap: 3rem; }
  .pi-about__check-standard .pi-about__eyebrow { align-self: start; padding-top: .4rem; color: #c6dce9; }
  .pi-about__check-standard h3 { max-width: 18ch; margin: 0; color: #fff; font: 600 clamp(2rem, 3.2vw, 3.5rem)/1.12 var(--font-display); letter-spacing: -.03em; }
  .pi-about__check-standard-head > div > p { max-width: 55ch; margin: 1rem 0 0; color: #d4e3ed; font: 400 1.05rem/1.62 var(--font-ui); }
  .pi-about__check-standard > ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2.5rem; margin: 2.5rem 0 0; padding: 0; list-style: none; border-bottom: 1px solid #67879b; }
  .pi-about__check-standard > ol li { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: .9rem; padding: 1.4rem 0 1.7rem; border-top: 1px solid #67879b; }
  .pi-about__check-standard > ol li > span { padding-top: .1rem; color: #f2c177; font: 700 .78rem/1.5 var(--font-ui); letter-spacing: .12em; }
  .pi-about__check-standard h4 { margin: 0; color: #fff; font: 600 1.2rem/1.3 var(--font-display); }
  .pi-about__check-standard li p { max-width: 42ch; margin: .55rem 0 0; color: #d4e3ed; font: 400 .98rem/1.6 var(--font-ui); }
  .pi-about__method-review { margin: 1.25rem 0 0; color: var(--soft); font: 500 .8rem/1.5 var(--font-ui); }

  .pi-about__example { display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); gap: 3rem; margin-top: clamp(3rem, 5vw, 5rem); padding: clamp(2rem, 4vw, 3rem); background: var(--bg-alt); border-radius: .35rem; }
  .pi-about__example .pi-about__eyebrow { align-self: start; padding-top: .4rem; }
  .pi-about__example blockquote { margin: 0; }
  .pi-about__example blockquote p { max-width: 40ch; margin: 0; font: 500 clamp(1.3rem, 2vw, 1.8rem)/1.45 var(--font-display); letter-spacing: -.02em; }
  .pi-about__example dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2rem; margin: 1.5rem 0 0; }
  .pi-about__example dl div { padding-top: .8rem; border-top: 1px solid #ccd6d9; }
  .pi-about__example dt { color: var(--accent); font: 700 .72rem/1.4 var(--font-ui); letter-spacing: .12em; text-transform: uppercase; }
  .pi-about__example dd { margin: .4rem 0 0; color: var(--soft); font: 400 .96rem/1.55 var(--font-ui); }
  .pi-about__example blockquote footer { margin-top: 1rem; }
  .pi-about__example-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; }

  .pi-about__independence { background: #123b56; color: #fff; padding: clamp(4.5rem, 7vw, 7rem) 0; scroll-margin-top: 8.25rem; }
  .pi-about__independence-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: clamp(3rem, 7vw, 8rem); }
  .pi-about__independence h2 { max-width: 13ch; margin: 1.6rem 0 0; color: #fff; font: 600 clamp(2.5rem, 4.2vw, 4.8rem)/1.1 var(--font-display); letter-spacing: -.03em; text-wrap: balance; }
  .pi-about__independence-points { border-top: 1px solid #67879b; }
  .pi-about__independence-points > div { padding: 1.3rem 0 1.6rem; border-bottom: 1px solid #67879b; }
  .pi-about__independence-points h3 { margin: 0 0 .6rem; color: #f2c177; font: 700 .78rem/1.4 var(--font-ui); letter-spacing: .14em; text-transform: uppercase; }
  .pi-about__independence-points p { max-width: 47ch; margin: 0; color: #e8f0f3; font: 400 clamp(1.05rem, 1.4vw, 1.25rem)/1.6 var(--font-ui); }
  .pi-about__independence-points a { color: #fff; text-decoration: underline; text-underline-offset: .2em; }

  .pi-about__current { background: var(--bg-alt); padding: clamp(5rem, 8vw, 8rem) 0; scroll-margin-top: 8.25rem; }
  .pi-about__current-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(3rem, 6vw, 7rem); align-items: center; }
  .pi-about__current figure { margin: 0; }
  .pi-about__current img { display: block; width: 100%; height: auto; aspect-ratio: 1.35; object-fit: cover; object-position: center; border-radius: .35rem; }
  .pi-about__current figcaption { display: block; }
  .pi-about__current figcaption span + span { display: block; }
  .pi-about__current h2 { max-width: 13ch; margin-top: 1.3rem; }
  .pi-about__current-copy > p:not(.pi-about__eyebrow) { max-width: 47ch; margin: 1.3rem 0 1.6rem; color: var(--soft); font: 400 clamp(1.1rem, 1.4vw, 1.3rem)/1.62 var(--font-ui); }
  .pi-about__current-copy p a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }

  .pi-about__next { padding: clamp(4.5rem, 7vw, 7rem) 0; }
  .pi-about__next-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: clamp(3rem, 7vw, 8rem); align-items: end; }
  .pi-about__next h2 { max-width: 13ch; margin-top: 1.25rem; }
  .pi-about__next-grid > div:last-child > p { max-width: 43ch; margin: 0 0 1.6rem; color: var(--soft); font: 400 1.15rem/1.6 var(--font-ui); }
  .pi-about__next-actions { display: flex; flex-wrap: wrap; gap: 1.2rem 1.5rem; align-items: center; }
  .pi-about__next-actions .pi-btn { min-height: 44px; }
  .pi-about a:focus-visible { outline: 3px solid #11309c; outline-offset: 4px; }

  @media (max-width: 900px) {
    .pi-about__hero-grid, .pi-about__promise-grid, .pi-about__section-head, .pi-about__check-standard-head, .pi-about__independence-grid, .pi-about__current-grid, .pi-about__next-grid { grid-template-columns: 1fr; gap: 2rem; }
    .pi-about__hero h1 { max-width: 14ch; }
    .pi-about__intro { max-width: 38rem; }
    .pi-about__hero-photo img { aspect-ratio: 1.65; }
    .pi-about__promise .pi-about__eyebrow, .pi-about__section-head .pi-about__eyebrow { padding-top: 0; }
    .pi-about__current figure { max-width: 42rem; }
  }
  @media (max-width: 640px) {
    .pi-about__hero { padding: 2.5rem 0 3.5rem; }
    .pi-about__hero-grid { gap: 1.6rem; margin-top: 1.25rem; }
    .pi-about__hero h1 { max-width: 12ch; font-size: clamp(2.8rem, 11.8vw, 4.2rem); letter-spacing: -.035em; }
    .pi-about__intro { padding: 0; border-left: 0; }
    .pi-about__intro .pi-about__standfirst { font-size: 1.2rem; }
    .pi-about__jump { gap: .9rem 1.2rem; margin-top: 2.25rem; }
    .pi-about__jump > span { flex-basis: 100%; }
    .pi-about__jump a { font-size: .88rem; }
    .pi-about__hero-photo { margin-top: 1.35rem; }
