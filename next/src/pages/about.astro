---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'About Peninsula Insider' },
];

const pillars = [
  {
    title: 'The Peninsula rewards slower attention',
    body: 'Most visits to the Peninsula are rushed. A good cellar door missed because the timing was wrong. A walk skipped because no one mentioned the conditions. A lunch chosen by default rather than by recommendation. Peninsula Insider exists to change that: arrive with better information, leave with a better weekend.',
  },
  {
    title: 'The edit, not the directory',
    body: 'We don\'t list everything. We cover what is genuinely worth your time: the cellar door with the afternoon light, the restaurant that earns a second visit, the walk that changes in winter. What we leave out matters as much as what we include.',
  },
  {
    title: 'The season is always named',
    body: 'The Peninsula in June is a different place from the Peninsula in January. Different conditions, different crowds, different things worth doing. Our verdicts shift with the season because the region does.',
  },
  {
    title: 'Editorial judgement over algorithmic ranking',
    body: 'Every recommendation reflects research and an editor\'s honest opinion. A venue appears because it earned a place, not because it submitted a form, paid for placement, or has the most reviews.',
  },
];
export const prerender = true;
---

<BaseLayout
  title="About Peninsula Insider"
  description="Peninsula Insider is the opinionated guide to the Mornington Peninsula. Every pick earns its place. Every verdict has a reason."
  section="home"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="About Peninsula Insider"
    title="The opinionated guide to the <em>Mornington Peninsula.</em>"
    dek="For readers who want to spend their weekend well. Specific, considered, and current. Every pick earns its place. Every verdict has a reason."
    gradient="journal"
    heroImage="/images/sourced/home-cover-back-beach-horses-01.jpg"
    visualLabel="Peninsula Insider · the back beach"
    entitySlug="about"
  />

  <!-- Why PI exists -->
  <section class="about-mission">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Why we exist</p>
          <h2 class="about-mission__title">A point of view, not a directory.</h2>
        </div>
        <div class="about-mission__body prose">
          <p>The Mornington Peninsula has more than two hundred cellar doors, more hatted restaurants per kilometre than anywhere outside inner Melbourne, and a coastline that changes character four times in forty minutes of driving. It rewards people who know where to look and when.</p>
          <p>The tourism boards can't rank one operator over another. The Melbourne mastheads often treat the Peninsula as a section, not a beat. Peninsula Insider was built as a publication focused on the region, with researched guidance on where to go, what to book and what to know before a visit.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What makes it different -->
  <section class="about-principles">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">How we work</p>
          <h2 class="split-intro__title">A different kind of Peninsula guide.</h2>
        </div>
        <p class="split-intro__body">Four things that shape how Peninsula Insider works, and why it's more useful than a list.</p>
      </div>
      <div class="about-principles__grid">
        {pillars.map((p) => (
          <article class="about-principle">
            <h3 class="about-principle__title">{p.title}</h3>
            <p class="about-principle__body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards -->
  <section class="about-mission">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Standards</p>
          <h2 class="about-mission__title">The verdict is the product.</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider makes calls. We rank, we pick, and we say when something is overrated, because a guide that treats every option as equally lovely isn't a guide. That only works if the standards behind the verdicts hold: recommendations are researched and editorially judged, commercial relationships are always labelled, and broad price guidance is used where it helps while operators remain the source for live prices.</p>
          <p>The full version, including how partner content is firewalled from editorial and how corrections work, is set out in <a href="/editorial-approach/">our editorial approach</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Publication identity -->
  <section class="about-colophon">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">The publication</p>
          <h2 class="about-mission__title">Independent. Editorially led. Local.</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider is independently founded and editorially led with a sustained focus on the Mornington Peninsula. Coverage is shaped by research, editorial review, seasonal openings and changing local conditions.</p>
          <p><em>The Insider Note</em> is the publication's weekly email: curated Peninsula weekends, seasonal verdicts, and what is worth knowing before you plan. <a href="/dispatch/">Read The Insider Note.</a></p>
          <p>Spotted an error? Write to <a href="mailto:corrections@peninsulainsider.com.au">corrections@peninsulainsider.com.au</a> and we fix fast.</p>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock
    body="Seasonal verdicts, curated weekends, and what's worth your time on the Mornington Peninsula."
    sub="The Peninsula worth knowing. Weekly. What's on, where we'd go and what's worth knowing next."
  />
</BaseLayout>
