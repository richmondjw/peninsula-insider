---
import BaseLayout from '../layouts/BaseLayout.astro';
import { editableText } from '../lib/inline-edit/attrs';
export const prerender = true;
---
<BaseLayout title="About Peninsula Insider" description="The opinionated guide to the Mornington Peninsula. Specific, considered and current." canonical="https://peninsulainsider.com.au/about/">
  <article class="about-page container">
    <header><h1 {...editableText({entityType:'page',entitySlug:'about',fieldPath:'hero.title',label:'About title'})}>About Peninsula Insider</h1><p class="standfirst" {...editableText({entityType:'page',entitySlug:'about',fieldPath:'hero.dek',label:'About introduction'})}>The opinionated guide to the Mornington Peninsula. Specific, considered and current.</p></header>
    <section><h2>A point of view, not a directory</h2><p>We curate the places worth knowing on the Mornington Peninsula. Every pick earns its place. Every verdict has a reason.</p></section>
    <section><h2>How we choose</h2><p>Research, local knowledge and editorial judgement guide our choices. We consider whether a place is worth your time, who it suits, the value and experience it offers, and when to go.</p></section>
    <section id="independent-editorial"><h2>Independent editorial</h2><p>Businesses cannot pay for a recommendation, ranking or Insider Pick. We may work commercially through advertising, sponsored content and partnerships. Commercial content is clearly identified and kept separate from our editorial choices.</p></section>
    <section><h2>Keeping things current</h2><p>Places change. If something is inaccurate or out of date, tell us what needs fixing.</p><a class="pi-btn pi-btn--ghost" href="/contact/?type=correction#correction">Report a correction</a></section>
    <section><h2>The Peninsula worth knowing.</h2><a class="pi-btn pi-btn--solid" href="/dispatch/">Join The Insider Note</a></section>
  </article>
</BaseLayout>
<style>
  .about-page { max-width: 52rem; padding-block: clamp(3rem, 6vw, 5rem); }
  h1 { font: 500 clamp(2.5rem, 6vw, 4.2rem)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 1.5rem; }
  .standfirst { font: 500 1.4rem/1.5 var(--font-display); }
  section { margin-top: 3rem; }
  h2 { font: 500 1.8rem/1.2 var(--font-display); margin: 0 0 .8rem; }
  p { max-width: 68ch; line-height: 1.7; }
</style>
