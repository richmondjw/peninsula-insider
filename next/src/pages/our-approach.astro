---
/**
 * /our-approach/ — replaces /editorial-approach/
 *
 * Philosophy of recommendation. How PI chooses what to cover, how trust
 * is protected, how partnerships are handled. Written for readers, not
 * the media industry.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Our Approach' },
];

const selectionPrinciples = [
  {
    title: 'Worth your time, not just worth knowing about',
    body: 'We ask one question before covering anything: is this worth a Saturday? If the answer is unclear, it doesn\'t appear. Volume isn\'t the goal.',
  },
  {
    title: 'Firsthand, or not at all',
    body: 'Recommendations reflect genuine visits and firsthand experience. Where something is included from a public listing or event submission, we say so. The reader should always know which is which.',
  },
  {
    title: 'Selective by design',
    body: 'Not every good venue appears. We choose what adds real value to a Peninsula experience — a place that earns a return visit, rewards the drive, or changes what the day feels like. Leaving things out is part of the editorial judgement.',
  },
  {
    title: 'Seasonal and revisited',
    body: 'The Peninsula changes with the weather, the calendar, and the time of day. Recommendations are updated when conditions change — not just published once and forgotten. A good cellar door in summer might be a different experience in winter.',
  },
];

const trustPrinciples = [
  {
    title: 'Editorial recommendations are not for sale',
    body: 'A venue appears in PI coverage because we think readers should know about it. Paid partnerships do not direct editorial rankings, coverage decisions, or recommendation language. The two are kept separate.',
  },
  {
    title: 'Partnerships are disclosed',
    body: 'Where content forms part of a commercial relationship, it is clearly labelled. Readers should always know when they\'re reading paid content. We don\'t obscure that line.',
  },
  {
    title: 'We pay our own way',
    body: 'Meals, accommodation, cellar door visits — we pay for our own. When a venue offers a complimentary experience and it influences coverage, we say so. The moment that becomes unclear, the coverage stops being useful.',
  },
  {
    title: 'Kept current',
    body: 'An outdated guide sends readers to closed venues, wrong hours, and changed menus — which defeats the purpose entirely. We update when things change, and we welcome corrections. Fix-fast is a standing commitment.',
  },
];
export const prerender = true;
---

<BaseLayout
  title="Our Approach · Peninsula Insider"
  description="How Peninsula Insider selects recommendations, protects editorial independence, and handles partnerships — a philosophy of recommendation, not an industry document."
  section="home"
  canonical="https://peninsulainsider.com.au/our-approach/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Our Approach"
    title="A philosophy of <em>recommendation.</em>"
    dek="How Peninsula Insider decides what is worth covering, how editorial independence is protected, and how commercial relationships are handled."
    gradient="journal"
    heroImage="/images/sourced/article-long-lunch-01.webp"
    visualLabel="Peninsula Insider · long lunch, the Peninsula"
  />

  <!-- Selection philosophy -->
  <section class="about-mission">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">How we choose</p>
          <h2 class="about-mission__title">Curated intentionally, not comprehensively.</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider doesn't try to cover everything. It covers what is genuinely worth your time — the places, experiences, and moments that make a Peninsula weekend feel well-spent rather than well-researched.</p>
          <p>That means leaving things out. A venue that is technically good but doesn't add something to the Peninsula experience won't appear. The editorial question is always: <em>what should someone actually do with their Saturday?</em></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Selection principles -->
  <section class="about-principles">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">Selection</p>
          <h2 class="split-intro__title">Four principles behind what appears.</h2>
        </div>
      </div>
      <div class="about-principles__grid">
        {selectionPrinciples.map((p) => (
          <article class="about-principle">
            <h3 class="about-principle__title">{p.title}</h3>
            <p class="about-principle__body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust principles -->
  <section class="about-principles" style="background: var(--bg-alt);">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">Trust</p>
          <h2 class="split-intro__title">Why readers can rely on what they find here.</h2>
        </div>
      </div>
      <div class="about-principles__grid">
        {trustPrinciples.map((p) => (
          <article class="about-principle">
            <h3 class="about-principle__title">{p.title}</h3>
            <p class="about-principle__body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Partnerships note -->
  <section class="about-mission">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Partnerships</p>
          <h2 class="about-mission__title">Commercial alignment, not commercial capture.</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider works with a small number of Peninsula businesses whose quality, atmosphere, and values genuinely align with the editorial. Partnerships allow businesses to reach readers who are already planning a Peninsula visit — through a guide those readers trust.</p>
          <p>Partnership placements are clearly labelled. They sit alongside editorial content but do not direct it. Editorial recommendations and rankings remain guided by relevance, quality, and honest judgement — not by commercial relationships.</p>
          <p>For businesses interested in working with Peninsula Insider, see <a href="/partners/">Partner with us</a>.</p>
          <p>Questions about this approach? Write to <a href="mailto:hello@peninsulainsider.com.au">hello@peninsulainsider.com.au</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock
    body="Seasonal recommendations, curated discoveries, and what's worth your time on the Mornington Peninsula."
    sub="Curated and sent occasionally by Peninsula Insider."
  />
</BaseLayout>
