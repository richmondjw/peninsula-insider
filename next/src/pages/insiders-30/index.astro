---
/**
 * /insiders-30/ - landing for the most-recent year (Phase 6 WS6C).
 *
 * Renders the top entry in the insidersThirty content collection by
 * year (descending). Each rank surfaces with editor blurb, hero, and
 * link to the canonical detail page (venue / experience / place).
 *
 * Per-year archives live at /insiders-30/<year>/. The map view at
 * /insiders-30/map/ pins the 30 against the Peninsula geography.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/SectionHero.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { routeSlug, venueHrefPrefix } from '../../lib/editorial';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';

const lists = (await getCollection('insidersThirty'))
  .filter((entry) => !entry.data.sitemapExclude)
  .sort((a, b) => b.data.year - a.data.year);

const currentList = lists[0];
if (!currentList) {
  throw new Error('No Insider\'s 30 list found in the content collection.');
}

const sortedPicks = [...currentList.data.picks].sort((a, b) => a.rank - b.rank);

/**
 * Hydrate each pick into its corresponding content entry. Drops picks
 * whose reference is missing rather than 404'ing the whole page.
 */
type Hydrated = {
  rank: number;
  blurb: string;
  category?: string;
  kind: 'venue' | 'experience' | 'place' | 'unknown';
  href: string;
  name: string;
  hero: string;
  meta: string;
};

const hydrated: Hydrated[] = [];
for (const pick of sortedPicks) {
  let entry: any = null;
  let kind: Hydrated['kind'] = 'unknown';
  let href = '#';
  let meta = '';

  if (pick.venue) {
    entry = await getEntry(pick.venue).catch(() => null);
    if (entry) {
      kind = 'venue';
      const slug = routeSlug(entry);
      href = `${venueHrefPrefix(entry.data.type)}/${slug}/`;
      const placeId = typeof entry.data.place === 'string' ? entry.data.place : entry.data.place?.id ?? '';
      const placeLabel = String(placeId).replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
      meta = [entry.data.priceBand, placeLabel].filter(Boolean).join(' · ');
    }
  } else if (pick.experience) {
    entry = await getEntry(pick.experience).catch(() => null);
    if (entry) {
      kind = 'experience';
      const slug = routeSlug(entry);
      href = `/explore/${slug}/`;
      meta = entry.data.type ?? 'Experience';
    }
  } else if (pick.place) {
    entry = await getEntry(pick.place).catch(() => null);
    if (entry) {
      kind = 'place';
      const slug = routeSlug(entry);
      href = `/explore/places/${slug}/`;
      meta = 'Peninsula place';
    }
  }

  if (!entry) continue;

  const hero = (kind === 'venue' || kind === 'experience' || kind === 'place')
    ? (await resolveHero(kind, routeSlug(entry), entry.data)).src
    : '';

  hydrated.push({
    rank: pick.rank,
    blurb: pick.blurb,
    category: pick.category,
    kind,
    href,
    name: entry.data.name,
    hero,
    meta,
  });
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "The Insider's 30" },
];

const yearsForArchive = lists.map((l) => l.data.year);
export const prerender = true;
---

<BaseLayout
  title={`The Insider's 30, ${currentList.data.year} · Peninsula Insider`}
  description={`Thirty venues across the Mornington Peninsula that defined ${currentList.data.year}. Cross-category, ranked, editor-selected.`}
  section="explore"
  canonical="https://peninsulainsider.com.au/insiders-30/"
  ogImage={currentList.data.heroImage?.src}
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow={`The Insider's 30 · ${currentList.data.year}`}
    subEyebrow="Annual editorial"
    title="Thirty places that <em>defined</em> the Peninsula this year."
    dek={currentList.data.editorialFraming}
    gradient="journal"
    heroImage={currentList.data.heroImage?.src}
    visualLabel={currentList.data.heroImage?.alt ?? `Peninsula Insider · The Insider's 30, ${currentList.data.year}`}
  entitySlug="insiders-30"
  />

  <section class="insiders-30">
    <div class="container">
      {currentList.data.editorsLetter && (
        <aside class="insiders-30__letter">
          <p class="label label--accent">Editor's letter</p>
          <p class="insiders-30__letter-body">{currentList.data.editorsLetter}</p>
        </aside>
      )}

      <div class="insiders-30__meta">
        <p class="insiders-30__meta-line">
          <strong>{hydrated.length}</strong> picks · cross-category · editor-selected · no paid placement, ever
          · <a href="/insiders-30/map/">view on the map</a>
          {yearsForArchive.length > 1 && (
            <>
              · archive: {yearsForArchive.slice(1).map((y, i) => (
                <>
                  <a href={`/insiders-30/${y}/`}>{y}</a>{i < yearsForArchive.length - 2 ? ', ' : ''}
                </>
              ))}
            </>
          )}
        </p>
      </div>

      <ol class="insiders-30__list">
        {hydrated.map((p) => (
          <li class={`insiders-30-pick insiders-30-pick--${p.category ?? p.kind}`} data-pick-rank={p.rank}>
            <a href={p.href} class="insiders-30-pick__link">
              <div class="insiders-30-pick__rank-block">
                <span class="insiders-30-pick__rank">{String(p.rank).padStart(2, '0')}</span>
                {p.category && <span class={`insiders-30-pick__category insiders-30-pick__category--${p.category}`}>{p.category}</span>}
              </div>
              {p.hero && <div class="insiders-30-pick__hero" style={`background-image:url(${p.hero})`} aria-hidden="true"></div>}
              <div class="insiders-30-pick__body">
                <h2 class="insiders-30-pick__name">{p.name}</h2>
                {p.meta && <p class="insiders-30-pick__meta">{p.meta}</p>}
                <p class="insiders-30-pick__blurb">{p.blurb}</p>
              </div>
              <span class="insiders-30-pick__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <p class="insiders-30__refresh">
        The list refreshes the first weekend of May each year. Subscribe to the Peninsula This Weekend dispatch and you'll be the first to read the {currentList.data.year + 1} list.
      </p>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  .insiders-30 {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .insiders-30__letter {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    padding: 1.25rem 1.4rem;
    border-left: 3px solid var(--accent);
    background: var(--paper, #fbf7f0);
    max-width: 720px;
  }
  .insiders-30__letter p.label { margin-bottom: 0.5rem; }
  .insiders-30__letter-body {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--text);
    margin: 0;
  }

  .insiders-30__meta {
    margin: 0 0 clamp(1.5rem, 3vw, 2rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .insiders-30__meta-line {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--soft);
    margin: 0;
  }
  .insiders-30__meta-line strong { color: var(--accent); }
  .insiders-30__meta-line a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .insiders-30__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 1.5vw, 1.1rem);
  }

  .insiders-30-pick {
    margin: 0;
    padding: 0;
  }
  .insiders-30-pick__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(0.85rem, 1.8vw, 1.4rem);
    align-items: center;
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid var(--border);
    background: var(--bg, #fff);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  @media (min-width: 720px) {
    .insiders-30-pick__link {
      grid-template-columns: auto 120px 1fr auto;
    }
  }
  .insiders-30-pick__link:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 12px 24px -16px rgba(14, 40, 34, 0.25);
  }

  .insiders-30-pick__rank-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 3rem;
  }
  .insiders-30-pick__rank {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .insiders-30-pick__category {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--border);
    color: var(--soft);
    border-radius: 999px;
    white-space: nowrap;
  }
  .insiders-30-pick__category--eat        { color: #2cb192; border-color: rgba(44, 177, 146, 0.35); }
  .insiders-30-pick__category--wine       { color: #7b1e3c; border-color: rgba(123, 30, 60, 0.35); }
  .insiders-30-pick__category--stay       { color: #4a6a4f; border-color: rgba(74, 106, 79, 0.35); }
  .insiders-30-pick__category--experience { color: #2f6e8a; border-color: rgba(47, 110, 138, 0.35); }
  .insiders-30-pick__category--wellness   { color: #6c4e7d; border-color: rgba(108, 78, 125, 0.35); }
  .insiders-30-pick__category--walk       { color: #4a6a4f; border-color: rgba(74, 106, 79, 0.35); }
  .insiders-30-pick__category--beach      { color: #2f6e8a; border-color: rgba(47, 110, 138, 0.35); }
  .insiders-30-pick__category--place      { color: #2c6b5c; border-color: rgba(44, 107, 92, 0.35); }
  .insiders-30-pick__category--producer   { color: #2cb192; border-color: rgba(44, 177, 146, 0.35); }
  .insiders-30-pick__category--event      { color: #2f6e8a; border-color: rgba(47, 110, 138, 0.35); }

  .insiders-30-pick__hero {
    display: none;
  }
  @media (min-width: 720px) {
    .insiders-30-pick__hero {
      display: block;
      width: 120px;
      aspect-ratio: 4 / 3;
      background-size: cover;
      background-position: center;
      background-color: var(--paper, #fbf7f0);
    }
  }

  .insiders-30-pick__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .insiders-30-pick__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.55rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0;
  }
  .insiders-30-pick__meta {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0;
  }
  .insiders-30-pick__blurb {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--dark);
    margin: 0;
  }

  .insiders-30-pick__arrow {
    font-family: var(--font-ui);
    font-size: 1.15rem;
    color: var(--soft);
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .insiders-30-pick__link:hover .insiders-30-pick__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .insiders-30__refresh {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--soft);
    text-align: center;
  }
</style>
