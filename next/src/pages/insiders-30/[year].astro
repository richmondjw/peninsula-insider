---
/**
 * /insiders-30/<year>/ — per-year archive page (Phase 6 WS6C).
 *
 * Same renderer as /insiders-30/ but locked to the requested year.
 * Each year stays at a permanent URL after the next year's list
 * supersedes it on the landing page.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/SectionHero.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { routeSlug, venueHrefPrefix, resolveHeroSrc } from '../../lib/editorial';

export async function getStaticPaths() {
  const lists = await getCollection('insidersThirty');
  return lists.map((list) => ({
    params: { year: String(list.data.year) },
    props: { list },
  }));
}

const { list } = Astro.props;
const sortedPicks = [...list.data.picks].sort((a, b) => a.rank - b.rank);

type Hydrated = {
  rank: number;
  blurb: string;
  category?: string;
  kind: 'venue' | 'experience' | 'place' | 'unknown';
  href: string;
  name: string;
  hero: string;
  meta: string;
};

const hydrated: Hydrated[] = [];
for (const pick of sortedPicks) {
  let entry: any = null;
  let kind: Hydrated['kind'] = 'unknown';
  let href = '#';
  let meta = '';

  if (pick.venue) {
    entry = await getEntry(pick.venue).catch(() => null);
    if (entry) {
      kind = 'venue';
      const slug = routeSlug(entry);
      href = `${venueHrefPrefix(entry.data.type)}/${slug}/`;
      const placeId = typeof entry.data.place === 'string' ? entry.data.place : entry.data.place?.id ?? '';
      const placeLabel = String(placeId).replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
      meta = [entry.data.priceBand, placeLabel].filter(Boolean).join(' · ');
    }
  } else if (pick.experience) {
    entry = await getEntry(pick.experience).catch(() => null);
    if (entry) {
      kind = 'experience';
      href = `/explore/${routeSlug(entry)}/`;
      meta = entry.data.type ?? 'Experience';
    }
  } else if (pick.place) {
    entry = await getEntry(pick.place).catch(() => null);
    if (entry) {
      kind = 'place';
      href = `/places/${routeSlug(entry)}/`;
      meta = 'Peninsula place';
    }
  }

  if (!entry) continue;

  hydrated.push({
    rank: pick.rank,
    blurb: pick.blurb,
    category: pick.category,
    kind,
    href,
    name: entry.data.name,
    hero: resolveHeroSrc(entry.data),
    meta,
  });
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "The Insider's 30", href: '/insiders-30/' },
  { label: String(list.data.year) },
];
export const prerender = true;
---

<BaseLayout
  title={`The Insider's 30, ${list.data.year} · Peninsula Insider`}
  description={`The ${list.data.year} edition of The Insider's 30 — thirty venues that defined the Mornington Peninsula that year.`}
  section="explore"
  canonical={`https://peninsulainsider.com.au/insiders-30/${list.data.year}/`}
  ogImage={list.data.heroImage?.src}
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow={`The Insider's 30 · Archive · ${list.data.year}`}
    subEyebrow="Annual editorial"
    title={`Thirty places that defined ${list.data.year}.`}
    dek={list.data.editorialFraming}
    gradient="journal"
    heroImage={list.data.heroImage?.src}
    visualLabel={list.data.heroImage?.alt ?? `Peninsula Insider · The Insider's 30, ${list.data.year}`}
  />

  <section class="insiders-30">
    <div class="container">
      {list.data.editorsLetter && (
        <aside class="insiders-30__letter">
          <p class="label label--accent">Editor's letter</p>
          <p class="insiders-30__letter-body">{list.data.editorsLetter}</p>
        </aside>
      )}

      <ol class="insiders-30__list">
        {hydrated.map((p) => (
          <li class={`insiders-30-pick insiders-30-pick--${p.category ?? p.kind}`} data-pick-rank={p.rank}>
            <a href={p.href} class="insiders-30-pick__link">
              <div class="insiders-30-pick__rank-block">
                <span class="insiders-30-pick__rank">{String(p.rank).padStart(2, '0')}</span>
                {p.category && <span class={`insiders-30-pick__category insiders-30-pick__category--${p.category}`}>{p.category}</span>}
              </div>
              {p.hero && <div class="insiders-30-pick__hero" style={`background-image:url(${p.hero})`} aria-hidden="true"></div>}
              <div class="insiders-30-pick__body">
                <h2 class="insiders-30-pick__name">{p.name}</h2>
                {p.meta && <p class="insiders-30-pick__meta">{p.meta}</p>}
                <p class="insiders-30-pick__blurb">{p.blurb}</p>
              </div>
              <span class="insiders-30-pick__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <p class="insiders-30__archive-back">
        <a href="/insiders-30/">→ See the latest list</a>
      </p>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* Reuses the styles from the landing page; archive page mirrors layout. */
  .insiders-30 { padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2rem, 4vw, 3rem); }
  .insiders-30__letter { margin: 0 0 clamp(1.5rem, 3vw, 2.25rem); padding: 1.25rem 1.4rem; border-left: 3px solid var(--accent); background: var(--paper, #fbf7f0); max-width: 720px; }
  .insiders-30__letter p.label { margin-bottom: 0.5rem; }
  .insiders-30__letter-body { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.1rem; line-height: 1.55; color: var(--text); margin: 0; }
  .insiders-30__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(0.85rem, 1.5vw, 1.1rem); }
  .insiders-30-pick { margin: 0; padding: 0; }
  .insiders-30-pick__link { display: grid; grid-template-columns: auto 1fr auto; gap: clamp(0.85rem, 1.8vw, 1.4rem); align-items: center; padding: clamp(1rem, 2vw, 1.4rem); border: 1px solid var(--border); background: var(--bg, #fff); text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease; }
  @media (min-width: 720px) { .insiders-30-pick__link { grid-template-columns: auto 120px 1fr auto; } }
  .insiders-30-pick__link:hover { border-color: var(--accent); transform: translateY(-1px); box-shadow: 0 12px 24px -16px rgba(40, 28, 14, 0.25); }
  .insiders-30-pick__rank-block { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; min-width: 3rem; }
  .insiders-30-pick__rank { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.85rem, 4vw, 2.6rem); font-weight: 500; color: var(--accent); letter-spacing: -0.02em; line-height: 1; }
  .insiders-30-pick__category { font-family: 'Outfit', sans-serif; font-size: 0.62rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.2rem 0.45rem; border: 1px solid var(--border); color: var(--soft); border-radius: 999px; white-space: nowrap; }
  .insiders-30-pick__hero { display: none; }
  @media (min-width: 720px) { .insiders-30-pick__hero { display: block; width: 120px; aspect-ratio: 4 / 3; background-size: cover; background-position: center; background-color: var(--paper, #fbf7f0); } }
  .insiders-30-pick__body { min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .insiders-30-pick__name { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.25rem, 2.5vw, 1.55rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; margin: 0; }
  .insiders-30-pick__meta { font-family: 'Outfit', sans-serif; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--soft); margin: 0; }
  .insiders-30-pick__blurb { font-family: 'Outfit', sans-serif; font-size: 0.95rem; line-height: 1.55; margin: 0; }
  .insiders-30-pick__arrow { font-family: 'Outfit', sans-serif; font-size: 1.15rem; color: var(--soft); }
  .insiders-30__archive-back { margin-top: clamp(2rem, 4vw, 3rem); padding-top: 1.5rem; border-top: 1px dashed var(--border); text-align: center; }
  .insiders-30__archive-back a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; font-family: 'Outfit', sans-serif; font-size: 0.92rem; }
</style>
