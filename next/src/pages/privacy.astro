---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PortableTextBody from '../components/PortableTextBody.astro';
import { fetchLegalPageFromSanity, formatLegalDate } from '../lib/sanity/legal-page-adapter';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Privacy' },
];

export const prerender = true;

const sanityPage = await fetchLegalPageFromSanity('privacy');

const title       = sanityPage?.title       ?? 'Privacy Policy';
const eyebrow     = sanityPage?.eyebrow     ?? 'Privacy';
const seoDesc     = sanityPage?.seoDescription ?? 'How Peninsula Insider collects, stores, and uses your data. Short version: barely any, and never sold.';
const lastUpdated = sanityPage?.lastUpdated  ? formatLegalDate(sanityPage.lastUpdated) : '15 May 2026';
const hasBody     = (sanityPage?.body?.length ?? 0) > 0;
---

<BaseLayout
  title={`${title}  -  Peninsula Insider`}
  description={seoDesc}
  section="home"
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="legal">
    <div class="container">
      <div class="legal__header">
        <p class="label label--accent">{eyebrow}</p>
        <h1 class="legal__title">{title}</h1>
        <p class="legal__updated">Last updated: {lastUpdated}</p>
      </div>

      <div class="legal__body prose">
        {hasBody ? (
          <PortableTextBody blocks={sanityPage!.body} />
        ) : (
          <>
            <p>Peninsula Insider is an independent editorial publication. We don't run display ads, we don't sell data, and we don't use third-party trackers. This policy explains the small amount of data we do collect and what happens to it.</p>

            <h2>What we collect</h2>

            <h3>Publication subscribers</h3>
            <p>When you subscribe to <em>The Insider</em>, we collect your <strong>email address</strong>. That's it. We don't ask for your name, location, or anything else. Your email is stored with our email service provider and used solely to send you editorial editions.</p>

            <h3>Contact form and email</h3>
            <p>If you email us  -  story tips, corrections, editorial enquiries  -  we receive whatever you choose to send. We store those emails in our editorial inbox and use them only for the purpose you wrote to us about. We don't add you to any mailing list unless you separately subscribe.</p>
            <p>If you submit a Peninsula Day, story, photograph or editorial contribution to Peninsula Insider, you retain ownership of your content but grant us permission to review, store and potentially feature it within Peninsula Insider editorial coverage.</p>

            <h3>Analytics</h3>
            <p>We use privacy-respecting, cookie-free analytics to understand which pages are read and how visitors find the site. This data is aggregated and anonymous  -  we cannot identify individual visitors. No personal data is collected through analytics.</p>

            <h2>What we don't collect</h2>
            <ul>
              <li>We don't use cookies for tracking or advertising.</li>
              <li>We don't run retargeting pixels or build user profiles.</li>
              <li>We don't share, sell, or rent your email address to anyone, ever.</li>
            </ul>

            <h2>Third-party services</h2>
            <p>The site is hosted on <strong>GitHub Pages</strong>. Fonts are served by <strong>Google Fonts</strong>, which may log standard server request data (IP address, browser type) as described in <a href="https://developers.google.com/fonts/faq/privacy">Google's Fonts privacy FAQ</a>. We have no access to that data.</p>
            <p>Publication email delivery is handled by our email service provider, which processes your email address under a data-processing agreement with us. Your email is not shared with other clients or used for any purpose beyond delivering editorial editions.</p>

            <h2>Affiliate and referral links</h2>
            <p>Some Peninsula Insider pages may contain affiliate or referral links. Where this occurs, Peninsula Insider may earn a commission at no additional cost to the reader.</p>

            <h2>Your rights</h2>
            <p>You can <strong>unsubscribe</strong> from The Insider at any time using the link at the bottom of every email. Once unsubscribed, your email address is removed from our active list.</p>
            <p>If you'd like us to delete any data we hold about you  -  including past emails you've sent us  -  write to <a href="mailto:hello@peninsulainsider.com.au">hello@peninsulainsider.com.au</a> and we'll action it within 30 days.</p>

            <h2>Australian Privacy Act</h2>
            <p>Peninsula Insider complies with the Australian Privacy Principles (APPs) under the <em>Privacy Act 1988</em> (Cth). We are a small publication and the data we collect is minimal, but we take the obligations seriously.</p>

            <h2>Changes to this policy</h2>
            <p>If we change this policy in any material way, we'll note the update date at the top of this page and, where practical, mention it in The Insider. We won't retroactively weaken your protections without consent.</p>

            <h2>Contact</h2>
            <p>Questions about this policy: <a href="mailto:hello@peninsulainsider.com.au">hello@peninsulainsider.com.au</a></p>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
