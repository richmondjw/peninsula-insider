---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import V2ArticleDetail from '../../../components/v2/V2ArticleDetail.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../../lib/editorial';

export async function getStaticPaths() {
  const STATIC_V2_JOURNAL_OVERRIDES = new Set(['free-things-to-do-mornington-peninsula']);
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles
    .filter((article) => !STATIC_V2_JOURNAL_OVERRIDES.has(routeSlug(article)))
    .map((article) => ({
      params: { slug: routeSlug(article) },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allArticles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const related = allArticles
  .filter((entry) => routeSlug(entry) !== routeSlug(article))
  .filter((entry) => {
    if (entry.data.format === article.data.format) return true;
    return entry.data.tags?.some((tag: string) => article.data.tags?.includes(tag));
  })
  .slice(0, 3);

const fallback = allArticles
  .filter((entry) => routeSlug(entry) !== routeSlug(article))
  .slice(0, 3);

const relatedFinal = related.length >= 2 ? related : fallback;
export const prerender = true;
---
<BaseLayout
  title={`${article.data.title} — Peninsula Insider`}
  description={article.data.excerpt}
  section="journal"
  ogImage={article.data.heroImage?.src}
>
  <V2ArticleDetail article={article} Content={Content} related={relatedFinal} />
  <NewsletterBlock />
</BaseLayout>
