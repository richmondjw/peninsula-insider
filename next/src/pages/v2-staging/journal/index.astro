---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { formatLabel, routeSlug } from '../../../lib/editorial';

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const featuredSlug = featured ? routeSlug(featured) : null;
const latest = articles.filter((article) => routeSlug(article) !== featuredSlug);
const rest = latest;

const pickSlugs = [
  'the-sorrento-weekend',
  'the-market-saturday',
  'the-peninsula-beach-swimming-guide',
];
const picks = pickSlugs
  .map((slug) => rest.find((article) => routeSlug(article) === slug))
  .filter((article): article is NonNullable<typeof article> => Boolean(article));

const formatOrder: Array<{ key: string; title: string; intro: string }> = [
  {
    key: 'weekend-picker',
    title: 'Weekend Picker',
    intro: 'Our Wednesday 6pm Peninsula This Weekend dispatches: one pick, one weather-proof backup, one thing to skip.',
  },
  {
    key: 'service',
    title: 'Service pieces',
    intro: 'Useful before you book. Weekend shapes, rainy-day plans, family trips, and the questions readers actually ask.',
  },
  {
    key: 'long-lunch-list',
    title: 'Long lunch lists',
    intro: 'The daylight-dining playbook. Which tables earn the drive and which do not.',
  },
  {
    key: 'cellar-door-dispatch',
    title: 'Cellar door dispatches',
    intro: 'The producers worth the appointment, the wines worth the cellar, and the arguments happening in the vines.',
  },
  {
    key: 'stay-notes',
    title: 'Stay notes',
    intro: 'The rooms, cottages, and villas that change the shape of a weekend.',
  },
  {
    key: 'insider-edit',
    title: 'Insider edits',
    intro: 'Shortlists with a point of view — the places locals rotate through, not the ones brochures push.',
  },
  {
    key: 'slow-peninsula',
    title: 'Slow Peninsula',
    intro: 'Field notes from the quieter end of the region. Weather, light, time, and the pieces no one is rushing.',
  },
  {
    key: 'editors-letter',
    title: "Editor's letters",
    intro: 'Where the issue is framed — what changed, what matters, what to read first.',
  },
  {
    key: 'interview',
    title: 'Interviews',
    intro: 'Long-form conversations with the people building the Peninsula worth writing about.',
  },
  {
    key: 'investigation',
    title: 'Investigations',
    intro: 'Reporting with edges. Where we spend the extra weeks.',
  },
];

const groups = formatOrder
  .map((group) => ({
    ...group,
    articles: rest.filter((article) => article.data.format === group.key),
  }))
  .filter((group) => group.articles.length > 0);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

function heroFor(entry: any): string {
  const src = entry?.data?.heroImage?.src;
  if (src && !src.includes('placeholder')) {
    return src.startsWith('/') ? `${base}${src.slice(1)}` : src;
  }
  return `${base}images/sourced/journal-hub-hero-01.webp`;
}

const planningGuides = [
  { eyebrow: 'Itinerary', name: 'The best 3-day Mornington Peninsula plan', href: 'journal/mornington-peninsula-itinerary/' },
  { eyebrow: 'Day trip', name: 'Mornington Peninsula day trip from Melbourne', href: 'journal/mornington-peninsula-day-trip/' },
  { eyebrow: 'Hot springs', name: 'The Peninsula hot springs guide', href: 'journal/mornington-peninsula-hot-springs-guide/' },
  { eyebrow: 'Cellar doors', name: 'Self-drive winery tour — the route that works', href: 'journal/mornington-peninsula-winery-tour/' },
  { eyebrow: 'Family', name: 'Mornington Peninsula with kids — the honest guide', href: 'journal/mornington-peninsula-with-kids/' },
  { eyebrow: 'Dogs', name: 'Dog-friendly Peninsula — beaches, cafés, stays', href: 'journal/dog-friendly-mornington-peninsula/' },
  { eyebrow: 'Season', name: 'The Peninsula in autumn — vintage and fires', href: 'journal/mornington-peninsula-in-autumn/' },
  { eyebrow: 'Season', name: 'The Peninsula in winter — what still runs', href: 'journal/mornington-peninsula-in-winter/' },
  { eyebrow: 'Budget', name: 'Free things to do on the Peninsula', href: 'journal/free-things-to-do-mornington-peninsula/' },
  { eyebrow: 'Eat', name: 'Best brunch on the Mornington Peninsula', href: 'journal/best-brunch-mornington-peninsula/' },
  { eyebrow: 'Wedding', name: 'Peninsula wedding venues worth the weekend', href: 'journal/mornington-peninsula-wedding-venues/' },
  { eyebrow: 'Walks', name: 'Best walks on the Mornington Peninsula', href: 'explore/best-walks/' },
];
---
<BaseLayout
  title="Mornington Peninsula Journal — Peninsula Insider"
  description="Long-form Peninsula journalism, service pieces, and editorial dispatches — written by editors who live on the Peninsula."
  section="journal"
>

<section class="hero" aria-label="Journal cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">The Journal</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Dispatches <span class="ornament">—</span> Lists <span class="ornament">·</span> Essays <span class="ornament">·</span> Stay notes</span>
        </div>
        <h1 class="hero__headline">Long-form notes from a region best read <em>slowly</em>.</h1>
        <p class="hero__dek">The Journal is where Peninsula Insider moves past directories and into voice. Browse by format below, or jump straight to the pieces doing the most work right now.</p>
        <div class="hero__byline">
          <span>— By <strong>The Editors</strong></span>
          <span class="hero__byline-read">{articles.length} pieces in this issue</span>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/journal-hub-hero-01.webp`} alt="Long lunch notebook, cellar door dispatches" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Long lunch notebook <span class="ornament">—</span> cellar door dispatches</span>
          <span>Peninsula Insider <span class="ornament">/</span> The Journal</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- Editor's desk note -->
<section class="letter" aria-labelledby="desk-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">From the editor's desk</span>
        </div>
        <h2 class="letter__head" id="desk-title">What we're writing about <em>this season</em>.</h2>
        <div class="letter__prose">
          <p>Autumn on the Peninsula is vintage season on the ridge and fireplace-lunch season everywhere else. The Journal is leaning into the service pieces that help you build a weekend around those two moods — plus a cellar-door dispatch series, honest stay notes, and the rolling <em>Peninsula This Weekend</em> brief refreshed each week.</p>
          <p>Every piece below answers a real question a weekend visitor actually asks. If we can't finish the sentence <em>"Read this before you…"</em> then we don't publish it.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/journal-hub-hero-01.webp`} alt="Journal — long-form notes">
        <figcaption class="letter__image-cap">Formats in this issue: service pieces, long-lunch lists, cellar-door dispatches, Weekend Picker, stay notes, insider edits.</figcaption>
      </div>
    </div>
  </div>
</section>

<!-- Planning guides — static service pages, authoritative index -->
<section class="shortlist" aria-labelledby="planning-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">Planning guides</span>
        <h2 id="planning-title">Read this <em>before you book</em>.</h2>
        <p class="shortlist__intro-body">Service pieces and seasonal guides for the specific weekend you're trying to build. Each one answers a real question a weekend visitor actually asks.</p>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {planningGuides.map((guide, i) => (
          <li class="sl-item">
            <span class="sl-item__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="sl-item__body">
              <div class="sl-item__meta">
                <span>{guide.eyebrow}</span>
                <span class="sl-item__meta-sep"></span>
                <span>Peninsula Insider</span>
                <span class="sl-item__meta-sep"></span>
                <span>Service guide</span>
              </div>
              <a href={`${base}${guide.href}`} class="sl-item__name">{guide.name}</a>
              <div class="sl-item__tags">
                <span class="sl-item__tag">{guide.eyebrow}</span>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{featured && (
  <section class="well" aria-labelledby="lead-title">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Lead story</span>
          <h2 class="well__head-title" id="lead-title" style="margin-top:.5rem;">The <em>piece</em> to read first.</h2>
        </div>
        <a href={`${base}journal/${featuredSlug}/`} class="well__head-link">Read the piece →</a>
      </div>
      <div class="well__grid">
        <article class="feat feat--lead">
          <img class="feat__image" src={heroFor(featured)} alt={featured.data.title} loading="lazy">
          <div class="feat__body">
            <div class="feat__eyebrow">Journal <span class="ornament">—</span> {formatLabel[featured.data.format] ?? featured.data.format}</div>
            <a href={`${base}journal/${featuredSlug}/`}><h3 class="feat__title">{featured.data.title}</h3></a>
            <p class="feat__excerpt">{featured.data.dek}</p>
            <div class="feat__byline">
              {featured.data.readingTimeMinutes && (
                <>
                  <span>{featured.data.readingTimeMinutes} min read</span>
                  <span class="feat__byline-sep">·</span>
                </>
              )}
              <span>{featured.data.publishedAt.toLocaleDateString('en-AU', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
)}

{picks.length > 0 && (
  <section class="well" aria-labelledby="picks-title">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Editor's picks</span>
          <h2 class="well__head-title" id="picks-title" style="margin-top:.5rem;">Three pieces to <em>read first</em>.</h2>
        </div>
        <span class="well__head-link">If you only have 20 minutes with the Journal, start here.</span>
      </div>
      <div class="well__grid">
        {picks.map((article: any, i: number) => (
          <article class={i === 0 ? 'feat feat--lead' : 'feat feat--std'}>
            <img class="feat__image" src={heroFor(article)} alt={article.data.title} loading="lazy">
            <div class="feat__body">
              <div class="feat__eyebrow">Journal <span class="ornament">—</span> {formatLabel[article.data.format] ?? article.data.format}</div>
              <a href={`${base}journal/${routeSlug(article)}/`}><h3 class="feat__title">{article.data.title}</h3></a>
              {article.data.dek && <p class="feat__excerpt">{article.data.dek}</p>}
              <div class="feat__byline">
                <span>{article.data.publishedAt.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' })}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Format nav -->
<section class="contents" aria-label="Navigate by format">
  <div class="container">
    <div class="contents__head">
      <div>
        <span class="eyebrow eyebrow--ochre">Navigate by format</span>
        <h2 style="margin-top:.5rem;">Every piece carries a <em>format tag</em>.</h2>
      </div>
      <div class="byline">Pick the kind of reading you want</div>
    </div>
    <div class="contents__grid">
      {groups.map((group, gi) => (
        <div class="contents__dept">
          <div class="contents__dept-head">
            <span class="contents__dept-title">{group.title}</span>
            <span class="contents__dept-num">{String(gi + 1).padStart(2, '0')}</span>
          </div>
          {group.articles.slice(0, 5).map((article: any, i: number) => (
            <a href={`${base}journal/${routeSlug(article)}/`} class="contents__item">
              <span class="contents__item-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{article.data.title}</span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

{groups.map((group, gi) => (
  <section class="dept" id={group.key} aria-labelledby={`group-${group.key}`}>
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> {['I','II','III','IV','V','VI','VII','VIII','IX','X'][gi] ?? String(gi + 1)}</span>
          <h2 class="dept__title" id={`group-${group.key}`}>{group.title}</h2>
          <p class="dept__dek">{group.intro}</p>
        </div>
        <span class="well__head-link">{group.articles.length} pieces</span>
      </div>
      <div class="dept__grid">
        {group.articles.map((article: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${heroFor(article)});`}>
              <span class="venue__image-marker">{formatLabel[article.data.format] ?? article.data.format}</span>
            </div>
            <div class="venue__meta">
              <span>{article.data.publishedAt.toLocaleDateString('en-AU', { month: 'short', year: 'numeric' })}</span>
              {article.data.readingTimeMinutes && (
                <>
                  <span class="venue__meta-sep"></span>
                  <span>{article.data.readingTimeMinutes} min read</span>
                </>
              )}
            </div>
            <a href={`${base}journal/${routeSlug(article)}/`}><h3 class="venue__name">{article.data.title}</h3></a>
            {article.data.dek && <p class="venue__sig">{article.data.dek}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
))}

<NewsletterBlock />
</BaseLayout>
