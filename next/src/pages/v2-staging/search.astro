---
import BaseLayout from '../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../components/v2/NewsletterBlock.astro';
---
<BaseLayout
  title="Search — Peninsula Insider"
  description="Search Peninsula Insider for places, stays, long lunches, beaches, itineraries, events, and local intelligence across the Mornington Peninsula."
  section=""
>

<section class="hero" aria-label="Page cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <span class="eyebrow eyebrow--ochre">Search <span class="ornament">·</span> The whole guide</span>
        <h1 class="hero__headline">Search the <em>Peninsula</em>.</h1>
        <p class="hero__dek">Find places, long lunches, stays, beaches, itineraries, events, and journal pieces across Peninsula Insider.</p>
      </div>
    </div>
  </div>
</section>

<section class="letter" aria-label="Search">
  <div class="container">
    <div class="letter__frame" style="display:block; max-width:46rem; margin-inline:auto;">
      <div class="letter__body">
        <div class="letter__prose v2-article-body">
          <form class="search-form" onsubmit="event.preventDefault();">
            <label class="search-form__label" for="site-search">Search the guide</label>
            <input id="site-search" class="search-form__input" type="search" placeholder="Try Red Hill, long lunch, family beach, Sorrento stay..." autocomplete="off" />
            <p class="search-form__hint">Search works across articles, venue pages, place guides, itineraries, experiences, and events.</p>
          </form>
          <div id="search-results" class="search-results" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock />

<script is:inline>
  let pagefindInstance;
  const input = document.getElementById('site-search');
  const results = document.getElementById('search-results');

  function escapeHtml(value) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function loadPagefind() {
    if (pagefindInstance) return pagefindInstance;
    pagefindInstance = await import('/pagefind/pagefind.js');
    return pagefindInstance;
  }

  function renderEmpty(state) {
    if (state === 'idle') {
      results.innerHTML = '<div class="search-state"><p>Start typing to search the guide.</p></div>';
      return;
    }
    if (state === 'none') {
      results.innerHTML = '<div class="search-state"><p>No results yet. Try a town, mood, or trip type.</p></div>';
    }
  }

  async function runSearch(query) {
    const q = query.trim();
    if (!q) {
      renderEmpty('idle');
      return;
    }

    results.innerHTML = '<div class="search-state"><p>Searching…</p></div>';
    const { search } = await loadPagefind();
    const searchResult = await search(q, { limit: 12 });

    if (!searchResult.results.length) {
      renderEmpty('none');
      return;
    }

    const data = await Promise.all(searchResult.results.map((item) => item.data()));
    results.innerHTML = `
      <div class="search-results-meta">${searchResult.results.length} result${searchResult.results.length === 1 ? '' : 's'}</div>
      <div class="search-results-grid">
        ${data.map((item) => `
          <article class="search-card">
            <p class="search-card__url">${escapeHtml(item.url)}</p>
            <h2 class="search-card__title"><a href="${item.url}">${escapeHtml(item.meta.title || 'Untitled')}</a></h2>
            <p class="search-card__excerpt">${item.excerpt || ''}</p>
          </article>
        `).join('')}
      </div>
    `;
  }

  renderEmpty('idle');
  input?.addEventListener('input', (event) => runSearch(event.target.value));
</script>

<style is:global>
  .search-form { display: flex; flex-direction: column; gap: .5rem; margin-bottom: 2rem; }
  .search-form__label { font-family: var(--sans, 'Inter'), sans-serif; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ochre, #a0612d); font-weight: 600; }
  .search-form__input { padding: .9rem 1rem; font-size: 1rem; border: 1px solid rgba(0,0,0,.15); background: transparent; font-family: var(--serif, 'Newsreader'), serif; }
  .search-form__input:focus { outline: 2px solid var(--ochre, #a0612d); outline-offset: 2px; }
  .search-form__hint { font-size: .85rem; opacity: .7; margin-top: .25rem; }
  .search-results { margin-top: 1rem; }
  .search-state { padding: 1rem 0; opacity: .65; font-style: italic; }
  .search-results-meta { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; opacity: .6; margin-bottom: 1rem; }
  .search-results-grid { display: grid; gap: 1.5rem; }
  .search-card { border-top: 1px solid rgba(0,0,0,.1); padding-top: 1rem; }
  .search-card__url { font-size: .75rem; opacity: .55; margin-bottom: .25rem; font-family: var(--sans, 'Inter'), sans-serif; }
  .search-card__title { font-family: var(--serif, 'Newsreader'), serif; font-weight: 500; font-size: 1.25rem; margin: 0 0 .5rem; }
  .search-card__title a { color: inherit; text-decoration: none; }
  .search-card__title a:hover { color: var(--ochre, #a0612d); }
  .search-card__excerpt { font-size: .95rem; line-height: 1.5; }

  .v2-article-body h2 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-feature-settings: 'opsz' 32;
  }
  .v2-article-body h3 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
  .v2-article-body p { margin-bottom: 1.2rem; }
  .v2-article-body blockquote {
    border-left: 3px solid var(--ochre, #a0612d);
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-family: var(--serif, 'Newsreader'), serif;
    font-style: italic;
    font-size: 1.2rem;
  }
  .v2-article-body ul, .v2-article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .v2-article-body li { margin-bottom: .5rem; }
  .v2-article-body a {
    color: var(--ochre, #a0612d);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>

</BaseLayout>
