---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { buildItemListSchema, buildBreadcrumbSchema } from '../../../lib/schema';
import { routeSlug } from '../../../lib/editorial';

const SITE = 'https://peninsulainsider.com.au';
const canonical = `${SITE}/wine/appointment-producers/`;

// Appointment-only and small-production producers worth planning for
const appointmentSlugs = [
  'garagiste', 'onannon', 'dexter-wines', 'eldridge-estate',
  'paradigm-hill', 'nazaaray-estate', 'baillieu-vineyard', 'elan-vineyard',
  'phaedrus-estate', 'hurley-vineyard', 'circe-wines',
];

const allVenues = await getCollection('venues');
const venues = appointmentSlugs
  .map((s) => allVenues.find((v) => routeSlug(v) === s))
  .filter(Boolean) as typeof allVenues;

const itemListSchema = buildItemListSchema({
  name: 'Appointment-only and small-production Mornington Peninsula wineries',
  description: 'The boutique and appointment-only producers on the Mornington Peninsula worth planning a dedicated visit for.',
  listPath: '/wine/appointment-producers',
  items: venues.map((v) => ({ name: v.data.name, path: `/wine/${routeSlug(v)}`, itemType: 'Winery' })),
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: SITE },
  { name: 'Wine Country', url: `${SITE}/wine` },
  { name: 'Appointment Producers', url: canonical },
]);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Appointment-Only Wineries · Mornington Peninsula · Peninsula Insider"
  description="The small-production and appointment-only wineries on the Mornington Peninsula that are worth planning a dedicated visit for — Garagiste, Onannon, Dexter, Eldridge, and more."
  section="wine"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<section class="hero" aria-label="Appointment producers">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Wine Country</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Access type <span class="ornament">·</span> By appointment</span>
        </div>
        <h1 class="hero__headline">Appointment-only <em>producers</em>.</h1>
        <p class="hero__dek">The producers that don't have a roadside sign and don't need one — small yields, limited production, and a preference for visitors who arrive with intent rather than habit.</p>
        <div class="hero__byline">
          <span>— By <strong>The Editors</strong></span>
        </div>
      </div>
      <figure>
        <div class="hero__image ph ph-cellar" role="img" aria-label="Appointment-only tasting room"></div>
        <figcaption class="hero__image-cap">
          <span>Boutique producers <span class="ornament">—</span> The Peninsula</span>
          <span>By appointment <span class="ornament">/</span> {venues.length} estates</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="appt-letter">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="appt-letter">The reward for the extra <em>planning</em>.</h2>
        <div class="letter__prose">
          <p>These are the producers that don't have a roadside sign and don't need one. Small yields, limited production, and a preference for visitors who arrive with intent rather than habit. Most require a booking — some several weeks in advance for popular releases.</p>
          <blockquote class="pullquote">Appointments at producers like Garagiste, Onannon, and Eldridge Estate mean time with the winemaker, access to library vintages, and wine that rarely appears in retail distribution.</blockquote>
          <p>The reward for the extra planning is disproportionate. These visits are among the best Peninsula experiences for people who are serious about what's in the glass.</p>
          <p>Contact each producer directly. Booking windows vary; some open seasonally. Most are happy to accommodate small groups.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <div class="letter__image ph ph-cellar" role="img" aria-label="Tasting bench with winemaker"></div>
        <figcaption class="letter__image-cap">A bench tasting at <em>a Peninsula producer by appointment</em>.</figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" aria-labelledby="appt-list" id="producers">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">Editorial ranking · {new Date().getFullYear()}</span>
        <h2 id="appt-list">{venues.length} producer{venues.length !== 1 ? 's' : ''} <em>worth the booking</em>.</h2>
        <p class="shortlist__intro-body">Ordered by editorial authority and Halliday score.</p>
        <a href={`${base}wine/`} class="shortlist__intro-link">All producers
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((venue, i) => {
          const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
          const hats = venue.data.authority?.hats ?? 0;
          return (
            <li class="sl-item">
              <span class="sl-item__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{placeLabel}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>By appointment</span>
                  {venue.data.priceBand && <><span class="sl-item__meta-sep"></span><span>{venue.data.priceBand}</span></>}
                </div>
                <a href={`${base}wine/${routeSlug(venue)}/`} class="sl-item__name">{venue.data.name}</a>
                <p class="sl-item__why">{venue.data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {venue.data.authority?.hallidayScore && <span class="sl-item__tag">Halliday {venue.data.authority.hallidayScore}</span>}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="appt-faq">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body" style="grid-column: 1 / -1;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently asked</span>
        </div>
        <h2 class="letter__head" id="appt-faq">Questions before you <em>book</em>.</h2>
        <div class="letter__prose">
          <h3>How do I book an appointment at a Mornington Peninsula winery?</h3>
          <p>Contact the winery directly — most have an email address or booking form on their website. Some use Cellar Door by Vinsight or similar booking systems. Lead time varies: popular producers in peak season (March–May, October–November) may be booked weeks in advance. Being specific about what you want to taste — a library vertical, a current release flight — helps the winery plan.</p>
          <h3>Are appointment-only wineries more expensive?</h3>
          <p>Not necessarily. Some charge a tasting fee (typically $30–$60 per person) that is often refundable against purchase. Others charge nothing. The expense is time: these visits reward you most if you set aside two to three hours rather than treating them as a quick stop.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
