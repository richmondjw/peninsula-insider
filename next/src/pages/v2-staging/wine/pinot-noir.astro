---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { buildItemListSchema, buildBreadcrumbSchema } from '../../../lib/schema';
import { routeSlug } from '../../../lib/editorial';

const SITE = 'https://peninsulainsider.com.au';
const canonical = `${SITE}/wine/pinot-noir/`;

const pinotSlugs = [
  'paringa-estate', 'ten-minutes-by-tractor', 'montalto', 'polperro',
  'kooyong', 'main-ridge-estate', 'ocean-eight', 'stonier-wines',
  'scorpo-wines', 'dexter-wines', 'yabby-lake', 'pt-leo-estate',
  'red-hill-estate', 'eldridge-estate', 'garagiste', 'onannon',
];

const allVenues = await getCollection('venues');
const venues = pinotSlugs
  .map((s) => allVenues.find((v) => routeSlug(v) === s))
  .filter(Boolean) as typeof allVenues;

const itemListSchema = buildItemListSchema({
  name: 'Best Pinot Noir producers — Mornington Peninsula',
  description: 'The Mornington Peninsula cellar doors producing the most compelling Pinot Noir.',
  listPath: '/wine/pinot-noir',
  items: venues.map((v) => ({ name: v.data.name, path: `/wine/${routeSlug(v)}`, itemType: 'Winery' })),
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: SITE },
  { name: 'Wine Country', url: `${SITE}/wine` },
  { name: 'Pinot Noir', url: canonical },
]);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Mornington Peninsula Pinot Noir · Best Producers · Peninsula Insider"
  description="The Peninsula Insider guide to Mornington Peninsula Pinot Noir — the best producers, the benchmark labels, and what makes the region's signature red worth seeking out."
  section="wine"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<section class="hero" aria-label="Pinot Noir producers">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Wine Country</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Varietal guide <span class="ornament">·</span> Pinot Noir</span>
        </div>
        <h1 class="hero__headline">Mornington Peninsula <em>Pinot Noir</em>.</h1>
        <p class="hero__dek">The region's identity grape. Fragrant, precise, with the kind of fine tannin structure that rewards a few years in bottle. The benchmark producers have been at this for thirty-plus years.</p>
        <div class="hero__byline">
          <span>— By <strong>The Editors</strong></span>
        </div>
      </div>
      <figure>
        <div class="hero__image ph ph-vine" role="img" aria-label="Pinot Noir vineyard"></div>
        <figcaption class="hero__image-cap">
          <span>Pinot Noir <span class="ornament">—</span> the Peninsula's identity</span>
          <span>{venues.length} producers <span class="ornament">/</span> Red Hill to Moorooduc</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="pn-letter">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="pn-letter">What separates the best is <em>line</em>.</h2>
        <div class="letter__prose">
          <p>Pinot Noir is the Mornington Peninsula's identity grape. The cool maritime climate — average summer temperature around 19°C, sea breezes from two directions — produces Pinot of unusual finesse: fragrant, precise, with the kind of fine tannin structure that rewards a few years in bottle.</p>
          <p>The Red Hill plateau is the heartland. Main Ridge sits higher and cooler; the wines from that altitude carry more perfume and intensity. Merricks and Moorooduc produce Pinot that's rounder and more approachable young.</p>
          <blockquote class="pullquote">What separates the best Peninsula Pinot from the rest of Victoria isn't power — it's line.</blockquote>
          <p>The acidity runs fine and persistent, the fruit sits clearly in the red spectrum, and the best examples have a saline edge that's distinctly maritime. The benchmark producers have been at this for thirty-plus years; the younger generation has inherited the template and is adding to it.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider · Wine</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <div class="letter__image ph ph-vine" role="img" aria-label="Pinot Noir canes"></div>
        <figcaption class="letter__image-cap">Fine tannin and saline edge — <em>the Peninsula Pinot signature</em>.</figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" aria-labelledby="pn-list" id="producers">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">Editorial ranking · {new Date().getFullYear()}</span>
        <h2 id="pn-list">{venues.length} Pinot <em>producers</em> worth knowing.</h2>
        <p class="shortlist__intro-body">Ordered by editorial authority and Halliday score.</p>
        <a href={`${base}wine/`} class="shortlist__intro-link">All producers
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((venue, i) => {
          const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
          const hats = venue.data.authority?.hats ?? 0;
          return (
            <li class="sl-item">
              <span class="sl-item__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{placeLabel}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>Pinot Noir</span>
                  {venue.data.priceBand && <><span class="sl-item__meta-sep"></span><span>{venue.data.priceBand}</span></>}
                </div>
                <a href={`${base}wine/${routeSlug(venue)}/`} class="sl-item__name">{venue.data.name}</a>
                <p class="sl-item__why">{venue.data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {venue.data.authority?.hallidayScore && <span class="sl-item__tag">Halliday {venue.data.authority.hallidayScore}</span>}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="pn-faq">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body" style="grid-column: 1 / -1;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently asked</span>
        </div>
        <h2 class="letter__head" id="pn-faq">Questions on <em>Peninsula Pinot</em>.</h2>
        <div class="letter__prose">
          <h3>Is Mornington Peninsula Pinot Noir the best in Australia?</h3>
          <p>It is consistently among the finest. The Yarra Valley, Adelaide Hills, and Tasmania all produce compelling Pinot Noir, but the Mornington Peninsula has a distinctive profile — saline, fine-tannined, and precise — that sets it apart. The concentration of serious producers on a relatively small area is unmatched in Australia.</p>
          <h3>When should you drink Mornington Peninsula Pinot Noir?</h3>
          <p>Entry-level and estate labels are approachable on release. Single-vineyard Pinots from the best producers repay 3–7 years. The benchmark labels — Paringa Estate Single Vineyard, Ten Minutes by Tractor McCutcheon, Kooyong Meres — are genuinely age-worthy. Most cellar doors offer back vintages; it is worth asking.</p>
          <h3>What food pairs with Mornington Peninsula Pinot Noir?</h3>
          <p>Duck, mushroom, and salmon are the classic matches. The peninsula's own produce — milk-fed lamb, duck from nearby farms — is the natural pairing. The region's restaurant cellar doors lean into this; lunching at Montalto or Ten Minutes by Tractor with the estate Pinot is one of the better food-and-wine experiences in Victoria.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
