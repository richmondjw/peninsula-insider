---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, currentSeason, seasonBlurb } from '../../../lib/editorial';

const wineTypes = ['winery', 'producer', 'brewery', 'distillery'];
const venues = (await getCollection('venues'))
  .filter((venue) => wineTypes.includes(venue.data.type))
  .sort((a, b) => Number(b.data.authority?.hallidayScore ?? 0) - Number(a.data.authority?.hallidayScore ?? 0));

const season = currentSeason();
const blurb = seasonBlurb[season];

// Split by type so the hub reads as a structured region guide.
const wineries = venues.filter((venue) => venue.data.type === 'winery');
const producers = venues.filter((venue) => venue.data.type === 'producer');
const breweries = venues.filter((venue) => venue.data.type === 'brewery');
const distilleries = venues.filter((venue) => venue.data.type === 'distillery');

// Benchmark shortlist  -  the cellar doors that anchor the region right now.
const benchmarkSlugs = [
  'pt-leo-estate',
  'montalto',
  'paringa-estate',
  'polperro',
  'dexter-wines',
  'ocean-eight',
];
const benchmarks = benchmarkSlugs
  .map((slug) => venues.find((venue) => routeSlug(venue) === slug))
  .filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));

// Appointment-only  -  the producers worth planning the drive around.
const appointmentOnly = venues
  .filter((venue) => venue.data.bookingProvider === 'direct' || Number(venue.data.authority?.hallidayScore ?? 0) >= 95)
  .filter((venue) => !benchmarks.some((b) => routeSlug(b) === routeSlug(venue)))
  .slice(0, 6);

// Places most associated with wine country.
const places = await getCollection('places');
const wineHubs = places.filter((place) =>
  ['red-hill', 'main-ridge', 'merricks', 'balnarring', 'moorooduc', 'tuerong'].includes(routeSlug(place)),
);

// Journal companions.
const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const companionSlugs = [
  'the-chardonnay-case',
  'the-cellar-door-short-list',
  'how-to-build-a-red-hill-saturday',
  'the-peninsula-pantry',
];
const companionReads = companionSlugs
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What wine is the Mornington Peninsula known for?',
      acceptedAnswer: { '@type': 'Answer', text: 'Pinot Noir and Chardonnay are the benchmark varieties — the cool maritime climate and basalt soils of the Red Hill plateau produce some of Australia\'s most consistent cool-climate examples. The region also has a growing reputation for Pinot Gris and Shiraz. Over 50 cellar doors are open to visitors, concentrated on the ridge between Red Hill and Main Ridge.' }},
    { '@type': 'Question', name: 'Do I need to book cellar door visits on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Some cellar doors operate by appointment only (Ten Minutes by Tractor, Main Ridge Estate, Paringa Estate). Others welcome walk-ins (Montalto, Polperro, Red Hill Estate). Check before you drive — appointment-only cellar doors are common on the plateau and the experience is better when expected. Weekend afternoons are busiest.' }},
    { '@type': 'Question', name: 'How many wineries are on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Mornington Peninsula has over 200 vineyards and approximately 50–60 cellar doors open to visitors. Most are concentrated on the Red Hill plateau between Dromana, Red Hill, and Main Ridge. The region is compact — you can visit three cellar doors in an afternoon without rushing if you stay on the ridge.' }},
  ],
};

const typeLabel: Record<string, string> = {
  winery: 'Winery', producer: 'Producer', brewery: 'Brewery', distillery: 'Distillery',
};
export const prerender = true;
---
<BaseLayout
  title="Best Wineries Mornington Peninsula · Peninsula Insider"
  description="The best cellar doors on the Mornington Peninsula — Pinot Noir, Chardonnay, cool-climate producers, breweries, and distilleries. Appointment tastings and walk-in cellar doors. Updated April 2026."
  section="wine"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Wine Country hub">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Wine Country</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Cellar doors <span class="ornament">·</span> Pinot noir <span class="ornament">·</span> Cool-climate producers</span>
        </div>
        <h1 class="hero__headline">The Peninsula's best bottles start on the <em>ridge</em>.</h1>
        <p class="hero__dek">Pinot noir and chardonnay built on basalt, plus the breweries and distilleries that now round out the region. This hub sorts them by what they're actually for — long lunches, appointment tastings, and afternoons that earn the drive.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href={`${base}wine/best-cellar-doors/`} class="hero__byline-read">Read the shortlist <span style="opacity:.5;margin-left:.3rem;">8 min</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/wine-hub-hero-01.webp`} alt="Pinot Noir vineyard, Main Ridge" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Pinot Noir <span class="ornament">—</span> Main Ridge Estate</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="wine-letter-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="wine-letter-title">Three ways a Peninsula wine <em>afternoon</em> works.</h2>
        <div class="letter__prose">
          <p>Either you anchor the day to one benchmark cellar door with a long lunch and let the rest of the afternoon be slow driving. Or you book two appointment-only tastings, one either side of a small village meal. Or you skip the wineries altogether and use a brewery, distillery, or orchard to make the day feel a little less formal.</p>
          <blockquote class="pullquote">The question is no longer whether the drive is worth it. It's which cellar doors to open, and in what order.</blockquote>
          <p>This list is editorial. Every entry has been visited and the wine has been drunk at the source. The list is ordered by editorial authority and Halliday score where applicable: benchmark producers first, then the smaller rooms doing quiet, interesting work below them.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider · Wine Country</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <div class="letter__image ph ph-vine" role="img" aria-label="Vine rows, Red Hill plateau"></div>
        <figcaption class="letter__image-cap">The plateau in late vintage — <em>the quietest a working winery ever gets.</em></figcaption>
      </div>
    </div>
  </div>
</section>

{benchmarks.length > 0 && (
  <section class="shortlist" aria-labelledby="benchmark-title" id="benchmarks">
    <div class="container">
      <div class="shortlist__frame">
        <div class="shortlist__intro">
          <span class="eyebrow eyebrow--ochre">Benchmark cellar doors</span>
          <h2 id="benchmark-title">The producers anchoring the region <em>right now</em>.</h2>
          <p class="shortlist__intro-body">Halliday scores matter less than editorial weight — this is the shortlist we'd put in front of a first-time visitor and an obsessive both.</p>
          <a href={`${base}journal/the-cellar-door-short-list/`} class="shortlist__intro-link">Read the shortlist
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
          </a>
        </div>
        <ol class="shortlist__list" style="list-style:none;">
          {benchmarks.map((venue, i) => {
            const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
            const hats = venue.data.authority?.hats ?? 0;
            return (
              <li class="sl-item">
                <span class="sl-item__num">{String(i + 1).padStart(2, '0')}</span>
                <div class="sl-item__body">
                  <div class="sl-item__meta">
                    <span>{placeLabel}</span>
                    <span class="sl-item__meta-sep"></span>
                    <span>{typeLabel[venue.data.type] ?? venue.data.type}</span>
                    {venue.data.priceBand && <><span class="sl-item__meta-sep"></span><span>{venue.data.priceBand}</span></>}
                  </div>
                  <a href={`${base}wine/${routeSlug(venue)}/`} class="sl-item__name">{venue.data.name}</a>
                  <p class="sl-item__why">{venue.data.signature}</p>
                  <div class="sl-item__tags">
                    {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                    {venue.data.authority?.hallidayScore && <span class="sl-item__tag">Halliday {venue.data.authority.hallidayScore}</span>}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>
)}

{appointmentOnly.length > 0 && (
  <section class="dept" aria-labelledby="appointment-title" id="appointment">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> I</span>
          <h2 class="dept__title" id="appointment-title">Appointment <em>producers</em>.</h2>
          <p class="dept__dek">Worth planning the drive around. Smaller tastings, closer to the winemaking, often the most interesting conversations of the weekend.</p>
        </div>
        <a href={`${base}wine/appointment-producers/`} class="well__head-link">All appointment producers
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <div class="dept__grid">
        {appointmentOnly.map((venue) => {
          const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
          const hats = venue.data.authority?.hats ?? 0;
          return (
            <article class="venue">
              <div class="venue__image ph ph-cellar" role="img" aria-label={venue.data.name}>
                <span class="venue__image-marker">{typeLabel[venue.data.type] ?? venue.data.type}</span>
                {hats > 0 && <span class="venue__image-hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
              </div>
              <div class="venue__meta">
                <span>{placeLabel}</span>
                {venue.data.priceBand && <><span class="venue__meta-sep"></span><span>{venue.data.priceBand}</span></>}
                <span class="venue__meta-sep"></span>
                <span>By appointment</span>
              </div>
              <a href={`${base}wine/${routeSlug(venue)}/`}><h3 class="venue__name">{venue.data.name}</h3></a>
              <p class="venue__sig">{venue.data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{wineries.length > 0 && (
  <section class="dept" aria-labelledby="wineries-title" id="wineries">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> II</span>
          <h2 class="dept__title" id="wineries-title">All <em>cellar doors</em>.</h2>
          <p class="dept__dek">{wineries.length} cellar doors across the region, sorted by authority. Expect a spread from three-hat destinations to back-road pinot rooms.</p>
        </div>
        <a href={`${base}wine/cellar-doors/`} class="well__head-link">All cellar doors
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <div class="dept__grid">
        {wineries.slice(0, 9).map((venue) => {
          const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
          const hats = venue.data.authority?.hats ?? 0;
          return (
            <article class="venue">
              <div class="venue__image ph ph-vine" role="img" aria-label={venue.data.name}>
                <span class="venue__image-marker">Winery</span>
                {hats > 0 && <span class="venue__image-hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
              </div>
              <div class="venue__meta">
                <span>{placeLabel}</span>
                {venue.data.priceBand && <><span class="venue__meta-sep"></span><span>{venue.data.priceBand}</span></>}
              </div>
              <a href={`${base}wine/${routeSlug(venue)}/`}><h3 class="venue__name">{venue.data.name}</h3></a>
              <p class="venue__sig">{venue.data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{breweries.length > 0 && (
  <section class="dept" aria-labelledby="breweries-title" id="breweries">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> III</span>
          <h2 class="dept__title" id="breweries-title">The Peninsula's beer <em>shortlist</em>.</h2>
          <p class="dept__dek">Where the weekend wants a slightly less serious spine.</p>
        </div>
      </div>
      <div class="dept__grid">
        {breweries.map((venue) => {
          const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
          return (
            <article class="venue">
              <div class="venue__image ph ph-cellar" role="img" aria-label={venue.data.name}>
                <span class="venue__image-marker">Brewery</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel}</span>
                {venue.data.priceBand && <><span class="venue__meta-sep"></span><span>{venue.data.priceBand}</span></>}
              </div>
              <a href={`${base}wine/${routeSlug(venue)}/`}><h3 class="venue__name">{venue.data.name}</h3></a>
              <p class="venue__sig">{venue.data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{distilleries.length > 0 && (
  <section class="dept" aria-labelledby="distilleries-title" id="distilleries">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> IV</span>
          <h2 class="dept__title" id="distilleries-title">Gin, whisky, and the <em>slow craft</em> layer.</h2>
          <p class="dept__dek">Small-batch producers working quietly behind the wine story.</p>
        </div>
      </div>
      <div class="dept__grid">
        {distilleries.map((venue) => {
          const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
          return (
            <article class="venue">
              <div class="venue__image ph ph-cellar" role="img" aria-label={venue.data.name}>
                <span class="venue__image-marker">Distillery</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel}</span>
                {venue.data.priceBand && <><span class="venue__meta-sep"></span><span>{venue.data.priceBand}</span></>}
              </div>
              <a href={`${base}wine/${routeSlug(venue)}/`}><h3 class="venue__name">{venue.data.name}</h3></a>
              <p class="venue__sig">{venue.data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{producers.length > 0 && (
  <section class="dept" aria-labelledby="producers-title" id="producers">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> V</span>
          <h2 class="dept__title" id="producers-title">Producers <em>&amp;</em> makers.</h2>
          <p class="dept__dek">Cheese, truffles, olive oil, chocolate, and the wider Peninsula pantry — the producers that round out a long lunch with everything the cellar door forgot.</p>
        </div>
        <a href={`${base}journal/the-peninsula-pantry/`} class="well__head-link">Read the pantry piece
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <div class="dept__grid">
        {producers.map((venue) => {
          const placeLabel = String(venue.data.place?.id ?? venue.data.place ?? '').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
          return (
            <article class="venue">
              <div class="venue__image ph ph-food" role="img" aria-label={venue.data.name}>
                <span class="venue__image-marker">Producer</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel}</span>
                {venue.data.priceBand && <><span class="venue__meta-sep"></span><span>{venue.data.priceBand}</span></>}
              </div>
              <a href={`${base}wine/${routeSlug(venue)}/`}><h3 class="venue__name">{venue.data.name}</h3></a>
              <p class="venue__sig">{venue.data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<section class="places" aria-labelledby="wine-places-title" id="hubs">
  <div class="container">
    <div class="places__head">
      <div>
        <span class="eyebrow eyebrow--ochre">Wine country <span class="ornament">·</span> By sub-region</span>
        <h2 class="dept__title" id="wine-places-title" style="margin-top:.5rem;">Pick a <em>sub-region</em>, and we'll build the day around it.</h2>
      </div>
      <a href={`${base}wine/wine-region/`} class="well__head-link">About the region
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
      </a>
    </div>
    <div class="places__grid">
      <a href={`${base}wine/red-hill/`} class="place">
        <div class="place__image ph ph-town-redhill"></div>
        <div class="place__name">Red Hill</div>
        <div class="place__count">The plateau heartland</div>
      </a>
      <a href={`${base}wine/main-ridge/`} class="place">
        <div class="place__image ph ph-town-mainridge"></div>
        <div class="place__name">Main Ridge</div>
        <div class="place__count">Highest elevation</div>
      </a>
      <a href={`${base}wine/merricks/`} class="place">
        <div class="place__image ph ph-vine"></div>
        <div class="place__name">Merricks</div>
        <div class="place__count">Approachable coastal Pinot</div>
      </a>
      <a href={`${base}wine/moorooduc-tuerong/`} class="place">
        <div class="place__image ph ph-vine"></div>
        <div class="place__name">Moorooduc &amp; Tuerong</div>
        <div class="place__count">Bay-facing estates</div>
      </a>
      <a href={`${base}wine/balnarring/`} class="place">
        <div class="place__image ph ph-vine"></div>
        <div class="place__name">Balnarring</div>
        <div class="place__count">Quieter southern stretch</div>
      </a>
      <a href={`${base}wine/flinders/`} class="place">
        <div class="place__image ph ph-coast"></div>
        <div class="place__name">Flinders</div>
        <div class="place__count">Southernmost tip</div>
      </a>
    </div>
  </div>
</section>

<section class="places" aria-labelledby="wine-ways-title" id="hub-index">
  <div class="container">
    <div class="places__head">
      <div>
        <span class="eyebrow eyebrow--ochre">Browse by type</span>
        <h2 class="dept__title" id="wine-ways-title" style="margin-top:.5rem;">More ways into <em>wine country</em>.</h2>
      </div>
    </div>
    <div class="places__grid">
      <a href={`${base}wine/pinot-noir/`} class="place">
        <div class="place__image ph ph-vine"></div>
        <div class="place__name">Pinot Noir</div>
        <div class="place__count">The region's signature red</div>
      </a>
      <a href={`${base}wine/chardonnay/`} class="place">
        <div class="place__image ph ph-vine"></div>
        <div class="place__name">Chardonnay</div>
        <div class="place__count">Cool-climate white at its best</div>
      </a>
      <a href={`${base}wine/cellar-doors/`} class="place">
        <div class="place__image ph ph-cellar"></div>
        <div class="place__name">All Cellar Doors</div>
        <div class="place__count">Walk-in and appointment</div>
      </a>
      <a href={`${base}wine/appointment-producers/`} class="place">
        <div class="place__image ph ph-cellar"></div>
        <div class="place__name">Appointment Producers</div>
        <div class="place__count">Small-batch · worth planning</div>
      </a>
      <a href={`${base}wine/best-cellar-doors/`} class="place">
        <div class="place__image ph ph-cellar"></div>
        <div class="place__name">Best Cellar Doors</div>
        <div class="place__count">The editorial shortlist</div>
      </a>
      <a href={`${base}wine/dog-friendly/`} class="place">
        <div class="place__image ph ph-vine"></div>
        <div class="place__name">Dog-Friendly</div>
        <div class="place__count">Confirmed outdoor areas</div>
      </a>
    </div>
  </div>
</section>

{companionReads.length > 0 && (
  <section class="well" aria-labelledby="wine-well-title">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">From the Journal</span>
          <h2 class="well__head-title" id="wine-well-title" style="margin-top:.5rem;">The wine arguments worth reading <em>before you buy</em>.</h2>
          <p class="dept__dek" style="margin-top:.5rem;">{blurb.line}</p>
        </div>
        <a href={`${base}journal/`} class="well__head-link">All in the Journal
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <div class="well__grid">
        {companionReads.map((article, i) => (
          <article class={`feat ${i === 0 ? 'feat--lead' : 'feat--std'}`}>
            <div class={`feat__image ph ${i === 0 ? 'ph-food' : 'ph-vine'}`} role="img" aria-label={article.data.title}></div>
            <div class="feat__body">
              <div class="feat__eyebrow">Wine Country <span class="ornament">—</span> Journal</div>
              <a href={`${base}journal/${routeSlug(article)}/`}><h3 class="feat__title">{article.data.title}</h3></a>
              <p class="feat__excerpt">{article.data.dek ?? article.data.description ?? ''}</p>
              <div class="feat__byline"><span>— By <strong>The Editors</strong></span></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

