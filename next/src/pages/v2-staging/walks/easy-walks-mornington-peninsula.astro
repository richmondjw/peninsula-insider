---
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const walks = [
  { rank: 1, name: 'Cape Schanck Boardwalk', tag: '20 min return · Accessible · No dogs',
    note: 'The boardwalk is surfaced and accessible for most mobility levels. The view from the platform — lighthouse, ocean, and the basalt stack called Pulpit Rock — is one of the strongest short-walk payoffs on the Peninsula. Do not skip it because it is short. Best time: late afternoon light is exceptional.' },
  { rank: 2, name: 'Mornington Foreshore Walk', tag: '3km one way · Flat · Dogs on lead OK',
    note: 'The flat path between Mornington Pier and Schnapper Point, passing the bathing boxes and foreshore reserve. Cafés at both ends. The best family or low-effort walk in the northern Peninsula — not spectacular, but reliably good. Best time: early morning or dusk for the bathing boxes light.' },
  { rank: 3, name: 'Farnsworth Track', tag: '1.5km one way · Clifftop exposure · No dogs',
    note: '1.5km one way from London Bridge carpark to the Portsea Ocean Beach lookout. Technically easy — the track is clear and not steep — but it has genuine clifftop exposure above Bass Strait. The reward is the best lookout above the Southern Ocean near Sorrento. Late afternoon light is best.' },
  { rank: 4, name: 'Arthurs Seat Summit Circuit', tag: '1.8km circuit · Some steps · No dogs',
    note: 'Formed path with some steps, well-maintained, shaded by messmate and manna gum. Views to Melbourne, the You Yangs, and Mt Macedon on a clear day. Can be combined with the Arthurs Seat Eagle gondola for a one-way walk down.' },
  { rank: 5, name: 'Baldrys Short Circuit, Greens Bush', tag: '1.6km · 45 min · No dogs',
    note: 'The entry-level walk into Victoria\'s largest surviving coastal heathland remnant. Easy grades, ancient grasstrees. Quiet on weekdays. The bush here feels wilder than the distance from Melbourne suggests. Best time: dawn or dusk for wildlife.' },
  { rank: 6, name: 'Coppins Track — first section', tag: 'Open distance · Flat clifftop · No dogs',
    note: 'The full Coppins Track to Diamond Bay is 4km one way and moderate. The first section from Sorrento is easy — flat clifftop path above Bass Strait, you walk as far as you want and turn back. Broad views, no scrambling, clear path.' },
];

const selectorRows = [
  { head: 'If you want spectacular without effort', body: 'Cape Schanck boardwalk. 20 minutes. Lighthouse, Bass Strait, Pulpit Rock. The most impressive short walk on the Peninsula by any measure.' },
  { head: 'If you\'re bringing small children', body: 'Mornington foreshore. Flat, café at both ends, bathing boxes for photographs, and the children can play on the beach after.' },
  { head: 'If you want a walk before lunch in Sorrento', body: 'Coppins Track first section. Start at Sorrento Ocean Beach, walk the clifftop as far as you like, return, and walk into town for lunch.' },
  { head: 'If you want views + wine in one morning', body: 'Arthurs Seat summit circuit, then Red Hill cellar doors. 1.8km at the summit, then drop into the plateau for the afternoon.' },
  { head: 'If you want something genuinely different', body: 'Baldrys Short Circuit in Greens Bush. Ancient grasstrees, real bush, wildlife if you are there at the right time of day.' },
  { head: 'If you want drama with a short time window', body: 'Farnsworth Track at 4pm. 1.5km to a clifftop lookout above Bass Strait. Do it in the last two hours of daylight.' },
];
export const prerender = true;
---

<BaseLayout
  title="Easy Walks on the Mornington Peninsula — Peninsula Insider"
  description="The best easy walks on the Mornington Peninsula — Cape Schanck boardwalk, Mornington foreshore, Farnsworth Track, Arthurs Seat circuit, and more. Honest difficulty notes and what to do after each walk."
  section="explore"
  ogImage="/images/sourced/explore-bushrangers-bay-walk-01.webp"
>

  <section class="hero" aria-label="Easy walks cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <a href={`${base}walks/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Walks</a>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">Easy walks</span>
          </div>
          <h1 class="hero__headline">Easy walks, properly.</h1>
          <p class="hero__dek">"Easy walk" is one of the most abused phrases in Peninsula tourism. We use it specifically — flat or near-flat, under two hours return, no scrambling. Six walks that meet that bar and are still genuinely good.</p>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/explore-cape-schanck-boardwalk-01.webp`} alt="Cape Schanck boardwalk" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Cape Schanck boardwalk</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">The editor's note</span>
        </div>
        <h2 class="letter__head">Flat, short, and genuinely good — all three matter.</h2>
        <div class="letter__prose">
          <p>"Easy walk" has been used to describe walks that are perfectly fine for a fit adult but genuinely not appropriate for a family with a two-year-old, or for someone who gets anxious on exposed clifftops. We use it specifically: flat or near-flat, under 2 hours return, no scrambling, and suitable for most adults without walking experience. Where a walk has conditions, we say so.</p>
          <p>Dogs are banned from Mornington Peninsula National Park and Greens Bush. Easy walk or not, that is a hard rule and it eliminates most of the Peninsula's best short tracks.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="shortlist">
    <div class="container">
      <div class="shortlist__head">
        <span class="eyebrow eyebrow--ochre">The walks</span>
        <h2 class="shortlist__title">Six easy walks worth making the drive for.</h2>
      </div>
      <ol class="sl-list">
        {walks.map(w => (
          <li class="sl-item">
            <div class="sl-item__rank">{w.rank}</div>
            <div class="sl-item__body">
              <span class="eyebrow">{w.tag}</span>
              <h3 class="sl-item__name">{w.name}</h3>
              <p class="sl-item__note">{w.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="dept">
    <div class="container">
      <div class="dept__head">
        <span class="eyebrow eyebrow--ochre">Walk selector</span>
        <h2 class="dept__title">Which easy walk belongs to your day?</h2>
      </div>
      <div class="dept__grid">
        {selectorRows.map(r => (
          <article class="venue">
            <div class="venue__body">
              <h3 class="venue__title">{r.head}</h3>
              <p class="venue__blurb">{r.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Dogs and easy walks</span>
        </div>
        <h2 class="letter__head">The honest guide to dog access.</h2>
        <div class="letter__prose">
          <p>Mornington Peninsula National Park — which includes Cape Schanck, the Farnsworth Track, the Coppins Track, Two Bays sections, Point Nepean, and the Coastal Walk corridor — prohibits dogs entirely. This includes carparks. There are no exceptions for small dogs, for leads, or for national park boundaries you cannot see from the trailhead.</p>
          <p>Greens Bush and Arthurs Seat State Park also prohibit dogs.</p>
          <p>For dogs, the clearest options are: the Mornington foreshore (on lead), Mount Martha clifftop sections (on lead), and Rosebud foreshore. These are genuinely good walks with dogs. The clifftop national park walks are not available to you. Plan accordingly.</p>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock />

</BaseLayout>
