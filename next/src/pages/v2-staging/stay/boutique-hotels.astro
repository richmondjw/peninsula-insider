---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const slugs = ['flinders-hotel','hotel-sorrento','lindenderry','jackalope','the-continental-sorrento'];
const venues = slugs.map((slug) => allVenues.find((venue) => routeSlug(venue) === slug)).filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Boutique Hotels Mornington Peninsula · Peninsula Insider"
  description="The best boutique hotels on the Mornington Peninsula, from Flinders and Sorrento to Red Hill design-led stays."
  section="stay"
>

<section class="hero" aria-label="Boutique Hotels on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}stay/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Stay</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Boutique Hotels <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">Boutique hotels on the <em>Mornington Peninsula</em>.</h1>
        <p class="hero__dek">The Peninsula's boutique hotels work best when they feel grounded in place rather than merely upscale. Village access, architectural character, or a clear relationship to the hinterland and coast.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} hotels</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-flinders-01.webp`} alt="Flinders village pub country" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Flinders <span class="ornament">—</span> the quietest of the Peninsula's boutique anchors</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Character over <em>scale</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula's boutique hotels work best when they feel grounded in place rather than merely upscale. That usually means village access, architectural character, or a clear relationship to the hinterland and coast. Flinders Hotel, Hotel Sorrento, Lindenderry, and Jackalope all do that in different registers.</p>
          <p style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 24 April 2026</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-sorrento-01.webp`} alt="Sorrento main street">
        <figcaption class="letter__image-cap">Sorrento main street <em>— the village end of the boutique map.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} boutique hotels worth <em>prioritising</em>.</h2>
        <p class="shortlist__intro-body">Character over scale, and a stronger sense of place than generic accommodation stock.</p>
        <a href={`${base}stay/`} class="shortlist__intro-link">All Peninsula stays
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">Keep <em>browsing</em>.</h2>
      </div>
      <a href={`${base}stay/`} class="well__head-link">All Stay →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}stay/luxury/`}><h3 class="venue__name">Luxury</h3></a>
        <p class="venue__sig">Design hotels, vineyard villas, and refined coastal stays.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}stay/couples/`}><h3 class="venue__name">Couples</h3></a>
        <p class="venue__sig">The stays that work best for two-night escapes and slower Peninsula weekends.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}stay/where-to-stay-mornington-peninsula/`}><h3 class="venue__name">Where to Base Yourself</h3></a>
        <p class="venue__sig">The practical Peninsula logic behind Sorrento, Red Hill, Flinders, and Mornington.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
