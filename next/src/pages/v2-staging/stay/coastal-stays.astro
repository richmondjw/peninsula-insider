---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const stayTypes = ['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'];

const coastalZones = ['tip', 'ocean-coast', 'back-beaches'];
const coastalStays = allVenues.filter((v) =>
  stayTypes.includes(v.data.type) &&
  coastalZones.includes(v.data.zone)
);

const preferredOrder = [
  'the-continental-sorrento',
  'hotel-sorrento',
  'flinders-hotel',
  'peninsula-hot-springs-glamping',
  'peninsula-hot-springs',
  'one-spa-racv-cape-schanck',
];

const sortedCoastalStays = [
  ...preferredOrder.map((s) => coastalStays.find((v) => routeSlug(v) === s)).filter((v): v is NonNullable<typeof v> => Boolean(v)),
  ...coastalStays.filter((v) => !preferredOrder.includes(routeSlug(v))),
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Coastal Stays Mornington Peninsula',
  description: 'Coastal accommodation on the Mornington Peninsula — ocean-side hotels, boutique village stays, and back-beach properties in Sorrento, Flinders, and Cape Schanck.',
  url: 'https://peninsulainsider.com.au/stay/coastal-stays/',
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: sortedCoastalStays.length,
    itemListElement: sortedCoastalStays.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.data.name,
      url: `https://peninsulainsider.com.au/stay/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is the best place to stay near the ocean on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sorrento is the strongest base for a coastal stay — The Continental Sorrento and Hotel Sorrento both sit on the main street with the ocean baths a short walk away. The back beach (ocean surf beach) is 10 minutes by car. Sorrento Coastal Retreat adds a more private option close to the bay. Flinders Hotel is the south coast alternative — quieter, less tourist infrastructure, directly above the Flinders pier and fishing boats.' },
    },
    {
      '@type': 'Question',
      name: 'Can you walk to the beach from the Peninsula hotels?',
      acceptedAnswer: { '@type': 'Answer', text: 'Hotel Sorrento and The Continental Sorrento are both within easy walking distance of the Sorrento ocean baths (bay beach). The back ocean beach is a short drive. Flinders Hotel is directly opposite the Flinders pier and a short walk to the back beach at Flinders Point. Peninsula Hot Springs Glamping is not walking distance to the beach — it is an inland thermal springs experience.' },
    },
    {
      '@type': 'Question',
      name: 'Is Sorrento or Portsea better for a coastal stay?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sorrento has more dining options, accommodation variety, and village infrastructure — better for a first visit or when you want dinner options without driving. Portsea is quieter and more private — the Portsea Hotel overlooks the bay, and the area suits those who want less activity and more seclusion. The two are 8 minutes apart and you can easily use both on the same trip.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Coastal Stays Mornington Peninsula · Peninsula Insider"
  description="Coastal accommodation on the Mornington Peninsula — hotel stays in Sorrento, south coast options at Flinders and Cape Schanck, and back-beach properties for ocean weekends."
  section="stay"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Coastal Stays on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}stay/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Stay</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Coastal Stays <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">Coastal stays on the <em>Mornington Peninsula</em>.</h1>
        <p class="hero__dek">The Peninsula has two distinct coasts. Bay side is calm water, limestone cliffs, and village dining. Ocean side is surf beaches, strong winds, and working fishing villages. This is the full list of stays on both.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#sorrento-tip" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{sortedCoastalStays.length} stays</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-sorrento-01.webp`} alt="Sorrento main street and bay edge" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Sorrento <span class="ornament">—</span> the centre of the bay-coast stay map</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Two coasts, two <em>different trips</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula has two distinct coasts, and they produce quite different trips. The bay coast (Port Phillip side) is calm water, limestone cliffs, and village dining — Sorrento is the centre of this version. The ocean coast (Bass Strait side) is surf beaches, strong prevailing winds, and working fishing villages — Flinders is the centre here, Cape Schanck at the southern tip is the most dramatic.</p>
          <p>The Continental Sorrento and Hotel Sorrento sit at the village end of Sorrento's main street, with the ocean baths a short walk away. Both suit couples who want a proper hotel stay with easy restaurant access. For a quieter coastal experience, the Sorrento Coastal Retreat gives bay views without the main-street activity.</p>
          <p>Flinders Hotel is the south coast benchmark: a proper country pub with good rooms, directly opposite the pier, in a village that has resisted the temptation to become a weekend destination. That resistance is the point.</p>
          <p style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 24 April 2026</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-flinders-01.webp`} alt="Flinders pier">
        <figcaption class="letter__image-cap">Flinders pier <em>— the south coast version of the stay map.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="sorrento-tip" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{sortedCoastalStays.length} coastal stays across the <em>Peninsula</em>.</h2>
        <p class="shortlist__intro-body">Village hotels, coastal retreats, and south-coast properties — Sorrento-tip properties first, then the south coast at Flinders and Cape Schanck.</p>
        <a href={`${base}places/sorrento/`} class="shortlist__intro-link">Sorrento guide
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {sortedCoastalStays.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The questions we <em>get asked</em>.</h2>
        <div class="letter__prose">
          <p><strong>Best coastal stay near the ocean?</strong><br>Sorrento for dining, village atmosphere, and easy beach access — The Continental and Hotel Sorrento both work well. Flinders Hotel for the south coast version: quieter, directly above the pier, working fishing village that hasn't been completely polished for tourism.</p>
          <p><strong>Can you walk to the beach from the hotels?</strong><br>Hotel Sorrento and The Continental are walking distance to the Sorrento ocean baths (bay side). The back ocean beach is a 10-minute drive. Flinders Hotel is a short walk to the Flinders pier and back beach at Flinders Point.</p>
          <p><strong>Sorrento or Portsea?</strong><br>Sorrento for more dining options and village infrastructure — better for a first visit. Portsea for quieter and more private. The two are 8 minutes apart; use Sorrento as a base and Portsea as an excursion.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More for the <em>coastal weekend</em>.</h2>
      </div>
      <a href={`${base}stay/`} class="well__head-link">All Stay →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}places/sorrento/`}><h3 class="venue__name">Sorrento Guide</h3></a>
        <p class="venue__sig">The complete Sorrento hub — beaches, restaurants, walks, and where to stay.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}explore/`}><h3 class="venue__name">Walks &amp; Exploration</h3></a>
        <p class="venue__sig">The best walking tracks, coastal paths, and lookouts across the Peninsula.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/best-accommodation/`}><h3 class="venue__name">Best Accommodation</h3></a>
        <p class="venue__sig">All Peninsula stays ranked across price bands and weekend types.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
