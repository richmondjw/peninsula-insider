---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import V2VenueDetail from '../../../components/v2/V2VenueDetail.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../../lib/editorial';

export async function getStaticPaths() {
  const stayTypes = ['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'];
  const venues = await getCollection('venues');
  return venues
    .filter((venue) => stayTypes.includes(venue.data.type))
    .map((venue) => ({
      params: { slug: routeSlug(venue) },
      props: { venue },
    }));
}

const stayTypes = ['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'];
const { venue } = Astro.props;
const slug = routeSlug(venue);

const allVenues = await getCollection('venues');
const related = allVenues
  .filter((entry) => routeSlug(entry) !== slug)
  .filter((entry) => stayTypes.includes(entry.data.type))
  .slice(0, 3);

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .filter((article) =>
    article.data.relatedVenues.some((entry: any) => String(entry.id ?? entry) === slug)
  )
  .slice(0, 3);
export const prerender = true;
---
<BaseLayout
  title={`${venue.data.name} — Peninsula Insider`}
  description={venue.data.signature}
  section="stay"
  ogImage={venue.data.heroImage?.src}
>
  <V2VenueDetail venue={venue} section="stay" related={related} articles={articles} />
  <NewsletterBlock />
</BaseLayout>
