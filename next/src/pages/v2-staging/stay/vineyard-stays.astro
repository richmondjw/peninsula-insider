---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const stayTypes = ['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'];

const ridgeZones = ['red-hill-plateau', 'hinterland'];
const vineyardSlugs = [
  'jackalope',
  'polperro-villas',
  'point-leo-estate-villas',
  'lindenderry',
  'crittenden-villas',
  'spa-by-jackalope',
];

const venues = vineyardSlugs
  .map((s) => allVenues.find((v) => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v) && stayTypes.includes(v.data.type));

const extraRidgeStays = allVenues.filter((v) =>
  stayTypes.includes(v.data.type) &&
  ridgeZones.includes(v.data.zone) &&
  !vineyardSlugs.includes(routeSlug(v))
);
const allVineyardStays = [...venues, ...extraRidgeStays];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Vineyard Stays Mornington Peninsula',
  description: 'Vineyard stays and winery accommodation on the Mornington Peninsula — where cellar doors, long lunches, and beds are on the same property or within walking distance.',
  url: 'https://peninsulainsider.com.au/stay/vineyard-stays/',
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: allVineyardStays.length,
    itemListElement: allVineyardStays.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.data.name,
      url: `https://peninsulainsider.com.au/stay/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Which Mornington Peninsula winery has accommodation?', acceptedAnswer: { '@type': 'Answer', text: 'Jackalope Hotel sits inside a working Merricks North vineyard with Doot Doot Doot on site. Polperro Villas are estate villas attached to the Polperro winery in Red Hill. Point Leo Estate Villas adjoin the Pt. Leo Estate sculpture park and winery. Lindenderry at Red Hill is a boutique hotel on a small vineyard. Crittenden Estate has self-contained villas on the estate grounds.' } },
    { '@type': 'Question', name: 'Which part of the Mornington Peninsula is wine country?', acceptedAnswer: { '@type': 'Answer', text: 'Red Hill, Main Ridge, and Merricks North on the central plateau are the wine country core. The elevation, cool-climate conditions, and concentration of cellar doors here are what makes Mornington Peninsula Pinot Noir and Chardonnay distinctive. Staying in this zone puts you within minutes of 20+ cellar doors.' } },
    { '@type': 'Question', name: 'How long do I need for a vineyard stay on the Mornington Peninsula?', acceptedAnswer: { '@type': 'Answer', text: 'Two nights is the natural unit. Day one: arrive, check in, afternoon cellar door session, dinner at the property restaurant. Day two: morning walk, two or three cellar doors, a long vineyard lunch (book Doot Doot Doot, Tedesca, or Laura in advance). Drive home Sunday evening. One night is doable but rushed — you end up spending most of Saturday driving.' } },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Vineyard Stays Mornington Peninsula · Peninsula Insider"
  description="Vineyard accommodation and winery stays on the Mornington Peninsula — from Jackalope's design-hotel to private estate villas where the cellar door is next door."
  section="stay"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Vineyard Stays on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}stay/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Stay</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Vineyard stays <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">Vineyard stays on the <em>Mornington Peninsula</em>.</h1>
        <p class="hero__dek">A 20-kilometre belt of plateau running through Red Hill, Main Ridge, and Merricks North. Staying here changes what the weekend is.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#vineyard-stays" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{allVineyardStays.length} stays</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-main-ridge-01.webp`} alt="Main Ridge vineyards" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Main Ridge <span class="ornament">—</span> the wine-country stay belt</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Cellar doors as a <em>walk</em>, not a drive.</h2>
        <div class="letter__prose">
          <p>The Peninsula's wine country is a 20-kilometre belt of plateau running through Red Hill, Main Ridge, and Merricks North. Staying in this zone changes what the weekend is — cellar doors become a morning walk rather than a drive, vineyard lunches are the main event rather than a detour, and the ridge light at dusk is what you came for.</p>
          <p>Jackalope is the design-hotel benchmark: a black-steel structure set inside a working vineyard with one of Victoria's most ambitious dining rooms. Polperro and Point Leo Estate Villas offer the more private version — self-contained on a working estate, close to serious winemaking. Lindenderry and Hillview Cottages give the boutique-hotel and cottage register that suits those who want character over spectacle.</p>
          <p>If you're spending two nights on the Peninsula and wine is the main reason, these are the properties that make the trip hold together.</p>
          <p style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 24 April 2026</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Hill ridge">
        <figcaption class="letter__image-cap">Red Hill ridge <em>— autumn, the quiet version.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="vineyard-stays" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{allVineyardStays.length} properties on or near the <em>ridge</em>.</h2>
        <p class="shortlist__intro-body">Estate villas and boutique hotels where the cellar door is either on site or within a short walk along vineyard rows.</p>
        <a href={`${base}wine/`} class="shortlist__intro-link">Wine country
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {allVineyardStays.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">Frequently <em>asked</em>.</h2>
        <div class="letter__prose">
          <p><strong>Which winery has accommodation on the Peninsula?</strong><br>Jackalope Hotel (Merricks North vineyard), Polperro Villas (Red Hill estate), Point Leo Estate Villas (sculpture park and winery), Lindenderry at Red Hill (boutique vineyard hotel), and Crittenden Estate (self-contained villas on the estate).</p>
          <p><strong>Which part of the Peninsula is wine country?</strong><br>Red Hill, Main Ridge, and Merricks North on the central plateau. The elevation and cool-climate conditions here are what produces Mornington Pinot Noir and Chardonnay with the character that's made the region internationally credentialled. Staying in this zone puts you within minutes of 20+ cellar doors.</p>
          <p><strong>How long do I need?</strong><br>Two nights. Day one: arrive, afternoon cellar door session, dinner on the property. Day two: morning walk, two or three cellar doors, a long vineyard lunch (book ahead). Drive home Sunday evening. One night is doable but leaves most of Saturday dedicated to travel.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">Complete the wine country <em>weekend</em>.</h2>
      </div>
      <a href={`${base}stay/`} class="well__head-link">All Stay →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}wine/`}><h3 class="venue__name">Wine Country Guide</h3></a>
        <p class="venue__sig">Every cellar door on the Peninsula with opening hours, food, and honest notes.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}eat/cellar-door-lunch/`}><h3 class="venue__name">Cellar Door Lunch</h3></a>
        <p class="venue__sig">The best winery restaurants where kitchen and cellar door are the same experience.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/best-accommodation/`}><h3 class="venue__name">Best Accommodation</h3></a>
        <p class="venue__sig">All Peninsula stays ranked by editorial authority across every price band.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
