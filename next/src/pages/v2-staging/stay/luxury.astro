---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const slugs = ['jackalope','lindenderry','the-continental-sorrento','point-leo-estate-villas','polperro-villas','crittenden-villas','peninsula-hot-springs-glamping','hotel-sorrento'];
const venues = slugs.map((slug) => allVenues.find((venue) => routeSlug(venue) === slug)).filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Luxury Accommodation Mornington Peninsula',
  description: 'The best luxury accommodation on the Mornington Peninsula, from design hotels and vineyard villas to refined coastal stays.',
  url: 'https://peninsulainsider.com.au/stay/luxury/',
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((venue, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: venue.data.name,
      url: `https://peninsulainsider.com.au/stay/${routeSlug(venue)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is the best luxury stay on the Mornington Peninsula?', acceptedAnswer: { '@type': 'Answer', text: 'Jackalope is the Peninsula\'s most distinct luxury hotel if you want design, drama, and a wine-country base. Lindenderry is the quieter classic for a slower Red Hill weekend. The Continental and Hotel Sorrento are the strongest options if you want refined coastal access at the tip.' } },
    { '@type': 'Question', name: 'Should I stay in Red Hill or Sorrento for a luxury Peninsula weekend?', acceptedAnswer: { '@type': 'Answer', text: 'Stay in Red Hill if the weekend is built around wine, lunches, and hinterland pace. Stay in Sorrento if you want village atmosphere, bay and ocean access, and the strongest walkable coastal base. The right answer depends on what the trip is for, not which postcode sounds grander.' } },
    { '@type': 'Question', name: 'Are the Peninsula\'s best luxury stays hotels or villas?', acceptedAnswer: { '@type': 'Answer', text: 'Both. Hotels like Jackalope, Lindenderry, Hotel Sorrento, and The Continental work best when service, dining, and easy flow matter. Villas like Point Leo Estate Villas, Polperro Villas, and Crittenden Estate Villas work better when privacy, vineyard setting, and a slower self-contained rhythm matter more.' } },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Luxury Accommodation Mornington Peninsula · Peninsula Insider"
  description="The best luxury accommodation on the Mornington Peninsula, from Jackalope and Lindenderry to vineyard villas and refined coastal stays in Sorrento."
  section="stay"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Luxury Accommodation on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}stay/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Stay</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Luxury <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">Luxury accommodation on the <em>Mornington Peninsula</em>.</h1>
        <p class="hero__dek">The Peninsula does luxury best when it stops trying to impersonate an international resort strip. The strongest stays are rooted in the landscape — vineyard, ridge, ocean edge, village main street.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} stays</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Hill luxury vineyard country" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Hill <span class="ornament">—</span> the hinterland luxury map</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Rooted in the <em>landscape</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula does luxury best when it stops trying to impersonate an international resort strip. The strongest stays here are either rooted in the landscape — vineyard, ridge, ocean edge, village main street — or they are not especially interesting. A good Peninsula luxury stay should shape the whole weekend, not just provide a handsome room key.</p>
          <p>That usually means one of two modes. The first is hinterland luxury, where the trip leans into wine, long lunches, fireplaces, and slower mornings, with Jackalope, Lindenderry, Point Leo Estate Villas, and Polperro Villas doing the heavy lifting. The second is coastal luxury, where the base matters because it decides the rhythm of the trip, and The Continental and Hotel Sorrento become the right answer.</p>
          <p>The question is not simply what is most expensive. It is what gives the Peninsula weekend the right shape.</p>
          <p style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 24 April 2026</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-sorrento-01.webp`} alt="Sorrento main street">
        <figcaption class="letter__image-cap">Sorrento <em>— the coastal luxury map.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} luxury stays worth <em>prioritising</em>.</h2>
        <p class="shortlist__intro-body">Design hotels, vineyard villas, and the coastal properties that genuinely shape a Peninsula weekend well.</p>
        <a href={`${base}stay/`} class="shortlist__intro-link">All Peninsula stays
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">How to choose well</span>
        </div>
        <h2 class="letter__head" id="faq-title">How to <em>choose</em> well.</h2>
        <div class="letter__prose">
          <p><strong>Red Hill or Sorrento?</strong><br>Red Hill is the right base when the weekend is about wine, long lunches, and a slower food-led Peninsula. Sorrento is the right base when the weekend is about village atmosphere, walking, bay and ocean access, and a stronger sense of arrival.</p>
          <p><strong>Hotel or villa?</strong><br>Choose a hotel if you want service, restaurant access, and easier flow. Choose a villa if privacy, vineyard setting, and a more self-contained long-weekend rhythm matter more than formal hotel infrastructure.</p>
          <p><strong>The publication's view.</strong><br>Jackalope is still the Peninsula's most singular luxury hotel expression. Lindenderry is the calmer, more classic counterpoint. Point Leo Estate Villas and Polperro Villas make the strongest case for luxury through place rather than spectacle.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">Build the <em>weekend</em> properly.</h2>
      </div>
      <a href={`${base}stay/`} class="well__head-link">All Stay →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/couples/`}><h3 class="venue__name">Couples Accommodation</h3></a>
        <p class="venue__sig">The stays that work best for two-night escapes, anniversaries, and slower Peninsula weekends.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/winery-accommodation/`}><h3 class="venue__name">Winery Accommodation</h3></a>
        <p class="venue__sig">Where to stay when the trip is built around cellar doors, lunch, and the hinterland.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/where-to-stay-mornington-peninsula/`}><h3 class="venue__name">Where to Base Yourself</h3></a>
        <p class="venue__sig">The practical Peninsula logic behind Sorrento, Red Hill, Flinders, Mornington, and beyond.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
