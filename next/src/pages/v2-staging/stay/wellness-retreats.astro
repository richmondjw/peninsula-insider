---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const stayTypes = ['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'];

const wellnessSlugs = [
  'peninsula-hot-springs',
  'peninsula-hot-springs-glamping',
  'spa-by-jackalope',
  'alba-thermal-springs',
  'one-spa-racv-cape-schanck',
  'endota-spa-mornington',
];

const venues = wellnessSlugs
  .map((s) => allVenues.find((v) => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

const wellnessStaySlugs = [
  'peninsula-hot-springs-glamping',
  'jackalope',
  'lindenderry',
  'hillview-cottages',
  'flinders-hotel',
];
const wellnessStays = wellnessStaySlugs
  .map((s) => allVenues.find((v) => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v) && stayTypes.includes(v.data.type));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Wellness Retreats Mornington Peninsula',
  description: 'Spa stays, thermal springs, and wellness retreats on the Mornington Peninsula — from Peninsula Hot Springs glamping to Spa by Jackalope and RACV Cape Schanck.',
  url: 'https://peninsulainsider.com.au/stay/wellness-retreats/',
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.data.name,
      url: `https://peninsulainsider.com.au/stay/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is Peninsula Hot Springs and can you stay there?', acceptedAnswer: { '@type': 'Answer', text: 'Peninsula Hot Springs is a large geothermal bathing complex near Rye with more than 50 pools. The Springs itself is a day-visit experience — you cannot stay inside the facility — but Peninsula Hot Springs Glamping operates directly adjacent and gives overnight guests priority entry and a quieter experience of the pools in the evening and early morning.' } },
    { '@type': 'Question', name: 'Is there a full spa retreat on the Mornington Peninsula?', acceptedAnswer: { '@type': 'Answer', text: 'Spa by Jackalope at Jackalope Hotel (Red Hill) is the most comprehensive resort spa on the Peninsula: six treatment rooms, a thermal suite, scrub rooms, and access to the hotel\'s private bathing facilities. One Spa at RACV Cape Schanck Resort is a full-service spa with ocean views on the south coast. Both require property bookings or day-spa appointments.' } },
    { '@type': 'Question', name: 'What is the difference between Peninsula Hot Springs and Alba Thermal Springs?', acceptedAnswer: { '@type': 'Answer', text: 'Peninsula Hot Springs (Rye) is the larger public facility — geothermal water, 50+ pools, family-friendly, day-visit focused. Alba Thermal Springs (Red Hill) is the newer, more design-conscious property: a smaller, curated experience with cave pools, cold plunge, and a stronger focus on the adult wellness experience. Alba is quieter and better suited to a couple\'s retreat day.' } },
    { '@type': 'Question', name: 'Can I do a wellness weekend on the Mornington Peninsula without a car?', acceptedAnswer: { '@type': 'Answer', text: 'It is difficult. The wellness properties are spread across the Peninsula and public transport connections between them are limited. Peninsula Hot Springs runs a shuttle from Frankston station on weekends. For a car-free wellness stay, the best option is Jackalope Hotel and Spa by Jackalope — the hotel, spa, and Doot Doot Doot dining room are all on the same property and you can walk between them.' } },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Wellness Retreats Mornington Peninsula · Peninsula Insider"
  description="Spa stays and wellness retreats on the Mornington Peninsula — Peninsula Hot Springs glamping, Spa by Jackalope, Alba Thermal Springs, and day spas worth staying for."
  section="stay"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Wellness Retreats on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}stay/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Stay</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Wellness retreats <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">Wellness retreats on the <em>Mornington Peninsula</em>.</h1>
        <p class="hero__dek">More serious than most people expect. Peninsula Hot Springs is the largest geothermal bathing complex in the southern hemisphere. Alba is the newer design-led alternative. Spa by Jackalope is a full resort spa.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#thermal-springs" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} properties</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-cape-schanck-01.webp`} alt="Cape Schanck coastline" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Fingal &amp; Cape Schanck <span class="ornament">—</span> wellness country</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Not the hotel-spa <em>afterthought</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula's wellness infrastructure is more serious than most people expect before they arrive. Peninsula Hot Springs is the largest geothermal bathing complex in the southern hemisphere. Alba Thermal Springs at Red Hill is a newer, design-led alternative with a more curated adult experience. Spa by Jackalope is a full resort spa operating at Jackalope Hotel on the wine ridge. RACV Cape Schanck's One Spa adds an ocean-view treatment experience on the south coast.</p>
          <p>None of these feel like the hotel-spa-as-afterthought that fills most resort brochures. They're the primary reason many people come. The question is whether you want the thermal bathing experience centred (Peninsula Hot Springs, Alba), the spa-as-luxury-hotel experience (Jackalope, Cape Schanck), or something more restorative and slow (glamping adjacent to the springs, cottage with private garden).</p>
          <p style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 24 April 2026</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Hill plateau">
        <figcaption class="letter__image-cap">Red Hill <em>— home of Alba and Spa by Jackalope.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="thermal-springs" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} wellness properties on the <em>Peninsula</em>.</h2>
        <p class="shortlist__intro-body">From geothermal bathing complexes to resort spas — ordered by the depth of the overnight wellness experience each offers.</p>
        <a href={`${base}spa/`} class="shortlist__intro-link">Spa guide
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="dept" id="stays-for-wellness" aria-labelledby="stays-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Stay nearby</span>
        <h2 class="dept__title" id="stays-title">Accommodation that pairs well with a <em>wellness day</em>.</h2>
        <p class="dept__dek">When the spa or springs is the day's main event, the right overnight base means you don't have to drive home tired.</p>
      </div>
    </div>
    <div class="dept__grid">
      {wellnessStays.map((v) => {
        const data = v.data;
        const hats = data.authority?.hats ?? 0;
        const hero = data.heroImage?.src;
        const place = placeLabel(data.place);
        const type = typeLabel[data.type] ?? data.type;
        return (
          <article class="venue">
            <div class="venue__image" style={hero ? `background-image:url(${hero});background-size:cover;background-position:center;` : ''}>
              <span class="venue__image-marker">{type}</span>
              {hats > 0 && <span class="venue__image-hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
            </div>
            <div class="venue__meta">
              <span>{place}</span>
              <span class="venue__meta-sep"></span>
              <span>{data.priceBand}</span>
            </div>
            <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{data.name}</h3></a>
            <p class="venue__sig">{data.signature}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">Frequently <em>asked</em>.</h2>
        <div class="letter__prose">
          <p><strong>Can you stay at Peninsula Hot Springs?</strong><br>The Springs itself is a day-visit facility — you cannot stay inside the complex. Peninsula Hot Springs Glamping operates adjacent to the property and gives overnight guests priority entry. It's the closest overnight option to the pools.</p>
          <p><strong>Peninsula Hot Springs vs Alba Thermal Springs?</strong><br>Peninsula Hot Springs (Rye): larger, more varied, family-friendly, geothermal water. Alba Thermal Springs (Red Hill): smaller, design-conscious, adult-focused, cave pools and cold plunge. Alba suits couples better. Peninsula Hot Springs is better for a first visit or a group.</p>
          <p><strong>Where's the best full resort spa?</strong><br>Spa by Jackalope (Red Hill) — six treatment rooms, thermal suite, and the whole Jackalope Hotel experience around it. One Spa at RACV Cape Schanck offers a full-service spa with ocean views on the south coast.</p>
          <p><strong>Is a car needed for a wellness weekend?</strong><br>Almost always. Peninsula Hot Springs runs a weekend shuttle from Frankston station. Jackalope Hotel and Spa by Jackalope are co-located so you can walk between them — the only car-free wellness stay option on the Peninsula.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">Plan the wellness <em>weekend</em>.</h2>
      </div>
      <a href={`${base}stay/`} class="well__head-link">All Stay →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}spa/`}><h3 class="venue__name">Spa Guide</h3></a>
        <p class="venue__sig">Every spa on the Peninsula with honest notes on which is worth the spend.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/couples-retreats/`}><h3 class="venue__name">Couples Retreats</h3></a>
        <p class="venue__sig">Romantic accommodation across the Peninsula for anniversary and honeymoon stays.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/best-accommodation/`}><h3 class="venue__name">Best Accommodation</h3></a>
        <p class="venue__sig">All Peninsula stays ranked by editorial authority across every price band.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
