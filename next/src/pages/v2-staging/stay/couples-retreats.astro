---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const stayTypes = ['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'];

const romanticSlugs = [
  'jackalope',
  'polperro-villas',
  'point-leo-estate-villas',
  'the-continental-sorrento',
  'crittenden-villas',
  'lindenderry',
  'peninsula-hot-springs-glamping',
  'hotel-sorrento',
];

const venues = romanticSlugs
  .map((s) => allVenues.find((v) => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v) && stayTypes.includes(v.data.type));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Couples Retreats Mornington Peninsula',
  description: 'Romantic accommodation and couples retreats on the Mornington Peninsula — vineyard villas, heritage hotels, and coastal stays for anniversaries, honeymoons, and long weekends together.',
  url: 'https://peninsulainsider.com.au/stay/couples-retreats/',
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.data.name,
      url: `https://peninsulainsider.com.au/stay/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the most romantic place to stay on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Jackalope Hotel (Red Hill) is the most dramatic option — a design-hotel set inside a working vineyard with a two-hat dining room and oversized baths. Polperro Villas and Point Leo Estate Villas are better for couples who want privacy over spectacle: self-contained estate villas with vineyard views and no shared common areas. For coastal romance, the Sorrento Coastal Retreat or The Continental Sorrento put you on the water\'s edge with easy access to back beach walks and sunset dinners.' },
    },
    {
      '@type': 'Question',
      name: 'Where should I take my partner for a weekend on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Two nights at a Red Hill vineyard stay (Jackalope, Polperro Villas, or Lindenderry) is the classic Peninsula couple\'s weekend — cellar door afternoon, long vineyard lunch, thermal springs on the second morning. For a coast-focused version: base in Sorrento, swim at the back beach, walk the coastal path, and book dinner at Bistro Elba or Hotel Sorrento. Match the stay to the weekend shape you actually want rather than picking a property and working backwards.' },
    },
    {
      '@type': 'Question',
      name: 'What is the best Peninsula stay for an anniversary?',
      acceptedAnswer: { '@type': 'Answer', text: 'For a significant anniversary, Jackalope is the answer — it was built to feel like an occasion. Book Doot Doot Doot (one hat) for dinner and the Flaggerdoot bar for nightcaps. For a more personal and less performative anniversary, Tedesca Osteria\'s farm setting plus a nearby villa stay has a warmer quality. The Continental Sorrento has a landmark heritage ballast if the big coastal hotel suits the occasion.' },
    },
    {
      '@type': 'Question',
      name: 'Do Mornington Peninsula stays include hot tubs or private baths?',
      acceptedAnswer: { '@type': 'Answer', text: 'Several do. Jackalope Hotel rooms are known for oversized freestanding baths. Polperro Villas and Point Leo Estate Villas have private outdoor spaces and bath setups. The Peninsula Hot Springs Glamping has access to private thermal pools. Check individual properties — bath and private outdoor bath details vary by room type at most estates.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Couples Retreats Mornington Peninsula · Peninsula Insider"
  description="Romantic accommodation and couples retreats on the Mornington Peninsula — vineyard villas, boutique hotels, and coastal stays for anniversaries, honeymoons, and weekends away."
  section="stay"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Couples Retreats on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}stay/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Stay</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Couples Retreats <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">Couples retreats on the <em>Mornington Peninsula</em>.</h1>
        <p class="hero__dek">The best couples' stays here work because they remove planning pressure — the cellar door is next to the bedroom, the restaurant is downstairs, and the itinerary largely arranges itself once you're in the right place.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#couples-stays" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} stays</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Hill vineyard" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Hill vineyards <span class="ornament">—</span> the slow version of the couples' map</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Remove <em>planning pressure</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula doesn't try to be a resort destination. The best couples' stays here work because they remove planning pressure — the cellar door is next to the bedroom, the vineyard restaurant is downstairs, the thermal springs are a short drive, and the itinerary largely arranges itself once you're in the right place.</p>
          <p>Jackalope is the cinematic choice: a design hotel that operates at an event register, best when the trip needs to feel like an occasion. Polperro and Point Leo Estate Villas are more private — self-contained on working estates, with vineyard views and no shared corridors to navigate. Lindenderry runs at a slightly warmer frequency: a boutique hotel on a small vineyard that works for couples who want a room with character rather than spectacle.</p>
          <p>For coast-focused weekends, Hotel Sorrento and The Continental are the main-street village hotel options. Sorrento Coastal Retreat suits those who want seclusion close to the ocean.</p>
          <p style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 24 April 2026</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-main-ridge-01.webp`} alt="Main Ridge vineyard rows">
        <figcaption class="letter__image-cap">Main Ridge <em>— vineyard quiet at dusk.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="couples-stays" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} Peninsula stays for <em>couples</em>.</h2>
        <p class="shortlist__intro-body">From vineyard estate villas to heritage hotels on the water — ordered by how private and self-contained each option is.</p>
        <a href={`${base}stay/`} class="shortlist__intro-link">All Peninsula stays
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">Frequently <em>asked</em>.</h2>
        <div class="letter__prose">
          <p><strong>Most romantic place to stay?</strong><br>Jackalope (Red Hill) for dramatic design and on-site dining. Polperro Villas and Point Leo Estate Villas for private estate-villa seclusion. Sorrento Coastal Retreat or The Continental for coastal romance with ocean access and back beach walks within reach.</p>
          <p><strong>Best for an anniversary?</strong><br>Jackalope if the trip needs to feel like an event. Lindenderry for a warmer, more personal register. For the most impressive setting in Victoria: Laura at Pt. Leo Estate for dinner (book four months ahead), combined with Point Leo Estate Villas for the stay.</p>
          <p><strong>Properties with private baths or outdoor soaking?</strong><br>Jackalope rooms feature oversized freestanding baths. Polperro and Point Leo Estate Villas have private outdoor spaces. Peninsula Hot Springs Glamping includes access to private thermal pools.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">Complete the <em>couples'</em> weekend.</h2>
      </div>
      <a href={`${base}stay/`} class="well__head-link">All Stay →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}eat/date-night/`}><h3 class="venue__name">Date Night Restaurants</h3></a>
        <p class="venue__sig">The intimate hatted rooms and vineyard settings best suited to a couple's dinner.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/wellness-retreats/`}><h3 class="venue__name">Wellness Retreats</h3></a>
        <p class="venue__sig">Spa stays, thermal springs, and the restorative layer of the Peninsula.</p>
      </article>
      <article class="venue">
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}stay/vineyard-stays/`}><h3 class="venue__name">Vineyard Stays</h3></a>
        <p class="venue__sig">Estate accommodation on or near the Red Hill plateau wine ridge.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
