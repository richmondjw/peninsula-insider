---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const slugs = ['polperro-villas','crittenden-villas','blue-moon-cottages','birch-creek'];
const venues = slugs.map((slug) => allVenues.find((venue) => routeSlug(venue) === slug)).filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Dog-Friendly Accommodation Mornington Peninsula · Peninsula Insider"
  description="Dog-friendly accommodation on the Mornington Peninsula, including coastal retreats, cottages, and selected vineyard stays that genuinely work with a dog."
  section="stay"
>

<section class="hero" aria-label="Dog-Friendly Accommodation on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}stay/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Stay</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Dog-friendly <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">Dog-friendly accommodation on the <em>Mornington Peninsula</em>.</h1>
        <p class="hero__dek">The right accommodation does more than permit a pet. It reduces friction across the whole weekend — because the Peninsula's dog logic is uneven everywhere else.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} stays</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Hill hinterland" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Hinterland <span class="ornament">—</span> the easiest version of a Peninsula dog weekend</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Note</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Reduce <em>friction</em>.</h2>
        <div class="letter__prose">
          <p>Dog-friendly stays on the Peninsula matter because the region's dog logic is uneven. Some beaches are friendly, some are not. Some wineries welcome dogs outdoors, many do not. The right accommodation therefore does more than permit a pet. It reduces friction across the whole weekend.</p>
          <p>The strongest dog-friendly stay choices tend to be self-contained properties or slower rural bases, where outdoor access, privacy, and easier arrival matter more than hotel formalities. Sorrento Coastal Retreat works for a tip-of-Peninsula stay with beach-town access. Hillview Farm Cottages fits a quieter hinterland rhythm. Polperro Villas and Crittenden Estate Villas are useful when the weekend leans food-and-wine but still needs a workable dog policy.</p>
          <p style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 24 April 2026</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-sorrento-01.webp`} alt="Sorrento coast">
        <figcaption class="letter__image-cap">Sorrento <em>— the coastal dog-friendly anchor.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} stays that work best when the <em>dog</em> is coming too.</h2>
        <p class="shortlist__intro-body">The practical answer is rarely the fanciest answer. It is the stay that makes the whole Peninsula plan easier.</p>
        <a href={`${base}journal/dog-friendly-mornington-peninsula/`} class="shortlist__intro-link">Dog guide
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
