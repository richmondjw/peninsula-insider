---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, stayTypes, currentSeason, seasonBlurb, placeLabel, typeLabel } from '../../../lib/editorial';

const venues = (await getCollection('venues'))
  .filter((venue) => stayTypes.includes(venue.data.type));
const itineraries = await getCollection('itineraries');
const places = await getCollection('places');

const season = currentSeason();
const blurb = seasonBlurb[season];

const featuredStaySlugs = ['jackalope', 'hotel-sorrento', 'flinders-hotel'];
const featuredStays = featuredStaySlugs
  .map((slug) => venues.find((venue) => routeSlug(venue) === slug))
  .filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));

const stayHubs = [
  { href: 'stay/luxury/', label: 'Luxury', sub: 'Design hotels, vineyard villas, refined coastal bases' },
  { href: 'stay/boutique-hotels/', label: 'Boutique Hotels', sub: 'Character stays in Flinders, Sorrento, and Red Hill' },
  { href: 'stay/winery-accommodation/', label: 'Winery Accommodation', sub: 'Stay where the long lunch actually happens' },
  { href: 'stay/couples/', label: 'Couples', sub: 'Stays that properly shape a weekend for two' },
  { href: 'stay/dog-friendly/', label: 'Dog-Friendly', sub: 'Useful stays when the dog is coming too' },
  { href: 'stay/glamping/', label: 'Glamping', sub: 'Thermal and experience-led stays' },
  { href: 'stay/villas/', label: 'Villas', sub: 'Private Peninsula bases with room to breathe' },
  { href: 'stay/cottages/', label: 'Cottages', sub: 'Slow rural weekends and fireplace logic' },
  { href: 'stay/resorts/', label: 'Resorts & Retreats', sub: 'Wellness, thermal, and retreat-style stays' },
  { href: 'stay/where-to-stay-mornington-peninsula/', label: 'Where to Base Yourself', sub: 'How to choose the right Peninsula zone' },
];

const ridgeZones = ['red-hill-plateau', 'hinterland'];
const coastZones = ['ocean-coast', 'back-beaches', 'tip'];
const bayZones = ['bayside'];
const ridgeStays = venues.filter((venue) => ridgeZones.includes(venue.data.zone));
const coastStays = venues.filter((venue) => coastZones.includes(venue.data.zone));
const bayStays = venues.filter((venue) => bayZones.includes(venue.data.zone));

const vineyardStays = venues.filter((venue) => {
  const moods: string[] = venue.data.tags?.mood ?? [];
  return moods.includes('cellar-door') || moods.includes('long-lunch') || ridgeZones.includes(venue.data.zone);
}).slice(0, 6);
const coastalStays = venues.filter((venue) => {
  const moods: string[] = venue.data.tags?.mood ?? [];
  return moods.includes('beach') || moods.includes('waterfront') || coastZones.includes(venue.data.zone);
}).slice(0, 6);
const wellnessStays = venues.filter((venue) => {
  const moods: string[] = venue.data.tags?.mood ?? [];
  return moods.includes('wellness') || venue.data.type === 'spa';
}).slice(0, 4);

const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const companionSlugs = [
  'where-to-stay-for-a-two-night-escape',
  'the-one-night-escape',
  'the-vineyard-villa-weekend',
  'the-thermal-springs-weekend',
];
const companionReads = companionSlugs
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const placeHighlights = places.filter((place) => ['red-hill', 'sorrento', 'flinders'].includes(routeSlug(place)));

const stayStats = {
  total: venues.length,
  ridge: ridgeStays.length,
  coast: coastStays.length,
  bay: bayStays.length,
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const stayZones = [
  {
    slug: 'red-hill-base',
    title: 'Red Hill / Merricks',
    x: '56%',
    y: '34%',
    label: `${stayStats.ridge} stays mapped`,
    suited: 'Long lunches, fireplaces, two-night couples weekends.',
    unlocks: 'Jackalope, Laura, Pt. Leo, Montalto, Main Ridge bakery runs.',
    pace: 'Best when the meal is the hero stop and the rest of the day stays slow.',
    href: `${base}stay/red-hill/`,
    action: 'Choose this base',
  },
  {
    slug: 'sorrento-base',
    title: 'Sorrento / Blairgowrie',
    x: '18%',
    y: '48%',
    label: `${stayStats.coast} coastal stays`,
    suited: 'Village weekends, beach access, easy people-watching, one-night resets.',
    unlocks: 'Hotel Sorrento, back beach walks, ferry edge, late bay light, tip dinners.',
    pace: 'Best when you want to park the car and let the southern end carry the mood.',
    href: `${base}stay/sorrento/`,
    action: 'Start on the tip',
  },
  {
    slug: 'flinders-base',
    title: 'Flinders / Cape Schanck',
    x: '71%',
    y: '60%',
    label: 'Southern reset',
    suited: 'Ocean weather, slower village energy, smarter one-night decompressions.',
    unlocks: 'Flinders Hotel, pier walks, Cape Schanck, southern wineries without the crowd.',
    pace: 'Best when you want the Peninsula to feel quieter and slightly wilder.',
    href: `${base}stay/flinders/`,
    action: 'Map this base',
  },
  {
    slug: 'mornington-base',
    title: 'Mornington / Mount Martha',
    x: '83%',
    y: '15%',
    label: `${stayStats.bay} bay-side bases`,
    suited: 'Shorter drives from Melbourne, practical family stays, easy first-timer access.',
    unlocks: 'Cliff walks, cafés, practical entry point, north-end flexibility.',
    pace: 'Best when the trip needs to feel easy from the first hour, not heroic.',
    href: `${base}stay/mornington/`,
    action: 'Keep it easy',
  },
];

---
<BaseLayout
  title="Where to Stay on the Mornington Peninsula · Peninsula Insider"
  description="Where to stay on the Mornington Peninsula — hotels, vineyard villas, coastal cottages, and farm stays. Every property visited and reviewed. Prices from $150/night. Updated April 2026."
  section="stay"
>

<section class="hero" aria-label="Where to Stay on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Stay</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Hotels <span class="ornament">·</span> Vineyard stays <span class="ornament">·</span> Coastal weekends</span>
        </div>
        <h1 class="hero__headline">Choose the base, and the whole <em>weekend</em> changes.</h1>
        <p class="hero__dek">The Peninsula is a region of different moods packed close together. A Red Hill country-house stay produces a different trip from a Sorrento main-street hotel. This hub sorts the beds by the kind of weekend you actually want.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#editors" class="hero__byline-read">Jump to picks <span style="opacity:.5;margin-left:.3rem;">{stayStats.total} stays</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-sorrento-01.webp`} alt="Vines inland · limestone coast beyond" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Vines inland <span class="ornament">—</span> limestone coast beyond</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="letter-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">How to choose</span>
        </div>
        <h2 class="letter__head" id="letter-title">Start with the <em>geography</em>, then pick the room.</h2>
        <div class="letter__prose">
          <p>Red Hill suits couples who want vineyard calm and long lunches nearby. Sorrento works when you want the social theatre of the tip and late light on the coast. Flinders is the quieter southern reset, better for one-night decompressions and ocean weather.</p>
          <p>{blurb.line}</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Hill plateau">
        <figcaption class="letter__image-cap">The ridge <em>— autumn, the quiet version.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="planning planning--base" aria-labelledby="base-planning-title">
  <div class="container">
    <div class="planning__frame">
      <div class="planning__intro">
        <span class="eyebrow eyebrow--ochre">Sandpit · Choose your base</span>
        <h2 class="planning__title" id="base-planning-title">Work out where to <em>wake up</em>, and the rest gets easier.</h2>
        <p class="planning__dek">This is the first stay-planning test. Instead of asking people to browse beds blindly, start with the pocket of the Peninsula that makes the whole weekend feel coherent.</p>
        <div class="planning__logic-list">
          <div class="planning__logic-item">
            <strong>What people need:</strong>
            <span>A fast answer to whether the weekend is a Red Hill lunch trip, a Sorrento village trip, a Flinders reset, or a simple north-end base.</span>
          </div>
          <div class="planning__logic-item">
            <strong>What the map does:</strong>
            <span>It turns abstract suburb names into a visual choice. You can immediately see whether the trip clusters around the ridge, the tip, or the northern bay side.</span>
          </div>
          <div class="planning__logic-item">
            <strong>What follows:</strong>
            <span>Once the base is obvious, the room choice becomes much less noisy.</span>
          </div>
        </div>
        <div class="planning__cta-row">
          <a class="planning__button planning__button--primary" href="#base-cards">Screenshot these stay zones</a>
          <a class="planning__button" href={`${base}stay/where-to-stay-mornington-peninsula/`}>Read the full base guide</a>
        </div>
      </div>

      <div class="planning__visual">
        <div class="planning-map planning-map--peninsula" aria-hidden="true">
          <div class="planning-map__canvas planning-map__canvas--zones">
            <div class="planning-map__cluster planning-map__cluster--north">
              <span>Easy from Melbourne</span>
              <small>Mornington side</small>
            </div>
            <div class="planning-map__cluster planning-map__cluster--ridgewide">
              <span>Food-and-wine corridor</span>
              <small>Red Hill to Merricks</small>
            </div>
            {stayZones.map((zone, index) => (
              <a
                class="planning-map__pin planning-map__pin--zone"
                href={`#${zone.slug}`}
                style={`--x:${zone.x};--y:${zone.y};`}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="planning__visual-note">The useful question here is not <strong>which hotel is nicest?</strong> It is <strong>which part of the Peninsula makes the trip easiest to love?</strong></div>
      </div>
    </div>

    <div class="planning-cards planning-cards--zones" id="base-cards">
      {stayZones.map((zone, index) => (
        <article class="planning-card planning-card--zone" id={zone.slug}>
          <div class="planning-card__number">{String(index + 1).padStart(2, '0')}</div>
          <div class="planning-card__body">
            <div class="planning-card__meta">
              <span>{zone.label}</span>
              <span class="planning-card__sep"></span>
              <span>{zone.title}</span>
            </div>
            <h3 class="planning-card__title planning-card__title--static">{zone.title}</h3>
            <p class="planning-card__text"><strong>Best for:</strong> {zone.suited}</p>
            <p class="planning-card__text"><strong>Unlocks:</strong> {zone.unlocks}</p>
            <p class="planning-card__text"><strong>Pace:</strong> {zone.pace}</p>
          </div>
          <div class="planning-card__actions">
            <a class="planning-card__link" href={zone.href}>{zone.action}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

{featuredStays.length > 0 && (
  <section class="shortlist" id="editors" aria-labelledby="featured-title">
    <div class="container">
      <div class="shortlist__frame">
        <div class="shortlist__intro">
          <span class="eyebrow eyebrow--ochre">Editor's Picks</span>
          <h2 id="featured-title">Three stays worth <em>planning</em> the trip around.</h2>
          <p class="shortlist__intro-body">From design-hotel spectacle to quieter village-hotel weekends — the rooms that change what the trip feels like.</p>
          <a href={`${base}journal/where-to-stay-for-a-two-night-escape/`} class="shortlist__intro-link">Editor's stay guide
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
          </a>
        </div>
        <ol class="shortlist__list" style="list-style:none;">
          {featuredStays.map((v, i) => {
            const data = v.data;
            const hats = data.authority?.hats ?? 0;
            const num = String(i + 1).padStart(2, '0');
            const place = placeLabel(data.place);
            const type = typeLabel[data.type] ?? data.type;
            return (
              <li class="sl-item">
                <span class="sl-item__num">{num}</span>
                <div class="sl-item__body">
                  <div class="sl-item__meta">
                    <span>{place}</span>
                    <span class="sl-item__meta-sep"></span>
                    <span>{type}</span>
                    <span class="sl-item__meta-sep"></span>
                    <span>{data.priceBand}</span>
                  </div>
                  <a href={`${base}stay/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                  <p class="sl-item__why">{data.signature}</p>
                  {hats > 0 && (
                    <div class="sl-item__tags">
                      <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>
)}

<section class="dept" aria-labelledby="hubs-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> I</span>
        <h2 class="dept__title" id="hubs-title">Browse by <em>stay type</em>.</h2>
        <p class="dept__dek">Start with the kind of Peninsula weekend you want, then move into the right properties and zones.</p>
      </div>
    </div>
    <div class="dept__grid">
      {stayHubs.map((hub) => (
        <article class="venue">
          <div class="venue__meta"><span>Guide</span></div>
          <a href={`${base}${hub.href}`}><h3 class="venue__name">{hub.label}</h3></a>
          <p class="venue__sig">{hub.sub}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{vineyardStays.length > 0 && (
  <section class="dept" id="vineyard" aria-labelledby="vineyard-title">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> II</span>
          <h2 class="dept__title" id="vineyard-title">Vineyard <em>weekends</em>.</h2>
          <p class="dept__dek">{stayStats.ridge} stays that make the Red Hill version of the Peninsula hold together — close to cellar doors, built for pinot pacing.</p>
        </div>
        <a href={`${base}wine/`} class="well__head-link">Wine country →</a>
      </div>
      <div class="dept__grid">
        {vineyardStays.map((v) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const hero = data.heroImage?.src;
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          return (
            <article class="venue">
              <div class="venue__image" style={hero ? `background-image:url(${hero});background-size:cover;background-position:center;` : ''}>
                <span class="venue__image-marker">{type}</span>
                {hats > 0 && <span class="venue__image-hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
              </div>
              <div class="venue__meta">
                <span>{place}</span>
                <span class="venue__meta-sep"></span>
                <span>{data.priceBand}</span>
              </div>
              <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{data.name}</h3></a>
              <p class="venue__sig">{data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{coastalStays.length > 0 && (
  <section class="dept" id="coastal" aria-labelledby="coastal-title">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> III</span>
          <h2 class="dept__title" id="coastal-title">Coastal <em>weekends</em>.</h2>
          <p class="dept__dek">{stayStats.coast} rooms that put you near limestone, open water, and the quieter southern end of the region.</p>
        </div>
        <a href={`${base}places/sorrento/`} class="well__head-link">Sorrento hub →</a>
      </div>
      <div class="dept__grid">
        {coastalStays.map((v) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const hero = data.heroImage?.src;
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          return (
            <article class="venue">
              <div class="venue__image" style={hero ? `background-image:url(${hero});background-size:cover;background-position:center;` : ''}>
                <span class="venue__image-marker">{type}</span>
                {hats > 0 && <span class="venue__image-hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
              </div>
              <div class="venue__meta">
                <span>{place}</span>
                <span class="venue__meta-sep"></span>
                <span>{data.priceBand}</span>
              </div>
              <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{data.name}</h3></a>
              <p class="venue__sig">{data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{wellnessStays.length > 0 && (
  <section class="dept" id="wellness" aria-labelledby="wellness-title">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> IV</span>
          <h2 class="dept__title" id="wellness-title">Wellness <em>&amp;</em> retreats.</h2>
          <p class="dept__dek">Springs, spa cabins, and farm-stay beds for the weekend that has to do more with less.</p>
        </div>
        <a href={`${base}journal/the-thermal-springs-weekend/`} class="well__head-link">Thermal springs guide →</a>
      </div>
      <div class="dept__grid">
        {wellnessStays.map((v) => {
          const data = v.data;
          const hero = data.heroImage?.src;
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          return (
            <article class="venue">
              <div class="venue__image" style={hero ? `background-image:url(${hero});background-size:cover;background-position:center;` : ''}>
                <span class="venue__image-marker">{type}</span>
              </div>
              <div class="venue__meta">
                <span>{place}</span>
                <span class="venue__meta-sep"></span>
                <span>{data.priceBand}</span>
              </div>
              <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{data.name}</h3></a>
              <p class="venue__sig">{data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<section class="dept" id="all" aria-labelledby="all-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">All stays</span>
        <h2 class="dept__title" id="all-title">Every bed currently <em>mapped</em>.</h2>
        <p class="dept__dek">From hotel to cottage. {blurb.line}</p>
      </div>
    </div>
    <div class="dept__grid">
      {venues.map((v) => {
        const data = v.data;
        const hats = data.authority?.hats ?? 0;
        const hero = data.heroImage?.src;
        const place = placeLabel(data.place);
        const type = typeLabel[data.type] ?? data.type;
        return (
          <article class="venue">
            <div class="venue__image" style={hero ? `background-image:url(${hero});background-size:cover;background-position:center;` : ''}>
              <span class="venue__image-marker">{type}</span>
              {hats > 0 && <span class="venue__image-hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
            </div>
            <div class="venue__meta">
              <span>{place}</span>
              <span class="venue__meta-sep"></span>
              <span>{data.priceBand}</span>
            </div>
            <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{data.name}</h3></a>
            <p class="venue__sig">{data.signature}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

{companionReads.length > 0 && (
  <section class="well" aria-labelledby="reads-title">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">From the Journal</span>
          <h2 class="well__head-title" id="reads-title" style="margin-top:.5rem;">Read the stay logic <em>before</em> you book.</h2>
        </div>
        <a href={`${base}journal/`} class="well__head-link">Journal →</a>
      </div>
      <div class="well__grid">
        {companionReads.map((article, i) => (
          <article class={`feat ${i === 0 ? 'feat--lead' : 'feat--std'}`}>
            {article.data.heroImage?.src && (
              <img class="feat__image" src={article.data.heroImage.src} alt={article.data.title}>
            )}
            <div class="feat__body">
              <div class="feat__eyebrow">Journal <span class="ornament">—</span> Stay</div>
              <a href={`${base}journal/${routeSlug(article)}/`}><h3 class="feat__title">{article.data.title}</h3></a>
              <p class="feat__excerpt">{article.data.excerpt ?? article.data.description ?? ''}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{placeHighlights.length > 0 && (
  <section class="places" aria-labelledby="places-title">
    <div class="container">
      <div class="places__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Choose the district</span>
          <h2 class="dept__title" id="places-title" style="margin-top:.5rem;">Browse stays through the <em>places</em> they belong to.</h2>
        </div>
        <a href={`${base}places/`} class="well__head-link">All places →</a>
      </div>
      <div class="places__grid">
        {placeHighlights.map((place) => {
          const hero = place.data.heroImage?.src;
          return (
            <a href={`${base}places/${routeSlug(place)}/`} class="place">
              <div class="place__image" style={hero ? `background-image:url(${hero});` : ''}></div>
              <div class="place__name">{place.data.name}</div>
              <div class="place__count">View stays →</div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<NewsletterBlock />
</BaseLayout>
