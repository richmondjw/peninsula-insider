---
import BaseLayout from "../../layouts/v2/BaseLayout.astro";
import NewsletterBlock from "../../components/v2/NewsletterBlock.astro";
export const prerender = true;
---
<BaseLayout title="Peninsula Insider — Volume 04, Autumn 2026" section="">


<!-- =============================================================
     HERO — cover feature
     ============================================================= -->
<section class="hero" aria-label="Cover feature">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">The Cover Feature</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Autumn 2026 <span class="ornament">—</span> The Long Read</span>
        </div>
        <h1 class="hero__headline">The five cellar doors worth the <em>appointment</em> <span class="amp">&amp;</span> the drive</h1>
        <p class="hero__dek">A working ranking of the producers actually worth the effort this autumn — judged not by the view from the tasting room, but by what you carry out and how you feel when you leave.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#" class="hero__byline-read">Read <span style="opacity:.5;margin-left:.3rem;">8 min</span></a>
        </div>
      </div>
      <figure>
        <div class="hero__image hero__rotator" role="img" aria-label="Scenes from across the Mornington Peninsula">
          <img class="hero__slide is-active" src="/images/sourced/home-cover.webp" alt="" loading="eager" fetchpriority="high">
          <img class="hero__slide" src="/images/sourced/explore-arthurs-seat-lookout-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-cape-schanck-lighthouse-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-bushrangers-bay-walk-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-cape-schanck-boardwalk-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-farnsworth-track-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-greens-bush-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-mount-martha-beach-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-point-nepean-fort-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-portsea-front-beach-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-sorrento-ocean-baths-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/explore-two-bays-walk-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/place-red-hill-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/place-sorrento-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/place-flinders-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/place-main-ridge-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/place-portsea-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/place-cape-schanck-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/golf-rye-sunrise-01.webp" alt="" loading="lazy">
          <img class="hero__slide" src="/images/sourced/wine-hub-hero-01.webp" alt="" loading="lazy">
        </div>
        <figcaption class="hero__image-cap">
          <span>Scenes from across the Peninsula <span class="ornament">—</span> Autumn 2026</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- =============================================================
     IN THIS ISSUE — contents page
     ============================================================= -->
<section class="contents" aria-label="In this issue">
  <div class="container">
    <div class="contents__head">
      <div>
        <span class="eyebrow eyebrow--ochre">In this issue</span>
        <h2 style="margin-top:.5rem;">A table of <em>contents</em>, by department.</h2>
      </div>
      <div class="byline">47 pieces <span class="ornament">·</span> 183 venues mapped <span class="ornament">·</span> 22 places <span class="ornament">·</span> 12 escape plans</div>
    </div>

    <div class="contents__grid">

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Eat &amp; Drink</span>
          <span class="contents__dept-num">I</span>
        </div>
        <a href="#" class="contents__item"><span class="contents__item-num">01</span><span>Three Italian dinners you won't find anywhere else in&nbsp;Victoria</span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">02</span><span>The long lunch — Sunday, slow, one decisive&nbsp;table</span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">03</span><span>Breakfast before the&nbsp;crowds</span></a>
      </div>

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Wine Country</span>
          <span class="contents__dept-num">II</span>
        </div>
        <a href="#" class="contents__item"><span class="contents__item-num">04</span><span>The cellar door short&nbsp;list <em>— Cover</em></span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">05</span><span>The Chardonnay case — why Peninsula white matters&nbsp;now</span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">06</span><span>A self-drive tour of the ridge, two hours or&nbsp;six</span></a>
      </div>

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Stay</span>
          <span class="contents__dept-num">III</span>
        </div>
        <a href="#" class="contents__item"><span class="contents__item-num">07</span><span>The one-night escape — 26 hours that feel like a long&nbsp;weekend</span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">08</span><span>The four hotels with a properly good&nbsp;bed</span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">09</span><span>Villa rentals actually worth the Friday&nbsp;drive</span></a>
      </div>

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Explore</span>
          <span class="contents__dept-num">IV</span>
        </div>
        <a href="#" class="contents__item"><span class="contents__item-num">10</span><span>Six ocean beaches ranked by what actually&nbsp;matters</span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">11</span><span>The thermal springs weekend, sequenced by the&nbsp;hour</span></a>
        <a href="#" class="contents__item"><span class="contents__item-num">12</span><span>The rainy-day Peninsula — without a&nbsp;booking</span></a>
      </div>

    </div>
  </div>
</section>

<!-- =============================================================
     SHORTLIST — the signature editorial device
     ============================================================= -->
<section class="shortlist" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">Cellar doors worth the <em>appointment</em>.</h2>
        <p class="shortlist__intro-body">Five producers we'd send a close friend to this autumn — ranked by the ratio of experience to effort, not the view from the tasting room. Each has been visited at least three times in the last twelve months.</p>
        <a href="#" class="shortlist__intro-link">Read the full methodology
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>

      <ol class="shortlist__list" style="list-style:none;">

        <li class="sl-item">
          <span class="sl-item__num">01</span>
          <div class="sl-item__body">
            <div class="sl-item__meta">
              <span>Main Ridge</span>
              <span class="sl-item__meta-sep"></span>
              <span>Appointment · 1 hr</span>
              <span class="sl-item__meta-sep"></span>
              <span>By seated tasting</span>
            </div>
            <a href="#" class="sl-item__name">Ten Minutes by Tractor</a>
            <p class="sl-item__why">Three single-vineyard Pinots poured in sequence, built to teach rather than impress. The cellar door staff know the answer to every question, including the ones you don't think to ask. The benchmark by which every other cellar door should be judged.</p>
            <div class="sl-item__tags">
              <span class="sl-item__tag sl-item__tag--hat">3 hats</span>
              <span class="sl-item__tag">Restaurant on site</span>
              <span class="sl-item__tag">Flight 4 wines</span>
            </div>
          </div>
        </li>

        <li class="sl-item">
          <span class="sl-item__num">02</span>
          <div class="sl-item__body">
            <div class="sl-item__meta">
              <span>Red Hill</span>
              <span class="sl-item__meta-sep"></span>
              <span>Appointment · 90 min</span>
              <span class="sl-item__meta-sep"></span>
              <span>Food pairing available</span>
            </div>
            <a href="#" class="sl-item__name">Montalto</a>
            <p class="sl-item__why">The most complete Peninsula cellar-door experience — wines that justify the fuss, a sculpture walk that isn't a contrivance, and a kitchen that treats the tasting as part of a meal rather than an obstacle. The pizzeria is the smart hedge for weekends.</p>
            <div class="sl-item__tags">
              <span class="sl-item__tag sl-item__tag--hat">1 hat</span>
              <span class="sl-item__tag">Sculpture garden</span>
              <span class="sl-item__tag">Pizzeria adjacent</span>
            </div>
          </div>
        </li>

        <li class="sl-item">
          <span class="sl-item__num">03</span>
          <div class="sl-item__body">
            <div class="sl-item__meta">
              <span>Merricks North</span>
              <span class="sl-item__meta-sep"></span>
              <span>Appointment · 45 min</span>
              <span class="sl-item__meta-sep"></span>
              <span>By appointment only</span>
            </div>
            <a href="#" class="sl-item__name">Yabby Lake</a>
            <p class="sl-item__why">Block-specific Pinots from some of the oldest vines on the Peninsula. The quietest of the top tier — no restaurant, no sculpture walk, no hotel. Just wine, made with precision, and the time to talk about it properly. A purist's cellar door.</p>
            <div class="sl-item__tags">
              <span class="sl-item__tag">Halliday 97 pts</span>
              <span class="sl-item__tag">Single-vineyard Pinot</span>
            </div>
          </div>
        </li>

        <li class="sl-item">
          <span class="sl-item__num">04</span>
          <div class="sl-item__body">
            <div class="sl-item__meta">
              <span>Red Hill South</span>
              <span class="sl-item__meta-sep"></span>
              <span>Walk-in friendly</span>
              <span class="sl-item__meta-sep"></span>
              <span>Tasting fee waived on purchase</span>
            </div>
            <a href="#" class="sl-item__name">Port Phillip Estate</a>
            <p class="sl-item__why">The one to send architecture friends to. A cellar door carved into the hillside, restaurant with a one-shot view down to Western Port Bay, and a lineup that's improved noticeably over the last five vintages. Easy to book, hard to forget.</p>
            <div class="sl-item__tags">
              <span class="sl-item__tag">Accommodation on site</span>
              <span class="sl-item__tag">Views to Western Port</span>
            </div>
          </div>
        </li>

        <li class="sl-item">
          <span class="sl-item__num">05</span>
          <div class="sl-item__body">
            <div class="sl-item__meta">
              <span>Main Ridge</span>
              <span class="sl-item__meta-sep"></span>
              <span>Appointment · 60 min</span>
              <span class="sl-item__meta-sep"></span>
              <span>Library releases available</span>
            </div>
            <a href="#" class="sl-item__name">Paringa Estate</a>
            <p class="sl-item__why">The cellar door to pair with a long lunch rather than a short visit. The Chardonnay has quietly become some of the best in the country. Ask about the library tastings — they're where the real education is, and the waitlist is shorter than you'd expect.</p>
            <div class="sl-item__tags">
              <span class="sl-item__tag sl-item__tag--hat">1 hat</span>
              <span class="sl-item__tag">Library tastings</span>
              <span class="sl-item__tag">Restaurant adjacent</span>
            </div>
          </div>
        </li>

      </ol>
    </div>
  </div>
</section>

<!-- =============================================================
     WEEKEND BRIEFING — the dark panel
     ============================================================= -->
<section class="briefing" aria-labelledby="briefing-title">
  <div class="container">
    <div class="briefing__head">
      <div class="briefing__titles">
        <div class="briefing__eyebrow">The Weekend Briefing</div>
        <h2 class="briefing__title" id="briefing-title">Friday 25 April to Sunday 27 April — a <em>short brief</em> for the Peninsula.</h2>
        <p class="briefing__dek">Vintage is finishing up. Mornings are cool, afternoons still generous, rooms are available, and some of the best tables are quietly open again after Easter.</p>
      </div>
      <a href="#" class="briefing__link">Full calendar →</a>
    </div>

    <div class="briefing__grid">
      <article class="brief-card brief-card--lead">
        <span class="brief-card__marker">Pick of the week</span>
        <span class="brief-card__tag">Saturday · Red Hill</span>
        <span class="brief-card__when">All day · from 8 am</span>
        <h3 class="brief-card__title">Red Hill Artisan Market — the first post-vintage weekend</h3>
        <p class="brief-card__body">Vintage crews back on the ground, the bakery stall with its post-harvest loaves, and the cheese producers restocked for the cooler run. Arrive by 9 if you want the good bread.</p>
        <span class="brief-card__more">Details →</span>
      </article>

      <article class="brief-card">
        <span class="brief-card__tag">Ongoing · Fingal</span>
        <span class="brief-card__when">Open daily · morning best</span>
        <h3 class="brief-card__title">Hot Springs — winter pools are open early</h3>
        <p class="brief-card__body">The outdoor pools read best in cold weather. Before midday entry is quieter. No booking needed for day admission this week.</p>
        <span class="brief-card__more">Details →</span>
      </article>

      <article class="brief-card">
        <span class="brief-card__tag">Sunday · Flinders</span>
        <span class="brief-card__when">Long lunch · from 12:30</span>
        <h3 class="brief-card__title">Flinders Hotel — a quiet autumn table</h3>
        <p class="brief-card__body">The kitchen has settled in again after a staff reset. Sunday bookings have opened up. The room is the best it's been since 2023.</p>
        <span class="brief-card__more">Details →</span>
      </article>
    </div>

    <dl class="briefing__foot">
      <div class="bf-meta">
        <dt>The weather</dt>
        <dd>Autumn settled <small>16°C · SW 12 km/h</small></dd>
      </div>
      <div class="bf-meta">
        <dt>In season</dt>
        <dd>Pears, fig, quince <small>late April</small></dd>
      </div>
      <div class="bf-meta">
        <dt>Traffic window</dt>
        <dd>Sat out by 8:30 <small>back Sun before 4</small></dd>
      </div>
      <div class="bf-meta">
        <dt>Open late</dt>
        <dd>Ocean View Ridge <small>until 10 pm</small></dd>
      </div>
      <div class="bf-meta">
        <dt>Dispatched</dt>
        <dd>Weekly <small>by email</small></dd>
      </div>
    </dl>
  </div>
</section>

<!-- =============================================================
     EDITOR'S LETTER
     ============================================================= -->
<section class="letter" aria-labelledby="letter-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="letter-title">On the <em>quiet authority</em> of a good autumn.</h2>
        <div class="letter__prose">
          <p>Autumn is the season the Peninsula stops performing. The weekend crowds thin, the vintage trucks finish their last runs, and the ridge takes on the colour it has for about six weeks a year. Most places you want to get into, you can actually get into. The light is good. The rooms are warm. The producers, finally, have time.</p>

          <blockquote class="pullquote">This issue is built for the six weeks where the Peninsula is at its most itself — before winter settles in and the coast goes quiet.</blockquote>

          <p>We've rebuilt the cellar-door shortlist from scratch this season, visited every restaurant on the long-lunch list at least twice, and walked every beach on the ranking. The newsletter, <em>Peninsula This Weekend</em>, will land in your inbox soon with the current issue's picks tightened into a single page.</p>

          <p>If this is your first issue with us — welcome. If you're returning — thanks for the patience through the refit.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <div class="letter__image ph ph-vine" role="img" aria-label="Vine rows in late-season colour, Red Hill"></div>
        <figcaption class="letter__image-cap">The last weekend of vintage, Red Hill — <em>the quietest a working winery ever gets.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<!-- =============================================================
     FEATURE WELL — magazine card grid
     ============================================================= -->
<section class="well" aria-labelledby="well-title">
  <div class="container">
    <div class="well__head">
      <div>
        <span class="eyebrow eyebrow--ochre">The Feature Well</span>
        <h2 class="well__head-title" id="well-title" style="margin-top:.5rem;">Recent <em>reading</em>.</h2>
      </div>
      <a href="#" class="well__head-link">All journal
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
      </a>
    </div>

    <div class="well__grid">
      <article class="feat feat--lead">
        <div class="feat__image ph ph-food" role="img" aria-label="Italian trattoria service"></div>
        <div class="feat__body">
          <div class="feat__eyebrow">Eat &amp; Drink <span class="ornament">—</span> Long Read</div>
          <a href="#"><h3 class="feat__title">Three Italian dinners you won't find anywhere else in Victoria</h3></a>
          <p class="feat__excerpt">The Peninsula has quietly built the strongest Italian dining room outside Melbourne's inner north. These three are the ones that matter, and why each one is doing something the city isn't.</p>
          <div class="feat__byline"><span>— By <strong>The Editors</strong></span><span class="feat__byline-sep">·</span><span class="feat__byline-read">12 min read</span></div>
        </div>
      </article>

      <article class="feat feat--std">
        <div class="feat__image ph ph-coast" role="img" aria-label="Ocean beach"></div>
        <div class="feat__body">
          <div class="feat__eyebrow">Explore</div>
          <a href="#"><h3 class="feat__title">Six ocean beaches ranked by what actually matters</h3></a>
          <p class="feat__excerpt">Surf, swimming, crowds, car parks, coffee after. A practical hierarchy, not a pretty one.</p>
          <div class="feat__byline"><span>April 2026</span></div>
        </div>
      </article>

      <article class="feat feat--std">
        <div class="feat__image ph ph-cellar" role="img" aria-label="Chardonnay vineyard"></div>
        <div class="feat__body">
          <div class="feat__eyebrow">Wine Country</div>
          <a href="#"><h3 class="feat__title">The Chardonnay case — why Peninsula white matters now</h3></a>
          <p class="feat__excerpt">Pinot gets the attention, but the argument for the country's best Chardonnay is actually stronger here.</p>
          <div class="feat__byline"><span>March 2026</span></div>
        </div>
      </article>

      <article class="feat feat--std">
        <div class="feat__image ph ph-trail" role="img" aria-label="Coastal walking track"></div>
        <div class="feat__body">
          <div class="feat__eyebrow">Explore</div>
          <a href="#"><h3 class="feat__title">Rainy-day Peninsula — no booking, no gamble</h3></a>
          <p class="feat__excerpt">Weather-proof options that don't require a reservation or advance planning.</p>
          <div class="feat__byline"><span>February 2026</span></div>
        </div>
      </article>

      <article class="feat feat--std">
        <div class="feat__image ph ph-springs" role="img" aria-label="Steam on hot springs"></div>
        <div class="feat__body">
          <div class="feat__eyebrow">Spa &amp; Wellness</div>
          <a href="#"><h3 class="feat__title">The thermal-springs weekend, sequenced by the hour</h3></a>
          <p class="feat__excerpt">A full thermal-and-treatment weekend, timed to avoid the Saturday crush.</p>
          <div class="feat__byline"><span>April 2026</span></div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- =============================================================
     DEPARTMENT — Eat & Drink venue shelf
     ============================================================= -->
<section class="dept" aria-labelledby="dept-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> I</span>
        <h2 class="dept__title" id="dept-title">Eat <em>&amp;</em> drink</h2>
        <p class="dept__dek">The restaurants on our current list — visited this season, opened well, and worth the drive even if the weather turns.</p>
      </div>
      <a href="#" class="well__head-link">All restaurants
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
      </a>
    </div>
    <div class="dept__grid">

      <article class="venue">
        <div class="venue__image ph ph-food" role="img" aria-label="Laura tasting menu">
          <span class="venue__image-marker">Restaurant</span>
          <span class="venue__image-hat">Two hats · Good Food Guide</span>
        </div>
        <div class="venue__meta">
          <span>Red Hill</span>
          <span class="venue__meta-sep"></span>
          <span>$$$$</span>
          <span class="venue__meta-sep"></span>
          <span>Tasting only</span>
        </div>
        <a href="#"><h3 class="venue__name">Laura</h3></a>
        <p class="venue__sig">The most considered tasting menu on the Peninsula — hyper-local sourcing, a grown-up dining room, and a kitchen that trusts its guests to sit still for three hours.</p>
      </article>

      <article class="venue">
        <div class="venue__image ph ph-vine" role="img" aria-label="Vineyard restaurant">
          <span class="venue__image-marker">Winery restaurant</span>
          <span class="venue__image-hat">Three hats · Good Food Guide</span>
        </div>
        <div class="venue__meta">
          <span>Main Ridge</span>
          <span class="venue__meta-sep"></span>
          <span>$$$$</span>
          <span class="venue__meta-sep"></span>
          <span>Book months ahead</span>
        </div>
        <a href="#"><h3 class="venue__name">Ten Minutes by Tractor</h3></a>
        <p class="venue__sig">The culinary benchmark for the region. Reserve a long weekend lunch months ahead — the dining room is as careful as the wine list, and the wine list is the best in the region.</p>
      </article>

      <article class="venue">
        <div class="venue__image ph ph-cellar" role="img" aria-label="Wood-fired pizzeria">
          <span class="venue__image-marker">Pizzeria</span>
        </div>
        <div class="venue__meta">
          <span>Red Hill South</span>
          <span class="venue__meta-sep"></span>
          <span>$$$</span>
          <span class="venue__meta-sep"></span>
          <span>Walk-in possible</span>
        </div>
        <a href="#"><h3 class="venue__name">Montalto Pizzeria</h3></a>
        <p class="venue__sig">The smart hedge when the main dining room is booked. Wood-fired, vineyard setting, a fraction of the wait. Arrive before 12:30 or after 2:00.</p>
      </article>

    </div>
  </div>
</section>

<!-- =============================================================
     ESCAPES
     ============================================================= -->
