---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../../lib/editorial';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const golfArticles = allArticles
  .filter((a) => a.data.tags?.includes('golf'))
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
---

<BaseLayout
  title="The Best Golf Courses on the Mornington Peninsula — Peninsula Insider"
  description="The best golf courses on the Mornington Peninsula — St Andrews Beach (world top 100), Moonah Links, The National, The Dunes, Cape Schanck. Tier-ranked public and private courses."
  section="golf"
  ogImage="/images/sourced/golf-rye-sunrise-01.webp"
>

  <section class="hero" aria-label="Golf cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <span class="hero__meta-tag">Golf</span>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">Coastal links country</span>
          </div>
          <h1 class="hero__headline">Golf on the Peninsula.</h1>
          <p class="hero__dek">World-ranked public access. Serious course architecture. Hot springs within fifteen minutes. Australia's best golf destination for a weekend that still works for non-golfers.</p>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/golf-rye-sunrise-01.webp`} alt="Peninsula golf" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Links country <span class="ornament">—</span> Peninsula golf</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's note</span>
        </div>
        <h2 class="letter__head">Honest, locally literate, useful.</h2>
        <div class="letter__prose">
          <p>Not every respected course on the Peninsula is equally useful to a visitor. This guide tells you which rounds are worth building a weekend around, which carry more aspiration than access, and how golf fits into a Peninsula trip that still works for the rest of the group.</p>
          <p>Green fees change. Access rules shift. We do not publish fee figures without live verification. Check direct before booking.</p>
          <blockquote class="pullquote">St Andrews Beach is the strongest public-access course on the Peninsula — a Tom Doak design with genuine world top-100 recognition.</blockquote>
        </div>
      </div>
    </div>
  </section>

  {golfArticles.length > 0 && (
    <section class="dept">
      <div class="container">
        <div class="dept__head">
          <span class="eyebrow eyebrow--ochre">Start here</span>
          <h2 class="dept__title">Three pieces that explain Peninsula golf.</h2>
        </div>
        <div class="dept__grid">
          {golfArticles.slice(0, 3).map((article) => {
            const data: any = article.data;
            const href = `${base}journal/${routeSlug(article)}/`;
            return (
              <a class="venue" href={href}>
                <div class="venue__body">
                  <span class="eyebrow">Golf {data.readingTimeMinutes ? `· ${data.readingTimeMinutes} min` : ''}</span>
                  <h3 class="venue__title">{data.title}</h3>
                  <p class="venue__blurb">{data.dek}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="dept">
    <div class="container">
      <div class="dept__head">
        <span class="eyebrow eyebrow--ochre">Go deeper</span>
        <h2 class="dept__title">Build the golf weekend.</h2>
      </div>
      <div class="dept__grid">
        <a class="venue" href={`${base}journal/mornington-peninsula-itinerary/`}>
          <div class="venue__body">
            <span class="eyebrow">Itinerary</span>
            <h3 class="venue__title">3-Day Peninsula itinerary</h3>
            <p class="venue__blurb">Where golf fits in a broader weekend — day-by-day plan with cellar doors, walks, and restaurants.</p>
          </div>
        </a>
        <a class="venue" href={`${base}explore/hot-springs/`}>
          <div class="venue__body">
            <span class="eyebrow">Recovery</span>
            <h3 class="venue__title">Hot springs guide</h3>
            <p class="venue__blurb">The perfect post-round recovery. Peninsula Hot Springs or Alba — when to go, which session.</p>
          </div>
        </a>
        <a class="venue" href={`${base}stay/`}>
          <div class="venue__body">
            <span class="eyebrow">Where to stay</span>
            <h3 class="venue__title">Accommodation near the courses</h3>
            <p class="venue__blurb">Stays within 20 minutes of St Andrews Beach and Moonah Links — the southern Peninsula options.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <NewsletterBlock />

</BaseLayout>
