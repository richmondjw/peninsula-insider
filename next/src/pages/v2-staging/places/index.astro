---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../../lib/editorial';

const places = (await getCollection('places'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const venues = await getCollection('venues');
const experiences = await getCollection('experiences');

const placeDensity: Record<string, number> = {};
places.forEach((place) => {
  const slug = routeSlug(place);
  const venueCount = venues.filter((v) => String(v.data.place?.id ?? v.data.place) === slug).length;
  const experienceCount = experiences.filter((e) => String(e.data.place?.id ?? e.data.place) === slug).length;
  placeDensity[slug] = venueCount + experienceCount;
});

const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
const townReadSlugs = [
  'a-flinders-weekend',
  'mornington-day-guide',
  'how-to-build-a-red-hill-saturday',
  'the-peninsula-orientation-drive',
];
const townReads = townReadSlugs
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const groups: { key: string; label: string; title: string; intro: string; zones: string[] }[] = [
  {
    key: 'hinterland',
    label: 'Hinterland',
    title: 'Hinterland — Red Hill, Main Ridge, Merricks',
    intro: 'The elevated central ridge between the bay and the ocean. Cool mornings, fog-prone winters, and volcanic red soils produce some of the best cool-climate Pinot Noir and Chardonnay in Australia. The area is predominantly rural — farmstands, cellar doors on gravel roads, the occasional serious restaurant tucked into a vineyard. There is no beach within five minutes. That\'s the point.',
    zones: ['red-hill-plateau', 'hinterland'],
  },
  {
    key: 'bay',
    label: 'Bay Coast',
    title: 'Bay Coast — Mornington to Rosebud',
    intro: 'Mornington, Mount Martha, Safety Beach, Dromana, and Rosebud face Port Phillip Bay along the peninsula\'s eastern edge. The water is calm, the swimming is safe, the bathing boxes are photogenic, and the summer crowds are real. Mornington anchors the northern end as the most town-like of the lot — gallery, market, decent coffee, a working marina.',
    zones: ['bayside'],
  },
  {
    key: 'tip',
    label: 'Tip & ocean',
    title: 'Sorrento to the Tip',
    intro: 'Blairgowrie, Sorrento, and Portsea occupy the peninsula\'s narrow western tip, with Point Nepean National Park sealing the end. Limestone cliffs, white-sand ocean beaches facing Bass Strait, a ferry crossing to Queenscliff, and heritage buildings from Victoria\'s earliest settlement attempt. Sorrento is the prettiest town on the Peninsula. Portsea is the richest. Blairgowrie is the best-kept secret.',
    zones: ['back-beaches', 'tip'],
  },
  {
    key: 'ocean',
    label: 'Ocean & Western Port',
    title: 'Ocean coast & Western Port',
    intro: 'Rye, Cape Schanck, Flinders, Shoreham, Balnarring, and Hastings wrap the peninsula\'s southern and eastern flanks. Rye is the most relaxed ocean-side town. Cape Schanck is a lighthouse at the edge of a national park. Flinders is a village that thinks of itself as a destination. Shoreham and Balnarring are quiet to the point of deliberate. Hastings is a working port with a marina and a train station.',
    zones: ['ocean-coast'],
  },
];

const grouped = groups
  .map((group) => ({
    ...group,
    places: places.filter((place) => group.zones.includes(place.data.zone)),
  }))
  .filter((group) => group.places.length > 0);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

function resolveImage(src?: string) {
  if (!src || src.includes('placeholder')) return `${base}images/sourced/home-cover.webp`;
  return src.startsWith('/') ? `${base}${src.slice(1)}` : src;
}

// Total venues (eat/wine/stay) for density display
const totalVenues = venues.length;
export const prerender = true;
---
<BaseLayout
  title="Mornington Peninsula Towns — a guide to every locality · Peninsula Insider"
  description="From Red Hill's cool-climate cellar doors to Portsea's clifftop mansions and Flinders' historic pier — the complete editorial guide to every town on the Mornington Peninsula."
  section=""
>

<section class="hero" aria-label="Places cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Places</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Town hubs <span class="ornament">—</span> local geography</span>
        </div>
        <h1 class="hero__headline">The Peninsula, town by <em>town</em>.</h1>
        <p class="hero__dek">The Peninsula has twenty distinct localities — from working harbour towns on Western Port to winery hamlets in the hinterland to white-sand ocean villages at the tip. No two towns are alike. This hub organises all of them by subregion so you know which to pair and which to avoid putting in the same day.</p>
        <div class="hero__byline">
          <span>— By <strong>The Editors</strong></span>
          <span class="hero__byline-read">{places.length} towns <span style="opacity:.5;margin-left:.3rem;">{totalVenues} venues mapped</span></span>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/places-hub-hero-01.webp`} alt="Arthur's Seat · Storm over Port Phillip Bay" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Arthur's Seat <span class="ornament">—</span> Storm over Port Phillip Bay</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="places-intro">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Why towns matter here</span>
        </div>
        <h2 class="letter__head" id="places-intro">Pick the <em>subregion</em> first. Everything else follows.</h2>
        <div class="letter__prose">
          <p>Most people come to the Mornington Peninsula for a category — beaches, wine, hot springs, golf — and pick accommodation that looks close to that category. That usually works out fine. But the Peninsula is specific in a way that categories flatten: the beach towns on Port Phillip Bay are calm, family-tilted, and good in summer; the ocean-side towns face Bass Strait and suit people who like dramatic coastline and solitude; the hinterland ridge is where serious food and wine happens; the Western Port fringe is quieter, underrated, and where artists and racehorses live.</p>
          <blockquote class="pullquote">Staying in Portsea when you want wineries is a 40-minute drive in the wrong direction. Staying in Red Hill when you want beaches puts you 20 minutes from any coast.</blockquote>
          <p>Understanding the subregions changes what you book. Read the subregion intros below, use the town cards to shortlist, then go deep in the individual pages.</p>
        </div>
      </div>
      <aside class="letter__side">
        <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
          <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">Jump to a subregion</p>
          <ul style="list-style:none;padding:0;margin:0;font-family:var(--sans,'Inter'),sans-serif;font-size:.95rem;">
            {grouped.map((g) => (
              <li style="padding:.5rem 0;border-top:1px solid rgba(0,0,0,0.08);">
                <a href={`#${g.key}`} style="color:inherit;text-decoration:none;display:flex;justify-content:space-between;">
                  <span>{g.label}</span>
                  <span style="opacity:.6;">{g.places.length}</span>
                </a>
              </li>
            ))}
            <li style="padding:.5rem 0;border-top:1px solid rgba(0,0,0,0.08);">
              <a href="#all" style="color:inherit;text-decoration:none;display:flex;justify-content:space-between;">
                <span>All towns</span>
                <span style="opacity:.6;">{places.length}</span>
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

{grouped.map((group, gi) => {
  const ordered = [...group.places].sort(
    (a, b) => (placeDensity[routeSlug(b)] ?? 0) - (placeDensity[routeSlug(a)] ?? 0),
  );
  const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'][gi] ?? String(gi + 1);
  return (
    <section class="places" id={group.key}>
      <div class="container">
        <div class="places__head">
          <div>
            <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> {roman}</span>
            <h2 class="dept__title" style="margin-top:.5rem;">{group.title}</h2>
            <p class="dept__dek">{group.intro}</p>
          </div>
        </div>
        <div class="places__grid">
          {ordered.map((place) => (
            <a href={`${base}places/${routeSlug(place)}/`} class="place">
              <div class="place__image" style={`background-image:url(${resolveImage(place.data.heroImage?.src)});background-size:cover;background-position:center;`}></div>
              <div class="place__name">{place.data.name}</div>
              <div class="place__count">{placeDensity[routeSlug(place)] ?? 0} venue{(placeDensity[routeSlug(place)] ?? 0) === 1 ? '' : 's'}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  );
})}

<section class="places" id="all">
  <div class="container">
    <div class="places__head">
      <div>
        <span class="eyebrow eyebrow--ochre">Every town</span>
        <h2 class="dept__title" style="margin-top:.5rem;">All {places.length} places, <em>alphabetical</em>.</h2>
        <p class="dept__dek">For when you already know which town you want to read next.</p>
      </div>
    </div>
    <div class="places__grid">
      {places.map((place) => (
        <a href={`${base}places/${routeSlug(place)}/`} class="place">
          <div class="place__image" style={`background-image:url(${resolveImage(place.data.heroImage?.src)});background-size:cover;background-position:center;`}></div>
          <div class="place__name">{place.data.name}</div>
          <div class="place__count">{placeDensity[routeSlug(place)] ?? 0} venue{(placeDensity[routeSlug(place)] ?? 0) === 1 ? '' : 's'}</div>
        </a>
      ))}
    </div>
  </div>
</section>

{townReads.length > 0 && (
  <section class="well" aria-labelledby="town-reads">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">From the journal</span>
          <h2 class="well__head-title" id="town-reads" style="margin-top:.5rem;">Town-first <em>reads</em> that map a single stretch properly.</h2>
        </div>
        <a href={`${base}journal/`} class="well__head-link">All journal →</a>
      </div>
      <div class="well__grid">
        {townReads.map((a, i) => (
          <article class={i === 0 ? 'feat feat--lead' : 'feat feat--std'}>
            <img class="feat__image" src={resolveImage(a.data.heroImage?.src)} alt={a.data.title} loading="lazy">
            <div class="feat__body">
              <div class="feat__eyebrow">Journal</div>
              <a href={`${base}journal/${routeSlug(a)}/`}><h3 class="feat__title">{a.data.title}</h3></a>
              {a.data.dek && <p class="feat__excerpt">{a.data.dek}</p>}
              <div class="feat__byline">
                <span>{a.data.publishedAt?.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' }) ?? ''}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<NewsletterBlock />

</BaseLayout>
