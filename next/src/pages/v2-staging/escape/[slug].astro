---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import V2EscapeDetail from '../../../components/v2/V2EscapeDetail.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, stayTypes } from '../../../lib/editorial';

export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries');
  return itineraries.map((itinerary) => ({
    params: { slug: routeSlug(itinerary) },
    props: { itinerary },
  }));
}

const { itinerary } = Astro.props;
const allItineraries = await getCollection('itineraries');
const allVenues = await getCollection('venues');
const allExperiences = await getCollection('experiences');

const slug = routeSlug(itinerary);
const venueMap = new Map(allVenues.map((venue) => [routeSlug(venue), venue]));
const experienceMap = new Map(allExperiences.map((experience) => [routeSlug(experience), experience]));

const venueSlugs = itinerary.data.stops.map((stop: any) => String(stop.venue?.id ?? stop.venue ?? '')).filter(Boolean);
const experienceSlugs = itinerary.data.stops.map((stop: any) => String(stop.experience?.id ?? stop.experience ?? '')).filter(Boolean);

const highlightedVenues = Array.from(new Set(venueSlugs))
  .map((key) => venueMap.get(key as string))
  .filter(Boolean) as any[];
const highlightedExperiences = Array.from(new Set(experienceSlugs))
  .map((key) => experienceMap.get(key as string))
  .filter(Boolean) as any[];

const featuredStays = highlightedVenues
  .filter((venue: any) => stayTypes.includes(venue.data.type))
  .slice(0, 3);

const relatedItineraries = allItineraries
  .filter((entry) => routeSlug(entry) !== slug)
  .slice(0, 2);
export const prerender = true;
---
<BaseLayout
  title={`${itinerary.data.title} — Mornington Peninsula Weekend Escape | Peninsula Insider`}
  description={itinerary.data.dek}
  section="explore"
  ogImage={itinerary.data.heroImage?.src}
>
  <V2EscapeDetail
    itinerary={itinerary}
    venueMap={venueMap}
    experienceMap={experienceMap}
    featuredStays={featuredStays}
    highlightedExperiences={highlightedExperiences}
    relatedItineraries={relatedItineraries}
  />
  <NewsletterBlock />
</BaseLayout>
