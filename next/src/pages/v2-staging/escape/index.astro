---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, stayTypes, titleize } from '../../../lib/editorial';

const itineraries = (await getCollection('itineraries'))
  .sort((a, b) => b.data.lengthNights - a.data.lengthNights);

const allVenues = await getCollection('venues');
const stays = allVenues.filter((venue) => stayTypes.includes(venue.data.type));
const places = await getCollection('places');
const stayHighlights = stays.filter((venue) => ['jackalope', 'hotel-sorrento', 'flinders-hotel'].includes(routeSlug(venue)));
const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const companionSlugs = [
  'the-sorrento-weekend',
  'a-winter-peninsula-weekend',
  'the-birthday-weekend',
  'where-to-stay-for-a-two-night-escape',
  'the-vineyard-villa-weekend',
  'the-thermal-springs-weekend',
  'a-flinders-weekend',
];
const companionReads = companionSlugs
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .slice(0, 4);

const placeHighlights = places.filter((place) => ['red-hill', 'cape-schanck', 'sorrento'].includes(routeSlug(place)));

const oneNight = itineraries.filter((it) => it.data.lengthNights <= 1);
const twoNight = itineraries.filter((it) => it.data.lengthNights === 2);
const longer = itineraries.filter((it) => it.data.lengthNights >= 3);

const moodGuides = [
  { label: 'Food & wine',  slug: 'how-to-build-a-red-hill-saturday',          note: 'Lunch, cellar doors, a slow drive back' },
  { label: 'Wellness',     slug: 'the-thermal-springs-weekend',               note: 'Springs, sauna, one soft dinner' },
  { label: 'Slow coast',   slug: 'a-flinders-weekend',                        note: 'Flinders, the pier, Bass Strait air' },
  { label: 'Tip of the peninsula', slug: 'the-sorrento-weekend',              note: 'Village base, fort walk, back beach' },
  { label: 'Celebration',  slug: 'the-birthday-weekend',                      note: 'One anchor dinner, everything else softer' },
  { label: 'Winter reset', slug: 'a-winter-peninsula-weekend',                note: 'Fireplace, hot springs, low-season calm' },
  { label: 'Quick reset',  slug: 'the-one-night-escape',                      note: '26 hours that feels like three days' },
  { label: 'With kids',    slug: 'the-peninsula-with-kids',                   note: 'A day that punishes no one' },
];
const moodResolved = moodGuides
  .map((mood) => {
    const article = articlesAll.find((a) => routeSlug(a) === mood.slug);
    return article ? { ...mood, article } : null;
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== null);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

function resolveImage(src?: string) {
  if (!src || src.includes('placeholder')) return `${base}images/sourced/home-cover.webp`;
  return src.startsWith('/') ? `${base}${src.slice(1)}` : src;
}

const moodLabel: Record<string, string> = {
  slow: 'Slow',
  indulgent: 'Indulgent',
  wellness: 'Wellness',
  adventure: 'Adventure',
  'food-wine': 'Food & Wine',
  mixed: 'Mixed',
  quick: 'Quick',
};
const audienceLabel: Record<string, string> = {
  couple: 'Couples',
  family: 'Families',
  friends: 'Friends',
  solo: 'Solo',
  locals: 'Locals',
};

function escapeCard(it: any) {
  return {
    href: `${base}escape/${routeSlug(it)}/`,
    img: resolveImage(it.data.heroImage?.src),
    nights: it.data.lengthNights,
    mood: moodLabel[it.data.mood] ?? titleize(it.data.mood),
    audience: audienceLabel[it.data.audience] ?? titleize(it.data.audience),
    title: it.data.title,
    dek: it.data.dek,
    stops: it.data.stops.length,
  };
}
export const prerender = true;
---
<BaseLayout
  title="Mornington Peninsula Itineraries · Peninsula Insider"
  description="Editorial itineraries and weekend plans for doing the Mornington Peninsula slowly and well."
  section="escape"
>

<section class="hero" aria-label="Escape cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Escape</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Itineraries <span class="ornament">—</span> weekends <span class="ornament">—</span> slow travel</span>
        </div>
        <h1 class="hero__headline">Good Peninsula weekends are built in the <em>sequence</em>.</h1>
        <p class="hero__dek">The region is small enough to overdo and varied enough to get wrong. These escape plans are our answer: fewer bookings, better pacing, and just enough structure that the whole thing feels inevitable rather than overplanned.</p>
        <div class="hero__byline">
          <span>— By <strong>The Editors</strong></span>
          <span class="hero__byline-read">{itineraries.length} plans</span>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-cape-schanck-01.webp`} alt="Ridge first, ocean later, no unnecessary backtracking" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Ridge first, ocean later <span class="ornament">—</span> Cape Schanck</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="escape-rules">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Three rules</span>
        </div>
        <h2 class="letter__head" id="escape-rules">What a good Peninsula weekend <em>actually looks like</em>.</h2>
        <div class="letter__prose">
          <p><strong>Pick one geography per day.</strong> Red Hill, Sorrento, Flinders, and Cape Schanck all ask for different tempos. Stringing them together without thought is how good weekends turn into traffic.</p>
          <p><strong>Let lunch or dinner be the event, not both.</strong> The Peninsula's strongest move is still daylight dining. If lunch is the headline, keep dinner softer. If dinner matters, keep the afternoon light.</p>
          <blockquote class="pullquote">Always leave room for weather — the region gets more interesting when the wind shifts, the sky changes, or dusk suddenly looks too good to waste indoors.</blockquote>
        </div>
      </div>
      <aside class="letter__side">
        <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
          <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">Jump to</p>
          <ul style="list-style:none;padding:0;margin:0;font-family:var(--sans,'Inter'),sans-serif;font-size:.95rem;">
            {twoNight.length > 0 && (
              <li style="padding:.5rem 0;border-top:1px solid rgba(0,0,0,0.08);"><a href="#two-night" style="color:inherit;text-decoration:none;display:flex;justify-content:space-between;"><span>Two-night escapes</span><span style="opacity:.6;">{twoNight.length}</span></a></li>
            )}
            {oneNight.length > 0 && (
              <li style="padding:.5rem 0;border-top:1px solid rgba(0,0,0,0.08);"><a href="#one-night" style="color:inherit;text-decoration:none;display:flex;justify-content:space-between;"><span>One-night quick</span><span style="opacity:.6;">{oneNight.length}</span></a></li>
            )}
            {longer.length > 0 && (
              <li style="padding:.5rem 0;border-top:1px solid rgba(0,0,0,0.08);"><a href="#longer" style="color:inherit;text-decoration:none;display:flex;justify-content:space-between;"><span>Three nights and beyond</span><span style="opacity:.6;">{longer.length}</span></a></li>
            )}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

{moodResolved.length > 0 && (
  <section class="shortlist" aria-labelledby="mood-title">
    <div class="container">
      <div class="shortlist__frame">
        <div class="shortlist__intro">
          <span class="eyebrow eyebrow--ochre">Escape by mood</span>
          <h2 id="mood-title">Pick the <em>feeling</em> first, then let the sequence follow.</h2>
          <p class="shortlist__intro-body">Each entry opens a service piece or stay-note that maps the weekend for that mood — built the way we'd actually book it.</p>
        </div>
        <ol class="shortlist__list" style="list-style:none;">
          {moodResolved.map((mood, i) => (
            <li class="sl-item">
              <span class="sl-item__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{mood.label}</span>
                </div>
                <a href={`${base}journal/${mood.slug}/`} class="sl-item__name">{mood.article.data.title}</a>
                <p class="sl-item__why">{mood.note}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

{twoNight.length > 0 && (
  <section class="escapes" aria-labelledby="two-night-title" id="two-night">
    <div class="container">
      <div class="escapes__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> I</span>
          <h2 class="dept__title" id="two-night-title" style="margin-top:.5rem;">Two-night escapes <em>— the sweet spot</em>.</h2>
          <p class="dept__dek">Two nights is the Peninsula's native rhythm. One lunch that earns the drive, one walk that resets the weekend, one bed that suits the mood.</p>
        </div>
      </div>
      <div class="escapes__grid">
        {twoNight.map((it) => {
          const c = escapeCard(it);
          return (
            <article class="escape">
              <div class="escape__image" style={`background-image:url(${c.img});background-size:cover;background-position:center;`}>
                <span class="escape__image-tag"><strong>{c.nights}</strong> night{c.nights === 1 ? '' : 's'}</span>
              </div>
              <div class="escape__body">
                <span class="escape__eyebrow">Plan <span class="ornament">·</span> {c.mood}</span>
                <a href={c.href}><h3 class="escape__title">{c.title}</h3></a>
                <p class="escape__dek">{c.dek}</p>
                <div class="escape__foot">
                  <span>{c.audience} <span class="ornament">·</span> {c.stops} stops</span>
                  <span class="escape__foot-read">Plan →</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{oneNight.length > 0 && (
  <section class="escapes" aria-labelledby="one-night-title" id="one-night">
    <div class="container">
      <div class="escapes__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> II</span>
          <h2 class="dept__title" id="one-night-title" style="margin-top:.5rem;">One-night quick <em>— when the weekend is tight</em>.</h2>
          <p class="dept__dek">Designed to feel three times longer than the drive down.</p>
        </div>
      </div>
      <div class="escapes__grid">
        {oneNight.map((it) => {
          const c = escapeCard(it);
          return (
            <article class="escape">
              <div class="escape__image" style={`background-image:url(${c.img});background-size:cover;background-position:center;`}>
                <span class="escape__image-tag"><strong>{c.nights}</strong> night{c.nights === 1 ? '' : 's'}</span>
              </div>
              <div class="escape__body">
                <span class="escape__eyebrow">Plan <span class="ornament">·</span> {c.mood}</span>
                <a href={c.href}><h3 class="escape__title">{c.title}</h3></a>
                <p class="escape__dek">{c.dek}</p>
                <div class="escape__foot">
                  <span>{c.audience} <span class="ornament">·</span> {c.stops} stops</span>
                  <span class="escape__foot-read">Plan →</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{longer.length > 0 && (
  <section class="escapes" aria-labelledby="longer-title" id="longer">
    <div class="container">
      <div class="escapes__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> III</span>
          <h2 class="dept__title" id="longer-title" style="margin-top:.5rem;">Three nights and beyond <em>— for the weekend that refuses to end</em>.</h2>
          <p class="dept__dek">The longer escapes are where the Peninsula stops performing and starts settling into something quieter.</p>
        </div>
      </div>
      <div class="escapes__grid">
        {longer.map((it) => {
          const c = escapeCard(it);
          return (
            <article class="escape">
              <div class="escape__image" style={`background-image:url(${c.img});background-size:cover;background-position:center;`}>
                <span class="escape__image-tag"><strong>{c.nights}</strong> night{c.nights === 1 ? '' : 's'}</span>
              </div>
              <div class="escape__body">
                <span class="escape__eyebrow">Plan <span class="ornament">·</span> {c.mood}</span>
                <a href={c.href}><h3 class="escape__title">{c.title}</h3></a>
                <p class="escape__dek">{c.dek}</p>
                <div class="escape__foot">
                  <span>{c.audience} <span class="ornament">·</span> {c.stops} stops</span>
                  <span class="escape__foot-read">Plan →</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{stayHighlights.length > 0 && (
  <section class="dept" aria-labelledby="stays-title">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Choose the base first</span>
          <h2 class="dept__title" id="stays-title">Three stays that <em>change the whole plan</em>.</h2>
          <p class="dept__dek">A Peninsula itinerary improves dramatically when the bed matches the landscape you want most.</p>
        </div>
        <a href={`${base}stay/`} class="well__head-link">All stays →</a>
      </div>
      <div class="dept__grid">
        {stayHighlights.map((v) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(v.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{titleize(v.data.type)}</span>
            </div>
            <div class="venue__meta">
              <span>{titleize(String(v.data.place?.id ?? v.data.place ?? ''))}</span>
              <span class="venue__meta-sep"></span>
              <span>{v.data.priceBand}</span>
            </div>
            <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{v.data.name}</h3></a>
            <p class="venue__sig">{v.data.signature}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{placeHighlights.length > 0 && (
  <section class="places" aria-labelledby="place-highlights">
    <div class="container">
      <div class="places__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Sequence by geography</span>
          <h2 class="dept__title" id="place-highlights" style="margin-top:.5rem;">The best escapes move through the Peninsula in a <em>clean line</em>.</h2>
          <p class="dept__dek">Ridge for the lunch, coast for the light, tip for the walk and the bed.</p>
        </div>
        <a href={`${base}places/`} class="well__head-link">All places →</a>
      </div>
      <div class="places__grid">
        {placeHighlights.map((p) => (
          <a href={`${base}places/${routeSlug(p)}/`} class="place">
            <div class="place__image" style={`background-image:url(${resolveImage(p.data.heroImage?.src)});background-size:cover;background-position:center;`}></div>
            <div class="place__name">{p.data.name}</div>
            <div class="place__count">{titleize(p.data.zone)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{companionReads.length > 0 && (
  <section class="well" aria-labelledby="companion-reads">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Read before you book</span>
          <h2 class="well__head-title" id="companion-reads" style="margin-top:.5rem;">Journal pieces that <em>sharpen the trip</em>.</h2>
        </div>
        <a href={`${base}journal/`} class="well__head-link">More from the Journal →</a>
      </div>
      <div class="well__grid">
        {companionReads.map((a, i) => (
          <article class={i === 0 ? 'feat feat--lead' : 'feat feat--std'}>
            <img class="feat__image" src={resolveImage(a.data.heroImage?.src)} alt={a.data.title} loading="lazy">
            <div class="feat__body">
              <div class="feat__eyebrow">Journal <span class="ornament">—</span> {titleize(a.data.format ?? 'guide')}</div>
              <a href={`${base}journal/${routeSlug(a)}/`}><h3 class="feat__title">{a.data.title}</h3></a>
              {a.data.dek && <p class="feat__excerpt">{a.data.dek}</p>}
              <div class="feat__byline">
                <span>{a.data.publishedAt?.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' }) ?? ''}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<NewsletterBlock />

</BaseLayout>
