---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../lib/editorial';

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const dispatches = articles.filter((a) => a.data.format === 'weekend-picker').slice(0, 3);
const highlights = articles.filter((a) => a.data.format !== 'weekend-picker').slice(0, 3);
const previewPieces = dispatches.length > 0 ? dispatches : highlights;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Newsletter — Peninsula Insider"
  description="Subscribe to Peninsula This Weekend: weekly Peninsula coverage with honest picks, new openings, and the cellar doors worth knowing."
  section=""
>

<section class="hero" aria-label="Page cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <span class="eyebrow eyebrow--ochre">Newsletter <span class="ornament">·</span> Peninsula This Weekend</span>
        <h1 class="hero__headline">The Peninsula in your inbox, <em>every week</em>.</h1>
        <p class="hero__dek">New openings, cellar door dispatches, and the places we're quietly recommending this season. Written by editors who live here.</p>
        <div class="hero__byline">
          <span>— Dispatched <strong>weekly</strong></span>
          <a href="#newsletter" class="hero__byline-read">Subscribe <span style="opacity:.5;margin-left:.3rem;">free</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock
  title="The Peninsula briefing for <em>this weekend</em>."
  body="A concise note with the weekend’s best picks, open tables, cellar-door windows, and one useful walk — sent when there is something worth sharing."
/>

<section class="shortlist" aria-labelledby="what-you-get">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">What you'll get</span>
        <h2 id="what-you-get">Four reasons it's worth the <em>inbox room</em>.</h2>
        <p class="shortlist__intro-body">We don't write round-ups that read like tourism copy — we write the email we'd want to receive when we're thinking about the weekend.</p>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        <li class="sl-item">
          <span class="sl-item__num">01</span>
          <div class="sl-item__body">
            <a class="sl-item__name">Weekly dispatch</a>
            <p class="sl-item__why">One curated email every week with the openings, closures, and stories that matter.</p>
          </div>
        </li>
        <li class="sl-item">
          <span class="sl-item__num">02</span>
          <div class="sl-item__body">
            <a class="sl-item__name">Weekend Picker</a>
            <p class="sl-item__why">Our weekly Peninsula This Weekend note: one opinionated pick, one weather-proof backup, one thing to skip.</p>
          </div>
        </li>
        <li class="sl-item">
          <span class="sl-item__num">03</span>
          <div class="sl-item__body">
            <a class="sl-item__name">Subscriber-only notes</a>
            <p class="sl-item__why">Short editorial observations we don't publish on the site. The things we'd text a friend.</p>
          </div>
        </li>
        <li class="sl-item">
          <span class="sl-item__num">04</span>
          <div class="sl-item__body">
            <a class="sl-item__name">Early access</a>
            <p class="sl-item__why">New guides and long-form pieces land in the newsletter before they hit the site.</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-label="What it sounds like">
  <div class="container">
    <div class="letter__frame" style="display:block; max-width:46rem; margin-inline:auto;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">What it sounds like</span>
        </div>
        <h2 class="letter__head">Written like a good recommendation from someone who <em>lives here</em>.</h2>
        <div class="letter__prose v2-article-body">
          <h3>Editorial first</h3>
          <p>Every mention is earned. We write the email we'd want to receive — recommendations from someone who actually lives here.</p>
          <h3>No click-bait subjects</h3>
          <p>Subject lines tell you what's inside. If the newsletter is about three cellar doors worth the appointment, the subject says so.</p>
          <h3>Weekly, not daily</h3>
          <p>One curated dispatch every week. We write when we have something to say.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{previewPieces.length > 0 && (
  <section class="well" id="recent-pieces" aria-labelledby="recent-pieces-title">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Recent from the site</span>
          <h2 class="well__head-title" id="recent-pieces-title" style="margin-top:.5rem;">The kind of writing subscribers <em>receive first</em>.</h2>
        </div>
        <a href={`${base}journal/`} class="well__head-link">More in the Journal →</a>
      </div>
      <div class="well__grid">
        {previewPieces.map((article, index) => (
          <article class={`feat ${index === 0 ? 'feat--lead' : 'feat--std'}`}>
            <div class="feat__image ph ph-food" role="img" aria-label={article.data.title}></div>
            <div class="feat__body">
              <div class="feat__eyebrow">Journal</div>
              <a href={`${base}journal/${routeSlug(article)}/`}><h3 class="feat__title">{article.data.title}</h3></a>
              {article.data.dek && <p class="feat__excerpt">{article.data.dek}</p>}
              <div class="feat__byline">
                <span>{article.data.publishedAt?.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' }) ?? ''}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style is:global>
  .v2-article-body h2 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-feature-settings: 'opsz' 32;
  }
  .v2-article-body h3 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
  .v2-article-body p { margin-bottom: 1.2rem; }
  .v2-article-body blockquote {
    border-left: 3px solid var(--ochre, #a0612d);
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-family: var(--serif, 'Newsreader'), serif;
    font-style: italic;
    font-size: 1.2rem;
  }
  .v2-article-body ul, .v2-article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .v2-article-body li { margin-bottom: .5rem; }
  .v2-article-body a {
    color: var(--ochre, #a0612d);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>

</BaseLayout>
