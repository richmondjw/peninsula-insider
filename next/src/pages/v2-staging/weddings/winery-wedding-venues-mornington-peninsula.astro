---
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const venues = [
  { rank: 1, tag: 'Up to 120 guests · Red Hill South', name: 'Montalto',
    note: 'The strongest complete winery wedding package on the Peninsula. Montalto has the estate, the kitchen, the cellar door, and the sculpture garden — a rare combination of serious food, genuine wine credentials, and a setting that photographs beautifully without needing embellishment. The indoor pavilion handles most weather conditions. Best for: couples who want food and wine as central to the day. Watch out for: peak season dates fill early; the kitchen\'s output is tied to the estate\'s restaurant programme.' },
  { rank: 2, tag: 'Up to 200 guests · Red Hill South', name: 'Pt. Leo Estate',
    note: 'The largest Peninsula winery wedding venue, with a coastal-architecture setting and the LUME sculpture park as a distinctive backdrop. Pt. Leo is the only Peninsula winery that can handle over 150 guests without feeling crowded. The indoor event spaces are purpose-built for wedding scale. Best for: larger guest lists that want a vineyard setting without compromising on logistics. Watch out for: the scale makes it feel slightly less intimate than the smaller producer estates.' },
  { rank: 3, tag: 'Up to 80 guests · Main Ridge', name: 'Polperro',
    note: 'An intimate cool-climate producer on the Main Ridge plateau — lower key and more private than Montalto, with a cellar door and indoor event space that rewards smaller guest lists. The Polperro wines are among the Peninsula\'s best, which means a wine-forward reception here is genuinely exceptional. Best for: intimate weddings under 80 guests for couples who value authenticity over scale. Watch out for: limited accommodation nearby.' },
  { rank: 4, tag: 'Up to 60 guests · Main Ridge', name: 'Ten Minutes by Tractor',
    note: 'The Peninsula\'s most celebrated restaurant-winery, and the strongest option for a food-led wedding that treats the meal as the event itself. Hatted kitchen, exceptional Pinot Noir programme. The constraint is capacity — Ten Minutes by Tractor is genuinely intimate and does not scale gracefully beyond 60 guests. Best for: couples who want the Peninsula\'s best food to be the centrepiece of the day.' },
  { rank: 5, tag: 'Onsite accommodation · Red Hill', name: 'Lindenderry at Red Hill',
    note: 'A boutique hotel on the Red Hill plateau with vineyard surroundings, onsite rooms and suites for the bridal party and guests, and event spaces that suit medium-scale weddings. The accommodation integration makes it different from pure winery venues — guests can walk from their room to the ceremony. Best for: couples who want the vineyard atmosphere with integrated guest accommodation. Watch out for: the wine programme is genuine but not the same as an estate like Montalto or Polperro.' },
  { rank: 6, tag: 'Relaxed · Merricks', name: 'Merricks General Wine Store',
    note: 'The most relaxed and informal winery wedding option on the Peninsula. A village institution — a general store turned wine bar and restaurant with a character that no purpose-built event venue can replicate. Best for smaller, more casual receptions where the feel of the place matters more than the scale. Best for: intimate weddings and receptions where informality is a deliberate choice.' },
];

const strengths = [
  { title: 'What winery weddings do well', body: 'Food and wine integration — the kitchen and the cellar door tell the same story. Setting that photographs without editing. An event that feels like a place rather than a hired space. Character that a hotel ballroom cannot replicate. Autumn and winter winery weddings, specifically, are some of the Peninsula\'s best kept secrets — low light, open fires, and a guest list who chose to be there.' },
  { title: 'What winery weddings don\'t do well', body: 'Scale beyond 120–150 guests without venue infrastructure stress. Indoor backup quality when the weather turns — some estates handle this better than others, and it is worth asking explicitly. Transport logistics for large guest lists on rural roads. Guest accommodation density — you cannot cluster 80 guests near Main Ridge the way you can in Sorrento.' },
  { title: 'Summer heat', body: 'February at a vineyard in formal wear can be genuinely uncomfortable. The Peninsula bakes. If you are set on an outdoor vineyard ceremony, autumn is a better season for comfort and photography than the height of summer. A venue with a credible shaded outdoor area or a strong indoor option makes a summer date viable.' },
  { title: 'Guest transport', body: 'These venues are not in towns. A coach from Melbourne to Red Hill or Main Ridge is not optional for a full guest list — it is the right call for guest safety and timing control. Budget $1,500 to $3,000 for a return coach before committing to a venue location. Build that cost into the venue comparison, not the contingency.' },
];

const guestStay = [
  { title: 'Holiday houses, Red Hill and surrounds', body: 'The most common solution. Houses sleeping 8–12 near the venue work well for the bridal party and core guests. Book 6–12 months in advance. Ask the venue for recommendations — they know the closest properties.' },
  { title: 'Lindenderry, Jackalope, boutique stays', body: 'For smaller guest lists or for the bridal party specifically. Lindenderry is on the plateau; Jackalope is in Merricks North. Both have onsite accommodation that makes the morning-after logistics simple.' },
  { title: 'Mornington town, 20–25 minutes north', body: 'For larger guest lists that cannot be accommodated near the venue. Mornington has broader accommodation stock — hotels, self-contained apartments, holiday houses. The drive to Red Hill venues is manageable but requires coordination on wedding day.' },
  { title: 'Sorrento, 30–45 minutes south-west', body: 'Only makes sense if the guest list has independent transport, or if the wedding is in the southern Red Hill corridor. The drive times from Sorrento to Main Ridge are realistic on a non-peak morning but add complexity to wedding-day logistics.' },
];

const faqs = [
  { q: 'How far in advance do Peninsula winery venues book out?', a: 'For the most in-demand properties — Montalto, Pt. Leo, Ten Minutes by Tractor — Saturday dates in peak season can fill 14 to 18 months ahead. If you have a date range in mind, check availability before you fall in love with a specific property. Winter and non-Saturday dates are much easier.' },
  { q: 'Is a winter winery wedding worth considering?', a: 'Yes — and it is underrated. Cellar doors have open fires. The vine foliage in May and June photographs differently, with warmth that summer green lacks. Rates are lower. The guest list, by necessity, is people who wanted to be there. A winter Peninsula winery wedding is not a compromise. It is a deliberate choice that often produces a better event.' },
  { q: 'Do we need a wedding coordinator for a winery venue?', a: 'Not always, but the logistics are more complex than an in-city event. Transport coordination, accommodation spread across multiple properties, and supplier access across the Peninsula all require more planning. Most Peninsula winery venues have a wedding coordinator function in-house or can recommend one.' },
];
export const prerender = true;
---

<BaseLayout
  title="Winery Wedding Venues on the Mornington Peninsula — Peninsula Insider"
  description="The Peninsula's best winery wedding venues — Montalto, Polperro, Pt. Leo Estate, Ten Minutes by Tractor, and more. Honest guide to what a vineyard wedding delivers and who it suits."
  section=""
  ogImage="/images/sourced/article-vineyard-villa-01.webp"
>

  <section class="hero" aria-label="Winery wedding venues cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <a href={`${base}weddings/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Weddings</a>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">Winery wedding venues</span>
          </div>
          <h1 class="hero__headline">Winery wedding venues, honestly.</h1>
          <p class="hero__dek">A winery wedding on the Peninsula is not just a location choice. It is a commitment to a particular kind of day — food and wine at the centre, working farmland as the backdrop, and guests who need to get there and get home. This guide helps you understand what that actually means before you choose a venue.</p>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/article-vineyard-villa-01.webp`} alt="Peninsula winery wedding" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Winery weddings <span class="ornament">—</span> Red Hill</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">What a winery wedding actually is</span>
        </div>
        <h2 class="letter__head">A vineyard is not a blank-canvas event space.</h2>
        <div class="letter__prose">
          <p>The best winery weddings on the Peninsula work because the venue contributes something genuine to the day — the wine is the wine you have been drinking all weekend, the kitchen is run by a chef who knows the estate, and the setting is the same landscape that shaped the bottles on the table. The photography is almost incidental to that.</p>
          <p>The trade-offs are real: capacity caps, weather dependency, transport obligations (you cannot walk to any of these properties), and indoor-backup quality that varies significantly by venue. Understanding both sides is the right way to make this decision.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="shortlist">
    <div class="container">
      <div class="shortlist__head">
        <span class="eyebrow eyebrow--ochre">The venues</span>
        <h2 class="shortlist__title">Peninsula winery wedding venues, ranked.</h2>
      </div>
      <ol class="sl-list">
        {venues.map(v => (
          <li class="sl-item">
            <div class="sl-item__rank">{v.rank}</div>
            <div class="sl-item__body">
              <span class="eyebrow">{v.tag}</span>
              <h3 class="sl-item__name">{v.name}</h3>
              <p class="sl-item__note">{v.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="dept">
    <div class="container">
      <div class="dept__head">
        <span class="eyebrow eyebrow--ochre">Honest assessment</span>
        <h2 class="dept__title">What winery weddings do well — and don't.</h2>
      </div>
      <div class="dept__grid">
        {strengths.map(s => (
          <article class="venue">
            <div class="venue__body">
              <h3 class="venue__title">{s.title}</h3>
              <p class="venue__blurb">{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dept">
    <div class="container">
      <div class="dept__head">
        <span class="eyebrow eyebrow--ochre">Guest accommodation</span>
        <h2 class="dept__title">Where guests stay for a Red Hill or Main Ridge wedding.</h2>
      </div>
      <div class="dept__grid">
        {guestStay.map(g => (
          <article class="venue">
            <div class="venue__body">
              <h3 class="venue__title">{g.title}</h3>
              <p class="venue__blurb">{g.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dept">
    <div class="container">
      <div class="dept__head">
        <span class="eyebrow eyebrow--ochre">Common questions</span>
        <h2 class="dept__title">What couples want to know about winery weddings.</h2>
      </div>
      <div class="dept__grid">
        {faqs.map(f => (
          <article class="venue">
            <div class="venue__body">
              <h3 class="venue__title">{f.q}</h3>
              <p class="venue__blurb">{f.a}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <NewsletterBlock />

</BaseLayout>
