---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, placeLabel, typeLabel, titleize } from '../../../lib/editorial';

export async function getStaticPaths() {
  const experiences = await getCollection('experiences');
  return experiences.map(e => ({ params: { slug: routeSlug(e) }, props: { experience: e } }));
}

const { experience } = Astro.props;
const data = experience.data;

const allExperiences = await getCollection('experiences');
const related = allExperiences
  .filter(e => e.id !== experience.id && (e.data.place === data.place || e.data.type === data.type))
  .slice(0, 3);

const allVenues = await getCollection('venues');
const nearby = allVenues.filter(v => v.data.place === data.place).slice(0, 3);

const allItineraries = await getCollection('itineraries');
const relatedItineraries = allItineraries
  .filter(i => i.data.experiences?.some((ref: any) => ref.slug === experience.slug))
  .slice(0, 2);

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const relatedArticles = allArticles
  .filter(a => a.data.tags?.some(t => data.tags?.mood?.includes(t) || data.tags?.season?.includes(t) || a.data.tags?.includes(data.type)))
  .slice(0, 3);

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const heroImage = data.heroImage?.src && !data.heroImage.src.includes('placeholder')
  ? (data.heroImage.src.startsWith('/') ? `${base}${data.heroImage.src.slice(1)}` : data.heroImage.src)
  : `${base}images/sourced/home-cover.webp`;

const editorParas = String(data.editorNote ?? data.description ?? '').split(/\n\n+/).filter(Boolean);
const pullquote = data.editorVerdict;
export const prerender = true;
---

<BaseLayout
  title={`${data.name} — Peninsula Insider`}
  description={data.signature ?? data.description}
  section="explore"
  ogImage={data.heroImage?.src}
>

  <section class="hero" aria-label={`${data.name} cover`}>
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <a href={`${base}explore/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Explore</a>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">{placeLabel(data.place)} <span class="ornament">·</span> {typeLabel[data.type] ?? data.type}</span>
          </div>
          <h1 class="hero__headline">{data.name}</h1>
          <p class="hero__dek">{data.signature}</p>
          <div class="hero__byline">
            <span>{data.durationMinutes ? `${data.durationMinutes} min` : ''} {data.difficulty && <>· <strong>{titleize(data.difficulty)}</strong></>}</span>
          </div>
        </div>
        <figure>
          <img class="hero__image" src={heroImage} alt={`${data.name}, ${placeLabel(data.place)}`} loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>{data.name} <span class="ornament">—</span> {placeLabel(data.place)}</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter" aria-labelledby={`editor-${routeSlug(experience)}`}>
    <div class="container">
      <div class="letter__frame">
        <div class="letter__body">
          <div class="letter__eyebrow">
            <span class="letter__eyebrow-rule"></span>
            <span class="eyebrow eyebrow--ochre">The Insider's note</span>
          </div>
          <h2 class="letter__head" id={`editor-${routeSlug(experience)}`}>On {data.name}.</h2>
          <div class="letter__prose">
            {editorParas.map((p: string, i: number) => (
              i === 1 && pullquote
                ? <><p>{p}</p><blockquote class="pullquote">{pullquote}</blockquote></>
                : <p>{p}</p>
            ))}
            {editorParas.length < 2 && pullquote && (
              <blockquote class="pullquote">{pullquote}</blockquote>
            )}
          </div>
        </div>

        <aside class="letter__side">
          <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
            <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">At a glance</p>
            <dl style="display:grid; grid-template-columns:auto 1fr; gap:.6rem 1rem; font-family:var(--sans,'Inter'),sans-serif; font-size:.92rem;">
              <dt style="font-weight:500;">Type</dt>
              <dd style="margin:0;">{typeLabel[data.type] ?? data.type}</dd>

              <dt style="font-weight:500;">Place</dt>
              <dd style="margin:0;">{placeLabel(data.place)}</dd>

              {data.durationMinutes && (<>
                <dt style="font-weight:500;">Duration</dt>
                <dd style="margin:0;">{data.durationMinutes} min</dd>
              </>)}

              {data.distanceKm && (<>
                <dt style="font-weight:500;">Distance</dt>
                <dd style="margin:0;">{data.distanceKm} km</dd>
              </>)}

              {data.difficulty && (<>
                <dt style="font-weight:500;">Difficulty</dt>
                <dd style="margin:0;">{titleize(data.difficulty)}</dd>
              </>)}

              {data.dogPolicy && (<>
                <dt style="font-weight:500;">Dogs</dt>
                <dd style="margin:0;">{titleize(data.dogPolicy)}</dd>
              </>)}

              {data.bestSeason && (<>
                <dt style="font-weight:500;">Best season</dt>
                <dd style="margin:0;">{Array.isArray(data.bestSeason) ? data.bestSeason.map(titleize).join(' · ') : titleize(data.bestSeason)}</dd>
              </>)}
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="dept" aria-labelledby="related-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Related</span>
            <h2 class="dept__title" id="related-title">More in <em>{placeLabel(data.place)}</em>.</h2>
          </div>
          <a href={`${base}explore/`} class="well__head-link">All experiences →</a>
        </div>
        <div class="dept__grid">
          {related.map(r => {
            const rHero = r.data.heroImage?.src && !r.data.heroImage.src.includes('placeholder')
              ? (r.data.heroImage.src.startsWith('/') ? `${base}${r.data.heroImage.src.slice(1)}` : r.data.heroImage.src)
              : `${base}images/sourced/home-cover.webp`;
            return (
              <article class="venue">
                <div class="venue__image" style={`background-image:url(${rHero});background-size:cover;background-position:center;`}>
                  <span class="venue__image-marker">{typeLabel[r.data.type] ?? r.data.type}</span>
                </div>
                <div class="venue__meta">
                  <span>{placeLabel(r.data.place)}</span>
                </div>
                <a href={`${base}explore/${routeSlug(r)}/`}><h3 class="venue__name">{r.data.name}</h3></a>
                <p class="venue__sig">{r.data.signature}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="dept" aria-labelledby="nearby-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Nearby</span>
            <h2 class="dept__title" id="nearby-title">While you're in <em>{placeLabel(data.place)}</em>.</h2>
          </div>
        </div>
        <div class="dept__grid">
          {nearby.map(v => {
            const section = v.data.type === 'hotel' || v.data.type === 'villa' ? 'stay' : v.data.type === 'winery' ? 'wine' : 'eat';
            const vHero = v.data.heroImage?.src && !v.data.heroImage.src.includes('placeholder')
              ? (v.data.heroImage.src.startsWith('/') ? `${base}${v.data.heroImage.src.slice(1)}` : v.data.heroImage.src)
              : `${base}images/sourced/home-cover.webp`;
            return (
              <article class="venue">
                <div class="venue__image" style={`background-image:url(${vHero});background-size:cover;background-position:center;`}>
                  <span class="venue__image-marker">{typeLabel[v.data.type] ?? v.data.type}</span>
                </div>
                <div class="venue__meta">
                  <span>{placeLabel(v.data.place)}</span>
                  <span class="venue__meta-sep"></span>
                  <span>{v.data.priceBand}</span>
                </div>
                <a href={`${base}${section}/${routeSlug(v)}/`}><h3 class="venue__name">{v.data.name}</h3></a>
                <p class="venue__sig">{v.data.signature}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section class="well" aria-labelledby="reading-title">
      <div class="container">
        <div class="well__head">
          <div>
            <span class="eyebrow eyebrow--ochre">Related reading</span>
            <h2 class="well__head-title" id="reading-title" style="margin-top:.5rem;">From the <em>journal</em>.</h2>
          </div>
          <a href={`${base}journal/`} class="well__head-link">All journal →</a>
        </div>
        <div class="well__grid">
          {relatedArticles.map((a, i) => {
            const aHero = a.data.heroImage?.src && !a.data.heroImage.src.includes('placeholder')
              ? (a.data.heroImage.src.startsWith('/') ? `${base}${a.data.heroImage.src.slice(1)}` : a.data.heroImage.src)
              : `${base}images/sourced/home-cover.webp`;
            return (
              <article class={i === 0 ? 'feat feat--lead' : 'feat feat--std'}>
                <img class="feat__image" src={aHero} alt={a.data.title} loading="lazy">
                <div class="feat__body">
                  <div class="feat__eyebrow">Journal</div>
                  <a href={`${base}journal/${routeSlug(a)}/`}><h3 class="feat__title">{a.data.title}</h3></a>
                  {a.data.excerpt && <p class="feat__excerpt">{a.data.excerpt}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />

</BaseLayout>
