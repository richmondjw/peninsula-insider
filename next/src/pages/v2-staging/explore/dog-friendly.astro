---
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const sections = [
  {
    title: 'Beaches',
    body: [
      'Mornington foreshore (on lead) — the flat path between Mornington Pier and Schnapper Point, past the bathing boxes. The Peninsula\'s easiest dog-walk with genuine reward.',
      'Mount Martha beaches — sections allow off-lead in designated zones at designated hours. Check council rules before visiting; they change seasonally.',
      'Rosebud foreshore — long, flat, on-lead generally permitted. Less busy than Mornington, good for longer walks.',
      'Balnarring Beach — Western-Port side, quieter and often under-used. On-lead sections are clearly signposted.',
      'Tyrone Beach (Safety Beach) — on-lead; one of the most reliable dog-walking beaches on Port Phillip.',
    ],
  },
  {
    title: 'Walks',
    body: [
      'Mornington foreshore trail (full length) — on-lead, flat, cafés at either end. The default Peninsula dog walk.',
      'Mount Martha clifftop path sections — on-lead, moderate, with views and shaded sections.',
      'Rosebud to Rye foreshore — long flat shared path, on-lead, manageable for longer dog walks.',
      'The national park (Cape Schanck, Point Nepean, Two Bays, Coastal Walk, Bushrangers Bay) bans dogs entirely, including in carparks. This includes Greens Bush and Arthurs Seat State Park. There are no exceptions.',
    ],
  },
  {
    title: 'Cafés',
    body: [
      'Commonfolk, Mornington — outdoor courtyard welcomes dogs.',
      'Trofeo Estate, Dromana — sprawling outdoor area, dogs welcome on the terrace.',
      'Stillwater at Crittenden, Dromana — lakeside winery restaurant; dog-friendly outdoor seating.',
      'The General Food Store, Merricks — dog-friendly outdoor village courtyard.',
      'Moss at Polperro, Main Ridge — outdoor courtyard welcomes dogs with their own water bowls.',
    ],
  },
  {
    title: 'Cellar doors',
    body: [
      'Red Hill Brewery — dog-friendly outdoor area, water bowls, relaxed.',
      'Trofeo Estate — one of the most genuinely dog-welcoming cellar doors on the Peninsula.',
      'Bass & Flinders Distillery — outdoor area welcomes dogs for tastings.',
      'Pt. Leo Estate — sculpture park is dog-friendly on lead; the restaurant and tasting room are not.',
      'Most Peninsula cellar doors permit dogs on outdoor terraces but not inside. Call ahead if in doubt.',
    ],
  },
  {
    title: 'Accommodation',
    body: [
      'Peppers Moonah Links — some dog-friendly rooms; surcharge applies.',
      'Red Hill Epicurean — boutique villas, some dog-friendly options.',
      'Many Peninsula holiday houses on Stayz and Airbnb welcome dogs — filter for "pet-friendly" and confirm with the host before booking.',
      'Most boutique hotels (Jackalope, Lindenderry, The Continental Sorrento) do not take dogs. Check before assuming.',
    ],
  },
];
---

<BaseLayout
  title="Dog-Friendly Mornington Peninsula — Peninsula Insider"
  description="The honest guide to the dog-friendly Peninsula — beaches, walks, cafés, cellar doors and accommodation. Where dogs are actually welcome, and where the national park bans them."
  section="explore"
  ogImage="/images/sourced/dog-beach-emma-01.webp"
>

  <section class="hero" aria-label="Dog-friendly cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <a href={`${base}dog-friendly/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Dog-Friendly</a>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">The honest guide</span>
          </div>
          <h1 class="hero__headline">Dog-friendly Peninsula, honestly.</h1>
          <p class="hero__dek">Mornington Peninsula National Park bans dogs entirely — including Cape Schanck, Point Nepean, and most of the Peninsula's best walks. This is the honest guide to where you can actually go with a dog.</p>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/dog-beach-emma-01.webp`} alt="Wet dog sitting on a Mornington Peninsula beach" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Bay foreshore <span class="ornament">—</span> Mornington Peninsula</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Read this first</span>
        </div>
        <h2 class="letter__head">The national park bans dogs. All of it.</h2>
        <div class="letter__prose">
          <p>Mornington Peninsula National Park prohibits dogs entirely. That includes Cape Schanck, Point Nepean, the Coastal Walk, the Two Bays Trail, and every major Peninsula walking track inside the park boundary. It includes the carparks. Greens Bush and Arthurs Seat State Park are the same. The rules are enforced.</p>
          <p>This is the most common planning error for first-time Peninsula visitors with dogs. If the walk is famous, dogs are probably banned. The bay-side foreshores, most cafés with outdoor seating, and a reasonable number of cellar doors and holiday rentals are the Peninsula dogs can enjoy — and genuinely enjoy. Plan around those, not around the places that won\'t have you.</p>
          <blockquote class="pullquote">Dogs banned from the park. Welcomed on the foreshore. Both are true.</blockquote>
        </div>
      </div>
    </div>
  </section>

  {sections.map(s => (
    <section class="letter">
      <div class="container">
        <div class="letter__frame" style="display:block;">
          <div class="letter__eyebrow">
            <span class="letter__eyebrow-rule"></span>
            <span class="eyebrow eyebrow--ochre">{s.title}</span>
          </div>
          <h2 class="letter__head">{s.title} that welcome dogs.</h2>
          <div class="letter__prose">
            <ul style="padding-left:1.25rem;">
              {s.body.map(line => <li style="margin-bottom:.6rem;">{line}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  <NewsletterBlock />

</BaseLayout>
