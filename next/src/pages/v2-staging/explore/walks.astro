---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, placeLabel } from '../../../lib/editorial';

const experiences = await getCollection('experiences');
const walks = experiences.filter(e => e.data.type === 'walk');

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const tierOne = [
  { rank: 1, name: 'Bushrangers Bay Walk', place: 'Cape Schanck', meta: '5km return · 2 hrs', note: 'The Peninsula\'s most consistently rewarding short walk. Basalt cliffs framing a sandy bay where Main Creek meets the sea. If you only do one real walk on the Peninsula, do this.' },
  { rank: 2, name: 'Coppins Track', place: 'Sorrento → Diamond Bay', meta: '4km one-way · 90 min', note: 'The best town-adjacent clifftop walk on the Peninsula. Flat path above Bass Strait. Pair with coffee in Sorrento either side for the classic Peninsula walk-morning.' },
  { rank: 3, name: 'Point Nepean Walk', place: 'Point Nepean', meta: '13.5km · 4–5 hrs', note: 'Fortifications, quarantine station, Cheviot Beach. History and view competing for attention. The Peninsula\'s best walk for people who find pure nature-walks unsatisfying.' },
  { rank: 4, name: 'Two Bays Walking Trail', place: 'Dromana → Bushrangers Bay', meta: '26km · 1–2 days', note: 'The definitive Peninsula long walk. Ancient grasstrees, eucalypt forest, fern gullies. Best done over two days with camping at Lightwood Creek.' },
];

const tierTwo = [
  { rank: 5, name: 'Greens Bush — Baldrys Long Circuit', place: 'Main Ridge', meta: '3.6km · 1.5 hrs', note: 'Victoria\'s largest surviving coastal heathland remnant. Ancient grasstrees and real wildlife at dusk.' },
  { rank: 6, name: 'The Coastal Walk', place: 'Cape Schanck → London Bridge', meta: '26–30km · 2 days', note: 'The Peninsula\'s wildest walking. Exposed Bass Strait clifftops. Autumn or spring; not suitable for beginners alone.' },
  { rank: 7, name: 'Mornington Peninsula Walk (97.5km)', place: 'Peninsula-wide', meta: '97.5km · 8–10 days', note: 'The full circuit. Treat it as sections across multiple Peninsula visits rather than a single continuous challenge.' },
];

const tierThree = [
  { rank: 8, name: 'Cape Schanck Boardwalk', place: 'Cape Schanck', meta: '20 min return', note: 'Short, accessible, and spectacular. Do not dismiss because it is brief.' },
  { rank: 9, name: 'Farnsworth Track', place: 'London Bridge → Portsea Ocean Beach', meta: '1.5km one-way', note: 'Best in the last two hours of daylight. Genuine clifftop exposure.' },
  { rank: 10, name: 'Arthurs Seat Summit Circuit', place: 'Arthurs Seat', meta: '1.8km · 1 hr', note: 'TC McKeller Walk, William Ricketts sculptures, views to Melbourne.' },
  { rank: 11, name: 'Mornington Foreshore', place: 'Mornington', meta: 'Flat · any distance', note: 'Reliable, pretty, dog-friendly on lead. The Peninsula walk for any weather and any fitness level.' },
];
export const prerender = true;
---

<BaseLayout
  title="Walks on the Mornington Peninsula — The Insider Guide"
  description="The Peninsula's walks, organised in three tiers — the essential, the ambitious, and the short-and-spectacular. Honest difficulty notes and pairing suggestions."
  section="explore"
  ogImage="/images/sourced/explore-bushrangers-bay-walk-01.webp"
>

  <section class="hero" aria-label="Walks cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <a href={`${base}explore/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Explore</a>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">Three tiers <span class="ornament">·</span> eleven walks</span>
          </div>
          <h1 class="hero__headline">The Peninsula walks guide.</h1>
          <p class="hero__dek">Not a trail list. A tiered editorial guide — the walks that define the Peninsula, the ones that require a commitment, and the short walks that deliver well above their size.</p>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/explore-bushrangers-bay-walk-01.webp`} alt="Peninsula walking" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Bushrangers Bay <span class="ornament">—</span> Cape Schanck</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">How to use this guide</span>
        </div>
        <h2 class="letter__head">Three tiers, one Peninsula.</h2>
        <div class="letter__prose">
          <p>The Peninsula walks split naturally into three tiers. <strong>Tier I</strong> — the four walks that anyone visiting the Peninsula should at least consider. <strong>Tier II</strong> — the longer, more demanding walks that define a walking weekend rather than a walking hour. <strong>Tier III</strong> — short walks that deliver more than their distance suggests.</p>
          <p>Dogs are banned from the national park and from Greens Bush. Most walks below exclude them; the <a href={`${base}dog-friendly/`}>dog-friendly guide</a> covers the foreshore alternatives.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="shortlist" aria-labelledby="tier-one">
    <div class="container">
      <div class="shortlist__head">
        <span class="eyebrow eyebrow--ochre">Tier I</span>
        <h2 class="shortlist__title" id="tier-one">The <em>essential</em> walks.</h2>
      </div>
      <ol class="sl-list">
        {tierOne.map(w => (
          <li class="sl-item">
            <div class="sl-item__rank">{String(w.rank).padStart(2, '0')}</div>
            <div class="sl-item__body">
              <div class="sl-item__head">
                <h3 class="sl-item__name">{w.name}</h3>
                <span class="sl-item__meta">{w.place} <span class="ornament">·</span> {w.meta}</span>
              </div>
              <p class="sl-item__note">{w.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="shortlist" aria-labelledby="tier-two">
    <div class="container">
      <div class="shortlist__head">
        <span class="eyebrow eyebrow--ochre">Tier II</span>
        <h2 class="shortlist__title" id="tier-two">The <em>ambitious</em> walks.</h2>
      </div>
      <ol class="sl-list">
        {tierTwo.map(w => (
          <li class="sl-item">
            <div class="sl-item__rank">{String(w.rank).padStart(2, '0')}</div>
            <div class="sl-item__body">
              <div class="sl-item__head">
                <h3 class="sl-item__name">{w.name}</h3>
                <span class="sl-item__meta">{w.place} <span class="ornament">·</span> {w.meta}</span>
              </div>
              <p class="sl-item__note">{w.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="shortlist" aria-labelledby="tier-three">
    <div class="container">
      <div class="shortlist__head">
        <span class="eyebrow eyebrow--ochre">Tier III</span>
        <h2 class="shortlist__title" id="tier-three">The <em>short-and-spectacular</em> walks.</h2>
      </div>
      <ol class="sl-list">
        {tierThree.map(w => (
          <li class="sl-item">
            <div class="sl-item__rank">{String(w.rank).padStart(2, '0')}</div>
            <div class="sl-item__body">
              <div class="sl-item__head">
                <h3 class="sl-item__name">{w.name}</h3>
                <span class="sl-item__meta">{w.place} <span class="ornament">·</span> {w.meta}</span>
              </div>
              <p class="sl-item__note">{w.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {walks.length > 0 && (
    <section class="dept" aria-labelledby="walk-guides">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Walk guides</span>
            <h2 class="dept__title" id="walk-guides">Full <em>guides</em>.</h2>
          </div>
        </div>
        <div class="dept__grid">
          {walks.slice(0, 6).map(w => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(w.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">Walk</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(w.data.place)}</span>
              </div>
              <a href={`${base}explore/${routeSlug(w)}/`}><h3 class="venue__name">{w.data.name}</h3></a>
              <p class="venue__sig">{w.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />

</BaseLayout>
