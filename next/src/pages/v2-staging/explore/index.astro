---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, placeLabel, typeLabel, titleize, currentSeason, seasonBlurb, experienceInSeason } from '../../../lib/editorial';

const experiences = await getCollection('experiences');
const places = await getCollection('places');
const itineraries = await getCollection('itineraries');
const articles = await getCollection('articles', ({ data }) => data.status === 'published');

const walks = experiences.filter(e => e.data.type === 'walk');
const beaches = experiences.filter(e => e.data.type === 'beach');
const lookouts = experiences.filter(e => e.data.type === 'lookout');
const markets = experiences.filter(e => e.data.type === 'market');
const wellness = experiences.filter(e => e.data.type === 'spa' || e.data.type === 'hot-spring');
const galleriesAttractions = experiences.filter(e => e.data.type === 'gallery' || e.data.type === 'attraction');

const shortWalks = walks.filter(w => (w.data.durationMinutes ?? 999) <= 60);
const longWalks = walks.filter(w => (w.data.durationMinutes ?? 0) > 60);

const season = currentSeason();
const seasonal = experiences.filter(e => experienceInSeason(e, season)).slice(0, 6);

const featuredPlaces = places.slice(0, 4);
const companionReads = articles
  .filter(a => a.data.tags?.some(t => ['walks','beaches','explore','experience','itinerary'].includes(t)))
  .sort((a,b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 4);

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout
  title="Explore the Mornington Peninsula — The Insider's Field Guide"
  description="Walks, beaches, lookouts, markets, wellness and the peninsula's defining experiences — curated, seasonal, honest."
  section="explore"
  ogImage="/images/sourced/explore-hub-hero-01.webp"
>

  <section class="hero" aria-label="Explore cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <span class="hero__meta-tag">Explore</span>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">{titleize(season)} field guide</span>
          </div>
          <h1 class="hero__headline">The Peninsula, experienced.</h1>
          <p class="hero__dek">Not a list of things to do. A field guide to the walks, beaches, markets and rituals that make the Peninsula a place worth returning to — matched to the kind of day you are actually trying to have.</p>
          <div class="hero__byline">
            <span>By the editors <span class="ornament">·</span> {seasonBlurb[season].line}</span>
          </div>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/explore-hub-hero-01.webp`} alt="Peninsula coast" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Cape Schanck <span class="ornament">—</span> Mornington Peninsula</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="contents" aria-label="In this issue">
    <div class="container">
      <div class="contents__inner">
        <span class="eyebrow eyebrow--ochre">In this field guide</span>
        <nav class="contents__nav">
          <a href="#walks">Walks</a>
          <a href="#beaches">Beaches</a>
          <a href="#lookouts">Lookouts</a>
          <a href="#markets">Markets</a>
          <a href="#wellness">Wellness</a>
          <a href="#seasonal">In season</a>
          <a href="#places">Places</a>
          <a href="#reading">Journal</a>
        </nav>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame">
        <div class="letter__body">
          <div class="letter__eyebrow">
            <span class="letter__eyebrow-rule"></span>
            <span class="eyebrow eyebrow--ochre">The editor's note</span>
          </div>
          <h2 class="letter__head">On exploring properly.</h2>
          <div class="letter__prose">
            <p>The Peninsula rewards people who know how to read it. The Cape Schanck boardwalk is twenty minutes and genuinely unmissable. The Bushrangers Bay walk is an hour from the same carpark and most visitors never do it. The first gets recommended; the second changes the day.</p>
            <p>What follows is not a catalogue. It is a filter — short walks that earn the drive, beaches that repay the effort of finding them, markets worth timing a weekend around, and the rituals (spa, lookout, long coffee) that stitch it all together.</p>
            <blockquote class="pullquote">The honest walk recommendation is more useful than the famous one.</blockquote>
          </div>
        </div>
        <aside class="letter__side">
          <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
            <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">Quick guides</p>
            <ul style="list-style:none; padding:0; margin:0; font-family:var(--sans,'Inter'),sans-serif; font-size:.92rem; line-height:1.9;">
              <li><a href={`${base}explore/best-walks/`} style="color:inherit;">Best walks →</a></li>
              <li><a href={`${base}explore/beaches/`} style="color:inherit;">Beaches →</a></li>
              <li><a href={`${base}explore/things-to-do/`} style="color:inherit;">25 things to do →</a></li>
              <li><a href={`${base}explore/day-trips/`} style="color:inherit;">Day trips →</a></li>
              <li><a href={`${base}explore/weekend-trips/`} style="color:inherit;">Weekend trips →</a></li>
              <li><a href={`${base}explore/where-to-base-yourself/`} style="color:inherit;">Where to base →</a></li>
              <li><a href={`${base}explore/getting-here/`} style="color:inherit;">Getting here →</a></li>
              <li><a href={`${base}explore/getting-around/`} style="color:inherit;">Getting around →</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {walks.length > 0 && (
    <section class="dept" id="walks" aria-labelledby="walks-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Department I</span>
            <h2 class="dept__title" id="walks-title">Walks, <em>honestly</em> ranked.</h2>
          </div>
          <a href={`${base}explore/best-walks/`} class="well__head-link">All walks →</a>
        </div>
        <div class="dept__grid">
          {walks.slice(0, 6).map(e => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(e.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">{typeLabel[e.data.type] ?? 'Walk'}</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(e.data.place)}</span>
                <span class="venue__meta-sep"></span>
                <span>{e.data.durationMinutes ? `${e.data.durationMinutes} min` : 'Varies'}</span>
              </div>
              <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
              <p class="venue__sig">{e.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {beaches.length > 0 && (
    <section class="dept" id="beaches" aria-labelledby="beaches-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Department II</span>
            <h2 class="dept__title" id="beaches-title">Beaches — <em>bay and back</em>.</h2>
          </div>
          <a href={`${base}explore/beaches/`} class="well__head-link">All beaches →</a>
        </div>
        <div class="dept__grid">
          {beaches.slice(0, 6).map(e => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(e.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">Beach</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(e.data.place)}</span>
              </div>
              <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
              <p class="venue__sig">{e.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {lookouts.length > 0 && (
    <section class="dept" id="lookouts" aria-labelledby="lookouts-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Department III</span>
            <h2 class="dept__title" id="lookouts-title">Lookouts — <em>the long view</em>.</h2>
          </div>
        </div>
        <div class="dept__grid">
          {lookouts.slice(0, 6).map(e => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(e.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">Lookout</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(e.data.place)}</span>
              </div>
              <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
              <p class="venue__sig">{e.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {markets.length > 0 && (
    <section class="dept" id="markets" aria-labelledby="markets-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Department IV</span>
            <h2 class="dept__title" id="markets-title">Markets — <em>produce and people</em>.</h2>
          </div>
          <a href={`${base}explore/markets/`} class="well__head-link">All markets →</a>
        </div>
        <div class="dept__grid">
          {markets.slice(0, 6).map(e => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(e.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">Market</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(e.data.place)}</span>
              </div>
              <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
              <p class="venue__sig">{e.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {wellness.length > 0 && (
    <section class="dept" id="wellness" aria-labelledby="wellness-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Department V</span>
            <h2 class="dept__title" id="wellness-title">Wellness — <em>the reset</em>.</h2>
          </div>
          <a href={`${base}spa/`} class="well__head-link">Spa guide →</a>
        </div>
        <div class="dept__grid">
          {wellness.slice(0, 3).map(e => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(e.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">Wellness</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(e.data.place)}</span>
              </div>
              <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
              <p class="venue__sig">{e.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {seasonal.length > 0 && (
    <section class="dept" id="seasonal" aria-labelledby="seasonal-title">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">In season</span>
            <h2 class="dept__title" id="seasonal-title">This {season}, <em>specifically</em>.</h2>
          </div>
        </div>
        <div class="dept__grid">
          {seasonal.map(e => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(e.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">{typeLabel[e.data.type] ?? 'Experience'}</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(e.data.place)}</span>
              </div>
              <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
              <p class="venue__sig">{e.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {featuredPlaces.length > 0 && (
    <section class="places" id="places" aria-labelledby="places-title">
      <div class="container">
        <div class="places__head">
          <span class="eyebrow eyebrow--ochre">Places</span>
          <h2 class="places__title" id="places-title">Where to <em>base yourself</em>.</h2>
        </div>
        <div class="places__grid">
          {featuredPlaces.map(p => (
            <article class="place">
              <h3 class="place__name">{p.data.name}</h3>
              <p class="place__sig">{p.data.signature ?? p.data.description}</p>
              <a href={`${base}places/${p.id ?? p.data.slug}/`} class="place__link">Read →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {companionReads.length > 0 && (
    <section class="well" id="reading" aria-labelledby="reading-title">
      <div class="container">
        <div class="well__head">
          <div>
            <span class="eyebrow eyebrow--ochre">From the journal</span>
            <h2 class="well__head-title" id="reading-title" style="margin-top:.5rem;">Companion <em>reading</em>.</h2>
          </div>
          <a href={`${base}journal/`} class="well__head-link">All journal →</a>
        </div>
        <div class="well__grid">
          {companionReads.map((a, i) => (
            <article class={i === 0 ? 'feat feat--lead' : 'feat feat--std'}>
              <img class="feat__image" src={`${base}${(a.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')}`} alt={a.data.title} loading="lazy">
              <div class="feat__body">
                <div class="feat__eyebrow">Journal</div>
                <a href={`${base}journal/${routeSlug(a)}/`}><h3 class="feat__title">{a.data.title}</h3></a>
                {a.data.excerpt && <p class="feat__excerpt">{a.data.excerpt}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />

</BaseLayout>
