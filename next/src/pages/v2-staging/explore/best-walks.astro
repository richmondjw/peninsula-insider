---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, placeLabel, typeLabel } from '../../../lib/editorial';

const experiences = await getCollection('experiences');
const walks = experiences.filter(e => e.data.type === 'walk');

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const shortlist = [
  { rank: 1, name: 'Bushrangers Bay Walk', place: 'Cape Schanck', meta: '5km return · 2 hrs · Easy–Moderate', note: 'The walk that consistently surprises first-time visitors. Basalt cliffs, a creek-to-sea bay where almost no one is there after 11am on weekdays. The Peninsula walk to clear the morning for.' },
  { rank: 2, name: 'Coppins Track', place: 'Sorrento → Diamond Bay', meta: '4km one-way · 90 min · Easy', note: 'The strongest town-adjacent clifftop walk on the Peninsula. Flat clifftop path above Bass Strait, with Diamond Bay as a genuine endpoint. Coffee in Sorrento either side.' },
  { rank: 3, name: 'Point Nepean Walk', place: 'Point Nepean', meta: '13.5km · 4–5 hrs · Easy–Moderate', note: 'Military fortifications from 1878, the quarantine station, Cheviot Beach where PM Harold Holt disappeared. The history competes with the view, which is the highest compliment a walk can earn.' },
  { rank: 4, name: 'Two Bays Walking Trail', place: 'Dromana → Bushrangers Bay', meta: '26km · 1–2 days · Moderate', note: 'The Peninsula\'s definitive long walk. Ancient grasstrees, eucalypt forest, fern gullies, grassland. Best split across two days with overnight camping at Lightwood Creek.' },
  { rank: 5, name: 'Greens Bush — Baldrys Long Circuit', place: 'Main Ridge', meta: '3.6km · 1.5 hrs · Easy', note: 'Victoria\'s largest surviving coastal heathland remnant. Ancient grasstrees and a reasonable chance of kangaroos at dusk. The Peninsula\'s most under-visited good walk.' },
  { rank: 6, name: 'Cape Schanck Boardwalk', place: 'Cape Schanck', meta: '20 min return · Accessible', note: 'Short, surfaced, and genuinely spectacular. The lighthouse platform above Bass Strait is the best short-stop on the southern Peninsula. Do not dismiss it because it is brief.' },
  { rank: 7, name: 'Farnsworth Track', place: 'London Bridge → Portsea Ocean Beach', meta: '1.5km one-way · 30 min · Easy', note: 'The late-afternoon clifftop walk. Best done at 4pm in autumn or winter for the light. Not for anyone uncomfortable near exposed edges.' },
  { rank: 8, name: 'Arthurs Seat Summit Circuit', place: 'Arthurs Seat', meta: '1.8km · 1 hr · Moderate', note: 'TC McKeller Walk, William Ricketts sculptures, and views to Melbourne on a clear day. Combine with the Eagle gondola for a one-way walk.' },
  { rank: 9, name: 'The Coastal Walk', place: 'Cape Schanck → London Bridge', meta: '26–30km · 2 days · Moderate–Hard', note: 'The Peninsula\'s wildest walking. Bass Strait clifftops, Bay of Islands, St Paul\'s, Diamond Bay, Jubilee Point. Exposed and demanding; autumn or spring only.' },
  { rank: 10, name: 'Mornington Foreshore', place: 'Mornington', meta: 'Varies · Flat · Dogs on lead', note: 'Flat path between Mornington Pier and Schnapper Point, past the bathing boxes. Reliably good, any weather, any fitness level. Cafés at both ends.' },
  { rank: 11, name: 'Mornington Peninsula Walk (Full Circuit)', place: 'Peninsula-wide', meta: '97.5km · 8–10 days', note: 'The full circuit — Two Bays, Coastal Walk, Point Nepean, Bay Trail. More enjoyable in sections across several visits than as a single time trial. Not a race.' },
];
export const prerender = true;
---

<BaseLayout
  title="Best Walks on the Mornington Peninsula — Peninsula Insider"
  description="Eleven Peninsula walks, editorially ranked. Bushrangers Bay, Coppins Track, Point Nepean, the Two Bays Trail — honest characterisation, not trail stats."
  section="explore"
  ogImage="/images/sourced/explore-bushrangers-bay-walk-01.webp"
>

  <section class="hero" aria-label="Best walks cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <a href={`${base}explore/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Explore</a>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">11 walks <span class="ornament">·</span> honestly ranked</span>
          </div>
          <h1 class="hero__headline">The Peninsula walks worth the drive.</h1>
          <p class="hero__dek">Not a trail database. An editorial ranking — which walks actually deliver the day they promise, and which ones are famous for reasons other than the walking.</p>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/explore-bushrangers-bay-walk-01.webp`} alt="Bushrangers Bay walk" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Bushrangers Bay <span class="ornament">—</span> Cape Schanck</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame">
        <div class="letter__body">
          <div class="letter__eyebrow">
            <span class="letter__eyebrow-rule"></span>
            <span class="eyebrow eyebrow--ochre">The editor's note</span>
          </div>
          <h2 class="letter__head">On ranking walks.</h2>
          <div class="letter__prose">
            <p>Parks Victoria has the facts. AllTrails has the reviews. Neither will tell you that Bushrangers Bay is the walk most visitors should be doing instead of the Cape Schanck boardwalk they have heard of, or that the Long Point Circuit in Greens Bush is the Peninsula's most under-visited good walk. This list will.</p>
            <p>Dogs are banned from Mornington Peninsula National Park and from Greens Bush. That eliminates most of the entries below for dog owners. We flag this clearly on each walk rather than burying it — see the <a href={`${base}dog-friendly/`}>dog-friendly guide</a> for the alternatives that genuinely work.</p>
            <blockquote class="pullquote">The walk that is famous is not always the walk that is best.</blockquote>
          </div>
        </div>
        <aside class="letter__side">
          <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
            <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">If you only do one</p>
            <p style="font-family:var(--sans,'Inter'),sans-serif; font-size:.92rem; line-height:1.6;">
              <strong>First-time visitor:</strong> Bushrangers Bay.<br><br>
              <strong>Twenty minutes:</strong> Cape Schanck boardwalk.<br><br>
              <strong>Full day:</strong> Two Bays Trail (or at least one segment).<br><br>
              <strong>With a coffee:</strong> Coppins Track from Sorrento.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="shortlist" aria-labelledby="walks-title">
    <div class="container">
      <div class="shortlist__head">
        <span class="eyebrow eyebrow--ochre">The ranking</span>
        <h2 class="shortlist__title" id="walks-title">Eleven walks, <em>editorially ranked</em>.</h2>
      </div>
      <ol class="sl-list">
        {shortlist.map(w => (
          <li class="sl-item">
            <div class="sl-item__rank">{String(w.rank).padStart(2, '0')}</div>
            <div class="sl-item__body">
              <div class="sl-item__head">
                <h3 class="sl-item__name">{w.name}</h3>
                <span class="sl-item__meta">{w.place} <span class="ornament">·</span> {w.meta}</span>
              </div>
              <p class="sl-item__note">{w.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {walks.length > 0 && (
    <section class="dept" aria-labelledby="more-walks">
      <div class="container">
        <div class="dept__head">
          <div class="dept__titles">
            <span class="eyebrow eyebrow--ochre">Walk guides</span>
            <h2 class="dept__title" id="more-walks">Read the <em>full guides</em>.</h2>
          </div>
          <a href={`${base}explore/`} class="well__head-link">All experiences →</a>
        </div>
        <div class="dept__grid">
          {walks.slice(0, 6).map(w => (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}${(w.data.heroImage?.src ?? 'images/sourced/home-cover.webp').replace(/^\//,'')});background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">Walk</span>
              </div>
              <div class="venue__meta">
                <span>{placeLabel(w.data.place)}</span>
                <span class="venue__meta-sep"></span>
                <span>{w.data.durationMinutes ? `${w.data.durationMinutes} min` : 'Varies'}</span>
              </div>
              <a href={`${base}explore/${routeSlug(w)}/`}><h3 class="venue__name">{w.data.name}</h3></a>
              <p class="venue__sig">{w.data.signature}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />

</BaseLayout>
