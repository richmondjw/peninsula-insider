---
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const sections = [
  {
    title: 'Beaches',
    intro: 'For children, bay side. Always. The back beaches are for photographs, not swimming.',
    items: [
      'Shelly Beach (Portsea) — shallow, calm, clear water. The best family-swim on the Peninsula.',
      'Mills Beach (Mornington) — bathing boxes, flat sand, 100m from town cafés.',
      'Mornington Main Beach — pier, sheltered water, foreshore walk either direction.',
      'Rye Front Beach — sheltered, gentle, pier for crabbing.',
      'Safety Beach — broad, flat, calm. Long stretch for building sandcastles.',
    ],
  },
  {
    title: 'Attractions',
    intro: 'Events and destinations that work for mixed ages without becoming parking-lot purgatory.',
    items: [
      'Arthurs Seat Eagle — the gondola up the hill. Short, visual, memorable. Strong for ages 4+.',
      'The Enchanted Adventure Garden — maze, tree-surfing, flying foxes. A full morning or afternoon for families with children 6+.',
      'Cape Schanck Lighthouse tour — short guided tour; 20-minute boardwalk walk before or after.',
      'Ashcombe Maze — hedge maze and lavender garden. Classic, compact, reliably enjoyed.',
      'Peninsula Hot Springs Family Bathing sessions — dedicated family times; better than trying to use general sessions with young children.',
    ],
  },
  {
    title: 'Walks',
    intro: 'Short, flat, with a clear reward at the end.',
    items: [
      'Cape Schanck boardwalk — 20 minutes return, fully accessible, spectacular lighthouse platform.',
      'Mornington foreshore — flat path, cafés at both ends, bathing boxes as visual anchors.',
      'Baldrys Short Circuit, Greens Bush — 1.6km, 45 min, real bush experience for older children.',
      'The Arthurs Seat summit circuit — 1.8km, formed path, William Ricketts sculptures en route.',
      'Avoid the clifftop tracks (Farnsworth, Coppins, Coastal Walk) with young children — the exposure is not appropriate.',
    ],
  },
  {
    title: 'Markets',
    intro: 'Markets make a Peninsula morning with children significantly better.',
    items: [
      'Red Hill Community Market (1st Saturday, Sept–May) — festival atmosphere, live music, food stalls, space to roam.',
      'Mornington Farmers Market (2nd Saturday) — serious producer market; children enjoy the tastings and the racecourse setting.',
      'Balnarring Racecourse Community Market (3rd Saturday) — broader stalls, easier parking.',
      'Go early. Bring sunscreen. Let children spend the money on the stall they choose.',
    ],
  },
  {
    title: 'Food',
    intro: 'Peninsula dining with children is easier than Melbourne dining with children, if you pick the right venues.',
    items: [
      'Montalto — welcomes children for lunch; sculpture-garden walk before or after extends the visit.',
      'Red Hill Brewery — outdoor space, casual atmosphere, food that works for mixed ages.',
      'Commonfolk (Mornington) — a relaxed brunch spot with space; avoid Sunday peak unless you can queue.',
      'Stillwater at Crittenden — lakeside, relaxed, paddleboats for children.',
      'Ice cream at Sorrento on Ocean Beach Road — the Peninsula Sunday afternoon tradition.',
    ],
  },
];
export const prerender = true;
---

<BaseLayout
  title="Family-Friendly Mornington Peninsula — Peninsula Insider"
  description="The Peninsula for families — beaches, attractions, walks, markets and food that work for mixed ages without becoming a scramble. Honest, specific, local."
  section="explore"
  ogImage="/images/sourced/explore-hub-hero-01.webp"
>

  <section class="hero" aria-label="Family-friendly cover">
    <div class="container">
      <div class="hero__frame">
        <div class="hero__above">
          <div class="hero__meta">
            <a href={`${base}explore/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Explore</a>
            <span class="hero__meta-divider"></span>
            <span class="hero__meta-date">The family guide</span>
          </div>
          <h1 class="hero__headline">Peninsula with children, properly.</h1>
          <p class="hero__dek">A Peninsula weekend with children should not be an endurance event. These are the beaches, walks, attractions and meals that work across ages — chosen for reliability, not length of list.</p>
        </div>
        <figure>
          <img class="hero__image" src={`${base}images/sourced/explore-hub-hero-01.webp`} alt="Family Peninsula" loading="eager" fetchpriority="high">
          <figcaption class="hero__image-cap">
            <span>Peninsula bay side</span>
            <span>Photography <span class="ornament">/</span> The Insider</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Start here</span>
        </div>
        <h2 class="letter__head">Bay side mornings, one activity a day.</h2>
        <div class="letter__prose">
          <p>The Peninsula family-weekend failure mode is trying to do too much. A morning at a beach, an afternoon at one attraction, and a dinner that suits the children is enough for a day. Two attractions plus a walk plus a sit-down lunch plus a sunset at Sorrento is three activities too many.</p>
          <p>Base yourself near a bay-side beach (Mornington, Mount Martha, Safety Beach or Rye) and drive out for the one activity each day. The drive times are short enough that this works, and children recover better between short excursions than long sustained ones.</p>
        </div>
      </div>
    </div>
  </section>

  {sections.map(s => (
    <section class="letter">
      <div class="container">
        <div class="letter__frame" style="display:block;">
          <div class="letter__eyebrow">
            <span class="letter__eyebrow-rule"></span>
            <span class="eyebrow eyebrow--ochre">{s.title}</span>
          </div>
          <h2 class="letter__head">{s.title}.</h2>
          <div class="letter__prose">
            <p>{s.intro}</p>
            <ul style="padding-left:1.25rem;">
              {s.items.map(line => <li style="margin-bottom:.6rem;">{line}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  <NewsletterBlock />

</BaseLayout>
