---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../components/v2/NewsletterBlock.astro';
import { routeSlug, stayTypes, wineTypes } from '../../lib/editorial';

const [venues, experiences, places, articles, itineraries, events] = await Promise.all([
  getCollection('venues'),
  getCollection('experiences'),
  getCollection('places'),
  getCollection('articles', ({ data }) => data.status === 'published'),
  getCollection('itineraries'),
  getCollection('events'),
]);

const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];

const eatVenues = venues.filter((v) => eatTypes.includes(v.data.type)).slice(0, 40);
const stayVenues = venues.filter((v) => stayTypes.includes(v.data.type)).slice(0, 20);
const wineVenues = venues.filter((v) => wineTypes.includes(v.data.type)).slice(0, 30);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Site Index — Peninsula Insider"
  description="A crawlable index of Peninsula Insider sections, guides, places, venues, events, and planning pages."
  section=""
>

<section class="hero" aria-label="Page cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <span class="eyebrow eyebrow--ochre">Site index <span class="ornament">·</span> The whole guide</span>
        <h1 class="hero__headline">Site <em>Index</em>.</h1>
        <p class="hero__dek">A direct index of the major sections and planning pages on Peninsula Insider. Useful for readers, and useful for crawlers.</p>
      </div>
    </div>
  </div>
</section>

<section class="contents" aria-label="Site index">
  <div class="container">
    <div class="contents__head">
      <div>
        <span class="eyebrow eyebrow--ochre">In this index</span>
        <h2 style="margin-top:.5rem;">Every section, <em>every page</em>.</h2>
      </div>
      <div class="byline">{articles.length} pieces <span class="ornament">·</span> {venues.length} venues <span class="ornament">·</span> {places.length} places <span class="ornament">·</span> {itineraries.length} escape plans</div>
    </div>

    <div class="contents__grid">

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Core sections</span>
          <span class="contents__dept-num">I</span>
        </div>
        <a href={`${base}eat/`} class="contents__item"><span class="contents__item-num">01</span><span>Eat &amp; Drink</span></a>
        <a href={`${base}stay/`} class="contents__item"><span class="contents__item-num">02</span><span>Stay</span></a>
        <a href={`${base}wine/`} class="contents__item"><span class="contents__item-num">03</span><span>Wine</span></a>
        <a href={`${base}explore/`} class="contents__item"><span class="contents__item-num">04</span><span>Explore</span></a>
        <a href={`${base}escape/`} class="contents__item"><span class="contents__item-num">05</span><span>Escape</span></a>
        <a href={`${base}whats-on/`} class="contents__item"><span class="contents__item-num">06</span><span>What's On</span></a>
        <a href={`${base}journal/`} class="contents__item"><span class="contents__item-num">07</span><span>Journal</span></a>
        <a href={`${base}places/`} class="contents__item"><span class="contents__item-num">08</span><span>Places</span></a>
      </div>

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Priority planning pages</span>
          <span class="contents__dept-num">II</span>
        </div>
        <a href={`${base}eat/best-restaurants/`} class="contents__item"><span class="contents__item-num">01</span><span>Best Restaurants</span></a>
        <a href={`${base}wine/best-cellar-doors/`} class="contents__item"><span class="contents__item-num">02</span><span>Best Cellar Doors</span></a>
        <a href={`${base}explore/best-walks/`} class="contents__item"><span class="contents__item-num">03</span><span>Best Walks</span></a>
        <a href={`${base}stay/best-accommodation/`} class="contents__item"><span class="contents__item-num">04</span><span>Best Accommodation</span></a>
        <a href={`${base}journal/mornington-peninsula-day-trip/`} class="contents__item"><span class="contents__item-num">05</span><span>Mornington Peninsula Day Trip</span></a>
        <a href={`${base}journal/mornington-peninsula-in-autumn/`} class="contents__item"><span class="contents__item-num">06</span><span>Mornington Peninsula in Autumn</span></a>
        <a href={`${base}journal/mornington-peninsula-with-kids/`} class="contents__item"><span class="contents__item-num">07</span><span>Mornington Peninsula with Kids</span></a>
        <a href={`${base}journal/dog-friendly-mornington-peninsula/`} class="contents__item"><span class="contents__item-num">08</span><span>Dog-Friendly Mornington Peninsula</span></a>
      </div>

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Places</span>
          <span class="contents__dept-num">III</span>
        </div>
        {places.map((place, index) => (
          <a href={`${base}places/${routeSlug(place)}/`} class="contents__item">
            <span class="contents__item-num">{String(index + 1).padStart(2, '0')}</span>
            <span>{place.data.name}</span>
          </a>
        ))}
      </div>

      <div class="contents__dept">
        <div class="contents__dept-head">
          <span class="contents__dept-title">Escape plans</span>
          <span class="contents__dept-num">IV</span>
        </div>
        {itineraries.map((entry, index) => (
          <a href={`${base}escape/${routeSlug(entry)}/`} class="contents__item">
            <span class="contents__item-num">{String(index + 1).padStart(2, '0')}</span>
            <span>{entry.data.title}</span>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

<section class="letter" aria-label="All pages">
  <div class="container">
    <div class="letter__frame" style="display:block; max-width:46rem; margin-inline:auto;">
      <div class="letter__body">
        <div class="letter__prose v2-article-body">

          <h2>Selected Eat &amp; Drink pages</h2>
          <ul>
            {eatVenues.map((venue) => (
              <li><a href={`${base}eat/${routeSlug(venue)}/`}>{venue.data.name}</a></li>
            ))}
          </ul>

          <h2>Selected Stay pages</h2>
          <ul>
            {stayVenues.map((venue) => (
              <li><a href={`${base}stay/${routeSlug(venue)}/`}>{venue.data.name}</a></li>
            ))}
          </ul>

          <h2>Selected Wine pages</h2>
          <ul>
            {wineVenues.map((venue) => (
              <li><a href={`${base}wine/${routeSlug(venue)}/`}>{venue.data.name}</a></li>
            ))}
          </ul>

          <h2>Experiences</h2>
          <ul>
            {experiences.map((entry) => (
              <li><a href={`${base}explore/${routeSlug(entry)}/`}>{entry.data.name}</a></li>
            ))}
          </ul>

          <h2>What's On</h2>
          <ul>
            {events.map((entry) => (
              <li><a href={`${base}whats-on/${routeSlug(entry)}/`}>{entry.data.title}</a></li>
            ))}
          </ul>

          <h2>Journal</h2>
          <ul>
            {articles.slice(0, 50).map((entry) => (
              <li><a href={`${base}journal/${routeSlug(entry)}/`}>{entry.data.title}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock />

<style is:global>
  .v2-article-body h2 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-feature-settings: 'opsz' 32;
  }
  .v2-article-body h3 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
  .v2-article-body p { margin-bottom: 1.2rem; }
  .v2-article-body blockquote {
    border-left: 3px solid var(--ochre, #a0612d);
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-family: var(--serif, 'Newsreader'), serif;
    font-style: italic;
    font-size: 1.2rem;
  }
  .v2-article-body ul, .v2-article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .v2-article-body li { margin-bottom: .5rem; }
  .v2-article-body a {
    color: var(--ochre, #a0612d);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>

</BaseLayout>
