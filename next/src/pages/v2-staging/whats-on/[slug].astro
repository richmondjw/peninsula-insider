---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import V2EventDetail from '../../../components/v2/V2EventDetail.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../../lib/editorial';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: routeSlug(event) },
    props: { event },
  }));
}

const { event } = Astro.props;
const place = event.data.place ? await getEntry(event.data.place).catch(() => null) : null;
const venue = event.data.venue ? await getEntry(event.data.venue).catch(() => null) : null;

const allEvents = (await getCollection('events')).filter((e) => routeSlug(e) !== routeSlug(event));
const related = allEvents
  .filter((e) => e.data.category === event.data.category)
  .slice(0, 3);
const relatedFallback = allEvents.slice(0, 3);
const sidebar = related.length >= 2 ? related : relatedFallback;
export const prerender = true;
---
<BaseLayout
  title={`${event.data.title}, ${place?.data?.name ?? 'Mornington Peninsula'} · Peninsula Insider`}
  description={event.data.summary}
  section="whats-on"
  ogImage={event.data.heroImage?.src}
>
  <V2EventDetail
    event={event}
    place={place}
    venue={venue}
    related={sidebar}
  />
  <NewsletterBlock />
</BaseLayout>
