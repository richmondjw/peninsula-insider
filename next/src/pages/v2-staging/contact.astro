---
import BaseLayout from '../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../components/v2/NewsletterBlock.astro';

const contactReasons = [
  {
    title: 'Story tips',
    body: 'Know something we should? A new opening, a closure, a chef move, a venue that deserves coverage — or one that\'s coasting? We read everything.',
    email: 'tips@peninsulainsider.com.au',
  },
  {
    title: 'Corrections',
    body: 'If we\'ve got a phone number wrong, a price band out of date, or a detail that doesn\'t match reality — tell us. Accuracy is the whole point.',
    email: 'corrections@peninsulainsider.com.au',
  },
  {
    title: 'Editorial enquiries',
    body: 'For questions about our editorial process, partnership philosophy, or anything that doesn\'t fit the other boxes.',
    email: 'hello@peninsulainsider.com.au',
  },
];

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Contact — Peninsula Insider"
  description="Get in touch with Peninsula Insider. Story tips, corrections, and editorial enquiries."
  section=""
>

<section class="hero" aria-label="Page cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <span class="eyebrow eyebrow--ochre">Contact <span class="ornament">·</span> Editorial</span>
        <h1 class="hero__headline">Tips, corrections, and things we should <em>know</em>.</h1>
        <p class="hero__dek">We don't run a tips line for clicks. But if something on the Peninsula has changed, opened, closed, or deserves attention — we want to hear about it.</p>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" aria-labelledby="contact-reasons-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">Reach the desk</span>
        <h2 id="contact-reasons-title">Three ways to <em>get in touch</em>.</h2>
        <p class="shortlist__intro-body">Pick the inbox that matches the message. We read every email — we don't always reply, but nothing is wasted.</p>
      </div>
      <ol class="shortlist__list" style="list-style:none;">
        {contactReasons.map((reason, index) => (
          <li class="sl-item">
            <span class="sl-item__num">{String(index + 1).padStart(2, '0')}</span>
            <div class="sl-item__body">
              <a href={`mailto:${reason.email}`} class="sl-item__name">{reason.title}</a>
              <p class="sl-item__why">{reason.body}</p>
              <div class="sl-item__tags">
                <span class="sl-item__tag"><a href={`mailto:${reason.email}`}>{reason.email}</a></span>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-label="For venues">
  <div class="container">
    <div class="letter__frame" style="display:block; max-width:46rem; margin-inline:auto;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">For venues</span>
        </div>
        <h2 class="letter__head">We don't accept <em>paid placements</em>.</h2>
        <div class="letter__prose v2-article-body">
          <p>If you run a venue on the Peninsula and you'd like to be covered, there's nothing to buy. We choose what to cover based on editorial merit — is this place doing something interesting, doing it well, and would a reader's weekend be better for knowing about it?</p>
          <p>You're welcome to let us know you exist. Send a note to <a href="mailto:tips@peninsulainsider.com.au">tips@peninsulainsider.com.au</a> with your venue name, location, and what you think makes it worth a visit. We'll add it to our list. No promises, no timelines, no invoices.</p>
          <p>If your venue is already listed and something has changed — new chef, new hours, a renovation, a closure — please send corrections to <a href="mailto:corrections@peninsulainsider.com.au">corrections@peninsulainsider.com.au</a>. We take accuracy seriously and will update promptly.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="letter" aria-label="What to expect">
  <div class="container">
    <div class="letter__frame" style="display:block; max-width:46rem; margin-inline:auto;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">What to expect</span>
        </div>
        <h2 class="letter__head">A small desk, <em>honest replies</em>.</h2>
        <div class="letter__prose v2-article-body">
          <p>We're a small editorial operation. We read every email, but we don't always reply — especially to tips. If your tip leads to coverage, you'll see it on the site. If a correction is valid, we'll fix it and you'll see the update.</p>
          <p>We don't do phone calls, media kits, or press events. We do eat lunch, walk the coast, and visit cellar doors — often unannounced. That's the job.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock />

<style is:global>
  .v2-article-body h2 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-feature-settings: 'opsz' 32;
  }
  .v2-article-body h3 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
  .v2-article-body p { margin-bottom: 1.2rem; }
  .v2-article-body blockquote {
    border-left: 3px solid var(--ochre, #a0612d);
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-family: var(--serif, 'Newsreader'), serif;
    font-style: italic;
    font-size: 1.2rem;
  }
  .v2-article-body ul, .v2-article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .v2-article-body li { margin-bottom: .5rem; }
  .v2-article-body a {
    color: var(--ochre, #a0612d);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>

</BaseLayout>
