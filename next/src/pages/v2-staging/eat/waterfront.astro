---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const waterfrontSlugs = ['the-baths-sorrento', 'the-rocks-mornington', 'portsea-hotel', 'afloat-mornington'];

const venues = waterfrontSlugs
  .map(s => allVenues.find(v => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Waterfront Restaurants Mornington Peninsula',
  description: 'The best waterfront restaurants on the Mornington Peninsula — genuine bay-facing positions at Sorrento, Mornington, and Portsea.',
  url: 'https://peninsulainsider.com.au/eat/waterfront/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Waterfront Dining', item: 'https://peninsulainsider.com.au/eat/waterfront/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What are the best waterfront restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Baths at Sorrento (panoramic Port Phillip Bay views, 2-course $75pp), The Rocks at Mornington (harbour deck, Melbourne skyline views, dog-friendly outdoor deck), and Portsea Hotel (sweeping bay views, pub format, dog-friendly beer garden) are the three main waterfront dining options. All face Port Phillip Bay — none face the ocean.' },
    },
    {
      '@type': 'Question',
      name: 'Are any Mornington Peninsula waterfront restaurants dog-friendly?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Rocks at Mornington (outdoor deck) and Portsea Hotel (beer garden) both confirm dog-friendly outdoor areas. The Baths Sorrento is not confirmed as dog-friendly — check before visiting.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need to book waterfront restaurants on the Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Baths: booking required most of the year. Portsea Hotel: walk-in only from 23 December to 31 January (peak season), bookings accepted otherwise. The Rocks: bookings advised on weekends.' },
    },
    {
      '@type': 'Question',
      name: 'Which is better — The Baths Sorrento or The Rocks Mornington?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Baths is the better special-occasion choice: more formal, wider views, seafood-focused set menu. The Rocks is the better casual choice: more accessible price point, harbour setting, dog-friendly deck, and a menu that changes weekly. Neither is hatted.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Waterfront Restaurants Mornington Peninsula · Peninsula Insider"
  description="The best waterfront restaurants on the Mornington Peninsula — The Baths at Sorrento, The Rocks at Mornington, and the Portsea Hotel. Genuine bay positions, honest comparison."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/waterfront/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Waterfront Restaurants on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Waterfront <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Waterfront <em>restaurants</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Three venues define the category — all face Port Phillip Bay, none are hatted. The choice is about what kind of afternoon you're building.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} venues</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-mornington-01.webp`} alt="The Rocks — Mornington harbour" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Mornington harbour <span class="ornament">—</span> the Melbourne skyline from the Peninsula's bay-facing deck</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">Port Phillip Bay — <em>not the ocean</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula's waterfront dining concentrates on Port Phillip Bay — the calmer, bay-facing side rather than the ocean. Three venues define the category. The Baths at Sorrento for special-occasion seafood with panoramic views. The Rocks at Mornington for casual waterfront dining at the marina. The Portsea Hotel for a pub setting with the most dramatic bay outlook of any pub on the Peninsula.</p>

          <p>None of these venues are hatted. All three have genuine waterfront positions. The choice between them is not about quality — it is about what kind of afternoon you are building.</p>

          <blockquote class="pullquote">Waterfront dining here means Port Phillip Bay, not the ocean. If you want ocean views, you are looking at a walk, not a table.</blockquote>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula waterfront">
        <figcaption class="letter__image-cap">Port Phillip Bay — <em>the calmer side, the seating side.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} venues with genuine <em>bay positions</em>.</h2>
        <p class="shortlist__intro-body">All face Port Phillip Bay. Different formats, different crowds, different reasons to go.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>What are the best waterfront restaurants on the Mornington Peninsula?</strong><br>The Baths (Sorrento), The Rocks (Mornington), and the Portsea Hotel are the three main waterfront dining options. All face Port Phillip Bay. The Baths is the most formal and has the widest views. The Rocks is more casual and dog-friendly. The Portsea Hotel is a pub with a spectacular clifftop beer garden.</p>

          <p><strong>Which waterfront restaurants are dog-friendly?</strong><br>The Rocks (outdoor deck) and the Portsea Hotel (beer garden) are both dog-friendly. The Baths is not confirmed as dog-friendly — check before visiting.</p>

          <p><strong>Do I need to book?</strong><br>The Baths: yes, booking required most of the year. The Rocks: booking advised on weekends. Portsea Hotel: walk-in only December 23 to January 31, bookings accepted the rest of the year.</p>

          <p><strong>Which is better for a special occasion?</strong><br>The Baths Sorrento — more formal, wider views, seafood-focused set menu ($75pp two courses). For a casual birthday or group lunch, The Rocks at Mornington is the more relaxed and accessible option.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Journal</span>
        </div>
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}journal/waterfront-restaurants-mornington-peninsula/`}><h3 class="venue__name">Full Waterfront Guide</h3></a>
        <p class="venue__sig">Side-by-side comparison of The Baths, The Rocks, and Portsea Hotel — what each actually is and when each makes sense.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-flinders-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/seafood/`}><h3 class="venue__name">Seafood</h3></a>
        <p class="venue__sig">The best places for seafood on the Peninsula — not just waterfront, but the places doing it well.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-portsea-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/dog-friendly/`}><h3 class="venue__name">Dog-Friendly Dining</h3></a>
        <p class="venue__sig">Where you can bring a dog on the Peninsula — outdoor dining options confirmed as of April 2026.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
