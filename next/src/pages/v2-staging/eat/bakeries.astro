---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const venues = (await getCollection('venues'))
  .filter(v => v.data.type === 'bakery')
  .sort((a, b) => (a.data.name ?? '').localeCompare(b.data.name ?? ''));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Best Bakeries Mornington Peninsula',
  description: 'The best bakeries on the Mornington Peninsula — six honest bakeries, where each one is, and what each does well.',
  url: 'https://peninsulainsider.com.au/eat/bakeries/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Best Bakeries', item: 'https://peninsulainsider.com.au/eat/bakeries/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the best bakery on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Flinders Sourdough is the strongest argument — loaves that hold their crust for days, a pastry counter that changes with the seasons, and good coffee in the back room. It is closed Monday and Tuesday and sells out by early afternoon on weekends — arrive by 9am. Johnny Ripe in Mornington is the best option if you need something on the main strip.' },
    },
    {
      '@type': 'Question',
      name: 'When do Peninsula bakeries open?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most Peninsula bakeries open between 7am and 8am. Flinders Sourdough is closed Monday and Tuesday. Weekend sell-outs are common — arriving before 10am is strongly advised.' },
    },
    {
      '@type': 'Question',
      name: 'Where can I find the best sourdough on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Flinders Sourdough (Flinders village) is the benchmark. The miche and seeded rye are the loaves to buy. Sourdough Kitchen in Balnarring and Red Hill Bakery are strong alternatives, each with a slightly different style and hours.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Best Bakeries Mornington Peninsula · Peninsula Insider"
  description="The best bakeries on the Mornington Peninsula — Flinders Sourdough, Johnny Ripe, Balnarring Bakehouse, and three others worth knowing. Where each is and what each does well."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/bakeries/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Best Bakeries on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Bakeries <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Best <em>bakeries</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Six honest bakeries, where each one is, and what each does well. The sell-out-by-noon problem is real — arrive before ten on weekends.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} bakeries</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-flinders-01.webp`} alt="Flinders village — bakery benchmark" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Flinders village <span class="ornament">—</span> the benchmark by which every other bakery is measured</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">Small, serious, and <em>sold out by noon</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula bakery scene is smaller than the cafe scene and better for it. There are six bakeries worth knowing about, scattered across the Peninsula from Mornington to Flinders. Each has a reason: a particular loaf, a particular morning, a particular detour that makes it worth the drive from wherever you are staying.</p>

          <p>The sell-out-by-noon problem is real across most of them. Arriving before ten on weekends is strongly advised. None of them have the inventory depth of a city bakery — they make what they make and stop when it is gone. That is largely the point.</p>

          <blockquote class="pullquote">Flinders Sourdough is the benchmark. Everything else maps from there by location and what you need the stop to do for the rest of the day.</blockquote>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula morning">
        <figcaption class="letter__image-cap">The Peninsula morning — <em>the hour before the bakeries run out.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">All {venues.length} Peninsula bakeries, by <em>location</em>.</h2>
        <p class="shortlist__intro-body">Sorted alphabetically. The Peninsula is small enough that location determines which one you visit — find yours by where you're staying.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>What is the best bakery on the Mornington Peninsula?</strong><br>Flinders Sourdough — closed Monday and Tuesday, sells out by early afternoon on weekends. Arrive before 9am for the best selection. Johnny Ripe in Mornington is the best option on the main strip. Sourdough Kitchen in Balnarring and Red Hill Bakery are strong hinterland alternatives.</p>

          <p><strong>When do Peninsula bakeries open?</strong><br>Most open between 7am and 8am. Weekend sell-outs are common. Arriving before 10am is strongly advised across all six.</p>

          <p><strong>Where is the best sourdough on the Peninsula?</strong><br>Flinders Sourdough is the benchmark. The miche and seeded rye are the loaves to buy. Sourdough Kitchen (Balnarring) and Red Hill Bakery are strong alternatives with slightly different styles.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/cafes/`}><h3 class="venue__name">Best Cafes</h3></a>
        <p class="venue__sig">The specialty coffee destination and the village cafes worth knowing — from Commonfolk to Flinders General Store.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/brunch/`}><h3 class="venue__name">Best Brunch</h3></a>
        <p class="venue__sig">The brunch spots worth planning a morning around — not just a coffee stop.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/`}><h3 class="venue__name">All Eat &amp; Drink</h3></a>
        <p class="venue__sig">The full Peninsula dining guide — restaurants, cellar doors, cafes, bakeries, and pubs.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
