---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const eatTypes = ['restaurant', 'cafe', 'winery'];
const venues = (await getCollection('venues'))
  .filter((v) => eatTypes.includes(v.data.type))
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

// Top 15 by editorial authority (hats descending)
const topVenues = venues.slice(0, 15);
const top3Names = topVenues.slice(0, 3).map((v) => v.data.name);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Restaurants Mornington Peninsula',
  description: 'The editorial ranked list of the best restaurants on the Mornington Peninsula, ordered from most authoritative to most approachable.',
  url: 'https://peninsulainsider.com.au/eat/best-restaurants/',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: topVenues.length,
  itemListElement: topVenues.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: v.data.name,
    url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What are the best restaurants on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `The strongest rooms right now are ${top3Names.join(', ')}. All three offer serious food in the vineyard-dining tradition the Peninsula does best — long lunches, estate-grown produce, and wine lists anchored by Mornington Pinot.`,
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to book restaurants on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most serious restaurants on the Peninsula require bookings, especially on weekends. Cellar door restaurants in Red Hill like Ten Minutes by Tractor and Montalto can book out weeks ahead in summer and autumn. Book as far ahead as you can for special occasions; casual venues like Allis Wine Bar and local bakeries typically operate walk-in.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the best area for restaurants on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Red Hill plateau — including Main Ridge and Red Hill South — has the highest concentration of serious dining. Mornington town has the strongest casual dining scene. Sorrento and Portsea dominate in summer for atmosphere. For wine-paired lunches, stick to the ridge.',
      },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const planningRestaurantSlugs = ['laura-pt-leo', 'ten-minutes-by-tractor', 'montalto', 'bistro-elba', 'pier-street-flinders'];
const planningPins = [
  {
    slug: 'laura-pt-leo',
    x: '56%',
    y: '36%',
    cluster: 'Red Hill / Merricks',
    cue: 'Destination lunch',
    note: 'Build the whole day around one serious table.',
  },
  {
    slug: 'ten-minutes-by-tractor',
    x: '51%',
    y: '31%',
    cluster: 'Main Ridge',
    cue: 'Long lunch anchor',
    note: 'Best if you want tastings and one high-authority meal.',
  },
  {
    slug: 'montalto',
    x: '59%',
    y: '43%',
    cluster: 'Red Hill South',
    cue: 'Art + vineyard day',
    note: 'Easy to pair with sculpture trail or one extra cellar door.',
  },
  {
    slug: 'bistro-elba',
    x: '21%',
    y: '56%',
    cluster: 'Sorrento side',
    cue: 'Village table',
    note: 'Works when you want the tip, the shops, and a shorter lunch loop.',
  },
  {
    slug: 'pier-street-flinders',
    x: '69%',
    y: '61%',
    cluster: 'Flinders coast',
    cue: 'Southern-end reset',
    note: 'Pair with ocean weather, a pier stop, and an easier second half.',
  },
];
const planningRestaurants = planningPins
  .map((pin, index) => {
    const venue = venues.find((item) => routeSlug(item) === pin.slug);
    if (!venue) return null;
    const data = venue.data;
    return {
      ...pin,
      venue,
      data,
      index: index + 1,
      mapLink: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${data.name} ${data.address ?? 'Mornington Peninsula'}`)}`,
    };
  })
  .filter(Boolean);
export const prerender = true;
---
<BaseLayout
  title="Best Restaurants Mornington Peninsula · Peninsula Insider"
  description="The editorial ranked list of the best restaurants on the Mornington Peninsula — from three-hat vineyard dining rooms to the bakeries and pubs worth the detour."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/best-restaurants"
>
<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Best Restaurants on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">The Ranked List <span class="ornament">—</span> {new Date().getFullYear()}</span>
        </div>
        <h1 class="hero__headline">The best <em>restaurants</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">The editorial ranked list — from three-hat vineyard dining rooms to the bakeries and pubs worth the detour. Every entry visited, every verdict our own.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{topVenues.length} rooms</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="The Red Hill plateau — the Peninsula's dining heart" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Hill plateau <span class="ornament">—</span> the Peninsula's dining heart</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="methodology-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Methodology</span>
        </div>
        <h2 class="letter__head" id="methodology-title">Ordered by <em>authority</em>, not algorithm.</h2>
        <div class="letter__prose">
          <p>The Mornington Peninsula runs on the Sunday long lunch. From the ridge-top dining rooms of Red Hill to the fisherman's-wharf-adjacent tables of Mornington, the dining options are deep, opinionated, and worth the drive. This list is built on editorial judgement — every entry has been visited and earned its sentence. If a restaurant appears here, it's because the meal was worth the drive and the editor was willing to say so.</p>

          <p>The Peninsula's strongest category is the vineyard restaurant — a dining room attached to or embedded within a working winery, where the produce is grown within a few kilometres and the wine list is anchored by the estate. Montalto, Ten Minutes by Tractor, and Polperro operate at the serious end of this format. Below them, a deep bench of rooms doing honest, seasonal work without the fanfare.</p>

          <p>The list is ordered by editorial authority: top-rated rooms first, then the places doing quietly strong work below them.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Peninsula Insider</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-main-ridge-01.webp`} alt="Main Ridge dining country">
        <figcaption class="letter__image-cap">The Main Ridge and Red Hill South ridge — <em>four two-hat rooms within a twenty-minute drive.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">The top {topVenues.length} dining rooms, by <em>authority</em>.</h2>
        <p class="shortlist__intro-body">Ordered by editorial weight. Rooms with a hat rating first, then the places doing the strongest quiet work.</p>
        <a href={`${base}eat/`} class="shortlist__intro-link">All {venues.length} venues
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>

      <p class="shortlist__keep" style="font-family:'Outfit',system-ui,sans-serif;font-size:0.82rem;letter-spacing:0.02em;color:rgba(23,20,19,0.55);margin:0 0 1.5rem;max-width:32rem;">Screenshot this list to keep it. Send it to whoever is booking Saturday lunch.</p>

      <ol class="shortlist__list" style="list-style:none;">
        {topVenues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

{planningRestaurants.length > 0 && (
  <section class="planning" aria-labelledby="planning-title">
    <div class="container">
      <div class="planning__frame">
        <div class="planning__intro">
          <span class="eyebrow eyebrow--ochre">Sandpit · Map this shortlist</span>
          <h2 class="planning__title" id="planning-title">See which tables actually <em>fit together</em>.</h2>
          <p class="planning__dek">This is the first planning-layer test. The point is not a giant map. It is showing, at a glance, which restaurants sit in one tight pocket of the Peninsula and which belong to a different day entirely.</p>
          <div class="planning__logic-list">
            <div class="planning__logic-item">
              <strong>Best cluster:</strong>
              <span>Red Hill, Merricks, and Main Ridge if the whole day revolves around one serious lunch.</span>
            </div>
            <div class="planning__logic-item">
              <strong>Separate plan:</strong>
              <span>Sorrento and Flinders sit better as their own coastal days. Don’t force them into a ridge itinerary.</span>
            </div>
            <div class="planning__logic-item">
              <strong>The useful answer:</strong>
              <span>If you can see the cluster instantly, the shortlist stops feeling theoretical and starts feeling bookable.</span>
            </div>
          </div>
          <div class="planning__cta-row">
            <a class="planning__button planning__button--primary" href="#planning-cards">Save this shortlist</a>
            <a class="planning__button" href={`${base}journal/the-long-lunch/`}>Read the long-lunch logic</a>
          </div>
        </div>

        <div class="planning__visual">
          <div class="planning-map planning-map--peninsula" aria-hidden="true">
            <div class="planning-map__canvas">
              <div class="planning-map__cluster planning-map__cluster--ridge">
                <span>Red Hill cluster</span>
                <small>One full lunch day</small>
              </div>
              <div class="planning-map__cluster planning-map__cluster--south">
                <span>Southern end</span>
                <small>Separate coastal outing</small>
              </div>
              {planningRestaurants.map((item) => (
                <a
                  class="planning-map__pin"
                  href={`#planning-stop-${item.slug}`}
                  style={`--x:${item.x};--y:${item.y};`}
                >
                  <span>{String(item.index).padStart(2, '0')}</span>
                </a>
              ))}
            </div>
          </div>
          <div class="planning__visual-note">What the user is really asking: <strong>is this one easy day or am I driving everywhere?</strong></div>
        </div>
      </div>

      <div class="planning-cards" id="planning-cards">
        {planningRestaurants.map((item) => (
          <article class="planning-card" id={`planning-stop-${item.slug}`}>
            <div class="planning-card__number">{String(item.index).padStart(2, '0')}</div>
            <div class="planning-card__body">
              <div class="planning-card__meta">
                <span>{item.cluster}</span>
                <span class="planning-card__sep"></span>
                <span>{item.cue}</span>
              </div>
              <a class="planning-card__title" href={`${base}eat/${routeSlug(item.venue)}/`}>{item.data.name}</a>
              <p class="planning-card__text">{item.note}</p>
            </div>
            <div class="planning-card__actions">
              <a class="planning-card__link" href={item.mapLink} target="_blank" rel="noreferrer">Open in Google Maps</a>
              <a class="planning-card__link" href={`${base}eat/${routeSlug(item.venue)}/`}>View venue</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Go deeper</span>
        <h2 class="dept__title" id="related-title">Browse by <em>category</em>.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-main-ridge-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/hatted-restaurants/`}><h3 class="venue__name">Hatted Restaurants</h3></a>
        <p class="venue__sig">Good Food Guide hat table with booking realities for every venue.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/long-lunch/`}><h3 class="venue__name">Long Lunch</h3></a>
        <p class="venue__sig">The rooms that carry a whole afternoon — two to three hours at the table.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/fine-dining/`}><h3 class="venue__name">Fine Dining</h3></a>
        <p class="venue__sig">Destination dining rooms worth planning a whole Peninsula day around.</p>
      </article>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>What are the best restaurants on the Mornington Peninsula?</strong><br>The strongest rooms right now are {top3Names.join(', ')}. All three offer serious food in the vineyard-dining tradition the Peninsula does best — long lunches, estate-grown produce, and wine lists anchored by Mornington Pinot. Below them, a deep bench of cellar door restaurants and neighbourhood rooms doing honest, seasonal work.</p>

          <p><strong>Do I need to book restaurants on the Mornington Peninsula?</strong><br>Most serious restaurants on the Peninsula require bookings, especially on weekends. Cellar door restaurants in Red Hill like Ten Minutes by Tractor and Montalto can book out weeks ahead in summer and autumn. Book as far ahead as you can for special occasions; casual venues like Allis Wine Bar and local bakeries typically operate walk-in.</p>

          <p><strong>What is the best area for restaurants on the Mornington Peninsula?</strong><br>The Red Hill plateau — including Main Ridge and Red Hill South — has the highest concentration of serious dining. Mornington town has the strongest casual dining scene. Sorrento and Portsea dominate in summer for atmosphere. For wine-paired lunches, stick to the ridge.</p>

          <p><strong>When is the best time to visit Mornington Peninsula for food?</strong><br>Autumn is the peak dining season. Vintage is running on the ridge, fires are lit in cellar door dining rooms, and the summer crowds have thinned enough that the best tables are actually bookable. Spring is a close second — new menus, release wines, and golden light that starts early and stays late.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
