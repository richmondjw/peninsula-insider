---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import {
  routeSlug,
  titleize,
  placeLabel,
  typeLabel,
  currentSeason,
  seasonBlurb,
} from '../../../lib/editorial';

const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
const venues = (await getCollection('venues'))
  .filter((venue) => eatTypes.includes(venue.data.type))
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

const season = currentSeason();
const blurb = seasonBlurb[season];

const editorPickSlugs = ['tedesca-osteria', 'barragunda-dining', 'laura-pt-leo'];
const editorPicks = editorPickSlugs
  .map((slug) => venues.find((venue) => routeSlug(venue) === slug))
  .filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));

const longLunchSlugs = ['montalto', 'polperro', 'pt-leo-estate', 'ten-minutes-by-tractor'];
const longLunches = longLunchSlugs
  .map((slug) => venues.find((venue) => routeSlug(venue) === slug))
  .filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));

const casualStops = venues.filter((venue) =>
  ['cafe', 'bakery'].includes(venue.data.type),
).slice(0, 6);

const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featuredGuideSlugs = [
  'where-to-eat-mornington-peninsula',
  'waterfront-restaurants-mornington-peninsula',
  'hatted-restaurants-mornington-peninsula-2025',
];
const featuredGuides = featuredGuideSlugs
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const hubs = [
  { href: 'eat/best-restaurants/', label: 'Best Restaurants', sub: 'Ranked by authority' },
  { href: 'eat/hatted-restaurants/', label: 'Hatted Restaurants', sub: '4 two-hat · 7 one-hat' },
  { href: 'eat/long-lunch/', label: 'Long Lunch', sub: 'Two-to-three hour tables' },
  { href: 'eat/cellar-door-lunch/', label: 'Cellar Door Lunch', sub: 'Estate wine, estate produce' },
  { href: 'eat/fine-dining/', label: 'Fine Dining', sub: 'Destination dining rooms' },
  { href: 'eat/waterfront/', label: 'Waterfront Dining', sub: 'Bay-facing positions' },
  { href: 'eat/seafood/', label: 'Seafood', sub: 'Waterfront fish and hatted seafood' },
  { href: 'eat/brunch/', label: 'Best Brunch', sub: 'Coffee rooms worth the drive' },
  { href: 'eat/cafes/', label: 'Best Cafes', sub: 'Village stops and specialty roasters' },
  { href: 'eat/bakeries/', label: 'Best Bakeries', sub: '6 bakeries across the Peninsula' },
  { href: 'eat/dog-friendly/', label: 'Dog-Friendly', sub: 'Confirmed outdoor options' },
  { href: 'eat/family-friendly/', label: 'Family-Friendly', sub: 'Relaxed formats for kids' },
  { href: 'eat/date-night/', label: 'Date Night', sub: 'Intimate rooms worth booking' },
  { href: 'eat/pubs/', label: 'Best Pubs', sub: 'Bay views and village locals' },
  { href: 'eat/paddock-to-plate/', label: 'Paddock to Plate', sub: 'Farm kitchens and produce trails' },
  { href: 'eat/markets/', label: 'Markets', sub: 'Red Hill · Mornington · Balnarring' },
  { href: 'eat/no-booking/', label: 'Walk-In Venues', sub: 'No reservation required' },
  { href: 'journal/where-to-eat-mornington-peninsula/', label: 'Full Eat Guide', sub: 'Comprehensive Peninsula dining' },
];

const pillarSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Where to Eat on the Mornington Peninsula',
  description: 'The best restaurants, long lunches, cellar door dining, cafes, bakeries, and waterfront dining on the Mornington Peninsula — an editorial guide, not a directory.',
  url: 'https://peninsulainsider.com.au/eat/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What are the best restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Good Food Guide awarded 15 hats across 11 Peninsula venues. The four two-hat restaurants — Barragunda Dining, Laura at Pt. Leo Estate, Tedesca Osteria, and Ten Minutes by Tractor — are the clearest destination dining choices. For long lunch without the hat commitment: Montalto, Polperro, and Paringa Estate are the strongest options.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need to book restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most serious restaurants on the Peninsula require bookings, especially on weekends. Hatted venues can book out weeks or months in advance. Walk-in options exist: Montalto Piazza (daily), Foxeys Hangout (no bookings taken), Rare Hare at Willow Creek (walk-in from 2pm weekends), and most cafes and bakeries.' },
    },
    {
      '@type': 'Question',
      name: 'What is the best area for food on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Red Hill plateau — including Main Ridge and Red Hill South — has the highest concentration of serious dining. Mornington town has the strongest casual eating scene. Sorrento and Portsea have the best waterfront and atmosphere-first dining. For wine-paired long lunches, stick to the ridge.' },
    },
    {
      '@type': 'Question',
      name: 'When is the best time to visit the Mornington Peninsula for food?',
      acceptedAnswer: { '@type': 'Answer', text: 'Autumn (March to May) is the peak dining season — vintage is running on the ridge, fires are lit in cellar door dining rooms, and the summer crowds have thinned enough that the best tables are actually bookable. Spring is a close second.' },
    },
    {
      '@type': 'Question',
      name: 'Are there dog-friendly restaurants on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes — outdoor seating options at cafes, village pub beer gardens, and a small number of winery casual dining areas permit dogs. Commonfolk Coffee (back courtyard), The Rocks Mornington (outdoor deck), Portsea Hotel (beer garden), and Green Olive at Red Hill (garden) are confirmed dog-friendly as of April 2026. Verify directly before visiting.' },
    },
    {
      '@type': 'Question',
      name: 'What is the signature food experience on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The long lunch — a two-to-three-hour table at a vineyard restaurant with estate wine and unhurried service. The Peninsula does this better than almost anywhere else in Victoria. Montalto, Laura, Polperro, and Ten Minutes by Tractor are the definitive versions of the format.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Where to Eat on the Mornington Peninsula · Peninsula Insider"
  description="The best restaurants, long lunches, cellar door dining, cafes, and bakeries on the Mornington Peninsula — editorial picks, not a directory. Updated April 2026."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(pillarSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Where to eat on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Eat &amp; Drink</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Long lunches <span class="ornament">—</span> hatted restaurants <span class="ornament">—</span> cellar door dining</span>
        </div>
        <h1 class="hero__headline">The dining rooms that justify the <em>drive</em>.</h1>
        <p class="hero__dek">The Mornington Peninsula has more serious cellar door restaurants, more hatted venues, and more long-lunch opportunities than almost any other regional destination in Victoria. This is the guide that tells you where to go and how to sequence the day.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#all" class="hero__byline-read">Browse all <span style="opacity:.5;margin-left:.3rem;">{venues.length} venues</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-merricks-01.webp`} alt="Red Hill plateau — lunch country" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Hill plateau <span class="ornament">—</span> the Peninsula's lunch country, within a twenty-minute drive of itself</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="contents" aria-labelledby="contents-title">
  <div class="container">
    <div class="contents__frame">
      <div class="contents__intro">
        <span class="eyebrow eyebrow--ochre">Start Here</span>
        <h2 class="contents__title" id="contents-title">Find what you're <em>looking for</em>.</h2>
        <p class="contents__dek">The Peninsula dining scene organised by format, occasion, and practicality.</p>
      </div>
      <ul class="contents__list" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1px;background:var(--line);">
        {hubs.map((hub, i) => (
          <li style="margin:0;">
            <a href={`${base}${hub.href}`} style="display:block;background:var(--paper);padding:1.25rem 1.5rem;text-decoration:none;color:inherit;">
              <span class="contents__num" style="display:block;font-family:var(--serif);font-size:0.85rem;opacity:.5;margin-bottom:0.25rem;">{String(i + 1).padStart(2, '0')}</span>
              <span style="display:block;font-size:1rem;font-weight:600;margin-bottom:0.2rem;">{hub.label}</span>
              <span style="display:block;font-size:0.75rem;opacity:.65;letter-spacing:0.02em;">{hub.sub}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">How the Peninsula eats</span>
        </div>
        <h2 class="letter__head" id="intro-title">A region that runs on the <em>long lunch</em>.</h2>
        <div class="letter__prose">
          <p>The Mornington Peninsula's food scene is built around one format: the long lunch. A two-to-three-hour table in a vineyard restaurant, estate wine poured from the vines outside the window, produce grown or sourced within five kilometres, and a kitchen serious enough to have earned it. The Peninsula does this better than almost anywhere else in Victoria.</p>

          <p>What makes the region distinctive is the density. Within the Red Hill plateau — a twenty-minute drive at most — there are four two-hat restaurants, seven one-hat venues, and a dozen more cellar door dining rooms doing honest, seasonal work without the formal recognition. The concentration of serious food in a small geographic area is closer to what you'd find in a Burgundy village or a Barossa sub-region than in most Australian wine country.</p>

          <blockquote class="pullquote">Below the hatted tier, the Peninsula's food scene organises around two more useful categories: the cellar door with a kitchen, and the village cafe or general store.</blockquote>

          <p>The Peninsula's strongest dining windows are autumn and spring. In autumn, vintage is running on the ridge, the summer crowds have thinned, and the best tables are actually bookable. In spring, new menus, release wines, and the right light. Winter fine dining with fires lit in cellar door rooms is underrated. Summer is beautiful and chaotic and the bookings problem is hardest to solve.</p>

          <p>The practical advice: pick one destination per day, not three. Book as far ahead as the venue requires. Arrive at the cellar door before the table, not after. And do not try to fit another estate in after a three-hour lunch. The day will not improve.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <div style="background:var(--paper-warm);padding:2rem;border-left:3px solid var(--ochre);">
          <span class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;display:block;">By the numbers</span>
          <dl style="display:grid;gap:1.25rem;margin:0;">
            <div><dt style="font-size:0.7rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;opacity:.65;margin-bottom:0.25rem;">Two-hat restaurants</dt><dd style="font-family:var(--serif);font-size:2.5rem;font-weight:500;line-height:1;margin:0;letter-spacing:-0.02em;">4</dd></div>
            <div><dt style="font-size:0.7rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;opacity:.65;margin-bottom:0.25rem;">Total GFG hats</dt><dd style="font-family:var(--serif);font-size:2.5rem;font-weight:500;line-height:1;margin:0;letter-spacing:-0.02em;">15</dd></div>
            <div><dt style="font-size:0.7rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;opacity:.65;margin-bottom:0.25rem;">Venues mapped</dt><dd style="font-family:var(--serif);font-size:2.5rem;font-weight:500;line-height:1;margin:0;letter-spacing:-0.02em;">{venues.length}</dd></div>
            <div><dt style="font-size:0.7rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;opacity:.65;margin-bottom:0.25rem;">Best dining season</dt><dd style="font-size:0.95rem;font-weight:600;margin:0.25rem 0 0 0;">Autumn (Mar–May)</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

{editorPicks.length > 0 && (
  <section class="shortlist" id="picks" aria-labelledby="picks-title">
    <div class="container">
      <div class="shortlist__frame">
        <div class="shortlist__intro">
          <span class="eyebrow eyebrow--ochre">Editor's picks right now</span>
          <h2 id="picks-title">Three rooms doing the <em>heaviest lifting</em>.</h2>
          <p class="shortlist__intro-body">If lunch is the event and you only have one booking, start with one of these three.</p>
        </div>

        <ol class="shortlist__list" style="list-style:none;">
          {editorPicks.map((v, i) => {
            const data = v.data;
            const hats = data.authority?.hats ?? 0;
            const num = String(i + 1).padStart(2, '0');
            const place = placeLabel(data.place);
            const type = typeLabel[data.type] ?? data.type;
            const allTags = [
              ...(data.tags?.mood ?? []),
              ...(data.tags?.audience ?? []),
            ].slice(0, 3);
            return (
              <li class="sl-item">
                <span class="sl-item__num">{num}</span>
                <div class="sl-item__body">
                  <div class="sl-item__meta">
                    <span>{place}</span>
                    <span class="sl-item__meta-sep"></span>
                    <span>{type}</span>
                    <span class="sl-item__meta-sep"></span>
                    <span>{data.priceBand}</span>
                  </div>
                  <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                  <p class="sl-item__why">{data.signature}</p>
                  <div class="sl-item__tags">
                    {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                    {allTags.map((tag: string) => (
                      <span class="sl-item__tag">{titleize(tag)}</span>
                    ))}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>
)}

{longLunches.length > 0 && (
  <section class="dept" id="long-lunch" aria-labelledby="long-lunch-title">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Long lunch shortlist</span>
          <h2 class="dept__title" id="long-lunch-title">Tables that carry the whole <em>afternoon</em>.</h2>
        </div>
        <a href={`${base}eat/long-lunch/`} class="well__head-link">Full long lunch list →</a>
      </div>
      <div class="dept__grid">
        {longLunches.map((v) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const place = placeLabel(data.place);
          return (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}images/sourced/place-${data.place || 'red-hill'}-01.webp);background-size:cover;background-position:center;`}>
                {hats > 0 && <span class="venue__image-marker">{hats} hat{hats > 1 ? 's' : ''}</span>}
              </div>
              <div class="venue__meta"><span>{place}</span></div>
              <a href={`${base}eat/${routeSlug(v)}/`}><h3 class="venue__name">{data.name}</h3></a>
              <p class="venue__sig">{data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{featuredGuides.length > 0 && (
  <section class="well" id="guides" aria-labelledby="guides-title">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Editorial guides</span>
          <h2 class="well__head-title" id="guides-title">Read before you <em>book</em>.</h2>
          <p class="well__head-sub">Service pieces that give you the context to make a better dining decision on the Peninsula.</p>
        </div>
        <a href={`${base}journal/`} class="well__head-link">All in the Journal →</a>
      </div>
      <div class="well__grid">
        {featuredGuides.map((article, i) => {
          const data = article.data;
          const modClass = i === 0 ? 'feat feat--lead' : 'feat feat--std';
          return (
            <article class={modClass}>
              <div class="feat__image" style={`background-image:url(${base}images/sourced/${data.heroImage || 'home-cover.webp'});background-size:cover;background-position:center;`}></div>
              <div class="feat__body">
                <div class="feat__eyebrow">Journal</div>
                <a href={`${base}journal/${routeSlug(article)}/`}>
                  <h3 class="feat__title">{data.title}</h3>
                </a>
                <p class="feat__excerpt">{data.description || data.summary}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

{casualStops.length > 0 && (
  <section class="dept" aria-labelledby="casual-title">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Before and after the booking</span>
          <h2 class="dept__title" id="casual-title">Coffee rooms and bakeries that keep the day from feeling <em>scheduled</em>.</h2>
        </div>
        <a href={`${base}eat/cafes/`} class="well__head-link">All cafes →</a>
      </div>
      <div class="dept__grid">
        {casualStops.map((v) => {
          const data = v.data;
          const place = placeLabel(data.place);
          return (
            <article class="venue">
              <div class="venue__image" style={`background-image:url(${base}images/sourced/place-${data.place || 'mornington'}-01.webp);background-size:cover;background-position:center;`}>
                <span class="venue__image-marker">{typeLabel[data.type] ?? data.type}</span>
              </div>
              <div class="venue__meta"><span>{place}</span></div>
              <a href={`${base}eat/${routeSlug(v)}/`}><h3 class="venue__name">{data.name}</h3></a>
              <p class="venue__sig">{data.signature}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<section class="shortlist" id="all" aria-labelledby="all-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">Complete dining directory</span>
        <h2 id="all-title">All {venues.length} eat-and-drink venues, by <em>authority</em>.</h2>
        <p class="shortlist__intro-body">Ordered by editorial weight — hatted rooms first, then the places doing quiet, serious work below them.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.slice(0, 24).map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>

      <p style="margin-top:2rem;text-align:center;">
        <a href={`${base}eat/best-restaurants/`} class="well__head-link">Ranked top 15 →</a>
      </p>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>What are the best restaurants on the Mornington Peninsula?</strong><br>The Good Food Guide awarded 15 hats across 11 Peninsula venues. The four two-hat restaurants — Barragunda Dining, Laura at Pt. Leo Estate, Tedesca Osteria, and Ten Minutes by Tractor — are the definitive destination dining choices. For long lunch without the commitment: Montalto, Polperro, and Paringa Estate are the strongest options below the hatted tier.</p>

          <p><strong>Do I need to book?</strong><br>Most serious restaurants require bookings, especially on weekends. Hatted venues book out weeks or months ahead. Walk-in options: Montalto Piazza (daily), Foxeys Hangout (no bookings taken), Rare Hare at Willow Creek (walk-in from 2pm weekends), and most cafes and bakeries.</p>

          <p><strong>What is the best area for food?</strong><br>The Red Hill plateau has the highest concentration of serious dining. Mornington has the strongest casual eating scene. For wine-paired long lunches, stay on the ridge — Main Ridge and Red Hill South are where the best rooms are.</p>

          <p><strong>When is the best time to visit for food?</strong><br>Autumn (March to May) — vintage is running, summer crowds have thinned, best tables are bookable. Spring is a close second. Winter cellar door lunches with fires are underrated.</p>

          <p><strong>Are there dog-friendly dining options?</strong><br>Yes — outdoor seating at cafes, village pub beer gardens, and a small number of winery casual areas. Commonfolk Coffee (back courtyard), Portsea Hotel (beer garden), The Rocks Mornington (outdoor deck), and Green Olive at Red Hill (garden) are confirmed as of April 2026. Verify directly before visiting.</p>

          <p><strong>What is the Peninsula's signature food experience?</strong><br>The long lunch. A two-to-three-hour table at a vineyard restaurant with estate wine and unhurried service. The Peninsula does this better than almost anywhere else in Victoria. Montalto, Laura, Polperro, and Ten Minutes by Tractor are the definitive versions of the format.</p>
        </div>
      </div>
    </div>
  </div>
