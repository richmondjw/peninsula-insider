---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const slugs = ['red-gum-bbq','merricks-general-wine-store','green-olive-red-hill','montalto','johnny-ripe','balnarring-pub','rye-hotel','sorrento-gelato','commonfolk-coffee','flinders-general-store'];
const venues = slugs.map(s=>allVenues.find(v=>routeSlug(v)===s)).filter((v):v is NonNullable<typeof v>=>Boolean(v));

const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Family-Friendly Restaurants Mornington Peninsula',description:'Family-friendly dining on the Mornington Peninsula — outdoor seating, relaxed formats, and the venues where bringing kids does not require an apology.',url:'https://peninsulainsider.com.au/eat/family-friendly/',breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{position:1,name:'Home',item:'https://peninsulainsider.com.au/'},{position:2,name:'Eat & Drink',item:'https://peninsulainsider.com.au/eat/'},{position:3,name:'Family-Friendly',item:'https://peninsulainsider.com.au/eat/family-friendly/'}].map(e=>({'@type':'ListItem',...e}))},mainEntity:{'@type':'ItemList',itemListOrder:'https://schema.org/ItemListOrderDescending',numberOfItems:venues.length,itemListElement:venues.map((v,i)=>({'@type':'ListItem',position:i+1,name:v.data.name,url:`https://peninsulainsider.com.au/eat/${routeSlug(v)}/`}))}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:'Where are the best family-friendly restaurants on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'Red Gum BBQ (Red Hill) is consistently the strongest family option — BBQ format, outdoor tables, relaxed service, and food kids actually want to eat. Montalto Piazza (Red Hill South) is the best family-friendly winery option: walk-in daily, outdoor setting, sculpture trail to explore before or after eating. Green Olive at Red Hill (garden, outdoor, dog-friendly) works well for families who want a winery stop without the pressure of a hatted room.'}},{'@type':'Question',name:'Which restaurants on the Mornington Peninsula are good for young children?',acceptedAnswer:{'@type': 'Answer',text:'Red Gum BBQ (Red Hill) for BBQ in an outdoor setting — kids do not need to sit still. Montalto Piazza for walk-in winery dining with a sculpture trail. Flinders General Store for a relaxed village stop with outdoor tables. Most hatted and fine dining rooms on the Peninsula are not suited to young children.'}},{'@type':'Question',name:'Are there family-friendly winery restaurants on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'Montalto Piazza (walk-in, daily, outdoor, sculpture trail) is the clearest family-friendly winery option. Green Olive at Red Hill (garden, relaxed format, dog-friendly) is a good second. Merricks General Wine Store has outdoor seating and a casual format.'}}]};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Family-Friendly Restaurants Mornington Peninsula · Peninsula Insider"
  description="Family-friendly dining on the Mornington Peninsula — Red Gum BBQ, Montalto Piazza, and the venues where bringing kids does not require an apology."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/family-friendly/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Family-Friendly Dining on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Family-Friendly <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Family-friendly <em>dining</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Outdoor seating, relaxed formats, and the venues where bringing kids does not require an apology.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} venues</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Gum BBQ — family-friendly outdoor dining" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Gum BBQ <span class="ornament">—</span> the clearest family call on the Peninsula</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">Venues that work with kids, <em>not merely tolerate them</em>.</h2>
        <div class="letter__prose">
          <p>Family-friendly dining on the Peninsula means outdoor seating, formats that do not require children to sit completely still for two hours, and venues where the staff have seen a high chair before. The list is shorter than the general dining list, but it is honest: these are the places that work with kids rather than merely tolerating them.</p>

          <p>Red Gum BBQ in Red Hill is the clearest call — BBQ format, outdoor tables, and food that children actually want to eat. Montalto Piazza is the best family-friendly winery option: walk-in daily, sculpture trail on the property, outdoor seating, and a kitchen that does not require advance planning. Village cafes and pub beer gardens fill in the practical gaps.</p>

          <blockquote class="pullquote">The outdoor, relaxed-format venues first. Hatted rooms are generally not on this list.</blockquote>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula family dining">
        <figcaption class="letter__image-cap">The Peninsula at lunch — <em>where children are welcome.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} venues that <em>work with kids</em>.</h2>
        <p class="shortlist__intro-body">The outdoor, relaxed-format venues first. Hatted rooms are generally not on this list.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>Best family-friendly restaurants on the Peninsula?</strong><br>Red Gum BBQ (Red Hill): BBQ, outdoor tables, food kids want. Montalto Piazza: walk-in daily, sculpture trail, outdoor. Green Olive at Red Hill: garden, relaxed, dog-friendly.</p>

          <p><strong>Best for young children?</strong><br>Red Gum BBQ and Montalto Piazza. Flinders General Store for a casual village stop. Most hatted rooms are not suited to young children.</p>

          <p><strong>Family-friendly winery restaurants?</strong><br>Montalto Piazza (walk-in, sculpture trail) is the clearest. Green Olive at Red Hill (garden, relaxed). Merricks General Wine Store (outdoor seating, casual).</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More Peninsula <em>family</em> content.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/brunch/`}><h3 class="venue__name">Best Brunch</h3></a>
        <p class="venue__sig">Cafes and morning-friendly venues across the Peninsula.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-portsea-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/dog-friendly/`}><h3 class="venue__name">Dog-Friendly Dining</h3></a>
        <p class="venue__sig">Outdoor dining with dogs confirmed as of April 2026.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/`}><h3 class="venue__name">All Eat &amp; Drink</h3></a>
        <p class="venue__sig">The full Peninsula dining guide.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
