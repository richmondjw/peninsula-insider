---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const brunchSlugs = [
  'commonfolk-coffee', 'many-little', 'martha-s-table', 'stringers-mornington',
  'merricks-general-wine-store', 'somers-general',
  'store-ten', 'flinders-general-store'
];

const venues = brunchSlugs
  .map(s => allVenues.find(v => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Best Brunch Mornington Peninsula',
  description: 'The best brunch spots on the Mornington Peninsula — specialty coffee, village cafes, and the rooms worth planning a morning around.',
  url: 'https://peninsulainsider.com.au/eat/brunch/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Best Brunch', item: 'https://peninsulainsider.com.au/eat/brunch/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is the best brunch on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Commonfolk Coffee (Mornington) is the Peninsula\'s best specialty coffee and runs a serious brunch menu daily. For a more elevated brunch experience, Many Little Bar & Dining (Red Hill South) offers hatted-restaurant quality in a cafe-daytime setting. Merricks General Wine Store is the most beautiful brunch setting on the Peninsula.' },
    },
    {
      '@type': 'Question',
      name: 'Which brunch spots on the Mornington Peninsula are dog-friendly?',
      acceptedAnswer: { '@type': 'Answer', text: 'Commonfolk Coffee (back courtyard), Somers General Store, and Flinders General Store all have confirmed dog-friendly outdoor seating. Check directly with venues as policies can change seasonally.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need to book brunch on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Many Little Bar & Dining takes bookings and can fill quickly on weekends. Commonfolk Coffee operates walk-in. Most village cafes on this list are walk-in. Arriving before 9:30am on weekends avoids the main queues at popular spots.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Best Brunch Mornington Peninsula · Peninsula Insider"
  description="The best brunch on the Mornington Peninsula — Commonfolk Coffee in Mornington, Many Little in Red Hill, and the village cafes worth planning a morning around."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/brunch/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Best Brunch on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Brunch <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Best <em>brunch</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Commonfolk Coffee in Mornington, Many Little in Red Hill, and the village cafes worth planning a morning around.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} spots</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-mornington-01.webp`} alt="Mornington — Peninsula brunch capital" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Mornington <span class="ornament">—</span> the Peninsula's specialty-coffee anchor</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">The first half of a <em>Peninsula day</em>.</h2>
        <div class="letter__prose">
          <p>Brunch on the Mornington Peninsula means either a specialty coffee destination in Mornington or a village cafe you would drive forty minutes for if you were not already nearby. The Peninsula's brunch scene is not a destination category in itself — it is the first half of a Peninsula day, the thing you do before the cellar door or the beach walk.</p>

          <p>Commonfolk Coffee (Mornington) is the benchmark. Everything else organises around it by geography. Somers General for the southern Mornington Shire bayside corridor. Merricks General for the ridge. Flinders General for the ocean coast. Many Little if you want something that reads more as a proper restaurant with a daytime offer.</p>

          <blockquote class="pullquote">The weekend queues are real at the popular spots. Arriving before 9:30am solves most of them.</blockquote>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula brunch morning">
        <figcaption class="letter__image-cap">A Peninsula morning — <em>before ten, before the queues.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} brunch spots worth <em>knowing about</em>.</h2>
        <p class="shortlist__intro-body">The specialty coffee benchmark first, then the village cafes organised by where they are on the Peninsula.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>Where is the best brunch on the Mornington Peninsula?</strong><br>Commonfolk Coffee (Mornington, 16 Progress Street) is the specialty coffee benchmark. For a more elevated daytime offer, Many Little Bar &amp; Dining (Red Hill South) is the hatted-restaurant alternative. Merricks General Wine Store is the most beautiful setting on the Peninsula for a morning meal.</p>

          <p><strong>Which brunch spots are dog-friendly?</strong><br>Commonfolk Coffee (back courtyard), Somers General Store, and Flinders General Store all have confirmed dog-friendly outdoor seating. Check directly with venues as policies can change.</p>

          <p><strong>Do I need to book?</strong><br>Many Little takes bookings and can fill on weekends. Most village cafes on this list are walk-in. Arriving before 9:30am avoids the main weekend queues.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/cafes/`}><h3 class="venue__name">Best Cafes</h3></a>
        <p class="venue__sig">The specialty coffee destination and the village cafes — from Commonfolk to Flinders General.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-flinders-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/bakeries/`}><h3 class="venue__name">Best Bakeries</h3></a>
        <p class="venue__sig">Six Peninsula bakeries — where each is and what makes each one worth knowing.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/long-lunch/`}><h3 class="venue__name">Long Lunch</h3></a>
        <p class="venue__sig">If brunch is only the start — the rooms worth building an afternoon around afterwards.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
