---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const venues = (await getCollection('venues')).filter(v=>v.data.type==='pub').sort((a,b)=>(a.data.name??'').localeCompare(b.data.name??''));

const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Best Pubs Mornington Peninsula',description:'The best pubs on the Mornington Peninsula — bay-view beer gardens, village locals, and the pub bistros that do an honest meal.',url:'https://peninsulainsider.com.au/eat/pubs/',breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{position:1,name:'Home',item:'https://peninsulainsider.com.au/'},{position:2,name:'Eat & Drink',item:'https://peninsulainsider.com.au/eat/'},{position:3,name:'Best Pubs',item:'https://peninsulainsider.com.au/eat/pubs/'}].map(e=>({'@type':'ListItem',...e}))},mainEntity:{'@type':'ItemList',itemListOrder:'https://schema.org/ItemListOrderDescending',numberOfItems:venues.length,itemListElement:venues.map((v,i)=>({'@type':'ListItem',position:i+1,name:v.data.name,url:`https://peninsulainsider.com.au/eat/${routeSlug(v)}/`}))}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:'What is the best pub on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'Portsea Hotel has the most dramatic setting — sweeping Port Phillip Bay views from a clifftop position above Portsea beach, dog-friendly beer garden, and a pub bistro better than the building suggests. Balnarring Pub is the most genuinely local and relaxed village pub on the Peninsula.'}},{'@type':'Question',name:'Which pubs on the Mornington Peninsula are dog-friendly?',acceptedAnswer:{'@type':'Answer',text:'Portsea Hotel (beer garden), Balnarring Pub (beer garden), and Rye Hotel (outdoor area) are confirmed dog-friendly. Check directly with venues before visiting as policies can change.'}},{'@type':'Question',name:'Where should I go for a pub meal on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'Portsea Hotel (bay views, Ishka Restaurant for more formal dining, pub format). Balnarring Pub (local favourite, village setting). The Bay Hotel Mornington (waterfront adjacent, Mornington town). Check current kitchen hours before visiting — pub kitchens on the Peninsula can have limited midweek service.'}}]};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Best Pubs Mornington Peninsula · Peninsula Insider"
  description="The best pubs on the Mornington Peninsula — Portsea Hotel's bay views, Balnarring Pub's village setting, and the honest pub bistros worth stopping at."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/pubs/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Best Pubs on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Pubs <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Best <em>pubs</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Bay-view beer gardens, village locals, and the pub bistros that do an honest meal. The setting is the reason to drive — not the food.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} pubs</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-portsea-01.webp`} alt="Portsea Hotel — clifftop above the bay" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Portsea Hotel <span class="ornament">—</span> the clifftop beer garden above Port Phillip Bay</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">The <em>setting</em> is the reason to drive.</h2>
        <div class="letter__prose">
          <p>The Peninsula's pub scene is spread across its towns and coastal villages rather than concentrated in one area. Portsea Hotel leads for setting — the clifftop position above Portsea beach, bay views, and a dog-friendly beer garden make it the strongest pub experience on the Peninsula. Balnarring Pub is the most local and genuinely village-feeling. The Bay Hotel Mornington works as a practical stop for anyone based in or passing through town.</p>

          <p>Peninsula pub kitchens range from honest bistro meals to better-than-expected seasonal menus. The general rule: pub food here is not the reason to drive; the setting is. Pair any pub stop with a coastal walk or afternoon activity nearby to get the most from it.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula pub afternoon">
        <figcaption class="letter__image-cap">The Peninsula pub afternoon — <em>pair the pub with a walk nearby.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">All {venues.length} Peninsula <em>pubs</em>.</h2>
        <p class="shortlist__intro-body">Sorted alphabetically. Location usually determines which one you visit.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>Best pub on the Mornington Peninsula?</strong><br>Portsea Hotel: best setting (clifftop, bay views, dog-friendly). Balnarring Pub: most genuine village local.</p>

          <p><strong>Which pubs are dog-friendly?</strong><br>Portsea Hotel (beer garden), Balnarring Pub (beer garden), Rye Hotel (outdoor area). Verify directly before visiting.</p>

          <p><strong>Best for a pub meal?</strong><br>Portsea Hotel (bay views, pub bistro, Ishka Restaurant for more formal). Balnarring Pub (local favourite). The Bay Hotel Mornington (waterfront adjacent). Check kitchen hours before visiting — midweek service can be limited.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-portsea-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/dog-friendly/`}><h3 class="venue__name">Dog-Friendly Dining</h3></a>
        <p class="venue__sig">Confirmed dog-friendly outdoor dining — cafes, pubs, and winery casual areas.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/waterfront/`}><h3 class="venue__name">Waterfront Dining</h3></a>
        <p class="venue__sig">Bay-facing restaurants at Sorrento, Mornington, and Portsea.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/`}><h3 class="venue__name">All Eat &amp; Drink</h3></a>
        <p class="venue__sig">The full Peninsula dining guide — restaurants, cellar doors, cafes, bakeries, and pubs.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
