---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import V2VenueDetail from '../../../components/v2/V2VenueDetail.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../../lib/editorial';

const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
const allVenues = await getCollection('venues');
const venue = allVenues.find((v) => routeSlug(v) === 'port-phillip-estate');

const slug = venue ? routeSlug(venue) : '';
const related = venue
  ? allVenues
      .filter((entry) => routeSlug(entry) !== slug)
      .filter((entry) => eatTypes.includes(entry.data.type))
      .filter((entry) => String(entry.data.place?.id ?? entry.data.place) === String(venue.data.place?.id ?? venue.data.place))
      .slice(0, 3)
  : [];

const articles = venue
  ? (await getCollection('articles', ({ data }) => data.status === 'published'))
      .filter((article) =>
        article.data.relatedVenues.some((entry: any) => String(entry.id ?? entry) === slug)
      )
      .slice(0, 3)
  : [];
---
<BaseLayout
  title={venue ? `${venue.data.name} — Peninsula Insider` : 'Port Phillip Estate — Peninsula Insider'}
  description={venue?.data.signature ?? 'Port Phillip Estate restaurant on the Mornington Peninsula.'}
  section="eat"
  ogImage={venue?.data.heroImage?.src}
>
  {venue && <V2VenueDetail venue={venue} section="eat" related={related} articles={articles} />}
  <NewsletterBlock />
</BaseLayout>
