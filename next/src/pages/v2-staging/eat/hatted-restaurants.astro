---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const hattedSlugs = [
  'tedesca-osteria', 'laura-pt-leo', 'doot-doot-doot', 'pt-leo-estate',
  'ten-minutes-by-tractor', 'willow-creek-vineyard', 'montalto', 'paringa-estate',
  'polperro', 'port-phillip-estate', 'yabby-lake', 'epicurean-red-hill',
  'barragunda-dining', 'rare-hare', 'many-little'
];

const venues = hattedSlugs
  .map(s => allVenues.find(v => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v))
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Hatted Restaurants on the Mornington Peninsula',
  description: 'The complete Good Food Guide hat list for the Mornington Peninsula — four two-hat venues, seven one-hat tables, with booking realities and what each restaurant actually is.',
  url: 'https://peninsulainsider.com.au/eat/hatted-restaurants/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Hatted Restaurants', item: 'https://peninsulainsider.com.au/eat/hatted-restaurants/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How many hatted restaurants are on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Good Food Guide awarded 15 hats across 11 Peninsula venues — four two-hat restaurants and seven one-hat restaurants. The Australian Good Food Guide (AGFG) recognises additional venues including Lancemore Lindenderry and Paringa Estate.' },
    },
    {
      '@type': 'Question',
      name: 'What is the best restaurant on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'By formal recognition, Barragunda Dining (Cape Schanck), Laura (Merricks), Tedesca Osteria (Red Hill), and Ten Minutes by Tractor (Main Ridge) all hold two hats in the Good Food Guide. Tedesca Osteria won Regional Restaurant of the Year. Barragunda is the most recent addition, opening in February and winning two hats in its debut year.' },
    },
    {
      '@type': 'Question',
      name: 'Which hatted restaurants on the Mornington Peninsula accept walk-ins?',
      acceptedAnswer: { '@type': 'Answer', text: 'Rare Hare (Jackalope Hotel, Merricks North) is walk-in only — no reservations taken. Many Little Bar & Dining (Red Hill South) takes walk-ins for some sessions. Montalto\'s Piazza is walk-in daily as a more casual alternative to the main hatted restaurant.' },
    },
    {
      '@type': 'Question',
      name: 'How far in advance do you need to book at Peninsula hatted restaurants?',
      acceptedAnswer: { '@type': 'Answer', text: 'Laura at Pt. Leo Estate: book four months ahead. Barragunda: book immediately — very hard to get. Tedesca Osteria: books out weeks ahead for Friday–Monday lunch. Ten Minutes by Tractor: four to eight weeks for weekend lunch. Doot Doot Doot: two to four weeks ahead.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Hatted Restaurants on the Mornington Peninsula · Peninsula Insider"
  description="The Good Food Guide awarded 15 hats across 11 Mornington Peninsula venues. Four two-hat tables, seven one-hat rooms, and honest booking realities for each."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/hatted-restaurants/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Hatted Restaurants on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Hatted Restaurants <span class="ornament">—</span> Good Food Guide 2025</span>
        </div>
        <h1 class="hero__headline">Hatted <em>restaurants</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">15 hats across 11 venues. Four two-hat tables, seven one-hat rooms, and honest booking realities for each.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} rooms</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Peninsula hatted dining" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>The Peninsula <span class="ornament">—</span> fifteen hats across eleven venues, by Good Food Guide count</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">The long lunch is the <em>defining format</em>.</h2>
        <div class="letter__prose">
          <p>The Good Food Guide awarded 15 hats across 11 Peninsula venues. Four venues carry two hats — the highest recognition in the region. What distinguishes the Peninsula's hatted scene is its context: these are not city strip restaurants. You eat in a converted 1940s farmhouse on a biodynamic property, a 40-seat room inside a sculpture park estate, or a cave-like dining room beneath a boutique winery hotel. The long lunch is the defining format.</p>

          <p>The four two-hat venues are Barragunda Dining (Cape Schanck), Laura at Pt. Leo Estate (Merricks), Tedesca Osteria (Red Hill), and Ten Minutes by Tractor (Main Ridge). Each is different in character. Barragunda is the Peninsula's newest and hardest booking. Tedesca is the most farm-forward. Laura is the most internationally credentialled. Ten Minutes by Tractor is the most established.</p>

          <blockquote class="pullquote">Below the two-hat tier, seven one-hat venues cover a wider range of formats — from Doot Doot Doot's formal dinner-only room to Rare Hare's walk-in wood-fired outdoor sessions. The list is ordered by hat count, then by editorial weight.</blockquote>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026 · Source: Good Food Guide 2025</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula fine dining">
        <figcaption class="letter__image-cap">The Peninsula long lunch — <em>the defining format for the Peninsula's hatted rooms.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} hatted and <em>hatted-adjacent</em> rooms.</h2>
        <p class="shortlist__intro-body">Two-hat venues first, then one-hat, then the AGFG-recognised rooms working below the GFG list.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>How many hatted restaurants are on the Mornington Peninsula?</strong><br>The Good Food Guide awarded 15 hats across 11 Peninsula venues — four two-hat restaurants and seven one-hat restaurants. The Australian Good Food Guide recognises additional venues including Lancemore Lindenderry Dining Room (two AGFG hats) and Paringa Estate (one AGFG hat).</p>

          <p><strong>Which hatted restaurants accept walk-ins?</strong><br>Rare Hare (Merricks North) is walk-in only — no reservations taken. Many Little Bar &amp; Dining (Red Hill South) takes walk-ins for some sessions. Montalto's Piazza is walk-in daily as a casual alternative to the main restaurant. All other hatted venues require bookings.</p>

          <p><strong>How far ahead do I need to book?</strong><br>Laura: four months ahead. Barragunda: book immediately when dates open — extremely hard to get. Tedesca: weeks ahead for Friday to Monday lunch. Ten Minutes by Tractor: four to eight weeks for weekend lunch. Doot Doot Doot: two to four weeks ahead.</p>

          <p><strong>What are the best hatted venues for a special occasion?</strong><br>Laura at Pt. Leo Estate is the strongest special-occasion choice — the sculpture park setting, Relais &amp; Châteaux membership, and consistent two-hat recognition make it the clearest destination-restaurant argument on the Peninsula. Barragunda Dining is the newest and most talked-about; Tedesca Osteria is the most personal and farm-driven.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/fine-dining/`}><h3 class="venue__name">Fine Dining</h3></a>
        <p class="venue__sig">The destination dining rooms worth planning a whole Peninsula day around.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/long-lunch/`}><h3 class="venue__name">Long Lunch</h3></a>
        <p class="venue__sig">Two to three hours at the table, estate wine, and a reason not to drive home at noon.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Journal</span>
        </div>
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}journal/hatted-restaurants-mornington-peninsula-2025/`}><h3 class="venue__name">Full Hat Guide</h3></a>
        <p class="venue__sig">The complete Good Food Guide hat table with booking realities and what each restaurant actually is.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
