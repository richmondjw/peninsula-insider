---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const dogFriendlySlugs = [
  'commonfolk-coffee', 'somers-general', 'merricks-general-wine-store',
  'green-olive-red-hill', 'flinders-general-store', 'balnarring-pub',
  'rye-hotel', 'sorrento-gelato', 'the-rocks-mornington', 'portsea-hotel'
];

const venues = dogFriendlySlugs
  .map(s => allVenues.find(v => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Dog-Friendly Restaurants Mornington Peninsula',
  description: 'Dog-friendly dining on the Mornington Peninsula — outdoor seating at cafes, village pubs with beer gardens, and a few winery options where dogs are welcome.',
  url: 'https://peninsulainsider.com.au/eat/dog-friendly/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Dog-Friendly Dining', item: 'https://peninsulainsider.com.au/eat/dog-friendly/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Which restaurants on the Mornington Peninsula are dog-friendly?',
      acceptedAnswer: { '@type': 'Answer', text: 'Dog-friendly dining on the Peninsula concentrates at outdoor-seating cafes, village pub beer gardens, and a small number of winery casual areas. Confirmed dog-friendly as of April 2026: Commonfolk Coffee (back courtyard), Somers General Store (outdoor), Merricks General Wine Store (outdoor), Green Olive at Red Hill (garden), Flinders General Store (outdoor), The Rocks Mornington (outdoor deck), Portsea Hotel (beer garden), Balnarring Pub (beer garden), and Rye Hotel (outdoor area). Dog policies change — verify directly before visiting.' },
    },
    {
      '@type': 'Question',
      name: 'Can I take my dog to wineries on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'A small number of wineries allow dogs in outdoor areas. Green Olive at Red Hill (garden area) and Merricks General Wine Store (outdoor seating) are confirmed. Most cellar door restaurants do not permit dogs — including Foxeys Hangout, Montalto, Quealy Winemakers, and most others. Confirm directly with any winery before visiting with a dog.' },
    },
    {
      '@type': 'Question',
      name: 'What is the best dog-friendly pub on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'The Portsea Hotel has the best dog-friendly beer garden with sweeping Port Phillip Bay views. Balnarring Pub is the most relaxed and local-feeling dog-friendly pub on the Peninsula. Both confirm dogs are welcome in outdoor areas.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Dog-Friendly Restaurants Mornington Peninsula · Peninsula Insider"
  description="Dog-friendly dining on the Mornington Peninsula — confirmed outdoor seating at cafes, pubs with beer gardens, and winery casual areas where dogs are welcome. Verified April 2026."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/dog-friendly/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Dog-Friendly Dining on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Dog-Friendly <span class="ornament">—</span> Verified April 2026</span>
        </div>
        <h1 class="hero__headline">Dog-friendly <em>dining</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Confirmed outdoor seating at cafes, pubs with beer gardens, and winery casual areas where dogs are welcome. Verify directly — policies change.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} venues</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-portsea-01.webp`} alt="Portsea Hotel beer garden — dog-friendly with bay views" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Portsea Hotel <span class="ornament">—</span> the best dog-friendly beer garden on the Peninsula</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">Three types of venue <em>welcome dogs</em>.</h2>
        <div class="letter__prose">
          <blockquote class="pullquote"><strong>Dog policies change.</strong> This list is based on outdoor-seating policies as of April 2026. Verify directly with the venue before you visit with a dog.</blockquote>

          <p>Dog-friendly dining on the Peninsula concentrates at three types of venue: outdoor-seating specialty cafes, village pub beer gardens, and a small number of winery casual dining areas. Most Peninsula restaurants, cellar door dining rooms, and hatted venues do not permit dogs.</p>

          <p>The clearest options: Commonfolk Coffee in Mornington has a proper back courtyard. The Portsea Hotel and Balnarring Pub both have dog-friendly beer gardens with outdoor dining. Green Olive at Red Hill and Merricks General Wine Store are the best winery-adjacent options.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula outdoor dining">
        <figcaption class="letter__image-cap">The Peninsula outdoors — <em>where dogs are welcome at the edges.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} venues confirmed for <em>outdoor dining with dogs</em>.</h2>
        <p class="shortlist__intro-body">Always verify directly with the venue before visiting with a dog — policies change seasonally.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>Which restaurants are dog-friendly on the Mornington Peninsula?</strong><br>Confirmed as of April 2026: Commonfolk Coffee (back courtyard), Somers General, Merricks General Wine Store, Green Olive at Red Hill, Flinders General Store, The Rocks Mornington (outdoor deck), Portsea Hotel (beer garden), Balnarring Pub, Rye Hotel (outdoor). Dog policies change — verify before visiting.</p>

          <p><strong>Can I take my dog to a winery?</strong><br>A small number of wineries allow dogs in outdoor areas: Green Olive at Red Hill and Merricks General Wine Store are confirmed. Most cellar door restaurants do not permit dogs. Confirm directly with any winery before arriving with a dog.</p>

          <p><strong>What is the best dog-friendly pub on the Peninsula?</strong><br>The Portsea Hotel has the best beer garden with bay views. Balnarring Pub is the most relaxed and local-feeling dog-friendly pub. Both confirm dogs welcome in outdoor areas.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More dog-friendly <em>Peninsula</em> content.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Journal</span>
        </div>
        <div class="venue__meta"><span>Guide</span></div>
        <a href={`${base}journal/dog-friendly-cafes-pubs-wineries-mornington-peninsula/`}><h3 class="venue__name">Dog-Friendly Cafes, Pubs &amp; Wineries</h3></a>
        <p class="venue__sig">The full guide — where dogs are welcome, the rules that apply, and how to plan a dog-friendly Peninsula day.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}dog-friendly/`}><h3 class="venue__name">Dog-Friendly Peninsula</h3></a>
        <p class="venue__sig">Beaches, walks, cafes, and accommodation — the complete guide to the Peninsula with a dog.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/`}><h3 class="venue__name">All Eat &amp; Drink</h3></a>
        <p class="venue__sig">The full Peninsula dining guide — restaurants, cellar doors, cafes, bakeries, and pubs.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
