---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const cellarDoorSlugs = [
  'montalto', 'ten-minutes-by-tractor', 'polperro', 'pt-leo-estate',
  'paringa-estate', 'port-phillip-estate', 'foxeys-hangout', 'rare-hare',
  'red-hill-estate', 't-gallant', 'barmah-park'
];

const venues = cellarDoorSlugs
  .map(s => allVenues.find(v => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v))
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Cellar Door Lunch Mornington Peninsula',
  description: 'The best cellar door lunch venues on the Mornington Peninsula — wineries with kitchens, estate wine, and lunches worth building a weekend around.',
  url: 'https://peninsulainsider.com.au/eat/cellar-door-lunch/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Cellar Door Lunch', item: 'https://peninsulainsider.com.au/eat/cellar-door-lunch/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the best cellar door lunch on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Montalto (Red Hill South) is the most complete cellar door lunch estate — sculpture trail, kitchen garden, a walk-in Piazza option and a one-hat main restaurant. For the most celebrated destination experience, Laura at Pt. Leo Estate holds two hats and requires bookings four months ahead.' },
    },
    {
      '@type': 'Question',
      name: 'Which cellar door restaurants accept walk-ins on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Montalto Piazza is walk-in daily 11am–5pm. Foxeys Hangout accepts no bookings (max group 6). Rare Hare at Willow Creek is walk-in only from 2pm weekends. All other cellar door restaurants on this list require bookings, often well in advance on weekends.' },
    },
    {
      '@type': 'Question',
      name: 'Do you need to book a cellar door lunch on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes for most venues. Red Hill cellar door restaurants book out quickly on weekends, especially in autumn and spring. Book four to eight weeks ahead for weekends at serious venues. Walk-ins available at Montalto Piazza, Foxeys Hangout, and Rare Hare.' },
    },
    {
      '@type': 'Question',
      name: 'Can you combine a cellar door tasting with lunch on the same visit?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes — most Peninsula cellar door restaurants offer tastings and lunch on the same visit. The standard move: arrive at 11am or 12pm for a tasting, then book the main restaurant or Piazza for lunch. Montalto, Pt. Leo Estate, and Paringa Estate all do this well. Allow a full afternoon.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Cellar Door Lunch Mornington Peninsula · Peninsula Insider"
  description="The best cellar door lunch venues on the Mornington Peninsula — winery restaurants with hatted kitchens, estate wine, and lunches worth building a Peninsula day around."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/cellar-door-lunch/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Cellar Door Lunch on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Cellar Door Lunch <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Cellar door <em>lunch</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">The best winery restaurants with hatted kitchens, estate wine, and lunches worth building a Peninsula day around.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} estates</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Red Hill cellar door country" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Hill <span class="ornament">—</span> the heart of cellar-door country</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">The Peninsula's <em>most distinctive</em> food experience.</h2>
        <div class="letter__prose">
          <p>The cellar door lunch is the Peninsula's most distinctive food experience. A winery with a kitchen — estate wine poured from the vineyard outside, produce grown or sourced within a few kilometres, and a dining room that exists because the place earned it rather than because a marketing brief suggested it would convert tastings.</p>

          <p>The Peninsula has more serious cellar door restaurants than almost any other wine region in Australia. The best sit in the Red Hill and Main Ridge sub-regions — the coolest part of the plateau, where the pinot grows slowest and the dining rooms feel most grounded in the landscape. Montalto, Ten Minutes by Tractor, and Polperro are the landmarks. Below them, eleven more worth knowing about.</p>

          <blockquote class="pullquote">The practical rule: arrive at the cellar door for a tasting first, book the restaurant for 12pm or 12:30pm, and plan nothing for the afternoon.</blockquote>

          <p>The day will not improve by trying to fit another estate in afterwards.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-main-ridge-01.webp`} alt="Main Ridge cellar country">
        <figcaption class="letter__image-cap">Main Ridge — <em>the coolest corner of the plateau.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} wineries with <em>kitchens</em> worth sitting down at.</h2>
        <p class="shortlist__intro-body">Ordered by editorial authority. Hatted rooms first, then the places doing the strongest quiet work.</p>
        <a href={`${base}wine/`} class="shortlist__intro-link">All wineries
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
        </a>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>What is the best cellar door lunch on the Mornington Peninsula?</strong><br>Montalto (Red Hill South) is the most complete estate: sculpture trail, kitchen garden, a walk-in Piazza option, and a one-hat main restaurant. For the most celebrated destination, Laura at Pt. Leo Estate holds two hats and requires bookings four months ahead.</p>

          <p><strong>Which cellar door restaurants accept walk-ins?</strong><br>Montalto Piazza (daily, 11am–5pm), Foxeys Hangout (no bookings, max group 6), and Rare Hare at Willow Creek (walk-in from 2pm weekends). All other venues on this list require bookings.</p>

          <p><strong>Do I need to book?</strong><br>Yes, for almost all venues. Red Hill cellar door restaurants book out quickly on weekends in autumn and spring. Book four to eight weeks ahead for serious venues. Walk-ins available at Montalto Piazza, Foxeys, and Rare Hare.</p>

          <p><strong>Can I combine tasting and lunch on the same visit?</strong><br>Yes — most Peninsula cellar door restaurants offer both. The move: arrive at 11am or 12pm for a tasting, then book the restaurant for lunch. Allow a full afternoon. Do not plan another estate after lunch.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/long-lunch/`}><h3 class="venue__name">Long Lunch</h3></a>
        <p class="venue__sig">The best rooms for a two-to-three-hour afternoon at the table with estate wine.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/wine-hub-hero-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Section</span>
        </div>
        <div class="venue__meta"><span>Wine Country</span></div>
        <a href={`${base}wine/`}><h3 class="venue__name">Wine Country</h3></a>
        <p class="venue__sig">All Peninsula cellar doors — with and without kitchens, by sub-region.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-main-ridge-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/hatted-restaurants/`}><h3 class="venue__name">Hatted Restaurants</h3></a>
        <p class="venue__sig">The complete Good Food Guide hat list for the Peninsula, with booking realities.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
