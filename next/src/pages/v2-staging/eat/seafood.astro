---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const slugs = ['pier-street-flinders','the-baths-sorrento','the-rocks-mornington','afloat-mornington','ocean-eight','flinders-pier-takeaway','portsea-hotel'];
const venues = slugs.map(s=>allVenues.find(v=>routeSlug(v)===s)).filter((v):v is NonNullable<typeof v>=>Boolean(v));

const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Best Seafood Restaurants Mornington Peninsula',description:'The best seafood restaurants on the Mornington Peninsula — waterfront bay dining, seafood takeaway, and the cellar-door kitchen doing the category properly.',url:'https://peninsulainsider.com.au/eat/seafood/',breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{position:1,name:'Home',item:'https://peninsulainsider.com.au/'},{position:2,name:'Eat & Drink',item:'https://peninsulainsider.com.au/eat/'},{position:3,name:'Seafood',item:'https://peninsulainsider.com.au/eat/seafood/'}].map(e=>({'@type':'ListItem',...e}))},mainEntity:{'@type':'ItemList',itemListOrder:'https://schema.org/ItemListOrderDescending',numberOfItems:venues.length,itemListElement:venues.map((v,i)=>({'@type':'ListItem',position:i+1,name:v.data.name,url:`https://peninsulainsider.com.au/eat/${routeSlug(v)}/`}))}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:'Where is the best seafood on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'Pier Street Kitchen in Flinders holds one GFG hat and is the strongest all-round seafood dining room on the Peninsula. The Baths at Sorrento is the best waterfront seafood experience. Afloat in Mornington does the best fish and chips in a sit-down setting. For a casual takeaway, Flinders Pier Takeaway is local institution.'}},{'@type':'Question',name:'Where can I get fish and chips on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'Flinders Pier Takeaway is the Peninsula benchmark for fish and chips — the pier location, fresh fish, and no-frills format make it a genuinely good stop. Afloat in Mornington is the better sit-down version. Both are cash-friendly and suited to a beach day.'}},{'@type':'Question',name:'Are there dog-friendly seafood restaurants on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'The Rocks at Mornington (outdoor deck) and Portsea Hotel (beer garden) are both confirmed dog-friendly and serve seafood menus. Verify directly before visiting as policies can change.'}}]};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Best Seafood Mornington Peninsula · Peninsula Insider"
  description="The best seafood restaurants on the Mornington Peninsula — Pier Street Kitchen's hatted kitchen, The Baths at Sorrento, waterfront fish and chips, and local oysters."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/seafood/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Best Seafood on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Seafood <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Best <em>seafood</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">One hatted dining room, a waterfront experience, and the benchmark pier-side takeaway. The category rewards matching venue to the right afternoon.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} venues</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-flinders-01.webp`} alt="Flinders Pier — the Peninsula seafood institution" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Flinders Pier <span class="ornament">—</span> where the Peninsula's seafood benchmark sits</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">Concentrated around the <em>piers</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula's seafood scene is concentrated around its waterfront towns and fishing piers. Pier Street Kitchen in Flinders is the strongest all-round seafood dining room — one GFG hat, a proper kitchen, and a setting that justifies the southern drive. The Baths at Sorrento is the waterfront experience, and Flinders Pier Takeaway is the benchmark for a genuinely good casual stop that does not pretend to be anything else.</p>

          <p>The Peninsula's fish is primarily sourced locally or from the southern Victorian coast — king george whiting, calamari, abalone in season, and Mornington Peninsula oysters when available. The category rewards finding the right venue for the right kind of afternoon.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula seafood">
        <figcaption class="letter__image-cap">The pier at Flinders — <em>where local whiting and calamari land daily.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} seafood <em>venues</em> ranked.</h2>
        <p class="shortlist__intro-body">The hatted kitchen first, then the waterfront dining options, then the best casual stops.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>Where is the best seafood on the Mornington Peninsula?</strong><br>Pier Street Kitchen (Flinders) holds one GFG hat and is the strongest all-round seafood dining room. The Baths at Sorrento is the best waterfront seafood experience. Flinders Pier Takeaway is the local institution for fish and chips.</p>

          <p><strong>Where can I get fish and chips?</strong><br>Flinders Pier Takeaway — the pier location, fresh fish, no-frills format. Afloat in Mornington is the better sit-down version.</p>

          <p><strong>Are there dog-friendly seafood venues?</strong><br>The Rocks at Mornington (outdoor deck) and Portsea Hotel (beer garden) are confirmed dog-friendly and serve seafood menus. Verify before visiting.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/waterfront/`}><h3 class="venue__name">Waterfront Dining</h3></a>
        <p class="venue__sig">Bay-facing positions at Sorrento, Mornington, and Portsea — compared honestly.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/fine-dining/`}><h3 class="venue__name">Fine Dining</h3></a>
        <p class="venue__sig">The destination dining rooms worth planning a whole Peninsula day around.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/`}><h3 class="venue__name">All Eat &amp; Drink</h3></a>
        <p class="venue__sig">The full Peninsula dining guide — restaurants, cellar doors, cafes, bakeries, and pubs.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
