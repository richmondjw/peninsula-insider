---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import V2VenueDetail from '../../../components/v2/V2VenueDetail.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug } from '../../../lib/editorial';

const STATIC_V2_EAT_OVERRIDES = new Set(['barmah-park-vineyard', 'port-phillip-estate-restaurant']);

export async function getStaticPaths() {
  const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
  const venues = await getCollection('venues');
  return venues
    .filter((venue) => eatTypes.includes(venue.data.type))
    .filter((venue) => !STATIC_V2_EAT_OVERRIDES.has(routeSlug(venue)))
    .map((venue) => ({
      params: { slug: routeSlug(venue) },
      props: { venue },
    }));
}

const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
const { venue } = Astro.props;
const slug = routeSlug(venue);

const allVenues = await getCollection('venues');
const related = allVenues
  .filter((entry) => routeSlug(entry) !== slug)
  .filter((entry) => eatTypes.includes(entry.data.type))
  .filter((entry) => String(entry.data.place?.id ?? entry.data.place) === String(venue.data.place?.id ?? venue.data.place))
  .slice(0, 3);

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .filter((article) =>
    article.data.relatedVenues.some((entry: any) => String(entry.id ?? entry) === slug)
  )
  .slice(0, 3);
export const prerender = true;
---
<BaseLayout
  title={`${venue.data.name} — Peninsula Insider`}
  description={venue.data.signature}
  section="eat"
  ogImage={venue.data.heroImage?.src}
>
  <V2VenueDetail venue={venue} section="eat" related={related} articles={articles} />
  <NewsletterBlock />
</BaseLayout>
