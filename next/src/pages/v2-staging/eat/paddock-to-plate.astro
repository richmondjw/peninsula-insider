---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');
const slugs=['tedesca-osteria','barragunda-dining','green-olive-red-hill','montalto','paringa-estate','kerri-greens','la-baracca-tgallant','red-gum-bbq','foxeys-hangout','merricks-general-wine-store','barmah-park'];
const venues=slugs.map(s=>allVenues.find(v=>routeSlug(v)===s)).filter((v):v is NonNullable<typeof v>=>Boolean(v)).sort((a,b)=>Number(b.data.authority?.hats??0)-Number(a.data.authority?.hats??0));

const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Paddock to Plate Restaurants Mornington Peninsula',description:'Farm-to-table and paddock-to-plate restaurants on the Mornington Peninsula — kitchens growing their own produce, sourcing from nearby farms, and cooking with what the landscape actually provides.',url:'https://peninsulainsider.com.au/eat/paddock-to-plate/',breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{position:1,name:'Home',item:'https://peninsulainsider.com.au/'},{position:2,name:'Eat & Drink',item:'https://peninsulainsider.com.au/eat/'},{position:3,name:'Paddock to Plate',item:'https://peninsulainsider.com.au/eat/paddock-to-plate/'}].map(e=>({'@type':'ListItem',...e}))},mainEntity:{'@type':'ItemList',itemListOrder:'https://schema.org/ItemListOrderDescending',numberOfItems:venues.length,itemListElement:venues.map((v,i)=>({'@type':'ListItem',position:i+1,name:v.data.name,url:`https://peninsulainsider.com.au/eat/${routeSlug(v)}/`}))}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:'Which Mornington Peninsula restaurants grow their own produce?',acceptedAnswer:{'@type':'Answer',text:'Tedesca Osteria (Red Hill) runs a biodynamic property with chickens, beehives, sheep, and an on-site kitchen garden — the most fully realised farm-to-table operation on the Peninsula. Barragunda Dining (Cape Schanck) grows its own organic vegetables on a 1000-acre estate and sources hyper-locally. Green Olive at Red Hill (Red Hill South) is built around an organic olive grove, orchard, and kitchen garden.'}},{'@type':'Question',name:'What does paddock to plate mean in a restaurant context?',acceptedAnswer:{'@type':'Answer',text:'Paddock to plate means the restaurant sources its produce from its own farm or from nearby farms, with a short, traceable supply chain from paddock to kitchen. On the Peninsula, this means estate-grown vegetables, local seafood, and regional producers rather than wholesale distributors. The strongest examples are Tedesca Osteria, Barragunda, and Green Olive — all of which grow some or most of their produce on-site.'}},{'@type':'Question',name:'Is paddock to plate just marketing or does it mean something on the Mornington Peninsula?',acceptedAnswer:{'@type':'Answer',text:'On the Peninsula, it means something real at the best restaurants. Tedesca Osteria\'s biodynamic property, Barragunda\'s estate garden, and Green Olive\'s olive grove all genuinely supply their kitchens. Some venues use the term more loosely. As a filter, look for restaurants that name their farms and producers on the menu — not just claim the concept.'}}]};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Paddock to Plate Restaurants Mornington Peninsula · Peninsula Insider"
  description="Farm-to-table restaurants on the Mornington Peninsula — Tedesca Osteria's biodynamic farm, Barragunda's estate garden, and the kitchens that actually grow what they serve."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/paddock-to-plate/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Paddock to Plate on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Paddock to Plate <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Paddock to <em>plate</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Kitchens growing their own produce, sourcing from nearby farms, and cooking with what the landscape actually provides. The real ones name their producers on the menu.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} venues</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Peninsula farm-to-table — biodynamic kitchen gardens" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Hill <span class="ornament">—</span> where the farm supplies the kitchen and the supply chain ends at the paddock gate</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">The landscape <em>produces it</em>.</h2>
        <div class="letter__prose">
          <p>The Peninsula has more genuine farm-to-table dining than almost any other regional destination in Victoria. The landscape produces it: the cool plateau grows some of Australia's best cool-climate produce, the Bass Strait coast supplies exceptional seafood, and the farm density in the Red Hill hinterland means short supply chains are the rule rather than the exception.</p>

          <p>The strongest example is Tedesca Osteria — a biodynamic property in Red Hill where Brigitte Hafner keeps chickens, beehives, and Wiltshire Horn sheep that supply the kitchen alongside an on-site garden. It is the most fully realised farm restaurant on the Peninsula and one of the most serious in Victoria. Below it, Barragunda (estate-grown organic vegetables, hibachi-charred proteins), Green Olive (olive grove, orchard, kitchen garden), and a set of cellar door restaurants where the wine and food share the same landscape.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula farm">
        <figcaption class="letter__image-cap">The biodynamic plateau — <em>short supply chains are the rule, not the exception.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} kitchens cooking with what the <em>Peninsula actually grows</em>.</h2>
        <p class="shortlist__intro-body">Hatted farm restaurants first, then the venues where the supply chain is visibly short.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>Which restaurants grow their own produce?</strong><br>Tedesca Osteria: biodynamic property, chickens, beehives, sheep, kitchen garden. Barragunda: estate-grown organic vegetables on a 1000-acre property. Green Olive at Red Hill: olive grove, orchard, kitchen garden.</p>

          <p><strong>Does paddock to plate mean something real here?</strong><br>At the best venues, yes. Tedesca, Barragunda, and Green Olive genuinely supply their kitchens from on-site or nearby farms. Look for menus that name producers — that's the real signal.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/fine-dining/`}><h3 class="venue__name">Fine Dining</h3></a>
        <p class="venue__sig">The destination dining rooms — most of the serious farm-restaurant kitchens are also hatted.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/cellar-door-lunch/`}><h3 class="venue__name">Cellar Door Lunch</h3></a>
        <p class="venue__sig">Winery restaurants where the kitchen shares the landscape with the vines.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/`}><h3 class="venue__name">All Eat &amp; Drink</h3></a>
        <p class="venue__sig">The full Peninsula dining guide.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
