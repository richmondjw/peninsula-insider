---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const fineDiningSlugs = [
  'tedesca-osteria', 'laura-pt-leo', 'doot-doot-doot', 'polperro',
  'montalto', 'ten-minutes-by-tractor', 'paringa-estate', 'port-phillip-estate',
  'barragunda-dining'
];

const venues = fineDiningSlugs
  .map(s => allVenues.find(v => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v))
  .sort((a, b) => Number(b.data.authority?.hats ?? 0) - Number(a.data.authority?.hats ?? 0));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Fine Dining Mornington Peninsula',
  description: 'Destination fine dining on the Mornington Peninsula — embedded in vineyard estates, converted farmhouses, and working properties. Not city fine dining.',
  url: 'https://peninsulainsider.com.au/eat/fine-dining/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Fine Dining', item: 'https://peninsulainsider.com.au/eat/fine-dining/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the best fine dining restaurant on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'By Good Food Guide recognition: Barragunda Dining, Laura at Pt. Leo Estate, and Tedesca Osteria all hold two hats. Laura is the most internationally credentialled (Relais & Châteaux, seventh consecutive two-hat year). Barragunda is the newest and hardest booking. Tedesca is the most farm-forward and personal.' },
    },
    {
      '@type': 'Question',
      name: 'Is there a dress code at Peninsula fine dining restaurants?',
      acceptedAnswer: { '@type': 'Answer', text: 'Peninsula fine dining is generally smart casual rather than formal. Tedesca Osteria and Laura lean more considered; Rare Hare and Montalto are relaxed. No Peninsula restaurant has a strict jacket requirement. The vineyard and farm settings set a slightly more casual register than a Melbourne CBD fine dining room.' },
    },
    {
      '@type': 'Question',
      name: 'Can I book Peninsula fine dining for a group?',
      acceptedAnswer: { '@type': 'Answer', text: 'Groups of 6+ should contact venues directly as most hatted rooms have private dining options or set-menu formats for larger parties. Foxeys Hangout accepts maximum groups of 6. Montalto and Port Phillip Estate both have event space options. Contact venues directly for group enquiries.' },
    },
    {
      '@type': 'Question',
      name: 'When is the best time to visit for fine dining?',
      acceptedAnswer: { '@type': 'Answer', text: 'Autumn (March–May) is the strongest season — vintage is running, summer crowds have thinned, and bookings are more achievable. Spring is excellent for new menus and release wines. Winter fine dining with fires in cellar door rooms is underrated and offers the best availability.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout
  title="Fine Dining Mornington Peninsula · Peninsula Insider"
  description="Destination fine dining on the Mornington Peninsula — hatted vineyard restaurants, converted farmhouses, and the rooms worth planning a whole day around."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/fine-dining/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Fine Dining on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Fine Dining <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Fine <em>dining</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Destination rooms embedded in vineyard estates, converted farmhouses, and working properties. The long lunch is the defining format.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} rooms</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-red-hill-01.webp`} alt="Peninsula fine dining — the long lunch" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Red Hill <span class="ornament">—</span> the fine dining heartland of the Peninsula</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">Not city fine dining — <em>something else entirely</em>.</h2>
        <div class="letter__prose">
          <p>Fine dining on the Mornington Peninsula is not city fine dining. The format here is embedded in vineyard estates, working farms, and converted heritage buildings. You eat in a 40-seat room in a converted 1940s farmhouse where the kitchen garden is outside the window. Or in a glass-walled dining room above a sculpture park overlooking Western Port Bay. Or under a 10,000-globe chandelier in a boutique winery hotel.</p>

          <p>The Peninsula's best fine dining rooms share a few things: serious winemaker relationships, produce sourced within a few kilometres, and service rhythms calibrated to a long afternoon rather than a city turnover. The long lunch is the defining format.</p>

          <blockquote class="pullquote">Four venues carry two hats from the Good Food Guide — Barragunda, Laura, Tedesca, and Ten Minutes by Tractor. All require bookings, often well in advance.</blockquote>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026 · Source: Good Food Guide 2025</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/home-cover.webp`} alt="Peninsula cellar door">
        <figcaption class="letter__image-cap">The Peninsula at the long lunch — <em>calibrated for the afternoon, not the turnover.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} destination <em>dining rooms</em>.</h2>
        <p class="shortlist__intro-body">Ranked by editorial authority — two-hat venues first, then the one-hat rooms, then the places working seriously without formal recognition.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>What is the best fine dining restaurant on the Mornington Peninsula?</strong><br>By Good Food Guide recognition, Barragunda Dining, Laura at Pt. Leo Estate, and Tedesca Osteria all hold two hats. Laura is the most internationally credentialled. Barragunda is the newest and hardest booking. Tedesca is the most farm-forward and personal.</p>

          <p><strong>Is there a dress code?</strong><br>Smart casual throughout — no Peninsula restaurant has a strict jacket requirement. The vineyard and farm settings register slightly more relaxed than a Melbourne CBD fine dining room, but the food is every bit as serious.</p>

          <p><strong>Can I book for a group?</strong><br>Groups of 6+ should contact venues directly. Most hatted rooms have private dining options or set-menu formats for larger parties. Contact venues directly for group enquiries.</p>

          <p><strong>When is the best time to visit?</strong><br>Autumn (March to May) is the strongest season — vintage running, summer crowds thinned, bookings more achievable. Winter fine dining with cellar door fires is underrated and offers better availability than peak season.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-red-hill-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/hatted-restaurants/`}><h3 class="venue__name">Hatted Restaurants</h3></a>
        <p class="venue__sig">The complete Good Food Guide hat list with booking realities for each venue.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/long-lunch/`}><h3 class="venue__name">Long Lunch</h3></a>
        <p class="venue__sig">The best rooms for a two-to-three-hour afternoon at the table with estate wine.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/cellar-door-lunch/`}><h3 class="venue__name">Cellar Door Lunch</h3></a>
        <p class="venue__sig">Winery restaurants where the kitchen and the cellar door are the same experience.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
