---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/v2/BaseLayout.astro';
import NewsletterBlock from '../../../components/v2/NewsletterBlock.astro';
import { routeSlug, titleize, placeLabel, typeLabel } from '../../../lib/editorial';

const allVenues = await getCollection('venues');

const cafeTypes = ['cafe'];
const cafeSlugs = ['commonfolk-coffee','many-little','somers-general',  'merricks-general-wine-store','store-ten','stringers-mornington','flinders-general-store',
  'rocker','sorrento-gelato'];

const venues = cafeSlugs
  .map(s => allVenues.find(v => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Best Cafes Mornington Peninsula',
  description: 'The best cafes on the Mornington Peninsula — specialty coffee, brunch rooms, and village stops worth planning a detour for.',
  url: 'https://peninsulainsider.com.au/eat/cafes/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Eat & Drink', item: 'https://peninsulainsider.com.au/eat/' },
      { '@type': 'ListItem', position: 3, name: 'Best Cafes', item: 'https://peninsulainsider.com.au/eat/cafes/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.data.name,
      url: `https://peninsulainsider.com.au/eat/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the best cafe on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Commonfolk Coffee in Mornington (16 Progress Street) is widely regarded as the Peninsula\'s best specialty coffee. House roaster, excellent food menu, dog-friendly back courtyard. For a village cafe experience, Somers General Store (Somers) and Small Stone Pantry (Shoreham) are both worth planning a stop around.' },
    },
    {
      '@type': 'Question',
      name: 'Which cafes on the Mornington Peninsula are dog-friendly?',
      acceptedAnswer: { '@type': 'Answer', text: 'Commonfolk Coffee (back courtyard), Somers General Store (outdoor seating), and Flinders General Store (outdoor area) are confirmed dog-friendly. Check directly with venues as outdoor seating policies can change seasonally.' },
    },
    {
      '@type': 'Question',
      name: 'Where should I go for brunch on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Commonfolk Coffee (Mornington) for specialty coffee and a serious brunch menu. Many Little Bar & Dining (Red Hill South) for a more elevated cafe experience — hatted restaurant with a casual daytime offer. Merricks General Wine Store for a village brunch in a genuinely beautiful setting.' },
    },
  ],
};

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
export const prerender = true;
---
<BaseLayout
  title="Best Cafes Mornington Peninsula · Peninsula Insider"
  description="The best cafes on the Mornington Peninsula — specialty coffee at Commonfolk, village stops in Somers and Flinders, and the brunch rooms worth the drive."
  section="eat"
  canonical="https://peninsulainsider.com.au/eat/cafes/"
  modifiedTime="2026-04-24"
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="hero" aria-label="Best Cafes on the Mornington Peninsula">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}eat/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Eat &amp; Drink</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">Cafes <span class="ornament">—</span> Updated April 2026</span>
        </div>
        <h1 class="hero__headline">Best <em>cafes</em> on the Mornington Peninsula.</h1>
        <p class="hero__dek">Specialty coffee at Commonfolk, village stops in Somers and Flinders, and the brunch rooms worth the drive.</p>
        <div class="hero__byline">
          <span>— By <strong>The Peninsula Insider Editors</strong></span>
          <a href="#rankings" class="hero__byline-read">Jump to the list <span style="opacity:.5;margin-left:.3rem;">{venues.length} cafes</span></a>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={`${base}images/sourced/place-mornington-01.webp`} alt="Mornington — specialty coffee benchmark" loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>Mornington <span class="ornament">—</span> the specialty-coffee benchmark</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="intro-title">
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's Letter</span>
        </div>
        <h2 class="letter__head" id="intro-title">The <em>general store</em> cafe is the Peninsula pattern.</h2>
        <div class="letter__prose">
          <p>The Peninsula's cafe scene concentrates in Mornington and the hinterland villages. Commonfolk Coffee in Mornington is the benchmark for specialty coffee — a house roaster, an excellent kitchen, and the kind of back courtyard that makes a weekday morning feel like a weekend decision. Below it, a scattered set of village cafes and general stores doing honest work without trying to be anything they are not.</p>

          <blockquote class="pullquote">The pattern on the Peninsula is the general store cafe: a converted grocery or provisions building now serving coffee, pastries, and a limited food menu.</blockquote>

          <p>Somers General, Flinders General Store, and Merricks General Wine Store are the strongest examples. Each is worth a stop rather than a destination, unless you are already in the right part of the Peninsula for another reason.</p>
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">The Editors</div>
            <div class="letter__sig-role">Last fact-verified 23 April 2026</div>
          </div>
        </div>
      </div>
      <div class="letter__side">
        <img class="letter__image" src={`${base}images/sourced/place-flinders-01.webp`} alt="Flinders General Store">
        <figcaption class="letter__image-cap">Flinders General Store — <em>the converted-provisions pattern at its best.</em></figcaption>
      </div>
    </div>
  </div>
</section>

<section class="shortlist" id="rankings" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <span class="eyebrow eyebrow--ochre">The Shortlist</span>
        <h2 id="shortlist-title">{venues.length} coffee rooms and <em>village stops</em>.</h2>
        <p class="shortlist__intro-body">The specialty coffee destination first, then the village cafes worth knowing by location.</p>
      </div>

      <ol class="shortlist__list" style="list-style:none;">
        {venues.map((v, i) => {
          const data = v.data;
          const hats = data.authority?.hats ?? 0;
          const num = String(i + 1).padStart(2, '0');
          const place = placeLabel(data.place);
          const type = typeLabel[data.type] ?? data.type;
          const allTags = [
            ...(data.tags?.mood ?? []),
            ...(data.tags?.audience ?? []),
          ].slice(0, 3);
          return (
            <li class="sl-item">
              <span class="sl-item__num">{num}</span>
              <div class="sl-item__body">
                <div class="sl-item__meta">
                  <span>{place}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{type}</span>
                  <span class="sl-item__meta-sep"></span>
                  <span>{data.priceBand}</span>
                </div>
                <a href={`${base}eat/${routeSlug(v)}/`} class="sl-item__name">{data.name}</a>
                <p class="sl-item__why">{data.signature}</p>
                <div class="sl-item__tags">
                  {hats > 0 && <span class="sl-item__tag sl-item__tag--hat">{hats} hat{hats > 1 ? 's' : ''}</span>}
                  {allTags.map((tag: string) => (
                    <span class="sl-item__tag">{titleize(tag)}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="faq-title">
  <div class="container">
    <div class="letter__frame" style="display:block;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Frequently Asked</span>
        </div>
        <h2 class="letter__head" id="faq-title">The <em>questions</em> we get asked.</h2>
        <div class="letter__prose">
          <p><strong>What is the best cafe on the Mornington Peninsula?</strong><br>Commonfolk Coffee (Mornington, 16 Progress Street) is the benchmark for specialty coffee on the Peninsula. House roaster, serious food menu, dog-friendly back courtyard, open every day except Christmas.</p>

          <p><strong>Which cafes are dog-friendly?</strong><br>Commonfolk Coffee (back courtyard), Somers General Store (outdoor seating), and Flinders General Store (outdoor area) are confirmed dog-friendly. Check directly with venues as outdoor seating policies can change.</p>

          <p><strong>Where should I go for brunch?</strong><br>Commonfolk Coffee for specialty coffee and a serious brunch menu. Many Little Bar &amp; Dining (Red Hill South) for a more elevated cafe-daytime experience. Merricks General Wine Store for a village brunch in a genuinely beautiful setting.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dept" aria-labelledby="related-title">
  <div class="container">
    <div class="dept__head">
      <div class="dept__titles">
        <span class="eyebrow eyebrow--ochre">Related guides</span>
        <h2 class="dept__title" id="related-title">More ways to <em>eat</em> on the Peninsula.</h2>
      </div>
      <a href={`${base}eat/`} class="well__head-link">All Eat &amp; Drink →</a>
    </div>
    <div class="dept__grid">
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-flinders-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/bakeries/`}><h3 class="venue__name">Best Bakeries</h3></a>
        <p class="venue__sig">The six Peninsula bakeries worth knowing — where they are and what makes each one different.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/place-mornington-01.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/brunch/`}><h3 class="venue__name">Best Brunch</h3></a>
        <p class="venue__sig">The brunch spots worth planning a detour for — from Mornington to the hinterland.</p>
      </article>
      <article class="venue">
        <div class="venue__image" style={`background-image:url(${base}images/sourced/home-cover.webp);background-size:cover;background-position:center;`}>
          <span class="venue__image-marker">Guide</span>
        </div>
        <div class="venue__meta"><span>Category</span></div>
        <a href={`${base}eat/`}><h3 class="venue__name">All Eat &amp; Drink</h3></a>
        <p class="venue__sig">The full Peninsula dining guide — restaurants, cellar doors, cafes, bakeries, and pubs.</p>
      </article>
    </div>
  </div>
</section>

<NewsletterBlock />
</BaseLayout>
