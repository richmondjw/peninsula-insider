---
/**
 * CMS page-builder catch-all — static generation.
 *
 * Enumerates all published Sanity `page` documents at build time via
 * fetchAllPageSlugsFromSanity(), builds a static HTML file for each,
 * and fetches the full page data as a prop so each page renders from
 * the CDN-cached response rather than a live Sanity query.
 *
 * Preview routes (/preview/*) still use SSR — see src/pages/preview/.
 * This route intentionally coexists with hardcoded Astro pages; explicit
 * file routes take priority over this catch-all.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionRenderer from '../components/page-builder/SectionRenderer.astro'
import {fetchAllPageSlugsFromSanity, fetchPageBySlug, imageUrl, pagePathFromSlug, type CmsPage} from '../lib/sanity/page-builder'

export async function getStaticPaths() {
  const slugs = await fetchAllPageSlugsFromSanity()
  const pages = await Promise.all(
    slugs.map(async (slug) => {
      const page = await fetchPageBySlug(slug)
      return page ? { params: { slug }, props: { page } } : null
    })
  )
  return pages.filter((p): p is { params: { slug: string }; props: { page: CmsPage } } => p !== null)
}

export const prerender = true

const { page } = Astro.props as { page: CmsPage }

const title = page.seoTitle || `${page.title} · Peninsula Insider`
const description = page.seoDescription || 'Peninsula Insider page.'
const ogImage = imageUrl(page.ogImage, 'og')
const canonical = `https://peninsulainsider.com.au${pagePathFromSlug(page.slug)}`
---

<BaseLayout
  title={title}
  description={description}
  section="home"
  canonical={canonical}
  ogImage={ogImage}
  noindex={Boolean(page.noIndex)}
  searchKind="Page"
>
  <SectionRenderer sections={page.sections ?? []} />
</BaseLayout>
