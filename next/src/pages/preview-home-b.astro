---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';

const now = new Date();
const issueDate = now.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' });
const weekendLabel = '2–3 May';

const plannerCards = [
  {
    label: 'The main move',
    title: 'Red Hill Market, then stay south',
    note: 'Do the market early, book lunch once, and let the rest of the day breathe.',
    href: '/journal/peninsula-this-weekend-april-26/'
  },
  {
    label: 'Rain-proof backup',
    title: 'Alba Fire & Ice',
    note: 'The cleanest all-weather Peninsula booking right now. Afternoon slot, not evening.',
    href: '/whats-on/alba-fire-and-ice-sessions/'
  },
  {
    label: 'Useful planning note',
    title: 'Start with the lunch, not the drive',
    note: 'The site gets stronger when the homepage behaves like a desk: one call, one backup, one note.',
    href: '/journal/the-long-lunch/'
  }
];

const routes = [
  { title: 'Long lunch', note: 'One decisive table, properly argued.', href: '/journal/the-long-lunch/' },
  { title: 'Rainy day', note: 'Weather-proof without feeling like a fallback.', href: '/journal/the-rainy-day-peninsula-without-a-booking/' },
  { title: 'With kids', note: 'A Peninsula day that punishes no one.', href: '/journal/the-peninsula-with-kids/' },
  { title: 'One night', note: 'A compact escape with the sequence already solved.', href: '/journal/the-one-night-escape/' },
];

const reads = [
  {
    eyebrow: 'Journal',
    title: 'The Hatted Restaurants of the Mornington Peninsula',
    note: 'A practical prestige piece. Strong search bait, stronger homepage anchor.',
    href: '/journal/hatted-restaurants-mornington-peninsula-2025/'
  },
  {
    eyebrow: 'Weekend plan',
    title: 'What to Do in Red Hill This Weekend: The Saturday Plan',
    note: 'This is the kind of intent-led piece the homepage should promote hard.',
    href: '/journal/how-to-build-a-red-hill-saturday/'
  },
  {
    eyebrow: 'Service',
    title: 'The Chardonnay Case',
    note: 'Good proof the brand can have an opinion without sounding precious.',
    href: '/journal/the-chardonnay-case/'
  }
];
---

<BaseLayout
  title="DRAFT — Homepage Preview B | Peninsula Insider"
  description="Preview page — weekend desk direction."
  section="home"
  noindex={true}
>
  <style>
    .preview-shell {
      background:
        radial-gradient(circle at top left, rgba(182,148,86,0.14), transparent 34%),
        linear-gradient(180deg, #f7f2ea 0%, #f3ede3 40%, #efe8dd 100%);
    }
    .desk-hero {
      padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(3rem, 7vw, 5.5rem);
      border-bottom: 1px solid rgba(43, 37, 32, 0.08);
    }
    .desk-hero__grid {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 clamp(1.25rem, 4vw, 2.5rem);
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }
    .desk-hero__kicker,
    .section-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      font: 600 0.72rem/1 Outfit, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.24em;
      color: #8b4e3b;
      margin-bottom: 1.4rem;
    }
    .desk-hero__kicker::before,
    .section-kicker::before {
      content: '';
      width: 38px;
      height: 1px;
      background: rgba(139, 78, 59, 0.45);
    }
    .desk-hero__headline {
      margin: 0;
      max-width: 10ch;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(3.5rem, 8vw, 7rem);
      line-height: 0.92;
      letter-spacing: -0.045em;
      color: #231d18;
    }
    .desk-hero__headline em {
      font-style: italic;
      color: #8b4e3b;
      font-weight: 500;
    }
    .desk-hero__dek {
      margin: 1.5rem 0 0;
      max-width: 43ch;
      font: 300 1.1rem/1.75 Outfit, sans-serif;
      color: rgba(35, 29, 24, 0.78);
    }
    .desk-hero__meta {
      margin-top: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }
    .desk-pill {
      display: inline-flex;
      align-items: center;
      padding: 0.75rem 1rem;
      border: 1px solid rgba(35, 29, 24, 0.1);
      background: rgba(255,255,255,0.58);
      backdrop-filter: blur(12px);
      font: 500 0.76rem/1 Outfit, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #4b4138;
    }
    .desk-summary {
      position: sticky;
      top: 1.5rem;
      background: #201b17;
      color: #faf6ef;
      border-radius: 26px;
      padding: clamp(1.4rem, 3vw, 2rem);
      box-shadow: 0 28px 80px rgba(32, 27, 23, 0.18);
      overflow: hidden;
    }
    .desk-summary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, rgba(182,148,86,0.22), transparent 40%);
      pointer-events: none;
    }
    .desk-summary > * { position: relative; z-index: 1; }
    .desk-summary__eyebrow {
      margin: 0 0 1rem;
      font: 600 0.7rem/1 Outfit, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: #b69456;
    }
    .desk-summary__title {
      margin: 0 0 1.2rem;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 0.98;
      letter-spacing: -0.03em;
      color: #faf6ef;
    }
    .desk-stack {
      display: grid;
      gap: 0.9rem;
    }
    .desk-card {
      display: block;
      text-decoration: none;
      color: inherit;
      padding: 1rem 1rem 1.05rem;
      border-radius: 18px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.08);
      transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    }
    .desk-card:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,0.09);
      border-color: rgba(182,148,86,0.35);
    }
    .desk-card__label {
      display: block;
      margin-bottom: 0.55rem;
      font: 600 0.68rem/1 Outfit, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: #b69456;
    }
    .desk-card__title {
      display: block;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.55rem;
      line-height: 1;
      margin-bottom: 0.5rem;
    }
    .desk-card__note {
      margin: 0;
      font: 300 0.98rem/1.6 Outfit, sans-serif;
      color: rgba(250,246,239,0.76);
    }
    .preview-section {
      max-width: 1320px;
      margin: 0 auto;
      padding: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 4vw, 2.5rem);
    }
    .preview-head {
      display: flex;
      justify-content: space-between;
      gap: 1.5rem;
      align-items: end;
      margin-bottom: 1.8rem;
    }
    .preview-head h2 {
      margin: 0;
      max-width: 10ch;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(2.3rem, 4vw, 3.7rem);
      line-height: 0.98;
      letter-spacing: -0.03em;
      color: #231d18;
    }
    .preview-head p {
      margin: 0;
      max-width: 42ch;
      font: 300 1rem/1.7 Outfit, sans-serif;
      color: rgba(35, 29, 24, 0.7);
    }
    .route-grid,
    .reads-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
    .route-card,
    .read-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 220px;
      padding: 1.2rem;
      border-radius: 22px;
      text-decoration: none;
      color: #231d18;
      background: rgba(255,255,255,0.62);
      border: 1px solid rgba(35, 29, 24, 0.08);
      box-shadow: 0 12px 32px rgba(35, 29, 24, 0.05);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .route-card:hover,
    .read-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 40px rgba(35, 29, 24, 0.08);
    }
    .route-card__title,
    .read-card__title {
      margin: 0;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2rem;
      line-height: 0.96;
      letter-spacing: -0.03em;
    }
    .route-card__note,
    .read-card__note {
      margin: 0.8rem 0 0;
      font: 300 0.98rem/1.65 Outfit, sans-serif;
      color: rgba(35, 29, 24, 0.72);
    }
    .route-card__foot,
    .read-card__eyebrow {
      font: 600 0.72rem/1 Outfit, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #8b4e3b;
    }
    .read-card--accent {
      background: linear-gradient(180deg, rgba(139,78,59,0.08), rgba(255,255,255,0.74));
    }
    .compare-bar {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }
    .compare-link {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      text-decoration: none;
      padding: 0.95rem 1.15rem;
      border-radius: 999px;
      font: 600 0.76rem/1 Outfit, sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      border: 1px solid rgba(35, 29, 24, 0.1);
      color: #231d18;
      background: rgba(255,255,255,0.65);
    }
    .compare-link--dark {
      background: #201b17;
      color: #faf6ef;
      border-color: #201b17;
    }
    @media (max-width: 1100px) {
      .desk-hero__grid,
      .route-grid,
      .reads-grid {
        grid-template-columns: 1fr;
      }
      .desk-summary { position: relative; top: 0; }
      .preview-head {
        flex-direction: column;
        align-items: start;
      }
    }
  </style>

  <div class="preview-shell">
    <section class="desk-hero">
      <div class="desk-hero__grid">
        <div>
          <div class="desk-hero__kicker">Preview B · Weekend desk</div>
          <h1 class="desk-hero__headline">Start with <em>the plan</em>, not the directory.</h1>
          <p class="desk-hero__dek">This version treats the homepage like an editor’s desk at 8am on a Saturday: one clear move, one backup, and a handful of fast lanes for intent. Less cinematic. More immediately useful.</p>
          <div class="desk-hero__meta">
            <span class="desk-pill">{issueDate} issue</span>
            <span class="desk-pill">Weekly dispatch model</span>
            <span class="desk-pill">Built for quick decisions</span>
          </div>
          <div class="compare-bar">
            <a class="compare-link compare-link--dark" href="/preview-hero/">Open Version A · cinematic editorial</a>
            <a class="compare-link" href="/newsletter/">Open live newsletter flow</a>
          </div>
        </div>

        <aside class="desk-summary" aria-label="Weekend desk preview">
          <p class="desk-summary__eyebrow">Peninsula This Weekend · {weekendLabel}</p>
          <h2 class="desk-summary__title">A homepage that makes a recommendation before it asks for a scroll.</h2>
          <div class="desk-stack">
            {plannerCards.map((card) => (
              <a class="desk-card" href={card.href}>
                <span class="desk-card__label">{card.label}</span>
                <span class="desk-card__title">{card.title}</span>
                <p class="desk-card__note">{card.note}</p>
              </a>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="preview-section">
      <div class="preview-head">
        <div>
          <div class="section-kicker">Quick routes</div>
          <h2>Choose the mood first. Then let the page narrow the Peninsula.</h2>
        </div>
        <p>These are meant to feel like intent doors, not category links. Big targets, short copy, and a strong sense that the site already has an opinion.</p>
      </div>
      <div class="route-grid">
        {routes.map((route) => (
          <a class="route-card" href={route.href}>
            <div>
              <h3 class="route-card__title">{route.title}</h3>
              <p class="route-card__note">{route.note}</p>
            </div>
            <span class="route-card__foot">Open guide →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="preview-section" style="padding-top: 0;">
      <div class="preview-head">
        <div>
          <div class="section-kicker">Priority reads</div>
          <h2>Three pieces that carry the brand without looking like filler.</h2>
        </div>
        <p>The point here is not volume. It’s proving the homepage can elevate a small number of strong editorial calls and make them feel expensive.</p>
      </div>
      <div class="reads-grid">
        {reads.map((read, index) => (
          <a class={`read-card ${index === 0 ? 'read-card--accent' : ''}`} href={read.href}>
            <div>
              <span class="read-card__eyebrow">{read.eyebrow}</span>
              <h3 class="read-card__title">{read.title}</h3>
              <p class="read-card__note">{read.note}</p>
            </div>
          </a>
        ))}
        <a class="read-card" href="/preview-hero/" aria-label="Compare against version A">
          <div>
            <span class="read-card__eyebrow">Comparison</span>
            <h3 class="read-card__title">Version A is the cover. Version B is the desk.</h3>
            <p class="read-card__note">If A feels more like a magazine front page, B is the one that starts converting impatient visitors faster.</p>
          </div>
        </a>
      </div>
    </section>

    <NewsletterBlock
      title="The weekly note that <em>lands with a point of view</em>."
      body="If this homepage direction leans more desk than cover, the newsletter should carry the same tone: one clear recommendation, one backup, and one useful planning note before the weekend starts."
      issueDate={issueDate}
      previewHeadline="This weekend: <em>Red Hill first</em>, then stop trying to do too much."
      previewItems={[
        'The Saturday plan that actually works after the market.',
        'One all-weather backup worth booking before noon.',
        'Where to put the long lunch if the weather holds.',
        'A small traffic note the tourists will miss.'
      ]}
      source="preview-home-b"
    />
  </div>
</BaseLayout>
