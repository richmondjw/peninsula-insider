---
const odooLogin = 'https://peninsula-insider.odoo.com/web/login';
export const prerender = true;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="refresh" content={`0;url=${odooLogin}`} />
    <title>Peninsula Insider CRM sign-in</title>
  </head>
  <body>
    <main>
      <a href={odooLogin}>Continue to Odoo sign-in</a>
    </main>
  </body>
</html>
