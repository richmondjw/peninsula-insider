---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { routeSlug, isStayVenue, wineTypes, isListableVenue } from '../lib/editorial';

const [venues, experiences, places, articles, itineraries, events] = await Promise.all([
  getCollection('venues'),
  getCollection('experiences'),
  getCollection('places'),
  getCollection('articles', ({ data }) => data.status === 'published'),
  getCollection('itineraries'),
  getCollection('events'),
]);

const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];

const activeVenues = venues.filter(isListableVenue);
const eatVenues = activeVenues.filter((v) => eatTypes.includes(v.data.type)).slice(0, 40);
const stayVenues = activeVenues.filter(isStayVenue).slice(0, 20);
const wineVenues = activeVenues.filter((v) => wineTypes.includes(v.data.type)).slice(0, 30);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Site Index' },
];
export const prerender = true;
---

<BaseLayout
  title="Site Index · Peninsula Insider"
  description="A crawlable index of Peninsula Insider sections, guides, places, venues, events, and planning pages."
  canonical="https://peninsulainsider.com.au/site-index"
>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <h1 class="article__title">Site Index</h1>
      <p class="article__dek">A direct index of the major sections and planning pages on Peninsula Insider. Useful for readers, and useful for crawlers.</p>

      <div class="prose">
        <h2>Core sections</h2>
        <ul>
          <li><a href="/eat/">Eat & Drink</a></li>
          <li><a href="/stay/">Stay</a></li>
          <li><a href="/wine/">Wine</a></li>
          <li><a href="/explore/">Explore</a></li>
          <li><a href="/explore/plans/">Plans</a></li>
          <li><a href="/whats-on/">What's On</a></li>
          <li><a href="/journal/">Journal</a></li>
          <li><a href="/explore/places/">Places</a></li>
        </ul>

        <h2>Priority planning pages</h2>
        <ul>
          <li><a href="/eat/best-restaurants/">Best Restaurants</a></li>
          <li><a href="/wine/best-cellar-doors/">Best Cellar Doors</a></li>
          <li><a href="/explore/walks/">Best Walks</a></li>
          <li><a href="/stay/best-accommodation/">Best Accommodation</a></li>
          <li><a href="/journal/mornington-peninsula-day-trip/">Mornington Peninsula Day Trip</a></li>
          <li><a href="/journal/the-spring-peninsula/">Mornington Peninsula in Spring</a></li>
          <li><a href="/journal/mornington-peninsula-with-kids/">Mornington Peninsula with Kids</a></li>
          <li><a href="/journal/dog-friendly-mornington-peninsula/">Dog-Friendly Mornington Peninsula</a></li>
        </ul>

        <h2>Collections and guides</h2>
        <ul>
          <li><a href="/eat/pubs/">Pubs</a></li>
          <li><a href="/eat/breweries/">Breweries</a></li>
          <li><a href="/eat/distilleries/">Distilleries</a></li>
          <li><a href="/eat/providores/">Providores</a></li>
          <li><a href="/eat/paddock-to-plate/">Paddock to Plate</a></li>
          <li><a href="/eat/family-friendly/">Family-Friendly Dining</a></li>
          <li><a href="/stay/resorts/">Resorts</a></li>
          <li><a href="/stay/luxury/">Luxury Stays</a></li>
          <li><a href="/stay/boutique-hotels/">Boutique Hotels</a></li>
          <li><a href="/stay/cottages/">Cottages</a></li>
          <li><a href="/stay/glamping/">Glamping</a></li>
          <li><a href="/guides/">Seasonal Guides</a></li>
          <li><a href="/journal/cellar-door/">Cellar Door Journal</a></li>
          <li><a href="/journal/local-secrets/">Local Secrets</a></li>
          <li><a href="/quick-note/">Quick Notes</a></li>
          <li><a href="/insiders-30/2026/">The Insider's 30, 2026</a></li>
          <li><a href="/explore/plans/mornington-peninsula-itinerary/">Mornington Peninsula Itinerary</a></li>
          <li><a href="/walks/easy-walks-mornington-peninsula/">Easy Walks</a></li>
          <li><a href="/fishing/seasons/snapper-run-oct-dec/">Snapper Season</a></li>
          <li><a href="/weddings/winery-wedding-venues-mornington-peninsula/">Winery Wedding Venues</a></li>
          <li><a href="/corporate-events/best-corporate-retreat-venues-mornington-peninsula/">Corporate Retreat Venues</a></li>
        </ul>

        <h2>Places</h2>
        <ul>
          {places.map((place) => (
            <li><a href={`/explore/places/${routeSlug(place)}/`}>{place.data.name}</a></li>
          ))}
        </ul>

        <h2>Selected Eat & Drink pages</h2>
        <ul>
          {eatVenues.map((venue) => (
            <li><a href={`/eat/${routeSlug(venue)}/`}>{venue.data.name}</a></li>
          ))}
        </ul>

        <h2>Selected Stay pages</h2>
        <ul>
          {stayVenues.map((venue) => (
            <li><a href={`/stay/${routeSlug(venue)}/`}>{venue.data.name}</a></li>
          ))}
        </ul>

        <h2>Selected Wine pages</h2>
        <ul>
          {wineVenues.map((venue) => (
            <li><a href={`/wine/${routeSlug(venue)}/`}>{venue.data.name}</a></li>
          ))}
        </ul>

        <h2>Experiences</h2>
        <ul>
          {experiences.map((entry) => (
            <li><a href={`/explore/${routeSlug(entry)}/`}>{entry.data.name}</a></li>
          ))}
        </ul>

        <h2>Plans</h2>
        <ul>
          {itineraries.map((entry) => (
            <li><a href={`/explore/plans/${routeSlug(entry)}/`}>{entry.data.title}</a></li>
          ))}
        </ul>

        <h2>What's On</h2>
        <ul>
          {events.map((entry) => (
            <li><a href={`/whats-on/${routeSlug(entry)}/`}>{entry.data.title}</a></li>
          ))}
        </ul>

        <h2>Journal</h2>
        <ul>
          {articles.slice(0, 50).map((entry) => (
            <li><a href={`/journal/${routeSlug(entry)}/`}>{entry.data.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>
