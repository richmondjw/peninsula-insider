---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import TourCard from '../../components/TourCard.astro';
import TourPackageCard from '../../components/TourPackageCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { buildTourPackageSchema } from '../../lib/schema';
import { editableText } from '../../lib/inline-edit/attrs';

export async function getStaticPaths() {
  const packages = await getCollection('tourPackages');
  return packages.map((pkg) => ({
    params: { slug: pkg.id ?? pkg.data.slug },
    props: { pkg },
  }));
}

const { pkg } = Astro.props;
const data = pkg.data;
const slug = pkg.id ?? data.slug;

const allTours = await getCollection('tours');
const allOperators = await getCollection('tourOperators');
const operatorMap = Object.fromEntries(allOperators.map(op => [op.data.slug, op.data]));

const componentTours = (data.componentTourSlugs || [])
  .map((tourSlug: string) => allTours.find(t => (t.id ?? t.data.slug) === tourSlug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const allPackages = (await getCollection('tourPackages'))
  .filter(p => (p.id ?? p.data.slug) !== slug)
  .slice(0, 3);

const packageSchema = buildTourPackageSchema(data, componentTours.map(t => t.data));

const occasionLabel: Record<string, string> = {
  'anniversary': 'Anniversary',
  'hens': "Hen's Party",
  'bucks': "Bucks' Party",
  'corporate': 'Corporate',
  'birthday': 'Birthday',
  'family-reunion': 'Family Reunion',
  'school': 'School',
  'general': 'General',
  'winter': 'Winter Escape',
  'foodies': 'Foodies',
};

const audienceLabel: Record<string, string> = {
  'adults': 'Adults',
  'families': 'Families',
  'solo': 'Solo travellers',
  'couples': 'Couples',
  'seniors': 'Seniors',
  'general': 'All guests',
};

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tour Packages', href: '/tour-packages/' },
  { label: data.name },
];
---

<BaseLayout
  title={`${data.name} · Tour Package · Peninsula Insider`}
  description={data.intro}
  section="tour"
  canonical={`https://peninsulainsider.com.au/tour-packages/${slug}/`}
  modifiedTime={data.lastVerified?.toISOString().split('T')[0]}
>
  <script type="application/ld+json" set:html={JSON.stringify(packageSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <SubpageHero
    eyebrow="Tour Packages"
    category={occasionLabel[data.occasion] ?? data.occasion}
    title={data.name}
    heroImage={data.heroImage.src}
    imageAlt={data.heroImage.alt}
    entityType="tour-package"
    entitySlug={slug}
  >
    <div class="prose">
      <p {...editableText({
        entityType: 'tour-package', entitySlug: slug, fieldPath: 'intro',
        label: `${data.name} — intro`,
      })}>{data.intro}</p>
      <p class="venues__sub" style="font-size:0.8rem;color:var(--soft)">Last verified: {data.lastVerified?.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    </div>
  </SubpageHero>

  <section class="experience-index experience-index--plain">
    <div class="container">
      <h2 class="venues__title" style="margin-bottom:1rem">Package overview</h2>
      <div class="at-a-glance">
        {componentTours.length > 0 && (
          <div class="at-a-glance__row">
            <div class="at-a-glance__label">Experiences</div>
            <div class="at-a-glance__value">{componentTours.length} operator-led {componentTours.length === 1 ? 'experience' : 'experiences'}</div>
          </div>
        )}
        {data.anchorStaySlug && (
          <div class="at-a-glance__row">
            <div class="at-a-glance__label">Anchor stay</div>
            <div class="at-a-glance__value">
              <a href={`/stay/${data.anchorStaySlug}/`}>{data.anchorStaySlug.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}</a>
            </div>
          </div>
        )}
        {data.durationNights != null && (
          <div class="at-a-glance__row">
            <div class="at-a-glance__label">Duration</div>
            <div class="at-a-glance__value">{data.durationNights === 0 ? 'Day trip' : `${data.durationNights} nights`}</div>
          </div>
        )}
        {/* Price range row intentionally removed. BRAND-PI rule (2026-05-15):
            "No pricing on site. Ever." Readers book direct with the operator
            for current pricing. */}
        <div class="at-a-glance__row">
          <div class="at-a-glance__label">Suits</div>
          <div class="at-a-glance__value">{audienceLabel[data.audience] ?? data.audience}</div>
        </div>
        <div class="at-a-glance__row">
          <div class="at-a-glance__label">Occasion</div>
          <div class="at-a-glance__value">{occasionLabel[data.occasion] ?? data.occasion}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="experience-index">
    <div class="container">
      <div class="prose">
        <h2>Why this combination works</h2>
        <p>{data.whyThisCombination}</p>
      </div>
    </div>
  </section>

  {componentTours.length > 0 && (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Component tours</p>
            <h2 class="venues__title">What you are booking</h2>
            <p class="venues__sub">Each tour is booked separately, directly with the operator. See the individual tour pages for booking intelligence and availability notes.</p>
          </div>
        </div>
        <div class="tour-grid">
          {componentTours.map((tour) => (
            <TourCard tour={tour} operatorName={operatorMap[tour.data.operatorSlug]?.name} />
          ))}
        </div>
        <div class="tour-grid" style="margin-top:1.5rem">
          {componentTours.map((tour) => {
            const opData = operatorMap[tour.data.operatorSlug];
            const tourSlug = tour.id ?? tour.data.slug;
            const bookingUrl = tour.data.bookingUrl || tour.data.aggregatorGYG;
            if (!bookingUrl) return null;
            const utmUrl = `${bookingUrl}${bookingUrl.includes('?') ? '&' : '?'}utm_source=peninsula-insider&utm_medium=tour-vertical&utm_campaign=${tourSlug}&utm_content=package-cta`;
            return (
              <div class="tour-cta-block">
                <h3 class="tour-cta-block__title">{tour.data.name}</h3>
                <p>Operated by {opData?.name ?? tour.data.operatorSlug}. Book directly with the operator.</p>
                <a href={utmUrl} target="_blank" rel="noopener noreferrer" class="tour-cta-primary">
                  Book this tour &rarr;
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {data.anchorStaySlug && data.anchorStayBlurb && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Anchor stay</p>
            <h2 class="venues__title">Where to base yourself</h2>
          </div>
        </div>
        <div class="venues__grid venues__grid--links">
          <div class="venue-card">
            <h3 class="venue-card__name">
              <a href={`/stay/${data.anchorStaySlug}/`}>
                {data.anchorStaySlug.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}
              </a>
            </h3>
            <p class="venue-card__signature">{data.anchorStayBlurb}</p>
            <a href={`/stay/${data.anchorStaySlug}/`} class="venue-card__cta">View stay notes &rarr;</a>
          </div>
          {data.altStaySlug && (
            <div class="venue-card">
              <h3 class="venue-card__name">
                <a href={`/stay/${data.altStaySlug}/`}>
                  Alternative stay
                </a>
              </h3>
              <p class="venue-card__signature">An alternative base for this package if the anchor property is unavailable.</p>
              <a href={`/stay/${data.altStaySlug}/`} class="venue-card__cta">View stay notes &rarr;</a>
            </div>
          )}
          <div class="venue-card">
            <h3 class="venue-card__name"><a href="/stay/">All Peninsula stays</a></h3>
            <p class="venue-card__signature">Browse the full Peninsula stay guide by location, budget, and mood.</p>
            <a href="/stay/" class="venue-card__cta">Browse stays &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {data.bookingSequence && (
    <section class="experience-index experience-index--plain">
      <div class="container">
        <div class="prose">
          <h2>Booking sequence</h2>
          <p>{data.bookingSequence}</p>
        </div>
      </div>
    </section>
  )}

  {data.faq?.length > 0 && (
    <section class="faq-section">
      <div class="container">
        <div class="prose">
          <h2>Frequently asked questions</h2>
          {data.faq.map((item: { question: string; answer: string }) => (
            <div>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {allPackages.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Related packages</p>
            <h2 class="venues__title">Other curated Peninsula weekends</h2>
          </div>
          <a href="/tour-packages/" class="venues__link">All packages &rarr;</a>
        </div>
        <div class="package-grid">
          {allPackages.map((p) => <TourPackageCard pkg={p} />)}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />
</BaseLayout>
