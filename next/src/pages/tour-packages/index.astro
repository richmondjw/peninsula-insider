---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchAllTourPackagesFromSanity } from '../../lib/sanity/phase5-adapters';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/SectionHero.astro';
import TourPackageCard from '../../components/TourPackageCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const allPackages = (await fetchAllTourPackagesFromSanity())
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Tour Packages' },
];

// "Browse by occasion" chips removed 2026-05-15. The anchor targets
// (#hens, #couples, etc.) never had matching <section id="..."> elements
// rendered on the page, so the chips floated to nowhere. With only 8
// packages total — one per occasion in most cases — the all-packages
// grid below is the more useful surface. If we want occasion filtering
// later, do it properly with grouped sub-sections or a search facet.
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Tour Packages · Peninsula Insider"
  description="Curated multi-experience Peninsula weekends — tours, stays, and cellar doors combined into a single editorial package. Built for couples, hens, corporate groups, and families."
  section="tour"
  canonical="https://peninsulainsider.com.au/tour-packages/"
  modifiedTime="2026-04-29"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Tour Packages"
    title="Tour Packages — <em>Curated multi-experience Peninsula weekends</em>"
    dek="Each package combines verified tours with an editorial stay recommendation. The combination is our call, not a sponsored placement. We explain why each pairing works."
    gradient="sand"
    heroImage="/images/sourced/article-flinders-weekend-01.webp"
  />

  {allPackages.length > 0 ? (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">All packages</p>
            <h2 class="venues__title">{allPackages.length} curated Peninsula {allPackages.length === 1 ? 'package' : 'packages'}</h2>
            <p class="venues__sub">Each package pairs at least one operator-led tour with an anchor stay recommendation. You book each component separately.</p>
          </div>
        </div>
        <div class="package-grid">
          {allPackages.map((pkg) => <TourPackageCard pkg={pkg} />)}
        </div>
      </div>
    </section>
  ) : (
    <section class="experience-index">
      <div class="container">
        <div class="prose">
          <p>Packages are being compiled. In the meantime, <a href="/tour/">browse individual tours</a> or <a href="/plans/">explore itineraries</a>.</p>
        </div>
      </div>
    </section>
  )}

  <section class="experience-index experience-index--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Planning notes</p>
          <h2 class="venues__title">Anchor your stay first</h2>
        </div>
      </div>
      <div class="venues__grid venues__grid--links">
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/stay/">Where to stay</a></h3>
          <p class="venue-card__signature">The right base changes the whole trip. Our stay guide covers the Peninsula's best properties — by location, budget, and mood.</p>
          <a href="/stay/" class="venue-card__cta">Browse stays &rarr;</a>
        </div>
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/tour/">Individual tours</a></h3>
          <p class="venue-card__signature">Browse the full tour catalogue and build your own combination. Each tour listing includes booking intelligence and an honest editorial assessment.</p>
          <a href="/tour/" class="venue-card__cta">Browse tours &rarr;</a>
        </div>
        <div class="venue-card">
          <h3 class="venue-card__name"><a href="/plans/">Self-drive itineraries</a></h3>
          <p class="venue-card__signature">Prefer your own wheels? Our escape itineraries plan the Peninsula in detail without a guide.</p>
          <a href="/plans/" class="venue-card__cta">Browse itineraries &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
