---
/**
 * /escape/ → /plans/ redirect
 *
 * The Plans section was renamed from /escape/ to /plans/ to close the
 * URL/label mismatch (footer + nav already labelled it "Plans"). This
 * page handles inbound /escape/ traffic — old bookmarks, social shares,
 * external backlinks — and forwards to the canonical /plans/ URL.
 *
 * The custom Redirect component fires window.location.replace() in <head>
 * so the browser navigates before first paint. noindex on the redirect
 * page; canonical points at /plans/.
 *
 * See: work/peninsula-insider/strategic-review-v2.md §3 Plans Assessment
 * and §6 SEO Assessment for the rationale.
 */
import Redirect from '../../components/Redirect.astro';
---
<Redirect to="/plans/" />
