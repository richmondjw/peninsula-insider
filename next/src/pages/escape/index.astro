---
/**
 * /escape/ → /explore/plans/ redirect
 *
 * This page handles inbound /escape/ traffic and forwards it to the canonical
 * /explore/plans/ URL.
 *
 * The custom Redirect component fires window.location.replace() in <head>
 * so the browser navigates before first paint. noindex on the redirect
 * page; canonical points at /explore/plans/.
 *
 * See: work/peninsula-insider/strategic-review-v2.md §3 Plans Assessment
 * and §6 SEO Assessment for the rationale.
 */
import Redirect from '../../components/Redirect.astro';
export const prerender = true;
---
<Redirect to="/explore/plans/" consolidate />
