---
/**
 * /explore/plans/[slug] → /explore/plans/[slug] redirect
 *
 * Section rename: /explore/plans/ → /explore/plans/. This dynamic page emits a redirect
 * for every existing /explore/plans/[slug]/ URL so that inbound links from
 * search engines, social shares, and external sites continue to resolve.
 *
 * Each redirect preserves the slug (e.g. /explore/plans/wellness-weekend/ →
 * /explore/plans/wellness-weekend/) and uses the custom Redirect component for
 * a flash-free JS redirect with meta-refresh fallback.
 */
import { getCollection } from 'astro:content';
import { routeSlug } from '../../lib/editorial';
import Redirect from '../../components/Redirect.astro';

export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries');
  return itineraries.map((it) => ({
    params: { slug: routeSlug(it) },
    props: { slug: routeSlug(it) },
  }));
}

const { slug } = Astro.props;
export const prerender = true;
---
<Redirect to={`/explore/plans/${slug}/`} consolidate />
