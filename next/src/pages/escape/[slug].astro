---
/**
 * /escape/[slug] → /plans/[slug] redirect
 *
 * Section rename: /escape/ → /plans/. This dynamic page emits a redirect
 * for every existing /escape/[slug]/ URL so that inbound links from
 * search engines, social shares, and external sites continue to resolve.
 *
 * Each redirect preserves the slug (e.g. /escape/wellness-weekend/ →
 * /plans/wellness-weekend/) and uses the custom Redirect component for
 * a flash-free JS redirect with meta-refresh fallback.
 */
import { fetchAllItinerariesFromSanity } from '../../lib/sanity/itinerary-adapter';

export async function getStaticPaths() {
  const itineraries = await fetchAllItinerariesFromSanity();
  return itineraries.map((it) => ({
    params: { slug: it.slug },
    props: { slug: it.slug },
  }));
}

const { slug } = Astro.props;
const to = `/plans/${slug}/`;
const canonical = `https://peninsulainsider.com.au${to}`;
export const prerender = true;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8">
    <title>Redirecting…</title>
    <style>html,body{display:none;visibility:hidden}</style>
    <script define:vars={{ to }}>window.location.replace(to);</script>
    <meta http-equiv="refresh" content={`0;url=${to}`}>
    <meta name="robots" content="noindex">
    <link rel="canonical" href={canonical}>
  </head>
  <body></body>
</html>
