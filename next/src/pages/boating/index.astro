---
import { pageImage } from '../../lib/page-images';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import BfAnalytics from '../../components/BfAnalytics.astro';
import AskLine from '../../components/v5/AskLine.astro';
import { buildBfHubSchema } from '../../lib/schema';
import { pageProvenance } from '../../lib/page-provenance';
import { BF_EXTERNAL } from '../../lib/bf';

// Every fact on this page comes from the published ramp, hire and charter
// records (src/content/boat-ramps, boat-hire, fishing-charters, and the tidal
// ranges in fishing-locations) or from the cited official sources. The short
// notes below restate record facts; when a record changes, change its note.

const allRamps = await getCollection('boatRamps', ({ data }) => data.status === 'published');
const allHire = await getCollection('boatHire', ({ data }) => data.status === 'published');
const allCharters = await getCollection('fishingCharters', ({ data }) => data.status === 'published');
const pierCount = (await getCollection('fishingLocations', ({ data }) => data.status === 'published' && (data.locationType === 'pier' || data.locationType === 'jetty'))).length;

// PI-004: the stamp is derived from the records this page is about, never
// declared. "Last fact-verified" only when every record has live supporting
// evidence in the claim registry; otherwise the floor of their review dates,
// worded as a review.
const provenance = await pageProvenance(allRamps, 'boat-ramps');
const modifiedISO = provenance.stampISO ?? undefined;
const reviewedOn = provenance.stampISO
  ? new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Melbourne' }).format(new Date(provenance.stampISO))
  : null;

// Geographic order, south-west to north along each shore. Document order,
// not a ranking; any ramp published later is appended in its water.
const RAMP_ORDER = [
  'sorrento-boat-ramp',
  'rye-boat-ramp',
  'safety-beach-boat-ramp',
  'mornington-park-boat-ramp',
  'hastings-boat-ramp',
  'warneet-boat-ramp',
];
const RAMP_NOTES: Record<string, string> = {
  'sorrento-boat-ramp': 'Breakwater shelter and the shortest run to the southern snapper grounds and the Heads.',
  'rye-boat-ramp': 'The biggest car park on the bay side, with about 127 trailer spaces and fish‑cleaning facilities.',
  'safety-beach-boat-ramp': 'Plenty of trailer parking and a picnic ground alongside. Not one for a low-tide arrival.',
  'mornington-park-boat-ramp': 'Central bay shore. The car park is shared with the pier and the yacht club, so it is tight.',
  'hastings-boat-ramp': 'Upgraded in 2024, with an all-abilities hoist on the new southern pontoon. The base for Western Port charters.',
  'warneet-boat-ramp': 'Smaller and quieter, with a central pontoon, for the whiting and flathead grounds of the northern arm.',
};
// Launch windows stated in the ramp records' own text (high water at the ramp's station).
const RAMP_WINDOWS: Record<string, string> = {
  'rye-boat-ramp': '1 to 2 hours either side of high water',
  'safety-beach-boat-ramp': 'About 2 hours either side of high water',
  'warneet-boat-ramp': '2 hours either side of high water for boats over 4.5 m',
};
const BOM_PENINSULA_FORECAST = 'http://www.bom.gov.au/vic/forecasts/mornington-peninsula.shtml';
const TIDE: Record<string, { label: string; low: boolean; mid: boolean; high: boolean }> = {
  'all-tide': { label: 'Any tide', low: true, mid: true, high: true },
  'mid-to-high': { label: 'Mid to high tide', low: false, mid: true, high: true },
  'high-tide-only': { label: 'High tide only', low: false, mid: false, high: true },
  'tidal-extreme': { label: 'Check the tide first', low: false, mid: false, high: true },
};
const PRESSURE: Record<string, string> = { high: 'High', medium: 'Medium', low: 'Low' };

const ordered = [
  ...RAMP_ORDER.map((slug) => allRamps.find((r) => r.data.slug === slug)).filter((r) => r !== undefined),
  ...allRamps.filter((r) => !RAMP_ORDER.includes(r.data.slug)),
];
const WATERS = [
  { key: 'port-phillip-bay', name: 'Port Phillip Bay', station: 'Portsea', note: 'Calmer water and a small tidal range.' },
  { key: 'western-port', name: 'Western Port', station: 'Stony Point', note: 'Strongly tidal. Time your launch and your return.' },
].map((w) => ({ ...w, ramps: ordered.filter((r) => r.data.region === w.key) }))
 .filter((w) => w.ramps.length > 0);
const anyTideCount = allRamps.filter((r) => r.data.tideDependence === 'all-tide').length;

const CHARTER_ORDER = ['proline-charters', 'western-port-fishing-charters', 'im-hooked-fishing-charters', 'reel-time-fishing-charters'];
const CHARTER_NOTES: Record<string, string> = {
  'proline-charters': 'From Sorrento Pier since 1991, on two of the largest charter boats in Victoria.',
  'western-port-fishing-charters': 'A 15-metre (50-foot) flybridge out of Westernport Marina at Hastings. Western Port only.',
  'im-hooked-fishing-charters': 'A 7-metre (24-foot) catamaran from several Peninsula ramps. Wheelchair-accessible.',
  'reel-time-fishing-charters': 'Two trailer boats from several Peninsula ramps. Suits groups of 11 to 18.',
};
const charters = [
  ...CHARTER_ORDER.map((slug) => allCharters.find((c) => c.data.slug === slug)).filter((c) => c !== undefined),
  ...allCharters.filter((c) => !CHARTER_ORDER.includes(c.data.slug)),
];
const hire = allHire.find((h) => h.data.slug === 'mornington-boat-hire') ?? allHire[0];

const trustLead = `Public ramps, all free to launch.${reviewedOn ? ` ${provenance.stampLabel} ` : ''}`;

const hero = pageImage('boating-hero');
const pier = pageImage('boating-pier');
const heroBase = hero.src.replace(/\.webp$/, '');
const pierBase = pier.src.replace(/\.webp$/, '');

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Boating' },
];

const hubSchema = buildBfHubSchema({
  name: 'Boating on the Mornington Peninsula',
  description:
    'Public boat ramps, self-drive hire, skippered charters, tides and safety on the Mornington Peninsula, checked against the ramp records and official sources.',
  path: '/boating/',
  dateModified: modifiedISO,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Boating' },
  ],
  items: [
    ...ordered.map((r) => ({
      name: r.data.name,
      path: `/boating/ramps/${r.data.slug}/`,
      description: r.data.intro,
      itemType: 'Place',
    })),
    ...allHire.map((h) => ({
      name: h.data.name,
      path: `/boating/hire/${h.data.slug}/`,
      description: h.data.intro,
      itemType: 'LocalBusiness',
    })),
  ],
});

export const prerender = true;
---

<BaseLayout
  title="Boating on the Mornington Peninsula · Peninsula Insider"
  description="Where to launch on the Mornington Peninsula, which ramps work at low tide, where to hire a boat without a licence, and the checks to make before you go out."
  section="boating"
  canonical="https://peninsulainsider.com.au/boating/"
  ogImage={pageImage('boating-hub').src}
  modifiedTime={modifiedISO}
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <section class="bh-cover container" aria-labelledby="bh-title">
    <div class="bh-cover__panel">
      <div class="bh-cover__text">
        <h1 class="bh-cover__title" id="bh-title">Boating the Mornington Peninsula</h1>
        <p class="bh-cover__dek">
          Two coastlines, two very different tides. Pick the ramp that suits the water today,
          or leave the trailer at home and hire a boat or go out with a skipper.
        </p>
        <div class="bh-cover__actions">
          <a class="bh-cover__primary" href="#ramps">Find a ramp</a>
          <a class="bh-cover__secondary" href="#no-boat">No boat? Hire or charter</a>
        </div>
        <p class="bh-cover__trust">
          {trustLead}{reviewedOn && <span class="nowrap">{reviewedOn}.</span>}
        </p>
      </div>
      <figure class="bh-cover__media">
        <img
          src={hero.src}
          srcset={`${heroBase}-800.webp 800w, ${heroBase}-1280.webp 1280w, ${hero.src} 2000w`}
          sizes="(min-width: 1100px) 58vw, 100vw"
          width="2000"
          height="1333"
          alt={hero.alt}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <figcaption class="bh-cover__caption">
          <span>{hero.caption}</span>
          <span>Photo · {hero.credit}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bh-ramps" id="ramps" aria-labelledby="ramps-title">
    <div class="container">
      <div class="bh-head">
        <h2 id="ramps-title">Choose your ramp</h2>
        <p class="bh-head__dek">
          The ramps in this guide are free to launch. The tide decides more than the drive does:
          {anyTideCount} work at any tide, the rest need the water up. Heading for the Heads?
          Read <a class="bh-inline" href="#before-you-launch">Before you launch</a> first.
        </p>
      </div>

      {WATERS.map((water) => (
        <section class="bh-water" aria-labelledby={`water-${water.key}`}>
          <div class="bh-water__head">
            <h3 id={`water-${water.key}`}>{water.name}</h3>
            <p>
              {water.note} Tide station: <strong>{water.station}</strong>.
              <a class="bh-tides" href={BF_EXTERNAL.bom} rel="external" data-bf-event="bf_tide_lookup" data-bf-source="hub-boating-chooser">Tide predictions<span class="sr-only"> on the Bureau of Meteorology site; choose {water.station} for {water.name}</span> <span aria-hidden="true">↗</span></a>
            </p>
          </div>
          <div class="bh-cols" aria-hidden="true">
            <span>Ramp</span><span>Launch at</span><span>Lanes</span><span>Parking pressure</span>
          </div>
          <ul class="bh-ramplist" role="list">
            {water.ramps.map((ramp) => {
              const t = TIDE[ramp.data.tideDependence] ?? TIDE['tidal-extreme'];
              return (
                <li class="bh-ramp">
                  <div class="bh-ramp__name">
                    <h4><a class="bh-link" href={`/boating/ramps/${ramp.data.slug}/`}>{ramp.data.name.replace(/ Boat Ramp$/, '')}</a></h4>
                    {RAMP_NOTES[ramp.data.slug] && <p>{RAMP_NOTES[ramp.data.slug]}</p>}
                  </div>
                  <dl class="bh-ramp__facts">
                    <div class="bh-fact bh-fact--tide">
                      <dt>Launch at</dt>
                      <dd>
                        <svg class="bh-gauge" viewBox="0 0 14 30" width="14" height="30" aria-hidden="true" focusable="false">
                          <rect x="1" y="1" width="12" height="8.5" rx="2" class={t.high ? 'on' : 'off'} />
                          <rect x="1" y="10.75" width="12" height="8.5" rx="2" class={t.mid ? 'on' : 'off'} />
                          <rect x="1" y="20.5" width="12" height="8.5" rx="2" class={t.low ? 'on' : 'off'} />
                        </svg>
                        <span>
                          {t.label}
                          {RAMP_WINDOWS[ramp.data.slug] && <span class="bh-window">{RAMP_WINDOWS[ramp.data.slug]}</span>}
                        </span>
                      </dd>
                    </div>
                    {ramp.data.laneCount && (
                      <div class="bh-fact">
                        <dt>Lanes</dt>
                        <dd>{ramp.data.laneCount}</dd>
                      </div>
                    )}
                    {ramp.data.parkingPressure && (
                      <div class="bh-fact">
                        <dt>Parking pressure</dt>
                        <dd>{PRESSURE[ramp.data.parkingPressure]}</dd>
                      </div>
                    )}
                  </dl>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      <div class="bh-source">
        <p>
          Parking pressure is our own rating. Lanes and tide access are checked against
          <a href={BF_EXTERNAL.betterBoating} rel="external">Better Boating Victoria</a> and the
          <a href={BF_EXTERNAL.mornpenShire} rel="external">Mornington Peninsula Shire</a>.
        </p>
        <a class="bh-link bh-more" href="/boating/ramps/">Every ramp in detail <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="bh-noboat" id="no-boat" aria-labelledby="noboat-title">
    <div class="container">
      <h2 id="noboat-title">No boat? Hire one, or go with a skipper</h2>
      <figure class="bh-noboat__photo">
        <img
          src={pier.src}
          srcset={`${pierBase}-800.webp 800w, ${pier.src} 1280w`}
          sizes="(min-width: 1280px) 1280px, 100vw"
          width="1280"
          height="854"
          alt={pier.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="bh-caption">
          <span>{pier.caption}</span>
          <span>Photo · {pier.credit}</span>
        </figcaption>
      </figure>
    </div>
    <div class="container bh-noboat__grid">
      <div class="bh-noboat__body">
        {hire && (
          <div class="bh-option">
            <h3>Self-drive hire</h3>
            <p class="bh-option__lead">
              <a class="bh-inline" href={`/boating/hire/${hire.data.slug}/`}>{hire.data.name}</a> runs tinnies and
              polycraft for the protected bay from {hire.data.departurePoint}.
              {!hire.data.licenceRequired && ' No marine licence needed.'}
            </p>
            <p class="bh-option__meta">
              The boats stay in the mid-bay, roughly Mount Martha to Dromana, and never go near the
              Rip. Expect a same-day cancellation if a strong southerly is forecast.
              {hire.data.seasonalityNote && ' Open year-round when the weather allows; book ahead in the summer holidays and on long weekends.'}
            </p>
          </div>
        )}

        <div class="bh-option">
          <h3>Fish from a pier</h3>
          <p class="bh-option__lead">
            No boat at all? Our <a class="bh-inline" href="/fishing/locations/">fishing spots guide</a> covers
            Piers and jetties, with tide notes for each and any current closure.
          </p>
        </div>
      </div>

      <div class="bh-option bh-option--charters">
          <h3>Skippered fishing charters</h3>
          <p class="bh-option__lead">The skipper handles the boat and finds the fish. These four are reviewed in our fishing guide.</p>
          <ul class="bh-charters" role="list">
            {charters.map((c) => (
              <li>
                <a class="bh-link" href={`/fishing/charters/${c.data.slug}/`}>{c.data.name}</a>
                {CHARTER_NOTES[c.data.slug] && <p>{CHARTER_NOTES[c.data.slug]}</p>}
              </li>
            ))}
          </ul>
      </div>
    </div>
  </section>

  <section class="bh-safety" id="before-you-launch" aria-labelledby="safety-title">
    <div class="container">
      <h2 id="safety-title">Before you launch</h2>
    </div>
    <div class="container bh-safety__grid">
      <div class="bh-safety__lead">
        <p class="bh-safety__rip">
          <strong>Respect the Rip.</strong> South and south-westerly swell running into Port
          Phillip Heads stands up into dangerous waves. Do not cross in unsuitable conditions,
          whatever the size of your boat or your experience.
        </p>
        <ol class="bh-checks">
          <li>
            <h3>Read the forecast twice</h3>
            <p>
              Check the <a href={BOM_PENINSULA_FORECAST} rel="external">Bureau of Meteorology forecast for the Peninsula</a>,
              wind included, the night before and again on the morning you go.
            </p>
          </li>
          <li>
            <h3>Use the right tide station</h3>
            <p>
              Portsea for the Peninsula's bay ramps, Stony Point for Western Port. Heading up the
              bay towards Melbourne, switch to Port Melbourne.
              <a href={BF_EXTERNAL.willyweather} rel="external" data-bf-event="bf_tide_lookup" data-bf-source="hub-boating">Willyweather</a> and
              the <a href={BF_EXTERNAL.bom} rel="external" data-bf-event="bf_tide_lookup" data-bf-source="hub-boating">Bureau</a> both publish them.
            </p>
          </li>
          <li>
            <h3>Know your second ramp</h3>
            <p>Pick an alternative before you leave home, in case the first is full or the tide turns against you.</p>
          </li>
        </ol>
        <a class="bh-safety__more" href="/boating/tides-safety/">Tides and safety in full <span aria-hidden="true">→</span></a>
      </div>

      <figure class="bh-range" aria-labelledby="range-title">
        <figcaption id="range-title">
          <span class="bh-range__title">How far the water moves</span>
          <span class="bh-range__sub">Typical rise and fall between low and high tide</span>
        </figcaption>
        <svg viewBox="0 0 360 214" width="360" height="214" role="img" aria-labelledby="range-desc" focusable="false">
          <desc id="range-desc">Port Phillip Bay rises and falls about 0.5 to 1.0 metres. Western Port rises and falls about 2.5 to 2.8 metres, several times as much.</desc>
          <g class="bh-range__grid">
            <line x1="40" x2="350" y1="180" y2="180" />
            <line x1="40" x2="350" y1="130" y2="130" />
            <line x1="40" x2="350" y1="80" y2="80" />
            <line x1="40" x2="350" y1="30" y2="30" />
          </g>
          <g class="bh-range__axis">
            <text x="32" y="184">0 m</text>
            <text x="32" y="134">1 m</text>
            <text x="32" y="84">2 m</text>
            <text x="32" y="34">3 m</text>
          </g>
          <rect class="bh-range__bar" x="54" y="155" width="52" height="25" rx="4" />
          <rect class="bh-range__max" x="54.75" y="130.75" width="50.5" height="23.5" rx="4" />
          <rect class="bh-range__bar" x="206" y="55" width="52" height="125" rx="4" />
          <rect class="bh-range__max" x="206.75" y="40.75" width="50.5" height="13.5" rx="4" />
          <text class="bh-range__val" x="114" y="148">0.5 to 1.0 m</text>
          <text class="bh-range__val" x="266" y="56">2.5 to 2.8 m</text>
          <text class="bh-range__name" x="80" y="204">Port Phillip Bay</text>
          <text class="bh-range__name" x="232" y="204">Western Port</text>
        </svg>
        <p class="bh-range__note">
          The dashed top of each bar is the spread between a small tide and a big one. Western
          Port's bigger tide changes channel depth and ramp access through the day, which is why
          Warneet wants the upper half of the tide.
        </p>
      </figure>
    </div>
  </section>

  <AskLine
    id="boating-ask"
    dek="Ask which ramp suits tomorrow's tide, or where to take the kids out for a first go."
    placeholder="A low-tide ramp near Sorrento"
  />

  <NewsletterBlock />
</BaseLayout>

<script>
  // The corner "Ask PI" launcher steps aside while the cover is on screen, so it
  // never sits over the cover's text or actions (same pattern as HomeCover).
  let coverSeen: IntersectionObserver | null = null;
  function watchBoatingCover() {
    coverSeen?.disconnect();
    document.documentElement.classList.remove('pi-hero-ask');
    const cover = document.querySelector('.bh-cover');
    if (!cover || !('IntersectionObserver' in window)) return;
    coverSeen = new IntersectionObserver(([e]) => document.documentElement.classList.toggle('pi-hero-ask', e.isIntersecting));
    coverSeen.observe(cover);
  }
  document.addEventListener('astro:page-load', watchBoatingCover);
</script>

<style>
  /* Type uses only the fs tokens: 800 page title, 700 sections, 600 sub-sections,
     500 deks and item names, 400 body, 300 supporting, 200 captions, 100 labels. */

  /* Cover: one navy panel, text left, photograph right; stacked on mobile. */
  .bh-cover { margin-top: var(--space-5); }
  .bh-cover__panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    background: var(--harbour-deep);
    color: var(--white);
    border-radius: var(--radius-m);
    overflow: hidden;
    min-height: clamp(30rem, 58vh, 38rem);
  }
  .bh-cover__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
    padding: var(--space-8) var(--space-7);
  }
  .bh-cover__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-800);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--white);
    text-wrap: balance;
    max-width: 12ch;
  }
  .bh-cover__dek {
    margin: 0;
    font-size: var(--fs-500);
    line-height: var(--lh-dek);
    color: rgba(255, 255, 255, 0.9);
    max-width: 34ch;
    text-wrap: pretty;
  }
  .bh-cover__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .bh-cover__primary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-s);
    background: var(--sand);
    color: var(--harbour-deep);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-400);
    text-decoration: none;
    transition: background-color var(--dur-med) var(--ease-enter);
  }
  .bh-cover__primary:hover { background: var(--white); }
  .bh-cover__secondary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--white);
    font-weight: var(--fw-medium);
    font-size: var(--fs-400);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: rgba(255, 255, 255, 0.55);
  }
  .bh-cover__secondary:hover { text-decoration-color: var(--sand); }
  .bh-cover__primary:focus-visible,
  .bh-cover__secondary:focus-visible { outline: 2px solid var(--sand); outline-offset: 3px; }
  .bh-cover__trust {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: var(--fs-300);
    font-weight: var(--fw-medium);
    color: rgba(255, 255, 255, 0.9);
  }
  .nowrap { white-space: nowrap; }
  .bh-cover__media { position: relative; margin: 0; min-height: 100%; }
  .bh-cover__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 70%;
  }
  .bh-cover__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 var(--space-3);
    padding: var(--space-7) var(--space-5) var(--space-3);
    background: linear-gradient(to top, rgba(11, 46, 74, 0.86), rgba(11, 46, 74, 0));
    font-size: var(--fs-200);
    line-height: 1.5;
    color: var(--white);
  }

  .bh-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: var(--space-2) 0 0;
    font-size: var(--fs-200);
    line-height: 1.5;
    color: var(--muted);
  }

  /* One record-link style for ramps, hire, charters and onward routes. */
  .bh-link {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    color: var(--harbour);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--harbour) 35%, transparent);
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }
