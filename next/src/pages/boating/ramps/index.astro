---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHero from '../../../components/SectionHero.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import BfAnalytics from '../../../components/BfAnalytics.astro';
import { buildBfHubSchema } from '../../../lib/schema';
import { REGION_LABEL, formatVerifiedStamp, BF_EXTERNAL } from '../../../lib/bf';

const lastVerifiedISO = '2026-04-30';
const lastVerifiedStamp = formatVerifiedStamp(lastVerifiedISO);

const allRamps = await getCollection('boatRamps', ({ data }) => data.status === 'published');
const grouped = {
  'port-phillip-bay': allRamps.filter((r) => r.data.region === 'port-phillip-bay'),
  'western-port': allRamps.filter((r) => r.data.region === 'western-port'),
};

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Boating', href: '/boating/' },
  { label: 'Boat ramps' },
];

const hubSchema = buildBfHubSchema({
  name: 'Mornington Peninsula boat ramps',
  description:
    'Boat ramps on the Mornington Peninsula. Tide dependence, parking pressure, lane count, fee, and the ramp to use when this one is full.',
  path: '/boating/ramps/',
  dateModified: lastVerifiedISO,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Boating', path: '/boating/' },
    { name: 'Boat ramps' },
  ],
  items: allRamps.map((r) => ({
    name: r.data.name,
    path: `/boating/ramps/${r.data.slug}/`,
    description: r.data.intro,
    itemType: 'Place',
  })),
});

export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula boat ramps · Peninsula Insider"
  description="Every Peninsula boat ramp ranked by use case. Tide dependence, parking pressure, lanes, fees, and the alternative when it's full."
  section="boating"
  canonical="https://peninsulainsider.com.au/boating/ramps/"
  modifiedTime={lastVerifiedISO}
>
  <script type="application/ld+json" set:html={JSON.stringify(hubSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Boating · Ramps"
    title="Peninsula boat ramps, <em>by use case</em>"
    dek="Every metadata-only ramp directory tells you the lane count and the postcode. This one tells you whether you can launch at low tide and whether you'll get a park on Saturday morning."
    gradient="vineyard"
  entitySlug="boating-ramps"
  />

  <p class="affiliate-disclosure container">
    Tide guidance is editorial framing. Always check live conditions at
    <a href={BF_EXTERNAL.willyweather} rel="external" data-bf-event="bf_tide_lookup" data-bf-source="hub-ramps">Willyweather</a>
    or <a href={BF_EXTERNAL.bom} rel="external" data-bf-event="bf_tide_lookup" data-bf-source="hub-ramps">the Bureau of Meteorology</a>
    for the relevant reference station before driving with a boat on the
    trailer.
  </p>

  {Object.entries(grouped).every(([, items]) => items.length === 0) ? (
    <section class="experience-index">
      <div class="container prose">
        <p>Ramp pages are being prepared. Six ramp profiles ship in the next wave: Safety Beach, Sorrento, Rye, Mornington Park, Hastings, and Warneet.</p>
      </div>
    </section>
  ) : (
    Object.entries(grouped).map(([region, items]) => items.length > 0 ? (
      <section class="experience-index">
        <div class="container">
          <div class="venues__header">
            <div>
              <p class="label label--accent">{REGION_LABEL[region as keyof typeof REGION_LABEL]}</p>
              <h2 class="venues__title">{items.length} {items.length === 1 ? 'ramp' : 'ramps'}</h2>
            </div>
          </div>
          <div class="venues__grid venues__grid--links">
            {items.map((r) => (
              <article class="pi-card"><div class="pi-card__body">
                <h3 class="pi-card__title">
                  <a href={`/boating/ramps/${r.data.slug}/`}>{r.data.name}</a>
                </h3>
                <p class="pi-card__meta">
                  {r.data.laneCount ? `${r.data.laneCount} lane${r.data.laneCount === 1 ? '' : 's'}` : 'Lanes [VERIFY]'}
                  {' · '}
                  {r.data.tideDependence === 'all-tide' ? 'All-tide' : r.data.tideDependence === 'high-tide-only' ? 'High-tide only' : r.data.tideDependence === 'mid-to-high' ? 'Mid–high tide' : 'Tidal extreme'}
                  {r.data.fee ? ` · ${r.data.fee}` : ''}
                </p>
                <p class="pi-card__dek">{r.data.intro}</p>
                <div class="pi-card__actions"><a href={`/boating/ramps/${r.data.slug}/`} class="pi-btn pi-btn--solid">Ramp guide &rarr;</a></div>
              </div></article>
            ))}
          </div>
        </div>
      </section>
    ) : null)
  )}

  <NewsletterBlock />
</BaseLayout>
