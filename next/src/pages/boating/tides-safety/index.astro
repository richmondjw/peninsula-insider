---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHero from '../../../components/SectionHero.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import BfAnalytics from '../../../components/BfAnalytics.astro';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqSchema, PUBLISHER_LOGO_URL } from '../../../lib/schema';
import { BF_EXTERNAL, formatVerifiedStamp } from '../../../lib/bf';

const lastVerifiedISO = '2026-11-20';
const lastVerifiedStamp = formatVerifiedStamp(lastVerifiedISO);
const path = '/boating/tides-safety/';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Boating', href: '/boating/' },
  { label: 'Tides and safety' },
];

const articleSchema = buildArticleSchema({
  headline: 'Tides, weather and safety on Port Phillip Bay and Western Port',
  description:
    'Pre-trip planning for Peninsula boating: tidal range and reference stations, the Rip at Port Phillip Heads, marine forecasts, return-to-ramp planning, and the species-tide editorial table.',
  path,
  datePublished: lastVerifiedISO,
  dateModified: lastVerifiedISO,
  imageUrl: PUBLISHER_LOGO_URL,
  publisherLogoUrl: PUBLISHER_LOGO_URL,
  articleSection: 'Boating',
});

const faq = [
  { q: 'How do Port Phillip Bay and Western Port differ?', a: 'Port Phillip Bay has a smaller tidal range than Western Port. The practical effect is that current at Western Port ramps and channels can be substantially faster, and ramps like Warneet and Tooradin need more care around low water. Use the BOM-listed station shown for the ramp: Rosebud Jetty, Mornington, or Western Port (Stony Point).' },
  { q: 'How do I check tides for the Peninsula?', a: 'Use BOM tidal predictions and select a station that appears in its current Victorian list: Rosebud Jetty for Sorrento and Rye, Mornington for Safety Beach and Mornington, Western Port (Stony Point) for Hastings and Warneet, or Flinders Jetty for Flinders. Confirm local ramp conditions before launching.' },
  { q: 'What is the Rip and why does it matter?', a: 'The Rip is the tidal passage between Point Nepean and Queenscliff at the entrance of Port Phillip Bay. Strong tidal currents combined with south or south-westerly swell create dangerous standing waves. The Rip is one of Australia\'s most dangerous tidal passages for small vessels. Do not attempt to cross in unsuitable conditions regardless of vessel size or experience. Boats departing Sorrento Boat Ramp or operating in the southern bay must stay well clear of the channel.' },
  { q: 'What pre-trip checks should I do before a session?', a: 'Tide forecast for the relevant reference station. Marine wind and swell forecast (BOM Marine Forecasts for Victoria). The location of your nearest alternative ramp in case conditions deteriorate. Vehicle check (fuel, lights, trailer secure). Vessel check (battery, fuel, safety equipment, EPIRB if offshore). Weather is checked the night before and again on the morning of the trip; conditions on Port Phillip Bay can change quickly with afternoon sea breezes from the north-west in summer and southerly change fronts in spring.' },
  { q: 'What safety equipment must I carry?', a: 'Requirements depend on vessel size and operating area. Carry a correctly fitted lifejacket for every person and check Safe Transport Victoria before departure for the current carriage and wearing rules. Children under 12 must wear a lifejacket whenever a vessel is underway.' },
];
const faqSchema = buildFaqSchema(faq);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Boating', url: 'https://peninsulainsider.com.au/boating/' },
  { name: 'Tides and safety', url: `https://peninsulainsider.com.au${path}` },
]);
export const prerender = true;
---

<BaseLayout
  title="Tides, weather and safety · Peninsula Insider"
  description="Pre-trip planning for Peninsula boating: tidal range and reference stations, the Rip at Port Phillip Heads, marine forecasts, return-to-ramp planning, and species-tide editorial."
  section="boating"
  canonical={`https://peninsulainsider.com.au${path}`}
  modifiedTime={lastVerifiedISO}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <BfAnalytics />

  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Boating"
    title="Tides, weather, and safety on the <em>Peninsula</em>"
    dek="Pre-trip planning for Port Phillip Bay and Western Port. The reference stations to use, the conditions to read, the alternatives to know about. The kind of session that does not feature in the news is the one that started with the right pre-trip check."
    gradient="vineyard"
  entitySlug="boating-tides-safety"
  />

  <article class="venue-detail boating-detail" data-bf-article>
    <div class="container">
      <div class="prose">
        <p class="prose__verified">Last fact-verified {lastVerifiedStamp}.</p>

        <h2>Tidal range, by water body</h2>
        <p>
          Port Phillip Bay has a smaller tidal range than Western Port. Western Port's stronger tidal movement directly
          affects channel depth, ramp access, and fish behaviour. The two systems demand different pre-trip thinking;
          use the current BOM-listed station shown for the ramp rather than a legacy station name.
        </p>

        <h3>Port Phillip Bay reference stations</h3>
        <ul>
          <li><strong>Rosebud Jetty</strong> for the southern bay ramps in this guide (Sorrento and Rye).</li>
          <li><strong>Mornington</strong> for Mornington and Safety Beach.</li>
        </ul>

        <h3>Western Port reference station</h3>
        <ul>
          <li><strong>Western Port (Stony Point)</strong> for Hastings and Warneet. BOM also lists Flinders Jetty, Tooradin, Cowes Jetty and San Remo; choose the station closest to your actual route.</li>
        </ul>

        <p>
          Look up tides at <a class="boating-action-link" href={BF_EXTERNAL.willyweather} rel="external" data-bf-event="bf_tide_lookup" data-bf-source="pillar-tides-safety">Willyweather</a>
          or <a class="boating-action-link" href={BF_EXTERNAL.bom} rel="external" data-bf-event="bf_tide_lookup" data-bf-source="pillar-tides-safety">the Bureau of Meteorology</a>.
          The night before and morning of every trip.
        </p>

        <h2>The Rip at Port Phillip Heads</h2>
        <p>
          The Rip, the tidal passage between Point Nepean and Queenscliff, is one of Australia's most dangerous
          tidal passages for small vessels. South and south-westerly swell entering on a strong ebb tide creates
          standing waves that have killed experienced operators on adequate vessels. <strong>Do not attempt to cross
          the Rip in unsuitable conditions regardless of vessel size or experience.</strong> Boats departing Sorrento
          must stay well clear of the channel.
        </p>

        <h2>Marine forecasts</h2>
        <p>
          Read the Bureau of Meteorology local waters forecast for
          <a class="boating-action-link" href={BF_EXTERNAL.bomPortPhillip} rel="external">Port Phillip</a> or
          <a class="boating-action-link" href={BF_EXTERNAL.bomWesternPort} rel="external">Western Port</a>. It covers wind, weather and seas.
          Check it the night before and again on the morning of your trip because conditions can change quickly. Check
          <a class="boating-action-link" href={BF_EXTERNAL.maritimeSafety} rel="external">Safe Transport Victoria</a> for current safety
          notices and licensing requirements.
        </p>

        <h2>Lifejackets and licensing</h2>
        <p>
          Carry a correctly fitted lifejacket for every person. On a powered vessel up to and including 4.8 metres,
          everyone in an open area must wear the specified lifejacket while underway. On powered vessels over 4.8 metres
          and under 12 metres, it must be worn in heightened-risk situations. Children under 12 must wear one in an open
          area whenever the vessel is underway. Port Phillip Heads, within three nautical miles of Point Lonsdale, is a
          designated hazardous area where everyone on vessels under 12 metres must wear one. Check the current
          <a class="boating-action-link" href={BF_EXTERNAL.safeTransportLifejackets} rel="external">lifejacket rules</a>
          before departure. For hire-and-drive boats, a marine licence is required when the vessel is capable of more
          than 10 knots; the owner must brief hirers on the vessel's operating requirements. See
          <a class="boating-action-link" href={BF_EXTERNAL.safeTransportLicensing} rel="external">Safe Transport Victoria's licensing guidance</a>.
        </p>

        <h2>Return-to-ramp planning</h2>
        <p>
          Before you launch, identify your nearest alternative ramp in case conditions deteriorate. A boat that
          cannot safely return to its launch ramp needs an alternative. This is not hypothetical; it is a basic
          pre-trip planning step. Useful alternative pairings:
        </p>
        <ul>
          <li><a class="boating-action-link" href="/boating/ramps/safety-beach-boat-ramp/">Safety Beach</a> → check <a class="boating-action-link" href="/boating/ramps/mornington-park-boat-ramp/">Mornington Park</a> or <a class="boating-action-link" href="/boating/ramps/sorrento-boat-ramp/">Sorrento</a>.</li>
          <li><a class="boating-action-link" href="/boating/ramps/sorrento-boat-ramp/">Sorrento</a> → check <a class="boating-action-link" href="/boating/ramps/rye-boat-ramp/">Rye</a>.</li>
          <li><a class="boating-action-link" href="/boating/ramps/warneet-boat-ramp/">Warneet</a> → check <a class="boating-action-link" href="/boating/ramps/hastings-boat-ramp/">Hastings</a>.</li>
        </ul>
        <p>These are geographic pairings, not live suitability endorsements. Recheck tide, weather, maintenance and ramp access for both locations before departure.</p>

        <h2>Species and tide</h2>
        <p>
          The reason tide matters for boating on the Peninsula is that fishing on the Peninsula is overwhelmingly
          tide-driven. The editorial summary by species:
        </p>
        <table>
          <thead><tr><th>Species</th><th>Tide preference</th><th>Best window</th></tr></thead>
          <tbody>
            <tr><td><a href="/fishing/species/snapper/">Snapper</a></td><td>Building tide, dawn or dusk</td><td>2 hours either side of high water</td></tr>
            <tr><td><a href="/fishing/species/king-george-whiting/">King George whiting</a></td><td>Running tide, ideally rising</td><td>Mid-tide on the run; "no run no fun"</td></tr>
            <tr><td><a href="/fishing/species/squid/">Southern calamari</a></td><td>Mild current, dusk and night</td><td>30 minutes either side of sunset</td></tr>
            <tr><td><a href="/fishing/species/australian-salmon/">Australian salmon</a></td><td>Incoming tide on surf beaches</td><td>2 hours either side of high water</td></tr>
            <tr><td><a href="/fishing/species/gummy-shark/">Gummy shark</a></td><td>Moving tide, low light</td><td>Dawn, dusk, or night</td></tr>
          </tbody>
        </table>

        <h2>Frequently asked questions</h2>
        {faq.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))}

        <h2>Related</h2>
        <ul>
          <li><a class="boating-action-link" href="/boating/">Boating hub</a></li>
          <li><a class="boating-action-link" href="/boating/ramps/">All Peninsula boat ramps</a></li>
          <li><a class="boating-action-link" href="/boating/hire/">Boat hire</a></li>
          <li><a class="boating-action-link" href="/fishing/charters/first-charter-guide/">First-charter guide</a></li>
        </ul>

        <p class="boating-correction">
          <strong>Seen something change?</strong>
          <a href={`/contact/?type=correction&page=${encodeURIComponent(path)}&message=${encodeURIComponent('Something has changed in the boating safety, access or tide guidance.')}`}>Report changed safety, access or tide information.</a>
        </p>
      </div>
    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>
