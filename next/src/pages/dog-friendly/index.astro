---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { editableText } from '../../lib/inline-edit/attrs';
import { resolveEditableImage } from '../../lib/inline-edit/overrides';

const dogHero = await resolveEditableImage({
  entityType: 'page',
  entitySlug: 'dog-friendly',
  fieldPath: 'hero',
  label: 'Dog-Friendly — hero image',
  purpose: 'hero',
  fallbackSrc: '/images/sourced/dog-beach-emma-01.webp',
  fallbackAlt: 'Dog-Friendly Peninsula',
});

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Dog-Friendly' },
];

const hubCards = [
  {
    title: 'Dog-Friendly Beaches',
    href: '/journal/dog-friendly-beaches-mornington-peninsula',
    dek: 'Where the dog can actually go, when leash rules change, and which beaches are worth the effort.',
  },
  {
    title: 'Dog-Friendly Cafés, Pubs and Wineries',
    href: '/journal/dog-friendly-cafes-pubs-wineries-mornington-peninsula',
    dek: 'The places that genuinely work with the dog in tow, not just the ones with a token water bowl.',
  },
  {
    title: 'Dog-Friendly Accommodation',
    href: '/journal/dog-friendly-accommodation-mornington-peninsula',
    dek: 'The stays that make a Peninsula trip with the dog feel easy rather than negotiated.',
  },
  {
    title: 'A Dog-Friendly Peninsula Weekend',
    href: '/journal/the-dog-friendly-peninsula',
    dek: 'A realistic weekend shape that works with the dog, not against it.',
  },
];

const utilityCards = [
  {
    title: 'Where to Walk the Dog',
    href: '/journal/where-to-walk-the-dog-mornington-peninsula',
  },
  {
    title: 'Dog Daycare, Boarding, Groomers and Pet Shops',
    href: '/journal/dog-daycare-boarding-groomers-pet-shops-mornington-peninsula',
  },
  {
    title: 'Emergency Vet and Pet Help',
    href: '/journal/emergency-vet-pet-help-mornington-peninsula',
  },
  {
    title: 'What to Do With a Dog When It’s Wet or Busy',
    href: '/journal/what-to-do-on-the-peninsula-with-a-dog-when-its-wet-or-busy',
  },
  {
    title: 'Best Towns to Base Yourself With a Dog',
    href: '/journal/best-towns-to-base-yourself-with-a-dog-mornington-peninsula',
  },
];
---

<BaseLayout
  title="Dog-Friendly Mornington Peninsula | Peninsula Insider"
  description="A practical Peninsula Insider guide to dog-friendly beaches, wineries, cafés, stays, and weekends on the Mornington Peninsula."
  section="explore"
  canonical="https://peninsulainsider.com.au/dog-friendly"
  ogImage="/images/sourced/dog-beach-emma-01.webp"
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="section-hero">
    <div class="container">
      <div class="section-hero__inner">
        <div class="section-hero__content">
          <p class="label label--accent">Dog-Friendly Peninsula</p>
          <h1 class="section-hero__title" {...editableText({ entityType: 'page', entitySlug: 'dog-friendly', fieldPath: 'hero.title', label: 'Dog-Friendly — title' })}>The practical guide to doing the Peninsula properly with the dog</h1>
          <p class="section-hero__dek" {...editableText({ entityType: 'page', entitySlug: 'dog-friendly', fieldPath: 'hero.dek', label: 'Dog-Friendly — dek' })}>Beaches, wineries, cafés, stays, walks, and backup options that actually work with a dog in the plan. No fluffy pet-travel clichés, just useful local trip logic.</p>
        </div>
        <div class="section-hero__visual" aria-hidden="true" style={`background-image: url(${dogHero.src}); background-size: cover; background-position: center;`} {...dogHero.attrs}>
          <div class="section-hero__visual-fog"></div>
          <span class="section-hero__visual-label">Dog-Friendly Peninsula</span>
        </div>
      </div>
    </div>
  </section>

  <section class="venues dog-hub-cards">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Start here</p>
          <h2 class="venues__title">Build the dog-friendly trip</h2>
          <p class="venues__sub">The four pages that should become the core of the hub.</p>
        </div>
      </div>
      {/* 4 cards lay out cleanest as 2×2 — the default 3-column grid leaves
          the fourth card stranded on its own row. The --two modifier is the
          existing system-wide pattern for even-card-count sections. */}
      <div class="venues__grid venues__grid--two">
        {hubCards.map((card) => (
          <article class="venue-card">
            <h3 class="venue-card__name"><a href={card.href}>{card.title}</a></h3>
            <p class="venue-card__signature">{card.dek}</p>
            <a href={card.href} class="venue-card__cta">Open guide →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-promise">
    <div class="container">
      <div class="editorial-promise__inner">
        <div>
          <p class="label label--accent">Next up</p>
          <h2 class="editorial-promise__title">Utility the hub should grow into</h2>
        </div>
        <div>
          <ul class="prose" style="margin:0; padding-left: 1.2rem;">
            {utilityCards.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock
    title="Dog-friendly Peninsula picks in your inbox"
    body="Useful beaches, stays, long lunches and practical weekend logic, without the generic pet-travel fluff."
  />

  <style>
    /* Dog hub cards are text-only guide cards, not venue cards with image/top
       metadata. The shared .venue-card system assumes a .venue-card__top or
       hero appears before the title, so the first-child title was sitting too
       high and the CTA was visually overweight on mobile. Scope the correction
       here so normal venue listings keep their existing rhythm. */
    .dog-hub-cards .venue-card {
      padding: clamp(1.25rem, 4vw, 1.75rem);
    }

    .dog-hub-cards .venue-card > .venue-card__name,
    .dog-hub-cards .venue-card > .venue-card__signature,
    .dog-hub-cards .venue-card > .venue-card__cta {
      padding-left: 0;
      padding-right: 0;
    }

    /* Hide the 5px gold top-accent bar that .venue-card::before draws.
       These are text-only guide cards (no hero image), so the bar visually
       crowds the title and looks like a clipped underline on mobile.
       Mirrors the existing .venues__grid--links .venue-card::before pattern. */
    .dog-hub-cards .venue-card::before {
      display: none;
    }

    .dog-hub-cards .venue-card__name {
      margin: 0 0 0.75rem;
      padding-top: 0.35rem;
      font-size: clamp(1.55rem, 6.4vw, 2rem);
      line-height: 1.08;
      letter-spacing: -0.012em;
    }

    .dog-hub-cards .venue-card__signature {
      padding-top: 0.85rem;
      margin-bottom: 1.15rem;
      border-top: 1px solid rgba(121, 92, 58, 0.14);
    }

    .dog-hub-cards .venue-card__cta {
      width: 100%;
      min-height: 3.25rem;
      padding: 0.82rem 1rem;
    }

    @media (max-width: 760px) {
      .dog-hub-cards {
        padding-top: 2.75rem;
      }

      .dog-hub-cards .venues__grid,
      .dog-hub-cards .venues__grid--two {
        gap: 1.25rem;
      }

      .dog-hub-cards .venue-card {
        border-radius: 1.2rem;
      }

      .dog-hub-cards .venue-card__name {
        font-size: clamp(1.5rem, 6.2vw, 1.85rem);
        line-height: 1.1;
      }

      .dog-hub-cards .venue-card__cta {
        min-height: 3rem;
        padding: 0.78rem 1rem;
        font-size: 0.78rem;
      }
    }
  </style>
</BaseLayout>
