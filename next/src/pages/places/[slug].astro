---
import { getCollection } from 'astro:content';
import { routeSlug } from '../../lib/editorial';
import Redirect from '../../components/Redirect.astro';

// Legacy /explore/places/[slug]/ -> /explore/places/[slug]/ (PR-5 URL migration).
export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((place) => ({ params: { slug: routeSlug(place) } }));
}
const { slug } = Astro.params;
---
<Redirect to={`/explore/places/${slug}/`} consolidate />
