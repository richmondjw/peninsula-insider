---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompareBlock from '../../components/CompareBlock.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { routeSlug } from '../../lib/editorial';
import { buildCollectionPageSchema, buildFaqSchema, buildBreadcrumbSchema } from '../../lib/schema';
import { editableText } from '../../lib/inline-edit/attrs';

// ── Data ──────────────────────────────────────────────────────────────────────
const places = (await getCollection('places')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const venues = await getCollection('venues');
const experiences = await getCollection('experiences');

// Curated destination order — editorial priority, not alphabetical or regional.
// Reflects search importance, Peninsula recognition, and editorial strength.
// Update this array to change what appears and in what order.
// Curated primary destinations in editorial priority order.
// Reflects search importance, Peninsula recognition, and editorial strength.
// Fingal added (Peninsula Hot Springs, Moonah Links, Cape Schanck access).
// Dromana promoted (Dromana Drive-In, Arthurs Seat Eagle, gateway positioning).
const CURATED_ORDER = [
  'sorrento', 'red-hill', 'flinders', 'portsea', 'mornington',
  'cape-schanck', 'fingal', 'dromana', 'main-ridge', 'merricks',
  'blairgowrie', 'rye',
];

// Primary curated destinations — shown in editorial order at the top of the hub
const primaryDestinations = CURATED_ORDER
  .map((slug) => places.find((p) => routeSlug(p) === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Secondary destinations — remaining places not in the curated primary list
const secondaryDestinations = places.filter(
  (p) => !CURATED_ORDER.includes(routeSlug(p))
).sort((a, b) => a.data.name.localeCompare(b.data.name));

const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const townReadSlugs = [
  'a-flinders-weekend',
  'mornington-day-guide',
  'how-to-build-a-red-hill-saturday',
  'the-peninsula-orientation-drive',
];
const townReads = townReadSlugs
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));


const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Places' },
];

const collectionSchema = buildCollectionPageSchema({
  name: 'Mornington Peninsula Towns — Peninsula Insider',
  description: 'From Red Hill\'s cool-climate cellar doors to Portsea\'s clifftop mansions and Flinders\' historic pier — the complete editorial guide to every town on the Mornington Peninsula.',
  path: '/places',
  dateModified: '2026-04-30',
});

const faqSchema = buildFaqSchema([
  { q: 'Which town should I stay in on the Mornington Peninsula?',
    a: 'It depends on what you\'re doing. For wineries and restaurants: Red Hill or Merricks. For the most dramatic scenery and beach options: Sorrento or Portsea. For a family-friendly bay beach base: Rosebud, Dromana, or Mount Martha. For something understated and local: Flinders or Balnarring.' },
  { q: 'How many towns can I cover in a day trip from Melbourne?',
    a: 'Realistically two, maybe three if they\'re adjacent. Red Hill and Mornington pair well. Sorrento and Portsea are 10 minutes apart. Cape Schanck and Flinders work together. Don\'t try to cross from the bay coast to the tip in a single day trip — it\'s 90 minutes of driving.' },
  { q: 'Are all the towns accessible by public transport?',
    a: 'Most towns have bus connections from Frankston (which has a train from Melbourne). Sorrento, Portsea, Dromana, Rosebud, and Rye are covered by bus route 788. Flinders, Balnarring, and Shoreham are on route 782. Hastings has its own train station on the Stony Point line. Red Hill, Main Ridge, and Merricks have limited or no public transport — a car is required.' },
  { q: "What's the difference between the bay beaches and the ocean beaches?",
    a: 'Bay beaches (Port Phillip side) are calm, shallow, and safe for young children — think bathing boxes and paddling. Ocean beaches (Bass Strait side) have surf, rips, and a wild energy — better for surfing and dramatic walks. Sorrento and Portsea uniquely have both: a front beach on the bay, a back beach on the ocean.' },
  { q: 'Is the Mornington Peninsula worth visiting in winter?',
    a: 'Strongly yes. The restaurants are quieter, the cellar doors are unhurried, and the dramatic ocean beaches are at their best in cold weather. Winter is when Peninsula Insider recommends Flinders and Cape Schanck most aggressively.' },
]);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://peninsulainsider.com.au/' },
  { name: 'Places', url: 'https://peninsulainsider.com.au/places/' },
]);
---

<BaseLayout
  title="Mornington Peninsula Towns — a guide to every locality · Peninsula Insider"
  description="From Red Hill's cool-climate cellar doors to Portsea's clifftop mansions and Flinders' historic pier — the complete editorial guide to every town on the Mornington Peninsula."
  section="places"
  canonical="https://peninsulainsider.com.au/places/"
  modifiedTime="2026-04-30"
  ogImage="/images/sourced/places-hub-hero-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <!-- ═══════════════════════════════════════════════════════════════
       1. LIGHTWEIGHT PAGE HEADER
       Minimal. Destinations are the page's primary function — the header
       introduces, the grid delivers. No hero image on this page.
       ═══════════════════════════════════════════════════════════════ -->
  <div class="places-page-header">
    <div class="container">
      <p class="label label--accent places-page-header__eyebrow">Peninsula Insider</p>
      <h1 class="places-page-header__title" {...editableText({ entityType: 'page', entitySlug: 'places', fieldPath: 'hero.title', label: 'Places — title' })}>Peninsula destinations</h1>
      <p class="places-page-header__dek" {...editableText({ entityType: 'page', entitySlug: 'places', fieldPath: 'hero.dek', label: 'Places — dek' })}>Choose where you want to be. Each page is a complete guide.</p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       2. PRIMARY DESTINATIONS — immediately after hero, destination-first.
       Curated editorial order. No regional groupings.
       ═══════════════════════════════════════════════════════════════ -->
  {primaryDestinations.length > 0 && (
    <section class="places places--primary" id="destinations">
      <div class="container">
        <div class="places__header places__header--primary">
          <div>
            <p class="label label--accent places__label">Peninsula destinations</p>
            <h2 class="places__title places__title--primary">Where on the Peninsula?</h2>
          </div>
        </div>
        <div class="places__grid">
          {primaryDestinations.map((place, index) => (
            <PlaceCard place={place} variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'} showMeta={false} showActions={false} introMaxLength={200} />
          ))}
        </div>
      </div>
    </section>
  )}

  <SectionDivider />

  <!-- ═══════════════════════════════════════════════════════════════
       3. GEOGRAPHIC FRAME — planning orientation, below destinations.
       Bay coast vs ocean — practical planning utility, not branded regions.
       ═══════════════════════════════════════════════════════════════ -->
  <CompareBlock
    eyebrow="The decision before the booking"
    heading="Bay coast or the Ocean side"
    dek="The Peninsula splits cleanly along which water each place faces. Knowing this changes what you book."
    left={{
      label: 'Bay side — Port Phillip',
      title: 'Calm water. Family-tilted. Summer-bright.',
      rows: [
        { label: 'Towns', value: 'Mornington, Mount Martha, Dromana, Rosebud, Safety Beach' },
        { label: 'Water', value: 'Sheltered. Shallow, calm, safe for young children. Warmer in summer.' },
        { label: 'Best for', value: 'Family weekends, casual day trips, beach swimming, foreshore walks.' },
      ],
    }}
    right={{
      label: 'Ocean side — Bass Strait',
      title: 'Wild water. Limestone cliffs. Year-round drama.',
      rows: [
        { label: 'Towns', value: 'Sorrento, Portsea, Rye, Cape Schanck, Flinders, Shoreham' },
        { label: 'Water', value: 'Open Bass Strait. Surf, rips, surge. Cold year-round.' },
        { label: 'Best for', value: 'Walkers, winter visits, dramatic scenery, surfers, solitude-seekers.' },
      ],
    }}
  />

  <!-- ═══════════════════════════════════════════════════════════════
       4. MORE PENINSULA PLACES — secondary destinations, alphabetical
       ═══════════════════════════════════════════════════════════════ -->
  {secondaryDestinations.length > 0 && (
    <section class="places places--secondary" id="more-places">
      <div class="container">
        <div class="places__header">
          <p class="label places__label--secondary">More Peninsula places</p>
        </div>
        <div class="places__grid places__grid--secondary">
          {secondaryDestinations.map((place, index) => (
            <PlaceCard place={place} variant={index % 3 === 1 ? 'bay' : index % 3 === 2 ? 'sand' : 'vineyard'} showMeta={false} showActions={false} introMaxLength={160} />
          ))}
        </div>
      </div>
    </section>
  )}



  <!-- ═══════════════════════════════════════════════════════════════
       6. EDITORIAL GUIDES — formerly section 7
       ═══════════════════════════════════════════════════════════════ -->
  {townReads.length > 0 && (
    <section class="venues venues--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">From the Journal</p>
            <h2 class="venues__title">Town-first reads that map a single stretch properly</h2>
            <p class="venues__sub">The essays and service pieces that sit closest to the place layer.</p>
          </div>
          <a href="/journal/" class="venues__link">All in the Journal →</a>
        </div>
        <div class="venues__grid">
          {townReads.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       8. FAQ
       ═══════════════════════════════════════════════════════════════ -->
  <section class="hub-faq" aria-label="Frequently asked questions">
    <div class="container">
      <div class="hub-faq__intro">
        <p class="label label--accent">Frequently asked</p>
        <h2 class="hub-faq__title">Five honest answers about Peninsula geography</h2>
      </div>
      <div class="hub-faq__list">
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Which town should I stay in on the Peninsula?</summary>
          <div class="hub-faq__a"><p>It depends on what you're doing. For wineries and restaurants: Red Hill or Merricks. For the most dramatic scenery and beach options: Sorrento or Portsea. For a family-friendly bay beach base: Rosebud, Dromana, or Mount Martha. For something understated and local: Flinders or Balnarring. Read <a href="/explore/where-to-base-yourself/">where to base yourself</a> for the full breakdown.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">How many towns can I cover in a day trip from Melbourne?</summary>
          <div class="hub-faq__a"><p>Realistically two, maybe three if they're adjacent. Red Hill and Mornington pair well. Sorrento and Portsea are 10 minutes apart. Cape Schanck and Flinders work together. Don't try to cross from the bay coast to the tip in a single day trip — it's 90 minutes of driving.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Are all the towns accessible by public transport?</summary>
          <div class="hub-faq__a"><p>Most towns have bus connections from Frankston (which has a train from Melbourne). Sorrento, Portsea, Dromana, Rosebud, and Rye are covered by bus route 788. Flinders, Balnarring, and Shoreham are on route 782. Hastings has its own train station on the Stony Point line. Moorooduc, Tuerong, Red Hill, Main Ridge, and Merricks have limited or no public transport — a car is required.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">What's the difference between the bay beaches and the ocean beaches?</summary>
          <div class="hub-faq__a"><p>Bay beaches (Port Phillip side) are calm, shallow, and safe for young children — think bathing boxes and paddling. Ocean beaches (Bass Strait side) have surf, rips, and a wild energy — better for surfing and dramatic walks. Sorrento and Portsea uniquely have both: a front beach on the bay, a back beach on the ocean.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Is the Peninsula worth visiting in winter?</summary>
          <div class="hub-faq__a"><p>Strongly yes. The restaurants are quieter, the cellar doors are unhurried, and the dramatic ocean beaches are at their best in cold weather. Winter is when Peninsula Insider recommends <a href="/places/flinders/">Flinders</a> and <a href="/places/cape-schanck/">Cape Schanck</a> most aggressively. Read <a href="/journal/mornington-peninsula-in-winter/">winter on the Peninsula</a> for the itinerary.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Map discovery — Peninsula Insider map as a planning tool within Places.
       Maps is a supporting discovery surface within the Places ecosystem,
       not a standalone primary section. Positioned before newsletter. -->
  <section class="places-map-cta">
    <div class="container">
      <div class="places-map-cta__inner">
        <div class="places-map-cta__text">
          <p class="label label--accent">Visual discovery</p>
          <h2 class="places-map-cta__title">Browse the Peninsula on a map</h2>
          <p class="places-map-cta__dek">Every destination, venue, walk, and experience plotted. Useful for orienting a new trip or checking what’s nearby.</p>
        </div>
        <a href="/map/" class="places-map-cta__link">Open the Peninsula map →</a>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* ── Lightweight page header ── */
  .places-page-header {
    padding: 2rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .places-page-header__eyebrow {
    margin-bottom: 0.35rem;
  }
  .places-page-header__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--dark);
    line-height: 1.05;
    margin: 0 0 0.5rem;
  }
  .places-page-header__dek {
    font-size: 0.9rem;
    color: var(--soft);
    margin: 0;
    max-width: 36rem;
  }
  @media (max-width: 640px) {
    .places-page-header {
      padding: 1.5rem 0 1.25rem;
    }
    .places-page-header__title {
      font-size: 1.6rem;
    }
  }

  /* Primary destinations — leads the page, full editorial weight */
  .places--primary {
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(3rem, 5vw, 4.5rem);
  }
  .places__header--primary {
    margin-bottom: 2.5rem;
  }
  .places__title--primary {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--dark);
    margin: 0.4rem 0 0;
    line-height: 1.05;
  }

  /* Secondary destinations — quieter, supporting layer */
  .places--secondary {
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    background: var(--bg-alt);
  }
  .places__label--secondary {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
    display: block;
    margin-bottom: 1.5rem;
  }
  .places__grid--secondary {
    opacity: 0.9;
  }
  /* Tighter card grid on secondary — smaller minimum so more fit per row */
  .places--secondary .places__grid {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  @media (max-width: 640px) {
    .places--secondary .places__grid {
      grid-template-columns: 1fr 1fr;
    }
    .places--primary {
      padding: 2rem 0 2.5rem;
    }
  }
  @media (max-width: 380px) {
    .places--secondary .places__grid {
      grid-template-columns: 1fr;
    }
  }

  .places-map-cta {
    padding: 2.5rem 0;
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
  }
  .places-map-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .places-map-cta__text { flex: 1; min-width: 200px; }
  .places-map-cta__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: 600;
    color: var(--dark);
    margin: 0.3rem 0 0.4rem;
    line-height: 1.15;
  }
  .places-map-cta__dek {
    font-size: 0.88rem;
    color: var(--soft);
    margin: 0;
    max-width: 38rem;
  }
  .places-map-cta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.4rem;
    background: var(--dark);
    color: var(--white);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }
  .places-map-cta__link:hover { opacity: 0.82; }
  @media (max-width: 600px) {
    .places-map-cta__inner { flex-direction: column; align-items: flex-start; }
  }

  .peninsula-glance {
    padding: clamp(3rem, 6vw, 5.5rem) 0;
    background: #f7f0e6;
  }

  .peninsula-glance__header {
    max-width: 760px;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .peninsula-glance__title {
    margin: 0.35rem 0 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.1rem, 4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: #1f1b16;
  }

  .peninsula-glance__sub {
    max-width: 58ch;
    margin: 1rem 0 0;
    color: rgba(31, 27, 22, 0.72);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
  }

  .peninsula-glance__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .peninsula-glance__card {
    min-height: 100%;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid rgba(31, 27, 22, 0.12);
    border-radius: 22px;
    background: rgba(255, 252, 247, 0.72);
    box-shadow: 0 18px 45px rgba(39, 30, 19, 0.06);
  }

  .peninsula-glance__kicker {
    margin: 0 0 1.1rem;
    color: #9b6a2f;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .peninsula-glance__card h3 {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #211c17;
  }

  .peninsula-glance__card p:last-child {
    margin: 1rem 0 0;
    color: rgba(31, 27, 22, 0.72);
    line-height: 1.62;
  }

  @media (max-width: 980px) {
    .peninsula-glance__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .peninsula-glance__grid { grid-template-columns: 1fr; }
  }
</style>
