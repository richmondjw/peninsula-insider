---
/**
 * /whats-on/this-weekend/ - rolling URL for Peninsula This Weekend.
 *
 * Per Wave 2 Brief 2 (work/peninsula-insider/wave-2-build-briefs.md): the
 * dispatch lives at a stable URL so AI assistants and external sources can
 * reliably link to "this weekend on the Peninsula". The page selects the
 * latest PTW article at build time.
 *
 * Renders two layers:
 *   1. Structured dispatch UI (hero, weather strip, at-a-glance,
 *      pick cards, archive grid) when `dispatch` frontmatter is present
 *   2. The long-form markdown body of the dispatch article below the cards
 *
 * Past dispatches preserved at /whats-on/this-weekend/archive/{date}/.
 * Legacy /journal/peninsula-this-weekend-{slug}/ URLs redirect into the
 * dated archive (see src/pages/journal/[slug].astro).
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import PiArticleActions from '../../../components/PiArticleActions.astro';
import ClusterLinks from '../../../components/ClusterLinks.astro';
import DispatchPickCard from '../../../components/DispatchPickCard.astro';
import DispatchAtAGlance from '../../../components/DispatchAtAGlance.astro';
import EventCard from '../../../components/EventCard.astro';
import {
  selectLatestPtw,
  ptwArchivePath,
  ptwWeekendLabel,
  ptwWeekendFriday,
  ptwWeekendEndIso,
  buildPtwEventSchema,
  sortPtwLatestFirst,
} from '../../../lib/peninsula-this-weekend';
import { isPeninsulaThisWeekend } from '../../../lib/peninsula-this-weekend';
import { formatHeroCredit, routeSlug } from '../../../lib/editorial';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import {
  loadLiveEvents,
  occursInWindow,
  startOfDay,
  weekendWindow,
  type ScopeWindow,
} from '../_data';

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const ptwArticles = sortPtwLatestFirst(allArticles.filter(isPeninsulaThisWeekend));
const latest = selectLatestPtw(allArticles);

if (!latest) {
  throw new Error('Peninsula This Weekend: no weekend-picker articles found in collection.');
}

const { Content } = await render(latest);

const canonical = 'https://peninsulainsider.com.au/whats-on/this-weekend/';
const now = new Date();
const currentWeekend = weekendWindow(now);
const latestWeekendEnd = new Date(ptwWeekendEndIso(latest));
const hasCurrentDispatch = latestWeekendEnd >= startOfDay(now);
const weekendLabel = hasCurrentDispatch ? ptwWeekendLabel(latest) : currentWeekend.label;
const weekendEndIso = hasCurrentDispatch
  ? ptwWeekendEndIso(latest)
  : new Date(currentWeekend.end.getFullYear(), currentWeekend.end.getMonth(), currentWeekend.end.getDate(), 23, 59, 0).toISOString();
const eventSchema = hasCurrentDispatch ? buildPtwEventSchema(latest, canonical) : null;
const dispatch = hasCurrentDispatch ? latest.data.dispatch : null;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "What's On", href: '/whats-on/' },
  { label: 'This Weekend' },
];

const latestHero = hasCurrentDispatch
  ? await resolveHero('article', routeSlug(latest), latest.data, 'hero')
  : null;
const fallbackHero = '/images/sourced/whats-on-winter-wine.webp';
const heroStyle = latestHero?.style ?? `background-image: url('${fallbackHero}')`;
const ogImage = latestHero?.src ?? fallbackHero;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: `https://peninsulainsider.com.au${item.href}` } : {}),
  })),
};

const archiveItems = ptwArticles
  .slice(hasCurrentDispatch ? 1 : 0, hasCurrentDispatch ? 9 : 8)
  .map((a) => ({
    href: ptwArchivePath(a),
    label: a.data.title,
    dek: a.data.dek,
    date: a.data.publishedAt,
  }));

// Cadence/refresh string: PTW publishes Sunday-ahead for the upcoming
// weekend (publish + 6, publish + 7). The hero status pill shows when
// this dispatch was last refreshed and what weekend it covers.
const publishedFmt = latest.data.publishedAt.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'short',
});

// Live events for this weekend, pulled from the events collection
// where startDate or endDate falls within the dispatch's Fri-Sun window.
// Lets us show "Also on this weekend" venue/event cards beneath the
// editor's curated picks, without re-editing them by hand each week.
const friday = hasCurrentDispatch ? ptwWeekendFriday(latest) : currentWeekend.start;
const sunday = hasCurrentDispatch ? new Date(friday) : currentWeekend.end;
if (hasCurrentDispatch) sunday.setUTCDate(friday.getUTCDate() + 2);
sunday.setHours(23, 59, 0, 0);
const activeWindow: ScopeWindow = { start: friday, end: sunday, label: weekendLabel };
const dispatchPickEventSlugs = new Set(
  [dispatch?.lead, dispatch?.saturday, dispatch?.sunday, dispatch?.rainyDay]
    .map((p: any) => p?.eventRef)
    .filter(Boolean),
);
const liveThisWeekend = (await loadLiveEvents(now))
  .filter((live) => occursInWindow(live.rule, activeWindow))
  .filter((live) => !dispatchPickEventSlugs.has(live.slug))
  .sort((a, b) => b.appeal - a.appeal || a.title.localeCompare(b.title))
  .map((live) => live.event)
  .slice(0, 6);

// Machine-readable list follows the current surface. When an edited weekly
// dispatch has aged out, the rolling URL exposes only current registry events
// and keeps the old edition in the archive instead of asserting stale picks.
const itemListSchema = dispatch
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Peninsula This Weekend, ${weekendLabel}`,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: [dispatch.lead, dispatch.saturday, dispatch.sunday, dispatch.rainyDay].filter(Boolean).length,
      itemListElement: [
        { p: dispatch.lead, eyebrow: 'Lead booking' },
        dispatch.saturday && { p: dispatch.saturday, eyebrow: 'Saturday' },
        dispatch.sunday && { p: dispatch.sunday, eyebrow: 'Sunday' },
        dispatch.rainyDay && { p: dispatch.rainyDay, eyebrow: 'If the weather changes' },
      ]
        .filter(Boolean)
        .map((entry: any, i: number) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: `${entry.eyebrow}: ${entry.p.title}`,
          url: entry.p.eventRef
            ? `https://peninsulainsider.com.au/whats-on/${entry.p.eventRef}/`
            : canonical,
        })),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `What's on this weekend, ${weekendLabel}`,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: liveThisWeekend.length,
      itemListElement: liveThisWeekend.map((event, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: event.data.title,
        url: `https://peninsulainsider.com.au/whats-on/${routeSlug(event)}/`,
      })),
    };
export const prerender = true;
---

<BaseLayout
  title={hasCurrentDispatch
    ? `Peninsula This Weekend - ${weekendLabel} · Peninsula Insider`
    : `What's on this weekend - ${weekendLabel} · Peninsula Insider`}
  description={hasCurrentDispatch
    ? latest.data.dek
    : `Current Mornington Peninsula events for ${weekendLabel}. The next edited Peninsula This Weekend dispatch is in preparation.`}
  section="whats-on"
  canonical={canonical}
  ogImage={ogImage}
  searchImage={ogImage}
  ogType="article"
  publishedTime={hasCurrentDispatch ? latest.data.publishedAt.toISOString() : undefined}
  modifiedTime={hasCurrentDispatch ? (latest.data.updatedAt ?? latest.data.publishedAt).toISOString() : undefined}
>
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}

  <Breadcrumbs items={breadcrumbItems} />

  <article
    class="article ptw"
    data-weekend-end={weekendEndIso}
    data-source-mode={hasCurrentDispatch ? 'editorial-dispatch' : 'registry-fallback'}
  >

    <!-- ─── Hero ───────────────────────────────────────────────────── -->
    <header class="ptw-hero">
      <div class="container">
        <div class="ptw-hero__frame">
          <div class="ptw-hero__head">
            <div class="ptw-hero__meta">
              <span class="ptw-hero__pill" aria-label="Section">Peninsula This Weekend</span>
              <span class="ptw-hero__pill ptw-hero__pill--accent">{weekendLabel}</span>
            </div>

            {/* Staleness guard: a statically built "this weekend" ages the
                moment the weekend closes. If the reader arrives after
                Sunday night, say so honestly rather than presenting a past
                weekend as current. */}
            {hasCurrentDispatch && (
              <p class="ptw-hero__stale" data-weekend-end={weekendEndIso} hidden>
                This dispatch covered the weekend of {weekendLabel}. The next
                edition is in preparation. <a href="/whats-on/">Browse everything on
                now instead</a>.
              </p>
            )}
            {hasCurrentDispatch && (
              <script is:inline>
                (function () {
                  var el = document.querySelector('.ptw-hero__stale');
                  if (!el) return;
                  var end = new Date(el.getAttribute('data-weekend-end'));
                  if (!isNaN(end) && Date.now() > end.getTime()) el.hidden = false;
                })();
              </script>
            )}
            <h1 class="ptw-hero__title">
              {hasCurrentDispatch ? latest.data.title : 'What’s on this weekend'}
            </h1>
            <p class="ptw-hero__dek">
              {hasCurrentDispatch
                ? latest.data.dek
                : `Current events across the Mornington Peninsula for ${weekendLabel}. Our next edited dispatch is in preparation; this list comes from the live events registry.`}
            </p>

            {dispatch?.weather && (
              <div class="ptw-hero__weather">
                <span class="ptw-hero__weather-label">Weekend forecast</span>
                <span class="ptw-hero__weather-body">{dispatch.weather}</span>
              </div>
            )}

            {hasCurrentDispatch ? (
              <>
                <PiArticleActions
                  slug={latest.id}
                  section="whats-on"
                  title={latest.data.title}
                  dek={latest.data.dek}
                  imageUrl={latest.data.heroImage?.src}
                  href="/whats-on/this-weekend/"
                />

                <p class="ptw-hero__cadence">
                  <strong>Refreshed {publishedFmt}</strong> for the weekend of <strong>{weekendLabel}</strong>.
                  A new dispatch lands weekly for the weekend ahead.
                </p>
              </>
            ) : (
              <p class="ptw-hero__cadence">
                <strong>Current window: {weekendLabel}.</strong> No expired dispatch is being presented as current.
              </p>
            )}
          </div>

          <figure class="ptw-hero__figure">
            <div
              class="ptw-hero__image"
              role="img"
              aria-label={hasCurrentDispatch
                ? latest.data.heroImage.alt
                : 'Mornington Peninsula wine-country events in winter'}
              style={heroStyle}
            ></div>
            {hasCurrentDispatch && latest.data.heroImage.credit && (
              <figcaption class="ptw-hero__credit">{formatHeroCredit(latest.data.heroImage.credit)}</figcaption>
            )}
          </figure>
        </div>
      </div>
    </header>

    <div class="container">

      {/* ─── Editor's line ──────────────────────────────────────────── */}
      {dispatch?.editorLine && (
        <p class="ptw-editor-line">{dispatch.editorLine}</p>
      )}

      {/* ─── At a glance ────────────────────────────────────────────── */}
      {dispatch && (
        <DispatchAtAGlance
          tiles={[
            { eyebrow: 'The lead', title: dispatch.lead.title, anchorId: 'lead' },
            ...(dispatch.saturday ? [{ eyebrow: 'Saturday', title: dispatch.saturday.title, anchorId: 'saturday' }] : []),
            ...(dispatch.sunday ? [{ eyebrow: 'Sunday', title: dispatch.sunday.title, anchorId: 'sunday' }] : []),
          ]}
        />
      )}

      {/* ─── Pick cards ─────────────────────────────────────────────── */}
      {dispatch && (
        <section class="ptw-picks" aria-label="Weekend picks">
          <div id="lead">
            <DispatchPickCard
              eyebrow="The lead booking"
              rank="01"
              variant="lead"
              pick={dispatch.lead}
            />
          </div>

          <div class="ptw-picks__row">
            {dispatch.saturday && (
              <div id="saturday">
                <DispatchPickCard
                  eyebrow="Saturday"
                  rank="02"
                  pick={dispatch.saturday}
                />
              </div>
            )}
            {dispatch.sunday && (
              <div id="sunday">
                <DispatchPickCard
                  eyebrow="Sunday"
                  rank="03"
                  pick={dispatch.sunday}
                />
              </div>
            )}
          </div>

          {dispatch.rainyDay && (
            <div id="rainy-day">
              <DispatchPickCard
                eyebrow="If the weather changes"
                rank="04"
                variant="backup"
                pick={dispatch.rainyDay}
              />
            </div>
          )}

          {dispatch.weekendShape && (
            <aside class="ptw-shape">
              <p class="ptw-shape__eyebrow">Weekend shape</p>
              <p class="ptw-shape__body">{dispatch.weekendShape}</p>
            </aside>
          )}
        </section>
      )}

      {!hasCurrentDispatch && (
        <section class="ptw-current" aria-labelledby="ptw-current-title">
          <div class="ptw-also__head">
            <p class="ptw-also__eyebrow">Current registry</p>
            <h2 id="ptw-current-title" class="ptw-also__title">Events running this weekend</h2>
            <p class="ptw-also__sub">
              These listings are date-checked at build time. The most recent edited dispatch is available in the archive below.
            </p>
          </div>
          {liveThisWeekend.length > 0 ? (
            <div class="event-grid">
              {liveThisWeekend.map((event) => <EventCard event={event} />)}
            </div>
          ) : (
            <p class="ptw-current__empty">
              No verified listings are currently available for this weekend. <a href="/whats-on/">Browse the full events index</a>.
            </p>
          )}
        </section>
      )}

      {/* ─── Mid-page newsletter CTA ────────────────────────────────── */}
      <aside class="ptw-cta" aria-label="Newsletter signup">
        <p class="ptw-cta__eyebrow">Get the dispatch in your inbox</p>
        <p class="ptw-cta__body">
          Thoughtful recommendations, seasonal discoveries, and what’s happening across the Mornington Peninsula.
        </p>
        <p class="ptw-cta__sub">The Peninsula worth knowing. Weekly. What's on, where we'd go and what's worth knowing next.</p>
        <a class="pi-btn pi-btn--solid" href="/dispatch/">Join</a>
      </aside>

      {/* ─── Editor's long-form body (existing markdown) ────────────── */}
      {hasCurrentDispatch && (
        <div class="prose ptw-body">
          <Content />
        </div>
      )}

      {/* ─── Also on this weekend (live events) ─────────────────────── */}
      {hasCurrentDispatch && liveThisWeekend.length > 0 && (
        <section class="ptw-also" aria-labelledby="ptw-also-title">
          <div class="ptw-also__head">
            <p class="ptw-also__eyebrow">Also running</p>
            <h2 id="ptw-also-title" class="ptw-also__title">Other things on this weekend</h2>
            <p class="ptw-also__sub">
              Pulled live from our events index. The dispatch above is what we'd actually book; the list below is the wider field.
            </p>
          </div>
          <div class="event-grid">
            {liveThisWeekend.map((e) => <EventCard event={e} />)}
          </div>
          <p class="ptw-also__more">
            <a href="/whats-on/">See the full What's On index →</a>
          </p>
        </section>
      )}

      {hasCurrentDispatch && latest.data.clusterLinks && latest.data.clusterLinks.length > 0 && (
        <ClusterLinks links={latest.data.clusterLinks} heading="Explore this hub" />
      )}

      {hasCurrentDispatch && latest.data.faq && latest.data.faq.length > 0 && (
        <section class="article-faq" aria-labelledby="ptw-faq-title">
          <div class="article-faq__header">
            <p class="article-faq__eyebrow">Questions readers actually ask</p>
            <h2 id="ptw-faq-title" class="article-faq__title">FAQ</h2>
          </div>
          <div class="article-faq__items">
            {latest.data.faq.map((item) => (
              <details class="article-faq__item">
                <summary class="article-faq__question">{item.question}</summary>
                <div class="article-faq__answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      {/* ─── Archive ────────────────────────────────────────────────── */}
      {archiveItems.length > 0 && (
        <section id="archive" class="ptw-archive" aria-labelledby="ptw-archive-title">
          <div class="ptw-archive__head">
            <p class="ptw-archive__eyebrow">Past dispatches</p>
            <h2 id="ptw-archive-title" class="ptw-archive__title">The archive</h2>
            <p class="ptw-archive__sub">Each week's dispatch stays online at a stable archive URL.</p>
          </div>
          <ul class="ptw-archive__list">
            {archiveItems.map((entry) => (
              <li class="ptw-archive__item">
                <a class="ptw-archive__link" href={entry.href}>
                  <span class="ptw-archive__date">
                    {entry.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' })}
                  </span>
                  <span class="ptw-archive__body">
                    <span class="ptw-archive__label">{entry.label}</span>
                    {entry.dek && <span class="ptw-archive__dek">{entry.dek}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────── */
  .ptw-hero {
    padding: 2.5rem 0 2rem;
    background: linear-gradient(180deg, rgba(246, 241, 232, 0.4), transparent);
  }
  .ptw-hero__frame {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 980px) {
    .ptw-hero__frame { grid-template-columns: 1.1fr 1fr; gap: 3rem; }
  }
  .ptw-hero__head { display: flex; flex-direction: column; gap: 1.1rem; }
  .ptw-hero__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ptw-hero__pill {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    background: rgba(33, 30, 28, 0.06);
    color: var(--ink, #211e1c);
    border-radius: 2px;
  }
  .ptw-hero__pill--accent {
    background: var(--ink, #211e1c);
    color: #fff;
  }
  .ptw-hero__stale {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.85rem;
    font-size: 0.95rem;
    line-height: 1.5;
    background: rgba(11, 90, 72, 0.08);
    border-left: 2px solid var(--accent, var(--accent));
    color: var(--ink, #211e1c);
  }
  .ptw-hero__stale a {
    color: var(--accent, var(--accent));
    text-decoration: underline;
  }
  .ptw-hero__title {
    margin: 0;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink, #211e1c);
  }
  .ptw-hero__dek {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink-soft, #433d39);
  }
  .ptw-hero__weather {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
    padding: 0.85rem 1rem;
    background: rgba(11, 90, 72, 0.07);
    border-left: 3px solid var(--accent, var(--accent));
  }
  .ptw-hero__weather-label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, var(--accent));
    font-weight: 600;
  }
  .ptw-hero__weather-body {
    font-size: 0.95rem;
    color: var(--ink, #211e1c);
    line-height: 1.5;
  }
  .ptw-hero__cadence {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-soft, #6b6b6b);
    line-height: 1.5;
  }
  .ptw-hero__figure { margin: 0; }
  .ptw-hero__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
  }
  .ptw-hero__credit {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--ink-soft, #7A726A);
    font-style: normal;
  }

  /* ── Editor's line ─────────────────────────────────────────────── */
  .ptw-editor-line {
    margin: 2.5rem auto 1rem;
    max-width: 720px;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: normal;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-soft, #433d39);
    text-align: center;
  }

  /* ── Picks ─────────────────────────────────────────────────────── */
  .ptw-picks {
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ptw-picks__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 780px) {
    .ptw-picks__row { grid-template-columns: 1fr 1fr; }
  }
  .ptw-shape {
    margin-top: 0.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--ink, #211e1c);
    color: #fff;
  }
  .ptw-shape__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 600;
  }
  .ptw-shape__body {
    margin: 0;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: normal;
    font-size: 1.15rem;
    line-height: 1.55;
    color: #fff;
  }

  /* ── Mid-page CTA ──────────────────────────────────────────────── */
  .ptw-cta {
    margin: 3rem auto;
    max-width: 720px;
    padding: 2.25rem 1.75rem;
    text-align: center;
    background: #fbf7ef;
    border-top: 3px solid var(--accent, var(--accent));
    border-bottom: 3px solid var(--accent, var(--accent));
  }
  .ptw-cta__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, var(--accent));
    font-weight: 600;
  }
  .ptw-cta__title {
    margin: 0 0 0.75rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.2;
    color: var(--ink, #211e1c);
  }
  .ptw-cta__body {
    margin: 0 0 0.75rem;
    color: var(--ink-soft, #433d39);
    line-height: 1.6;
  }
  .ptw-cta__sub {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--ink-muted, #6E655C);
    font-style: normal;
  }

  /* ── Long-form body ────────────────────────────────────────────── */
  .ptw-body {
    margin: 2rem auto 3rem;
    max-width: 720px;
  }

