---
/**
 * /whats-on/this-weekend/ — rolling URL for Peninsula This Weekend.
 *
 * Per Wave 2 Brief 2 (work/peninsula-insider/wave-2-build-briefs.md): the
 * dispatch lives at a stable URL so AI assistants and external sources can
 * reliably link to "this weekend on the Peninsula". The page selects the
 * latest PTW article at build time.
 *
 * Renders two layers:
 *   1. Structured dispatch UI (hero, weather strip, at-a-glance,
 *      pick cards, archive grid) when `dispatch` frontmatter is present
 *   2. The long-form markdown body of the dispatch article below the cards
 *
 * Past dispatches preserved at /whats-on/this-weekend/archive/{date}/.
 * Legacy /journal/peninsula-this-weekend-{slug}/ URLs redirect into the
 * dated archive (see src/pages/journal/[slug].astro).
 */
import { getCollection, getEntry, render } from 'astro:content';
import { fetchAllEventsFromSanity } from '../../../lib/sanity/event-adapter';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import PiArticleActions from '../../../components/PiArticleActions.astro';
import ClusterLinks from '../../../components/ClusterLinks.astro';
import DispatchPickCard from '../../../components/DispatchPickCard.astro';
import DispatchAtAGlance from '../../../components/DispatchAtAGlance.astro';
import EventCard from '../../../components/EventCard.astro';
import {
  selectLatestPtw,
  ptwArchivePath,
  ptwWeekendLabel,
  ptwWeekendFriday,
  buildPtwEventSchema,
  sortPtwLatestFirst,
} from '../../../lib/peninsula-this-weekend';
import { isPeninsulaThisWeekend } from '../../../lib/peninsula-this-weekend';
import { heroBackgroundStyle, formatHeroCredit, routeSlug } from '../../../lib/editorial';

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const ptwArticles = sortPtwLatestFirst(allArticles.filter(isPeninsulaThisWeekend));
const latest = selectLatestPtw(allArticles);

if (!latest) {
  throw new Error('Peninsula This Weekend: no weekend-picker articles found in collection.');
}

const { Content } = await render(latest);

const canonical = 'https://peninsulainsider.com.au/whats-on/this-weekend/';
const weekendLabel = ptwWeekendLabel(latest);
const eventSchema = buildPtwEventSchema(latest, canonical);
const dispatch = latest.data.dispatch;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "What's On", href: '/whats-on' },
  { label: 'This Weekend' },
];

const heroStyle = heroBackgroundStyle(latest.data);
const ogImage = latest.data.heroImage?.src && !latest.data.heroImage.src.includes('placeholder')
  ? latest.data.heroImage.src
  : '/images/sourced/home-cover.webp';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: `https://peninsulainsider.com.au${item.href}` } : {}),
  })),
};

// ItemList JSON-LD: machine-readable index of the weekend picks so AI
// assistants and search rich results can extract the dispatch's curated
// list cleanly without parsing prose.
const itemListSchema = dispatch
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Peninsula This Weekend, ${weekendLabel}`,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: [dispatch.lead, dispatch.saturday, dispatch.sunday, dispatch.rainyDay].filter(Boolean).length,
      itemListElement: [
        { p: dispatch.lead, eyebrow: 'Lead booking' },
        dispatch.saturday && { p: dispatch.saturday, eyebrow: 'Saturday' },
        dispatch.sunday && { p: dispatch.sunday, eyebrow: 'Sunday' },
        dispatch.rainyDay && { p: dispatch.rainyDay, eyebrow: 'If the weather changes' },
      ]
        .filter(Boolean)
        .map((entry: any, i: number) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: `${entry.eyebrow}: ${entry.p.title}`,
          url: entry.p.eventRef
            ? `https://peninsulainsider.com.au/whats-on/${entry.p.eventRef}/`
            : canonical,
        })),
    }
  : null;

const archiveItems = ptwArticles
  .slice(1, 9)
  .map((a) => ({
    href: ptwArchivePath(a),
    label: a.data.title,
    dek: a.data.dek,
    date: a.data.publishedAt,
  }));

// Cadence/refresh string: PTW publishes Sunday-ahead for the upcoming
// weekend (publish + 6, publish + 7). The hero status pill shows when
// this dispatch was last refreshed and what weekend it covers.
const publishedFmt = latest.data.publishedAt.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'short',
});

// Live events for this weekend, pulled from the events collection
// where startDate or endDate falls within the dispatch's Fri-Sun window.
// Lets us show "Also on this weekend" venue/event cards beneath the
// editor's curated picks, without re-editing them by hand each week.
const friday = ptwWeekendFriday(latest);
const sunday = new Date(friday);
sunday.setUTCDate(friday.getUTCDate() + 2);
sunday.setUTCHours(23, 59, 0, 0);
const allEvents = await fetchAllEventsFromSanity();
const dispatchPickEventSlugs = new Set(
  [dispatch?.lead, dispatch?.saturday, dispatch?.sunday, dispatch?.rainyDay]
    .map((p: any) => p?.eventRef)
    .filter(Boolean),
);
const liveThisWeekend = allEvents
  .filter((e) => {
    const start = e.data.startDate;
    const end = e.data.endDate ?? e.data.startDate;
    return start <= sunday && end >= friday;
  })
  .filter((e) => !dispatchPickEventSlugs.has(routeSlug(e)))
  .sort((a, b) => (a.data.startDate?.getTime() ?? 0) - (b.data.startDate?.getTime() ?? 0))
  .slice(0, 6);
export const prerender = true;
---

<BaseLayout
  title={`Peninsula This Weekend — ${weekendLabel} · Peninsula Insider`}
  description={latest.data.dek}
  section="whats-on"
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  publishedTime={latest.data.publishedAt.toISOString()}
  modifiedTime={(latest.data.updatedAt ?? latest.data.publishedAt).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}

  <Breadcrumbs items={breadcrumbItems} />

  <article class="article ptw">

    <!-- ─── Hero ───────────────────────────────────────────────────── -->
    <header class="ptw-hero">
      <div class="container">
        <div class="ptw-hero__frame">
          <div class="ptw-hero__head">
            <div class="ptw-hero__meta">
              <span class="ptw-hero__pill" aria-label="Section">Peninsula This Weekend</span>
              <span class="ptw-hero__pill ptw-hero__pill--accent">{weekendLabel}</span>
            </div>
            <h1 class="ptw-hero__title">{latest.data.title}</h1>
            <p class="ptw-hero__dek">{latest.data.dek}</p>

            {dispatch?.weather && (
              <div class="ptw-hero__weather">
                <span class="ptw-hero__weather-label">Weekend forecast</span>
                <span class="ptw-hero__weather-body">{dispatch.weather}</span>
              </div>
            )}

            <PiArticleActions
              slug={latest.id}
              section="whats-on"
              title={latest.data.title}
              dek={latest.data.dek}
              imageUrl={latest.data.heroImage?.src}
              href="/whats-on/this-weekend/"
            />

            <p class="ptw-hero__cadence">
              <strong>Refreshed {publishedFmt}</strong> for the weekend of <strong>{weekendLabel}</strong>.
              A new dispatch lands weekly for the weekend ahead.
            </p>
          </div>

          <figure class="ptw-hero__figure">
            <div
              class="ptw-hero__image"
              role="img"
              aria-label={latest.data.heroImage.alt}
              style={heroStyle}
            ></div>
            {latest.data.heroImage.credit && (
              <figcaption class="ptw-hero__credit">{formatHeroCredit(latest.data.heroImage.credit)}</figcaption>
            )}
          </figure>
        </div>
      </div>
    </header>

    <div class="container">

      {/* ─── Editor's line ──────────────────────────────────────────── */}
      {dispatch?.editorLine && (
        <p class="ptw-editor-line">{dispatch.editorLine}</p>
      )}

      {/* ─── At a glance ────────────────────────────────────────────── */}
      {dispatch && (
        <DispatchAtAGlance
          tiles={[
            { eyebrow: 'The lead', title: dispatch.lead.title, anchorId: 'lead' },
            ...(dispatch.saturday ? [{ eyebrow: 'Saturday', title: dispatch.saturday.title, anchorId: 'saturday' }] : []),
            ...(dispatch.sunday ? [{ eyebrow: 'Sunday', title: dispatch.sunday.title, anchorId: 'sunday' }] : []),
          ]}
        />
      )}

      {/* ─── Pick cards ─────────────────────────────────────────────── */}
      {dispatch && (
        <section class="ptw-picks" aria-label="Weekend picks">
          <div id="lead">
            <DispatchPickCard
              eyebrow="The lead booking"
              rank="01"
              variant="lead"
              pick={dispatch.lead}
            />
          </div>

          <div class="ptw-picks__row">
            {dispatch.saturday && (
              <div id="saturday">
                <DispatchPickCard
                  eyebrow="Saturday"
                  rank="02"
                  pick={dispatch.saturday}
                />
              </div>
            )}
            {dispatch.sunday && (
              <div id="sunday">
                <DispatchPickCard
                  eyebrow="Sunday"
                  rank="03"
                  pick={dispatch.sunday}
                />
              </div>
            )}
          </div>

          {dispatch.rainyDay && (
            <div id="rainy-day">
              <DispatchPickCard
                eyebrow="If the weather changes"
                rank="04"
                variant="backup"
                pick={dispatch.rainyDay}
              />
            </div>
          )}

          {dispatch.weekendShape && (
            <aside class="ptw-shape">
              <p class="ptw-shape__eyebrow">Weekend shape</p>
              <p class="ptw-shape__body">{dispatch.weekendShape}</p>
            </aside>
          )}
        </section>
      )}

      {/* ─── Mid-page newsletter CTA ────────────────────────────────── */}
      <aside class="ptw-cta" aria-label="Newsletter signup">
        <p class="ptw-cta__eyebrow">Get the dispatch in your inbox</p>
        <p class="ptw-cta__body">
          Thoughtful recommendations, seasonal discoveries, and what’s happening across the Mornington Peninsula.
        </p>
        <p class="ptw-cta__sub">Curated and sent occasionally by Peninsula Insider.</p>
        <a class="ptw-cta__button" href="/dispatch/">Join</a>
      </aside>

      {/* ─── Editor's long-form body (existing markdown) ────────────── */}
      <div class="prose ptw-body">
        <Content />
      </div>

      {/* ─── Also on this weekend (live events) ─────────────────────── */}
      {liveThisWeekend.length > 0 && (
        <section class="ptw-also" aria-labelledby="ptw-also-title">
          <div class="ptw-also__head">
            <p class="ptw-also__eyebrow">Also running</p>
            <h2 id="ptw-also-title" class="ptw-also__title">Other things on this weekend</h2>
            <p class="ptw-also__sub">
              Pulled live from our events index. The dispatch above is what we'd actually book; the list below is the wider field.
            </p>
          </div>
          <div class="event-grid">
            {liveThisWeekend.map((e) => <EventCard event={e} />)}
          </div>
          <p class="ptw-also__more">
            <a href="/whats-on/">See the full What's On index →</a>
          </p>
        </section>
      )}

      {latest.data.clusterLinks && latest.data.clusterLinks.length > 0 && (
        <ClusterLinks links={latest.data.clusterLinks} heading="Explore this hub" />
      )}

      {latest.data.faq && latest.data.faq.length > 0 && (
        <section class="article-faq" aria-labelledby="ptw-faq-title">
          <div class="article-faq__header">
            <p class="article-faq__eyebrow">Questions readers actually ask</p>
            <h2 id="ptw-faq-title" class="article-faq__title">FAQ</h2>
          </div>
          <div class="article-faq__items">
            {latest.data.faq.map((item) => (
              <details class="article-faq__item">
                <summary class="article-faq__question">{item.question}</summary>
                <div class="article-faq__answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      {/* ─── Archive ────────────────────────────────────────────────── */}
      {archiveItems.length > 0 && (
        <section id="archive" class="ptw-archive" aria-labelledby="ptw-archive-title">
          <div class="ptw-archive__head">
            <p class="ptw-archive__eyebrow">Past dispatches</p>
            <h2 id="ptw-archive-title" class="ptw-archive__title">The archive</h2>
            <p class="ptw-archive__sub">Each week's dispatch stays online at a stable archive URL.</p>
          </div>
          <ul class="ptw-archive__list">
            {archiveItems.map((entry) => (
              <li class="ptw-archive__item">
                <a class="ptw-archive__link" href={entry.href}>
                  <span class="ptw-archive__date">
                    {entry.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' })}
                  </span>
                  <span class="ptw-archive__body">
                    <span class="ptw-archive__label">{entry.label}</span>
                    {entry.dek && <span class="ptw-archive__dek">{entry.dek}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────── */
  .ptw-hero {
    padding: 2.5rem 0 2rem;
    background: linear-gradient(180deg, rgba(246, 241, 232, 0.4), transparent);
  }
  .ptw-hero__frame {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 980px) {
    .ptw-hero__frame { grid-template-columns: 1.1fr 1fr; gap: 3rem; }
  }
  .ptw-hero__head { display: flex; flex-direction: column; gap: 1.1rem; }
  .ptw-hero__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ptw-hero__pill {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    background: rgba(33, 30, 28, 0.06);
    color: var(--ink, #211e1c);
    border-radius: 2px;
  }
  .ptw-hero__pill--accent {
    background: var(--ink, #211e1c);
    color: #fff;
  }
  .ptw-hero__title {
    margin: 0;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink, #211e1c);
  }
  .ptw-hero__dek {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink-soft, #433d39);
  }
  .ptw-hero__weather {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
    padding: 0.85rem 1rem;
    background: rgba(139, 78, 59, 0.07);
    border-left: 3px solid var(--accent, #8B4E3B);
  }
  .ptw-hero__weather-label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #8B4E3B);
    font-weight: 600;
  }
  .ptw-hero__weather-body {
    font-size: 0.95rem;
    color: var(--ink, #211e1c);
    line-height: 1.5;
  }
  .ptw-hero__cadence {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-soft, #6b6b6b);
    line-height: 1.5;
  }
  .ptw-hero__figure { margin: 0; }
  .ptw-hero__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
  }
  .ptw-hero__credit {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--ink-soft, #7A726A);
    font-style: italic;
  }

  /* ── Editor's line ─────────────────────────────────────────────── */
  .ptw-editor-line {
    margin: 2.5rem auto 1rem;
    max-width: 720px;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-soft, #433d39);
    text-align: center;
  }

  /* ── Picks ─────────────────────────────────────────────────────── */
  .ptw-picks {
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ptw-picks__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 780px) {
    .ptw-picks__row { grid-template-columns: 1fr 1fr; }
  }
  .ptw-shape {
    margin-top: 0.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--ink, #211e1c);
    color: #fff;
  }
  .ptw-shape__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 600;
  }
  .ptw-shape__body {
    margin: 0;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.55;
    color: #fff;
  }

  /* ── Mid-page CTA ──────────────────────────────────────────────── */
  .ptw-cta {
    margin: 3rem auto;
    max-width: 720px;
    padding: 2.25rem 1.75rem;
    text-align: center;
    background: #fbf7ef;
    border-top: 3px solid var(--accent, #8B4E3B);
    border-bottom: 3px solid var(--accent, #8B4E3B);
  }
  .ptw-cta__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #8B4E3B);
    font-weight: 600;
  }
  .ptw-cta__title {
    margin: 0 0 0.75rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.2;
    color: var(--ink, #211e1c);
  }
  .ptw-cta__body {
    margin: 0 0 0.75rem;
    color: var(--ink-soft, #433d39);
    line-height: 1.6;
  }
  .ptw-cta__sub {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--ink-muted, #6E655C);
    font-style: italic;
  }
  .ptw-cta__button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: var(--ink, #211e1c);
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    border-radius: 2px;
    font-weight: 500;
  }
  .ptw-cta__button:hover { background: #000; }

  /* ── Long-form body ────────────────────────────────────────────── */
  .ptw-body {
    margin: 2rem auto 3rem;
    max-width: 720px;
  }

  /* ── Also running ──────────────────────────────────────────────── */
  .ptw-also {
    margin: 3rem 0;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .ptw-also__head { margin-bottom: 1.5rem; }
  .ptw-also__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #8B4E3B);
    font-weight: 600;
  }
  .ptw-also__title {
    margin: 0 0 0.5rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: 1.65rem;
    color: var(--ink, #211e1c);
  }
  .ptw-also__sub {
    margin: 0;
    color: var(--ink-soft, #6b6b6b);
    line-height: 1.5;
  }
  .ptw-also__more {
    margin-top: 1.25rem;
    text-align: right;
  }
  .ptw-also__more a {
    color: var(--accent, #8B4E3B);
    text-decoration: underline;
  }

  /* ── Archive ───────────────────────────────────────────────────── */
  .ptw-archive {
    margin: 3rem 0 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .ptw-archive__head { margin-bottom: 1.5rem; }
  .ptw-archive__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #8B4E3B);
    font-weight: 600;
  }
  .ptw-archive__title {
    margin: 0 0 0.5rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: 1.65rem;
    color: var(--ink, #211e1c);
  }
  .ptw-archive__sub {
    margin: 0;
    color: var(--ink-soft, #6b6b6b);
    line-height: 1.5;
  }
  .ptw-archive__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 760px) {
    .ptw-archive__list { grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
  }
  .ptw-archive__item { margin: 0; }
  .ptw-archive__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    text-decoration: none;
    color: inherit;
  }
  .ptw-archive__link:hover .ptw-archive__label { color: var(--accent, #8B4E3B); }
  .ptw-archive__date {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    color: var(--ink-soft, #6b6b6b);
    min-width: 4.5rem;
  }
  .ptw-archive__body { display: flex; flex-direction: column; gap: 0.25rem; }
  .ptw-archive__label {
    font-weight: 500;
    color: var(--ink, #211e1c);
    line-height: 1.3;
    transition: color 0.12s ease;
  }
  .ptw-archive__dek {
    font-size: 0.88rem;
    color: var(--ink-soft, #6b6b6b);
    line-height: 1.5;
  }
</style>
