---
/**
 * /whats-on/this-weekend/ - rolling URL for Peninsula This Weekend.
 *
 * Per Wave 2 Brief 2 (work/peninsula-insider/wave-2-build-briefs.md): the
 * dispatch lives at a stable URL so AI assistants and external sources can
 * reliably link to "this weekend on the Peninsula". The page selects the
 * latest PTW article at build time.
 *
 * Renders two layers:
 *   1. Structured dispatch UI (hero, weather strip, at-a-glance,
 *      pick cards, archive grid) when `dispatch` frontmatter is present
 *   2. The long-form markdown body of the dispatch article below the cards
 *
 * Past dispatches preserved at /whats-on/this-weekend/archive/{date}/.
 * Legacy /journal/peninsula-this-weekend-{slug}/ URLs redirect into the
 * dated archive (see src/pages/journal/[slug].astro).
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import PiArticleActions from '../../../components/PiArticleActions.astro';
import ClusterLinks from '../../../components/ClusterLinks.astro';
import DispatchPickCard from '../../../components/DispatchPickCard.astro';
import DispatchAtAGlance from '../../../components/DispatchAtAGlance.astro';
import WeekendVerifiedCard from '../../../components/WeekendVerifiedCard.astro';
import {
  selectLatestPtw,
  ptwArchivePath,
  ptwWeekendLabel,
  ptwWeekendFriday,
  ptwWeekendEndIso,
  sortPtwLatestFirst,
} from '../../../lib/peninsula-this-weekend';
import { isPeninsulaThisWeekend } from '../../../lib/peninsula-this-weekend';
import { formatHeroCredit, routeSlug } from '../../../lib/editorial';
import { wallClockToInstant } from '../../../lib/event-occurrence.mjs';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import {
  loadLiveEvents,
  occursInWindow,
  startOfDay,
  weekendWindow,
  type ScopeWindow,
} from '../_data';

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const ptwArticles = sortPtwLatestFirst(allArticles.filter(isPeninsulaThisWeekend));
const latest = selectLatestPtw(allArticles);

if (!latest) {
  throw new Error('Peninsula This Weekend: no weekend-picker articles found in collection.');
}

const { Content } = await render(latest);

const canonical = 'https://peninsulainsider.com.au/whats-on/this-weekend/';
const now = new Date();
const currentWeekend = weekendWindow(now);
const latestWeekendEnd = new Date(ptwWeekendEndIso(latest));
const hasCurrentDispatch = latestWeekendEnd >= startOfDay(now);
const weekendLabel = hasCurrentDispatch ? ptwWeekendLabel(latest) : currentWeekend.label;
const weekendEndIso = hasCurrentDispatch
  ? ptwWeekendEndIso(latest)
  : wallClockToInstant(currentWeekend.end.getUTCFullYear(), currentWeekend.end.getUTCMonth() + 1, currentWeekend.end.getUTCDate(), 23, 59).toISOString();
// The rolling URL may outlive its build. Dated schema belongs on dated archives, not here.
const dispatch = hasCurrentDispatch ? latest.data.dispatch : null;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "What's On", href: '/whats-on/' },
  { label: 'This Weekend' },
];

const latestHero = hasCurrentDispatch
  ? await resolveHero('article', routeSlug(latest), latest.data, 'hero')
  : null;
const fallbackHero = '/images/sourced/place-cape-schanck-01.webp';
const heroStyle = latestHero?.style ?? `background-image: url('${fallbackHero}')`;
const ogImage = latestHero?.src ?? fallbackHero;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: `https://peninsulainsider.com.au${item.href}` } : {}),
  })),
};

const archiveItems = ptwArticles
  .slice(hasCurrentDispatch ? 1 : 0, hasCurrentDispatch ? 5 : 4)
  .map((a) => ({
    href: ptwArchivePath(a),
    label: a.data.title,
    dek: a.data.dek,
    date: a.data.publishedAt,
  }));

// Cadence/refresh string: PTW publishes Sunday-ahead for the upcoming
// weekend (publish + 6, publish + 7). The hero status pill shows when
// this dispatch was last refreshed and what weekend it covers.
const publishedFmt = latest.data.publishedAt.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'short',
});

// Live events for this weekend, pulled from the events collection
// where startDate or endDate falls within the dispatch's Fri-Sun window.
// Lets us show "Also on this weekend" venue/event cards beneath the
// editor's curated picks, without re-editing them by hand each week.
const friday = hasCurrentDispatch ? ptwWeekendFriday(latest) : currentWeekend.start;
const sunday = hasCurrentDispatch ? new Date(friday) : currentWeekend.end;
if (hasCurrentDispatch) sunday.setUTCDate(friday.getUTCDate() + 2);
sunday.setHours(23, 59, 0, 0);
const activeWindow: ScopeWindow = { start: friday, end: sunday, label: weekendLabel };
const dispatchPickEventSlugs = new Set(
  [dispatch?.lead, dispatch?.saturday, dispatch?.sunday, dispatch?.rainyDay]
    .map((p: any) => p?.eventRef)
    .filter(Boolean),
);
const liveEvents = await loadLiveEvents(now);
const weekendQuickOrder: Record<string, number> = {
  'hill-ridge-community-market-september-2026-restart': 0,
  'acoustic-saturdays-peppers-moonah-links-2026': 1,
  'national-works-on-paper-2026-nwop': 2,
};
const liveThisWeekend = liveEvents
  .filter((live) => occursInWindow(live.rule, activeWindow))
  .filter((live) => (live.event.data.dateBasis ?? 'fixed') === 'fixed')
  .filter((live) => live.event.data.verification === 'verified')
  .filter((live) => {
    const checked = live.event.data.lastCheckedDate;
    return checked instanceof Date && now.getTime() - checked.getTime() <= 30 * 86400000;
  })
  .filter((live) => !dispatchPickEventSlugs.has(live.slug))
  .sort((a, b) => (weekendQuickOrder[a.slug] ?? 9) - (weekendQuickOrder[b.slug] ?? 9) || b.appeal - a.appeal || a.title.localeCompare(b.title))
  .map((live) => live.event)
  .slice(0, 6);
const weekendQuickLabels: Record<string, string> = {
  'national-works-on-paper-2026-nwop': 'National Works on Paper',
  'acoustic-saturdays-peppers-moonah-links-2026': 'Acoustic Saturdays',
  'hill-ridge-community-market-september-2026-restart': 'Hill & Ridge Market',
};
const weekendQuickFacts: Record<string, string> = {
  'national-works-on-paper-2026-nwop': 'Sunday · 11am–4pm · Mornington',
  'acoustic-saturdays-peppers-moonah-links-2026': 'Saturday · 5–8pm · Fingal · Free',
  'hill-ridge-community-market-september-2026-restart': 'Saturday · 9am–2pm · Red Hill',
};
const weekendChoiceCues: Record<string, string> = {
  'national-works-on-paper-2026-nwop': 'Choose this for an indoor art stop. The gallery is open 11am-4pm on Sunday.',
  'acoustic-saturdays-peppers-moonah-links-2026': 'After a Fingal or Cape Schanck day, this is the free Saturday evening option.',
  'hill-ridge-community-market-september-2026-restart': 'Produce, makers and live music in Red Hill before a wine-country lunch. Check weather with the organiser.',
};
const flexibleIdeaCopy: Record<string, { label: string; reason: string }> = {
  'bass-flinders-gin-masterclass': {
    label: 'Choose a session',
    reason: 'A two-hour guided class with a take-home blend. The operator calendar holds the actual dates.',
  },
  'pt-leo-estate-sculpture-park': {
    label: 'Check opening hours',
    reason: 'An art-led walk in the wine country. Confirm current park hours before setting out.',
  },
  'peninsula-hot-springs-daily-studio-yoga': {
    label: 'Check the activity timetable',
    reason: 'A slower wellness option. The operator timetable determines which sessions are available.',
  },
};
const flexibleIdeas = liveEvents
  .filter((live) => flexibleIdeaCopy[live.slug])
  .map((live) => ({ ...live, ...flexibleIdeaCopy[live.slug] }));

// Dated ItemList markup would stay stale in a cached static page after Sunday.
export const prerender = true;
---

<BaseLayout
  title="Peninsula This Weekend · Peninsula Insider"
  description="Weekend ideas and checked event details for the Mornington Peninsula. Confirm dates with each organiser before travelling."
  section="whats-on"
  canonical={canonical}
  ogImage={ogImage}
  searchImage={ogImage}
  ogType="article"
  publishedTime={hasCurrentDispatch ? latest.data.publishedAt.toISOString() : undefined}
  modifiedTime={hasCurrentDispatch ? (latest.data.updatedAt ?? latest.data.publishedAt).toISOString() : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <article
    class="article ptw"
    data-weekend-end={weekendEndIso}
    data-source-mode={hasCurrentDispatch ? 'editorial-dispatch' : 'registry-fallback'}
  >

    <!-- ─── Hero ───────────────────────────────────────────────────── -->
    <header class="ptw-hero">
      <div class="container">
        <div class="ptw-hero__frame">
          <div class="ptw-hero__head">
            <div class="ptw-hero__meta">
              <span class="ptw-hero__pill" aria-label="Section">Peninsula This Weekend</span>
              <span class="ptw-hero__pill ptw-hero__pill--accent" data-weekend-current hidden>{weekendLabel}</span>
              <span class="ptw-hero__pill ptw-hero__pill--accent" data-weekend-expired>Edition · {weekendLabel}</span>
            </div>

            {/* A static weekend page must stop presenting dated cards as current after Sunday night. */}
            <p class="ptw-hero__stale" data-weekend-expired>
              This edition covers {weekendLabel}. Check the date with each organiser before travelling, or <a href="/whats-on/">browse the current events index</a>.
            </p>
            <script is:inline>
              (function () {
                var article = document.querySelector('.ptw[data-weekend-end]');
                if (!article) return;
                var end = new Date(article.getAttribute('data-weekend-end'));
                var refresh = function () {
                  var current = !isNaN(end) && Date.now() <= end.getTime();
                  document.querySelectorAll('[data-weekend-current], [data-weekend-dated]').forEach(function (el) { el.hidden = !current; });
                  document.querySelectorAll('[data-weekend-expired]').forEach(function (el) { el.hidden = current; });
                };
                var start = function () {
                  refresh();
                  var delay = end.getTime() - Date.now() + 1;
                  if (delay > 0 && delay < 2147483647) setTimeout(refresh, delay);
                };
                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
                else start();
              })();
            </script>
            <h1 class="ptw-hero__title" data-weekend-current hidden>
              {hasCurrentDispatch ? latest.data.title : 'What’s on this weekend'}
            </h1>
            <h1 class="ptw-hero__title" data-weekend-expired>A Peninsula weekend selection</h1>
            <p class="ptw-hero__dek" data-weekend-current hidden>
              {hasCurrentDispatch
                ? latest.data.dek
                : `${liveThisWeekend.length} source-checked events for ${weekendLabel}. Confirm details with the organiser before travelling.`}
            </p>
            {!hasCurrentDispatch && liveThisWeekend.length > 0 && (
              <nav class="ptw-hero__quick" aria-label="Confirmed weekend events" data-weekend-current hidden>
                {liveThisWeekend.slice(0, 3).map((event) => (
                  <a href={`/whats-on/${routeSlug(event)}/`}>
                    <span><strong>{weekendQuickLabels[routeSlug(event)] ?? event.data.title}</strong><small>{weekendQuickFacts[routeSlug(event)] ?? event.data.suburb}</small></span><span aria-hidden="true">↗</span>
                  </a>
                ))}
              </nav>
            )}

            {dispatch?.weather && (
              <div class="ptw-hero__weather" data-weekend-current hidden>
                <span class="ptw-hero__weather-label">Weekend forecast</span>
                <span class="ptw-hero__weather-body">{dispatch.weather}</span>
              </div>
            )}

            {hasCurrentDispatch ? (
              <>
                <div data-weekend-current hidden><PiArticleActions
                  slug={latest.id}
                  section="whats-on"
                  title={latest.data.title}
                  dek={latest.data.dek}
                  imageUrl={latest.data.heroImage?.src}
                  href="/whats-on/this-weekend/"
                /></div>

                <p class="ptw-hero__cadence" data-weekend-current hidden>
                  <strong>Refreshed {publishedFmt}</strong> for the weekend of <strong>{weekendLabel}</strong>.
                  A new dispatch appears when an edited weekend selection is ready.
                </p>
              </>
            ) : null}
          </div>

          <figure class="ptw-hero__figure">
            <div
              class="ptw-hero__image"
              role="img"
              aria-label={hasCurrentDispatch
                ? latest.data.heroImage.alt
                : 'Cape Schanck at dawn, looking towards Pulpit Rock'}
              style={heroStyle}
            ></div>
            {hasCurrentDispatch && latest.data.heroImage.credit && (
              <figcaption class="ptw-hero__credit">{formatHeroCredit(latest.data.heroImage.credit)}</figcaption>
            )}
            {!hasCurrentDispatch && (
              <figcaption class="ptw-hero__credit">
                Cape Schanck at dawn. <a href="https://commons.wikimedia.org/wiki/File:Cape_schanck_looking_towards_pulpit_rock_at_dawn.jpg" rel="noreferrer">Marshlung / source</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noreferrer">CC BY-SA 4.0</a> · cropped and converted to WebP.
              </figcaption>
            )}
          </figure>
        </div>
      </div>
    </header>

    <div class="container">

      {/* ─── Editor's line ──────────────────────────────────────────── */}
      {dispatch?.editorLine && (
        <p class="ptw-editor-line" data-weekend-dated hidden>{dispatch.editorLine}</p>
      )}

      {/* ─── At a glance ────────────────────────────────────────────── */}
      {dispatch && (
        <div data-weekend-dated hidden><DispatchAtAGlance
          tiles={[
            { eyebrow: 'The lead', title: dispatch.lead.title, anchorId: 'lead' },
            ...(dispatch.saturday ? [{ eyebrow: 'Saturday', title: dispatch.saturday.title, anchorId: 'saturday' }] : []),
            ...(dispatch.sunday ? [{ eyebrow: 'Sunday', title: dispatch.sunday.title, anchorId: 'sunday' }] : []),
          ]}
        /></div>
      )}

      {/* ─── Pick cards ─────────────────────────────────────────────── */}
      {dispatch && (
        <section class="ptw-picks" aria-label="Weekend picks" data-weekend-dated hidden>
          <div id="lead">
            <DispatchPickCard
              eyebrow="The lead booking"
              rank="01"
              variant="lead"
              pick={dispatch.lead}
            />
          </div>

          <div class="ptw-picks__row">
            {dispatch.saturday && (
              <div id="saturday">
                <DispatchPickCard
                  eyebrow="Saturday"
                  rank="02"
                  pick={dispatch.saturday}
                />
              </div>
            )}
            {dispatch.sunday && (
              <div id="sunday">
                <DispatchPickCard
                  eyebrow="Sunday"
                  rank="03"
                  pick={dispatch.sunday}
                />
              </div>
            )}
          </div>

          {dispatch.rainyDay && (
            <div id="rainy-day">
              <DispatchPickCard
                eyebrow="If the weather changes"
                rank="04"
                variant="backup"
                pick={dispatch.rainyDay}
              />
            </div>
          )}

          {dispatch.weekendShape && (
            <aside class="ptw-shape">
              <p class="ptw-shape__eyebrow">Weekend shape</p>
              <p class="ptw-shape__body">{dispatch.weekendShape}</p>
            </aside>
          )}
        </section>
      )}

      {!hasCurrentDispatch && (
        <section class="ptw-current" aria-labelledby="ptw-current-title" data-weekend-dated hidden>
          <div class="ptw-also__head">
            <p class="ptw-also__eyebrow">Dates we could verify</p>
            <h2 id="ptw-current-title" class="ptw-also__title">Confirmed for this weekend</h2>
            <p class="ptw-also__sub">
              These dated listings had recent source checks. Confirm opening times and bookings with the organiser before travelling.
            </p>
          </div>
          {liveThisWeekend.length > 0 ? (
            <div class="event-grid">
              {liveThisWeekend.map((event) => <WeekendVerifiedCard event={event} choiceCue={weekendChoiceCues[routeSlug(event)]} />)}
            </div>
          ) : (
            <p class="ptw-current__empty">
              We have no dated listing with a recent source check for this weekend. <a href="/whats-on/">Browse the full events index</a>.
            </p>
          )}
        </section>
      )}

      {!hasCurrentDispatch && flexibleIdeas.length > 0 && (
        <section class="ptw-flex" aria-labelledby="ptw-flex-title">
          <div class="ptw-also__head">
            <p class="ptw-also__eyebrow">Choose your own timing</p>
            <h2 id="ptw-flex-title" class="ptw-also__title">Experiences worth checking</h2>
            <p class="ptw-also__sub">These are not confirmed weekend sessions. Check a date or opening hours with each operator before making a plan.</p>
          </div>
          <div class="ptw-flex__grid">
            {flexibleIdeas.map((idea, index) => (
              <article class="ptw-flex__card">
                <span class="ptw-flex__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p class="ptw-flex__label">{idea.label}</p>
                <h3><a href={idea.href}>{idea.title}</a></h3>
                <p>{idea.reason}</p>
                {idea.event.data.primarySourceUrl && <a class="ptw-flex__source" href={idea.event.data.primarySourceUrl} rel="noreferrer">Check with the operator ↗</a>}
              </article>
            ))}
          </div>
        </section>
      )}

      {/* ─── Editor's long-form body (existing markdown) ────────────── */}
      {hasCurrentDispatch && (
        <div class="prose ptw-body" data-weekend-dated hidden>
          <Content />
        </div>
      )}

      {/* ─── Also on this weekend (live events) ─────────────────────── */}
      {hasCurrentDispatch && liveThisWeekend.length > 0 && (
        <section class="ptw-also" aria-labelledby="ptw-also-title" data-weekend-dated hidden>
          <div class="ptw-also__head">
            <p class="ptw-also__eyebrow">Also running</p>
            <h2 id="ptw-also-title" class="ptw-also__title">Other things on this weekend</h2>
            <p class="ptw-also__sub">
              Pulled live from our events index. The dispatch above is what we'd actually book; the list below is the wider field.
            </p>
          </div>
          <div class="event-grid">
            {liveThisWeekend.map((e) => <WeekendVerifiedCard event={e} choiceCue={weekendChoiceCues[routeSlug(e)]} />)}
          </div>
          <p class="ptw-also__more">
            <a href="/whats-on/">See the full What's On index →</a>
          </p>
        </section>
      )}

      {hasCurrentDispatch && latest.data.clusterLinks && latest.data.clusterLinks.length > 0 && (
        <ClusterLinks links={latest.data.clusterLinks} heading="Explore this hub" />
      )}

      {hasCurrentDispatch && latest.data.faq && latest.data.faq.length > 0 && (
        <section class="article-faq" aria-labelledby="ptw-faq-title" data-weekend-dated hidden>
          <div class="article-faq__header">
            <p class="article-faq__eyebrow">Questions readers actually ask</p>
            <h2 id="ptw-faq-title" class="article-faq__title">FAQ</h2>
          </div>
          <div class="article-faq__items">
            {latest.data.faq.map((item) => (
              <details class="article-faq__item">
                <summary class="article-faq__question">{item.question}</summary>
                <div class="article-faq__answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      {/* ─── Archive ────────────────────────────────────────────────── */}
      {archiveItems.length > 0 && (
        <section id="archive" class="ptw-archive" aria-labelledby="ptw-archive-title">
          <div class="ptw-archive__head">
            <p class="ptw-archive__eyebrow">Past dispatches</p>
            <h2 id="ptw-archive-title" class="ptw-archive__title">The archive</h2>
            <p class="ptw-archive__sub">Each week's dispatch stays online at a stable archive URL.</p>
          </div>
          <ul class="ptw-archive__list">
            {archiveItems.map((entry) => (
              <li class="ptw-archive__item">
                <a class="ptw-archive__link" href={entry.href}>
                  <span class="ptw-archive__date">
                    {entry.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' })}
                  </span>
                  <span class="ptw-archive__body">
                    <span class="ptw-archive__label">{entry.label}</span>
                    {entry.dek && <span class="ptw-archive__dek">{entry.dek}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────── */
  .ptw-hero {
    padding: 1.25rem 0 1.75rem;
    background: linear-gradient(180deg, rgba(246, 241, 232, 0.4), transparent);
  }
  .ptw-hero__frame {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 980px) {
    .ptw-hero__frame { grid-template-columns: 1.1fr 1fr; gap: 3rem; }
  }
  .ptw-hero__head { display: flex; flex-direction: column; gap: 1.1rem; }
  .ptw-hero__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ptw-hero__pill {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    background: rgba(33, 30, 28, 0.06);
    color: var(--ink, #211e1c);
    border-radius: 2px;
  }
  .ptw-hero__pill--accent {
    background: var(--ink, #211e1c);
    color: #fff;
  }
  .ptw-hero__stale {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.85rem;
    font-size: 0.95rem;
    line-height: 1.5;
    background: rgba(11, 90, 72, 0.08);
    border-left: 2px solid var(--accent, var(--accent));
    color: var(--ink, #211e1c);
  }
  .ptw-hero__stale a {
    color: var(--accent, var(--accent));
    text-decoration: underline;
  }
  .ptw-hero__title {
    margin: 0;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink, #211e1c);
  }
  .ptw-hero__dek {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink-soft, #433d39);
  }
  .ptw-hero__weather {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
    padding: 0.85rem 1rem;
    background: rgba(11, 90, 72, 0.07);
    border-left: 3px solid var(--accent, var(--accent));
  }
  .ptw-hero__weather-label {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, var(--accent));
    font-weight: 600;
  }
  .ptw-hero__weather-body {
    font-size: 0.95rem;
    color: var(--ink, #211e1c);
    line-height: 1.5;
  }
  .ptw-hero__cadence {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-soft, #6b6b6b);
    line-height: 1.5;
  }
  .ptw-hero__figure { margin: 0; }
  .ptw-hero__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
  }
  @media (min-width: 980px) { .ptw-hero__image { aspect-ratio: 3 / 2; } }
  .ptw-hero__credit {
    margin-top: 0.4rem;
    font-size: 0.75rem;
