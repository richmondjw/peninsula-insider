---
/**
 * /whats-on/this-weekend/archive/[YYYY-MM-DD]/ - per-week PTW archive.
 *
 * Each Peninsula This Weekend dispatch keeps a stable archive URL so
 * AI assistants and external links can resolve a specific weekend
 * forever. The slug is the ISO date (YYYY-MM-DD) derived from the
 * article's publishedAt - sortable, machine-readable, and stable
 * across editorial rewrites.
 *
 * Per Wave 2 Brief 2.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../../../components/NewsletterBlock.astro';
import PiArticleActions from '../../../../components/PiArticleActions.astro';
import ClusterLinks from '../../../../components/ClusterLinks.astro';
import {
  isPeninsulaThisWeekend,
  ptwArchiveSlug,
  ptwArchivePath,
  ptwWeekendLabel,
  buildPtwEventSchema,
  sortPtwLatestFirst,
} from '../../../../lib/peninsula-this-weekend';
import { formatHeroCredit, routeSlug } from '../../../../lib/editorial';
import { resolveHero } from '../../../../lib/inline-edit/resolve-hero';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles
    .filter(isPeninsulaThisWeekend)
    .map((article) => ({
      params: { slug: ptwArchiveSlug(article) },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const archiveSlug = ptwArchiveSlug(article);
const canonical = `https://peninsulainsider.com.au/whats-on/this-weekend/archive/${archiveSlug}/`;
const weekendLabel = ptwWeekendLabel(article);
const eventSchema = buildPtwEventSchema(article, canonical);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "What's On", href: '/whats-on' },
  { label: 'This Weekend', href: '/whats-on/this-weekend' },
  { label: weekendLabel },
];

const articleHero = await resolveHero('article', routeSlug(article), article.data, 'hero');
const heroStyle = articleHero.style;
const ogImage = articleHero.src;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: `https://peninsulainsider.com.au${item.href}` } : {}),
  })),
};

// Adjacent dispatches for prev/next nav within the archive.
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const allPtw = sortPtwLatestFirst(allArticles.filter(isPeninsulaThisWeekend));
const idx = allPtw.findIndex((a) => ptwArchiveSlug(a) === archiveSlug);
const newer = idx > 0 ? allPtw[idx - 1] : null;
const older = idx >= 0 && idx < allPtw.length - 1 ? allPtw[idx + 1] : null;
export const prerender = true;
---

<BaseLayout
  title={`Peninsula This Weekend - ${weekendLabel} · Peninsula Insider`}
  description={article.data.dek}
  section="journal"
  canonical={canonical}
  ogImage={ogImage}
  searchImage={ogImage}
  ogType="article"
  publishedTime={article.data.publishedAt.toISOString()}
  modifiedTime={(article.data.updatedAt ?? article.data.publishedAt).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <article class="article ptw ptw--archive">
    <header class="article-hero">
      <div class="container">
        <div class="article-hero__frame">
          <div class="article-hero__head">
            <div class="article-hero__meta">
              <span class="article-hero__format">Peninsula This Weekend · Archive</span>
              <span class="article-hero__sep" aria-hidden="true"></span>
              <span class="article-hero__date">{weekendLabel}</span>
            </div>
            <h1 class="article-hero__title">{article.data.title}</h1>
            <p class="article-hero__dek">{article.data.dek}</p>
            <p class="ptw__archive-note">
              This is an archived weekend dispatch. The current weekend lives at
              <a href="/whats-on/this-weekend/">/whats-on/this-weekend/</a>.
            </p>
            <PiArticleActions
              slug={article.id}
              section="journal"
              title={article.data.title}
              dek={article.data.dek}
              imageUrl={article.data.heroImage?.src}
            />
          </div>
          <figure class="article-hero__figure">
            <div class="article-hero__image" role="img" aria-label={article.data.heroImage.alt} style={heroStyle}></div>
            {article.data.heroImage.credit && (
              <figcaption class="article-hero__credit">{formatHeroCredit(article.data.heroImage.credit)}</figcaption>
            )}
          </figure>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="prose has-drop-cap">
        <Content />
      </div>

      {article.data.clusterLinks && article.data.clusterLinks.length > 0 && (
        <ClusterLinks links={article.data.clusterLinks} heading="Explore this hub" />
      )}

      {article.data.faq && article.data.faq.length > 0 && (
        <section class="article-faq" aria-labelledby="ptw-archive-faq-title">
          <div class="article-faq__header">
            <p class="article-faq__eyebrow">Questions readers actually ask</p>
            <h2 id="ptw-archive-faq-title" class="article-faq__title">FAQ</h2>
          </div>
          <div class="article-faq__items">
            {article.data.faq.map((item) => (
              <details class="article-faq__item">
                <summary class="article-faq__question">{item.question}</summary>
                <div class="article-faq__answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <nav class="ptw-archive-nav" aria-label="Adjacent weekend dispatches">
        {older && (
          <a class="ptw-archive-nav__link ptw-archive-nav__link--prev" href={ptwArchivePath(older)}>
            <span class="ptw-archive-nav__dir">← Older weekend</span>
            <span class="ptw-archive-nav__title">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a class="ptw-archive-nav__link ptw-archive-nav__link--next" href={ptwArchivePath(newer)}>
            <span class="ptw-archive-nav__dir">Newer weekend →</span>
            <span class="ptw-archive-nav__title">{newer.data.title}</span>
          </a>
        )}
      </nav>

    </div>
  </article>

  <NewsletterBlock />
</BaseLayout>

<style>
  .ptw__archive-note {
    margin: 0.75rem 0 1rem;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.03);
    border-left: 3px solid var(--accent, #4ab89e);
    font-size: 0.95rem;
    color: var(--ink-soft, #6b6b6b);
    line-height: 1.5;
  }
  .ptw__archive-note a {
    color: inherit;
    text-decoration: underline;
  }
  .ptw-archive-nav {
    margin: 3rem 0 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .ptw-archive-nav {
      grid-template-columns: 1fr 1fr;
    }
    .ptw-archive-nav__link--next {
      text-align: right;
    }
  }
  .ptw-archive-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .ptw-archive-nav__link:hover {
    border-color: rgba(0, 0, 0, 0.18);
  }
  .ptw-archive-nav__dir {
    font-size: 0.85rem;
    color: var(--ink-soft, #6b6b6b);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ptw-archive-nav__title {
    font-weight: 500;
    line-height: 1.35;
  }
</style>
