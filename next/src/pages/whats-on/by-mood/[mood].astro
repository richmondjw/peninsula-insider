---
/**
 * /whats-on/by-mood/[mood]/ - chip landing pages.
 *
 * One template renders all five mood pages by reading the chip definition
 * from src/lib/events.ts. Each chip has its own filter, sort, eyebrow,
 * heading, and framing copy.
 *
 * Emits ItemList JSON-LD so search engines understand the curated list.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EventCard from '../../../components/EventCard.astro';
import EventChipBar from '../../../components/EventChipBar.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import { chips, eventsForChip, getChip } from '../../../lib/events';
import { routeSlug } from '../../../lib/editorial';
import { loadLiveEvents } from '../_data';

export async function getStaticPaths() {
  return chips.map((chip) => ({
    params: { mood: chip.slug },
    props: { chipSlug: chip.slug },
  }));
}

const { chipSlug } = Astro.props;
const chip = getChip(chipSlug);
if (!chip) {
  throw new Error(`Unknown chip slug: ${chipSlug}`);
}

// Pull the same date- and status-qualified event set as the What's On hub so
// an archived record can never leak into an otherwise indexable mood lane.
const now = new Date();
const allEvents = (await loadLiveEvents(now)).map(({ event }) => event);

const events = eventsForChip(chip, allEvents);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "What's On", href: '/whats-on/' },
  { label: chip.label },
];

const SITE_URL = 'https://peninsulainsider.com.au';
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${chip.label} - Peninsula Insider events`,
  description: chip.framing,
  itemListElement: events.map((event, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_URL}/whats-on/${routeSlug(event)}/`,
    name: event.data.title,
  })),
};
export const prerender = true;
---

<BaseLayout
  title={`${chip.label} - Peninsula Insider events`}
  description={chip.framing}
  section="whats-on"
  canonical={`${SITE_URL}/whats-on/by-mood/${chip.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <section class="mood-hero">
    <div class="container">
      <p class="mood-hero__eyebrow">{chip.eyebrow}</p>
      <h1 class="mood-hero__heading">{chip.heading}</h1>
      <p class="mood-hero__framing">{chip.framing}</p>
      <EventChipBar active={chip.slug} />
    </div>
  </section>

  <section class="mood-events">
    <div class="container">
      {events.length === 0 ? (
        <p class="mood-events__empty">
          No events match this filter for the upcoming window. Check back, or try
          <a href="/whats-on/">all events</a>.
        </p>
      ) : (
        <div class="mood-events__grid">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      )}
    </div>
  </section>

  <NewsletterBlock

    body="Thoughtful recommendations, seasonal discoveries, and what’s happening across the Mornington Peninsula."
    sub="The Peninsula worth knowing. Weekly."
  />
</BaseLayout>

<style>
  .mood-hero {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    padding: clamp(2.5rem, 5vw, 4rem) 0 1.5rem;
  }

  .mood-hero__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }

  .mood-hero__heading {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--text);
    margin: 0 0 0.75rem;
    letter-spacing: -0.015em;
  }

  .mood-hero__framing {
    font-family: var(--font-ui);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--soft);
    margin: 0 0 1.5rem;
    max-width: 70ch;
  }

  .mood-events {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .mood-events__empty {
    font-family: var(--font-ui);
    color: var(--soft);
    text-align: center;
    padding: 2rem 0;
  }
  .mood-events__empty a {
    color: var(--accent);
    text-decoration: underline;
  }

  .mood-events__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }
</style>
