---
import {occurrenceData} from '../../lib/intelligence-series.mjs';
import { pageImage } from '../../lib/page-images';
import { eventContentKind } from '../../lib/event-publication.mjs';
/**
 * /whats-on/ - the canonical When front door (v5 rebuild, T-601).
 *
 * Structure per page-redesigns-hubs.md section 7 + wireframes #whatson:
 *   1. h1 date context + selection rule (one line)
 *   2. Scope controls: This weekend (default, in-DOM) / Next weekend /
 *      Pick dates / School holidays
 *   3. PI's picks: up to 3 recently checked choices, Local voice verdicts
 *   4. Day-grouped compact rows for the current scope (weekend is fully
 *      server-rendered; other scopes render client-side from feed.json)
 *   5. Shelf anchor links + category shelves (Markets, Live music,
 *      Food & wine, Openings, Major events)
 *   6. Month+ on demand via the JSON island at /whats-on/feed.json
 *      (HUB-11 closed: zero hidden pre-rendered cards)
 *
 * Event JSON-LD kept; NO price offers are emitted (house rule).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import WhatsOnScopeBar from '../../components/v5/whatson/WhatsOnScopeBar.astro';
import WhatsOnRow from '../../components/v5/whatson/WhatsOnRow.astro';
import TrustNote from '../../components/v5/hub/TrustNote.astro';
import {
  loadLiveEvents,
  isDatedCalendarEvent,
  weekendWindow,
  schoolHolidayWindow,
  groupByDay,
  getPicks,
  getShelves,
  isoDate,
  startOfDay,
  type OccurrenceState,
} from './_data';
import { getAustralianSeasonLower } from '../../lib/season';
import { eventCategoryLabel } from '../../lib/editorial';

export const prerender = true;

const now = new Date();
const events = await loadLiveEvents(now);
const calendarEvents = events.filter(isDatedCalendarEvent);
const flexibleExperiences = events.filter((live) => eventContentKind(live.event.data) === 'experience').slice(0, 4);

const weekend = weekendWindow(now);
const nextWeekend = weekendWindow(now, 1);
const holidays = schoolHolidayWindow(now);

const picks = await getPicks(calendarEvents, weekend, now);
const pickHeading = ['A reason to go', 'A reason to go', 'Two reasons to go', 'Three reasons to go'][Math.min(picks.length, 3)];
const pickSlugs = new Set(picks.map((p) => p.live.slug));

const dayGroups = groupByDay(calendarEvents, weekend, now);
const weekendCount = dayGroups.reduce((n, g) => n + g.items.length, 0);

const shelves = getShelves(calendarEvents, now, pickSlugs).filter((s) => s.items.length > 0);
const shelfVisuals = shelves.map((shelf, index) => {
  // Prefer an actual listed venue. A vetted regional category image may set
  // the scene, with its subject named in the caption, but never presents
  // itself as artwork for a specific event in the shelf.
  const source = shelf.items.find((item) => {
    const photo = (item.event.data as Record<string, any>).heroImage;
    return photo?.src && photo?.alt && photo?.credit && photo?.rightsStatus === 'recorded' && photo?.depictionStatus === 'actual';
  });
  const photo = source ? (source.event.data as Record<string, any>).heroImage : null;
  // The old markets hero depicts a venue whose current operation is unresolved.
  // Do not imply that it is a current featured event in this discovery rail.
  const regionalKey = ({ 'food-wine': 'wine-hub' } as Record<string, string>)[shelf.id];
  const regional = !photo && regionalKey ? pageImage(regionalKey) : null;
  return {
    id: shelf.id,
    label: shelf.label,
    count: shelf.items.length,
    index: String(index + 1).padStart(2, '0'),
    photo: photo || regional ? {
      src: String(photo?.src ?? regional!.src),
      alt: String(photo?.alt ?? regional!.alt),
      caption: String(photo?.caption ?? photo?.depicts ?? regional?.caption ?? source?.title),
      credit: String(photo?.credit ?? regional!.credit),
    } : null,
  };
});

// ── JSON-LD: Event nodes for everything server-rendered (picks + weekend
// rows), deduped. Deliberately no offers: pricing never ships in schema
// or copy (house rule; priceBand chips only elsewhere).
const SITE_ORIGIN = 'https://peninsulainsider.com.au';
const truncate = (text: unknown, n = 200): string => {
  const s = String(text ?? '').replace(/\s+/g, ' ').trim();
  return s.length <= n ? s : `${s.slice(0, n - 1).trimEnd()}…`;
};
const ldSeen = new Set<string>();
const ldEvents: Record<string, any>[] = [];
// PI-008: the ItemList used to stamp EventScheduled on every node, so a
// sold-out night and a cancelled market both told search engines they were
// going ahead as normal. Status now comes from the same resolver the page
// renders from, and a finished occurrence emits no status at all (an
// EventScheduled with a past endDate is what lint-seo-architecture.mjs fails
// the build over).
//
// That was half done. The helper that lived here re-derived the status from
// the raw `cancelled` flag: one of the four signals that record a cancellation,
// and none of the occurrence-level exceptions at all. A weekly market cancelled
// for a single Thursday would have rendered "Cancelled this time" with
// EventScheduled in the markup beside it. The state _data.ts resolved is now
// the only answer on this page.
const pushLd = (
  live: (typeof events)[number],
  occursISO: string,
  state: OccurrenceState
) => {
  if (ldSeen.has(live.slug)) return;
  ldSeen.add(live.slug);
  const data = (occurrenceData(live.event.data, occursISO) ?? live.event.data) as Record<string, any>;
  if (eventContentKind(data) !== 'event') return;
  const heroSrc = data.heroImage?.src;
  const imageUrl = heroSrc
    ? heroSrc.startsWith('http')
      ? heroSrc
      : `${SITE_ORIGIN}${heroSrc}`
    : undefined;
  ldEvents.push({
    '@type': 'Event',
    name: data.title,
    startDate: occursISO,
    url: `${SITE_ORIGIN}${live.href}`,
    ...(imageUrl ? { image: imageUrl } : {}),
    description: truncate(data.summary),
    ...(state.schemaStatus ? { eventStatus: state.schemaStatus } : {}),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: data.venueName || data.suburb || 'Mornington Peninsula',
      address: {
        '@type': 'PostalAddress',
        ...(data.streetAddress ? { streetAddress: data.streetAddress } : {}),
        addressLocality: data.suburb || data.venueRegion || 'Mornington Peninsula',
        addressRegion: 'VIC',
        addressCountry: 'AU',
      },
    },
  });
};
for (const p of picks) pushLd(p.live, p.dateISO, p.occurrence);
for (const g of dayGroups) {
  for (const it of g.items) {
    pushLd(it.live, g.iso, it);
  }
}
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "What's On Mornington Peninsula",
  url: `${SITE_ORIGIN}/whats-on/`,
  numberOfItems: ldEvents.length,
  itemListElement: ldEvents.map((ev, i) => ({ '@type': 'ListItem', position: i + 1, item: ev })),
};

// Pick cards, precomputed here: the Astro compiler cannot parse TS generics
// inside template expressions, and the template stays declarative this way.
const pickCards = picks.map((p, i) => {
  const data = p.live.event.data as Record<string, any>;
  return {
    title: p.live.title,
    href: p.live.href,
    slug: p.live.slug,
    image: data.heroImage
      ? { src: data.heroImage.src as string, alt: (data.heroImage.alt ?? p.live.title) as string,
          caption: data.heroImage.caption as string | undefined, credit: data.heroImage.credit as string | undefined }
      : undefined,
    verdict: p.verdict,
    categoryLabel: p.live.categoryLabel,
    leadMark: [p.dayLabel, p.live.placeLabel].filter(Boolean).join(' · '),
    meta: [p.dayLabel, p.live.placeLabel, p.live.accessLabel ?? p.live.categoryLabel]
      .filter(Boolean)
      .slice(0, 3),
    dateISO: p.dateISO,
    position: i + 1,
  };
});

const season = getAustralianSeasonLower(now);
const todayISO = isoDate(startOfDay(now));
const townOptions = [...new Set(calendarEvents.map((entry) => entry.event.data.suburb).filter((town): town is string => typeof town === 'string' && town.trim().length > 0))].sort((a, b) => a.localeCompare(b));
const categoryOptions = [...new Set(calendarEvents.map((entry) => entry.event.data.category))]
  .map((category) => ({ value: category, label: eventCategoryLabel[category] ?? category }))
  .sort((a, b) => a.label.localeCompare(b.label));
const modifiedTime = todayISO;
const pageDescription = `Browse Mornington Peninsula events by date: markets, live music, exhibitions and festivals. Choose this weekend, school holidays or your own dates.`;
// The photo at the top must depict a currently listed pick. The verified
// Peninsula Hot Springs venue image is suitable when that pick is present;
// otherwise use an explicitly captioned regional scene, not an unverified
// market that could be mistaken for a live event.
const hubImage = picks.some((pick) => pick.live.slug === 'peninsula-hot-springs-sunday-sessions-spring-2026')
  ? pageImage('spas-hub')
  : pageImage('explore-hub');
---

<BaseLayout
  title="What's On Mornington Peninsula | Events Calendar"
  description={pageDescription}
  section="whats-on"
  canonical="https://peninsulainsider.com.au/whats-on"
  ogImage={hubImage.src}
  modifiedTime={modifiedTime}
>
  <script data-wo-event-schema type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <header class="wo-head">
    <div class="container wo-head__inner">
      <div class="wo-head__copy">
        <p class="wo-head__eyebrow">The Peninsula, in motion <span aria-hidden="true">✳</span> {season} edition</p>
        <h1 class="wo-head__title" data-wo-heading>What's on this weekend</h1>
        <p class="wo-head__context"><span data-wo-range>{weekend.label}</span> · Mornington Peninsula</p>
        <p class="wo-head__rule">Find the date, place and reason to go, then check with the organiser before you head out.</p>
        <a class="wo-head__calendar-link" href="#wo-calendar">Browse events by day <span aria-hidden="true">↘</span></a>
        <p class="wo-head__credit-mobile">Photo: {hubImage.credit}.</p>
      </div>
      <figure class="wo-head__figure">
        <img src={hubImage.src} alt={hubImage.alt} width="960" height="640" fetchpriority="high" decoding="async" data-pi-responsive="(max-width: 640px) 320px, (max-width: 1023px) 600px, 720px" />
        <figcaption>{hubImage.caption} Photo: {hubImage.credit}.</figcaption>
      </figure>
    </div>
  </header>

  <div class="container wo-scope-wrap">
    <WhatsOnScopeBar
      weekendStartISO={isoDate(weekend.start)}
      weekendLabel={weekend.label}
      nextWeekendLabel={nextWeekend.label}
      holidays={holidays
        ? {
            startISO: isoDate(holidays.start),
            endISO: isoDate(holidays.end),
            label: holidays.label,
            name: holidays.name,
          }
        : null}
      todayISO={todayISO}
    />
    <details class="wo-filter-disclosure" data-wo-filter-disclosure hidden>
      <summary>Search and filter events</summary>
    <form class="wo-filters" data-wo-filters role="search" aria-label="Find an event" hidden>
      <label class="wo-filters__search">Search events
        <input type="search" name="q" placeholder="Event or venue" autocomplete="off" />
      </label>
      <label>Town
        <select name="town"><option value="">Any town</option>{townOptions.map((town) => <option value={town}>{town}</option>)}</select>
      </label>
      <label>Category
        <select name="category"><option value="">All categories</option>{categoryOptions.map((category) => <option value={category.value}>{category.label}</option>)}</select>
      </label>
      <label class="wo-filters__check"><input type="checkbox" name="free" /> Free entry</label>
      <label class="wo-filters__check"><input type="checkbox" name="kids" /> With kids</label>
      <button type="button" class="wo-filters__clear" data-wo-filter-reset>Clear filters</button>
    </form>
    </details>
    <TrustNote surface="whatson" />
  </div>

  {picks.length > 0 && (
    <section class="wo-picks" aria-labelledby="wo-picks-h">
      <div class="container">
        <div class="wo-picks__head">
          <div>
            <p class="wo-section-kicker">The short list / {weekend.label}</p>
            <h2 class="wo-picks__title" id="wo-picks-h">{pickHeading}</h2>
          </div>
          <p class="wo-picks__dek">Our edit of the weekend. Open an event for the details, then confirm with its organiser.</p>
        </div>
        {picks.length > 1 && <p class="wo-picks__swipe">Swipe or scroll for more picks.</p>}
        <CardGrid label="PI's picks for this weekend">
          {pickCards.map((c) => (
            <Card
              variant="event"
              title={c.title}
              href={c.href}
              entityType="event"
              entitySlug={c.slug}
              image={c.image}
              verdict={c.verdict}
              meta={c.meta}
              dateISO={c.dateISO}
              showEyebrow={c.position === 1}
              typeMark={c.leadMark}
              mediaFallback={c.position !== 1}
              mediaFallbackLabel={c.categoryLabel}
              trip={true}
              surface="whatson"
              position={c.position}
            />
          ))}
        </CardGrid>
        <a class="wo-picks__all" href="#wo-calendar">Explore the full calendar <span aria-hidden="true">↘</span></a>
      </div>
    </section>
  )}

  <section class="wo-days" id="wo-calendar" aria-label="Everything on for the selected dates">
    <div class="container">
      <div class="wo-days__head">
        <div>
          <p class="wo-section-kicker">Make a day of it</p>
          <h2 class="wo-days__title">Everything on, by day</h2>
        </div>
        <p class="wo-days__hint">Browse by date and save what catches your eye.</p>
        <p id="pi-results-status" class="wo-vh" role="status" aria-live="polite"></p>
      </div>
      <div data-wo-days data-wo-default-count={weekendCount}>
        {dayGroups.map((g) => (
          <section class="wo-day">
            <h3 class="wo-day__h">{g.heading}</h3>
            {g.items.length > 0 ? (
              <ul class="wo-day__list" role="list">
                {g.items.map((it) => (
                  <WhatsOnRow
                    title={it.live.title}
                    href={it.live.href}
                    slug={it.live.slug}
                    oneLiner={it.live.oneLiner}
                    meta={it.live.meta}
                    spanLabel={it.spanLabel}
                    statusLabel={it.statusLabel}
                    phase={it.phase}
                    bookable={it.bookable}
                  />
                ))}
              </ul>
            ) : (
              <p class="wo-day__empty">{g.emptyMessage}</p>
            )}
          </section>
        ))}
      </div>
      <p class="wo-more">
        <button type="button" class="pi-btn pi-btn--ghost" data-wo-month data-evt="wo_date_change" hidden>
          Load the month ahead
        </button>
        <noscript>
          <span class="wo-more__noscript">
            Longer horizons load with JavaScript on; the weekend above is the complete current edit.
          </span>
        </noscript>
      </p>
    </div>
  </section>

  {flexibleExperiences.length > 0 && (
    <section class="wo-flexible" aria-labelledby="wo-flexible-h">
      <div class="container">
        <p class="wo-section-kicker">Choose your own timing</p>
        <h2 class="wo-shelves__title" id="wo-flexible-h">Experiences to check</h2>
        <p class="wo-flexible__intro">These are not confirmed sessions for the dates above. Check the operator's dates or opening hours before making a plan.</p>
        <ul class="wo-shelf__list" role="list">
          {flexibleExperiences.map((live) => (
            <WhatsOnRow title={live.title} href={live.href} slug={live.slug} oneLiner={live.oneLiner} meta={['Check dates and hours', live.placeLabel, live.categoryLabel].filter(Boolean)} />
          ))}
        </ul>
      </div>
    </section>
  )}

  {shelves.length > 0 && (
    <section class="wo-shelves" aria-labelledby="wo-shelves-h">
      <div class="container">
        <h2 class="wo-shelves__title" id="wo-shelves-h">Browse the next two months</h2>
        <nav class="wo-shelfnav" aria-label="Explore event categories">
          {shelfVisuals.map((s) => (
            <div class="wo-shelfnav__tile">
              <a class="wo-shelfnav__link" href={`#${s.id}`} aria-label={`Explore ${s.label}, ${s.count} featured events`}>
                <span class="wo-shelfnav__media" aria-hidden="true">
                  {s.photo ? (
                    <img src={s.photo.src} alt="" loading="lazy" decoding="async" width="400" height="300" data-pi-responsive="(max-width: 767px) 55vw, 20vw" />
                  ) : (
                    <span class="wo-shelfnav__mark">{s.index}</span>
                  )}
                </span>
                <span class="wo-shelfnav__info"><strong>{s.label}</strong><span>{s.count} featured <span aria-hidden="true">↗</span></span></span>
              </a>
              {s.photo && <p class="wo-shelfnav__credit">{s.photo.caption} · Photo: {s.photo.credit}.</p>}
            </div>
          ))}
        </nav>
        {shelves.map((s) => (
          <section class="wo-shelf" id={s.id} aria-labelledby={`${s.id}-h`}>
            <h3 class="wo-shelf__h" id={`${s.id}-h`}>{s.label}</h3>
            <ul class="wo-shelf__list" role="list">
              {s.items.map((live) => (
                <WhatsOnRow
                  title={live.title}
                  href={live.href}
                  slug={live.slug}
                  oneLiner={live.oneLiner}
                  meta={live.meta}
                />
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  )}

  <NewsletterBlock />

  {/* Row template for client-side scope rendering: cloned by the script
      below, never displayed. Template content is inert (not hidden DOM
      weight in the HUB-11 sense: one empty row, no event content). */}
  <template data-wo-row-template>
    <WhatsOnRow title="" href="" slug="" />
  </template>
</BaseLayout>

<script>
  import { feedHasCurrentFreeEntry, currentFreePrice } from '../../lib/event-discovery.mjs';
  // ── /whats-on/ scope engine ──────────────────────────────────────────
  // Default (this weekend) is fully server-rendered. Every other scope
  // fetches /whats-on/feed.json once and renders compact rows from it:
  // the month+ horizon is a JSON island, never hidden DOM (HUB-11).
  import { initV5Analytics } from '../../lib/v5-analytics';
  import { tripAdd } from '../../lib/v5-store';
  import { startOfDay, addDays, rangeLabel, weekendWindow, occursOnDay, isoDate } from '../../lib/event-schedule';
  import { resolveListingOccurrence, listingDateLabel } from '../../lib/whatson-listing.mjs';
  import { emptyDayMessage } from '../../lib/whatson-empty-state.mjs';
  import { hasLegacyExceptions } from '../../lib/intelligence-series.mjs';

  initV5Analytics();

  // "+ Trip" wiring (rows + pick cards). data-evt="trip_add" analytics fires
  // via the delegated v5-analytics listener; this adds the store behaviour.
  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-evt="trip_add"]:not([data-card-trip])');
    if (!btn || btn.dataset.added === 'true') return;
    const slug = btn.dataset.entitySlug;
    if (!slug) return;
    const title = btn.dataset.entityTitle || slug;
    const href = btn.dataset.entityHref || `/whats-on/${slug}/`;
    if (!tripAdd({ kind: 'event', slug, title, href })) {
      // The write did not land; say so rather than painting "In trip".
      const previous = btn.textContent;
      btn.textContent = 'Not added';
      setTimeout(() => { btn.textContent = previous; }, 2000);
      return;
    }
    btn.dataset.added = 'true';
    btn.textContent = 'In trip';
  });

  interface FeedEntry {
    slug: string;
    href: string;
    t: string;
    d: string;
    m: string[];
    c: string;
    p: string;
    f: boolean;
    fp?: {label:string;sourceUrl:string;checkedAt:string;validUntil:string};
    g: boolean;
    k: 'range' | 'weekly' | 'monthly' | 'explicit';
    dates?: string[];
    s: string;
    e: string;
    wd?: number;
    wds?: number[];
    nth?: number;
    months?: number[];
    x?: string;
    statusData?: Record<string, any>;
  }

  let scopeHistoryHandler: ((event: PopStateEvent) => void) | null = null;
  let disposeScope: (() => void) | null = null;
  window.addEventListener('popstate', (event) => scopeHistoryHandler?.(event), true);
  document.addEventListener('astro:before-swap', () => {
    disposeScope?.();
    disposeScope = null;
    scopeHistoryHandler = null;
  });

  function initEventScopes() {
  const daysEl = document.querySelector<HTMLElement>('[data-wo-days]');
  const scopeNav = document.querySelector<HTMLElement>('[data-wo-scope]');
  const headingEl = document.querySelector<HTMLElement>('[data-wo-heading]');
  const rangeEl = document.querySelector<HTMLElement>('[data-wo-range]');
  const statusEl = document.getElementById('pi-results-status');
  const monthBtn = document.querySelector<HTMLButtonElement>('[data-wo-month]');
  const custom = document.querySelector<HTMLDetailsElement>('[data-wo-custom]');
  const customForm = document.querySelector<HTMLFormElement>('[data-wo-custom-form]');
  const rowTpl = document.querySelector<HTMLTemplateElement>('[data-wo-row-template]');
  const filterForm = document.querySelector<HTMLFormElement>('[data-wo-filters]');
  const filterDisclosure = document.querySelector<HTMLDetailsElement>('[data-wo-filter-disclosure]');

  if (daysEl && scopeNav && rowTpl) {
    if (daysEl.dataset.scopeInitialized === 'true') return;
    daysEl.dataset.scopeInitialized = 'true';
    const scopePath = window.location.pathname;
    history.replaceState({ ...history.state, piWhatsOnScope: true }, '');
    const defaultHTML = daysEl.innerHTML;
    const defaultRange = rangeEl?.textContent ?? '';
    if (monthBtn) monthBtn.hidden = false;
    if (filterForm) filterForm.hidden = false;
    if (filterDisclosure) {
      filterDisclosure.hidden = false;
    }

    // Calendar dates use Melbourne's day and UTC date-only arithmetic in all surfaces.
    const parseISO = (s: string) => new Date(`${s}T00:00:00Z`);
    const fmt = (d: Date, opts: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-AU', { ...opts, timeZone: 'UTC' });
    const occursOn = (e: FeedEntry, d: Date) => occursOnDay({
      kind: e.k, start: parseISO(e.s), end: parseISO(e.e), day: e.wd,
      days: e.wds, nth: e.nth, months: e.months, dates: e.dates, reschedules: e.reschedules,
    }, d);

    // This editorial shortlist and its Event schema belong to the default
    // window. Detach both for other dates; restore both together on return.
    const picksEl = document.querySelector<HTMLElement>('.wo-picks');
    const eventSchema = document.querySelector<HTMLScriptElement>('[data-wo-event-schema]');
    const scopedNodes = [picksEl, eventSchema].filter((node): node is HTMLElement => !!node);
    const anchors = scopedNodes.map((node) => {
      const anchor = document.createComment('default weekend content');
      node.before(anchor);
      return { node, anchor };
    });
    const showDefaultContent = (show: boolean) => anchors.forEach(({ node, anchor }) => {
      if (show) anchor.after(node); else node.remove();
    });
    let requestVersion = 0;
    let readingUrl = false;
    let activeScope = 'weekend';
    let activeCustomRange: { from: string; to: string } | null = null;
    const filters = () => {
      const fields = filterForm ? new FormData(filterForm) : new FormData();
      return {
        q: String(fields.get('q') ?? '').trim().toLocaleLowerCase('en-AU'),
        town: String(fields.get('town') ?? ''),
        category: String(fields.get('category') ?? ''),
        free: fields.has('free'),
        kids: fields.has('kids'),
      };
    };
    const hasFilters = () => {
      const value = filters();
      return Boolean(value.q || value.town || value.category || value.free || value.kids);
    };
    const matchesFilters = (entry: FeedEntry, occurrence: ReturnType<typeof resolveListingOccurrence> | null) => {
      const value = filters();
      const effective = hasLegacyExceptions(entry.statusData) ? occurrence?.data : null;
      const town = effective ? effective.suburb ?? '' : entry.p;
      const meta = effective ? [effective.venueName, effective.startTime].filter(Boolean) : entry.m;
      if (value.town && town !== value.town) return false;
      if (value.category && entry.c !== value.category) return false;
      if (value.free && !feedHasCurrentFreeEntry(entry, new Date())) return false;
      if (value.kids && !entry.g) return false;
      return !value.q || [entry.t, entry.d, town, ...meta].join(' ').toLocaleLowerCase('en-AU').includes(value.q);
    };

    // ── feed island (fetched once, on first non-default scope) ─────────
    let freeExpiryTimer: ReturnType<typeof setTimeout> | null = null;
    function scheduleFreeExpiry(entries: FeedEntry[]) {
      if (freeExpiryTimer !== null) clearTimeout(freeExpiryTimer);
      const expiries = entries.map(entry => currentFreePrice({verifiedPrice:entry.fp}, new Date())?.expiresAt).filter(Boolean).map(value => Date.parse(value!));
      if (!expiries.length) {freeExpiryTimer = null; return;}
      const delay = Math.min(...expiries) - Date.now() + 1;
      freeExpiryTimer = setTimeout(() => {
        if (!daysEl?.isConnected) return;
        if (filters().free) applyScope(activeScope, activeCustomRange?.from, activeCustomRange?.to);
        scheduleFreeExpiry(entries);
      }, Math.max(1, Math.min(delay, 2147483647)));
    }
    let feedPromise: Promise<FeedEntry[]> | null = null;
    const loadFeed = () => {
      feedPromise ??= fetch('/whats-on/feed.json')
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then((j) => {const entries = j.events as FeedEntry[]; scheduleFreeExpiry(entries); return entries;})
        .catch((error) => { feedPromise = null; throw error; });
      return feedPromise;
    };

    const buildRow = (e: FeedEntry, spanLabel: string, day: Date): HTMLElement => {
      const frag = rowTpl.content.cloneNode(true) as DocumentFragment;
      const row = frag.querySelector<HTMLElement>('.wo-row')!;
      const occurrence = e.statusData ? resolveListingOccurrence(e.statusData,
        { kind: e.k, start: parseISO(e.s), end: parseISO(e.e) }, isoDate(day)) : null;
      if (occurrence) {
        row.dataset.occurrencePhase = occurrence.phase;
        row.dataset.occurrenceBookable = String(occurrence.bookable);
      }
      const link = row.querySelector<HTMLAnchorElement>('.wo-row__link')!;
      link.href = e.href;
      link.textContent = e.t;
      link.dataset.entitySlug = e.slug;
      row.querySelector<HTMLElement>('.wo-row__dek')!.textContent = e.d;
      row.querySelector<HTMLElement>('.wo-row__meta')!.textContent = [
        (occurrence?.data ? [occurrence.data.venueName, occurrence.data.startTime].filter(Boolean) : e.m).join(' · '),
        spanLabel,
        occurrence ? (occurrence.label ?? '') : (e.x ?? ''),
      ]
        .filter(Boolean)
        .join(' · ');
      const save = row.querySelector<HTMLElement>('[data-v5-save-control]');
      if (save) {
        save.dataset.slug = e.slug;
        save.dataset.title = e.t;
        save.dataset.href = e.href;
        save.dataset.dek = e.d;
        const saveBtn = save.querySelector<HTMLElement>('[data-v5-save-btn]');
        saveBtn?.setAttribute('aria-label', `Save ${e.t}`);
      }
      const trip = row.querySelector<HTMLElement>('.wo-row__trip');
      if (trip) {
        trip.dataset.entitySlug = e.slug;
        trip.dataset.entityTitle = e.t;
        trip.dataset.entityHref = e.href;
        trip.setAttribute('aria-label', `Add ${e.t} to trip`);
      }
      return row;
    };

    const renderWindow = (entries: FeedEntry[], start: Date, end: Date): number => {
      const dayCount = Math.min(
        62,
        Math.round((startOfDay(end).getTime() - startOfDay(start).getTime()) / 86400000) + 1
      );
      const showEmptyDays = dayCount <= 4 && !hasFilters();
      const seenRanges = new Set<string>();
      daysEl.textContent = '';
      let shown = 0;
      for (let i = 0; i < dayCount; i += 1) {
        const day = addDays(start, i);
        if (day < startOfDay(new Date())) continue;
        const matches: { e: FeedEntry; span: string }[] = [];
        let continuingCount = 0;
        for (const e of entries) {
          if (!occursOn(e, day)) continue;
          const occurrence = e.statusData ? resolveListingOccurrence(e.statusData,
            { kind: e.k, start: parseISO(e.s), end: parseISO(e.e) }, isoDate(day)) : null;
          if (occurrence?.phase === 'past') continue;
          if (!matchesFilters(e, occurrence)) continue;
          if (e.k === 'range') {
            if (seenRanges.has(e.slug)) {
              continuingCount += 1;
              continue;
            }
            seenRanges.add(e.slug);
            const span = listingDateLabel({ kind: e.k, start: parseISO(e.s), end: parseISO(e.e) }, { start, end });
            matches.push({ e, span });
          } else {
            matches.push({ e, span: listingDateLabel({ kind: e.k, start: parseISO(e.s), end: parseISO(e.e) }, { start, end }) });
          }
        }
        if (matches.length === 0 && !showEmptyDays) continue;
        const section = document.createElement('section');
        section.className = 'wo-day';
        const h = document.createElement('h3');
        h.className = 'wo-day__h';
        h.textContent = fmt(day, { weekday: 'long', day: 'numeric', month: 'long' });
        section.appendChild(h);
        if (matches.length > 0) {
          const ul = document.createElement('ul');
          ul.className = 'wo-day__list';
          ul.setAttribute('role', 'list');
          for (const m of matches) {
            ul.appendChild(buildRow(m.e, m.span, day));
            shown += 1;
          }
          section.appendChild(ul);
        } else {
          const p = document.createElement('p');
          p.className = 'wo-day__empty';
          p.textContent = emptyDayMessage(continuingCount);
          section.appendChild(p);
        }
        daysEl.appendChild(section);
      }
      if (shown === 0) {
        const p = document.createElement('p');
        p.className = 'wo-day__empty';
        p.textContent = hasFilters()
          ? 'No matching events for these dates. Clear a filter or choose another date.'
          : 'Nothing in the registry for those dates yet. Try the month ahead.';
        daysEl.appendChild(p);
      }
      // Re-run SaveControl hydration for the cloned rows (its init listens
      // for astro:page-load; hydrate() is idempotent).
      document.dispatchEvent(new Event('astro:page-load'));
      return shown;
    };

    // ── scope application + URL sync ────────────────────────────────────
    const setPressed = (scope: string) => {
      scopeNav.querySelectorAll<HTMLButtonElement>('[data-wo-scope-btn]').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.scope === scope ? 'true' : 'false');
      });
      if (custom) custom.dataset.active = scope === 'custom' ? 'true' : 'false';
    };

    const announce = (n: number, label: string) => {
      if (statusEl) {
        statusEl.textContent = n === 1 ? `Showing 1 event for ${label}` : `Showing ${n} events for ${label}`;
      }
    };

    const syncUrl = (param: string | null) => {
      const url = new URL(window.location.href);
      if (param) url.searchParams.set('date', param);
      else url.searchParams.delete('date');
      const value = filters();
      for (const key of ['q', 'town', 'category', 'free', 'kids']) url.searchParams.delete(key);
      if (value.q) url.searchParams.set('q', value.q);
      if (value.town) url.searchParams.set('town', value.town);
      if (value.category) url.searchParams.set('category', value.category);
      if (value.free) url.searchParams.set('free', '1');
      if (value.kids) url.searchParams.set('kids', '1');
      if (!readingUrl && url.href !== window.location.href) history.pushState({ ...history.state, piWhatsOnScope: true }, '', url.pathname + url.search + url.hash);
    };

    const setHeading = (headline: string, label: string) => {
      if (headingEl) headingEl.textContent = headline;
      if (rangeEl) rangeEl.textContent = label;
    };

    const applyDefault = () => {
      if (hasFilters()) {
        const win = weekendWindow(new Date());
        applyWindow('weekend', win.start, win.end, "What's on this weekend", null, 'this weekend');
        return;
      }
      requestVersion += 1;
      showDefaultContent(true);
      daysEl.innerHTML = defaultHTML;
      setPressed('weekend');
      setHeading("What's on this weekend", defaultRange);
      syncUrl(null);
      announce(Number(daysEl.dataset.woDefaultCount ?? 0), 'this weekend');
      document.dispatchEvent(new Event('astro:page-load'));
    };

    const applyWindow = async (
      scope: string,
      start: Date,
      end: Date,
      headline: string,
      param: string | null,
      announceLabel: string
    ) => {
      const version = ++requestVersion;
      showDefaultContent(false);
      daysEl.textContent = 'Loading events for these dates…';
      setPressed(scope);
      const label = rangeLabel(start, end);
      setHeading(headline, label);
      syncUrl(param);
      try {
        const entries = await loadFeed();
        if (version !== requestVersion) return;
        const shown = renderWindow(entries, start, end);
        announce(shown, announceLabel);
      } catch {
        if (version !== requestVersion) return;
        filterForm?.reset();
        activeScope = 'weekend';
        activeCustomRange = null;
        applyDefault();
        if (statusEl) statusEl.textContent = 'Could not load those dates. Showing this weekend instead.';
        document.dispatchEvent(new Event('astro:page-load'));
      }
    };

    const applyScope = (scope: string, from?: string, to?: string) => {
      activeScope = scope;
      if (scope !== 'custom') activeCustomRange = null;
      if (scope === 'weekend') {
        applyDefault();
        return;
      }
      if (scope === 'today' || scope === 'tomorrow') {
        const day = addDays(startOfDay(new Date()), scope === 'tomorrow' ? 1 : 0);
        applyWindow(scope, day, day, scope === 'today' ? "What's on today" : "What's on tomorrow", scope, scope);
        return;
      }
      if (scope === 'next-weekend') {
        const w = weekendWindow(new Date(), 1);
        applyWindow(scope, w.start, w.end, "What's on next weekend", 'next-weekend', 'next weekend');
        return;
      }
      if (scope === 'school-holidays' && scopeNav.dataset.holidayStart) {
        const hs = parseISO(scopeNav.dataset.holidayStart);
        const today = startOfDay(new Date());
        const start = hs > today ? hs : today;
        const end = parseISO(scopeNav.dataset.holidayEnd || scopeNav.dataset.holidayStart);
        applyWindow(scope, start, end, "What's on these school holidays", 'school-holidays', 'the school holidays');
        return;
      }
      if (scope === 'month') {
        const today = startOfDay(new Date());
        applyWindow(scope, today, addDays(today, 31), "What's on this month", 'this-month', 'the month ahead');
        return;
      }
      if (scope === 'custom' && from && to) {
        activeCustomRange = { from, to };
        let a = parseISO(from);
        let b = parseISO(to);
        if (!Number.isFinite(a.getTime()) || !Number.isFinite(b.getTime()) || isoDate(a) !== from || isoDate(b) !== to) { applyDefault(); return; }
        if (b < a) [a, b] = [b, a];
        if ((b.getTime() - a.getTime()) / 86400000 > 61) b = addDays(a, 61);
        applyWindow(scope, a, b, "What's on for your dates", `${isoDate(a)}..${isoDate(b)}`, 'your dates');
      }
    };

    scopeNav.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-wo-scope-btn]');
      if (!btn) return;
      if (custom) custom.open = false;
      applyScope(btn.dataset.scope ?? 'weekend');
    });

    customForm?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const fd = new FormData(customForm);
      const from = String(fd.get('from') ?? '');
      const to = String(fd.get('to') ?? '');
      if (!from || !to) return;
      if (custom) {
        custom.open = false;
        custom.querySelector<HTMLElement>('summary')?.focus();
      }
      applyScope('custom', from, to);
    });

    monthBtn?.addEventListener('click', () => applyScope('month'));

    let searchTimer: ReturnType<typeof setTimeout> | null = null;
    filterForm?.addEventListener('input', (event) => {
      if ((event.target as HTMLElement).getAttribute('name') !== 'q') return;
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => applyScope(activeScope, activeCustomRange?.from, activeCustomRange?.to), 180);
    });
    filterForm?.addEventListener('change', (event) => {
      if ((event.target as HTMLElement).getAttribute('name') === 'q') return;
      applyScope(activeScope, activeCustomRange?.from, activeCustomRange?.to);
    });
    filterForm?.addEventListener('submit', (event) => event.preventDefault());
    filterForm?.querySelector('[data-wo-filter-reset]')?.addEventListener('click', () => {
      filterForm.reset();
      applyScope(activeScope, activeCustomRange?.from, activeCustomRange?.to);
    });

    // Deep links + back/forward.
    const applyFromUrl = () => {
      readingUrl = true;
      try {
      const query = new URLSearchParams(window.location.search);
      if (filterForm) {
        for (const name of ['q', 'town', 'category']) {
          const control = filterForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
          if (control) control.value = query.get(name) ?? '';
        }
        for (const name of ['free', 'kids']) {
          const control = filterForm.elements.namedItem(name) as HTMLInputElement | null;
          if (control) control.checked = query.get(name) === '1';
        }
        if (filterDisclosure && hasFilters()) filterDisclosure.open = true;
      }
      const v = query.get('date');
      if (!v) {
        applyDefault();
        return;
      }
      if (v === 'today' || v === 'tomorrow' || v === 'next-weekend' || v === 'school-holidays') applyScope(v);
      else if (v === 'this-month') applyScope('month');
      else if (/^\d{4}-\d{2}-\d{2}\.\.\d{4}-\d{2}-\d{2}$/.test(v)) {
        const [from, to] = v.split('..');
        applyScope('custom', from, to);
      } else applyDefault();
      } finally { readingUrl = false; }
    };
    const onScopeHistory = (event: PopStateEvent) => {
      if (!daysEl.isConnected || window.location.pathname !== scopePath || !event.state?.piWhatsOnScope) return;
      // Filter history is local to this document, not an Astro page transition.
      event.stopImmediatePropagation();
      applyFromUrl();
    };
    scopeHistoryHandler = onScopeHistory;
    disposeScope = () => { requestVersion += 1; if (freeExpiryTimer !== null) clearTimeout(freeExpiryTimer); if (searchTimer !== null) clearTimeout(searchTimer); };
    if ([...new URLSearchParams(window.location.search).keys()].some((key) => ['date', 'q', 'town', 'category', 'free', 'kids'].includes(key))) applyFromUrl();
  }
  }
  document.addEventListener('astro:page-load', initEventScopes);
  initEventScopes();
  // Browser focus can accept a sliver of a card as visible. Align the entire
  // card when one of its links or actions receives focus inside the rail.
  function initPickRailFocus() {
    const rail = document.querySelector<HTMLElement>('.wo-picks .v5-card-grid');
    if (!rail || rail.dataset.focusScrollBound) return;
    rail.dataset.focusScrollBound = 'true';
    rail.addEventListener('focusin', (event) => {
      if (rail.scrollWidth <= rail.clientWidth) return;
      const card = (event.target as HTMLElement).closest<HTMLElement>('.pi-card');
      if (!card) return;
      const left = rail.scrollLeft + card.getBoundingClientRect().left - rail.getBoundingClientRect().left;
      rail.scrollTo({ left, behavior: 'instant' });
    });
  }
  document.addEventListener('astro:page-load', initPickRailFocus);
  initPickRailFocus();
</script>

