---
/**
 * /whats-on/ - the canonical When front door (v5 rebuild, T-601).
 *
 * Structure per page-redesigns-hubs.md section 7 + wireframes #whatson:
 *   1. h1 date context + selection rule (one line)
 *   2. Scope controls: This weekend (default, in-DOM) / Next weekend /
 *      Pick dates / School holidays
 *   3. PI's picks: exactly 3, Local voice verdicts
 *   4. Day-grouped compact rows for the current scope (weekend is fully
 *      server-rendered; other scopes render client-side from feed.json)
 *   5. Shelf anchor links + category shelves (Markets, Live music,
 *      Food & wine, Openings, Major events)
 *   6. Month+ on demand via the JSON island at /whats-on/feed.json
 *      (HUB-11 closed: zero hidden pre-rendered cards)
 *
 * Event JSON-LD kept; NO price offers are emitted (house rule).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import WhatsOnScopeBar from '../../components/v5/whatson/WhatsOnScopeBar.astro';
import WhatsOnRow from '../../components/v5/whatson/WhatsOnRow.astro';
import TrustNote from '../../components/v5/hub/TrustNote.astro';
import {
  loadLiveEvents,
  weekendWindow,
  schoolHolidayWindow,
  groupByDay,
  getPicks,
  getShelves,
  isoDate,
  startOfDay,
  type OccurrenceState,
} from './_data';
import { getAustralianSeasonLower } from '../../lib/season';

export const prerender = true;

const now = new Date();
const events = await loadLiveEvents(now);

const weekend = weekendWindow(now);
const nextWeekend = weekendWindow(now, 1);
const holidays = schoolHolidayWindow(now);

const picks = await getPicks(events, weekend, now);
const pickSlugs = new Set(picks.map((p) => p.live.slug));

const dayGroups = groupByDay(events, weekend, now);
const weekendCount = dayGroups.reduce((n, g) => n + g.items.length, 0);

const shelves = getShelves(events, now, pickSlugs).filter((s) => s.items.length > 0);

// ── JSON-LD: Event nodes for everything server-rendered (picks + weekend
// rows), deduped. Deliberately no offers: pricing never ships in schema
// or copy (house rule; priceBand chips only elsewhere).
const SITE_ORIGIN = 'https://peninsulainsider.com.au';
const truncate = (text: unknown, n = 200): string => {
  const s = String(text ?? '').replace(/\s+/g, ' ').trim();
  return s.length <= n ? s : `${s.slice(0, n - 1).trimEnd()}…`;
};
const ldSeen = new Set<string>();
const ldEvents: Record<string, any>[] = [];
// PI-008: the ItemList used to stamp EventScheduled on every node, so a
// sold-out night and a cancelled market both told search engines they were
// going ahead as normal. Status now comes from the same resolver the page
// renders from, and a finished occurrence emits no status at all (an
// EventScheduled with a past endDate is what lint-seo-architecture.mjs fails
// the build over).
//
// That was half done. The helper that lived here re-derived the status from
// the raw `cancelled` flag: one of the four signals that record a cancellation,
// and none of the occurrence-level exceptions at all. A weekly market cancelled
// for a single Thursday would have rendered "Cancelled this time" with
// EventScheduled in the markup beside it. The state _data.ts resolved is now
// the only answer on this page.
const pushLd = (
  live: (typeof events)[number],
  occursISO: string,
  state: OccurrenceState
) => {
  if (ldSeen.has(live.slug)) return;
  ldSeen.add(live.slug);
  const data = live.event.data as Record<string, any>;
  const heroSrc = data.heroImage?.src;
  const imageUrl = heroSrc
    ? heroSrc.startsWith('http')
      ? heroSrc
      : `${SITE_ORIGIN}${heroSrc}`
    : undefined;
  ldEvents.push({
    '@type': 'Event',
    name: data.title,
    startDate: occursISO,
    url: `${SITE_ORIGIN}${live.href}`,
    ...(imageUrl ? { image: imageUrl } : {}),
    description: truncate(data.summary),
    ...(state.schemaStatus ? { eventStatus: state.schemaStatus } : {}),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: data.venueName || data.suburb || 'Mornington Peninsula',
      address: {
        '@type': 'PostalAddress',
        ...(data.streetAddress ? { streetAddress: data.streetAddress } : {}),
        addressLocality: data.suburb || data.venueRegion || 'Mornington Peninsula',
        addressRegion: 'VIC',
        addressCountry: 'AU',
      },
    },
  });
};
for (const p of picks) pushLd(p.live, p.dateISO, p.occurrence);
for (const g of dayGroups) {
  for (const it of g.items) {
    pushLd(it.live, g.iso, it);
  }
}
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "What's On Mornington Peninsula",
  url: `${SITE_ORIGIN}/whats-on/`,
  numberOfItems: ldEvents.length,
  itemListElement: ldEvents.map((ev, i) => ({ '@type': 'ListItem', position: i + 1, item: ev })),
};

// Pick cards, precomputed here: the Astro compiler cannot parse TS generics
// inside template expressions, and the template stays declarative this way.
const pickCards = picks.map((p, i) => {
  const data = p.live.event.data as Record<string, any>;
  return {
    title: p.live.title,
    href: p.live.href,
    slug: p.live.slug,
    image: data.heroImage
      ? { src: data.heroImage.src as string, alt: (data.heroImage.alt ?? p.live.title) as string }
      : undefined,
    verdict: p.verdict,
    meta: [p.dayLabel, p.live.placeLabel, p.live.accessLabel ?? p.live.categoryLabel]
      .filter(Boolean)
      .slice(0, 3),
    dateISO: p.dateISO,
    position: i + 1,
  };
});

const season = getAustralianSeasonLower(now);
const todayISO = isoDate(startOfDay(now));
const modifiedTime = todayISO;
const pageDescription = `Browse Mornington Peninsula events by date: markets, live music, exhibitions and festivals. Choose this weekend, school holidays or your own dates.`;
---

<BaseLayout
  title="What's On Mornington Peninsula | Events Calendar"
  description={pageDescription}
  section="whats-on"
  canonical="https://peninsulainsider.com.au/whats-on"
  modifiedTime={modifiedTime}
  ogImage="/images/sourced/whats-on-winter-wine.webp"
>
  <script data-wo-event-schema type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <header class="wo-head">
    <div class="wo-head__bg" style="background-image:url(/images/sourced/whats-on-winter-wine.webp)" aria-hidden="true"></div>
    <div class="wo-head__scrim" aria-hidden="true"></div>
    <div class="container wo-head__inner">
      <p class="wo-head__eyebrow"><span class="wo-head__live" aria-hidden="true"></span>What's On · live now</p>
      <h1 class="wo-head__title" data-wo-heading>What's on this weekend</h1>
      <p class="wo-head__context">
        <span data-wo-range>{weekend.label}</span> · {season} on the Peninsula
      </p>
      <p class="wo-head__rule">Browse events by date, then check the organiser before you go.</p>
      <p class="wo-head__rule">For a slower Western Port detour between listings, start with <a href="/explore/places/hastings/">Hastings</a> and its working harbour.</p>
    </div>
  </header>

  <div class="container wo-scope-wrap">
    <WhatsOnScopeBar
      weekendStartISO={isoDate(weekend.start)}
      weekendLabel={weekend.label}
      nextWeekendLabel={nextWeekend.label}
      holidays={holidays
        ? {
            startISO: isoDate(holidays.start),
            endISO: isoDate(holidays.end),
            label: holidays.label,
            name: holidays.name,
          }
        : null}
      todayISO={todayISO}
    />
    <TrustNote surface="whatson" />
  </div>

  {picks.length > 0 && (
    <section class="wo-picks" aria-labelledby="wo-picks-h">
      <div class="container">
        <div class="wo-picks__head">
          <h2 class="wo-picks__title" id="wo-picks-h">PI's picks</h2>
          <p class="wo-picks__dek">Selected events for this weekend. Check the organiser for the latest details.</p>
        </div>
        {/* Every card here is an event on the What's On page, under a heading
            that says so: the per-card EVENT stamp is dropped. */}
        <CardGrid label="PI's picks for this weekend">
          {pickCards.map((c) => (
            <Card
              variant="event"
              title={c.title}
              href={c.href}
              entityType="event"
              entitySlug={c.slug}
              image={c.image}
              verdict={c.verdict}
              meta={c.meta}
              dateISO={c.dateISO}
              showEyebrow={false}
              mediaFallback={true}
              trip={true}
              surface="whatson"
              position={c.position}
            />
          ))}
        </CardGrid>
      </div>
    </section>
  )}

  <section class="wo-days" aria-label="Everything on for the selected dates">
    <div class="container">
      <div class="wo-days__head">
        <h2 class="wo-days__title">Everything on, by day</h2>
        <p id="pi-results-status" class="wo-vh" role="status" aria-live="polite"></p>
      </div>
      <div data-wo-days data-wo-default-count={weekendCount}>
        {dayGroups.map((g) => (
          <section class="wo-day">
            <h3 class="wo-day__h">{g.heading}</h3>
            {g.items.length > 0 ? (
              <ul class="wo-day__list" role="list">
                {g.items.map((it) => (
                  <WhatsOnRow
                    title={it.live.title}
                    href={it.live.href}
                    slug={it.live.slug}
                    oneLiner={it.live.oneLiner}
                    meta={it.live.meta}
                    spanLabel={it.spanLabel}
                    statusLabel={it.statusLabel}
                    phase={it.phase}
                    bookable={it.bookable}
                  />
                ))}
              </ul>
            ) : (
              <p class="wo-day__empty">{g.emptyMessage}</p>
            )}
          </section>
        ))}
      </div>
      <p class="wo-more">
        <button type="button" class="pi-btn pi-btn--ghost" data-wo-month data-evt="wo_date_change" hidden>
          Load the month ahead
        </button>
        <noscript>
          <span class="wo-more__noscript">
            Longer horizons load with JavaScript on; the weekend above is the complete current edit.
          </span>
        </noscript>
      </p>
    </div>
  </section>

  {shelves.length > 0 && (
    <section class="wo-shelves" aria-labelledby="wo-shelves-h">
      <div class="container">
        <h2 class="wo-shelves__title" id="wo-shelves-h">Browse the next two months</h2>
        <nav class="wo-shelfnav" aria-label="Jump to a category">
          {shelves.map((s) => (
            <a class="wo-shelfnav__link" href={`#${s.id}`}>{s.label}</a>
          ))}
        </nav>
        {shelves.map((s) => (
          <section class="wo-shelf" id={s.id} aria-labelledby={`${s.id}-h`}>
            <h3 class="wo-shelf__h" id={`${s.id}-h`}>{s.label}</h3>
            <ul class="wo-shelf__list" role="list">
              {s.items.map((live) => (
                <WhatsOnRow
                  title={live.title}
                  href={live.href}
                  slug={live.slug}
                  oneLiner={live.oneLiner}
                  meta={live.meta}
                />
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  )}

  <NewsletterBlock />

  {/* Row template for client-side scope rendering: cloned by the script
      below, never displayed. Template content is inert (not hidden DOM
      weight in the HUB-11 sense: one empty row, no event content). */}
  <template data-wo-row-template>
    <WhatsOnRow title="" href="" slug="" />
  </template>
</BaseLayout>

<script>
  // ── /whats-on/ scope engine ──────────────────────────────────────────
  // Default (this weekend) is fully server-rendered. Every other scope
  // fetches /whats-on/feed.json once and renders compact rows from it:
  // the month+ horizon is a JSON island, never hidden DOM (HUB-11).
  import { initV5Analytics } from '../../lib/v5-analytics';
  import { tripAdd } from '../../lib/v5-store';
  import { startOfDay, addDays, rangeLabel, weekendWindow, occursOnDay, isoDate } from '../../lib/event-schedule';
  import { resolveOccurrence } from '../../lib/event-occurrence.mjs';
  import { emptyDayMessage } from '../../lib/whatson-empty-state.mjs';

  initV5Analytics();

  // "+ Trip" wiring (rows + pick cards). data-evt="trip_add" analytics fires
  // via the delegated v5-analytics listener; this adds the store behaviour.
  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-evt="trip_add"]:not([data-card-trip])');
    if (!btn || btn.dataset.added === 'true') return;
    const slug = btn.dataset.entitySlug;
    if (!slug) return;
    const title = btn.dataset.entityTitle || slug;
    const href = btn.dataset.entityHref || `/whats-on/${slug}/`;
    if (!tripAdd({ kind: 'event', slug, title, href })) {
      // The write did not land; say so rather than painting "In trip".
      const previous = btn.textContent;
      btn.textContent = 'Not added';
      setTimeout(() => { btn.textContent = previous; }, 2000);
      return;
    }
    btn.dataset.added = 'true';
    btn.textContent = 'In trip';
  });

  interface FeedEntry {
    slug: string;
    href: string;
    t: string;
    d: string;
    m: string[];
    k: 'range' | 'weekly' | 'monthly';
    s: string;
    e: string;
    wd?: number;
    wds?: number[];
    nth?: number;
    months?: number[];
    x?: string;
    statusData?: Record<string, any>;
  }

  let scopeHistoryHandler: ((event: PopStateEvent) => void) | null = null;
  let disposeScope: (() => void) | null = null;
  window.addEventListener('popstate', (event) => scopeHistoryHandler?.(event), true);
  document.addEventListener('astro:before-swap', () => {
    disposeScope?.();
    disposeScope = null;
    scopeHistoryHandler = null;
  });

  function initEventScopes() {
  const daysEl = document.querySelector<HTMLElement>('[data-wo-days]');
  const scopeNav = document.querySelector<HTMLElement>('[data-wo-scope]');
  const headingEl = document.querySelector<HTMLElement>('[data-wo-heading]');
  const rangeEl = document.querySelector<HTMLElement>('[data-wo-range]');
  const statusEl = document.getElementById('pi-results-status');
  const monthBtn = document.querySelector<HTMLButtonElement>('[data-wo-month]');
  const custom = document.querySelector<HTMLDetailsElement>('[data-wo-custom]');
  const customForm = document.querySelector<HTMLFormElement>('[data-wo-custom-form]');
  const rowTpl = document.querySelector<HTMLTemplateElement>('[data-wo-row-template]');

  if (daysEl && scopeNav && rowTpl) {
    if (daysEl.dataset.scopeInitialized === 'true') return;
    daysEl.dataset.scopeInitialized = 'true';
    const scopePath = window.location.pathname;
    history.replaceState({ ...history.state, piWhatsOnScope: true }, '');
    const defaultHTML = daysEl.innerHTML;
    const defaultRange = rangeEl?.textContent ?? '';
    if (monthBtn) monthBtn.hidden = false;

    // Calendar dates use Melbourne's day and UTC date-only arithmetic in all surfaces.
    const parseISO = (s: string) => new Date(`${s}T00:00:00Z`);
    const fmt = (d: Date, opts: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-AU', { ...opts, timeZone: 'UTC' });
    const occursOn = (e: FeedEntry, d: Date) => occursOnDay({
      kind: e.k, start: parseISO(e.s), end: parseISO(e.e), day: e.wd,
      days: e.wds, nth: e.nth, months: e.months,
    }, d);

    // This editorial shortlist and its Event schema belong to the default
    // window. Detach both for other dates; restore both together on return.
    const picksEl = document.querySelector<HTMLElement>('.wo-picks');
    const eventSchema = document.querySelector<HTMLScriptElement>('[data-wo-event-schema]');
    const scopedNodes = [picksEl, eventSchema].filter((node): node is HTMLElement => !!node);
    const anchors = scopedNodes.map((node) => {
      const anchor = document.createComment('default weekend content');
      node.before(anchor);
      return { node, anchor };
    });
    const showDefaultContent = (show: boolean) => anchors.forEach(({ node, anchor }) => {
      if (show) anchor.after(node); else node.remove();
    });
    let requestVersion = 0;
    let readingUrl = false;

    // ── feed island (fetched once, on first non-default scope) ─────────
    let feedPromise: Promise<FeedEntry[]> | null = null;
    const loadFeed = () => {
      feedPromise ??= fetch('/whats-on/feed.json')
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then((j) => j.events as FeedEntry[])
        .catch((error) => { feedPromise = null; throw error; });
      return feedPromise;
    };

    const buildRow = (e: FeedEntry, spanLabel: string, day: Date, scopeEnd: Date): HTMLElement => {
      const frag = rowTpl.content.cloneNode(true) as DocumentFragment;
      const row = frag.querySelector<HTMLElement>('.wo-row')!;
      const link = row.querySelector<HTMLAnchorElement>('.wo-row__link')!;
      link.href = e.href;
      link.textContent = e.t;
      link.dataset.entitySlug = e.slug;
      row.querySelector<HTMLElement>('.wo-row__dek')!.textContent = e.d;
      row.querySelector<HTMLElement>('.wo-row__meta')!.textContent = [
        e.m.join(' · '),
        spanLabel,
        e.statusData ? (resolveOccurrence(e.statusData, isoDate(day), new Date(), e.k === 'range' ? { endDayIso: isoDate(parseISO(e.e) < scopeEnd ? parseISO(e.e) : scopeEnd) } : {}).label ?? '') : (e.x ?? ''),
      ]
        .filter(Boolean)
        .join(' · ');
      const save = row.querySelector<HTMLElement>('[data-v5-save-control]');
      if (save) {
        save.dataset.slug = e.slug;
        save.dataset.title = e.t;
        save.dataset.href = e.href;
        save.dataset.dek = e.d;
        const saveBtn = save.querySelector<HTMLElement>('[data-v5-save-btn]');
        saveBtn?.setAttribute('aria-label', `Save ${e.t}`);
      }
      const trip = row.querySelector<HTMLElement>('.wo-row__trip');
      if (trip) {
        trip.dataset.entitySlug = e.slug;
        trip.dataset.entityTitle = e.t;
        trip.dataset.entityHref = e.href;
        trip.setAttribute('aria-label', `Add ${e.t} to trip`);
      }
      return row;
    };

    const renderWindow = (entries: FeedEntry[], start: Date, end: Date): number => {
      const dayCount = Math.min(
        62,
        Math.round((startOfDay(end).getTime() - startOfDay(start).getTime()) / 86400000) + 1
      );
      const showEmptyDays = dayCount <= 4;
      const seenRanges = new Set<string>();
      daysEl.textContent = '';
      let shown = 0;
      for (let i = 0; i < dayCount; i += 1) {
        const day = addDays(start, i);
        const matches: { e: FeedEntry; span: string }[] = [];
        let continuingCount = 0;
        for (const e of entries) {
          if (!occursOn(e, day)) continue;
          if (e.k === 'range') {
            if (seenRanges.has(e.slug)) {
              continuingCount += 1;
              continue;
            }
            seenRanges.add(e.slug);
            const ruleEnd = parseISO(e.e);
            const runsTo = ruleEnd < end ? ruleEnd : end;
            const span =
              runsTo.getTime() > day.getTime()
                ? `runs to ${fmt(runsTo, { weekday: 'short', day: 'numeric', month: 'short' })}`
                : '';
            matches.push({ e, span });
          } else {
            matches.push({ e, span: '' });
          }
        }
        if (matches.length === 0 && !showEmptyDays) continue;
        const section = document.createElement('section');
        section.className = 'wo-day';
        const h = document.createElement('h3');
        h.className = 'wo-day__h';
        h.textContent = fmt(day, { weekday: 'long', day: 'numeric', month: 'long' });
        section.appendChild(h);
        if (matches.length > 0) {
          const ul = document.createElement('ul');
          ul.className = 'wo-day__list';
          ul.setAttribute('role', 'list');
          for (const m of matches) {
            ul.appendChild(buildRow(m.e, m.span, day, end));
            shown += 1;
          }
          section.appendChild(ul);
        } else {
          const p = document.createElement('p');
          p.className = 'wo-day__empty';
          p.textContent = emptyDayMessage(continuingCount);
          section.appendChild(p);
        }
        daysEl.appendChild(section);
      }
      if (shown === 0) {
        const p = document.createElement('p');
        p.className = 'wo-day__empty';
        p.textContent = 'Nothing in the registry for those dates yet. Try the month ahead.';
        daysEl.appendChild(p);
      }
      // Re-run SaveControl hydration for the cloned rows (its init listens
      // for astro:page-load; hydrate() is idempotent).
      document.dispatchEvent(new Event('astro:page-load'));
      return shown;
    };

    // ── scope application + URL sync ────────────────────────────────────
    const setPressed = (scope: string) => {
      scopeNav.querySelectorAll<HTMLButtonElement>('[data-wo-scope-btn]').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.scope === scope ? 'true' : 'false');
      });
      if (custom) custom.dataset.active = scope === 'custom' ? 'true' : 'false';
    };

    const announce = (n: number, label: string) => {
      if (statusEl) {
        statusEl.textContent = n === 1 ? `Showing 1 event for ${label}` : `Showing ${n} events for ${label}`;
      }
    };

    const syncUrl = (param: string | null) => {
      const url = new URL(window.location.href);
      if (param) url.searchParams.set('date', param);
      else url.searchParams.delete('date');
      if (!readingUrl && url.href !== window.location.href) history.pushState({ ...history.state, piWhatsOnScope: true }, '', url.pathname + url.search + url.hash);
    };

    const setHeading = (headline: string, label: string) => {
      if (headingEl) headingEl.textContent = headline;
      if (rangeEl) rangeEl.textContent = label;
    };

    const applyDefault = () => {
      requestVersion += 1;
      showDefaultContent(true);
      daysEl.innerHTML = defaultHTML;
      setPressed('weekend');
      setHeading("What's on this weekend", defaultRange);
      syncUrl(null);
      announce(Number(daysEl.dataset.woDefaultCount ?? 0), 'this weekend');
      document.dispatchEvent(new Event('astro:page-load'));
    };

    const applyWindow = async (
      scope: string,
      start: Date,
      end: Date,
      headline: string,
      param: string,
      announceLabel: string
    ) => {
      const version = ++requestVersion;
      showDefaultContent(false);
      daysEl.textContent = 'Loading events for these dates…';
      setPressed(scope);
      const label = rangeLabel(start, end);
      setHeading(headline, label);
      syncUrl(param);
      try {
        const entries = await loadFeed();
        if (version !== requestVersion) return;
        const shown = renderWindow(entries, start, end);
        announce(shown, announceLabel);
      } catch {
        if (version !== requestVersion) return;
        applyDefault();
        if (statusEl) statusEl.textContent = 'Could not load those dates. Showing this weekend instead.';
        document.dispatchEvent(new Event('astro:page-load'));
      }
    };

    const applyScope = (scope: string, from?: string, to?: string) => {
      if (scope === 'weekend') {
        applyDefault();
        return;
      }
      if (scope === 'next-weekend') {
        const w = weekendWindow(new Date(), 1);
        applyWindow(scope, w.start, w.end, "What's on next weekend", 'next-weekend', 'next weekend');
        return;
      }
      if (scope === 'school-holidays' && scopeNav.dataset.holidayStart) {
        const hs = parseISO(scopeNav.dataset.holidayStart);
        const today = startOfDay(new Date());
        const start = hs > today ? hs : today;
        const end = parseISO(scopeNav.dataset.holidayEnd || scopeNav.dataset.holidayStart);
        applyWindow(scope, start, end, "What's on these school holidays", 'school-holidays', 'the school holidays');
        return;
      }
      if (scope === 'month') {
        const today = startOfDay(new Date());
        applyWindow(scope, today, addDays(today, 31), "What's on this month", 'this-month', 'the month ahead');
        return;
      }
      if (scope === 'custom' && from && to) {
        let a = parseISO(from);
        let b = parseISO(to);
        if (!Number.isFinite(a.getTime()) || !Number.isFinite(b.getTime()) || isoDate(a) !== from || isoDate(b) !== to) { applyDefault(); return; }
        if (b < a) [a, b] = [b, a];
        if ((b.getTime() - a.getTime()) / 86400000 > 61) b = addDays(a, 61);
        applyWindow(scope, a, b, "What's on for your dates", `${isoDate(a)}..${isoDate(b)}`, 'your dates');
      }
    };

    scopeNav.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-wo-scope-btn]');
      if (!btn) return;
      if (custom) custom.open = false;
      applyScope(btn.dataset.scope ?? 'weekend');
    });

    customForm?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const fd = new FormData(customForm);
      const from = String(fd.get('from') ?? '');
      const to = String(fd.get('to') ?? '');
      if (!from || !to) return;
      if (custom) custom.open = false;
      applyScope('custom', from, to);
    });

    monthBtn?.addEventListener('click', () => applyScope('month'));

    // Deep links + back/forward.
    const applyFromUrl = () => {
      readingUrl = true;
      try {
      const v = new URLSearchParams(window.location.search).get('date');
      if (!v) {
        applyDefault();
        return;
      }
      if (v === 'next-weekend' || v === 'school-holidays') applyScope(v);
      else if (v === 'this-month') applyScope('month');
      else if (/^\d{4}-\d{2}-\d{2}\.\.\d{4}-\d{2}-\d{2}$/.test(v)) {
        const [from, to] = v.split('..');
        applyScope('custom', from, to);
      } else applyDefault();
      } finally { readingUrl = false; }
    };
    const onScopeHistory = (event: PopStateEvent) => {
      if (!daysEl.isConnected || window.location.pathname !== scopePath || !event.state?.piWhatsOnScope) return;
      // Filter history is local to this document, not an Astro page transition.
      event.stopImmediatePropagation();
      applyFromUrl();
    };
    scopeHistoryHandler = onScopeHistory;
    disposeScope = () => { requestVersion += 1; };
    if (new URLSearchParams(window.location.search).get('date')) applyFromUrl();
  }
  }
  document.addEventListener('astro:page-load', initEventScopes);
  initEventScopes();
</script>

