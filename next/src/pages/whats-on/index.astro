---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideHero from '../../components/GuideHero.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import EventCard from '../../components/EventCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { isUpcoming, routeSlug } from '../../lib/editorial';

// ── Data ──────────────────────────────────────────────────────────────────────
const now = new Date();
const events = (await getCollection('events', ({ data }) => data.status === 'published'))
  .filter((event) => {
    const cancelled = /cancelled/i.test(event.data.verificationStatus ?? '') || /^cancelled:/i.test(event.data.summary ?? '');
    if (cancelled) return false;
    if (['weekly', 'monthly', 'ongoing'].includes(event.data.recurrence)) return true;
    const end = event.data.endDate ?? event.data.startDate;
    return isUpcoming(end, now);
  })
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());

const dispatches = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const currentDispatch = dispatches[0];
const allSignatureEvents = await getCollection('signature-events');
const signatureOrder = [
  'portsea-polo',
  'sorrento-writers-festival',
  'winter-wine-weekend',
  'portsea-swim-classic',
  'peninsula-film-festival',
  'portsea-twilight',
  'main-street-mornington-festival',
  'mornington-winter-music-festival',
  'sailing-regattas',
  'wine-weekends',
  'annual-festivals',
];
const signatureEvents = signatureOrder
  .map((slug) => allSignatureEvents.find((entry) => routeSlug(entry) === slug))
  .filter(Boolean);

const sortAppealThenDate = (a: typeof events[number], b: typeof events[number]) => {
  const ap = a.data.visitorAppealScore ?? 0;
  const bp = b.data.visitorAppealScore ?? 0;
  if (ap !== bp) return bp - ap;
  return a.data.startDate.getTime() - b.data.startDate.getTime();
};

const seasonalEvents = events
  .filter((event) => event.data.category !== 'market')
  .filter((event) => ['annual', 'seasonal', 'ongoing'].includes(event.data.recurrence) || Boolean(event.data.season))
  .sort(sortAppealThenDate)
  .slice(0, 6);

const marketEvents = events
  .filter((event) => event.data.category === 'market')
  .sort(sortAppealThenDate)
  .slice(0, 6);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "What's On" },
];
---

<BaseLayout
  title="What's On Mornington Peninsula · Peninsula Insider"
  description="A curated edit of what's happening across the Mornington Peninsula - organised by season, signature events, and markets."
  section="whats-on"
  canonical="https://peninsulainsider.com.au/whats-on"
  modifiedTime="2026-05-13"
  ogImage="/images/sourced/category-market-02.webp"
>
  <Breadcrumbs items={breadcrumbItems} />

  <GuideHero
    eyebrow="Reviewed weekly by our editors"
    title="What's on, <em>worth your time</em>"
    dek="A curated edit of what's happening across the Peninsula - organised by season and signature events."
    heroImage="/images/sourced/category-market-02.webp"
    imageAlt="Saturday morning at a Peninsula farmers market, part of the seasonal rhythm of the calendar"
    entitySlug="whats-on"
  />

  {currentDispatch && (
    <section class="whatson-briefing" aria-label="Peninsula This Weekend editorial lead">
      <div class="container">
        <div class="whatson-briefing__inner">
          <div class="whatson-briefing__body">
            <p class="label label--accent">Peninsula This Weekend</p>
            <h2 class="whatson-briefing__title">
              <a href="/whats-on/this-weekend/">{currentDispatch.data.title}</a>
            </h2>
            <p class="whatson-briefing__dek">{currentDispatch.data.dek}</p>
            <a class="whatson-briefing__cta" href="/whats-on/this-weekend/">
              Read this weekend’s briefing →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="whatson-section" aria-label="Seasonal events">
    <div class="container">
      <div class="whatson-section__header">
        <p class="label label--accent">Seasonal</p>
        <h2 class="whatson-section__title">Seasonal events and recurring reasons to go</h2>
        <p class="whatson-section__dek">The dates and programs that shape the Peninsula calendar beyond a single weekend.</p>
      </div>
      {seasonalEvents.length > 0 ? (
        <div class="event-grid">
          {seasonalEvents.map((event) => <EventCard event={event} />)}
        </div>
      ) : (
        <p class="whatson-section__empty">Seasonal events are being refreshed.</p>
      )}
    </div>
  </section>

  <SectionDivider />

  <section class="whatson-section" aria-label="Signature Events">
    <div class="container">
      <div class="whatson-section__header whatson-section__header--split">
        <div>
          <p class="label label--accent">Signature Events</p>
          <h2 class="whatson-section__title">The Peninsula's anchor events</h2>
          <p class="whatson-section__dek">Annual events with dedicated landing pages, recurring coverage, and a strong Peninsula identity.</p>
        </div>
        <a class="whatson-section__text-link" href="/events/">View all Signature Events →</a>
      </div>
      <ul class="signature-mini-grid" role="list">
        {signatureEvents.map((entry) => (
          <li class="signature-mini-card">
            <a class="signature-mini-card__link" href={`/events/${routeSlug(entry)}/`}>
              {entry.data.heroImage && (
                <div class="signature-mini-card__image" aria-hidden="true">
                  <img src={entry.data.heroImage} alt={entry.data.heroImageAlt ?? entry.data.name} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="signature-mini-card__body">
                <p class="signature-mini-card__meta">{entry.data.monthAnchor} · {entry.data.location}</p>
                <h3 class="signature-mini-card__title">{entry.data.name}</h3>
                <p class="signature-mini-card__summary">{entry.data.tagline ?? entry.data.summary}</p>
                <span class="signature-mini-card__cta">Read the guide →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SectionDivider />

  <section class="whatson-section" aria-label="Markets">
    <div class="container">
      <div class="whatson-section__header">
        <p class="label label--accent">Markets</p>
        <h2 class="whatson-section__title">Markets worth planning around</h2>
        <p class="whatson-section__dek">Recurring farmers, makers, foreshore and community markets with enough Peninsula character to anchor a morning.</p>
      </div>
      {marketEvents.length > 0 ? (
        <div class="event-grid">
          {marketEvents.map((event) => <EventCard event={event} />)}
        </div>
      ) : (
        <p class="whatson-section__empty">Market listings are being refreshed.</p>
      )}
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  /* Peninsula This Weekend — editorial lead section
     Text-only strip. GuideHero above already provides the visual.
     Strong typography carries the editorial weight. */
  .whatson-briefing {
    padding: clamp(1.25rem, 3vw, 2rem) 0 0;
  }

  .whatson-briefing__inner {
    border-top: 1px solid var(--border, #d8d3c8);
    border-bottom: 1px solid var(--border, #d8d3c8);
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  .whatson-briefing__body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 56rem;
  }

  .whatson-briefing__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.35rem, 2.8vw, 2.2rem);
    line-height: 1.2;
    margin: 0;
    text-wrap: balance;
  }

  .whatson-briefing__title a {
    color: inherit;
    text-decoration: none;
  }

  .whatson-briefing__title a:hover {
    color: var(--accent, #8a6a3b);
  }

  .whatson-briefing__dek {
    margin: 0;
    color: var(--soft, #5f5a50);
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .whatson-briefing__cta,
  .whatson-section__text-link {
    color: var(--accent, #8a6a3b);
    font-weight: 500;
    text-decoration: none;
    font-size: 0.85rem;
    align-self: flex-start;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .whatson-section {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
  }

  .whatson-section__header {
    max-width: 48rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .whatson-section__header--split {
    max-width: none;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
  }

  .whatson-section__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1.1;
    margin: 0.35rem 0;
  }

  .whatson-section__dek,
  .whatson-section__empty {
    color: var(--text-muted, #5f5a50);
    line-height: 1.6;
    margin: 0;
  }

  .signature-mini-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .signature-mini-card {
    border: 1px solid var(--border, #d8d3c8);
    background: var(--surface, #fdfbf6);
  }

  .signature-mini-card__link {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .signature-mini-card__image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-mute, #ece6d8);
  }

  .signature-mini-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .signature-mini-card__body {
    padding: 1rem 1.1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .signature-mini-card__meta {
    margin: 0;
    color: var(--accent, #8a6a3b);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }

  .signature-mini-card__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.18rem;
    line-height: 1.25;
    margin: 0;
  }

  .signature-mini-card__summary {
    margin: 0;
    color: var(--text-muted, #5f5a50);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .signature-mini-card__cta {
    margin-top: auto;
    color: var(--accent, #8a6a3b);
    font-weight: 700;
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .whatson-briefing__inner,
    .whatson-section__header--split {
      display: block;
    }

    .whatson-briefing__cta,
    .whatson-section__text-link {
      display: inline-block;
      margin-top: 0.9rem;
      white-space: normal;
    }
  }
</style>
