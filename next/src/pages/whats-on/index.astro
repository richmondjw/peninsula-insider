---
import { pageImage } from '../../lib/page-images';
/**
 * /whats-on/ - the canonical When front door (v5 rebuild, T-601).
 *
 * Structure per page-redesigns-hubs.md section 7 + wireframes #whatson:
 *   1. h1 date context + selection rule (one line)
 *   2. Scope controls: This weekend (default, in-DOM) / Pick dates /
 *      Next weekend / School holidays
 *   3. PI's picks: exactly 3, Local voice verdicts
 *   4. Rows for the current scope, each event once: an "On all weekend"
 *      strip for runs and multi-day series (three rows, the rest behind
 *      "Show all"), then day groups for what is tied to one day, each led
 *      where possible by one thumbnail feature row (weekend is fully
 *      server-rendered; other scopes render client-side from feed.json)
 *   5. Shelf anchor links + category shelves (Markets, Live music,
 *      Food & wine, Exhibitions & arts, Major events), minus anything the
 *      weekend already showed
 *   6. Month+ on demand via the JSON island at /whats-on/feed.json
 *      (HUB-11 closed: zero hidden pre-rendered cards)
 *
 * Event JSON-LD kept; NO price offers are emitted (house rule).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import WhatsOnScopeBar from '../../components/v5/whatson/WhatsOnScopeBar.astro';
import WhatsOnRow from '../../components/v5/whatson/WhatsOnRow.astro';
import TrustNote from '../../components/v5/hub/TrustNote.astro';
import {
  loadLiveEvents,
  weekendWindow,
  schoolHolidayWindow,
  groupWeekend,
  getPicks,
  getShelves,
  isoDate,
  startOfDay,
  type OccurrenceState,
} from './_data';
import { getAustralianSeasonLower } from '../../lib/season';

export const prerender = true;

const now = new Date();
const events = await loadLiveEvents(now);

const weekend = weekendWindow(now);
const nextWeekend = weekendWindow(now, 1);
const holidays = schoolHolidayWindow(now);

const picks = await getPicks(events, weekend, now);
const pickSlugs = new Set(picks.map((p) => p.live.slug));

// WO1: every event once. Picks are left out of the lists below them; runs
// and multi-day series sit once in "On all weekend"; a day group holds only
// what is tied to that day; the shelves then skip everything already shown.
const { ongoing, days: dayGroups } = groupWeekend(events, weekend, now, pickSlugs);
const weekendCount = ongoing.length + dayGroups.reduce((n, g) => n + g.items.length, 0);

const shownSlugs = new Set([
  ...pickSlugs,
  ...ongoing.map((it) => it.live.slug),
  ...dayGroups.flatMap((g) => g.items.map((it) => it.live.slug)),
]);
const shelves = getShelves(events, now, shownSlugs).filter((s) => s.items.length > 0);

// WO23: the "On all weekend" group is a compact strip. Three rows show; the
// rest stay in the DOM behind "Show all". Order is untouched.
const STRIP_VISIBLE = 3;

// WO23: one feature row per day group and shelf. Items arrive highest
// appeal first, so the first that may show its own photograph is the one.
// Nothing moves; the chosen row simply carries its thumbnail.
const featureIndex = (lives: { thumb: { src: string; alt: string } | null }[]) =>
  lives.findIndex((live) => live.thumb !== null);
const dayFeature = dayGroups.map((g) => featureIndex(g.items.map((it) => it.live)));
const shelfFeature = shelves.map((s) => featureIndex(s.items.map((it) => it.live)));

// ── JSON-LD: Event nodes for everything server-rendered (picks + weekend
// rows), deduped. Deliberately no offers: pricing never ships in schema
// or copy (house rule; priceBand chips only elsewhere).
const SITE_ORIGIN = 'https://peninsulainsider.com.au';
const truncate = (text: unknown, n = 200): string => {
  const s = String(text ?? '').replace(/\s+/g, ' ').trim();
  return s.length <= n ? s : `${s.slice(0, n - 1).trimEnd()}…`;
};
const ldSeen = new Set<string>();
const ldEvents: Record<string, any>[] = [];
// PI-008: the ItemList used to stamp EventScheduled on every node, so a
// sold-out night and a cancelled market both told search engines they were
// going ahead as normal. Status now comes from the same resolver the page
// renders from, and a finished occurrence emits no status at all (an
// EventScheduled with a past endDate is what lint-seo-architecture.mjs fails
// the build over).
//
// That was half done. The helper that lived here re-derived the status from
// the raw `cancelled` flag: one of the four signals that record a cancellation,
// and none of the occurrence-level exceptions at all. A weekly market cancelled
// for a single Thursday would have rendered "Cancelled this time" with
// EventScheduled in the markup beside it. The state _data.ts resolved is now
// the only answer on this page.
const pushLd = (
  live: (typeof events)[number],
  occursISO: string,
  state: OccurrenceState
) => {
  if (ldSeen.has(live.slug)) return;
  ldSeen.add(live.slug);
  const data = live.event.data as Record<string, any>;
  const heroSrc = data.heroImage?.src;
  const imageUrl = heroSrc
    ? heroSrc.startsWith('http')
      ? heroSrc
      : `${SITE_ORIGIN}${heroSrc}`
    : undefined;
  ldEvents.push({
    '@type': 'Event',
    name: data.title,
    startDate: occursISO,
    url: `${SITE_ORIGIN}${live.href}`,
    ...(imageUrl ? { image: imageUrl } : {}),
    description: truncate(data.summary),
    ...(state.schemaStatus ? { eventStatus: state.schemaStatus } : {}),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: data.venueName || data.suburb || 'Mornington Peninsula',
      address: {
        '@type': 'PostalAddress',
        ...(data.streetAddress ? { streetAddress: data.streetAddress } : {}),
        addressLocality: data.suburb || data.venueRegion || 'Mornington Peninsula',
        addressRegion: 'VIC',
        addressCountry: 'AU',
      },
    },
  });
};
for (const p of picks) pushLd(p.live, p.dateISO, p.occurrence);
for (const it of ongoing) pushLd(it.live, it.dayIso, it);
for (const g of dayGroups) {
  for (const it of g.items) {
    pushLd(it.live, g.iso, it);
  }
}
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "What's On Mornington Peninsula",
  url: `${SITE_ORIGIN}/whats-on/`,
  numberOfItems: ldEvents.length,
  itemListElement: ldEvents.map((ev, i) => ({ '@type': 'ListItem', position: i + 1, item: ev })),
};

// Pick cards, precomputed here: the Astro compiler cannot parse TS generics
// inside template expressions, and the template stays declarative this way.
const pickCards = picks.map((p, i) => {
  const data = p.live.event.data as Record<string, any>;
  return {
    title: p.live.title,
    href: p.live.href,
    slug: p.live.slug,
    image: data.heroImage
      ? { src: data.heroImage.src as string, alt: (data.heroImage.alt ?? p.live.title) as string }
      : undefined,
    verdict: p.verdict,
    // One meta schema for every pick (WO22): when, where, then category or
    // access. A dated pick's "when" is its day; an ongoing or recurring one
    // gives its time, or failing that its cadence, so the first slot is never
    // skipped and the three cards' meta lines read alike. Its tag on the
    // image uses the same cadence vocabulary as the rows.
    meta: [p.showDate ? p.dayLabel : p.live.timeLabel || p.badge, ...p.live.details]
      .filter(Boolean)
      .slice(0, 3),
    dateISO: p.showDate ? p.dateISO : undefined,
    badge: p.badge,
    position: i + 1,
  };
});

const season = getAustralianSeasonLower(now);
const todayISO = isoDate(startOfDay(now));
const modifiedTime = todayISO;
const pageDescription = `Browse Mornington Peninsula events by date: markets, live music, exhibitions and festivals. Choose this weekend, school holidays or your own dates.`;
---

<BaseLayout
  title="What's On Mornington Peninsula | Events Calendar"
  description={pageDescription}
  section="whats-on"
  canonical="https://peninsulainsider.com.au/whats-on"
  ogImage={pageImage('whats-on-hub').src}
  modifiedTime={modifiedTime}
>
  <script data-wo-event-schema type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <header class="wo-head">
    <div class="container wo-head__inner">
      <h1 class="wo-head__title" data-wo-heading>What’s on this weekend</h1>
      <p class="wo-head__context">
        <span data-wo-range>{weekend.label}</span> · {season} on the Peninsula
      </p>
      <p class="wo-head__note">Browse events by date, then check the organiser before you go.</p>
    </div>
  </header>

  <div class="container wo-scope-wrap">
    <WhatsOnScopeBar
      weekendStartISO={isoDate(weekend.start)}
      weekendLabel={weekend.label}
      nextWeekendLabel={nextWeekend.label}
      holidays={holidays
        ? {
            startISO: isoDate(holidays.start),
            endISO: isoDate(holidays.end),
            label: holidays.label,
            name: holidays.name,
          }
        : null}
      todayISO={todayISO}
    />
    <TrustNote surface="whatson" />
  </div>

  {picks.length > 0 && (
    <section class="wo-picks pi-section" aria-labelledby="wo-picks-h">
      <div class="container">
        <div class="pi-section-head">
          <div class="pi-section-head__text">
            <h2 class="pi-h2" id="wo-picks-h">PI’s picks</h2>
            <p class="pi-section-dek">Selected events for this weekend.</p>
          </div>
        </div>
        {/* Every card here is an event on the What's On page, under a heading
            that says so: the per-card EVENT stamp is dropped. */}
        <CardGrid label="PI’s picks for this weekend">
          {pickCards.map((c) => (
            <Card
              variant="event"
              title={c.title}
              href={c.href}
              entityType="event"
              entitySlug={c.slug}
              image={c.image}
              verdict={c.verdict}
              meta={c.meta}
              dateISO={c.dateISO}
              showEyebrow={false}
              mediaFallback={true}
              trip={true}
              surface="whatson"
              position={c.position}
            >
              {c.badge && <span slot="badges" class="wo-pick-tag">{c.badge}</span>}
            </Card>
          ))}
        </CardGrid>
      </div>
    </section>
  )}

  <section class="wo-days pi-section" aria-labelledby="wo-days-h">
    <div class="container">
      <div class="pi-section-head">
        <div class="pi-section-head__text">
          <h2 class="pi-h2" id="wo-days-h">Everything on, by day</h2>
        </div>
        <p id="pi-results-status" class="wo-vh" role="status" aria-live="polite"></p>
      </div>
      <div class="wo-days__groups" data-wo-days data-wo-default-count={weekendCount}>
        {ongoing.length > 0 && (
          <section class="wo-day wo-day--ongoing" aria-labelledby="wo-day-ongoing-h">
            <h3 class="wo-day__h" id="wo-day-ongoing-h">On all weekend</h3>
            <ul class="wo-day__list" role="list">
              {ongoing.map((it, i) => (
                <WhatsOnRow
                  title={it.live.title}
                  href={it.live.href}
                  slug={it.live.slug}
                  oneLiner={it.live.oneLiner}
                  when={it.spanLabel}
                  meta={[it.live.timeLabel, ...it.live.details]}
                  statusLabel={it.statusLabel}
                  phase={it.phase}
                  bookable={it.bookable}
                  strip
                  collapsed={i >= STRIP_VISIBLE}
                />
              ))}
            </ul>
            {ongoing.length > STRIP_VISIBLE && (
              <button type="button" class="wo-day__more" data-wo-more>
                Show all {ongoing.length}
              </button>
            )}
          </section>
        )}
        {dayGroups.map((g, gi) => (
          <section class="wo-day">
            <h3 class="wo-day__h">{g.heading}</h3>
            {g.items.length > 0 ? (
              <ul class="wo-day__list" role="list">
                {g.items.map((it, i) => (
                  <WhatsOnRow
                    title={it.live.title}
                    href={it.live.href}
                    slug={it.live.slug}
                    oneLiner={it.live.oneLiner}
                    when={it.live.timeLabel || it.spanLabel}
                    meta={[it.live.timeLabel ? it.spanLabel : '', ...it.live.details]}
                    statusLabel={it.statusLabel}
                    phase={it.phase}
                    bookable={it.bookable}
                    image={i === dayFeature[gi] ? it.live.thumb : null}
                  />
                ))}
              </ul>
            ) : (
              <p class="wo-day__empty">{g.emptyMessage}</p>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>

  {shelves.length > 0 && (
    <section class="wo-shelves pi-section" aria-labelledby="wo-shelves-h">
      <div class="container">
        <div class="pi-section-head wo-shelves__head">
          <div class="pi-section-head__text">
            <h2 class="pi-h2" id="wo-shelves-h">Browse the next two months</h2>
          </div>
        </div>
        <nav class="wo-shelfnav" aria-label="Jump to a category">
          <div class="wo-shelfnav__row">
            {shelves.map((s) => (
              <a class="wo-shelfnav__link" href={`#${s.id}`}>{s.label}</a>
            ))}
          </div>
        </nav>
        {shelves.map((s, si) => (
          <section class="wo-shelf" id={s.id} aria-labelledby={`${s.id}-h`}>
            <h3 class="wo-shelf__h" id={`${s.id}-h`}>{s.label}</h3>
            <ul class="wo-shelf__list" role="list">
              {s.items.map(({ live, when }, i) => (
                <WhatsOnRow
                  title={live.title}
                  href={live.href}
                  slug={live.slug}
                  oneLiner={live.oneLiner}
                  when={when}
                  meta={[live.timeLabel, ...live.details]}
                  image={i === shelfFeature[si] ? live.thumb : null}
                />
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  )}

  {/* The one route to a longer horizon, after the shelves rather than
      competing with them. */}
  <div class="container wo-more">
    <button type="button" class="pi-btn pi-btn--ghost wo-more__btn" data-wo-month data-evt="wo_date_change" hidden>
      See the month ahead
    </button>
    <noscript>
      <p class="wo-more__noscript">
        Longer horizons load with JavaScript on; the weekend above is the complete current edit.
      </p>
    </noscript>
  </div>

  <NewsletterBlock />

  {/* Row template for client-side scope rendering: cloned by the script
      below, never displayed. Template content is inert (not hidden DOM
      weight in the HUB-11 sense: one empty row, no event content). */}
  <template data-wo-row-template>
    <WhatsOnRow title="" href="" slug="" />
  </template>
  {/* Without JavaScript the "Show all" control cannot run, so every strip
      row shows and the control goes. */}
  <noscript>
    <style is:inline>
      .wo-row[data-wo-more-row] { display: grid !important; }
      [data-wo-more] { display: none !important; }
    </style>
  </noscript>
</BaseLayout>

<script>
  // ── /whats-on/ scope engine ──────────────────────────────────────────
  // Default (this weekend) is fully server-rendered. Every other scope
  // fetches /whats-on/feed.json once and renders compact rows from it:
  // the month+ horizon is a JSON island, never hidden DOM (HUB-11).
  import { initV5Analytics } from '../../lib/v5-analytics';
  import { tripAdd } from '../../lib/v5-store';
  import { startOfDay, addDays, rangeLabel, weekendWindow, occursOnDay, isoDate } from '../../lib/event-schedule';
  import { resolveListingOccurrence, listingDateLabel, partitionWindow } from '../../lib/whatson-listing.mjs';
  import { emptyDayMessage } from '../../lib/whatson-empty-state.mjs';

  initV5Analytics();

  // "Add to trip" wiring (list rows; pick cards wire their own). The
  // data-evt="trip_add" analytics fires via the delegated v5-analytics
  // listener; this adds the store behaviour. Only the visible label changes,
  // and the button's minimum width holds it steady between the two labels.
  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-evt="trip_add"]:not([data-card-trip])');
    if (!btn || btn.dataset.added === 'true') return;
    const slug = btn.dataset.entitySlug;
    if (!slug) return;
    const title = btn.dataset.entityTitle || slug;
    const href = btn.dataset.entityHref || `/whats-on/${slug}/`;
    const label = btn.querySelector<HTMLElement>('.wo-row__trip-label') ?? btn;
    if (!tripAdd({ kind: 'event', slug, title, href })) {
      // The write did not land; say so rather than painting "In trip".
      const previous = label.textContent;
      const previousName = btn.getAttribute('aria-label');
      label.textContent = 'Not added';
      btn.setAttribute('aria-label', `${title} was not added to your trip`);
      setTimeout(() => {
        label.textContent = previous;
        if (previousName) btn.setAttribute('aria-label', previousName);
      }, 2000);
      return;
    }
    btn.dataset.added = 'true';
    label.textContent = 'In trip';
    btn.setAttribute('aria-label', `${title} is in your trip`);
  });

  interface FeedEntry {
    slug: string;
    href: string;
    t: string;
    d: string;
    m: string[];
    tm?: string;
    dt?: string[];
    k: 'range' | 'weekly' | 'monthly';
    s: string;
    e: string;
    wd?: number;
    wds?: number[];
    nth?: number;
    months?: number[];
    x?: string;
    statusData?: Record<string, any>;
    im?: { src: string; alt: string };
  }

  // WO23: the ongoing strip shows this many rows before "Show all".
  const STRIP_VISIBLE = 3;

  let scopeHistoryHandler: ((event: PopStateEvent) => void) | null = null;
  let disposeScope: (() => void) | null = null;
  window.addEventListener('popstate', (event) => scopeHistoryHandler?.(event), true);
  document.addEventListener('astro:before-swap', () => {
    disposeScope?.();
    disposeScope = null;
    scopeHistoryHandler = null;
  });

  function initEventScopes() {
  const daysEl = document.querySelector<HTMLElement>('[data-wo-days]');
  const scopeNav = document.querySelector<HTMLElement>('[data-wo-scope]');
  const headingEl = document.querySelector<HTMLElement>('[data-wo-heading]');
  const rangeEl = document.querySelector<HTMLElement>('[data-wo-range]');
  const statusEl = document.getElementById('pi-results-status');
  const monthBtn = document.querySelector<HTMLButtonElement>('[data-wo-month]');
  const custom = document.querySelector<HTMLDetailsElement>('[data-wo-custom]');
  const customForm = document.querySelector<HTMLFormElement>('[data-wo-custom-form]');
  const rowTpl = document.querySelector<HTMLTemplateElement>('[data-wo-row-template]');

  if (daysEl && scopeNav && rowTpl) {
    if (daysEl.dataset.scopeInitialized === 'true') return;
    daysEl.dataset.scopeInitialized = 'true';
    const scopePath = window.location.pathname;
    history.replaceState({ ...history.state, piWhatsOnScope: true }, '');
    const defaultHTML = daysEl.innerHTML;
    const defaultRange = rangeEl?.textContent ?? '';
    if (monthBtn) monthBtn.hidden = false;

    // "Show all" on the ongoing strip (WO23): reveal the rows held back,
    // retire the control, and move focus to the first revealed title. One
    // delegated listener on the list container, so rows restored from
    // defaultHTML or drawn for another scope need no rewiring.
    daysEl.addEventListener('click', (ev) => {
      const more = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-wo-more]');
      if (!more) return;
      const held = Array.from(more.closest('.wo-day')?.querySelectorAll<HTMLElement>('[data-wo-more-row]') ?? []);
      held.forEach((row) => {
        row.hidden = false;
        delete row.dataset.woMoreRow;
      });
      more.remove();
      held[0]?.querySelector<HTMLElement>('.wo-row__link')?.focus();
    });

    // Calendar dates use Melbourne's day and UTC date-only arithmetic in all surfaces.
    const parseISO = (s: string) => new Date(`${s}T00:00:00Z`);
    const fmt = (d: Date, opts: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-AU', { ...opts, timeZone: 'UTC' });
    const ruleOf = (e: FeedEntry) => ({
      kind: e.k, start: parseISO(e.s), end: parseISO(e.e), day: e.wd,
      days: e.wds, nth: e.nth, months: e.months,
    });
    const occursOn = (e: FeedEntry, d: Date) => occursOnDay(ruleOf(e), d);

    // This editorial shortlist and its Event schema belong to the default
    // window. Detach both for other dates; restore both together on return.
    const picksEl = document.querySelector<HTMLElement>('.wo-picks');
    const eventSchema = document.querySelector<HTMLScriptElement>('[data-wo-event-schema]');
    const scopedNodes = [picksEl, eventSchema].filter((node): node is HTMLElement => !!node);
    const anchors = scopedNodes.map((node) => {
      const anchor = document.createComment('default weekend content');
      node.before(anchor);
      return { node, anchor };
    });
    const showDefaultContent = (show: boolean) => anchors.forEach(({ node, anchor }) => {
      if (show) anchor.after(node); else node.remove();
    });
    let requestVersion = 0;
    let readingUrl = false;

    // ── feed island (fetched once, on first non-default scope) ─────────
    let feedPromise: Promise<FeedEntry[]> | null = null;
    const loadFeed = () => {
      feedPromise ??= fetch('/whats-on/feed.json')
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then((j) => j.events as FeedEntry[])
        .catch((error) => { feedPromise = null; throw error; });
      return feedPromise;
    };

    // Same markup and token order as the server rows (WhatsOnRow): the lead
    // token fills column 1 and opens the meta list; the rest follow as
    // unbreakable list items. A strip row drops its dek; a feature row
    // carries the event's own thumbnail (only sent when it may show one).
    const buildRow = (
      e: FeedEntry,
      when: string,
      tokens: string[],
      days: Date[],
      opts: { strip?: boolean; feature?: boolean } = {}
    ): HTMLElement => {
      const frag = rowTpl.content.cloneNode(true) as DocumentFragment;
      const row = frag.querySelector<HTMLElement>('.wo-row')!;
      if (opts.strip) row.classList.add('wo-row--strip');
      if (opts.feature && e.im) {
        row.classList.add('wo-row--feature');
        const thumb = document.createElement('div');
        thumb.className = 'wo-row__thumb';
        const img = document.createElement('img');
        img.src = e.im.src;
        img.alt = '';
        img.width = 120;
        img.height = 90;
        img.loading = 'lazy';
        img.decoding = 'async';
        thumb.appendChild(img);
        row.querySelector<HTMLElement>('.wo-row__when')!.after(thumb);
      }
      // An ongoing row reads its state on its first day that has not finished.
      let occurrence: ReturnType<typeof resolveListingOccurrence> | null = null;
      if (e.statusData) {
        for (const day of days) {
          occurrence = resolveListingOccurrence(e.statusData, ruleOf(e), isoDate(day));
          if (occurrence.phase !== 'past') break;
        }
      }
      if (occurrence) {
        row.dataset.occurrencePhase = occurrence.phase;
        row.dataset.occurrenceBookable = String(occurrence.bookable);
      }
      const link = row.querySelector<HTMLAnchorElement>('.wo-row__link')!;
      link.href = e.href;
      link.textContent = e.t;
      link.dataset.entitySlug = e.slug;
      row.querySelector<HTMLElement>('.wo-row__dek')!.textContent = opts.strip ? '' : e.d;
      row.querySelector<HTMLElement>('.wo-row__when')!.textContent = when;
      const metaEl = row.querySelector<HTMLElement>('.wo-row__meta')!;
      metaEl.textContent = '';
      const status = occurrence ? (occurrence.label ?? '') : (e.x ?? '');
      if (when) {
        const li = document.createElement('li');
        li.className = 'wo-row__meta-when';
        li.textContent = when;
        metaEl.appendChild(li);
      }
      for (const token of [...tokens, status].filter(Boolean)) {
        const li = document.createElement('li');
        li.textContent = token;
        metaEl.appendChild(li);
      }
      const save = row.querySelector<HTMLElement>('[data-v5-save-control]');
      if (save) {
        save.dataset.slug = e.slug;
        save.dataset.title = e.t;
        save.dataset.href = e.href;
        save.dataset.dek = e.d;
        const saveBtn = save.querySelector<HTMLElement>('[data-v5-save-btn]');
        saveBtn?.setAttribute('aria-label', `Save ${e.t}`);
      }
      const trip = row.querySelector<HTMLElement>('.wo-row__trip');
      if (trip) {
        trip.dataset.entitySlug = e.slug;
        trip.dataset.entityTitle = e.t;
        trip.dataset.entityHref = e.href;
        trip.setAttribute('aria-label', `Add ${e.t} to trip`);
      }
      return row;
    };

    const groupSection = (heading: string, rows: HTMLElement[]): HTMLElement => {
      const section = document.createElement('section');
      section.className = 'wo-day';
      const h = document.createElement('h3');
      h.className = 'wo-day__h';
      h.textContent = heading;
      section.appendChild(h);
      if (rows.length > 0) {
        const ul = document.createElement('ul');
        ul.className = 'wo-day__list';
        ul.setAttribute('role', 'list');
        rows.forEach((row) => ul.appendChild(row));
        section.appendChild(ul);
      } else {
        const p = document.createElement('p');
        p.className = 'wo-day__empty';
        p.textContent = emptyDayMessage(0);
        section.appendChild(p);
      }
      return section;
    };

    // Each listing once (WO1): anything on across more than one day of the
    // window is listed once at the top with its date token; a day group holds
    // only what is tied to that day. A day covered only by the ongoing group
    // is left out; a short window keeps a truly empty day with its message.
    const renderWindow = (entries: FeedEntry[], start: Date, end: Date): number => {
      const dayCount = Math.min(
        62,
        Math.round((startOfDay(end).getTime() - startOfDay(start).getTime()) / 86400000) + 1
      );
      const showEmptyDays = dayCount <= 4;
      const dayDates = Array.from({ length: dayCount }, (_, i) => addDays(start, i));
      const win = { start, end };
      const split = partitionWindow(entries, dayDates, occursOn);
      const details = (e: FeedEntry) => e.dt ?? e.m;
      daysEl.textContent = '';
      let shown = 0;
      if (split.ongoing.length > 0) {
        // The same compact strip as the server render (WO23).
        const rows = split.ongoing.map(({ item: e, dayIndexes }: { item: FeedEntry; dayIndexes: number[] }) =>
          buildRow(e, listingDateLabel(ruleOf(e), win), [e.tm ?? '', ...details(e)], dayIndexes.map((i) => dayDates[i]), { strip: true }));
        rows.slice(STRIP_VISIBLE).forEach((row) => {
          row.hidden = true;
          row.dataset.woMoreRow = '';
        });
        const section = groupSection(dayCount <= 3 ? 'On all weekend' : 'On across these dates', rows);
        section.classList.add('wo-day--ongoing');
        if (rows.length > STRIP_VISIBLE) {
          const more = document.createElement('button');
          more.type = 'button';
          more.className = 'wo-day__more';
          more.dataset.woMore = '';
          more.textContent = `Show all ${rows.length}`;
          section.appendChild(more);
        }
        daysEl.appendChild(section);
        shown += rows.length;
      }
      split.days.forEach(({ day, items, ongoingCount }: { day: Date; items: FeedEntry[]; ongoingCount: number }) => {
        if (items.length === 0 && (ongoingCount > 0 || !showEmptyDays)) return;
        // Entries arrive highest appeal first: the first with a thumbnail
        // leads the group as its feature row, in place (WO23).
        const feature = items.findIndex((e) => !!e.im);
        const rows = items.map((e, i) => {
          // A row with no time leads with its cadence instead (WO22), so
          // column 1 is never blank; the cadence then leaves the meta line.
          const cadence = listingDateLabel(ruleOf(e), win);
          return buildRow(e, e.tm || cadence, [e.tm ? cadence : '', ...details(e)], [day], { feature: i === feature });
        });
        daysEl.appendChild(groupSection(fmt(day, { weekday: 'long', day: 'numeric', month: 'long' }), rows));
        shown += rows.length;
      });
      if (shown === 0) {
        const p = document.createElement('p');
        p.className = 'wo-day__empty';
        p.textContent = 'Nothing listed for those dates yet. Try the month ahead.';
        daysEl.appendChild(p);
      }
      // Re-run SaveControl hydration for the cloned rows (its init listens
      // for astro:page-load; hydrate() is idempotent).
      document.dispatchEvent(new Event('astro:page-load'));
      return shown;
    };

    // ── scope application + URL sync ────────────────────────────────────
    const setPressed = (scope: string) => {
      scopeNav.querySelectorAll<HTMLButtonElement>('[data-wo-scope-btn]').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.scope === scope ? 'true' : 'false');
      });
      if (custom) custom.dataset.active = scope === 'custom' ? 'true' : 'false';
    };

    const announce = (n: number, label: string) => {
      if (statusEl) {
        statusEl.textContent = n === 1 ? `Showing 1 event for ${label}` : `Showing ${n} events for ${label}`;
      }
    };

    const syncUrl = (param: string | null) => {
      const url = new URL(window.location.href);
      if (param) url.searchParams.set('date', param);
      else url.searchParams.delete('date');
      if (!readingUrl && url.href !== window.location.href) history.pushState({ ...history.state, piWhatsOnScope: true }, '', url.pathname + url.search + url.hash);
    };

    const setHeading = (headline: string, label: string) => {
      if (headingEl) headingEl.textContent = headline;
      if (rangeEl) rangeEl.textContent = label;
    };

    const applyDefault = () => {
      requestVersion += 1;
      showDefaultContent(true);
      daysEl.innerHTML = defaultHTML;
      setPressed('weekend');
      setHeading('What’s on this weekend', defaultRange);
      syncUrl(null);
      announce(Number(daysEl.dataset.woDefaultCount ?? 0), 'this weekend');
      document.dispatchEvent(new Event('astro:page-load'));
    };

    const applyWindow = async (
      scope: string,
      start: Date,
      end: Date,
      headline: string,
      param: string,
      announceLabel: string
    ) => {
      const version = ++requestVersion;
      showDefaultContent(false);
      daysEl.textContent = 'Loading events for these dates…';
      setPressed(scope);
      const label = rangeLabel(start, end);
      setHeading(headline, label);
      syncUrl(param);
      try {
        const entries = await loadFeed();
        if (version !== requestVersion) return;
        const shown = renderWindow(entries, start, end);
        announce(shown, announceLabel);
      } catch {
        if (version !== requestVersion) return;
        applyDefault();
        if (statusEl) statusEl.textContent = 'Could not load those dates. Showing this weekend instead.';
        document.dispatchEvent(new Event('astro:page-load'));
      }
    };

    const applyScope = (scope: string, from?: string, to?: string) => {
      if (scope === 'weekend') {
        applyDefault();
        return;
      }
      if (scope === 'next-weekend') {
        const w = weekendWindow(new Date(), 1);
        applyWindow(scope, w.start, w.end, 'What’s on next weekend', 'next-weekend', 'next weekend');
        return;
      }
      if (scope === 'school-holidays' && scopeNav.dataset.holidayStart) {
        const hs = parseISO(scopeNav.dataset.holidayStart);
        const today = startOfDay(new Date());
        const start = hs > today ? hs : today;
        const end = parseISO(scopeNav.dataset.holidayEnd || scopeNav.dataset.holidayStart);
        applyWindow(scope, start, end, 'What’s on these school holidays', 'school-holidays', 'the school holidays');
        return;
      }
      if (scope === 'month') {
        const today = startOfDay(new Date());
        applyWindow(scope, today, addDays(today, 31), 'What’s on this month', 'this-month', 'the month ahead');
        return;
      }
      if (scope === 'custom' && from && to) {
        let a = parseISO(from);
        let b = parseISO(to);
        if (!Number.isFinite(a.getTime()) || !Number.isFinite(b.getTime()) || isoDate(a) !== from || isoDate(b) !== to) { applyDefault(); return; }
        if (b < a) [a, b] = [b, a];
        if ((b.getTime() - a.getTime()) / 86400000 > 61) b = addDays(a, 61);
        applyWindow(scope, a, b, 'What’s on for your dates', `${isoDate(a)}..${isoDate(b)}`, 'your dates');
      }
    };

    scopeNav.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-wo-scope-btn]');
      if (!btn) return;
      if (custom) custom.open = false;
      applyScope(btn.dataset.scope ?? 'weekend');
    });

    customForm?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const fd = new FormData(customForm);
      const from = String(fd.get('from') ?? '');
      const to = String(fd.get('to') ?? '');
      if (!from || !to) return;
      if (custom) custom.open = false;
      applyScope('custom', from, to);
    });

    monthBtn?.addEventListener('click', () => applyScope('month'));

    // Deep links + back/forward.
    const applyFromUrl = () => {
      readingUrl = true;
      try {
      const v = new URLSearchParams(window.location.search).get('date');
      if (!v) {
        applyDefault();
        return;
      }
      if (v === 'next-weekend' || v === 'school-holidays') applyScope(v);
      else if (v === 'this-month') applyScope('month');
      else if (/^\d{4}-\d{2}-\d{2}\.\.\d{4}-\d{2}-\d{2}$/.test(v)) {
        const [from, to] = v.split('..');
        applyScope('custom', from, to);
      } else applyDefault();
      } finally { readingUrl = false; }
    };
    const onScopeHistory = (event: PopStateEvent) => {
      if (!daysEl.isConnected || window.location.pathname !== scopePath || !event.state?.piWhatsOnScope) return;
      // Filter history is local to this document, not an Astro page transition.
      event.stopImmediatePropagation();
      applyFromUrl();
    };
    scopeHistoryHandler = onScopeHistory;
    disposeScope = () => { requestVersion += 1; };
    if (new URLSearchParams(window.location.search).get('date')) applyFromUrl();
  }
  }
  document.addEventListener('astro:page-load', initEventScopes);
  initEventScopes();
</script>

<style>
  /* Visually hidden live region */
  .wo-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Hero: H1, then two tiers (the dateline in ink, one muted line 8px
     below), then a frame-width rule 24px under them and 24px above the
     chips (WO3). The rule sits on the container so it stops at the frame. ── */
  .wo-head {
    padding-top: clamp(1.5rem, 4vw, 2.75rem);
    background: var(--bg);
    color: var(--text);
  }
  .wo-head__inner {
    padding-bottom: var(--space-5, 1.5rem);
    border-bottom: 1px solid var(--border);
  }
  .wo-head__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-900, clamp(2.5rem, 1.6rem + 4vw, 4rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-display, 1.02);
    letter-spacing: var(--ls-display, -0.02em);
    color: var(--text);
    text-wrap: balance;
  }
  .wo-head__context {
    margin: var(--space-4, 1rem) 0 0;
    color: var(--text);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-500, 1.25rem);
    line-height: 1.35;
  }
  .wo-head__note {
    margin: var(--space-2, 0.5rem) 0 0;
    color: var(--soft);
    font-size: var(--fs-300, 0.9375rem);
    line-height: 1.5;
    font-style: normal;
  }
  .wo-scope-wrap {
    padding-top: var(--space-5, 1.5rem);
  }

  /* ── Section rhythm: one --section-space between sections, not two.
     The picks follow the scope controls a step closer (48px), because they
     answer the dates just chosen. When another scope removes the picks, the
     day list takes that same 48px. ── */
  .pi-section.wo-picks,
  .pi-section.wo-days,
  .pi-section.wo-shelves {
    padding-block: var(--section-space, 4rem);
  }
  .pi-section.wo-picks,
  .pi-section.wo-days {
    padding-top: var(--space-7, 3rem);
  }
  .wo-picks + .pi-section.wo-days,
  .pi-section.wo-shelves {
    padding-top: 0;
  }
  .pi-section.wo-shelves {
    padding-bottom: var(--space-7, 3rem);
  }

  /* Picks that run all weekend or recur carry a sand tag in place of the
     calendar block, in the same corner. */
  .wo-pick-tag {
    position: absolute;
    top: var(--space-3, 0.75rem);
    left: var(--space-3, 0.75rem);
    z-index: 1;
    padding: 0.4rem 0.6rem;
    background: var(--sand);
    color: var(--harbour-deep, var(--text));
    border-radius: var(--radius-s, 8px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-100, 0.75rem);
    font-weight: var(--fw-semibold, 600);
    line-height: 1.2;
    letter-spacing: var(--ls-eyebrow, 0.08em);
    text-transform: uppercase;
  }

  /* ── Group rhythm (WO23): one gap between groups in both lists, 64px
     (48px on phones), measured from the hairline that closes one list to
     the next heading. Every row carries its bottom rule, so each list
     closes on the same hairline that separates its rows. ── */
  .wo-days,
  .wo-shelves {
    --wo-group-gap: var(--space-8, 4rem);
  }
  @media (max-width: 47.9375em) {
    .wo-days,
    .wo-shelves {
      --wo-group-gap: var(--space-7, 3rem);
    }
  }

  /* ── Day groups. The client script draws other date scopes with plain
     DOM, whose nodes carry no scope attribute, so these selectors are
     :global() under the scoped container. ── */
  .wo-days__groups :global(.wo-day + .wo-day) {
    margin-top: var(--wo-group-gap);
  }
  /* One subhead style for day groups and category shelves (WO23): a Sora
     600 heading over a hairline, so the weekend's days read at the same
     rank as the two-month categories below them. */
  .wo-days__groups :global(.wo-day__h),
  .wo-shelf__h {
    margin: 0;
    padding-bottom: var(--space-3, 0.75rem);
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-600, 1.5rem);
    font-weight: var(--fw-display, 600);
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: none;
    text-wrap: balance;
  }
  .wo-days__groups :global(.wo-day__list) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wo-days__groups :global(.wo-day__empty) {
    margin: 0;
    padding: var(--space-4, 1rem) 0 0;
    color: var(--soft);
    font-style: normal;
    font-size: var(--fs-300, 0.9375rem);
  }
  /* "Show all" under the ongoing strip: the house 48px, 8px-radius
     secondary control (44px on phones), the same hairline and Harbour
     label as the row actions. */
  .wo-days__groups :global(.wo-day__more) {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: var(--space-4, 1rem);
    padding: 0 var(--space-5, 1.5rem);
    background: transparent;
    color: var(--harbour);
    border: 1px solid var(--border);
    border-radius: var(--radius-s, 8px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-ui, 1.4);
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .wo-days__groups :global(.wo-day__more:hover) {
    border-color: var(--harbour);
    color: var(--harbour-h, var(--harbour));
  }
  .wo-days__groups :global(.wo-day__more:focus-visible) {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  @media (max-width: 47.9375em) {
    .wo-days__groups :global(.wo-day__more) {
      min-height: 44px;
      padding: 0 var(--space-4, 1rem);
    }
  }

  /* ── The month ahead: one route to more, after the shelves ── */
  .wo-more {
    padding-bottom: var(--section-space, 4rem);
  }
  .pi-btn.wo-more__btn {
    min-height: 48px;
    color: var(--harbour);
    border-color: var(--border);
  }
  .pi-btn.wo-more__btn:hover {
    border-color: var(--harbour);
  }
  .wo-more__noscript {
    margin: 0;
    color: var(--soft);
    font-size: var(--fs-300, 0.9375rem);
    font-style: normal;
  }

  /* ── Shelves: H2, 24px, a sticky chip bar, 64px, then the first shelf.
     The bar's own 12px padding is counted inside both intervals so the
     chips keep clear space when they pin under the masthead. ── */
  .pi-section-head.wo-shelves__head {
    margin-bottom: calc(var(--space-5, 1.5rem) - var(--space-3, 0.75rem));
  }
  .wo-shelfnav {
    position: sticky;
    top: var(--masthead-h, 0px);
    z-index: 5;
    margin-bottom: calc(var(--wo-group-gap, 4rem) - var(--space-3, 0.75rem));
    padding-block: var(--space-3, 0.75rem);
    background: var(--bg);
  }
  .wo-shelfnav__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
  }
  /* One chip spec with the scope bar: 48px pill, hairline, Harbour on
     hover (these are jump links, so they have no selected state). */
  .wo-shelfnav__link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-4, 1rem);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill, 999px);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    line-height: 1.2;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .wo-shelfnav__link:hover {
    border-color: var(--harbour);
    color: var(--harbour);
  }
  .wo-shelfnav__link:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wo-shelf {
    scroll-margin-top: calc(var(--masthead-h, 0px) + 6rem);
  }
  .wo-shelf + .wo-shelf {
    margin-top: var(--wo-group-gap);
  }
  /* .wo-shelf__h shares the day-group subhead rule above. */
  .wo-shelf__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Phones (WO23): the five category chips wrap onto two full rows, each
     chip growing to share its row, so every label is whole and nothing
     hides behind a fade. Two rows of chips would make a tall sticky block
     on a phone, so the bar scrolls with the page there. */
  @media (max-width: 47.9375em) {
    .wo-shelfnav {
      position: static;
    }
    .wo-shelfnav__link {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
