---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideHero from '../../components/GuideHero.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import EventCard from '../../components/EventCard.astro';
import WeekendPickerBlock from '../../components/WeekendPickerBlock.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import {
  dispatchWeekend,
  melbourneDateKey,
  isUpcoming,
  routeSlug,
} from '../../lib/editorial';
import { chips, eventInWindow, upcomingWeekend } from '../../lib/events';

// ── Data ──────────────────────────────────────────────────────────────────────
const now = new Date();
const events = (await getCollection('events', ({ data }) => data.status === 'published'))
  .filter((event) => {
    const cancelled = /cancelled/i.test(event.data.verificationStatus ?? '') || /^cancelled:/i.test(event.data.summary ?? '');
    if (cancelled) return false;
    if (['weekly', 'monthly', 'ongoing'].includes(event.data.recurrence)) return true;
    const end = event.data.endDate ?? event.data.startDate;
    return isUpcoming(end, now);
  })
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());

const dispatches = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .filter((a) => a.data.format === 'weekend-picker')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const currentDispatch = dispatches[0];

const dispatchWindow = currentDispatch
  ? dispatchWeekend(currentDispatch.data.publishedAt)
  : { start: new Date(0), end: new Date(0), sat: new Date(), sun: new Date(), label: 'This weekend' };
const upcomingWeekendStart = dispatchWindow.start;
const upcomingWeekendEnd = dispatchWindow.end;

// Events with at least one occurrence inside the upcoming weekend
// window. Uses the proper recurrence-aware check (weekly events must
// actually have a Sat/Sun occurrence; monthly events must have their
// next occurrence inside the window).
const nextWeekendEvents = events.filter((event) =>
  eventInWindow(event, upcomingWeekendStart, upcomingWeekendEnd)
);

// ── Peninsula Insider Picks This Weekend ─────────────────────────────────
// The curated editorial layer. Per the editorial brief, this is now the
// canonical weekly shortlist — also the source for the newsletter and
// social amplification. Capped at 10 to keep the section selective; top
// 3 get featured-card treatment.
//
// Source of truth (Wave 3): when a `weekend-picks` content-collection
// entry exists for the current upcoming weekend, use its hand-curated
// list. Otherwise fall back to events tagged with the `weekend-pick`
// lens so the section is never empty.
const weekendPicksOverrides = await getCollection('weekend-picks', ({ data }) =>
  melbourneDateKey(data.weekendStart) === melbourneDateKey(upcomingWeekendStart)
);
const weekendPicksEntry = weekendPicksOverrides[0];

const eventsBySlug = new Map(events.map((e) => [e.data.slug, e] as const));

type WeekendPick = {
  event: typeof events[number];
  verdictOverride?: string;
  featured: boolean;
};

const weekendPicks: WeekendPick[] = weekendPicksEntry
  ? [...weekendPicksEntry.data.picks]
      .sort((a, b) => a.position - b.position)
      .map((p) => {
        const ev = eventsBySlug.get(p.eventSlug);
        return ev
          ? { event: ev, verdictOverride: p.editorVerdict, featured: p.featured }
          : null;
      })
      .filter((x): x is WeekendPick => x !== null)
      .slice(0, 10)
  : nextWeekendEvents
      .filter((event) => event.data.lens.includes('weekend-pick'))
      .slice(0, 10)
      .map((event, i) => ({ event, featured: i < 3 }));

// Running set of events already given a slot on this page. Each editorial
// section below adds to it after taking its slice; subsequent sections
// filter against it. The temporal tabs are exempt (they're a tab-
// switching scan view, not a linear read), but every editorial section
// from the dispatch downward must show each event at most once.
const seenIds = new Set<string>();
weekendPicks.forEach((p) => seenIds.add(p.event.id));

const skipEvents = events.filter((event) => event.data.skipThis);

// Hub tiles for "Browse by Mood" — each one navigates to a real
// /whats-on/by-mood/[mood]/ sub-page driven by the `chips` registry in
// lib/events.ts. Mood-led browsing lives on those sub-pages; the hub
// here is pure navigation.
const moodTiles = chips.map((chip) => ({
  slug: chip.slug,
  label: chip.hubLabel ?? chip.label,
  note: chip.eyebrow,
  count: events.filter(chip.filter).length,
}));

const totalEvents = events.length;
const recurringCount = events.filter((e) => ['weekly', 'monthly', 'ongoing'].includes(e.data.recurrence)).length;
const oneOffCount = totalEvents - recurringCount;

// ── Temporal tabs ────────────────────────────────────────────────────────
// Three tabs only, per the editorial brief: This Week / This Month /
// Recurring. Today and This Weekend were removed — Today is too narrow
// to ever feel useful, and the Weekend is now owned by the Picks
// section above. Recurring becomes a peer tab rather than its own
// scroll section so the predictable spine is one click away rather
// than another full grid below.
//
// Each tab is recurrence-aware via `eventInWindow` so a weekly Sunday
// market only appears under "This Week" if a Sunday falls inside the
// 7-day window — fixing the bug where every recurring event surfaced
// under every time window regardless of when it actually occurred.
const dayMs = 24 * 60 * 60 * 1000;
const todayStart = new Date(now);
todayStart.setHours(0, 0, 0, 0);

const weekStart = todayStart;
const weekEnd = new Date(todayStart.getTime() + 7 * dayMs - 1);

const monthStart = todayStart;
const monthEnd = new Date(todayStart.getTime() + 30 * dayMs - 1);

const sortAppealThenDate = (a: typeof events[number], b: typeof events[number]) => {
  const ap = a.data.visitorAppealScore ?? 0;
  const bp = b.data.visitorAppealScore ?? 0;
  if (ap !== bp) return bp - ap;
  return a.data.startDate.getTime() - b.data.startDate.getTime();
};

// Don't repeat the weekend picks inside the temporal tabs — the picks
// section is above and the tabs are the utility layer for everything
// else. Exempt the Recurring tab so the predictable spine stays whole.
const weekEvents = events
  .filter((e) => !seenIds.has(e.id) && eventInWindow(e, weekStart, weekEnd))
  .sort(sortAppealThenDate)
  .slice(0, 9);
const monthEvents = events
  .filter((e) => !seenIds.has(e.id) && eventInWindow(e, monthStart, monthEnd))
  .sort(sortAppealThenDate)
  .slice(0, 9);
const recurringTabEvents = events
  .filter((e) => ['weekly', 'monthly', 'ongoing'].includes(e.data.recurrence))
  .sort((a, b) => (b.data.visitorAppealScore ?? 0) - (a.data.visitorAppealScore ?? 0))
  .slice(0, 12);

const temporalTabs = [
  { key: 'week',      label: 'This Week',   items: weekEvents,         blurb: 'The next seven days on the Peninsula.' },
  { key: 'month',     label: 'This Month',  items: monthEvents,        blurb: 'The next thirty days, sorted by appeal then date.' },
  { key: 'recurring', label: 'Recurring',   items: recurringTabEvents, blurb: "The predictable spine — markets, sessions, programmes that run on a known cadence." },
];

const initialTabKey = weekEvents.length > 0
  ? 'week'
  : monthEvents.length > 0
    ? 'month'
    : 'recurring';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: "What's On" },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'How are Peninsula Insider Picks chosen?',
      acceptedAnswer: { '@type': 'Answer', text: 'A named editor curates a shortlist for each upcoming weekend — the strongest, most worthwhile events the editor would actually book. It is deliberately selective, capped at ten, and refreshed weekly. The Picks are the canonical shortlist; the time-based tabs below cover the broader calendar.' } },
    { '@type': 'Question', name: 'Are the kids-grade A/B/C ratings genuine?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. We attend or have attended every family programme we grade. A means we\'d return without hesitation. B means it works but has a flaw. C means we wouldn\'t go back. Grades are visible on every event with the family-saturday or school-holidays lens.' } },
    { '@type': 'Question', name: 'Why do some events carry a planning note?',
      acceptedAnswer: { '@type': 'Answer', text: 'Because the useful part of an events guide is context. When an event is likely to be crowded, logistically awkward, or a better fit for a different kind of visitor, we say so briefly and plainly so readers can plan with their eyes open.' } },
    { '@type': 'Question', name: 'Do you cover events outside the Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. Mornington Peninsula only, defined as Mount Martha down to Portsea, plus Hastings and the Western Port fringe. We don\'t cover Phillip Island, the Bellarine, or Frankston. The constraint is what makes the recommendations sharp.' } },
  ],
};
---

<BaseLayout
  title="What's On Mornington Peninsula · Peninsula Insider"
  description="The Peninsula's events page with an editorial point of view. Weekend picks, kids-graded school holidays, worth-the-drive badges, and useful planning notes."
  section="whats-on"
  canonical="https://peninsulainsider.com.au/whats-on"
  modifiedTime="2026-04-30"
  ogImage="/images/sourced/category-market-02.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <!-- ═══════════════════════════════════════════════════════════════
       1. CINEMATIC HERO
       ═══════════════════════════════════════════════════════════════ -->
  <GuideHero
    eyebrow={`What's On · ${totalEvents} curated events · Reviewed weekly`}
    title="Peninsula events, with an <em>opinion</em> for a change"
    dek="Every other Peninsula calendar lists everything. This one picks the events the editor would actually book, with planning notes when the logistics matter."
    meta={[
      { label: `${totalEvents} curated events` },
      { label: `${recurringCount} recurring programmes` },
      { label: 'Reviewed weekly' },
    ]}
    heroImage="/images/sourced/category-market-02.webp"
    imageAlt="Saturday morning at a Peninsula farmers market, the recurring event spine of the calendar"
    imageCredit="Peninsula Insider"
    entitySlug="whats-on"
  />

  <!-- ═══════════════════════════════════════════════════════════════
       2. PENINSULA INSIDER PICKS THIS WEEKEND
       The curated editorial layer. The canonical weekly shortlist —
       also the source for newsletter and social amplification. Top 3
       get featured-card treatment; verdicts only render here.
       ═══════════════════════════════════════════════════════════════ -->
  {weekendPicks.length > 0 && (
    <section class="venues venues--plain" id="picks">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Peninsula Insider Picks</p>
            <h2 class="venues__title">Peninsula Insider Picks This Weekend</h2>
            <p class="venues__sub venues__sub--standfirst">The strongest, most worthwhile, and most editorially endorsed events for {dispatchWindow.label}. Selected, not listed.</p>
          </div>
          <span class="venues__count">{weekendPicks.length} picks</span>
        </div>
        <div class="event-grid">
          {weekendPicks.map(({ event, verdictOverride, featured }) => {
            const eventWithOverride = verdictOverride
              ? { ...event, data: { ...event.data, editorVerdict: verdictOverride } }
              : event;
            return (
              <EventCard
                event={eventWithOverride}
                featured={featured}
                showVerdict={true}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       3. WEEKEND LETTER (editor's letter for the upcoming weekend)
       ═══════════════════════════════════════════════════════════════ -->
  {currentDispatch && (
    <WeekendPickerBlock dispatch={currentDispatch} weekend={`This weekend · ${dispatchWindow.label}`} />
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       4. TEMPORAL TABS — This Week / This Month / Recurring
       The utility layer. No verdicts, just listings. Editor's voice
       lives in the Picks section above; this surface is for scanning.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="whatson-temporal" aria-label="Events by time window">
    <div class="container">
      <div class="whatson-temporal__header">
        <p class="label label--accent">By time</p>
        <h2 class="whatson-temporal__title">When are you on the Peninsula?</h2>
      </div>

      <div class="whatson-temporal__tabs" role="tablist" aria-label="Filter events by time window">
        {temporalTabs.map((tab) => (
          <button
            type="button"
            class="whatson-temporal__tab"
            role="tab"
            id={`whatson-temporal-tab-${tab.key}`}
            aria-controls={`whatson-temporal-panel-${tab.key}`}
            aria-selected={tab.key === initialTabKey ? 'true' : 'false'}
            tabindex={tab.key === initialTabKey ? 0 : -1}
            data-temporal-tab={tab.key}
          >
            <span class="whatson-temporal__tab-label">{tab.label}</span>
            <span class="whatson-temporal__tab-count">{tab.items.length}</span>
          </button>
        ))}
      </div>

      {temporalTabs.map((tab) => (
        <div
          class="whatson-temporal__panel"
          role="tabpanel"
          id={`whatson-temporal-panel-${tab.key}`}
          aria-labelledby={`whatson-temporal-tab-${tab.key}`}
          data-temporal-panel={tab.key}
          hidden={tab.key !== initialTabKey}
        >
          <p class="whatson-temporal__blurb">{tab.blurb}</p>
          {tab.items.length > 0 ? (
            <div class="event-grid">
              {tab.items.map((event) => <EventCard event={event} />)}
            </div>
          ) : (
            <p class="whatson-temporal__empty">
              Nothing programmed in this window. Try a wider one or browse by mood below.
            </p>
          )}
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    /* What's On temporal-tab controller. Tabs swap which panel is visible.
       Idempotent across astro:page-load. */
    (function () {
      function bindTemporal() {
        var tabs = document.querySelectorAll('[data-temporal-tab]');
        var panels = document.querySelectorAll('[data-temporal-panel]');
        if (!tabs.length || !panels.length) return;
        var first = tabs[0];
        if (first._piTemporalBound) return;

        function activate(key) {
          tabs.forEach(function (t) {
            var on = t.getAttribute('data-temporal-tab') === key;
            t.setAttribute('aria-selected', on ? 'true' : 'false');
            t.setAttribute('tabindex', on ? '0' : '-1');
          });
          panels.forEach(function (p) {
            var on = p.getAttribute('data-temporal-panel') === key;
            if (on) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
        }

        tabs.forEach(function (tab, idx) {
          tab._piTemporalBound = true;
          tab.addEventListener('click', function () {
            activate(tab.getAttribute('data-temporal-tab'));
          });
          tab.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
              e.preventDefault();
              var dir = e.key === 'ArrowRight' ? 1 : -1;
              var next = (idx + dir + tabs.length) % tabs.length;
              tabs[next].focus();
              activate(tabs[next].getAttribute('data-temporal-tab'));
            }
          });
        });
      }
      bindTemporal();
      document.addEventListener('astro:page-load', bindTemporal);
    })();
  </script>

  <!-- ═══════════════════════════════════════════════════════════════
       5. BROWSE BY MOOD, hub navigation only
       Five reader-intent lenses cut across the calendar. Each tile links
       to its dedicated /whats-on/by-mood/[mood]/ sub-page rather than
       expanding inline, keeping the main What's On page a single linear
       read with no event repetition.
       ═══════════════════════════════════════════════════════════════ -->
  <section class="hub-formats" aria-label="Browse events by mood">
    <div class="container">
      <div class="hub-formats__intro">
        <p class="label label--accent">Or browse by mood</p>
        <h2 class="hub-formats__title">Pick the feeling first, let the events follow</h2>
        <p class="hub-formats__dek">Five reader-intent lenses cut across the calendar. Each opens its own page of events matching the mood.</p>
      </div>
      <ul class="hub-formats__grid">
        {moodTiles.map((tile) => (
          <li class={`hub-formats__cell${tile.count === 0 ? ' is-empty' : ''}`}>
            <a href={`/whats-on/by-mood/${tile.slug}/`} class="hub-formats__link">
              <span class="hub-formats__label">{tile.label} · {tile.count}</span>
              <span class="hub-formats__sub">{tile.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SectionDivider />

  <!-- ═══════════════════════════════════════════════════════════════
       7. WORTH KNOWING
       ═══════════════════════════════════════════════════════════════ -->
  {skipEvents.length > 0 && (
    <section class="skip-block" id="lens-skip">
      <div class="container">
        <div class="skip-block__inner">
          <div>
            <p class="label label--accent">Worth knowing</p>
            <h2 class="skip-block__title">Extra context for events that need it</h2>
            <p class="skip-block__body">Short notes on fit, timing, and trade-offs so readers can plan with their eyes open.</p>
          </div>
          <div class="skip-block__list">
            {skipEvents.map((event) => (
              <article class="skip-entry">
                <h3 class="skip-entry__title">
                  <a href={`/whats-on/${routeSlug(event)}`}>{event.data.title}</a>
                </h3>
                <p class="skip-entry__reason">{event.data.skipReason ?? event.data.editorVerdict ?? event.data.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       8. EDITORIAL STATS
       ═══════════════════════════════════════════════════════════════ -->
  <section class="events-stats">
    <div class="container">
      <dl class="events-stats__list">
        <div><dt>Curated events</dt><dd>{totalEvents}</dd></div>
        <div><dt>Recurring programmes</dt><dd>{recurringCount}</dd></div>
        <div><dt>One-off events</dt><dd>{oneOffCount}</dd></div>
      </dl>
      <p class="events-stats__note">
        Reviewed weekly by a named editor. We publish what we'd actually attend, with context where the timing, fit, or logistics matter. If you think we've missed something, <a href="/contact/">tell us</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       10. FAQ
       ═══════════════════════════════════════════════════════════════ -->
  <section class="hub-faq" aria-label="Frequently asked questions">
    <div class="container">
      <div class="hub-faq__intro">
        <p class="label label--accent">Frequently asked</p>
        <h2 class="hub-faq__title">Four answers about how this calendar works</h2>
      </div>
      <div class="hub-faq__list">
        <details class="hub-faq__item">
          <summary class="hub-faq__q">How are Peninsula Insider Picks chosen?</summary>
          <div class="hub-faq__a"><p>A named editor curates a shortlist for each upcoming weekend  -  the strongest, most worthwhile events the editor would actually book. It is deliberately selective, capped at ten, and refreshed weekly. The Picks are the canonical shortlist; the time-based tabs below cover the broader calendar.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Are the kids-grade A/B/C ratings genuine?</summary>
          <div class="hub-faq__a"><p>Yes. We attend or have attended every family programme we grade. A means we'd return without hesitation. B means it works but has a flaw. C means we wouldn't go back. Grades are visible on every event with the family-saturday or school-holidays lens.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Why do some events carry a planning note?</summary>
          <div class="hub-faq__a"><p>Because the useful part of an events guide is context. When an event is likely to be crowded, logistically awkward, or a better fit for a different kind of visitor, we say so briefly and plainly so readers can plan around it.</p></div>
        </details>
        <details class="hub-faq__item">
          <summary class="hub-faq__q">Do you cover events outside the Peninsula?</summary>
          <div class="hub-faq__a"><p>No. Mornington Peninsula only, defined as Mount Martha down to Portsea, plus Hastings and the Western Port fringe. We don't cover Phillip Island, the Bellarine, or Frankston. The constraint is what makes the recommendations sharp.</p></div>
        </details>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
