---
/**
 * /search - Peninsula Insider site search
 *
 * Pagefind-powered search results page. Supports:
 *   - ?q=<query> deep-link (auto-focus + auto-run on load)
 *   - "kind" facet chips (All / Eat / Stay / Wine / Explore / Escape /
 *     What's On / Journal / Places) wired to Pagefind filters
 *   - Card results with hero image, kind eyebrow, title, excerpt
 *   - Pagination (12 cards per page)
 *   - Empty / no-result states with a plain "no matches" fallback card
 *   - noindex (the search results page itself shouldn't be Google-indexed)
 *
 * Pagefind's index is built by `npm run build:search` and lives at
 * `/pagefind/`. The page is fully static; all search runs in the browser.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Search' },
];

// All possible filter chips. "All" is the default; the rest mirror the
// labels emitted by BaseLayout via data-pagefind-filter="kind:<Label>".
const KIND_CHIPS = [
  { value: 'all',        label: 'All' },
  { value: 'Eat',        label: 'Eat & Drink' },
  { value: 'Stay',       label: 'Stay' },
  { value: 'Wine',       label: 'Wine' },
  { value: 'Explore',    label: 'Explore' },
  { value: 'Plans',      label: 'Plans' },
  { value: "What's On",  label: "What's On" },
  { value: 'Journal',    label: 'Journal' },
  { value: 'Places',     label: 'Places' },
];
export const prerender = true;
---

<BaseLayout
  title="Explore · Peninsula Insider"
  description="Explore Peninsula Insider - discover places, stays, long lunches, beaches, itineraries, events, and local seasonal intelligence across the Mornington Peninsula."
  section="home"
  noindex={true}
  searchExclude={true}
>
  <Breadcrumbs items={breadcrumbItems} />

  <main class="search-page-v2">

    <section class="search-page-v2__hero">
      <div class="container">
        <p class="search-page-v2__eyebrow">Peninsula Insider · Explore</p>
        <h1 class="search-page-v2__title">Explore the Peninsula</h1>

        <form class="search-page-v2__bar" id="searchPageForm" autocomplete="off" role="search" aria-label="Search Peninsula Insider">
          <span class="search-page-v2__bar-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="6" />
              <path d="M14 14l4 4" />
            </svg>
          </span>
          <input
            type="search"
            id="searchPageInput"
            class="search-page-v2__input"
            placeholder="Try a place, a mood, a season…"
            aria-label="Search query"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="submit" class="search-page-v2__submit" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="9" r="6" />
              <path d="M14 14l4 4" />
            </svg>
          </button>
        </form>
      </div>
    </section>

    <section class="search-page-v2__filters" aria-label="Result filters">
      <div class="container">
        <div class="search-page-v2__chips" role="tablist">
          {KIND_CHIPS.map((chip, i) => (
            <button
              type="button"
              class="search-page-v2__chip"
              data-kind={chip.value}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="search-page-v2__results-section">
      <div class="container">
        <div class="search-page-v2__results-header">
          <p class="search-page-v2__results-meta" id="searchResultsMeta" aria-live="polite">Start typing to search.</p>
        </div>

        <div class="search-page-v2__results" id="searchResultsList" aria-live="polite"></div>

        <nav class="search-page-v2__pagination" id="searchPagination" aria-label="Result pages" hidden></nav>
      </div>
    </section>

    <section class="search-page-v2__fallback" id="searchFallback" hidden>
      <div class="container">
        <div class="search-page-v2__fallback-card">
          <p class="search-page-v2__fallback-eyebrow">Didn't find it?</p>
          <h2 class="search-page-v2__fallback-title">No matches yet.</h2>
          <p class="search-page-v2__fallback-body">Search is keyword-strict. Try a different word, or browse by category above.</p>
        </div>
      </div>
    </section>

  </main>

  <script is:inline>
    (function () {
      const form = document.getElementById('searchPageForm');
      const input = document.getElementById('searchPageInput');
      const list = document.getElementById('searchResultsList');
      const meta = document.getElementById('searchResultsMeta');
      const pagination = document.getElementById('searchPagination');
      const fallback = document.getElementById('searchFallback');
      const chips = Array.from(document.querySelectorAll('.search-page-v2__chip'));

      const PER_PAGE = 12;
      let pagefindModule = null;
      let currentResults = [];   // raw Pagefind result handles (lazy .data())
      let currentDataPage = new Map(); // pageNum -> array of resolved data
      let currentQuery = '';
      let currentKind = 'all';
      let currentPage = 1;
      let searchToken = 0;

      const BEST_BET_INTENTS = [
        {
          aliases: ['rainy day', 'rainy days'],
          title: 'Rainy Day Peninsula',
          href: '/explore/rainy-day/',
          kind: 'Explore',
          entityType: 'page',
          entitySlug: 'explore-rainy-day',
          image: '/images/sourced/article-rainy-day-01.webp',
          excerpt: 'Weather-proof Peninsula plans: hot springs, galleries, pub lunches, cellar doors, and indoor options that still feel like a proper day out.',
        },
        {
          aliases: ['long lunch', 'long lunches'],
          title: 'Long Lunch Peninsula',
          href: '/eat/long-lunch/',
          kind: 'Eat',
          entityType: 'page',
          entitySlug: 'eat-long-lunch',
          image: '/images/sourced/article-long-lunch-01.webp',
          excerpt: 'The Peninsula long-lunch shortlist: estate restaurants, cellar-door dining, and the places built for a slow afternoon.',
        },
        {
          aliases: ['winter wineries', 'winter winery', 'winter wine', 'winter wine weekend'],
          title: 'Mornington Peninsula in Winter',
          href: '/journal/mornington-peninsula-in-winter/',
          kind: 'Journal',
          entityType: 'article',
          entitySlug: 'mornington-peninsula-in-winter',
          image: '/images/sourced/article-cellar-door-01.webp',
          excerpt: 'The winter version of the Peninsula: cellar doors, fires, hot springs, winter wine events, and weekends that work better cold.',
        },
        {
          aliases: ['coming from melbourne', 'from melbourne', 'day trip from melbourne', 'melbourne day trip'],
          title: 'Mornington Peninsula Day Trip from Melbourne',
          href: '/journal/mornington-peninsula-day-trip/',
          kind: 'Journal',
          entityType: 'article',
          entitySlug: 'mornington-peninsula-day-trip',
          image: '/images/sourced/place-red-hill-01.webp',
          excerpt: 'The cleanest one-day Peninsula plan from Melbourne: drive times, route logic, lunch structure, and the stops worth the trip.',
        },
        {
          aliases: ['weekend escape', 'weekend escapes', 'two night escape', 'two-night escape'],
          title: 'Where to Stay for a Two-Night Peninsula Escape',
          href: '/journal/where-to-stay-for-a-two-night-escape/',
          kind: 'Journal',
          entityType: 'article',
          entitySlug: 'where-to-stay-for-a-two-night-escape',
          image: '/images/sourced/article-vineyard-villa-01.webp',
          excerpt: 'A practical two-night escape guide: where to base yourself, what to book, and how to make the weekend feel properly away.',
        },
        {
          aliases: ['dog friendly', 'dog-friendly', 'dogs', 'with dog'],
          title: 'Dog-Friendly Mornington Peninsula',
          href: '/dog-friendly/',
          kind: 'Guide',
          entityType: 'page',
          entitySlug: 'dog-friendly',
          image: '/images/sourced/dog-beach-emma-01.webp',
          excerpt: 'The dog-friendly hub: beaches, stays, cafes, pubs, wineries, walks, and wet-weather options that actually work with the dog.',
        },
      ];

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      // Fire-and-forget: log the search query to Supabase for analytics.
      // Uses keepalive so the beacon survives page navigations.
      function logSearch(query, resultCount, kindFilter) {
        try {
          const sb = window.__PI_SB;
          if (!sb || !sb.url || !sb.key) return;
          const payload = {
            query: query,
            result_count: resultCount,
            kind_filter: kindFilter === 'all' ? null : (kindFilter || null),
            surface: 'search_page',
            page_path: window.location.pathname,
          };
          fetch(sb.url + '/rest/v1/site_search_queries', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'apikey': sb.key,
              'Authorization': 'Bearer ' + sb.key,
              'Prefer': 'return=minimal',
            },
            body: JSON.stringify(payload),
            keepalive: true,
          }).catch(function () {});
        } catch (_e) {}
      }

      async function loadPagefind() {
        if (pagefindModule) return pagefindModule;
        pagefindModule = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        try { await pagefindModule.options({ basePath: '/pagefind/' }); } catch (_e) {}
        return pagefindModule;
      }

      function setMeta(text) {
        if (meta) meta.textContent = text;
      }

      function renderEmpty(query) {
        if (list) list.innerHTML = '';
        if (pagination) pagination.hidden = true;
        if (fallback) {
          fallback.hidden = false;
        }
        setMeta(query
          ? `No matches for "${query}". Try a broader phrase or a place name.`
          : 'No matches yet.');
      }

      function renderIdle() {
        if (list) {
          list.innerHTML = `
            <div class="search-page-v2__idle">
              <p>Try a place, a mood, or a season - "Rainy day", "Long lunch", "Winter wineries", "Coming from Melbourne", "Weekend escape", "Dog friendly".</p>
            </div>
          `;
        }
        if (pagination) pagination.hidden = true;
        if (fallback) fallback.hidden = true;
        setMeta('Start typing to search.');
      }

      function renderLoading() {
        if (list) {
          list.innerHTML = `
            <div class="search-page-v2__loading">
              <p>Searching…</p>
            </div>
          `;
        }
        if (fallback) fallback.hidden = true;
      }

      function normalizeText(value) {
        return String(value || '')
          .toLowerCase()
          .replace(/&/g, 'and')
          .replace(/[^a-z0-9]+/g, ' ')
          .trim();
      }

      function bestBetForQuery(query) {
        const q = normalizeText(query);
        if (!q || currentKind !== 'all') return null;
        return BEST_BET_INTENTS.find((intent) =>
          intent.aliases.some((alias) => {
            const a = normalizeText(alias);
            return q === a || q.includes(a);
          })
        ) || null;
      }

      function resultGroup(item) {
        const type = item.entity_type || '';
        const kind = item.meta?.kind || item.filters?.kind?.[0] || 'Guide';
        if (type === 'place' || kind === 'Places') return { key: 'places', label: 'Places' };
        if (type === 'region') return { key: 'regions', label: 'Regions' };
        if (type === 'event') return { key: 'events', label: "What's On" };
        if (type === 'experience') return { key: 'explore', label: 'Explore' };
        if (type === 'itinerary' || type === 'tour' || type === 'tour-package') return { key: 'plans', label: 'Plans & Tours' };
        if (type === 'article' || type === 'quick-note' || type === 'local-secret') return { key: 'journal', label: 'Journal & Guides' };
        if (type === 'venue') {
          const href = item.url || '';
          if (href.startsWith('/stay/')) return { key: 'stay', label: 'Stay' };
          if (href.startsWith('/wine/')) return { key: 'wine', label: 'Wine' };
          return { key: 'eat', label: 'Eat & Drink' };
        }
        return { key: 'other', label: kind };
      }

      function pathFromUrl(value) {
        try {
          return new URL(value || '/', window.location.origin).pathname;
        } catch (_e) {
          return String(value || '/').split('?')[0].split('#')[0];
        }
      }

      function slugFromPath(value) {
        const path = pathFromUrl(value);
        return path.replace(/^\/|\/$/g, '').replaceAll('/', '-') || 'search-result';
      }

      function entityTypeFromPath(value, fallback) {
        const path = pathFromUrl(value);
        if (fallback) return fallback;
        if (path.startsWith('/journal/')) return 'article';
        if (path.startsWith('/whats-on/')) return 'event';
        if (path.startsWith('/explore/places/')) return 'place';
        if (path.startsWith('/explore/regions/')) return 'region';
        if (path.startsWith('/explore/')) return 'page';
        if (path.startsWith('/eat/') || path.startsWith('/stay/') || path.startsWith('/wine/')) return 'venue';
        return 'page';
      }

      function imageSlotAttrs(item, title) {
        const url = item.url || '#';
        const entityType = entityTypeFromPath(url, item.entity_type || '');
        const entitySlug = item.entity_slug || slugFromPath(url);
        const label = `${title || entitySlug} search image`;
        return [
          'data-pi-edit="image"',
          `data-pi-entity-type="${escapeHtml(entityType)}"`,
          `data-pi-entity-slug="${escapeHtml(entitySlug)}"`,
          'data-pi-field-path="heroImage"',
          'data-pi-purpose="card"',
          `data-pi-label="${escapeHtml(label)}"`,
          'role="img"',
          `aria-label="${escapeHtml(label)}"`,
        ].join(' ');
      }

      let imageSlotCachePromise = null;
      function fetchImageSlotCache() {
        if (imageSlotCachePromise) return imageSlotCachePromise;
        imageSlotCachePromise = (async function () {
          const sb = window.__PI_SB;
          if (!sb || !sb.url || !sb.key) return new Map();
          const url = new URL('/rest/v1/cms_image_slots', sb.url);
          url.searchParams.set('select', 'entity_type,entity_slug,field_path,public_url');
          url.searchParams.set('status', 'eq.published');
          const res = await fetch(url.toString(), {
            headers: {
              apikey: sb.key,
              Authorization: 'Bearer ' + sb.key,
              'Accept-Profile': 'pi',
            },
          });
          if (!res.ok) return new Map();
          const rows = await res.json();
          const map = new Map();
          (Array.isArray(rows) ? rows : []).forEach((row) => {
            if (!row.public_url) return;
            map.set(`${row.entity_type}/${row.entity_slug}/${row.field_path}`, row.public_url);
          });
          return map;
        })().catch(function () { return new Map(); });
        return imageSlotCachePromise;
      }

      async function hydrateSearchResultImages() {
        const slots = await fetchImageSlotCache();
        if (!(slots instanceof Map) || slots.size === 0 || !list) return;
        list.querySelectorAll('[data-pi-edit="image"][data-pi-entity-type][data-pi-entity-slug][data-pi-field-path]').forEach((el) => {
          const key = `${el.dataset.piEntityType}/${el.dataset.piEntitySlug}/${el.dataset.piFieldPath}`;
          const src = slots.get(key);
          if (!src) return;
          el.style.backgroundImage = `url("${src.replace(/"/g, '\\"')}")`;
          el.classList.remove('search-card__hero--placeholder');
        });
      }

      function renderCard(item, extraClass) {
        const kind = item.meta?.kind || item.filters?.kind?.[0] || 'Guide';
        const title = item.meta?.title || 'Untitled';
        const url = item.url || '#';
        const excerpt = item.excerpt || '';
        const image = item.meta?.image || '';
        const heroStyle = image ? `background-image: url('${image.replace(/'/g, "%27")}')` : '';
        const heroClass = image
          ? 'search-card__hero'
          : 'search-card__hero search-card__hero--placeholder';
        const className = extraClass ? `search-card ${extraClass}` : 'search-card';
        return `
          <a href="${escapeHtml(url)}" class="${className}">
            <span class="${heroClass}" style="${heroStyle}" ${imageSlotAttrs(item, title)}></span>
            <span class="search-card__body">
              <span class="search-card__kind">${escapeHtml(kind)}</span>
              <span class="search-card__title">${escapeHtml(title)}</span>
              <span class="search-card__excerpt">${excerpt}</span>
            </span>
          </a>
        `;
      }

      function pickLeadResult(data) {
        const bestBet = data.find((item) => item._bestBet);
        if (bestBet) return bestBet;
        const q = normalizeText(currentQuery);
        const exactPlace = data.find((item) =>
          item.entity_type === 'place' && normalizeText(item.meta?.title) === q
        );
        if (exactPlace) return exactPlace;
        const exactTitle = data.find((item) => normalizeText(item.meta?.title) === q);
        if (exactTitle) return exactTitle;
        const priority = ['place', 'region', 'article', 'itinerary', 'experience', 'event', 'venue'];
        return data.slice().sort((a, b) => {
          const ai = priority.indexOf(a.entity_type || '');
          const bi = priority.indexOf(b.entity_type || '');
          return (ai < 0 ? 99 : ai) - (bi < 0 ? 99 : bi);
        })[0] || data[0];
      }

      function renderGroupedResults(data, total) {
        if (!list) return;
        if (data.length === 0) {
          renderEmpty(currentQuery);
          return;
        }

        const lead = pickLeadResult(data);
        const leadUrl = lead?.url || '';
        const groups = new Map();
        data.forEach((item) => {
          if (item === lead || item.url === leadUrl) return;
          const group = resultGroup(item);
          if (!groups.has(group.key)) groups.set(group.key, { label: group.label, items: [] });
          groups.get(group.key).items.push(item);
        });

        const order = ['places', 'regions', 'eat', 'wine', 'stay', 'explore', 'events', 'plans', 'journal', 'other'];
        const sections = order
          .map((key) => groups.get(key))
          .filter((group) => group && group.items.length > 0)
          .map((group) => {
            const collapsedCount = Math.max(0, group.items.length - 4);
            const cards = group.items.map((item, index) =>
              renderCard(item, index >= 4 ? 'search-card--extra' : '')
            ).join('');
            const toggle = collapsedCount > 0
              ? `<button type="button" class="search-result-group__toggle" data-search-group-toggle aria-expanded="false">Show ${collapsedCount} more</button>`
              : '';
            return `
              <section class="search-result-group">
                <div class="search-result-group__header">
                  <h2 class="search-result-group__title">${escapeHtml(group.label)}</h2>
                  <div class="search-result-group__actions">
                    <span class="search-result-group__count">${group.items.length}</span>
                    ${toggle}
                  </div>
                </div>
                <div class="search-result-group__grid">${cards}</div>
              </section>
            `;
          }).join('');

        list.innerHTML = `
          <div class="search-results-curated">
            <section class="search-result-lead" aria-label="Top result">
              <div class="search-result-lead__header">
                <p class="search-result-lead__eyebrow">Top result</p>
              </div>
              ${renderCard(lead, 'search-card--lead')}
            </section>
            ${sections}
          </div>
        `;
        hydrateSearchResultImages();
        if (fallback) fallback.hidden = false;
        setMeta(`Showing grouped results from ${total} match${total === 1 ? '' : 'es'}.`);
      }

      function renderResults(data, total, page) {
        if (!list) return;
        if (data.length === 0) {
          renderEmpty(currentQuery);
          return;
        }
        const cards = data.map((item) => renderCard(item)).join('');
        list.innerHTML = `<div class="search-page-v2__grid">${cards}</div>`;
        hydrateSearchResultImages();
        if (fallback) fallback.hidden = false;
        setMeta(`Showing ${(page - 1) * PER_PAGE + 1}–${Math.min(page * PER_PAGE, total)} of ${total} result${total === 1 ? '' : 's'}.`);
      }

      function renderPagination(total) {
        if (!pagination) return;
        const totalPages = Math.ceil(total / PER_PAGE);
        if (totalPages <= 1) {
          pagination.hidden = true;
          pagination.innerHTML = '';
          return;
        }
        // Compact pager: prev · 1 2 3 … N · next
        const buttons = [];
        const win = (p) =>
          p === 1 || p === totalPages || Math.abs(p - currentPage) <= 1;
        let lastShown = 0;
        for (let p = 1; p <= totalPages; p++) {
          if (!win(p)) continue;
          if (p - lastShown > 1) {
            buttons.push('<span class="search-page-v2__pager-gap">…</span>');
          }
          buttons.push(`
            <button
              type="button"
              class="search-page-v2__pager-btn ${p === currentPage ? 'is-active' : ''}"
              data-page="${p}"
              aria-current="${p === currentPage ? 'page' : 'false'}"
              aria-label="Go to page ${p}"
            >${p}</button>
          `);
          lastShown = p;
        }
        const prevDisabled = currentPage <= 1;
        const nextDisabled = currentPage >= totalPages;
        pagination.innerHTML = `
          <button type="button" class="search-page-v2__pager-step" data-page-delta="-1" ${prevDisabled ? 'disabled' : ''} aria-label="Previous page">‹ Prev</button>
          ${buttons.join('')}
          <button type="button" class="search-page-v2__pager-step" data-page-delta="1" ${nextDisabled ? 'disabled' : ''} aria-label="Next page">Next ›</button>
        `;
        pagination.hidden = false;
      }

      async function showPage(page) {
        if (page < 1) page = 1;
        currentPage = page;
        const shouldGroup = page === 1 && currentKind === 'all' && currentResults.some((r) => r._rpc);
        if (shouldGroup) {
          const cached = currentDataPage.get('grouped');
          const data = cached || await Promise.all(currentResults.map((r) => r.data()));
          if (!cached) currentDataPage.set('grouped', data);
          renderGroupedResults(data, currentResults.length);
          if (pagination) pagination.hidden = true;
          return;
        }
        const start = (page - 1) * PER_PAGE;
        const end = start + PER_PAGE;
        const slice = currentResults.slice(start, end);
        const cached = currentDataPage.get(page);
        const data = cached || await Promise.all(slice.map((r) => r.data()));
        if (!cached) currentDataPage.set(page, data);
        renderResults(data, currentResults.length, page);
        renderPagination(currentResults.length);
        // Scroll to top of results when paging
        if (page !== 1 && list) list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // ── Phase D wave 1: kind chip → RPC predicates ────────────────────
      // Chip values are legacy Pagefind labels (Eat, Stay, Wine, etc).
      // Translate each into a combination of (entityTypes, facets) the
      // pi.search RPC understands. "all" returns null/{} so the RPC
      // doesn't narrow on type.
      function kindToRpcPredicates(kind) {
        switch (kind) {
          case 'Eat':       return { entityTypes: ['venue'], facets: { theme: ['food','food+wine','coffee'] } };
          case 'Stay':      return { entityTypes: ['venue'], facets: {} }; // venue.type narrows further in result rendering
          case 'Wine':      return { entityTypes: ['venue'], facets: { theme: ['wine'] } };
          case 'Explore':   return { entityTypes: ['experience'], facets: {} };
          case 'Plans':     return { entityTypes: ['itinerary','tour','tour-package'], facets: {} };
          case "What's On": return { entityTypes: ['event'], facets: {} };
          case 'Journal':   return { entityTypes: ['article','quick-note','local-secret'], facets: {} };
          case 'Places':    return { entityTypes: ['place'], facets: {} };
          default:          return { entityTypes: null, facets: {} };
        }
      }

      function rpcKindLabel(entityType) {
        const m = {
          venue: 'Venue', experience: 'Explore', event: "What's On",
          place: 'Places', region: 'Explore', itinerary: 'Plans', tour: 'Plans',
          'tour-package': 'Plans', article: 'Journal',
          'quick-note': 'Journal', 'local-secret': 'Journal',
        };
        return m[entityType] || 'Guide';
      }

      async function waitForSearchRpc() {
        const started = Date.now();
        while (Date.now() - started < 1000) {
          const rpc = window.PISearchRpc;
          if (rpc && rpc.available) return rpc;
          await new Promise((resolve) => setTimeout(resolve, 50));
        }
        return window.PISearchRpc || null;
      }

      // Shape a SearchHit into the Pagefind-result shape `renderResults`
      // expects. We wrap in a shim with a `.data()` method so the
      // pagination path (which lazily resolves each handle) works
      // unchanged for both retrieval sources.
      function rpcHitToHandle(hit, query) {
        const q = (query || '').toLowerCase();
        const dek = hit.dek || '';
        let excerpt = escapeHtml(dek.slice(0, 260));
        if (q && excerpt.toLowerCase().includes(q)) {
          const i = excerpt.toLowerCase().indexOf(q);
          excerpt = excerpt.slice(0, i) + '<mark>' + excerpt.slice(i, i + q.length) + '</mark>' + excerpt.slice(i + q.length);
        }
        const data = {
          url:     hit.href,
          entity_type: hit.entity_type,
          entity_slug: hit.entity_slug,
          meta:    {
            title: hit.title,
            kind:  rpcKindLabel(hit.entity_type),
            image: hit.hero_image?.src || '',
          },
          excerpt,
        };
        return { data: async () => data, _rpc: true, _url: hit.href };
      }

      function bestBetToHandle(intent) {
        const data = {
          url: intent.href,
          entity_type: intent.entityType,
          entity_slug: intent.entitySlug || intent.href.replace(/^\/|\/$/g, '').replaceAll('/', '-'),
          meta: {
            title: intent.title,
            kind: intent.kind,
            image: intent.image || '',
          },
          excerpt: escapeHtml(intent.excerpt),
          _bestBet: true,
        };
        return { data: async () => data, _rpc: true, _bestBet: true, _url: intent.href };
      }

      function withBestBet(handles, query) {
        const intent = bestBetForQuery(query);
        if (!intent) return handles;
        const seenHref = intent.href.replace(/\/$/, '');
        const filtered = handles.filter((handle) => {
          const url = handle._url || '';
          return url.replace(/\/$/, '') !== seenHref;
        });
        return [bestBetToHandle(intent), ...filtered];
      }

      async function runSearch() {
        const q = (input?.value || '').trim();
        currentQuery = q;
        currentDataPage = new Map();

        if (!q && currentKind === 'all') {
          currentResults = [];
          renderIdle();
          updateUrl(q);
          return;
        }

        renderLoading();
        const myToken = ++searchToken;

        // ── Path 1: pi.search RPC (Phase D wave 1) ──────────────────────
        const rpc = await waitForSearchRpc();
        if (rpc && rpc.available) {
          try {
            const preds = kindToRpcPredicates(currentKind);
            const hits = await rpc.search({
              q: q || undefined,
              filters: preds.facets,
              entityTypes: preds.entityTypes,
              limit: 96,
            });
            if (myToken !== searchToken) return;
            if (Array.isArray(hits) && hits.length > 0) {
              currentResults = withBestBet(hits.map((h) => rpcHitToHandle(h, q)), q);
              await showPage(1);
              logSearch(q, currentResults.length, currentKind);
              updateUrl(q);
              return;
            }
            // Empty hits → fall through to Pagefind so we don't 0-result
            // when the RPC simply has no embedding for a niche query.
          } catch (err) {
            console.warn('[search] RPC failed, falling back to Pagefind:', err);
          }
        }

        // ── Path 2: Pagefind (legacy path, retained as fallback) ───────
        if (!q) {
          currentResults = [];
          renderIdle();
          updateUrl(q);
          return;
        }
        try {
          const pf = await loadPagefind();
          const filters = currentKind === 'all' ? undefined : { kind: currentKind };
          const result = await pf.search(q, filters ? { filters } : undefined);
          if (myToken !== searchToken) return;
          currentResults = result.results;
          currentResults = withBestBet(currentResults, q);
          if (currentResults.length === 0) {
            renderEmpty(q);
          } else {
            await showPage(1);
          }
          logSearch(q, currentResults.length, currentKind);
        } catch (err) {
          console.warn('[search] error', err);
          if (list) list.innerHTML = '<div class="search-page-v2__loading"><p>Search isn\'t available right now. Try again in a moment.</p></div>';
          if (fallback) fallback.hidden = false;
        }
        updateUrl(q);
      }

      function updateUrl(q) {
        const url = new URL(window.location.href);
        if (q) url.searchParams.set('q', q);
        else url.searchParams.delete('q');
        if (currentKind !== 'all') url.searchParams.set('kind', currentKind);
        else url.searchParams.delete('kind');
        window.history.replaceState({}, '', url);
      }

      // Wire form
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        runSearch();
      });

      // Debounced live search as the user types - Pagefind is fast enough
      // that this feels instant.
      let inputDebounce = null;
      input?.addEventListener('input', () => {
        clearTimeout(inputDebounce);
        inputDebounce = setTimeout(runSearch, 100);
      });

      // Filter chip selection
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => {
            c.classList.remove('is-active');
            c.setAttribute('aria-selected', 'false');
          });
          chip.classList.add('is-active');
          chip.setAttribute('aria-selected', 'true');
          currentKind = chip.dataset.kind || 'all';
          if (currentQuery) runSearch();
          else updateUrl(currentQuery);
        });
      });
      // Activate the "All" chip by default
      if (chips[0]) chips[0].classList.add('is-active');

      // Pagination clicks
      pagination?.addEventListener('click', (e) => {
        const stepBtn = e.target.closest('[data-page-delta]');
        if (stepBtn) {
          e.preventDefault();
          const delta = parseInt(stepBtn.dataset.pageDelta, 10) || 0;
          showPage(currentPage + delta);
          return;
        }
        const pageBtn = e.target.closest('[data-page]');
        if (pageBtn) {
          e.preventDefault();
          const p = parseInt(pageBtn.dataset.page, 10) || 1;
          showPage(p);
        }
      });

      list?.addEventListener('click', (e) => {
        const toggle = e.target.closest('[data-search-group-toggle]');
        if (!toggle) return;
        e.preventDefault();
        const group = toggle.closest('.search-result-group');
        if (!group) return;
        const isExpanded = group.classList.toggle('is-expanded');
        toggle.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        if (isExpanded) {
          toggle.textContent = 'Show fewer';
        } else {
          const hiddenCount = group.querySelectorAll('.search-card--extra').length;
          toggle.textContent = `Show ${hiddenCount} more`;
        }
      });

      // Initialise from URL params (?q=… &kind=…)
      const params = new URLSearchParams(window.location.search);
      const initialQ = params.get('q') || '';
      const initialKind = params.get('kind');
      if (initialKind) {
        const kindChip = chips.find((c) => c.dataset.kind === initialKind);
        if (kindChip) {
          chips.forEach((c) => { c.classList.remove('is-active'); c.setAttribute('aria-selected', 'false'); });
          kindChip.classList.add('is-active');
          kindChip.setAttribute('aria-selected', 'true');
          currentKind = initialKind;
        }
      }
      if (initialQ && input) {
        input.value = initialQ;
        runSearch();
      } else {
        renderIdle();
      }

      input?.focus();
    })();
  </script>

  <!--
    Phase D wave 1: expose pi.search RPC to the inline script.
    Same pattern as SearchOverlay - module script bundled by Astro,
    imports search-client which carries supabase-js. `available` is
    false when window.__PI_SB is missing, so the inline runSearch
    falls through to Pagefind without any visible regression.
  -->
  <script>
    import { search, typeahead } from '../lib/search-client.ts';
    function isAvailable() {
      const sb = (window as any).__PI_SB;
      return Boolean(sb && sb.url && sb.key);
    }
    (window as any).PISearchRpc = {
      get available() { return isAvailable(); },
      search,
      typeahead,
    };
  </script>
</BaseLayout>
