---
/**
 * /journal/cellar-door/ — index of cellar-door dispatch articles
 *
 * Lists all published articles with format === 'cellar-door-dispatch'.
 * Follows the same pattern as other journal section indexes.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import NewsletterBlock from '../../../components/NewsletterBlock.astro';
import { editableText } from '../../../lib/inline-edit/attrs';

const dispatches = (await getCollection('articles', ({ data }) =>
  data.format === 'cellar-door-dispatch' && data.status === 'published'
)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'Cellar Door Dispatches' },
];
export const prerender = true;
---

<BaseLayout
  title="Cellar Door Dispatches · Peninsula Insider"
  description="The producers worth the appointment, the wines worth the cellar, and the arguments happening in the vines. Peninsula Insider's cellar-door dispatch series."
  section="journal"
  canonical="https://peninsulainsider.com.au/journal/cellar-door/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="cellar-door-hub" aria-label="Cellar door dispatches">
    <div class="container">
      <div class="cellar-door-hub__header">
        <p class="label label--accent">Wine</p>
        <h1 class="cellar-door-hub__title" {...editableText({ entityType: 'page', entitySlug: 'journal-cellar-door', fieldPath: 'hero.title', label: 'Cellar Door — title' })}>Cellar Door Dispatches</h1>
        <p class="cellar-door-hub__dek" {...editableText({ entityType: 'page', entitySlug: 'journal-cellar-door', fieldPath: 'hero.dek', label: 'Cellar Door — dek' })}>The producers worth the appointment, the wines worth the cellar, and the arguments happening in the vines.</p>
      </div>

      {dispatches.length > 0 ? (
        <div class="venues__grid">
          {dispatches.map((article) => <ArticleCard article={article} hideType />)}
        </div>
      ) : (
        <p class="cellar-door-hub__empty">The first dispatch is coming. Subscribe to the newsletter to be the first to read it.</p>
      )}
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  .cellar-door-hub {
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(2rem, 4vw, 3rem);
  }
  .cellar-door-hub__header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .cellar-door-hub__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0.25rem 0 0.6rem;
  }
  .cellar-door-hub__dek {
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--soft);
    max-width: 44rem;
    margin: 0;
  }
  .cellar-door-hub__empty {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    color: var(--soft);
    padding: 2rem 0;
  }
</style>
