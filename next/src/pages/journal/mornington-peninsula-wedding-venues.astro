  { label: "Home", href: "/" },
  { label: "Journal", href: "/journal/" },
  { label: "Mornington Peninsula Wedding Venues" },
];
export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Wedding Venues · Peninsula Insider"
  description="Mornington Peninsula wedding venues sorted by format: vineyard estates, coastal and hotel venues, boutique properties, intimate weddings, large weddings, and single-site ceremony and reception."
  section="journal"
  canonical="https://peninsulainsider.com.au/journal/mornington-peninsula-wedding-venues"
  ogImage="/images/sourced/article-vineyard-villa-01.webp"
  searchImage="/images/sourced/article-vineyard-villa-01.webp"
  ogType="article"
  modifiedTime="2026-08-02"
>
