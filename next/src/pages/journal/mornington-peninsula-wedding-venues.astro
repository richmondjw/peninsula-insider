  headline: 'Mornington Peninsula Wedding Venues',
  description: 'Mornington Peninsula wedding venues sorted by format: vineyard estates, coastal and hotel venues, boutique properties, intimate weddings, large weddings, and single-site ceremony and reception. Capacity, register, and the practical detail that decides between them.',
  datePublished: '2026-04-14',
  dateModified: '2026-08-02',
  author: { '@type': 'Organization', name: 'Peninsula Insider', url: 'https://peninsulainsider.com.au' },
  publisher: {
    '@type': 'Organization',
    name: 'Peninsula Insider',
    url: 'https://peninsulainsider.com.au',
    logo: { '@type': 'ImageObject', url: 'https://peninsulainsider.com.au/images/sourced/home-cover.webp' },
  },
  mainEntityOfPage: 'https://peninsulainsider.com.au/journal/mornington-peninsula-wedding-venues',
  url: 'https://peninsulainsider.com.au/journal/mornington-peninsula-wedding-venues',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the best wedding venue on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It depends on the wedding. Montalto suits a food-led estate wedding to 120 guests. Pt. Leo Estate suits coastal architecture and photography to 200. The Continental Sorrento suits a walkable town-centre wedding to 200. Polperro suits an intimate vineyard wedding under 80. Each serves a different style and a different guest count, so the useful question is which format fits, not which venue ranks highest.',
      },
    },
    {
      '@type': 'Question',
      name: 'How far in advance should you book a Mornington Peninsula wedding venue?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For peak season (October to April), book 14 to 18 months in advance. The most popular venues on premium Saturday dates fill even earlier. Winter weddings (May to August) are easier to secure with 6 to 12 months notice and often come at reduced venue hire rates. Friday and Sunday weddings at any time of year are easier to book and sometimes cheaper.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much does a Mornington Peninsula wedding cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Venue hire plus catering varies widely with the venue, guest count, and menu choice. The major additional cost specific to the Peninsula is transport - a return guest coach from Melbourne is a line item worth quoting before you shortlist venues. Accommodation for the wedding party adds another variable. A Peninsula wedding typically costs 10-20% more than an equivalent Melbourne venue once transport and accommodation are factored in.',
      },
    },
  ],
