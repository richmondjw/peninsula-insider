---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import VenueCard from '../../components/VenueCard.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import PiArticleActions from '../../components/PiArticleActions.astro';
import ClusterLinks from '../../components/ClusterLinks.astro';
import ItineraryCard from '../../components/ItineraryCard.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import CorrectionNote from '../../components/CorrectionNote.astro';
import HubGuideTOC from '../../components/HubGuideTOC.astro';
import { formatLabel, routeSlug, venueHrefPrefix, titleize, heroBackgroundStyle, formatHeroCredit } from '../../lib/editorial';
import { pickRelatedArticles, resolveRefs } from '../../lib/related';
import { isPeninsulaThisWeekend, ptwArchivePath } from '../../lib/peninsula-this-weekend';
import { editableText, editableImage } from '../../lib/inline-edit/attrs';
import { loadOverrides } from '../../lib/inline-edit/overrides';
import { sanityReadEnabled } from '../../lib/sanity/client';
import { fetchArticleFromSanity, extractHeadingsFromPT } from '../../lib/sanity/article-adapter';
import PortableTextBody from '../../components/PortableTextBody.astro';

export async function getStaticPaths() {
  const STATIC_JOURNAL_OVERRIDES = new Set([
    'best-golf-courses-mornington-peninsula',
    'best-spas-mornington-peninsula',
    'free-things-to-do-mornington-peninsula',
    'mornington-peninsula-beach-guide',
    'mornington-peninsula-golf-guide',
    'the-dog-friendly-peninsula',
    'the-peninsula-beach-swimming-guide',
    'the-peninsula-with-kids',
    'the-rainy-day-peninsula-without-a-booking',
    'things-to-do-mornington-peninsula',
    'where-to-stay-mornington-peninsula',
  ]);
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles
    .filter((article) => !STATIC_JOURNAL_OVERRIDES.has(routeSlug(article)))
    .map((article) => ({
      params: { slug: routeSlug(article) },
      props: { article },
    }));
}

let { article } = Astro.props;

// Dual-read. When the flag is on AND the article exists in Sanity, swap
// it in. Body becomes Portable Text (rendered by <PortableTextBody />
// below instead of Astro's render()).
let sanityBody: Array<Record<string, unknown>> | null = null;
if (sanityReadEnabled('articles')) {
  const sanityArt = await fetchArticleFromSanity(routeSlug(article));
  if (sanityArt) {
    article = sanityArt as any;
    sanityBody = sanityArt.body;
  }
}

// Plans articles live at /plans/[slug] — redirect with 301 so inbound
// /journal/ URLs resolve cleanly without serving duplicate content.
if (article.data.section === 'plans') {
  return Astro.redirect(`/plans/${routeSlug(article)}/`, 301);
}

// Peninsula This Weekend dispatches were migrated to a stable rolling URL
// (/whats-on/this-weekend/) with per-week archive (Wave 2 Brief 2,
// 2026-05-10). The journal URL pattern still emits a static page so
// inbound search traffic, social shares, and external backlinks resolve
// cleanly — but the body is a flash-free redirect to the dated archive
// URL rather than the article content. See lib/peninsula-this-weekend.ts.
const ptwRedirectTo = isPeninsulaThisWeekend(article) ? ptwArchivePath(article) : null;

// Astro's render() can't be called on a Sanity-sourced article. When
// sanityBody is set we render the body via <PortableTextBody> further
// down; Content stays null here. Headings are extracted from the
// Portable Text body so hub-guide TOC keeps working on Sanity articles.
const { Content, headings } = ptwRedirectTo
  ? { Content: null as any, headings: [] as Array<{ slug: string; text: string; depth: number }> }
  : sanityBody
    ? { Content: null as any, headings: extractHeadingsFromPT(sanityBody) }
    : await render(article);

// Hub-guide treatment: planning-utility articles (regional reference, hub
// guides, trail guides, venue guides) read as scan-first reference rather
// than long-form prose. The template applies a sticky TOC + 2-col grid
// when the format is in this set.
const HUB_GUIDE_FORMATS = new Set(['hub-guide', 'service', 'trail-guide', 'venue-guide']);
const isHubGuide = HUB_GUIDE_FORMATS.has(String(article.data.format ?? ''));

// Editorial-only formats: immersive reading pieces that should end cleanly
// at the newsletter block. No downstream venue/experience/place/itinerary
// card sections — those are reference/planning surface patterns, not editorial
// ones. Venues referenced within the prose appear as inline links only.
// Applies to: editors-letter, slow-peninsula, interview, investigation, insider-edit.
const EDITORIAL_FORMATS = new Set([
  'editors-letter',
  'slow-peninsula',
  'interview',
  'investigation',
  'insider-edit',
]);
const isEditorialFormat = EDITORIAL_FORMATS.has(String(article.data.format ?? ''));

const allArticles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const currentIndex = allArticles.findIndex((a) => routeSlug(a) === routeSlug(article));
const prevArticle = currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;
const nextArticle = currentIndex > 0 ? allArticles[currentIndex - 1] : null;

// Related articles: explicit relatedArticles refs lead, then format/tag
// similarity, then a recency fallback. Single helper keeps all three layers
// in one place so no surface ever shows an empty rail. Limit bumped from
// 3 to 6 on 2026-05-05 (experiment 2026-05-05-02) to expose more siblings,
// concentrating crawl signal on the 58 unindexed journal articles.
const relatedArticles = pickRelatedArticles(article, allArticles, {
  explicit: article.data.relatedArticles,
  limit: 6,
});

const allVenues = await getCollection('venues');
const relatedVenues = resolveRefs(article.data.relatedVenues, allVenues).slice(0, 3);

const allExperiences = await getCollection('experiences');
const relatedExperiences = resolveRefs(article.data.relatedExperiences, allExperiences).slice(0, 3);

const allPlaces = await getCollection('places');
const relatedPlaces = resolveRefs(article.data.relatedPlaces, allPlaces).slice(0, 3);

const allItineraries = await getCollection('itineraries');
const relatedItineraries = resolveRefs(article.data.relatedItineraries, allItineraries).slice(0, 3);

const authorLabel = article.data.houseByline
  ? 'The Peninsula Insider'
  : String(article.data.author?.id ?? article.data.author);
const slug = routeSlug(article);

// Build-time CMS override consult. If an editor has uploaded a new hero
// via the inline editor, it wins over the content-MDX default — and
// crucially, it ships in the static HTML so there's no client-side flash
// where the default paints first and gets swapped after hydration.
const articleOverrides = await loadOverrides('article', slug);
const overrideHero = articleOverrides.image['hero'];

// Body-block text overrides — one entry per paragraph/heading/list/blockquote
// the editor has rewritten via the inline editor. Field path format:
// `body.block:<deterministic-hash>`. Inlined as a JSON blob below so the
// pre-paint patcher in client.ts can apply them before the body becomes
// visible, eliminating the flash where the MDX-rendered default paints first.
const blockOverridesEntries = Object.entries(articleOverrides.text)
  .filter(([k]) => k.startsWith('body.block:'))
  .map(([k, v]) => [k.slice('body.block:'.length), v] as const);
const blockOverrides = Object.fromEntries(blockOverridesEntries);
const articleHeroStyle = overrideHero?.src
  ? `background-image: url('${overrideHero.src.replace(/["\\]/g, (m: string) => `\\${m}`)}'); background-size: cover; background-position: center;`
  : heroBackgroundStyle(article.data);
const heroAlt = overrideHero?.alt ?? article.data.heroImage?.alt ?? article.data.title;

const canonical = `https://peninsulainsider.com.au/journal/${slug}/`;
const ogImage = overrideHero?.src
  ?? (article.data.heroImage?.src && !article.data.heroImage.src.includes('placeholder')
      ? article.data.heroImage.src
      : '/images/sourced/home-cover.webp');

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Journal', href: '/journal' },
  { label: article.data.title },
];

// Map internal format tag → human-readable articleSection for JSON-LD.
// Per Operational Definitions v1.2 (Journal section): format must be exposed
// in structured data so AI/search systems can distinguish editorial perspective
// from service or planning content. Visible CSS labels are not enough.
const formatToArticleSection: Record<string, string> = {
  'editors-letter': "Editor's Letter",
  'long-lunch-list': 'Long Lunch List',
  'cellar-door-dispatch': 'Cellar Door Dispatch',
  'stay-notes': 'Stay Notes',
  'slow-peninsula': 'Slow Peninsula',
  'insider-edit': 'Insider Edit',
  'interview': 'Interview',
  'investigation': 'Investigation',
  'service': 'Service',
  'weekend-picker': 'Weekend Picker',
  'hub-guide': 'Hub Guide',
  'trail-guide': 'Trail Guide',
  'venue-guide': 'Venue Guide',
};
const articleSection = formatToArticleSection[String(article.data.format ?? '')] ?? 'Editorial';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.dek,
  articleSection,
  datePublished: article.data.publishedAt.toISOString(),
  ...(article.data.updatedAt ? { dateModified: article.data.updatedAt.toISOString() } : {}),
  author: {
    '@type': 'Organization',
    name: 'Peninsula Insider',
    url: 'https://peninsulainsider.com.au',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Peninsula Insider',
    url: 'https://peninsulainsider.com.au',
    logo: {
      '@type': 'ImageObject',
      url: 'https://peninsulainsider.com.au/images/sourced/home-cover.webp',
    },
  },
  ...(ogImage !== '/images/sourced/home-cover.webp' ? { image: `https://peninsulainsider.com.au${ogImage}` } : {}),
  mainEntityOfPage: canonical,
  url: canonical,
  about: {
    '@type': 'Place',
    name: 'Mornington Peninsula, Victoria, Australia',
  },
};

const evergreenFormats = new Set(['service', 'hub-guide', 'trail-guide', 'venue-guide', 'long-lunch-list', 'cellar-door-dispatch', 'stay-notes']);
const showCorrectionNote = evergreenFormats.has(String(article.data.format ?? ''));

const faqSchema = article.data.faq && article.data.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: article.data.faq.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;
export const prerender = true;
---

{ptwRedirectTo ? (
  <html lang="en-AU">
    <head>
      <meta charset="utf-8" />
      <title>Redirecting…</title>
      <style is:global set:html={'html,body{display:none;visibility:hidden}'} />
      <script type="text/javascript" set:html={`window.location.replace(${JSON.stringify(ptwRedirectTo)});`} />
      <meta http-equiv="refresh" content={`0;url=${ptwRedirectTo}`} />
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={`https://peninsulainsider.com.au${ptwRedirectTo}`} />
    </head>
    <body></body>
  </html>
) : (
<BaseLayout
  title={`${article.data.title} · Peninsula Insider`}
  description={article.data.dek}
  section="journal"
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  publishedTime={article.data.publishedAt.toISOString()}
  modifiedTime={(article.data.updatedAt ?? article.data.publishedAt).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <!-- Magazine-style split hero: meta + title + dek + byline LEFT,
         hero image RIGHT, on a generous cream surface. -->
    <header class="article-hero">
      <div class="container">
        <div class="article-hero__frame">
          <div class="article-hero__head">
            <div class="article-hero__meta">
              <span class="article-hero__format">{formatLabel[article.data.format] ?? article.data.format}</span>
              <span class="article-hero__sep" aria-hidden="true"></span>
              <span class="article-hero__date">{article.data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              {article.data.readingTimeMinutes && (
                <>
                  <span class="article-hero__sep" aria-hidden="true"></span>
                  <span class="article-hero__read">{article.data.readingTimeMinutes} min read</span>
                </>
              )}
            </div>
            <h1 class="article-hero__title" {...editableText({
              entityType: 'article', entitySlug: slug, fieldPath: 'title',
              label: `${article.data.title} — title`,
            })}>{article.data.title}</h1>
            <p class="article-hero__dek" {...editableText({
              entityType: 'article', entitySlug: slug, fieldPath: 'dek',
              label: `${article.data.title} — dek`,
            })}>{article.data.dek}</p>
            <PiArticleActions
              slug={article.id}
              section={article.data.section ?? 'journal'}
              title={article.data.title}
              dek={article.data.dek}
              imageUrl={article.data.heroImage?.src}
            />
            <div class="article-hero__byline">
              <span class="article-hero__byline-name">— By <strong>{authorLabel}</strong></span>
            </div>
            {article.data.tags.length > 0 && (
              <div class="article-hero__tags">
                {article.data.tags.slice(0, 4).map((tag) => (
                  <span class="article-hero__tag">{titleize(tag)}</span>
                ))}
              </div>
            )}
          </div>
          <figure class="article-hero__figure">
            <div class="article-hero__image" role="img" aria-label={heroAlt} style={articleHeroStyle} {...editableImage({
              entityType: 'page', entitySlug: `journal/${slug}`, fieldPath: 'hero',
              label: `${article.data.title} hero`, purpose: 'hero',
              sanitySingletonId: `pageHero-journal--${slug}`,
              sanitySingletonPath: 'image',
            })}></div>
            {article.data.heroImage.credit && (
              <figcaption class="article-hero__credit">{formatHeroCredit(article.data.heroImage.credit)}</figcaption>
            )}
          </figure>
        </div>
      </div>
    </header>

    <div class={`container${isHubGuide ? ' article-body--hub' : ''}`}>
      {isHubGuide && <HubGuideTOC headings={headings} />}
      <div class="article-body__content">
        {article.data.aiSummary && article.data.aiSummary.length > 0 && (
          <section class="article-summary" aria-label="Quick summary">
            <div class="article-summary__eyebrow">Start here</div>
            <h2 class="article-summary__title">The short version</h2>
            <ul class="article-summary__list">
              {article.data.aiSummary.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}

        <div class="prose has-drop-cap" data-pi-prose-root data-pi-entity-type="article" data-pi-entity-slug={slug}>
          {sanityBody ? <PortableTextBody blocks={sanityBody} /> : <Content />}
        </div>

        {/* Pre-paint block-override patcher. Reads the JSON blob below and
            swaps the innerHTML of each matching [data-pi-block-id] element
            BEFORE the browser paints the body. Ships only when there are
            overrides to apply — saves a script roundtrip on uncustomised
            articles. is:inline ensures the script runs synchronously in
            document order. */}
        {Object.keys(blockOverrides).length > 0 && (
          <>
            <script
              type="application/json"
              id="pi-block-overrides"
              set:html={JSON.stringify(blockOverrides)}
            />
            <script is:inline>
              {`(function(){
                try {
                  var n = document.getElementById('pi-block-overrides');
                  if (!n || !n.textContent) return;
                  var o = JSON.parse(n.textContent);
                  var els = document.querySelectorAll('[data-pi-prose-root] [data-pi-block-id]');
                  for (var i = 0; i < els.length; i++) {
                    var id = els[i].getAttribute('data-pi-block-id');
                    if (o[id] != null) els[i].innerHTML = o[id];
                  }
                } catch (e) { /* fail silent — the default content stays visible */ }
              })();`}
            </script>
          </>
        )}

        {showCorrectionNote && <CorrectionNote />}

        {article.data.clusterLinks && article.data.clusterLinks.length > 0 && (
          <ClusterLinks links={article.data.clusterLinks} heading="Explore this hub" />
        )}

        {article.data.faq && article.data.faq.length > 0 && (
          <section class="article-faq" aria-labelledby="article-faq-title">
            <div class="article-faq__header">
              <p class="article-faq__eyebrow">Questions readers actually ask</p>
              <h2 id="article-faq-title" class="article-faq__title">FAQ</h2>
            </div>
            <div class="article-faq__items">
              {article.data.faq.map((item) => (
                <details class="article-faq__item">
                  <summary class="article-faq__question">{item.question}</summary>
                  <div class="article-faq__answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="venues venues--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Keep reading</p>
            <h2 class="venues__title">More from the Journal</h2>
          </div>
          <a href="/journal/" class="venues__link">All stories →</a>
        </div>
        <div class="venues__grid">
          {relatedArticles.map((entry) => <ArticleCard article={entry} />)}
        </div>
      </div>
    </section>
  )}

  {/* Venue cards: reference/guide formats only. Editorial formats (editors-letter,
      slow-peninsula, interview, investigation, insider-edit) reference venues as
      inline prose links — card sections break reading immersion on those formats. */}
  {!isEditorialFormat && relatedVenues.length > 0 && (
    <section class="venues">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Mentioned in this piece</p>
            <h2 class="venues__title">Venues worth opening in a new tab</h2>
            <p class="venues__sub">Every venue referenced has its own page with editor notes, booking links, and nearby picks.</p>
          </div>
        </div>
        <div class="venues__grid">
          {relatedVenues.map((venue) => <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />)}
        </div>
      </div>
    </section>
  )}

  {/* Experiences / places / itineraries: hidden for editorial-only formats
      (editors-letter, slow-peninsula, interview, investigation, insider-edit).
      Reference and guide formats (hub-guide, service, trail-guide, venue-guide,
      lists, dispatches) show these panels as useful downstream context.
      Previously gated on !isHubGuide which had the logic inverted — these
      panels are appropriate for guides, not for pure editorial pieces. */}
  {!isEditorialFormat && relatedExperiences.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Experiences in this piece</p>
            <h2 class="venues__title">The non-restaurant moves that round out the trip</h2>
          </div>
          <a href="/explore/" class="venues__link">Explore all →</a>
        </div>
        <div class="experience-grid">
          {relatedExperiences.map((exp) => <ExperienceCard experience={exp} />)}
        </div>
      </div>
    </section>
  )}

  {!isEditorialFormat && relatedPlaces.length > 0 && (
    <section class="venues venues--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Places anchored in this piece</p>
            <h2 class="venues__title">Where on the Peninsula this lands</h2>
          </div>
          <a href="/places/" class="venues__link">All places →</a>
        </div>
        <div class="venues__grid">
          {relatedPlaces.map((place) => <PlaceCard place={place} />)}
        </div>
      </div>
    </section>
  )}

  {!isEditorialFormat && relatedItineraries.length > 0 && (
    <section class="venues">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Make this a weekend</p>
            <h2 class="venues__title">Itineraries that pick up where this piece leaves off</h2>
          </div>
          <a href="/plans/" class="venues__link">All itineraries →</a>
        </div>
        <div class="venues__grid">
          {relatedItineraries.map((it) => <ItineraryCard itinerary={it} />)}
        </div>
      </div>
    </section>
  )}

  {(prevArticle || nextArticle) && (
    <nav class="article-nav" aria-label="Article navigation">
      <div class="container">
        <div class="article-nav__inner">
          {prevArticle ? (
            <a href={`/journal/${routeSlug(prevArticle)}`} class="article-nav__link article-nav__link--prev">
              <span class="article-nav__direction">← Previous</span>
              <span class="article-nav__link-title">{prevArticle.data.title}</span>
            </a>
          ) : <div />}
          {nextArticle ? (
            <a href={`/journal/${routeSlug(nextArticle)}`} class="article-nav__link article-nav__link--next">
              <span class="article-nav__direction">Next →</span>
              <span class="article-nav__link-title">{nextArticle.data.title}</span>
            </a>
          ) : <div />}
        </div>
      </div>
    </nav>
  )}

  <NewsletterBlock />
</BaseLayout>
)}

<style>
  /* ── Hub-guide layout ───────────────────────────────────────────────
     For articles with format = hub-guide / service / trail-guide /
     venue-guide, the body container becomes a 2-col grid at desktop:
     sticky TOC on the left, content on the right. Mobile / tablet
     collapses back to single column with the TOC rendering as a
     horizontal scroll bar at the top (handled in HubGuideTOC.astro).
  ─────────────────────────────────────────────────────────────────────── */
  .article-body--hub .article-body__content {
    min-width: 0;
  }
  @media (min-width: 1080px) {
    .article-body--hub {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      gap: clamp(2.5rem, 4vw, 3.75rem);
      align-items: start;
    }
  }

  .article-summary {
    margin: 2.5rem 0 2rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid rgba(33, 30, 28, 0.12);
    background: rgba(246, 241, 232, 0.7);
  }
  .article-summary__eyebrow,
  .article-faq__eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, #7a5c3e);
  }
  .article-summary__title,
  .article-faq__title {
    margin: 0 0 0.9rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    font-weight: 500;
    color: var(--ink, #211e1c);
  }
  .article-summary__list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }
  .article-summary__list li {
    color: var(--ink-soft, #433d39);
    line-height: 1.65;
  }
  .article-faq {
    margin-top: 2.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(0,0,0,.08);
  }
  .article-faq__items {
    display: grid;
    gap: 0.8rem;
  }
  .article-faq__item {
    border-bottom: 1px solid rgba(0,0,0,.08);
    padding-bottom: 0.8rem;
  }
  .article-faq__question {
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--ink, #211e1c);
  }
  .article-faq__question::-webkit-details-marker {
    display: none;
  }
  .article-faq__answer p {
    margin: 0.7rem 0 0;
    color: var(--ink-soft, #433d39);
    line-height: 1.7;
  }
</style>
