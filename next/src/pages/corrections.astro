---
/**
 * /corrections/ - the public corrections policy, and the intake form behind it.
 *
 * Until PI-016 this page published a policy and a mailto link. Nothing a
 * reader reported produced a record: no queue, no reference, no acknowledgement
 * and no audit history, so the policy above the link could not actually be
 * kept. The form writes to pi.corrections (plus pi.correction_reporters when
 * contact is given) through the anon Supabase client, exactly as /submit/ does.
 *
 * There is no application server: this is a static build on GitHub Pages and
 * RLS is the only gate. Two consequences shape the code below. The case
 * reference is minted in the browser before the insert, because the anon role
 * has no select policy and so a server-generated id could never be read back
 * to show the reporter. And the mailto address stays visible, because when
 * Supabase is unreachable the only remaining route to the desk is email.
 *
 * Schema and reasoning: ops/migrations/2026-09-13-pi-corrections-queue.sql
 * Helpers and their tests: src/lib/corrections.ts, src/lib/corrections.test.mjs
 * Operating loop after intake: ops/correction-handling.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Corrections' },
];

// Standing (not identity). It changes how a claim is verified, never how fast
// it is looked at - see the free-correction paragraph below.
const relationships = [
  { value: 'reader',         label: 'A reader who spotted it' },
  { value: 'operator',       label: 'I own or work at the venue, or run the event' },
  { value: 'subject',        label: 'I am the person or business the piece is about' },
  { value: 'representative', label: 'I am acting for them' },
  { value: 'other',          label: 'Something else' },
];

// Advisory input to triage, not a promise about turnaround.
const severities = [
  { value: 'urgent', label: 'Urgent - it could mislead someone planning a visit today' },
  { value: 'normal', label: 'Normal' },
  { value: 'minor',  label: 'Minor' },
];

// The affected-URL pattern has to reach the template as an expression.
// Written inline as a plain attribute it goes through the Astro compiler,
// which eats the backslashes and ships pattern="s*S.*" instead: a regex that
// rejects almost every real URL. Verified in dist, not assumed.
//
// It does exactly one job, and deliberately not more. A field holding
// nothing but whitespace satisfies `required`, and this rejects it. It does
// NOT try to decide what a valid page reference looks like: a reporter who
// cannot produce a URL must still be able to file, and corrections.ts keeps
// an unparseable value verbatim rather than losing the report.
const affectedUrlPattern = '\\s*\\S.*';

const lastUpdated = '13 September 2026';
export const prerender = true;
---

<BaseLayout
  title="Corrections | Peninsula Insider"
  description="How Peninsula Insider handles corrections, clarifications and editorial updates. Spotted something wrong? Tell us."
  section="home"
  canonical="https://peninsulainsider.com.au/corrections/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="legal">
    <div class="container">
      <div class="legal__header">
        <p class="label label--accent">Editorial standards</p>
        <h1 class="legal__title">Corrections &amp; clarifications</h1>
        <p class="legal__updated">Policy last updated: {lastUpdated}</p>
      </div>

      <div class="legal__body prose">
        <p>Peninsula Insider takes accuracy seriously. If something we have published is wrong, incomplete or misleading, we correct it. Quickly, on the page where the error appeared, and with a record of what changed and how we checked it.</p>
        <p>If you want the step before this one, <a href="/how-we-check/">how we check</a> sets out where a fact on this site comes from, who we believe when two sources disagree, and how much of that work is done so far.</p>

        <h2>What counts as a correction</h2>
        <p>We treat the following as material errors that require a correction:</p>
        <ul>
          <li>Factual inaccuracies in editorial copy (names, dates, prices, addresses, opening hours, ownership)</li>
          <li>Misattributed quotes or mischaracterised positions</li>
          <li>Out-of-date information that materially misleads a reader planning a visit</li>
          <li>Photo credits or captions that are wrong or missing</li>
          <li>Broken or misdirected booking and ticketing links</li>
        </ul>
        <p>Minor copy edits, typo fixes and structural improvements are made silently. A material correction is logged with the date, what changed and how it was verified.</p>

        <h2>How we handle them</h2>
        <ol>
          <li><strong>Verify</strong> the error against the original source or a fresh check with the venue or organiser.</li>
          <li><strong>Update</strong> the page with the correct information.</li>
          <li><strong>Log</strong> the correction where the change is material, with the date, what changed and how it was verified.</li>
          <li><strong>Reply</strong> to the reader who flagged it, where contact details were provided.</li>
        </ol>

        <h2>Reporting an error</h2>
        <p>Use the form below. It asks for four things: the page it is on, what is wrong, what it should say instead, and how you know. Those four are what let us verify a correction rather than write back asking for them. We act on corrections promptly, typically within one business day.</p>
        <p><strong>Correcting a factual error is free.</strong> No charge, no commercial relationship required, and a correction is handled the same way whoever reports it: reader, operator, or the subject of the piece. Who you are changes how we verify a claim, never how quickly we look at it.</p>

        <form class="submit-form" data-corrections-form aria-label="Report a correction">
          <fieldset class="submit-form__group">
            <legend class="submit-form__legend">The error</legend>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-url">The page it is on</label>
              <input
                id="correction-url"
                name="affected_url"
                type="text"
                required
                maxlength="500"
                inputmode="url"
                autocomplete="off"
                pattern={affectedUrlPattern}
                title="Paste the page address, or just the part after peninsulainsider.com.au"
                class="submit-form__input"
                placeholder="https://peninsulainsider.com.au/eat/portsea-hotel/"
              />
              <p class="submit-form__hint">Paste the address out of your browser, or just the part after the domain. This is the thing an emailed correction most often leaves out, and without it we are guessing.</p>
            </div>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-claim">What we published that is wrong</label>
              <textarea
                id="correction-claim"
                name="claim"
                required
                maxlength="1200"
                rows="3"
                class="submit-form__textarea"
                placeholder="You have the kitchen closing at 9pm on Sundays."
              ></textarea>
            </div>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-proposed">What it should say instead</label>
              <textarea
                id="correction-proposed"
                name="proposed_correction"
                required
                maxlength="1200"
                rows="3"
                class="submit-form__textarea"
                placeholder="The kitchen closes at 8pm on Sundays, and has since June."
              ></textarea>
            </div>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-evidence">How you know</label>
              <textarea
                id="correction-evidence"
                name="evidence"
                required
                maxlength="1200"
                rows="3"
                class="submit-form__textarea"
                placeholder="I run the kitchen. Our own site and the sign on the door both say 8pm."
              ></textarea>
              <p class="submit-form__hint">A primary source is what turns this into a same-week fix: the venue's own page, a public register, a photo, a booking confirmation. "It looked wrong" is still worth sending, it just takes us longer to verify.</p>
            </div>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-evidence-url">A link to that source (optional)</label>
              <input
                id="correction-evidence-url"
                name="evidence_url"
                type="url"
                maxlength="500"
                class="submit-form__input"
                placeholder="https://example.com/opening-hours"
              />
            </div>
          </fieldset>

          <fieldset class="submit-form__group">
            <legend class="submit-form__legend">Context</legend>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-relationship">Where you are standing</label>
              <select id="correction-relationship" name="reporter_relationship" class="submit-form__select">
                {relationships.map((r) => <option value={r.value}>{r.label}</option>)}
              </select>
              <p class="submit-form__hint">This tells us how to verify the claim. It does not change the queue.</p>
            </div>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-severity">How urgent is it</label>
              <select id="correction-severity" name="severity" class="submit-form__select">
                {severities.map((s) => <option value={s.value} selected={s.value === 'normal'}>{s.label}</option>)}
              </select>
            </div>
          </fieldset>

          <fieldset class="submit-form__group">
            <legend class="submit-form__legend">You (optional)</legend>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-name">Your name</label>
              <input
                id="correction-name"
                name="contact_name"
                type="text"
                maxlength="120"
                class="submit-form__input"
                placeholder="Jo Bennett"
              />
            </div>

            <div class="submit-form__field">
              <label class="submit-form__label" for="correction-email">Email</label>
              <input
                id="correction-email"
                name="contact_email"
                type="email"
                maxlength="240"
                class="submit-form__input"
                placeholder="you@example.com"
              />
              <p class="submit-form__hint">Optional, and leaving it blank costs you nothing: a correction with no address on it is still verified, still fixed and still logged. It is the only thing we cannot do, which is write back and tell you what we did. Your details are held apart from the case itself and are used for that reply and nothing else.</p>
            </div>
          </fieldset>

          <div class="submit-form__submit">
            <button type="submit" class="submit-form__button pi-btn pi-btn--solid">File the correction</button>
            <p class="submit-form__caveat">You will get a reference on screen as soon as it is filed. Keep it: it is how you follow the case up, and with no email address it is the only handle you will have.</p>
          </div>

          <p class="submit-form__status" data-corrections-status role="status" aria-live="polite" hidden></p>
        </form>

        <p>Prefer email? <a href="mailto:corrections@peninsulainsider.com.au">corrections@peninsulainsider.com.au</a> reaches the same desk. Include the page URL and what is wrong, or the first reply will only be us asking for them.</p>

        <h2>If you remain dissatisfied</h2>
        <p>If you have raised a correction and feel it has not been handled properly, write directly to <a href="mailto:hello@peninsulainsider.com.au">hello@peninsulainsider.com.au</a> and it will be escalated to the editor.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSupabase, isAuthEnabled } from '../lib/auth';
  import {
    CORRECTIONS_EMAIL,
    buildCorrectionRow,
    buildReporterRow,
    describeMissingFields,
    generateCaseRef,
    missingRequiredFields,
  } from '../lib/corrections';

  /** Light dedupe signal, same shape and same non-guarantee as /submit/. */
  function clientToken(): string {
    try {
      const k = 'pi:corrections:client-token';
      let v = localStorage.getItem(k);
      if (!v) {
        v = (typeof crypto !== 'undefined' && crypto.randomUUID)
          ? crypto.randomUUID()
          : 'tok-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        localStorage.setItem(k, v);
      }
      return v;
    } catch {
      return 'tok-' + Math.random().toString(36).slice(2);
    }
  }

  /**
   * The case id, minted here rather than by the database. The contact row is
   * keyed on it and the anon role cannot select the case back, so the client
   * has to know the id before it writes either row.
   */
  function newCaseId(): string {
    if (typeof crypto !== 'undefined' && crypto.randomUUID) return crypto.randomUUID();
    // Pre-2021 browsers only. Shape-valid v4, weaker entropy; the primary key
    // still turns any collision into a loud failure rather than a silent one.
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (ch) => {
      const r = (Math.random() * 16) | 0;
      return (ch === 'x' ? r : (r & 0x3) | 0x8).toString(16);
    });
  }

  function init() {
    const form = document.querySelector('[data-corrections-form]') as HTMLFormElement | null;
    if (!form) return;

    // init() runs twice on a first load with the client router: once when
    // this module executes, and again when astro:page-load fires, which it
    // does on the initial load as well as after a navigation. Without this
    // guard the form carries two submit listeners and one press files the
    // correction twice - two cases, two references, one report, and the
    // reference shown is the second one's. Found while building the partner
    // enquiry form on the same pattern (PI-015).
    //
    // An element-level guard is the right instrument here, and only because
    // the listener is on the element: a view transition replaces the form, so
    // guard and listener are discarded together.
    if (form.dataset.piCorrectionsBound === '1') return;
    form.dataset.piCorrectionsBound = '1';

    const status = document.querySelector('[data-corrections-status]') as HTMLParagraphElement | null;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    function setStatus(kind: 'success' | 'error' | 'info', message: string) {
      if (!status) return;
      status.textContent = message;
      status.setAttribute('data-status-kind', kind);
      status.removeAttribute('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fd = new FormData(form);
      const values: Record<string, string> = {};
      for (const [key, value] of fd.entries()) {
        values[key] = typeof value === 'string' ? value : '';
      }

      // The browser has already enforced `required`; this catches the case it
      // does not, which is a field holding nothing but whitespace, and says
      // what is outstanding in one sentence instead of leaving the reporter
      // to find the control the browser focused.
      const missing = missingRequiredFields(values);
      if (missing.length > 0) {
        setStatus('error', describeMissingFields(missing));
        return;
      }

      if (button) button.disabled = true;
      setStatus('info', 'Filing…');

      const c = getSupabase();
      if (!c || !isAuthEnabled()) {
        setStatus('error', 'The correction queue is not reachable from this page right now. Email ' + CORRECTIONS_EMAIL + ' instead. Same desk, same queue.');
        if (button) button.disabled = false;
        return;
      }

      const session = (await c.auth.getSession()).data.session;
      const userId = session?.user?.id ?? null;

      const caseRef = generateCaseRef();
      const id = newCaseId();
      const row = buildCorrectionRow(values, { id, caseRef, userId, clientToken: clientToken() });

      const { error } = await c.from('corrections').insert(row);
      if (error) {
        console.warn('[corrections] insert failed:', error.message);
        setStatus('error', 'That did not file. Try once more, and if it fails again email ' + CORRECTIONS_EMAIL + ' with the page URL and what is wrong.');
        if (button) button.disabled = false;
        return;
      }

      // Deliberately second, and deliberately best-effort. The case is already
      // safe on the server by this point, so a failure here costs the reply,
      // never the correction. Same shape as the photo upload on /submit/.
      const reporter = buildReporterRow(values, id);
      let answerable = false;
      if (reporter) {
        try {
          const { error: contactError } = await c.from('correction_reporters').insert(reporter);
          if (contactError) console.warn('[corrections] contact insert failed:', contactError.message);
          else answerable = reporter.contact_preference === 'email';
        } catch (err) {
          console.warn('[corrections] contact insert threw:', err);
        }
      }

      form.reset();
      setStatus(
        'success',
        'Filed. Your reference is ' + caseRef + '. ' +
        (answerable
          ? 'Write it down anyway, then leave it with us. We will reply when it is resolved.'
          : 'Write it down: with no email address on the case, that reference is the only way to follow it up. Quote it to ' + CORRECTIONS_EMAIL + ' if you want an answer.'),
      );
      if (button) button.disabled = false;
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
