---
import { getCollection } from 'astro:content';
import { routeSlug } from '../../lib/editorial';
import Redirect from '../../components/Redirect.astro';

// Legacy /plans/[slug]/ -> /explore/plans/[slug]/ (PR-5 URL migration).
export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries');
  const plansArticles = await getCollection('articles', ({ data }) =>
    data.section === 'plans' && data.status === 'published'
  );
  return [
    ...itineraries.map((i) => ({ params: { slug: routeSlug(i) } })),
    ...plansArticles.map((a) => ({ params: { slug: routeSlug(a) } })),
  ];
}
const { slug } = Astro.params;
---
<Redirect to={`/explore/plans/${slug}/`} consolidate />
