---
/**
 * /plans/[slug] — itinerary detail page + section:plans article pages
 *
 * Handles two entry types:
 *   - itineraries collection: renders the full 11-section anatomy
 *   - articles with section:plans: renders a simpler article layout
 *
 * The conversion architecture (anchor stay 3-placement rule) lives here:
 *   1. Hero CTA above the fold — "Stay at {anchor}"
 *   2. Day-N "where you sleep tonight" block at end of each day except last
 *   3. Footer rail — anchor + alt stays
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import ItineraryCard from '../../components/ItineraryCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import PiForkPlanButton from '../../components/PiForkPlanButton.astro';
import {
  routeSlug,
  stayTypes,
  titleize,
  venueHrefPrefix,
  heroBackgroundStyle,
  formatLabel,
} from '../../lib/editorial';
import {
  audienceDisplay,
  budgetLabel,
  buildEscapeItinerarySchema,
  deriveDuration,
  durationLabel,
  occasionLabel,
  seasonLabel,
  themeLabel,
} from '../../lib/escape';
import { editableText, editableImage } from '../../lib/inline-edit/attrs';

const timeOfDayLabel: Record<string, string> = {
  morning: 'Morning',
  midday: 'Midday',
  afternoon: 'Afternoon',
  evening: 'Evening',
  night: 'Night',
};

const moodLabel: Record<string, string> = {
  slow: 'Slow',
  indulgent: 'Indulgent',
  wellness: 'Wellness',
  adventure: 'Adventure',
  'food-wine': 'Food & Wine',
  mixed: 'Mixed',
  quick: 'Quick',
};

export async function getStaticPaths() {
  const itineraries = await getCollection('itineraries');
  const plansArticles = await getCollection('articles', ({ data }) =>
    data.section === 'plans' && data.status === 'published'
  );
  const itineraryPaths = itineraries.map((itinerary) => ({
    params: { slug: routeSlug(itinerary) },
    props: { itinerary, articleData: null as any },
  }));
  const articlePaths = plansArticles.map((article) => ({
    params: { slug: routeSlug(article) },
    props: { itinerary: null as any, articleData: article },
  }));
  return [...itineraryPaths, ...articlePaths];
}

const { itinerary, articleData } = Astro.props;

// ─── Plans-article branch data ─────────────────────────────────────────────
const isArticle = articleData != null;
const ArticleContent = isArticle ? (await render(articleData)).Content : (null as any);

const ad = isArticle ? articleData.data : null;
const articleSlug = isArticle ? routeSlug(articleData) : null;

// Resolve related venues/experiences for article branch
const allVenuesRaw = await getCollection('venues');
const allExperiencesRaw = await getCollection('experiences');
const venueMapBase = new Map(allVenuesRaw.map((v: any) => [routeSlug(v), v]));
const expMapBase = new Map(allExperiencesRaw.map((e: any) => [routeSlug(e), e]));

const articleRelatedVenues = isArticle
  ? (ad.relatedVenues ?? [])
      .map((r: any) => venueMapBase.get(String(r?.id ?? r ?? '')))
      .filter(Boolean)
      .slice(0, 3)
  : [];

const articleFaqSchema = isArticle && ad.faq && ad.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ad.faq.map(({ question, answer }: any) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
} : null;

const aCanonical = isArticle ? `https://peninsulainsider.com.au/plans/${articleSlug}/` : '';
const aOgImage = isArticle
  ? (ad.heroImage?.src && !ad.heroImage.src.includes('placeholder') ? ad.heroImage.src : '/images/sourced/home-cover.webp')
  : '';
const aBreadcrumbs = isArticle
  ? [{ label: 'Home', href: '/' }, { label: 'Plans', href: '/plans' }, { label: ad.title }]
  : [];

// ─── Itinerary branch data ─────────────────────────────────────────────────
const data = isArticle ? null : itinerary.data;
const slug = isArticle ? '' : routeSlug(itinerary);

const allItineraries = isArticle ? [] : await getCollection('itineraries');
const allVenues = isArticle ? allVenuesRaw : allVenuesRaw;
const allExperiences = isArticle ? allExperiencesRaw : allExperiencesRaw;
const allPlaces = isArticle ? [] : await getCollection('places');
const articles = isArticle ? [] : await getCollection('articles', ({ data: a }) => a.status === 'published');

const venueMap = new Map(allVenues.map((venue: any) => [routeSlug(venue), venue]));
const experienceMap = new Map(allExperiences.map((experience: any) => [routeSlug(experience), experience]));
const placeMap = new Map(allPlaces.map((place: any) => [routeSlug(place), place]));

// ─── Resolve venue/experience references on stops ─────────────────────────
const venueSlugs = data
  ? data.stops.map((stop: any) => String(stop.venue?.id ?? stop.venue ?? '')).filter(Boolean)
  : [];
const experienceSlugs = data
  ? data.stops.map((stop: any) => String(stop.experience?.id ?? stop.experience ?? '')).filter(Boolean)
  : [];
const highlightedVenues = Array.from(new Set(venueSlugs))
  .map((key) => venueMap.get(key))
  .filter(Boolean);
const highlightedExperiences = Array.from(new Set(experienceSlugs))
  .map((key) => experienceMap.get(key))
  .filter(Boolean);

// ─── Anchor stay (conversion architecture) ────────────────────────────────
const anchorStaySlug = data ? String((data as any).anchorStay?.id ?? (data as any).anchorStay ?? '') : '';
const anchorStay = anchorStaySlug ? venueMap.get(anchorStaySlug) : undefined;
const fallbackStay = highlightedVenues.find((v: any) => stayTypes.includes(v.data.type));
const effectiveStay: any = anchorStay ?? fallbackStay;
const effectiveStayHref = effectiveStay
  ? `${venueHrefPrefix(effectiveStay.data.type)}/${routeSlug(effectiveStay)}`
  : undefined;

const altStaySlugs: string[] = data
  ? ((data as any).altStays ?? []).map((entry: any) => String(entry?.id ?? entry ?? '')).filter(Boolean)
  : [];
const altStays = altStaySlugs.map((s) => venueMap.get(s)).filter(Boolean) as any[];
const inferredAltStays = altStays.length === 0
  ? highlightedVenues
      .filter((v: any) => stayTypes.includes(v.data.type) && routeSlug(v) !== routeSlug(effectiveStay ?? { data: {}, id: '' }))
      .slice(0, 2)
  : [];
const stayRail = [...altStays, ...inferredAltStays].slice(0, 2);

// ─── Anchor town label ─────────────────────────────────────────────────────
const anchorTownSlug = data ? String((data as any).anchorTown?.id ?? (data as any).anchorTown ?? '') : '';
const anchorTown = anchorTownSlug ? placeMap.get(anchorTownSlug) : undefined;

// ─── Day-by-day grouping ──────────────────────────────────────────────────
const dayNumbers = data
  ? Array.from(new Set(data.stops.map((stop: any) => stop.day))).sort((a, b) => a - b)
  : [];
const groupedStops = dayNumbers.map((day) => {
  const stops = data!.stops
    .filter((stop: any) => stop.day === day)
    .sort((a: any, b: any) => a.order - b.order)
    .map((stop: any) => {
      const vSlug = String(stop.venue?.id ?? stop.venue ?? '');
      const eSlug = String(stop.experience?.id ?? stop.experience ?? '');
      const venue = vSlug ? venueMap.get(vSlug) : null;
      const experience = eSlug ? experienceMap.get(eSlug) : null;
      const entry = venue ?? experience;
      const href = venue
        ? `${venueHrefPrefix(venue.data.type)}/${routeSlug(venue)}`
        : experience
        ? `/explore/${routeSlug(experience)}`
        : undefined;
      const label = (venue as any)?.data?.name ?? (experience as any)?.data?.name ?? 'Stop';
      return { ...stop, entry, href, label };
    });
  return { day, stops };
});

// ─── Related content ──────────────────────────────────────────────────────
const relatedArticles = articles
  .filter(
    (article: any) =>
      article.data.relatedVenues.some((entry: any) => venueSlugs.includes(String(entry.id ?? entry))) ||
      article.data.relatedExperiences.some((entry: any) => experienceSlugs.includes(String(entry.id ?? entry)))
  )
  .slice(0, 2);
const relatedItineraries = allItineraries
  .filter((entry: any) => routeSlug(entry) !== slug)
  .slice(0, 4);

// ─── Fork-plan items (Wave 5) ─────────────────────────────────────────────
// Editorial itineraries become templates: a single tap merges the itinerary
// itself plus every referenced venue and experience into the reader's
// pi:saves:v2 store. They can then edit, share, or print as their own plan.
type ForkItem = {
  kind: 'article' | 'venue' | 'place' | 'event' | 'experience' | 'itinerary' | 'tour' | 'tour-operator' | 'tour-package';
  slug: string;
  section?: string;
  title: string;
  dek?: string;
  image_url?: string;
  href: string;
};
const forkItems: ForkItem[] = [];
if (data) {
  forkItems.push({
    kind: 'itinerary',
    slug,
    title: data.title,
    dek: data.dek,
    image_url: data.heroImage?.src,
    href: `/plans/${slug}/`,
  });
  for (const v of highlightedVenues) {
    const vSlug = routeSlug(v as any);
    forkItems.push({
      kind: 'venue',
      slug: vSlug,
      title: (v as any).data.name,
      dek: (v as any).data.signature || (v as any).data.editorNote,
      image_url: (v as any).data.heroImage?.src,
      href: `${venueHrefPrefix((v as any).data.type)}/${vSlug}/`,
    });
  }
  for (const e of highlightedExperiences) {
    const eSlug = routeSlug(e as any);
    forkItems.push({
      kind: 'experience',
      slug: eSlug,
      title: (e as any).data.name,
      dek: (e as any).data.editorNote,
      image_url: (e as any).data.heroImage?.src,
      href: `/explore/${eSlug}/`,
    });
  }
}

// ─── Display labels ───────────────────────────────────────────────────────
const duration = data ? deriveDuration(data) : null;
const audienceText = data ? (audienceDisplay[data.audience] ?? titleize(data.audience)) : '';
const themeText = data
  ? ((data as any).theme ?? []).map((t: string) => themeLabel[t] ?? t).filter(Boolean).join(' · ')
  : '';
const occasionText = data ? (occasionLabel[(data as any).occasion ?? 'none'] || '') : '';
const seasonText = data ? (seasonLabel[(data as any).season ?? 'year-round'] || '') : '';
const budgetText = data ? (budgetLabel[(data as any).budget ?? 'mixed'] || '') : '';
const nightsLabel = data ? `${data.lengthNights} night${data.lengthNights === 1 ? '' : 's'}` : '';
const durationText = duration ? durationLabel[duration] ?? duration : nightsLabel;

// ─── Anatomy gates (only render the section if data exists) ───────────────
const showEditorialFrame = data ? Boolean((data as any).editorialFrame) : false;
const showVariations = data ? Array.isArray((data as any).variations) && (data as any).variations.length > 0 : false;
const showSkipThese = data ? Boolean((data as any).skipThese) : false;
const showCostBreakdown = data ? Boolean((data as any).costBreakdown) : false;
const showChecklist = data ? Array.isArray((data as any).bookingChecklist) && (data as any).bookingChecklist.length > 0 : false;
const showFaq = data ? Array.isArray((data as any).faq) && (data as any).faq.length > 0 : false;

// ─── Schema (TouristTrip + FAQPage + BreadcrumbList) ──────────────────────
const schemaDays = groupedStops.map((g) => ({
  name: `Day ${g.day}`,
  stops: g.stops
    .filter((s) => s.label && s.href)
    .map((s) => ({
      name: s.label,
      path: s.href!,
      stopType: s.entry && stayTypes.includes(((s.entry as any).data?.type) ?? '')
        ? 'LodgingBusiness'
        : (s.entry as any)?.data?.type === 'restaurant' || (s.entry as any)?.data?.type === 'cafe'
        ? 'FoodEstablishment'
        : 'TouristAttraction',
    })),
}));

const lastVerified = data
  ? ((data as any).lastVerified instanceof Date
      ? (data as any).lastVerified.toISOString().slice(0, 10)
      : data.publishedAt instanceof Date
      ? data.publishedAt.toISOString().slice(0, 10)
      : undefined)
  : undefined;

const { tripSchema, breadcrumbSchema, faqSchema } = data
  ? buildEscapeItinerarySchema({
      slug,
      title: data.title,
      description: data.dek,
      audienceLabels: [audienceText],
      days: schemaDays,
      anchorStayPath: effectiveStayHref,
      datePublished: data.publishedAt instanceof Date ? data.publishedAt.toISOString().slice(0, 10) : undefined,
      dateModified: lastVerified,
      faq: showFaq ? (data as any).faq : undefined,
    })
  : { tripSchema: null, breadcrumbSchema: null, faqSchema: null };

const lastVerifiedLabel = lastVerified
  ? new Date(lastVerified).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

// ─── Misc ─────────────────────────────────────────────────────────────────
const breadcrumbItems = data
  ? [{ label: 'Home', href: '/' }, { label: 'Plans', href: '/plans' }, { label: data.title }]
  : [];
const canonical = data ? `https://peninsulainsider.com.au/plans/${slug}/` : '';
const ogImage = data
  ? (data.heroImage?.src && !data.heroImage.src.includes('placeholder') ? data.heroImage.src : '/images/sourced/home-cover.webp')
  : '';
---

{isArticle ? (
<BaseLayout
  title={`${ad.title} | Peninsula Insider`}
  description={ad.dek}
  section="escape"
  canonical={aCanonical}
  ogImage={aOgImage}
>
  {articleFaqSchema && <script type="application/ld+json" set:html={JSON.stringify(articleFaqSchema)} />}

  <Breadcrumbs items={aBreadcrumbs} />

  <article class="article">
    <header class="article-hero">
      <div class="container">
        <div class="article-hero__frame">
          <div class="article-hero__head">
            <div class="article-hero__meta">
              <span class="article-hero__format">{formatLabel[ad.format] ?? ad.format}</span>
              <span class="article-hero__sep" aria-hidden="true"></span>
              <span class="article-hero__date">{ad.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              {ad.readingTimeMinutes && (
                <>
                  <span class="article-hero__sep" aria-hidden="true"></span>
                  <span class="article-hero__read">{ad.readingTimeMinutes} min read</span>
                </>
              )}
            </div>
            <h1 class="article-hero__title" {...editableText({
              entityType: 'article', entitySlug: articleSlug!, fieldPath: 'title',
              label: `${ad.title} — title`,
            })}>{ad.title}</h1>
            <p class="article-hero__dek" {...editableText({
              entityType: 'article', entitySlug: articleSlug!, fieldPath: 'dek',
              label: `${ad.title} — dek`,
            })}>{ad.dek}</p>
          </div>
          <figure class="article-hero__figure">
            <div class="article-hero__image" role="img" aria-label={ad.heroImage.alt} style={heroBackgroundStyle(ad)} {...editableImage({
              entityType: 'article', entitySlug: articleSlug!, fieldPath: 'hero',
              label: `${ad.title} hero`, purpose: 'hero',
            })}></div>
          </figure>
        </div>
      </div>
    </header>

    <div class="container">
      {ad.aiSummary && ad.aiSummary.length > 0 && (
        <section class="article-summary" aria-label="Quick summary">
          <div class="article-summary__eyebrow">Start here</div>
          <h2 class="article-summary__title">The short version</h2>
          <ul class="article-summary__list">
            {ad.aiSummary.map((item: string) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      <div class="prose has-drop-cap">
        <ArticleContent />
      </div>

      {ad.faq && ad.faq.length > 0 && (
        <section class="article-faq" aria-labelledby="article-faq-title">
          <div class="article-faq__header">
            <p class="article-faq__eyebrow">Questions readers actually ask</p>
            <h2 id="article-faq-title" class="article-faq__title">FAQ</h2>
          </div>
          <div class="article-faq__items">
            {ad.faq.map((item: any) => (
              <details class="article-faq__item">
                <summary class="article-faq__question">{item.question}</summary>
                <div class="article-faq__answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  {articleRelatedVenues.length > 0 && (
    <section class="venues">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Places in this plan</p>
            <h2 class="venues__title">Worth knowing before you go</h2>
          </div>
        </div>
        <div class="venues__grid">
          {articleRelatedVenues.map((venue: any) => (
            <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />
          ))}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />
</BaseLayout>
) : (
<BaseLayout
  title={`${data!.title} — Mornington Peninsula Weekend Escape | Peninsula Insider`}
  description={data!.dek}
  section="escape"
  canonical={canonical}
  ogImage={ogImage}
  noindex={(data as any).sitemapExclude === true}
>
  <script type="application/ld+json" set:html={JSON.stringify(tripSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <Breadcrumbs items={breadcrumbItems} />

  {/* ─── 1. Hero ──────────────────────────────────────────────────────── */}
  <section class="itinerary-detail">
    <div class="container">
      <div class="itinerary-detail__meta">
        <a href="/plans/" class="itinerary-detail__back">Plans</a>
        <span class="itinerary-detail__dot" aria-hidden="true"></span>
        <span class="itinerary-detail__nights">{durationText}</span>
        {anchorTown && (
          <>
            <span class="itinerary-detail__dot" aria-hidden="true"></span>
            <a href={`/places/${routeSlug(anchorTown)}`} class="itinerary-detail__back">{(anchorTown as any).data.name}</a>
          </>
        )}
      </div>

      <h1 class="itinerary-detail__title" {...editableText({
        entityType: 'itinerary', entitySlug: slug, fieldPath: 'title',
        label: `${data!.title} — title`,
      })}>{data!.title}</h1>
      <p class="itinerary-detail__dek" {...editableText({
        entityType: 'itinerary', entitySlug: slug, fieldPath: 'dek',
        label: `${data!.title} — dek`,
      })}>{data!.dek}</p>

      <div class="itinerary-detail__chips">
        <span>{audienceText}</span>
        {themeText && <span>{themeText}</span>}
        {!themeText && <span>{moodLabel[data!.mood] ?? data!.mood}</span>}
        {occasionText && <span>{occasionText}</span>}
        {seasonText && seasonText !== 'Year-round' && <span>{seasonText}</span>}
        {data!.totalDriveMinutes && <span>{data!.totalDriveMinutes} min driving</span>}
      </div>

      {/* Anchor-stay 3-placement rule, slot 1: hero CTA */}
      {effectiveStay && effectiveStayHref && (
        <div class="itinerary-detail__cta-row">
          <a
            href={`${effectiveStayHref}?utm_source=peninsula-insider&utm_medium=escape&utm_campaign=${slug}&utm_content=hero`}
            class="itinerary-detail__cta"
            data-event="escape_hero_anchor_stay_cta_click"
            data-itinerary={slug}
          >
            Stay at {(effectiveStay as any).data.name} →
          </a>
          <span class="itinerary-detail__cta-note">Anchor stay for this plan</span>
        </div>
      )}

      {/* Fork this editorial plan into the reader's saves. Wave 5 of the
          Save & Share rebuild — editorial content as a template. */}
      <PiForkPlanButton items={forkItems} />

      <div
        class="itinerary-detail__hero feature__image-block feature__image-block--sand"
        aria-hidden="true"
        style={heroBackgroundStyle(data!)}
      >
        <div class="itinerary-detail__hero-fog"></div>
        <span class="itinerary-detail__hero-label">{data!.heroImage.alt}</span>
      </div>

      <div class="itinerary-detail__grid">
        <div>
          {/* ─── 3. Editorial frame ──────────────────────────────────── */}
          {showEditorialFrame && (
            <div class="prose itinerary-detail__editor-note">
              {(data as any).editorialFrame.split(/\n\n+/).map((paragraph: string) => (
                <p>{paragraph}</p>
              ))}
            </div>
          )}

          {/* Editor's note (legacy field — treat as supporting paragraphs) */}
          <div class="prose itinerary-detail__editor-note">
            {data!.editorNote.split(/\n\n+/).map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {/* ─── 5–6. Day-by-day plan ────────────────────────────────── */}
          <div class="stop-list">
            {groupedStops.map((group, idx) => {
              const isLastDay = idx === groupedStops.length - 1;
              return (
                <section class="stop-day">
                  <h2 class="stop-day__heading">Day {group.day}</h2>
                  <ol class="stop-day__stops">
                    {group.stops.map((stop) => (
                      <li class="stop-item">
                        <div class="stop-item__time">
                          {stop.timeRange ?? (timeOfDayLabel[stop.timeOfDay] ?? titleize(stop.timeOfDay))}
                        </div>
                        <div>
                          <h3 class="stop-item__name">
                            {stop.href ? <a href={stop.href}>{stop.label}</a> : stop.label}
                          </h3>
                          {stop.note && <p class="stop-item__note">{stop.note}</p>}
                          {stop.practical && (
                            <p class="stop-item__practical"><em>{stop.practical}</em></p>
                          )}
                          {stop.driveMinutesToNext && (
                            <p class="stop-item__drive">{stop.driveMinutesToNext} min drive to next stop</p>
                          )}
                        </div>
                      </li>
                    ))}
                  </ol>

                  {/* Anchor-stay 3-placement rule, slot 2: where you sleep */}
                  {!isLastDay && effectiveStay && effectiveStayHref && (
                    <aside class="where-you-sleep">
                      <p class="where-you-sleep__label">Where you sleep tonight</p>
                      <p class="where-you-sleep__body">
                        {(data as any).anchorStayBlurb ??
                          `Settle into ${(effectiveStay as any).data.name} for the night. Check the room before dinner so you can step straight into the next morning without admin.`}
                      </p>
                      <a
                        href={`${effectiveStayHref}?utm_source=peninsula-insider&utm_medium=escape&utm_campaign=${slug}&utm_content=inflow`}
                        class="where-you-sleep__cta"
                        data-event="escape_inflow_anchor_stay_click"
                        data-itinerary={slug}
                      >
                        See {(effectiveStay as any).data.name} →
                      </a>
                    </aside>
                  )}
                </section>
              );
            })}
          </div>

          {/* ─── 6. Variations ───────────────────────────────────────── */}
          {showVariations && (
            <section class="variations">
              <h2 class="variations__heading">Variations</h2>
              <div class="variations__grid">
                {(data as any).variations.map((variation: any) => (
                  <article class="variation">
                    <h3 class="variation__label">{variation.label}</h3>
                    <p class="variation__body">{variation.body}</p>
                    {variation.relatedItinerary && (
                      <a class="variation__link" href={`/plans/${variation.relatedItinerary}/`}>
                        See the full version →
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )}

          {/* ─── 7. Worth knowing before you plan ─────────────────────── */}
          {showSkipThese && (
            <section class="skip-these">
              <h2 class="skip-these__heading">Worth knowing before you plan</h2>
              <p class="skip-these__body">{(data as any).skipThese}</p>
            </section>
          )}

          {/* ─── 8. Cost band ────────────────────────────────────────── */}
          {showCostBreakdown && (
            <section class="cost-band">
              <h2 class="cost-band__heading">What this costs</h2>
              <dl class="cost-band__grid">
                {Object.entries((data as any).costBreakdown).map(([k, v]) =>
                  v ? (
                    <>
                      <dt>{k.charAt(0).toUpperCase() + k.slice(1)}</dt>
                      <dd>{v as string}</dd>
                    </>
                  ) : null
                )}
              </dl>
              {(data as any).budgetRangeAud && (
                <p class="cost-band__total">{(data as any).budgetRangeAud}</p>
              )}
            </section>
          )}

          {/* ─── 9. Booking checklist ────────────────────────────────── */}
          {showChecklist && (
            <section class="checklist">
              <h2 class="checklist__heading">Booking checklist</h2>
              <ol class="checklist__list">
                {(data as any).bookingChecklist.map((row: any) => (
                  <li class={`checklist__item checklist__item--${row.priority}`}>
                    <span class="checklist__priority">{row.priority}</span>
                    <span class="checklist__text">{row.item}</span>
                    {row.windowWeeksAhead && (
                      <span class="checklist__window">{row.windowWeeksAhead} weeks ahead</span>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )}

          {/* ─── 10. FAQ ─────────────────────────────────────────────── */}
          {showFaq && (
            <section class="faq">
              <h2 class="faq__heading">Common questions</h2>
              <dl class="faq__list">
                {(data as any).faq.map((entry: any) => (
                  <div class="faq__item">
                    <dt class="faq__question">{entry.question}</dt>
                    <dd class="faq__answer">{entry.answer}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
        </div>

        {/* ─── 2. At-a-glance facts box ────────────────────────────── */}
        <aside class="facts">
          <p class="facts__title">At a glance</p>
          <dl>
            <dt>Duration</dt>
            <dd>{durationText}</dd>

            <dt>Best for</dt>
            <dd>{audienceText}{occasionText ? ` · ${occasionText}` : ''}</dd>

            {themeText && (
              <>
                <dt>Theme</dt>
                <dd>{themeText}</dd>
              </>
            )}

            {anchorTown && (
              <>
                <dt>Base town</dt>
                <dd>{(anchorTown as any).data.name}</dd>
              </>
            )}

            <dt>Best season</dt>
            <dd>{seasonText}</dd>

            {(data as any).walkingIntensity && (
              <>
                <dt>Walking</dt>
                <dd>{titleize((data as any).walkingIntensity)}</dd>
              </>
            )}

            {(data as any).drivingDistanceKm && (
              <>
                <dt>Driving</dt>
                <dd>{(data as any).drivingDistanceKm} km on-Peninsula</dd>
              </>
            )}

            {!(data as any).drivingDistanceKm && data!.totalDriveMinutes && (
              <>
                <dt>Driving</dt>
                <dd>{data!.totalDriveMinutes} min total</dd>
              </>
            )}

            {effectiveStay && effectiveStayHref && (
              <>
                <dt>Anchor stay</dt>
                <dd><a href={effectiveStayHref}>{(effectiveStay as any).data.name}</a></dd>
              </>
            )}

            {(data as any).budgetRangeAud && (
              <>
                <dt>Budget</dt>
                <dd>{(data as any).budgetRangeAud}</dd>
              </>
            )}

            {!((data as any).budgetRangeAud) && budgetText && (
              <>
                <dt>Budget</dt>
                <dd>{budgetText}</dd>
              </>
            )}

            <dt>Stops</dt>
            <dd>{data!.stops.length} sequenced stops</dd>
          </dl>

          {effectiveStayHref ? (
            <a
              class="facts__cta"
              href={`${effectiveStayHref}?utm_source=peninsula-insider&utm_medium=escape&utm_campaign=${slug}&utm_content=facts`}
              data-event="escape_facts_anchor_stay_click"
              data-itinerary={slug}
            >
              Stay here →
            </a>
          ) : (
            <a class="facts__cta" href="/stay/">Choose the stay</a>
          )}

          {lastVerifiedLabel && (
            <p class="facts__verified">Last fact-verified {lastVerifiedLabel}</p>
          )}
        </aside>
      </div>
    </div>
  </section>

  {/* ─── 9b. Where to stay (anchor + alts) — also slot 3 of the 3-placement rule */}
  {(effectiveStay || stayRail.length > 0) && (
    <section class="venues">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Sleep here</p>
            <h2 class="venues__title">Stays that anchor this escape properly</h2>
          </div>
          <a href="/stay/" class="venues__link">All stays →</a>
        </div>
        <div class="venues__grid">
          {effectiveStay && <VenueCard venue={effectiveStay} hrefPrefix={venueHrefPrefix((effectiveStay as any).data.type)} />}
          {stayRail.map((venue: any) => (
            <VenueCard venue={venue} hrefPrefix={venueHrefPrefix(venue.data.type)} />
          ))}
        </div>
      </div>
    </section>
  )}

  {highlightedExperiences.length > 0 && (
    <section class="experience-index">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Move the trip outside</p>
            <h2 class="venues__title">Explore stops inside this plan</h2>
          </div>
          <a href="/explore/" class="venues__link">Explore →</a>
        </div>
        <div class="experience-grid">
          {highlightedExperiences.slice(0, 3).map((experience: any) => <ExperienceCard experience={experience} />)}
        </div>
      </div>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section class="venues venues--plain">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Further reading</p>
            <h2 class="venues__title">Journal pieces that sharpen this version of the Peninsula</h2>
          </div>
          <a href="/journal/" class="venues__link">Journal →</a>
        </div>
        <div class="venues__grid venues__grid--two">
          {relatedArticles.map((article: any) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  {/* ─── 11. Related itineraries ─────────────────────────────────── */}
  {relatedItineraries.length > 0 && (
    <section class="escape-callout">
      <div class="container">
        <div class="venues__header">
          <div>
            <p class="label label--accent">Try another shape</p>
            <h2 class="venues__title">More escape plans from the rebuild</h2>
          </div>
          <a href="/plans/" class="venues__link">All plans →</a>
        </div>
        <div class="itinerary-grid">
          {relatedItineraries.map((entry: any) => <ItineraryCard itinerary={entry} />)}
        </div>
      </div>
    </section>
  )}

  <NewsletterBlock />
</BaseLayout>
)}
