---
/**
 * /plans/ - the Decide front door (v5 hub redesign, page-redesigns-hubs.md
 * section 6, wireframes #plans). A decision engine, not a card wall: h1 and
 * one Local-voice line, seven single-select context chips, one featured plan
 * plus two alternates per context, the full catalogue as compact rows, and
 * a next-step band (Ask PI / blank My Trip).
 *
 * Default context (Weekend) is server-rendered so the page is complete with
 * JS disabled; other contexts swap in place from embedded JSON with the URL
 * persisted as ?context= (canonical stays /plans/, so parameterised views
 * never index). Plan detail pages are untouched; every plan URL is linked
 * from the index rows.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlanContextEngine from '../../components/v5/plans/PlanContextEngine.astro';
import PlanIndexRows from '../../components/v5/plans/PlanIndexRows.astro';
import PlanNextStep from '../../components/v5/plans/PlanNextStep.astro';
import { buildPlansModel } from '../../components/v5/plans/plans-data';

const model = await buildPlansModel();

const SITE_URL = 'https://peninsulainsider.com.au';
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Mornington Peninsula plans',
  numberOfItems: model.plans.length,
  itemListElement: [...model.plans]
    .sort((a, b) => a.title.localeCompare(b.title))
    .map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.title,
      url: `${SITE_URL}${p.href}`,
    })),
};

export const prerender = true;
---

<BaseLayout
  title="Mornington Peninsula Plans · Peninsula Insider"
  description="Ready-made Peninsula days and weekends. Pick the shape of the day, get one plan and two alternates, and make it your trip in one tap."
  section="explore"
  canonical="https://peninsulainsider.com.au/plans/"
  ogImage="/images/sourced/article-sunset-01.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <header class="plans-hero">
    <div class="container">
      <h1 class="plans-hero__title">Don't plan. Pick one of ours.</h1>
      <p class="plans-hero__standfirst">
        Tested routes, real drive times, no backtracking. Tell PI the shape of the day and the plan is already done.
      </p>
    </div>
  </header>

  <PlanContextEngine model={model} />

  <PlanIndexRows plans={model.plans} />

  <PlanNextStep />
</BaseLayout>

<style>
  .plans-hero {
    padding: var(--space-6, 2rem) 0 var(--space-3, 0.75rem);
  }
  .plans-hero__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display, var(--font-display));
    font-size: var(--fs-900, clamp(2.25rem, 1.7rem + 2.8vw, 3.5rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-display, 1.08);
    color: var(--text);
    max-width: 22ch;
  }
  .plans-hero__standfirst {
    margin: 0;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-400, 1.0625rem);
    line-height: var(--lh-ui, 1.5);
    color: var(--soft);
    max-width: 56ch;
  }
</style>
