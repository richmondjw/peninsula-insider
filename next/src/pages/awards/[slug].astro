---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

export function getStaticPaths() {
  return [
    ['restaurant-of-the-year', 'Restaurant of the Year'],
    ['cellar-door-of-the-year', 'Cellar Door of the Year'],
    ['stay-of-the-year', 'Stay of the Year'],
    ['walk-of-the-year', 'Walk of the Year'],
    ['best-new-opening', 'Best New Opening'],
    ['best-family-day', 'Best Family Day'],
    ['locals-choice', "Locals' Choice"],
    ['worth-the-drive', 'Worth-the-Drive Award'],
    ['editorial-discovery', 'Editorial Discovery'],
  ].map(([slug, title]) => ({ params: { slug }, props: { title } }));
}
const { title } = Astro.props;
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'The Awards', href: '/awards/' }, { label: title }];
export const prerender = true;
---

<BaseLayout title={`${title} · The Peninsula Insider Awards`} description={`Programme update for ${title} in the Peninsula Insider Awards.`} section="explore">
  <Breadcrumbs items={breadcrumbItems} />
  <main class="award-detail">
    <div class="container">
      <article class="award-detail__card">
        <p class="label label--accent">Peninsula Insider Award · Programme update</p>
        <h1>{title}</h1>
        <p class="award-detail__lead">No verified 2026 result is currently published for this category.</p>
        <p>The voting cycle is closed. We removed the incomplete nominee and results experience because it did not provide a reliable public record. We will not infer a winner or publish unsupported vote totals.</p>
        <p>The awards will return only with published rules, transparent selection evidence and a durable result record.</p>
        <div class="award-detail__actions">
          <a class="pi-btn pi-btn--solid" href="/awards/">Read the awards update</a>
          <a class="pi-btn pi-btn--text" href="/explore/">Browse current guides →</a>
        </div>
      </article>
    </div>
  </main>
  <NewsletterBlock />
</BaseLayout>

<style>
  .award-detail { padding: clamp(2rem, 5vw, 4.5rem) 0; }
  .award-detail__card { max-width: 48rem; border: 1px solid var(--border); border-top: 5px solid var(--accent); background: var(--paper, #fbf7f0); padding: clamp(1.35rem, 4vw, 2.75rem); }
  .award-detail h1 { font-family: var(--font-display); font-size: clamp(2.2rem, 7vw, 4.5rem); line-height: 0.98; margin: 0.65rem 0 1.25rem; }
  .award-detail p:not(.label) { font-family: var(--font-ui); font-size: 1rem; line-height: 1.65; color: var(--dark); max-width: 42rem; }
  .award-detail__lead { font-size: clamp(1.2rem, 3vw, 1.5rem) !important; color: var(--text) !important; }
  .award-detail__actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; margin-top: 1.5rem; }
  .award-detail__actions a { min-height: 44px; display: inline-flex; align-items: center; }
</style>
