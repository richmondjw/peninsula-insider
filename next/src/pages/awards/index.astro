---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/SectionHero.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'The Peninsula Insider Awards' }];
const guides = [
  { href: '/eat/', title: 'Eat', description: 'Restaurants, cafes and local food worth knowing.' },
  { href: '/wine/', title: 'Wine', description: 'Cellar doors, producers and Peninsula bottles.' },
  { href: '/stay/', title: 'Stay', description: 'Places to stay, chosen for the trip they make possible.' },
  { href: '/explore/', title: 'Explore', description: 'Walks, beaches, villages and plans for a day or weekend.' },
  { href: '/whats-on/', title: "What's On", description: 'Current events and timely reasons to visit.' },
];
export const prerender = true;
---

<BaseLayout title="The Peninsula Insider Awards" description="Current status of the Peninsula Insider Awards and links to verified editorial guides." section="explore" canonical="https://peninsulainsider.com.au/awards/">
  <Breadcrumbs items={breadcrumbItems} />
  <SectionHero eyebrow="The Peninsula Insider Awards" subEyebrow="Programme update" title="The awards are being <em>rebuilt</em>." dek="The 2026 voting cycle is closed. We have not published verified winners, so we have removed the incomplete results experience while we review the programme, its evidence and its rules." gradient="journal" visualLabel="Peninsula Insider · Awards" entitySlug="awards" />
  <main class="awards-page">
    <div class="container awards-layout">
      <section class="awards-update" aria-labelledby="awards-update-title">
        <p class="label label--accent">Status · 20 November 2026</p>
        <h2 id="awards-update-title">No 2026 result is currently published</h2>
        <p>Earlier versions of this page described an October results date, but the result pages did not provide a complete, verifiable record. That was not good enough. Voting and nominations are closed, and we will not name winners without evidence we can stand behind.</p>
        <p>Before the awards return, we will publish the eligibility rules, selection method, reader and editor weighting, conflicts policy, corrections process and a durable record of every result.</p>
        <div class="awards-actions">
          <a class="pi-btn pi-btn--solid" href="/about/#how-we-choose">How we choose our picks</a>
          <a class="pi-btn pi-btn--text" href="/contact/?type=correction">Report an awards issue →</a>
        </div>
      </section>
      <section class="awards-guides" aria-labelledby="awards-guides-title">
        <p class="label label--accent">Where to browse now</p>
        <h2 id="awards-guides-title">Current Peninsula guides</h2>
        <p class="awards-guides__intro">Use our live editorial sections while the awards programme is under review.</p>
        <ul class="awards-guides__list">
          {guides.map((guide) => <li><a href={guide.href}><span>{guide.title}</span><small>{guide.description}</small></a></li>)}
        </ul>
      </section>
    </div>
  </main>
  <NewsletterBlock />
</BaseLayout>

<style>
  .awards-page { padding: clamp(1.75rem, 4vw, 3.5rem) 0; }
  .awards-layout { display: grid; gap: clamp(2rem, 5vw, 4.5rem); }
  @media (min-width: 900px) { .awards-layout { grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr); align-items: start; } }
  .awards-update { border: 1px solid var(--border); border-top: 5px solid var(--accent); background: var(--paper, #fbf7f0); padding: clamp(1.35rem, 3vw, 2.25rem); }
  .awards-update h2, .awards-guides h2 { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.7rem); line-height: 1.05; margin: 0.55rem 0 1rem; }
  .awards-update > p:not(.label), .awards-guides__intro { font-family: var(--font-ui); font-size: 1rem; line-height: 1.65; color: var(--dark); max-width: 44rem; }
  .awards-actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; margin-top: 1.4rem; }
  .awards-actions a { min-height: 44px; display: inline-flex; align-items: center; }
  .awards-guides__list { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 0.65rem; }
  .awards-guides__list a { display: grid; gap: 0.2rem; min-height: 70px; padding: 0.85rem 1rem; border: 1px solid var(--border); color: var(--text); text-decoration: none; transition: border-color 160ms ease, background-color 160ms ease; }
  .awards-guides__list a:hover, .awards-guides__list a:focus-visible { border-color: var(--accent); background: var(--paper, #fbf7f0); }
  .awards-guides__list span { font-family: var(--font-display); font-size: 1.25rem; }
  .awards-guides__list small { font-family: var(--font-ui); font-size: 0.86rem; line-height: 1.45; color: var(--soft); }
</style>
