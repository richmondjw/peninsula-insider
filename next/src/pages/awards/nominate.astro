---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/SectionHero.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'The Awards', href: '/awards/' }, { label: 'Nominations' }];
export const prerender = true;
---

<BaseLayout title="Nominations closed · The Peninsula Insider Awards" description="The 2026 Peninsula Insider Awards nomination period is closed. No future cycle has been announced." section="explore">
  <Breadcrumbs items={breadcrumbItems} />
  <SectionHero eyebrow="The Peninsula Insider Awards" subEyebrow="Nominations closed" title="Submissions are <em>closed</em>." dek="The 2026 nomination and voting cycle has ended. We have not announced dates for another cycle." gradient="journal" visualLabel="Peninsula Insider · Awards nominations" entitySlug="awards-nominate" />
  <main class="nomination-status">
    <div class="container">
      <section class="nomination-status__card" aria-labelledby="nomination-status-title">
        <p class="label label--accent">Programme update · 20 November 2026</p>
        <h2 id="nomination-status-title">The form has been closed</h2>
        <p>We are reviewing the awards programme before accepting any more nominations. Future dates, categories and eligibility rules will be published here if a new cycle is approved.</p>
        <p>If you need to correct an existing Peninsula Insider listing, use our corrections form instead.</p>
        <div class="nomination-status__actions">
          <a class="pi-btn pi-btn--solid" href="/awards/">Read the awards update</a>
          <a class="pi-btn pi-btn--text" href="/contact/?type=correction">Submit a correction →</a>
        </div>
      </section>
    </div>
  </main>
  <NewsletterBlock />
</BaseLayout>

<style>
  .nomination-status { padding: clamp(2rem, 5vw, 4rem) 0; }
  .nomination-status__card { max-width: 46rem; border: 1px solid var(--border); border-top: 5px solid var(--accent); background: var(--paper, #fbf7f0); padding: clamp(1.35rem, 4vw, 2.5rem); }
  .nomination-status h2 { font-family: var(--font-display); font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.05; margin: 0.6rem 0 1rem; }
  .nomination-status p:not(.label) { font-family: var(--font-ui); font-size: 1rem; line-height: 1.65; color: var(--dark); max-width: 42rem; }
  .nomination-status__actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; margin-top: 1.5rem; }
  .nomination-status__actions a { min-height: 44px; display: inline-flex; align-items: center; }
</style>
