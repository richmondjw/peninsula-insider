---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { routeSlug } from '../../lib/editorial';

const allVenues = await getCollection('venues');
const stayTypes = ['hotel', 'villa', 'cottage', 'glamping', 'farm-stay', 'spa'];

// Romantic / couples stays: anniversary, romance, slow mood tags + audience: couples
const romanticSlugs = [
  'jackalope',
  'polperro-villas',
  'sanctuary-at-alba',
  'crittenden-villas',
  'cassis',
  'villa-mallorca',
  'the-continental-sorrento',
  'lindenderry',
  'peninsula-hot-springs-glamping',
  'hotel-sorrento',
];

const venues = romanticSlugs
  .map((s) => allVenues.find((v) => routeSlug(v) === s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v) && stayTypes.includes(v.data.type));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Stay', href: '/stay/' },
  { label: 'Couples Retreats' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Couples Retreats Mornington Peninsula',
  description: 'Romantic accommodation and couples retreats on the Mornington Peninsula — vineyard villas, thermal-anchored suites, and heritage hotels for anniversaries, honeymoons, and weekends for two.',
  url: 'https://peninsulainsider.com.au/stay/couples-retreats/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Stay', item: 'https://peninsulainsider.com.au/stay/' },
      { '@type': 'ListItem', position: 3, name: 'Couples Retreats', item: 'https://peninsulainsider.com.au/stay/couples-retreats/' },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: venues.length,
    itemListElement: venues.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: v.data.name,
      url: `https://peninsulainsider.com.au/stay/${routeSlug(v)}/`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the most romantic place to stay on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Jackalope Hotel (Red Hill) is the most dramatic option — a design-hotel set inside a working vineyard with a one-hat dining room. Polperro Villas and Crittenden Estate Villas offer privacy over spectacle: self-contained estate villas with vineyard views and no shared corridors. Sanctuary at Alba (opened June 2025) is the Peninsula\'s first thermal-anchored villa stay — private plunge pools with geothermal water and full access to Alba Thermal Springs. Cassis Red Hill delivers the same private-pool logic in the Red Hill corridor. Villa Mallorca in Mt Martha is the most intimate: two suites, host-led, with a Majorcan finca feel.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where should I take my partner for a weekend on the Mornington Peninsula?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Two nights at a Red Hill vineyard stay (Jackalope, Polperro Villas, or Lindenderry) is the classic Peninsula couple\'s weekend — cellar door afternoon, long vineyard lunch, thermal springs on the second morning. For a thermal-focused version: Sanctuary at Alba or Peninsula Hot Springs Glamping gives the most immersive bathing experience. For coast: base in Sorrento, swim at the back beach, and book dinner at Hotel Sorrento. Match the stay to the weekend shape you want rather than picking a property and working backwards.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the best Peninsula stay for an anniversary?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For a significant anniversary, Jackalope is the answer — it was built to feel like an occasion. Book Doot Doot Doot (one hat) for dinner. For a more personal anniversary, Sanctuary at Alba — private plunge pool, thermal springs access, the quieter Fingal end of the Peninsula — has a warmer quality. Villa Mallorca in Mt Martha works for couples who want an intimate host-led stay over a hotel experience.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do Mornington Peninsula stays include hot tubs or private pools?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Several do. Cassis Red Hill has five villas each with a private heated mineral pool. Sanctuary at Alba villas all include private heated plunge pools with geothermal water. Jackalope Hotel rooms are known for oversized freestanding baths. Peninsula Hot Springs Glamping gives overnight guests access to private thermal bathing sessions. Check individual properties for specifics — bath and pool details vary by room type.',
      },
    },
  ],
};
---

<BaseLayout
  title="Couples Retreats Mornington Peninsula · Peninsula Insider"
  description="Romantic accommodation and couples retreats on the Mornington Peninsula — vineyard villas, thermal-anchored suites, boutique hotels, and coastal stays for anniversaries and weekends away."
  section="stay"
  canonical="https://peninsulainsider.com.au/stay/couples-retreats/"
  modifiedTime="2026-05-08"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <h1 class="article__title">Couples Retreats on the Mornington Peninsula</h1>
      <div class="prose">
        <p>The Peninsula doesn't try to be a resort destination. The best couples' stays here work because they remove planning pressure — the cellar door is next to the bedroom, the vineyard restaurant is downstairs, the thermal springs are thirty seconds away, and the itinerary largely arranges itself once you're in the right place.</p>
        <p>Jackalope is the cinematic choice: a design hotel that operates at an event register, best when the trip needs to feel like an occasion. Polperro and Crittenden Estate Villas are more private — self-contained on working estates, with vineyard views and no shared corridors to navigate. Sanctuary at Alba opened June 2025 as the Peninsula's first thermal-anchored villa stay: private plunge pools on the Fingal precinct, full access to Alba Thermal Springs, quietly removed from the main tourist circuit. Cassis Red Hill delivers the same private-pool logic in the Red Hill corridor. Villa Mallorca in Mt Martha is the most intimate option — two suites, a Majorcan finca feel, and hosts who have been running couples' weekends for long enough to have built something with genuine character.</p>
        <p>Lindenderry runs at a slightly warmer frequency: a boutique hotel on a small vineyard that works for couples who want a room with character rather than spectacle. For coast-focused weekends, Hotel Sorrento and The Continental are the main-street village hotel options — walkable dining, bay access, and a proper sense of arrival.</p>
        <p class="venues__sub" style="font-size:0.8rem;color:var(--soft)">Last fact-verified: 8 May 2026</p>
      </div>
    </div>
  </article>

  <section class="venues" id="couples-stays">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Romantic stays</p>
          <h2 class="venues__title">{venues.length} Peninsula stays for couples</h2>
          <p class="venues__sub">From vineyard estate villas to thermal-anchored suites and coastal heritage hotels — ordered by privacy and self-contained depth.</p>
        </div>
        <a href="/stay/" class="venues__link">All stays →</a>
      </div>
      <div class="venues__grid">
        {venues.map((venue) => <VenueCard venue={venue} hrefPrefix="/stay" />)}
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="prose">
        <h2>Frequently asked questions</h2>
        <h3>Most romantic place to stay?</h3>
        <p>Jackalope (Red Hill) for dramatic design and on-site dining. Polperro Villas for private estate-villa seclusion. Sanctuary at Alba for thermal-anchored intimacy — private plunge pool, Alba Thermal Springs access, and the quieter Fingal end of the Peninsula.</p>
        <h3>Best for an anniversary?</h3>
        <p>Jackalope if the trip needs to feel like an event — book Doot Doot Doot well ahead. Sanctuary at Alba for something warmer and more personal. Villa Mallorca for an intimate host-led stay where the hosts are genuinely part of the experience.</p>
        <h3>Properties with private pools or baths?</h3>
        <p>Cassis Red Hill — each of five villas has a private heated mineral pool. Sanctuary at Alba — each villa has a private heated plunge pool with geothermal water. Jackalope rooms feature oversized freestanding baths. Peninsula Hot Springs Glamping includes private thermal bathing access for overnight guests.</p>
      </div>
    </div>
  </section>

  <section class="venues venues--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Related guides</p>
          <h2 class="venues__title">Complete the couples' weekend</h2>
        </div>
      </div>
      <div class="venues__grid venues__grid--links">
        <div class="venue-card"><h3 class="venue-card__name"><a href="/eat/date-night/">Date Night Restaurants</a></h3><p class="venue-card__signature">The intimate hatted rooms and vineyard settings best suited to a couple's dinner.</p><a href="/eat/date-night/" class="venue-card__cta">See the list →</a></div>
        <div class="venue-card"><h3 class="venue-card__name"><a href="/stay/hot-springs-accommodation/">Hot Springs Accommodation</a></h3><p class="venue-card__signature">Sleep inside the thermal precinct — PHS glamping, eco lodges, and Sanctuary at Alba.</p><a href="/stay/hot-springs-accommodation/" class="venue-card__cta">See the guide →</a></div>
        <div class="venue-card"><h3 class="venue-card__name"><a href="/stay/vineyard-stays/">Vineyard Stays</a></h3><p class="venue-card__signature">Estate accommodation on or near the Red Hill plateau wine ridge.</p><a href="/stay/vineyard-stays/" class="venue-card__cta">Explore →</a></div>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
