---
/**
 * /stay/ hub, v5 rebuild (T-503, page-redesigns-hubs.md section 3).
 *
 * Structure: stand-first -> party chips (CHIP_PRESETS.stay via FilterBar) ->
 * The Six -> best-of rail -> full directory (ALL stay venues, compact rows,
 * Book primary + Save secondary) -> From the Journal (3) -> FAQ (retained) ->
 * Ask band. Title/meta/canonical/schema unchanged from v4. No consolidation
 * or redirects in this wave.
 *
 * Shared hub modules (EAT agent, components/v5/hub/): HubStandfirst, TheSix,
 * DirectoryRows, JournalModule, AskBand. Item payloads follow the v5 Card
 * props API plus `facets` from getFacets('venue', data); the modules render
 * data-facets/data-title/data-sort-container/data-filter-empty themselves.
 *
 * ONE filter state governs The Six and the directory: the single FilterBar
 * below the stand-first renders #pi-results-status and the paired sheet;
 */
import { pageImage } from '../../lib/page-images';
import { getCollection } from 'astro:content';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/v5/Card.astro';
import CardGrid from '../../components/v5/CardGrid.astro';
import FilterBar from '../../components/v5/FilterBar.astro';
import SortControl from '../../components/v5/SortControl.astro';
import HubStandfirst from '../../components/v5/hub/HubStandfirst.astro';
import TheSix from '../../components/v5/hub/TheSix.astro';
import DirectoryRows from '../../components/v5/hub/DirectoryRows.astro';
import JournalModule from '../../components/v5/hub/JournalModule.astro';
import CategoryBrowse from '../../components/v5/hub/CategoryBrowse.astro';
import PlanningHelp from '../../components/v5/hub/PlanningHelp.astro';
import StayBaseComparison from '../../components/v5/hub/StayBaseComparison.astro';
import TrustNote from '../../components/v5/hub/TrustNote.astro';
import { getFacets, type FacetKey } from '../../lib/facets';
import { routeSlug, isStayVenue, typeLabel, titleize, isListableVenue } from '../../lib/editorial';
import { buildBreadcrumbSchema, absUrl } from '../../lib/schema';
import CorrectionNote from '../../components/CorrectionNote.astro';
import ProvenanceLine from '../../components/ProvenanceLine.astro';

// ── Data ─────────────────────────────────────────────────────────────────────
// Day spas (type 'spa') pass isStayVenue but aren't accommodation - they get
// their own detail pages (kept live for existing inbound links via
// venueHrefPrefix) but are excluded from the reader-facing Stay directory.
const venues = (await getCollection('venues')).filter((v) => isListableVenue(v) && isStayVenue(v) && v.data.type !== 'spa');
const stayCount = venues.length; // FULL corpus, every row server-rendered

const articlesAll = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));

const venueImages = new Map(await Promise.all(venues.map(async (venue) => {
  const slug = routeSlug(venue);
  const hero = await resolveHero('venue', slug, venue.data);
  const status = !hero.override ? venue.data.heroImage?.depictionStatus : undefined;
  return [slug, { src: hero.src, alt: hero.alt, caption: status === 'illustrative' ? 'Illustrative image' : status === 'unverified' ? 'Image subject unverified' : undefined }] as const;
})));

// ── Helpers ──────────────────────────────────────────────────────────────────
const iso = (d: unknown): string | undefined =>
  d instanceof Date ? d.toISOString().slice(0, 10) : typeof d === 'string' && d ? d : undefined;

const PARTNER_LABEL: Record<string, string> = {
  airbnb: 'Books via Airbnb',
  'booking.com': 'Books via Booking.com',
};

const PARTY_LABEL: Record<string, string> = {
  couples: 'Couples',
  family: 'Family',
  group: 'Group',
  solo: 'Solo',
  'dog-friendly': 'Dog-friendly',
};

type Facets = Partial<Record<FacetKey, string[]>>;

function partyFit(facets: Facets): string | undefined {
  const party = facets.party ?? [];
  if (party.includes('dog-friendly')) return 'Dog-friendly';
  for (const key of ['couples', 'family', 'group', 'solo']) {
    if (party.includes(key)) return PARTY_LABEL[key];
  }
  return undefined;
}

/** The page says the booking caveat once, in the area intro (James, 2 October
 *  2026). A row drops a generic trailing check sentence; a caveat specific to
 *  the property (a no-pets policy, say) is not a check sentence and stays. */
function withoutCaveats(line: string): string {
  const sentences = line.match(/[^.!?]+(?:[.!?]+|$)\s*/g) ?? [line];
  const kept = sentences.filter((s) => !/^\s*(Check|Confirm|Verify|Ask)\b/.test(s));
  return (kept.length ? kept : sentences).join('').trim();
}

/** Row verdict: reuse the entry's own short line only when it fits the
 *  25-word Critic budget; otherwise the row runs on meta alone. */
function rowVerdict(data: any): string | undefined {
  for (const candidate of [data.signature, data.whyWeGo]) {
    if (typeof candidate !== 'string' || !candidate.trim()) continue;
    if (candidate.trim().split(/\s+/).length <= 25) return withoutCaveats(candidate.trim());
  }
  return undefined;
}

function stayItem(v: any, overrides: { verdict?: string } = {}) {
  const data = v.data;
  const slug = v.id ?? data.slug;
  const facets = getFacets('venue', data);
  const bookingUrl: string | undefined = data.bookingUrl ?? data.website;
  const provider = typeof data.bookingProvider === 'string' ? data.bookingProvider : '';
  const partnerLabel = PARTNER_LABEL[provider] ?? (data.featuredPartner ? 'Sponsored placement' : undefined);
  return {
    title: data.name as string,
    href: `/stay/${slug}/`,
    entityType: 'venue' as const,
    entitySlug: slug as string,
    image: venueImages.get(slug),
    verdict: overrides.verdict ?? rowVerdict(data),
    meta: [
      typeLabel[data.type] ?? titleize(String(data.type ?? '')),
      titleize(String(data.place?.id ?? data.place ?? '')),
      partyFit(facets),
    ].filter(Boolean).slice(0, 3) as string[],
    booking: bookingUrl
      ? { url: bookingUrl, label: 'Check availability', venueName: data.name as string, partnerLabel }
      : undefined,
    surface: 'stay',
    facets,
  };
}

// ── The Six: hand-picked spread of corridor, party and price ────────────────
// Verdicts are Critic voice, <= 25 words, written here (editorial curation).
const SIX: { slug: string; verdict: string }[] = [
  { slug: 'jackalope', verdict: 'A Merricks North vineyard hotel for a special-occasion night, with dinner at Doot Doot Doot.' },
  { slug: 'polperro-villas', verdict: 'Four vineyard villas, each sleeping two with a king-size bed, indoor spa and open fireplace.' },
  { slug: 'hotel-sorrento', verdict: 'A coastal hotel above a limestone pub, for a weekend centred on Sorrento.' },
  { slug: 'flinders-hotel', verdict: 'A village hotel for a Flinders base, with the southern coast as a separate outing.' },
  { slug: 'peninsula-hot-springs-glamping', verdict: 'Stay at the hot springs when bathing is the centre of the escape.' },
  { slug: 'blue-moon-cottages', verdict: 'Cottage accommodation in Rye for a bay-side base. Ask about the cottage’s current dog policy.' },
];

const bySlug = new Map(venues.map((v) => [(v.id ?? v.data.slug) as string, v]));
const sixItems = SIX
  .map(({ slug, verdict }) => {
    const v = bySlug.get(slug);
    return v ? stayItem(v, { verdict }) : null;
  })
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

// ── Directory ───────────────────────────────────────────────────────────────
// The three picks on screen in The Six are not listed again (James, 2 October
// 2026). The list holds the three disclosed picks, then every other stay in
// town/name order, and its heading counts exactly what it lists. The one
// filter state still searches The Six and the list together.
const SIX_ON_SCREEN = 3;
const sixSlugs = new Set(SIX.map((s) => s.slug));
const disclosedSix = SIX.slice(SIX_ON_SCREEN).map(({ slug }) => bySlug.get(slug)).filter(Boolean);
const restVenues = venues
  .filter((v) => !sixSlugs.has((v.id ?? v.data.slug) as string))
  .sort((a, b) => {
    const townA = String(a.data.place?.id ?? a.data.place ?? '');
    const townB = String(b.data.place?.id ?? b.data.place ?? '');
    return townA.localeCompare(townB) || String(a.data.name).localeCompare(String(b.data.name));
  });
// A disclosed pick keeps its shortlist line in its row (one line per venue).
const sixVerdictBySlug = new Map(SIX.map(({ slug, verdict }) => [slug, verdict]));
const directoryItems = [...disclosedSix, ...restVenues].map((v) =>
  stayItem(v, { verdict: sixVerdictBySlug.get((v!.id ?? v!.data.slug) as string) }),
);

// The directory's header action opens the map on the stays alone. The ranked
// list it used to link to is already the first best-of card above, and the
// category values are read from the stays themselves so none drop off the map.
const stayCats = [...new Set(directoryItems.flatMap((item) => item.facets.cat ?? []))].sort();
const STAY_MAP_HREF = stayCats.length ? `/map/?cat=${stayCats.join(',')}` : '/map/';

// ── Best-of rail (guide cards to existing /stay/ list pages) ────────────────
const bestOfGuides = [
  { group: 'kind', slug: 'best-accommodation', title: 'The best places to stay', verdict: 'Coast, wine country or the thermal springs: the strongest base in each, side by side.' },
  { group: 'kind', slug: 'boutique-hotels', title: 'Boutique hotels', verdict: 'A village hotel, a vineyard estate and a stay built around its design.' },
  { group: 'kind', slug: 'cottages', title: 'Cottages and B&Bs', verdict: 'A self-contained cottage for privacy, or a hosted room or suite.' },
  { group: 'who', slug: 'couples-retreats', title: 'Couples’ retreats', verdict: 'Weekends for two among the vines, at the springs or in Sorrento.' },
  { group: 'kind', slug: 'vineyard-stays', title: 'Vineyard stays', verdict: 'Estate suites and villas, plus a wine-country base nearby.' },
  { group: 'place', slug: 'coastal-stays', title: 'Coastal stays', verdict: 'Bay villages, south-coast bases and a night inside Point Nepean.' },
  { group: 'kind', slug: 'hot-springs-accommodation', title: 'Hot springs stays', verdict: 'Rooms on the thermal estates themselves.' },
  { group: 'kind', slug: 'wellness-retreats', title: 'Wellness stays', verdict: 'On-site bathing, a hotel spa, or a springs package you drive to.' },
  { group: 'who', slug: 'resorts', title: 'Resorts and retreats', verdict: 'Resort rooms, thermal stays and venues for a group retreat.' },
  { group: 'place', slug: 'sorrento', title: 'Stay in Sorrento', verdict: 'Adults-only rooms, or a family-friendly stay in the village precinct.' },
  { group: 'place', slug: 'red-hill', title: 'Stay in Red Hill', verdict: 'Red Hill estates and private bases, placed where they actually are.' },
  { group: 'who', slug: 'dog-friendly', href: '/journal/dog-friendly-accommodation-mornington-peninsula/', title: 'Dog-friendly stays', verdict: 'Stays where the dog is a guest, not a problem.' },
];
const GUIDE_GROUPS = [
  { key: 'place', label: 'By place' },
  { key: 'who', label: 'By who is coming' },
  { key: 'kind', label: 'By kind of stay' },
] as const;

// ── From the Journal (3 stay stories, each with its own photograph) ─────────
// 'where-to-stay-for-a-two-night-escape' borrowed the vineyard villa story's
// cover, so the page's duplicate-image guard drew the brand plate on the
// villa card. Stay and Soak takes its place with a cover of its own.
const journalSlugs = [
  'the-one-night-escape',
  'the-vineyard-villa-weekend',
  'mornington-peninsula-stay-and-soak',
];
const journalItems = journalSlugs
  .map((slug) => articlesAll.find((a) => routeSlug(a) === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .slice(0, 3)
  .map((a) => ({
    title: a.data.title as string,
    href: a.data.section === 'plans'
      ? `/explore/plans/${routeSlug(a)}/`
      : `/journal/${routeSlug(a)}/`,
    entitySlug: routeSlug(a) as string,
    image: a.data.heroImage?.src
      ? { src: a.data.heroImage.src as string, alt: (a.data.heroImage.alt ?? a.data.title) as string }
      : undefined,
    verdict: a.data.dek as string | undefined,
    readTime: a.data.readingTimeMinutes ? `${a.data.readingTimeMinutes} min read` : undefined,
    dateISO: iso(a.data.publishedAt),
  }));

// ── Stand-first (<= 80 words, carries the where-to-stay + corridor phrases) ─
const standfirst =
  'Ridge and hinterland, or a coastal village. ' +
  'Compare the atmosphere, evenings and transport tradeoffs below, then find a hotel, vineyard villa or cottage that fits your party.';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Stay' },
];
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: absUrl('/') },
  { name: 'Stay', url: absUrl('/stay/') },
]);

// FAQ schema retained verbatim from v4 (title/meta/schema unchanged).
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Where is the best area to stay on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Red Hill and Main Ridge suit cellar-door weekends. Check distances and transport between your accommodation and each winery. Sorrento for coastal village atmosphere and ocean beach access. Mornington town for the most accessible base from Melbourne (60 minutes). The right answer depends on the weekend you want, wine country, beach village, or practical proximity.' } },
    { '@type': 'Question', name: 'When is it hardest to book a stay on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'Summer and the long weekends fill first, so book those early. Autumn midweek is the easiest time to find a room. For a cellar-door weekend, a villa or cottage on the ridge keeps the drives short; Rosebud, Dromana and Rye offer more choice but sit further from the cellar doors.' } },
    { '@type': 'Question', name: 'Is one night enough on the Mornington Peninsula?',
      acceptedAnswer: { '@type': 'Answer', text: 'One night works for a focused escape: arrive Friday evening, spend Saturday on the ridge and return home that evening. Two nights is better: it allows a beach day, a second area to explore, and the slower pace the Peninsula rewards. Base in Mornington or Sorrento for single-night trips.' } },
  ],
};
// Visible questions: the section already names the place, so the page
// drops the repeated "on the Mornington Peninsula". The schema keeps the
// full questions above for search.
const FAQ_LABELS = [
  'Where is the best area to stay?',
  'When is it hardest to book a stay?',
  'Is one night enough?',
];
export const prerender = true;
---

<BaseLayout
  title="Where to Stay on the Mornington Peninsula · Peninsula Insider"
  description="Choose where to stay on the Mornington Peninsula: compare coastal towns and wine-country bases, then explore hotels, vineyard villas, cottages and farm stays."
  section="stay"
  canonical="https://peninsulainsider.com.au/stay"
  modifiedTime="2026-04-30"
  ogImage={pageImage('stay-hub').src}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={breadcrumbItems} />

  <!-- 1. Stand-first: h1 retained, intro + CompareBlock compressed to <= 80
       words. The compact band contains its controls (jump links and the one
       FilterBar), so its bottom edge sits below them. The planning help is
       a note under the full list. -->
  <HubStandfirst
    compact
    aside={{
      src: '/images/visit-victoria/vv-25061217-lancemore-lindenderry-red-hill.webp',
      alt: 'Guests on the lawn at Lindenderry in Red Hill at dusk, under festoon lights, with the white homestead behind',
      caption: 'Lindenderry, Red Hill.',
      credit: 'Peter Foster, courtesy of Visit Victoria',
    }}
    title="Choose the base, and the whole weekend changes"
    standfirst={standfirst}
  >
    <CategoryBrowse directory="stay-directory" noun="stays" contained={false}>
      <FilterBar
        surface="stay"
        noun="stays"
        label="Filter stays"
        facets={['place', 'cat', 'price', 'party']}
      />
    </CategoryBrowse>
  </HubStandfirst>

  <div data-category-editorial>
  <StayBaseComparison />

  <!-- 2. The Six. The eyebrow names the shortlist; the old sub explained
       check dates the cards no longer show, so it is gone. -->
  <TheSix
    eyebrow="The stay shortlist"
    heading="Stays worth building a weekend around"
    surface="stay"
    items={sixItems}
  />

  <!-- 4. Best-of rail -->
  <section class="v5-bestof pi-section" aria-labelledby="bestof-heading">
    <div class="container">
      <div class="pi-section-head">
        <div class="pi-section-head__text">
          <p class="pi-eyebrow">Best-of guides</p>
          <h2 id="bestof-heading" class="pi-h2">Choose a stay guide</h2>
        </div>
      </div>
      {/* "Best-of guides" is stated once, in the section eyebrow. The cards
          drop their GUIDE stamp. They are text-only by design, so no media
          fallback either: a plate on all three would be noise, not repair. */}
      {GUIDE_GROUPS.map((group) => (
        <div class="v5-bestof__group">
          <h3 class="v5-bestof__subhead">{group.label}</h3>
          <CardGrid label={`Stay guides: ${group.label.toLowerCase()}`} layout="grid" maxCols={3}>
            {bestOfGuides.filter((guide) => guide.group === group.key).map((guide, i) => (
              <Card
                variant="guide"
                title={guide.title}
                href={'href' in guide ? guide.href : `/stay/${guide.slug}/`}
                entityType="page"
                entitySlug={`stay-${guide.slug}`}
                showEyebrow={false}
                verdict={guide.verdict}
                surface="stay"
                position={i + 1}
              />
            ))}
          </CardGrid>
        </div>
      ))}
    </div>
  </section>

  </div>

  <!-- Full directory; the single early FilterBar owns its state and count. -->
  <div class="container">
    <TrustNote surface="stay" />
  </div>
  <DirectoryRows
    id="stay-directory"
    eyebrow="The full list"
    heading="Everywhere else to stay"
    surface="stay"
    noun="stays"
    items={directoryItems}
    topLink={{ label: 'Open the map', href: STAY_MAP_HREF }}
  >
    <div slot="before-list" class="stay-list-tools">
      <SortControl />
      <ProvenanceLine records={venues} type="venues" noun="stay" class="stay-list-tools__checked" />
    </div>
    <div slot="after-list" class="stay-list-help">
      <PlanningHelp />
    </div>
  </DirectoryRows>

  <!-- 6. From the Journal (3) -->
  <JournalModule
    eyebrow="Further reading"
    heading="From the Journal"
    moreHref="/journal/"
    items={journalItems}
  />

  <!-- 7. FAQ: retained from v4, in-DOM, schema above -->
  <section class="hub-faq pi-section" aria-labelledby="stay-faq-heading">
    <div class="container">
      <div class="pi-section-head">
        <div class="pi-section-head__text">
          <p class="pi-eyebrow">Frequently asked</p>
          <h2 class="pi-h2" id="stay-faq-heading">Three honest answers before you book the bed</h2>
        </div>
      </div>
      <div class="hub-faq__list">
        {faqSchema.mainEntity.map((item, i) => (
          <details class="hub-faq__item">
            <summary class="hub-faq__q">{FAQ_LABELS[i] ?? item.name}</summary>
            <div class="hub-faq__a"><p>{item.acceptedAnswer.text}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Ask band hidden (bug fix in progress) -->
  <div class="container">
    <CorrectionNote surface="stay-hub" />
  </div>
</BaseLayout>

<style>
  .v5-bestof {
    background: var(--bg-alt, var(--bg));
  }
  .v5-bestof__group + .v5-bestof__group {
    margin-top: var(--space-7, 2.5rem);
  }
  .v5-bestof__subhead {
    margin: 0 0 var(--space-4, 1rem);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--soft, var(--text));
  }
  /* Phones: twelve guide links read as a list, not twelve framed cards
     (three screens of near-identical boxes). Title and one short line per
     row, hairline between rows, the whole row still the link. */
  @media (max-width: 47.99em) {
    .v5-bestof :global(.v5-card-grid) {
      row-gap: 0;
      column-gap: 0;
    }
    .v5-bestof :global(.pi-card--guide) {
      border: 0;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
      background: none;
      box-shadow: none;
    }
    .v5-bestof :global(.pi-card--guide .pi-card__body) {
      padding: var(--space-4, 1rem) 0;
      gap: var(--space-1, 0.25rem);
    }
    .v5-bestof :global(.pi-card--guide .pi-card__title) {
      font-size: var(--fs-400, 1.0625rem);
    }
    .v5-bestof :global(.pi-card--guide .pi-card__dek) {
      font-size: var(--fs-300, 0.9375rem);
      min-height: 0;
    }
  }
  /* Sort acts on the list, so it sits under the list heading it reorders. */
  .stay-list-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2, 0.5rem) var(--space-5, 1.5rem);
    margin-bottom: var(--space-4, 1rem);
  }
  .stay-list-tools :global(.stay-list-tools__checked) {
    margin: 0;
    font-size: var(--fs-200, 0.8125rem);
    color: var(--soft, var(--text));
  }
  /* The planning note closes the full list. */
  .stay-list-help {
    margin-top: var(--space-3, 0.75rem);
  }
</style>
