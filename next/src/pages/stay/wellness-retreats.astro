---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { routeSlug, isStayVenue, venueHref } from '../../lib/editorial';
import { buildFaqSchema } from '../../lib/schema';

const allVenues = await getCollection('venues');
const groups = [
  { id: 'stay-at-the-springs', label: 'On-site bathing', title: 'Stay at the springs',
    note: 'Choose these when bathing is the main reason to stay. Glamping and eco lodges are at Peninsula Hot Springs; The Sanctuary is at Alba. Both operators are in Fingal. Check the inclusions of your chosen accommodation package.',
    slugs: ['peninsula-hot-springs-glamping', 'peninsula-hot-springs-eco-lodges', 'sanctuary-at-alba'] },
  { id: 'hotel-and-spa', label: 'Hotel and treatments', title: 'Build the stay around a hotel spa',
    note: 'Jackalope in Merricks North pairs accommodation with its spa and restaurants. Arrange treatments separately and check what your room booking includes.',
    slugs: ['jackalope'] },
  { id: 'stay-and-bathe', label: 'External bathing package', title: 'Stay in Flinders, bathe in Fingal',
    note: 'The Stay and Bathe package at Quarters at Flinders Hotel combines accommodation with Peninsula Hot Springs Bath House entry. Bathing is off-site; arrange transport between Flinders and Fingal and check package availability and blackout dates.',
    slugs: ['flinders-hotel'] },
  { id: 'stay-nearby', label: 'A separate accommodation base', title: 'Stay on the wine ridge',
    note: 'Lindenderry at Red Hill is a base for a Peninsula break. Book your chosen spa or springs separately; inclusion here does not indicate an on-site treatment spa or a bathing package.',
    slugs: ['lindenderry'] },
].map(group => ({ ...group, venues: group.slugs.map(slug => {
  const venue = allVenues.find(v => routeSlug(v) === slug);
  if (!venue || !isStayVenue(venue)) throw new Error(`Wellness stay is missing or not accommodation: ${slug}`);
  return venue;
}) }));
const stays = groups.flatMap(group => group.venues);
const faqs = [
  { q: 'Can you stay at Peninsula Hot Springs?', a: 'Yes. Peninsula Hot Springs offers glamping and eco lodge accommodation in Fingal. They are different accommodation formats at the same operator. Check the room type, guest age policy and bathing inclusions before booking.' },
  { q: 'Where is Alba, and can you stay there?', a: 'Alba Thermal Springs & Spa is at 282 Browns Road, Fingal. Its accommodation, The Sanctuary, includes five standalone villas and two rooms. Book accommodation and any spa treatments through Alba.' },
  { q: 'Does Flinders Hotel have an on-site hot spring?', a: 'The Stay and Bathe package combines a stay at Quarters at Flinders Hotel with bathing at Peninsula Hot Springs in Fingal. These are separate locations, so you need to arrange travel between them.' },
  { q: 'Is a day-spa booking the same as a wellness retreat stay?', a: 'No. A day-spa booking is a treatment or bathing visit. An overnight stay includes accommodation; a facilitated retreat also needs a confirmed program and dates. Check each booking for what is included.' },
  { q: 'Can I plan a wellness stay without a car?', a: 'Plan transport before booking. Staying at the springs reduces travel during your visit, but you still need to get there and home. Check current operator transport options and arrange any taxis or transfers in advance.' },
];
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Wellness stays on the Mornington Peninsula',
  description: 'Accommodation at the springs, hotel spa stays, an external bathing package and a separate Red Hill base.',
  url: 'https://peninsulainsider.com.au/stay/wellness-retreats/',
  dateModified: '2026-09-07',
  mainEntity: {
    '@type': 'ItemList', itemListOrder: 'https://schema.org/ItemListUnordered', numberOfItems: stays.length,
    itemListElement: stays.map((venue, i) => ({ '@type': 'ListItem', position: i + 1, name: venue.data.name, url: new URL(venueHref(venue, '/stay'), 'https://peninsulainsider.com.au').href })),
  },
};
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Stay', href: '/stay/' }, { label: 'Wellness stays' }];
export const prerender = true;
---
<BaseLayout title="Wellness stays and retreats on the Mornington Peninsula · Peninsula Insider"
  description="Choose accommodation at the springs, a hotel spa stay or a verified Stay and Bathe package. Clear guidance on what is on-site and what needs a separate booking."
  section="stay" canonical="https://peninsulainsider.com.au/stay/wellness-retreats/" modifiedTime="2026-09-07">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(buildFaqSchema(faqs))} />
  <Breadcrumbs items={breadcrumbItems} />
  <article class="article"><div class="container"><h1 class="article__title">Wellness stays on the Mornington Peninsula</h1><div class="prose">
    <p>If the springs are the reason for your trip, stay in Fingal at Peninsula Hot Springs or Alba. If you want a hotel and restaurant weekend with a treatment added, start with Jackalope. Flinders Hotel offers a different arrangement: stay in the village and travel to Peninsula Hot Springs for bathing.</p>
    <p>These {stays.length} accommodation options are grouped by what the stay actually offers. A day spa is not accommodation, and a quiet hotel is not automatically a facilitated retreat.</p>
    <p><a href="/explore/spas-and-wellness/">Choosing a day spa instead? Read the spa guide →</a></p>
  </div></div></article>
  {groups.map(group => <section class="venues" id={group.id}><div class="container"><div class="venues__header"><div>
    <p class="label label--accent">{group.label}</p><h2 class="venues__title">{group.title}</h2><p class="venues__sub">{group.note}</p>
  </div></div><div class="venues__grid">{group.venues.map(venue => <VenueCard venue={venue} hrefPrefix="/stay" />)}</div>
  {group.id === 'stay-and-bathe' && <p class="prose"><a href="https://www.peninsulahotsprings.com/accommodation/stay-local/flinders-hotel-stay-and-bathe" target="_blank" rel="noopener noreferrer">Check the official Flinders Stay and Bathe package →</a></p>}
  </div></section>)}
  <section class="faq-section"><div class="container"><div class="prose"><h2>Frequently asked questions</h2>{faqs.map(faq => <><h3>{faq.q}</h3><p>{faq.a}</p></>)}</div></div></section>
  <section class="venues venues--plain"><div class="container"><div class="prose"><h2>Plan the rest of the stay</h2><ul>
    <li><a href="/explore/hot-springs/">Compare Peninsula Hot Springs and Alba</a></li>
    <li><a href="/stay/hot-springs-accommodation/">Accommodation inside the thermal precincts</a></li>
    <li><a href="/explore/plans/wellness-weekend/">The wellness weekend plan</a></li>
    <li><a href="/stay/best-accommodation/">The wider accommodation shortlist</a></li>
  </ul><h2>Sources and booking details</h2><p>Accommodation formats, locations and the Flinders partnership checked on 7 September 2026 against <a href="https://www.peninsulahotsprings.com/accommodation">Peninsula Hot Springs accommodation</a>, <a href="https://albathermalsprings.com.au/alba-experiences/the-sanctuary/">The Sanctuary at Alba</a> and the <a href="https://www.peninsulahotsprings.com/accommodation/stay-local/flinders-hotel-stay-and-bathe">official Flinders package</a>. Check current availability, age requirements and inclusions with the operator before booking.</p></div></div></section>
  <NewsletterBlock />
</BaseLayout>
