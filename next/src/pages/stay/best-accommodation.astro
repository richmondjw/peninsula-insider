---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { buildBreadcrumbSchema, absUrl } from '../../lib/schema';

const stayDecisions = [
  {
    label: 'A room-based stay',
    title: 'Hotels',
    description: 'Compare the town, room layout and included services.',
    href: '/stay/boutique-hotels/',
    action: 'Explore hotels',
  },
  {
    label: 'Room to settle in',
    title: 'Cottages',
    description: 'Choose the space you need, then check facilities and access.',
    href: '/stay/cottages/',
    action: 'Explore cottages',
  },
  {
    label: 'Food and wine',
    title: 'Vineyard stays',
    description: 'Plan food and wine visits from the exact stay address.',
    href: '/stay/vineyard-stays/',
    action: 'Explore vineyard stays',
  },
  {
    label: 'A coastal base',
    title: 'Coastal stays',
    description: 'Choose your village or beach base before comparing stays.',
    href: '/stay/coastal-stays/',
    action: 'Explore coastal stays',
  },
];

const thermalOptions = [
  {
    label: 'Peninsula Hot Springs',
    title: 'Eco Lodges',
    description: 'Rooms in shared lodges, separate from tented glamping.',
    href: '/stay/peninsula-hot-springs-eco-lodges/',
    source: 'https://www.peninsulahotsprings.com/accommodation/eco-lodges',
    image: '/images/visit-victoria/vv-172319-eco-lodges-peninsula-hot-springs.webp',
    imageAlt: 'A guest sits beside a bushland-view window in a Peninsula Hot Springs Eco Lodge room.',
    imageNote: 'Eco Lodge room. Photo courtesy of Visit Victoria.',
    illustrative: false,
  },
  {
    label: 'Peninsula Hot Springs',
    title: 'Glamping',
    description: 'Tented stays on site. Check bathing inclusions.',
    href: '/stay/peninsula-hot-springs-glamping/',
    source: 'https://www.peninsulahotsprings.com/accommodation/glamping',
    image: '/images/visit-victoria/vv-161940-peninsula-hot-springs.webp',
    imageAlt: 'A bather beside a hilltop pool at Peninsula Hot Springs, with farmland beyond.',
    imageNote: 'Illustrative: Peninsula Hot Springs bathing grounds, not a glamping tent. Photo courtesy of Visit Victoria.',
    illustrative: true,
  },
  {
    label: 'Alba Thermal Springs',
    title: 'The Sanctuary',
    description: 'Villas and rooms at Alba. Check stay type and bathing inclusions.',
    href: '/stay/sanctuary-at-alba/',
    source: 'https://albathermalsprings.com.au/alba-experiences/the-sanctuary/',
    image: '/images/visit-victoria/vv-172661-alba-thermal-springs-and-spa.webp',
    imageAlt: 'A bather in a pool beneath curved concrete canopies at Alba Thermal Springs.',
    imageNote: 'Illustrative: Alba bathing grounds, not Sanctuary accommodation. Photo courtesy of Visit Victoria.',
    illustrative: true,
  },
];

const faqs = [
  {
    question: 'Where should I stay on the Mornington Peninsula?',
    answer: 'Start with the main purpose of your trip: a coastal town, a wine-country base, or a stay centred on thermal bathing. Then check the exact address and journey to the places you plan to visit.',
  },
  {
    question: 'Are Peninsula Hot Springs Eco Lodges the same as glamping?',
    answer: 'No. Peninsula Hot Springs describes the Eco Lodges as private rooms in shared lodges and glamping as tented accommodation. Compare the current inclusions for the specific stay you choose.',
  },
  {
    question: 'What should I check before reserving?',
    answer: 'Confirm the current room or accommodation format, bathing and meal inclusions, guest conditions, accessibility and cancellation terms with the operator for your chosen dates.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Stay', href: '/stay/' },
  { label: 'Best Accommodation' },
];
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: absUrl('/') },
  { name: 'Stay', url: absUrl('/stay/') },
  { name: 'Best Accommodation', url: absUrl('/stay/best-accommodation/') },
]);
export const prerender = true;
---

<BaseLayout
  title="Best Accommodation Mornington Peninsula · Peninsula Insider"
  description="Choose where to stay on the Mornington Peninsula by accommodation format and trip purpose, with clear routes to hotels, cottages, coast, wine country and thermal stays."
  section="stay"
  canonical="https://peninsulainsider.com.au/stay/best-accommodation"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article">
    <div class="container">
      <p class="label label--accent">Find your base</p>
      <h1 class="article__title">The Best Places to Stay on the Mornington Peninsula</h1>
      <a href="/stay/" class="pi-btn pi-btn--solid">Browse all stays</a>
      <div class="prose">
        <p>Choose by format and location, then confirm the exact room, inclusions, guest conditions and travel time with the operator.</p>
      </div>
    </div>
  </article>

  <section class="venues venues--plain" aria-labelledby="choose-stay-title">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Choose your direction</p>
          <h2 class="venues__title" id="choose-stay-title">Start with the shape of your stay</h2>
          <p class="venues__sub">Four useful ways into the accommodation guide.</p>
        </div>
        <a href="/stay/" class="venues__link">All stays →</a>
      </div>
      <div class="venues__grid stay-decisions__grid">
        {stayDecisions.map((decision) => (
          <div class="pi-card">
            <div class="pi-card__body">
              <p class="label label--accent">{decision.label}</p>
              <h3 class="pi-card__title"><a href={decision.href}>{decision.title}</a></h3>
              <p class="pi-card__dek">{decision.description}</p>
              <div class="pi-card__actions">
                <a href={decision.href} class="pi-btn pi-btn--solid">{decision.action} →</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="venues thermal-stay" aria-labelledby="thermal-stay-title">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">A stay built around bathing</p>
          <h2 class="venues__title" id="thermal-stay-title">Three distinct thermal stays</h2>
          <p class="venues__sub">These operators describe different accommodation formats. Check the booking you choose for current inclusions and conditions.</p>
        </div>
      </div>
      <div class="venues__grid">
        {thermalOptions.map((option) => (
          <div class="pi-card">
            <a href={option.href} class="pi-card__media">
              <img src={option.image} alt={option.imageAlt} loading="lazy" decoding="async" />
            </a>
            <p class="thermal-card__image-note" data-pi-media-disclosure={option.illustrative ? 'illustrative' : undefined}>{option.imageNote}</p>
            <div class="pi-card__body">
              <p class="label label--accent">{option.label}</p>
              <h3 class="pi-card__title"><a href={option.href}>{option.title}</a></h3>
              <p class="pi-card__dek">{option.description}</p>
              <div class="pi-card__actions">
                <a href={option.href} class="pi-btn pi-btn--solid">Read stay notes →</a>
                <a href={option.source} class="pi-btn pi-btn--ghost" target="_blank" rel="noopener noreferrer">Operator details ↗</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="prose">
        <h2>How to choose where to stay</h2>
        {faqs.map(({ question, answer }) => (
          <><h3>{question}</h3><p>{answer}</p></>
        ))}
        <p><a href="/stay/">Browse all stays</a> when you are ready to compare individual properties.</p>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>

<style>
  .venues__grid.stay-decisions__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 768px) {
    .venues__grid.stay-decisions__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .thermal-stay .pi-card__dek {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
    min-height: 0;
  }

  .thermal-card__image-note {
    margin: 0;
    padding: 0.5rem 1rem 0;
    color: var(--ink-soft, #433d39);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
</style>