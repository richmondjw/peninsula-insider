---
import { eventPromotionEntries } from '../../lib/event-discovery.mjs';
import { schemaImage } from '../../lib/photo-set';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VenueDetailTemplate from '../../components/VenueDetailTemplate.astro';
import EventStrip from '../../components/EventStrip.astro';
import { routeSlug, isStayVenue, typeLabel, titleize, isUpcoming, placeLabel, isListableVenue } from '../../lib/editorial';
import { buildKnownForProperties, buildBreadcrumbSchema, absUrl } from '../../lib/schema';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';

export async function getStaticPaths() {
  const venues = await getCollection('venues');
  return venues
    .filter(isStayVenue)
    .map((venue) => ({
      params: { slug: routeSlug(venue) },
      props: { venue },
    }));
}

const { venue } = Astro.props;
const slug = routeSlug(venue);
const isPaused = venue.data.status === 'paused';

const allVenues = (await getCollection('venues')).filter(isListableVenue);
const relatedPlaceId = (entry: any) => String(entry.data.place?.id ?? entry.data.place ?? '');
const relatedRank = (entry: any) => {
  if (relatedPlaceId(entry) === relatedPlaceId(venue)) return 0;
  if (entry.data.zone && entry.data.zone === venue.data.zone) return 1;
  if (entry.data.type === venue.data.type) return 2;
  return 3;
};
const related = allVenues
  .filter((entry) => routeSlug(entry) !== slug)
  .filter((entry) => isStayVenue(entry) && entry.data.type !== 'spa')
  .sort((a, b) => relatedRank(a) - relatedRank(b) || a.data.name.localeCompare(b.data.name))
  .slice(0, 3);

// Cross-link articles that reference this venue
const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .filter((article) =>
    article.data.relatedVenues.some((entry) => String(entry.id ?? entry) === slug)
  )
  .slice(0, 3);

// Cross-link itineraries that include this venue as a stop
const itineraries = (await getCollection('itineraries'))
  .filter((itinerary) =>
    itinerary.data.stops.some((stop) => String(stop.venue?.id ?? stop.venue ?? '') === slug)
  )
  .slice(0, 2);

// Events at this venue, gated on a clean venue ref.
const venueEvents = eventPromotionEntries((await getCollection('events'))
  .sort((a, b) => (b.data.visitorAppealScore ?? 0) - (a.data.visitorAppealScore ?? 0)),
  {now: new Date(), venueId: slug, limit: 3});

const venuePlaceName = titleize(String(venue.data.place?.id ?? venue.data.place ?? ''));
const venueTypeLabel = typeLabel[venue.data.type] ?? titleize(venue.data.type);
const sigDesc = (venue.data.signature ?? '').trim();
const editorLead = (venue.data.editorNote ?? '').split(/\n\s*\n/)[0].replace(/\s+/g, ' ').trim();
const description = sigDesc.length >= 90 ? sigDesc : (editorLead || sigDesc).slice(0, 158);
const canonical = `https://peninsulainsider.com.au/stay/${slug}/`;
// Stay CMS uploads lack a complete rights-evidence slot. Use the reviewed source hero.
const hero = await resolveHero('venue', slug, venue.data, 'heroImage', { ignoreOverride: true });
const ogImage = hero.src;

// Mirrors the visible trail built in VenueDetailTemplate.astro exactly
// (Home > Stay > place > venue) so JSON-LD never disagrees with the UI.
const placeId = venue.data.place?.id ?? venue.data.place;
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: absUrl('/') },
  { name: 'Stay', url: absUrl('/stay/') },
  { name: placeLabel(venue.data.place), url: absUrl(`/explore/places/${placeId}/`) },
  { name: venue.data.name, url: canonical },
]);

const venueSchema = isPaused ? null : {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': `${canonical}#LodgingBusiness`,
  name: venue.data.name,
  description: venue.data.signature,
  ...schemaImage(venue.data),
  address: {
    '@type': 'PostalAddress',
    streetAddress: venue.data.address,
    addressRegion: 'VIC',
    addressCountry: 'AU',
  },
  ...(Number.isFinite(venue.data.coordinates?.lat) && Number.isFinite(venue.data.coordinates?.lng)
    ? { geo: {
        '@type': 'GeoCoordinates',
        latitude: venue.data.coordinates?.lat,
        longitude: venue.data.coordinates?.lng,
      } }
    : {}),
  ...(venue.data.website ? { url: venue.data.website } : {}),
  ...(venue.data.phone ? { telephone: venue.data.phone } : {}),
  ...(placeId
    ? {
        containedInPlace: {
          '@type': 'TouristDestination',
          '@id': `https://peninsulainsider.com.au/explore/places/${placeId}/#TouristDestination`,
          name: placeLabel(venue.data.place),
          url: `https://peninsulainsider.com.au/explore/places/${placeId}/`,
        },
      }
    : {}),
  ...buildKnownForProperties(venue.data.knownFor),
  // priceRange intentionally omitted (BRAND-PI 2026-05-15: no pricing on site).
};
export const prerender = true;
---

<BaseLayout
  title={`${venue.data.name}, ${venuePlaceName} · Peninsula Insider`}
  description={description}
  section="stay"
  canonical={canonical}
  ogImage={ogImage}
  searchImage={ogImage}
  noindex={venue.data.sitemapExclude === true || isPaused}
  searchExclude={isPaused}
>
  {venueSchema && <script type="application/ld+json" set:html={JSON.stringify(venueSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <VenueDetailTemplate venue={venue} section="stay" related={related} articles={articles} itineraries={itineraries} />

  <EventStrip
    events={venueEvents}
    eyebrow="On the calendar here"
    heading={`${venue.data.name} is also a real event venue`}
    intro={`Upcoming events at ${venue.data.name}, with editorial notes when we have them.`}
    moreHref="/whats-on/"
    moreLabel="All events"
    variant="alt"
  />
</BaseLayout>
