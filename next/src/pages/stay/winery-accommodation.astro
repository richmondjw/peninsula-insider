---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VenueCard from '../../components/VenueCard.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { routeSlug, isListableVenue } from '../../lib/editorial';
import ProvenanceLine from '../../components/ProvenanceLine.astro';

const allVenues = (await getCollection('venues')).filter(isListableVenue);
const slugs = [
  'polperro-villas',
  'crittenden-villas',
  'port-phillip-estate',
  'mantons-creek-estate',
  'cassis',
  'jackalope',
  'lindenderry',
];
const venues = slugs
  .map((slug) => allVenues.find((venue) => routeSlug(venue) === slug))
  .filter((venue): venue is NonNullable<typeof venue> => Boolean(venue));
// This guide does not repeat an unverified drive time or ranking from the shared record.
const displayVenues = venues.map((venue) => routeSlug(venue) === 'mantons-creek-estate'
  ? { ...venue, data: { ...venue.data, signature: 'Vineyard accommodation with an on-estate restaurant in Shoreham.' } }
  : venue);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Stay', href: '/stay/' },
  { label: 'Winery Accommodation' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Winery Accommodation Mornington Peninsula',
  description: 'Compare seven wine-country stays on the Mornington Peninsula by accommodation format and location.',
  url: 'https://peninsulainsider.com.au/stay/winery-accommodation/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { position: 1, name: 'Home', item: 'https://peninsulainsider.com.au/' },
      { position: 2, name: 'Stay', item: 'https://peninsulainsider.com.au/stay/' },
      { position: 3, name: 'Winery Accommodation', item: 'https://peninsulainsider.com.au/stay/winery-accommodation/' },
    ].map((item) => ({ '@type': 'ListItem', ...item })),
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListUnordered',
    numberOfItems: venues.length,
    itemListElement: venues.map((venue, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: venue.data.name,
      url: `https://peninsulainsider.com.au/${routeSlug(venue) === 'port-phillip-estate' ? 'wine' : 'stay'}/${routeSlug(venue)}/`,
    })),
  },
};
export const prerender = true;
---
<BaseLayout
  title="Winery Accommodation Mornington Peninsula · Peninsula Insider"
  description="Compare seven wine-country stays on the Mornington Peninsula: vineyard villas, winery suites and hotels, with clear routes to each venue."
  section="stay"
  canonical="https://peninsulainsider.com.au/stay/winery-accommodation/"
  modifiedTime="2026-10-01"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Breadcrumbs items={breadcrumbItems} />

  <section class="wine-hero" aria-labelledby="wine-hero-title">
    <div class="container wine-hero__inner">
      <div class="wine-hero__copy">
        <p class="label label--accent">Winery accommodation</p>
        <h1 id="wine-hero-title">Stay in wine country.</h1>
        <p class="wine-hero__lede">Choose an estate villa, winery suite or hotel base. Compare seven stays, then check the exact address and inclusions.</p>
        <div class="wine-hero__actions">
          <a href="#rankings" class="pi-btn pi-btn--solid">Compare seven stays ↓</a>
          <a href="#choose-your-base" class="wine-hero__quiet-link">Choose by format →</a>
        </div>
      </div>
      <div class="wine-hero__note" aria-label="How to choose a wine-country stay">
        <span class="wine-hero__note-label">A good first decision</span>
        <p>Pick the stay format first. Then look at the cellar doors and meals you can reach from its actual address.</p>
        <span class="wine-hero__note-rule" aria-hidden="true"></span>
        <p class="wine-hero__note-foot">If tasting is part of the plan, arrange a driver or transport before you go.</p>
      </div>
    </div>
  </section>

  <section class="wine-chooser" id="choose-your-base" aria-labelledby="wine-chooser-title">
    <div class="container">
      <div class="wine-chooser__heading">
        <p class="label label--accent">Choose your base</p>
        <h2 id="wine-chooser-title">Four ways to do a wine weekend</h2>
      </div>
      <div class="wine-chooser__grid">
        <div class="wine-chooser__option">
          <span class="wine-chooser__number">01 / Vineyard villas</span>
          <p>Stay among the vines, with the vineyard as part of the trip.</p>
          <div class="wine-chooser__links"><a href="/stay/polperro-villas/">Polperro Villas →</a><a href="/stay/crittenden-villas/">Crittenden Estate Villas →</a></div>
        </div>
        <div class="wine-chooser__option">
          <span class="wine-chooser__number">02 / Estate rooms</span>
          <p>Choose an estate room and build the stay around food and place.</p>
          <div class="wine-chooser__links"><a href="/wine/port-phillip-estate/">Port Phillip Estate →</a><a href="/stay/mantons-creek-estate/">Mantons Creek Estate →</a></div>
        </div>
        <div class="wine-chooser__option">
          <span class="wine-chooser__number">03 / Hotel base</span>
          <p>Keep hotel service close to the Peninsula's wine-country circuit.</p>
          <div class="wine-chooser__links"><a href="/stay/jackalope/">Jackalope →</a><a href="/stay/lindenderry/">Lindenderry →</a></div>
        </div>
        <div class="wine-chooser__option">
          <span class="wine-chooser__number">04 / Red Hill villa</span>
          <p>Cassis is a villa base near wineries, not an on-estate winery stay. Pool and outdoor-bath options differ by villa.</p>
          <div class="wine-chooser__links"><a href="/stay/cassis/">Cassis Red Hill →</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="venues" id="rankings">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Wine-country stays</p>
          <h2 class="venues__title">Compare the seven stays</h2>
          <p class="venues__sub">Look at the stay itself, then confirm current dining, tasting and room details with the operator.</p>
        </div>
        <a href="/wine/" class="venues__link">Wine country →</a>
      </div>
      <div class="venues__grid">
        {displayVenues.map((venue) => <VenueCard venue={venue} hrefPrefix="/stay" href={routeSlug(venue) === "port-phillip-estate" ? "/wine/port-phillip-estate/" : undefined} />)}
      </div>
      <ProvenanceLine style="font-size:0.8rem;color:var(--soft);display:block;margin-top:1rem" records={venues} type="venues" noun="venue" />
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="prose">
        <h2>Before you reserve</h2>
        <p>Check the exact room or villa format, current dining hours, minimum nights and tasting access for your dates. These can differ even within the same estate.</p>
        <p><strong>Plan the trip home from tastings.</strong> If you intend to drink, choose a driver or arrange transport in advance. A wine-country address alone does not make every cellar door walkable.</p>
      </div>
    </div>
  </section>

  <section class="venues venues--plain">
    <div class="container">
      <div class="venues__header"><div><p class="label label--accent">Related guides</p><h2 class="venues__title">Build around food and wine</h2></div></div>
      <div class="venues__grid venues__grid--links">
        <div class="pi-card"><div class="pi-card__body"><h3 class="pi-card__title"><a href="/wine/best-cellar-doors/">Best Cellar Doors</a></h3><p class="pi-card__dek">The cellar doors worth structuring a Peninsula day around.</p><div class="pi-card__actions"><a href="/wine/best-cellar-doors/" class="pi-btn pi-btn--solid">See the guide →</a></div></div></div>
        <div class="pi-card"><div class="pi-card__body"><h3 class="pi-card__title"><a href="/eat/cellar-door-lunch/">Cellar Door Lunch</a></h3><p class="pi-card__dek">The winery restaurants and long lunches that make the overnight stay worthwhile.</p><div class="pi-card__actions"><a href="/eat/cellar-door-lunch/" class="pi-btn pi-btn--solid">Read the list →</a></div></div></div>
        <div class="pi-card"><div class="pi-card__body"><h3 class="pi-card__title"><a href="/explore/places/red-hill/">Red Hill</a></h3><p class="pi-card__dek">The Peninsula's food-and-wine centre of gravity.</p><div class="pi-card__actions"><a href="/explore/places/red-hill/" class="pi-btn pi-btn--solid">Explore the town →</a></div></div></div>
      </div>
    </div>
  </section>

  <NewsletterBlock />
  <style>
    #rankings, #choose-your-base { scroll-margin-top: 9rem; }
    .wine-hero {
      background: radial-gradient(circle at 90% 15%, #f9f6ef 0, #f2efe9 58%, #ebe7df 100%);
      color: #0b2e4a;
      border-bottom: 1px solid rgba(11, 46, 74, .12);
    }
    .wine-hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(260px, .6fr);
      align-items: center;
      gap: clamp(28px, 6vw, 88px);
      padding-block: clamp(40px, 6vw, 86px);
    }
    .wine-hero__copy { min-width: 0; max-width: 770px; }
    .wine-hero__copy .label { margin: 0 0 16px; }
    .wine-hero h1 {
      max-width: 13ch;
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 5.3vw, 5.4rem);
      font-weight: 700;
      line-height: 1.02;
      letter-spacing: -.055em;
      text-wrap: balance;
    }
    .wine-hero__lede {
      max-width: 58ch;
      margin: clamp(18px, 2.5vw, 28px) 0 0;
      font-size: clamp(1rem, 1.4vw, 1.18rem);
      line-height: 1.56;
      color: #36566b;
    }
    .wine-hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 20px;
      margin-top: clamp(20px, 2.5vw, 30px);
    }
    .wine-hero__actions .pi-btn { min-height: 46px; display: inline-flex; align-items: center; }
    .wine-hero__quiet-link { color: #10527e; font-weight: 700; text-underline-offset: .25em; }
    .wine-hero__quiet-link:hover, .wine-hero__quiet-link:focus-visible { text-decoration: underline; }
    .wine-hero__note {
      padding: clamp(22px, 2.8vw, 34px);
      border: 1px solid rgba(11, 46, 74, .14);
      border-radius: 14px;
      background: rgba(255, 255, 255, .72);
      box-shadow: 0 20px 55px rgba(11, 46, 74, .06);
    }
    .wine-hero__note-label, .wine-chooser__number {
      display: block;
      color: #98672a;
      font-family: var(--font-ui);
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .12em;
      line-height: 1.3;
      text-transform: uppercase;
    }
    .wine-hero__note p { margin: 12px 0 0; font-size: clamp(1.05rem, 1.5vw, 1.3rem); font-weight: 600; line-height: 1.4; }
    .wine-hero__note-rule { display: block; width: 36px; height: 2px; margin-top: 24px; background: #d7a64e; }
    .wine-hero__note .wine-hero__note-foot { font-size: .91rem; font-weight: 500; color: #496172; line-height: 1.5; }
    .wine-chooser { padding-block: clamp(34px, 5vw, 70px); }
    .wine-chooser__heading { margin-bottom: clamp(20px, 3vw, 32px); }
    .wine-chooser__heading .label { margin: 0 0 8px; }
    .wine-chooser h2 { max-width: 22ch; margin: 0; font-family: var(--font-display); font-size: clamp(1.75rem, 3vw, 2.65rem); line-height: 1.12; letter-spacing: -.035em; }
    .wine-chooser__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; border: 1px solid rgba(11, 46, 74, .16); background: rgba(11, 46, 74, .16); border-radius: 12px; overflow: hidden; }
    .wine-chooser__option { display: flex; flex-direction: column; min-width: 0; padding: clamp(18px, 2.2vw, 28px); background: #fff; }
    .wine-chooser__option p { margin: 13px 0 20px; line-height: 1.5; color: #36566b; }
    .wine-chooser__links { display: flex; flex-direction: column; gap: 9px; margin-top: auto; }
    .wine-chooser__links a { width: fit-content; color: #10527e; font-weight: 700; text-underline-offset: .22em; }
    .wine-chooser__links a:hover, .wine-chooser__links a:focus-visible { text-decoration: underline; }
    @media (max-width: 960px) {
      .wine-chooser__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 700px) {
      #rankings, #choose-your-base { scroll-margin-top: 5rem; }
      .wine-hero__inner { display: block; padding-block: 30px 34px; }
      .wine-hero__copy .label { margin-bottom: 12px; }
      .wine-hero h1 { font-size: clamp(2.55rem, 10vw, 3.8rem); max-width: 12ch; }
      .wine-hero__lede { margin-top: 14px; font-size: 1rem; line-height: 1.48; }
      .wine-hero__actions { margin-top: 18px; }
      .wine-hero__note { margin-top: 30px; padding: 20px; }
      .wine-chooser__grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 360px) {
      .wine-hero__inner { padding-top: 22px; }
      .wine-hero h1 { font-size: 2.45rem; }
      .wine-hero__actions { gap: 12px; }
    }
  </style>
</BaseLayout>
