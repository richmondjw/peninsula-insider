---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Contact' },
];

const contactReasons = [
  {
    icon: '✉️',
    title: 'Story tips',
    body: 'Know something we should? A new opening, a closure, a chef move, a venue that deserves coverage. We read everything.',
    email: 'tips@peninsulainsider.com.au',
  },
  {
    icon: '📝',
    title: 'Corrections',
    body: 'If we\'ve got a phone number wrong, a price band out of date, or a detail that doesn\'t match reality  -  tell us. Accuracy is the whole point.',
    email: 'corrections@peninsulainsider.com.au',
  },
  {
    icon: '🤝',
    title: 'Editorial enquiries',
    body: 'For questions about our editorial process, partnership philosophy, or anything that doesn\'t fit the other boxes.',
    email: 'hello@peninsulainsider.com.au',
  },
];
export const prerender = true;
---

<BaseLayout
  title="Contact  -  Peninsula Insider"
  description="Get in touch with Peninsula Insider. Story tips, corrections, and editorial enquiries."
  section="home"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Contact"
    subEyebrow="Editorial"
    title="Tips, corrections, and things we should <em>know.</em>"
    dek="Peninsula Insider is built around thoughtful, accurate and genuinely useful editorial coverage of the Mornington Peninsula. If something has changed, opened, closed, or deserves attention, we'd love to hear about it."
    gradient="stay"
    image="/images/sourced/home-cover-sunset-bay-01.jpg"
    imageAlt="Sunset over a Mornington Peninsula bay with bathing boxes in the foreground"
    visualLabel="Peninsula Insider · contact"
  />

  <!-- Contact reasons -->
  <section class="contact-reasons">
    <div class="container">
      <div class="contact-reasons__grid">
        {contactReasons.map((reason) => (
          <article class="contact-card">
            <span class="contact-card__icon">{reason.icon}</span>
            <h3 class="contact-card__title">{reason.title}</h3>
            <p class="contact-card__body">{reason.body}</p>
            <a href={`mailto:${reason.email}`} class="contact-card__email">{reason.email}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Peninsula Days editorial section -->
  <section class="contact-editorial">
    <div class="container">
      <div class="contact-editorial__inner">
        <div class="contact-editorial__header">
          <span class="contact-editorial__icon">📷</span>
          <h2 class="contact-editorial__title">Peninsula Days</h2>
        </div>
        <p class="contact-editorial__lead">Thoughtful Peninsula days inspired by the people who explore them.</p>
        <div class="contact-editorial__body">
          <p>Planned a Peninsula day worth remembering?</p>
          <p>We'd love to hear how it unfolded — a favourite stop, a long lunch, an unexpected moment, a rainy-day detour, or a photo from the coast.</p>
          <p>Peninsula Insider may feature selected Peninsula Days within future editorial stories.</p>
        </div>
        <a href="mailto:stories@peninsulainsider.com.au" class="contact-card__email">stories@peninsulainsider.com.au</a>
      </div>
    </div>
  </section>

  <!-- The People Behind the Peninsula editorial section -->
  <section class="contact-editorial contact-editorial--people">
    <div class="container">
      <div class="contact-editorial__inner">
        <div class="contact-editorial__header">
          <h2 class="contact-editorial__title">The People Behind the Peninsula</h2>
        </div>
        <p class="contact-editorial__lead">Editorial conversations with the people shaping the character, atmosphere and experience of the Mornington Peninsula.</p>
        <div class="contact-editorial__body">
          <p>If there's a person, place or story you believe belongs within the series — or you'd like to introduce yourself thoughtfully — we'd love to hear from you.</p>
        </div>
        <a href="mailto:stories@peninsulainsider.com.au" class="contact-card__email">stories@peninsulainsider.com.au</a>
      </div>
    </div>
  </section>

  <!-- Venue submissions policy -->
  <section class="contact-policy">
    <div class="container">
      <div class="contact-policy__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">For venues</p>
          <h2 class="about-mission__title">How venue coverage works</h2>
        </div>
        <div class="about-mission__body prose">
          <p>If you operate a place, experience or venue on the Peninsula that you believe aligns with the Peninsula Insider approach, we're always open to thoughtful introductions. Editorial coverage is decided on merit, not on outreach volume.</p>
          <p>Send a note to <a href="mailto:tips@peninsulainsider.com.au">tips@peninsulainsider.com.au</a> with your venue name, location, and what you think makes it worth a visit. We'll add it to our list and visit when we can. No promises on timelines  -  the editorial calendar moves at its own pace.</p>
          <p>If your venue is already listed and something has changed  -  new chef, new hours, a renovation, a closure  -  please send corrections to <a href="mailto:corrections@peninsulainsider.com.au">corrections@peninsulainsider.com.au</a>. We take accuracy seriously and will update promptly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Response expectations -->
  <section class="contact-expectations">
    <div class="container">
      <div class="contact-expectations__inner">
        <p class="label label--accent">What to expect</p>
        <div class="contact-expectations__body">
          <p>We read every email, but we don't always reply  -  especially to tips. If your tip leads to coverage, you'll see it on the site. If a correction is valid, we'll fix it and you'll see the update.</p>
          <p>We're a small editorial operation built around thoughtful coverage of the Peninsula. We spend more time visiting places than talking about visiting them, often quietly and without much announcement.</p>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
