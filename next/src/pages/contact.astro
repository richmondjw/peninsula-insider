---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicIntakeForm from '../components/PublicIntakeForm.astro';
export const prerender=true;
const sections=[
 {id:'general',title:'Send us a note',copy:'For story ideas, local tips, general questions or anything else.'},
 {id:'correction',title:'Report a correction',copy:'Found something inaccurate or out of date? Tell us what needs fixing.'},
 {id:'accessibility',title:'Accessibility',copy:'Having trouble reading, navigating or using the site? Let us know so we can help.'},
] as const;
---
<BaseLayout title="Contact · Peninsula Insider" description="Send a note, report a correction, get accessibility help or find the right pathway for your business." canonical="https://peninsulainsider.com.au/contact/">
 <div class="contact-page container">
  <h1>Contact</h1>
  {sections.map(section=><details id={section.id} name="contact-reason" data-contact-reason={section.id}>
   <summary><h2>{section.title}</h2></summary>
   <div class="contact-panel"><p>{section.copy}</p><PublicIntakeForm kind={section.id}/></div>
  </details>)}
  <details id="business" name="contact-reason" data-contact-reason="business"><summary><h2>Business enquiries</h2></summary><div class="contact-panel"><p>For listing updates, adding a business, enhanced pages or partnerships.</p><a class="pi-btn pi-btn--solid" href="/partners/">For Peninsula Businesses</a></div></details>
 </div>
</BaseLayout>
<script>
function initContact(){
 const panels=Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-contact-reason]'));
 panels.forEach(panel=>{if(panel.dataset.bound)return;panel.dataset.bound='1';panel.addEventListener('toggle',()=>{if(panel.open)panels.filter(p=>p!==panel).forEach(p=>p.open=false);});});
 const type=new URLSearchParams(location.search).get('type')||location.hash.slice(1);
 const panel=panels.find(p=>p.dataset.contactReason===type);if(panel)panel.open=true;
}
initContact();document.addEventListener('astro:page-load',initContact);window.addEventListener('hashchange',initContact);
</script>
<style>
.contact-page{max-width:54rem;padding-block:clamp(3rem,6vw,5rem)}h1{font:500 clamp(2.8rem,6vw,4.5rem)/1.1 var(--font-display);margin:0 0 2.5rem}details{border-top:1px solid var(--border)}details:last-child{border-bottom:1px solid var(--border)}summary{cursor:pointer;padding:1.4rem 0;min-height:44px}summary h2{display:inline;font:500 1.6rem/1.3 var(--font-display);margin-left:.6rem}summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.contact-panel{padding:0 0 2rem}p{line-height:1.6;max-width:65ch}
</style>
