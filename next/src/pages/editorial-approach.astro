---
/**
 * /editorial-approach/ — Publication philosophy page.
 *
 * Simplified May 2026: evolved from manifesto-style operational document
 * toward a calm, editorial publication philosophy page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Editorial Approach' },
];

const principles = [
  {
    title: 'Editorial first',
    body: 'Recommendations are grounded in firsthand experience, editorial judgement and practical Peninsula planning value. Coverage decisions sit with the editorial desk.',
  },
  {
    title: 'We pay our own way',
    body: 'We pay for our own meals, our own rooms, our own visits. The moment a publication starts accepting undisclosed hospitality, the reader has to do the work of figuring out what\'s real.',
  },
  {
    title: 'Opinions, not scores',
    body: 'We write editor notes — a short, honest paragraph about what a place actually feels like. Clarity matters more than consensus.',
  },
  {
    title: 'Useful before complete',
    body: 'Every piece answers a real question a visitor to the Peninsula actually asks. The Peninsula doesn\'t need more content. It needs better answers.',
  },
];

const coverageRules = [
  {
    title: 'Editorial fit before commercial fit',
    body: 'A venue appears because we think readers should know about it. Coverage decisions sit with the editorial desk; they are not influenced by commercial relationships.',
  },
  {
    title: 'Visited before written',
    body: 'Every venue review reflects a real visit. Where a venue is added from public information alone, it is labelled as a listing, not an editorial review.',
  },
  {
    title: 'Local before national',
    body: 'We cover what is on the Peninsula, made by Peninsula operators, or otherwise rooted here. We are a regional publication that takes its region seriously.',
  },
  {
    title: 'Selective by design',
    body: 'We choose the places worth your Saturday, knowing that leaves some things out. We explain the reasoning where it matters.',
  },
];
---

<BaseLayout
  title="Editorial Approach · Peninsula Insider"
  description="The editorial philosophy behind Peninsula Insider — how we choose what to cover, how we verify, and how we handle commercial relationships."
  section="home"
  canonical="https://peninsulainsider.com.au/editorial-approach/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Editorial Approach"
    subEyebrow="A thoughtful editorial guide"
    title="A thoughtful editorial guide to the <em>Mornington Peninsula.</em>"
    dek="Peninsula Insider is built around thoughtful, accurate and genuinely useful editorial coverage of the Mornington Peninsula — written by people who live here, for readers who care about it."
    gradient="journal"
    heroImage="/images/sourced/home-cover-back-beach-horses-01.jpg"
    visualLabel="Peninsula Insider · the back beach"
  />

  <!-- Mission -->
  <section class="about-mission">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">The approach</p>
          <h2 class="about-mission__title">Editorial coverage the Peninsula deserves</h2>
        </div>
        <div class="about-mission__body prose">
          <p>The Mornington Peninsula has some of the most compelling food, wine, coastal, and natural experiences in Australia. It deserves coverage that takes it seriously — opinionated, service-first editorial that answers the questions visitors actually have.</p>
          <p>Every recommendation reflects a genuine visit and an honest editorial opinion. We write for readers planning a weekend, not for operators seeking coverage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="about-principles">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">Editorial standards</p>
          <h2 class="split-intro__title">How we approach editorial</h2>
        </div>
        <p class="split-intro__body">These are the principles that shape how we write, what we cover, and how we maintain editorial independence.</p>
      </div>
      <div class="about-principles__grid">
        {principles.map((principle) => (
          <article class="about-principle">
            <h3 class="about-principle__title">{principle.title}</h3>
            <p class="about-principle__body">{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage decisions -->
  <section class="about-principles">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">What we cover</p>
          <h2 class="split-intro__title">How coverage decisions are made</h2>
        </div>
        <p class="split-intro__body">The Peninsula offers more than any one publication can cover well. These principles shape what makes the editorial cut.</p>
      </div>
      <div class="about-principles__grid">
        {coverageRules.map((rule) => (
          <article class="about-principle">
            <h3 class="about-principle__title">{rule.title}</h3>
            <p class="about-principle__body">{rule.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Verification -->
  <section class="about-mission ea-verification">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Accuracy</p>
          <h2 class="about-mission__title">Kept current, not just published</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Listings and venue details are reviewed and updated regularly. Accuracy matters — an outdated guide sends readers to closed venues or wrong opening hours, which defeats the point entirely.</p>
          <p>Each venue page carries a "Last verified" date. If something is wrong or out of date, we want to know about it — corrections are acted on promptly. Write to <a href="mailto:corrections@peninsulainsider.com.au">corrections@peninsulainsider.com.au</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial transparency -->
  <section class="about-mission ea-commercial">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Commercial transparency</p>
          <h2 class="about-mission__title">How commercial relationships work</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider works with selected commercial partners across editorial features, guides and publication placements.</p>
          <p>Where content forms part of a commercial relationship, it is disclosed clearly and editorially separated from independent coverage.</p>
          <p>Some pages may also contain affiliate or referral links. Where this occurs, Peninsula Insider may earn a commission at no additional cost to the reader.</p>
          <p>Editorial judgement and publication recommendations remain independent.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Publication voice -->
  <section class="about-colophon">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">The publication</p>
          <h2 class="about-mission__title">Founded and edited on the Peninsula</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider is founded and edited on the Peninsula. The editorial direction and coverage sign-off sit with the editors. Peninsula Insider is built from the Peninsula, by people who live on the Peninsula, for readers who care about it.</p>
          <p>The publication runs without named bylines on most pieces. Coverage is signed off by the editor regardless of who drafted it, and the principles on this page apply consistently across every piece.</p>
          <p><em>The Insider</em> is the publication's editorial correspondence — curated Peninsula weekends, seasonal editions, openings and editorial recommendations, sent when they're worth sending. <a href="/newsletter/">Read more about The Insider.</a></p>
          <p>Questions about the editorial process? Write to <a href="mailto:hello@peninsulainsider.com.au">hello@peninsulainsider.com.au</a>.</p>
        </div>
      </div>
      <div class="about-masthead__credits">
        <dl>
          <div>
            <dt>Editors &amp; Publishers</dt>
            <dd>Peninsula Insider</dd>
          </div>
          <div>
            <dt>Contact</dt>
            <dd><a href="mailto:hello@peninsulainsider.com.au">hello@peninsulainsider.com.au</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Corrections -->
  <section class="about-mission ea-corrections">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Corrections</p>
          <h2 class="about-mission__title">Accuracy matters to us</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider is updated regularly and accuracy matters to us.</p>
          <p>If you spot something outdated or incorrect, please contact <a href="mailto:corrections@peninsulainsider.com.au">corrections@peninsulainsider.com.au</a></p>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock
    title="The Insider — editorial correspondence from Peninsula Insider."
    body="Curated Peninsula weekends, seasonal editions, openings and editorial recommendations — sent when they're worth sending."
  />
</BaseLayout>

<style>
  .ea-verification,
  .ea-commercial,
  .ea-corrections {
    background: var(--bg-alt);
  }
  .ea-corrections {
    border-top: 1px solid var(--border);
  }
</style>
