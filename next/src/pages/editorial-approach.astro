---
/**
 * /editorial-approach/ - Publication philosophy page.
 *
 * Simplified May 2026: evolved from manifesto-style operational document
 * toward a calm, editorial publication philosophy page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Editorial Approach' },
];

const principles = [
  {
    title: 'Thoughtful recommendations',
    body: 'Peninsula Insider is built around thoughtful, useful recommendations shaped by firsthand experience, editorial judgement and local context.',
  },
  {
    title: 'Independent editorial',
    body: 'Editorial recommendations are made on merit. What appears in Peninsula Insider reflects genuine local knowledge and firsthand experience — not commercial relationships.',
  },
  {
    title: 'Practical Peninsula planning',
    body: 'We focus on the places, experiences and details that genuinely help readers build a better Peninsula weekend - from long lunches to rainy-day alternatives.',
  },
  {
    title: 'Shaped by the Peninsula',
    body: 'Peninsula Insider is shaped by the Peninsula\'s seasons, rhythms, landscapes and the people who return to it regularly.',
  },
];

const coverageRules = [
  {
    title: 'Coverage is editorially led',
    body: 'A venue appears because we think readers should know about it — because it is good, relevant and worth a Saturday. Coverage reflects the Peninsula, not the inbox.',
  },
  {
    title: 'Grounded in firsthand experience',
    body: 'Recommendations are grounded in genuine visits, firsthand experience and editorial judgement. Where information is added from public listings or event submissions, it is clearly positioned as such.',
  },
  {
    title: 'Local before national',
    body: 'We cover what is on the Peninsula, made by Peninsula operators, or otherwise rooted here. We are a regional publication that takes its region seriously.',
  },
  {
    title: 'Selective by design',
    body: 'We choose the places worth your Saturday, knowing that leaves some things out. We explain the reasoning where it matters.',
  },
];
export const prerender = true;
---

<BaseLayout
  title="Editorial Approach · Peninsula Insider"
  description="The editorial philosophy behind Peninsula Insider - how we choose what to cover, how we verify, and how we handle commercial relationships."
  section="home"
  canonical="https://peninsulainsider.com.au/editorial-approach/"
>
  <Breadcrumbs items={breadcrumbItems} />

  <SectionHero
    eyebrow="Editorial Approach"
    subEyebrow="A thoughtful editorial guide"
    title="A thoughtful editorial guide to the <em>Mornington Peninsula.</em>"
    dek="Peninsula Insider is built around thoughtful, accurate and genuinely useful editorial coverage of the Mornington Peninsula - shaped by long weekends, local knowledge and firsthand experience of the region."
    gradient="journal"
    heroImage="/images/sourced/article-long-lunch-01.webp"
    visualLabel="Peninsula Insider · long lunch, the Peninsula"
  />

  <!-- Mission -->
  <section class="about-mission">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">The approach</p>
          <h2 class="about-mission__title">Editorial coverage the Peninsula deserves</h2>
        </div>
        <div class="about-mission__body prose">
          <p>The Mornington Peninsula has some of the most compelling food, wine, coastal, and natural experiences in Australia. It deserves coverage that takes it seriously - opinionated, service-first editorial that answers the questions visitors actually have.</p>
          <p>Recommendations are grounded in firsthand experience and honest editorial judgement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="about-principles">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">Editorial standards</p>
          <h2 class="split-intro__title">Our editorial approach</h2>
        </div>
      </div>
      <div class="about-principles__grid">
        {principles.map((principle) => (
          <article class="about-principle">
            <h3 class="about-principle__title">{principle.title}</h3>
            <p class="about-principle__body">{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage decisions -->
  <section class="about-principles">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">What we cover</p>
          <h2 class="split-intro__title">How coverage decisions are made</h2>
        </div>
      </div>
      <div class="about-principles__grid">
        {coverageRules.map((rule) => (
          <article class="about-principle">
            <h3 class="about-principle__title">{rule.title}</h3>
            <p class="about-principle__body">{rule.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Accuracy & Corrections -->
  <section class="about-mission ea-verification">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Accuracy</p>
          <h2 class="about-mission__title">Kept current, not just published</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Listings and venue details are reviewed and updated regularly. Accuracy matters — an outdated guide sends readers to closed venues or wrong opening hours, which defeats the point entirely.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial transparency (brief, reader-focused) -->
  <section class="about-mission ea-commercial">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">Commercial transparency</p>
          <h2 class="about-mission__title">Disclosed where relevant</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Where content forms part of a commercial relationship, it is disclosed clearly. Some pages may also contain affiliate or referral links, clearly identified, where Peninsula Insider may earn a commission at no additional cost to the reader.</p>
          <p>For businesses: full partnership terms and editorial ground rules are at <a href="/partners/">Partner With Us</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Publication voice -->
  <section class="about-colophon">
    <div class="container">
      <div class="about-mission__grid">
        <div class="about-mission__lead">
          <p class="label label--accent">The publication</p>
          <h2 class="about-mission__title">Shaped by time spent on the Peninsula</h2>
        </div>
        <div class="about-mission__body prose">
          <p>Peninsula Insider is independently founded and editorially led through a long-standing connection to the Mornington Peninsula.</p>
          <p>The publication is shaped through regular time spent across the region — from coastlines and wineries to seasonal openings, long weekends and evolving local favourites.</p>
          <p>Coverage is guided by editorial judgement, firsthand experience and a focus on genuinely useful recommendations for readers planning time on the Peninsula.</p>
          <p><em>The Insider</em> is the publication's editorial correspondence — curated Peninsula weekends, seasonal editions, openings and editorial recommendations, sent when they're worth sending. <a href="/newsletter/">Read more about The Insider.</a></p>
          <p>Questions about the editorial process? Write to <a href="mailto:hello@peninsulainsider.com.au">hello@peninsulainsider.com.au</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <NewsletterBlock
    title="The Insider - editorial correspondence from Peninsula Insider."
    body="Thoughtful recommendations, seasonal discoveries, and what’s happening across the Mornington Peninsula."
    sub="Curated and sent occasionally by Peninsula Insider."
  />
</BaseLayout>

<style>
  .ea-verification,
  .ea-commercial {
    background: var(--bg-alt);
  }
</style>
