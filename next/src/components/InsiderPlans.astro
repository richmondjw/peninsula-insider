---
/**
 * InsiderPlans — homepage conversion block
 * "Start with an Insider Plan"
 *
 * Mobile-first horizontal swipe, 4–6 cards.
 * Each card links to a fully structured itinerary page.
 */

interface PlanCard {
  duration: string;
  title: string;
  dek: string;
  href: string;
  image: string;
  imageAlt: string;
  accent: string; // CSS custom property value or hex
}

const plans: PlanCard[] = [
  {
    duration: '1 day',
    title: 'Red Hill Day',
    dek: 'Market, long lunch, then stay south.',
    href: '/journal/how-to-build-a-red-hill-saturday/',
    image: '/images/sourced/article-red-hill-saturday-01.webp',
    imageAlt: 'Red Hill hinterland — vineyards and market stalls',
    accent: '#5C3D1A',
  },
  {
    duration: '1 day',
    title: 'Coastal Day',
    dek: 'Coffee, walk, lunch, ocean.',
    href: '/journal/the-four-hour-peninsula/',
    image: '/images/sourced/article-sorrento-weekend-01.webp',
    imageAlt: 'Sorrento coastline — limestone cliffs and calm bay water',
    accent: '#1A3850',
  },
  {
    duration: '2 days',
    title: 'Peninsula Escape',
    dek: 'Stay, explore, unwind.',
    href: '/journal/the-one-night-escape/',
    image: '/images/sourced/article-couples-weekend-01.webp',
    imageAlt: 'Peninsula accommodation — quiet rooms and green views',
    accent: '#2C4A2C',
  },
  {
    duration: '2 days',
    title: 'Food & Wine Weekend',
    dek: 'The best of the hinterland.',
    href: '/journal/the-vineyard-villa-weekend/',
    image: '/images/sourced/article-vineyard-villa-01.webp',
    imageAlt: 'Mornington Peninsula winery — cellar door and vines',
    accent: '#4A2C1A',
  },
  {
    duration: '3 days',
    title: 'Slow Peninsula',
    dek: 'Take your time and do it properly.',
    href: '/journal/how-to-plan-a-peninsula-weekend/',
    image: '/images/sourced/article-flinders-weekend-01.webp',
    imageAlt: 'Flinders village — quiet street, morning light',
    accent: '#2C3A2C',
  },
];
---

<section class="insider-plans" aria-labelledby="insider-plans-title">
  <div class="insider-plans__header container">
    <div class="insider-plans__heading-group">
      <p class="insider-plans__eyebrow">Insider Plans</p>
      <h2 class="insider-plans__title" id="insider-plans-title">Start with an Insider Plan</h2>
      <p class="insider-plans__subhead">We've already planned it. Just follow it.</p>
    </div>
  </div>

  <div class="insider-plans__scroll-wrapper" role="list" aria-label="Insider Plans">
    <div class="insider-plans__track">
      {plans.map((plan) => (
        <a
          href={plan.href}
          class="plan-card"
          role="listitem"
          style={`--plan-accent: ${plan.accent};`}
          aria-label={`${plan.title} — ${plan.duration}. ${plan.dek}`}
        >
          <div class="plan-card__image" style={`background-image: url('${plan.image}');`} role="img" aria-label={plan.imageAlt}></div>
          <div class="plan-card__overlay"></div>
          <div class="plan-card__body">
            <span class="plan-card__duration">{plan.duration}</span>
            <h3 class="plan-card__title">{plan.title}</h3>
            <p class="plan-card__dek">{plan.dek}</p>
            <span class="plan-card__cta" aria-hidden="true">See plan →</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="insider-plans__footer">
      <a href="/escape/" class="insider-plans__all-link">See all Insider Plans →</a>
    </div>
  </div>
</section>

<style>
  .insider-plans {
    padding: 4rem 0 3rem;
    background: var(--paper, #F5F0E8);
    overflow: hidden;
  }

  .insider-plans__header {
    margin-bottom: 2rem;
  }

  .insider-plans__heading-group {
    max-width: 520px;
  }

  .insider-plans__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    margin: 0 0 0.5rem;
  }

  .insider-plans__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--ink, #1A1208);
    margin: 0 0 0.5rem;
    line-height: 1.15;
  }

  .insider-plans__subhead {
    font-size: 1rem;
    color: var(--ink-muted, #6E655C);
    margin: 0;
    font-style: italic;
  }

  /* ── Scroll track ── */
  .insider-plans__scroll-wrapper {
    padding: 0.25rem 0 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
  }

  .insider-plans__scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .insider-plans__track {
    display: flex;
    gap: 1rem;
    padding: 0 var(--container-pad, 1.25rem);
    width: max-content;
  }

  /* ── Plan card ── */
  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 260px;
    height: 360px;
    flex-shrink: 0;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    border-radius: 2px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media (min-width: 768px) {
    .plan-card {
      width: 300px;
      height: 420px;
    }
  }

  .plan-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.25);
  }

  .plan-card__image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.4s ease;
  }

  .plan-card:hover .plan-card__image {
    transform: scale(1.03);
  }

  .plan-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 30%,
      rgba(0,0,0,0.25) 60%,
      rgba(0,0,0,0.72) 100%
    );
  }

  .plan-card__body {
    position: relative;
    padding: 1.5rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .plan-card__duration {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 0.1rem;
  }

  .plan-card__title {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
    margin: 0;
  }

  .plan-card__dek {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.8);
    margin: 0.2rem 0 0.75rem;
    line-height: 1.4;
  }

  .plan-card__cta {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.9);
    border-bottom: 1px solid rgba(255,255,255,0.4);
    padding-bottom: 1px;
    width: fit-content;
    transition: border-color 0.15s ease;
  }

  .plan-card:hover .plan-card__cta {
    border-color: rgba(255,255,255,0.9);
  }

  /* ── Footer ── */
  .insider-plans__footer {
    padding-top: 0.5rem;
  }

  .insider-plans__all-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-muted, #6E655C);
    text-decoration: underline;
    text-underline-offset: 3px;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .insider-plans__all-link:hover {
    color: var(--ink, #1A1208);
  }

  /* ── Drag scroll JS ── */
</style>

<script>
  const track = document.querySelector('.insider-plans__scroll-wrapper') as HTMLElement;
  if (track) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      track.style.cursor = 'grabbing';
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => { isDown = false; track.style.cursor = 'grab'; });
    track.addEventListener('mouseup', () => { isDown = false; track.style.cursor = 'grab'; });
    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollLeft - walk;
    });
  }
</script>
