---
/**
 * InsiderPlans — homepage conversion block
 * "Start with an Insider Plan"
 *
 * Keep the strongest five first, then continue the rest
 * in the same horizontal rail.
 */
import { getCollection } from 'astro:content';
import { routeSlug } from '../lib/editorial';

interface PlanCard {
  duration: string;
  title: string;
  dek: string;
  href: string;
  image: string;
  imageAlt: string;
  accent: string;
}

interface PlanSpec {
  slug: string;
  duration: string;
  title: string;
  dek?: string;
  accent: string;
}

const featuredSpecs: PlanSpec[] = [
  {
    slug: 'how-to-build-a-red-hill-saturday',
    duration: '1 day',
    title: 'Red Hill Day',
    dek: 'Market, long lunch, then stay south.',
    accent: '#5C3D1A',
  },
  {
    slug: 'the-four-hour-peninsula',
    duration: '1 day',
    title: 'Coastal Day',
    dek: 'Coffee, walk, lunch, ocean.',
    accent: '#1A3850',
  },
  {
    slug: 'the-one-night-escape',
    duration: '2 days',
    title: 'Peninsula Escape',
    dek: 'Stay, explore, unwind.',
    accent: '#2C4A2C',
  },
  {
    slug: 'the-vineyard-villa-weekend',
    duration: '2 days',
    title: 'Food & Wine Weekend',
    dek: 'The best of the hinterland.',
    accent: '#4A2C1A',
  },
  {
    slug: 'how-to-plan-a-peninsula-weekend',
    duration: '3 days',
    title: 'Slow Peninsula',
    dek: 'Take your time and do it properly.',
    accent: '#2C3A2C',
  },
];

const allPlanSpecs: PlanSpec[] = [
  ...featuredSpecs,
  {
    slug: 'mornington-peninsula-stay-and-soak',
    duration: '1 day',
    title: 'Hot Springs Day',
    dek: 'Thermal pools, then lunch.',
    accent: '#6A5545',
  },
  {
    slug: 'the-cellar-door-short-list',
    duration: '1 day',
    title: 'Cellar Door Saturday',
    dek: 'Three doors, no agenda.',
    accent: '#5D3A24',
  },
  {
    slug: 'the-sunset-drink',
    duration: 'Evening',
    title: 'The Sunset Drink',
    dek: 'One venue, one drink, before it gets dark.',
    accent: '#7A4C3D',
  },
  {
    slug: 'the-peninsula-with-kids',
    duration: '1–2 days',
    title: 'Peninsula with Kids',
    dek: 'Beaches, eagle, maze. Keep it moving.',
    accent: '#6A5332',
  },
  {
    slug: 'autumn-weekend-edit',
    duration: '2 days',
    title: 'Autumn Peninsula',
    dek: 'Best season, least people.',
    accent: '#70533B',
  },
  {
    slug: 'the-sorrento-weekend',
    duration: '2 days',
    title: 'Sorrento Weekend',
    dek: 'The classic Peninsula trip, done properly.',
    accent: '#24425A',
  },
  {
    slug: 'the-long-lunch',
    duration: 'Half day',
    title: 'The Long Lunch',
    dek: 'Pick a table. Stay too long.',
    accent: '#4F392A',
  },
  {
    slug: 'the-market-saturday',
    duration: 'Half day',
    title: 'The Market Morning',
    dek: 'Red Hill Market, then wherever it takes you.',
    accent: '#8A5C33',
  },
  {
    slug: 'a-flinders-weekend',
    duration: '1 day',
    title: 'Flinders Day',
    dek: 'The quiet end. Bakery, pier, general store.',
    accent: '#32463A',
  },
  {
    slug: 'the-producer-trail',
    duration: '1 day',
    title: 'The Producer Trail',
    dek: 'Farm gate to cellar door to table.',
    accent: '#55613C',
  },
  {
    slug: 'the-point-nepean-half-day',
    duration: 'Half day',
    title: 'Point Nepean Half Day',
    dek: 'Walk to the tip. Swim if you’re brave.',
    accent: '#3C5463',
  },
  {
    slug: 'the-dog-friendly-peninsula',
    duration: '2 days',
    title: 'Dog Weekend',
    dek: 'Beaches that say yes.',
    accent: '#6B5A46',
  },
  {
    slug: 'mornington-peninsula-golf-stay-and-play',
    duration: '2–3 days',
    title: 'Golf Weekend',
    dek: 'World-class courses, Peninsula pace.',
    accent: '#4C5A39',
  },
  {
    slug: 'the-birthday-weekend',
    duration: '2 days',
    title: 'Celebration Weekend',
    dek: 'Somewhere worth celebrating.',
    accent: '#5B2E34',
  },
  {
    slug: 'the-couples-weekend',
    duration: '2 days',
    title: 'Couples Weekend',
    dek: 'The Peninsula’s best double act: wine and water.',
    accent: '#5A3E4A',
  },
  {
    slug: 'rainy-day-peninsula',
    duration: '1 day',
    title: 'Rainy Day Peninsula',
    dek: 'Bad weather, good options.',
    accent: '#4B5663',
  },
  {
    slug: 'corporate-events-how-to-plan-peninsula-retreat',
    duration: '2–3 days',
    title: 'Corporate Retreat',
    dek: 'The hinterland, for work that needs space to think.',
    accent: '#4C4339',
  },
  {
    slug: 'the-thermal-springs-weekend',
    duration: '2 days',
    title: 'Thermal Springs',
    dek: 'Soak, soften, and keep the schedule light.',
    accent: '#4B4032',
  },
  {
    slug: 'a-winter-peninsula-weekend',
    duration: '2 days',
    title: 'Winter Reset',
    dek: 'Fires, hot pools, low-season calm.',
    accent: '#3A4554',
  },
];

const articles = await getCollection('articles', ({ data }) => data.status === 'published');
const articleBySlug = new Map(articles.map((article) => [routeSlug(article), article]));

function buildPlan(spec: PlanSpec): PlanCard | null {
  const article = articleBySlug.get(spec.slug);
  if (!article) return null;
  const heroImage = article.data.heroImage;

  return {
    duration: spec.duration,
    title: spec.title,
    dek: spec.dek || article.data.dek,
    href: `/journal/${spec.slug}/`,
    image: heroImage?.src || '/images/sourced/article-sunset-01.webp',
    imageAlt: heroImage?.alt || article.data.title,
    accent: spec.accent,
  };
}

const orderedPlans = allPlanSpecs
  .map(buildPlan)
  .filter((plan): plan is PlanCard => Boolean(plan))
  .filter((plan, index, plans) => plans.findIndex((candidate) => candidate.href === plan.href) === index);
---

<section class="insider-plans" aria-labelledby="insider-plans-title">
  <div class="insider-plans__header container">
    <div class="insider-plans__heading-group">
      <p class="insider-plans__eyebrow">Insider Plans</p>
      <h2 class="insider-plans__title" id="insider-plans-title">Start with an Insider Plan</h2>
      <p class="insider-plans__subhead">Start with the strongest five, then keep scrolling through the rest.</p>
    </div>
  </div>

  {orderedPlans.length > 0 && (
    <div class="insider-plans__scroll-wrapper" role="list" aria-label="Insider Plans">
      <div class="insider-plans__track">
        {orderedPlans.map((plan) => (
          <a
            href={plan.href}
            class="plan-card"
            role="listitem"
            style={`--plan-accent: ${plan.accent};`}
            aria-label={`${plan.title} — ${plan.duration}. ${plan.dek}`}
          >
            <div class="plan-card__image" style={`background-image: url('${plan.image}');`} role="img" aria-label={plan.imageAlt}></div>
            <div class="plan-card__overlay"></div>
            <div class="plan-card__body">
              <span class="plan-card__duration">{plan.duration}</span>
              <h3 class="plan-card__title">{plan.title}</h3>
              <p class="plan-card__dek">{plan.dek}</p>
              <span class="plan-card__cta" aria-hidden="true">See plan →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .insider-plans {
    padding: 4rem 0 3rem;
    background: var(--paper, #F5F0E8);
    overflow: hidden;
  }

  .insider-plans__header {
    margin-bottom: 2rem;
  }

  .insider-plans__heading-group {
    max-width: 520px;
  }

  .insider-plans__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    margin: 0 0 0.5rem;
  }

  .insider-plans__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--ink, #1A1208);
    margin: 0 0 0.5rem;
    line-height: 1.15;
  }

  .insider-plans__subhead {
    font-size: 1rem;
    color: var(--ink-muted, #6E655C);
    margin: 0;
    font-style: italic;
  }

  .insider-plans__scroll-wrapper {
    padding: 0.25rem 0 1.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    /* iOS native inertia. Combined with no touch-action override the
       browser handles axis-locking, momentum, and edge bounce — which
       is faster and smoother than any JS we could write. */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* Mandatory snap with `scroll-snap-stop: normal` lets a fast flick
       still cross multiple cards, but every release settles a card to
       the leading edge. iOS/Android both implement this with their
       native deceleration so it lands soft. */
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-pad, 1.25rem);
    overscroll-behavior-x: contain;
    /* Performance: this is a long rail with photo backgrounds. Tell
       the browser the wrapper paints/lays-out independently so off-
       screen card paints don't invalidate the rest of the page. */
    contain: layout paint;
  }
  /* Desktop only: opt into the JS click-drag affordance. On touch
     devices we rely entirely on native scroll. */
  @media (hover: hover) and (pointer: fine) {
    .insider-plans__scroll-wrapper { cursor: grab; }
    .insider-plans__scroll-wrapper.is-dragging {
      cursor: grabbing;
      user-select: none;
    }
  }

  .insider-plans__scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .insider-plans__track {
    display: flex;
    gap: 1rem;
    padding: 0 var(--container-pad, 1.25rem);
    width: max-content;
  }

  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 78vw;
    max-width: 320px;
    height: clamp(360px, 70vw, 420px);
    flex-shrink: 0;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    border-radius: 2px;
    scroll-snap-align: start;
    /* GPU-friendly: every card promotes to its own compositor layer
       so the scroll-paint stays at 60fps even with 11 cards in the
       rail. transform avoids triggering layout. */
    transform: translateZ(0);
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1),
                box-shadow 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (min-width: 768px) {
    .plan-card {
      width: 300px;
      max-width: none;
      height: 420px;
    }
  }

  .plan-card:hover {
    /* `translate3d` keeps the card on the same compositor layer as
       the scroll-time transform — no relayout, no jank. */
    transform: translate3d(0, -4px, 0);
    box-shadow: 0 18px 40px rgba(0,0,0,0.22);
  }

  .plan-card__image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }

  .plan-card:hover .plan-card__image {
    transform: scale(1.04);
  }

  .plan-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 30%,
      rgba(0,0,0,0.25) 60%,
      rgba(0,0,0,0.72) 100%
    );
  }

  .plan-card__body {
    position: relative;
    padding: 1.5rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .plan-card__duration {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 0.1rem;
  }

  .plan-card__title {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
    margin: 0;
  }

  .plan-card__dek {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.8);
    margin: 0.2rem 0 0.75rem;
    line-height: 1.4;
  }

  .plan-card__cta {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.9);
    border-bottom: 1px solid rgba(255,255,255,0.4);
    padding-bottom: 1px;
    width: fit-content;
    transition: border-color 0.15s ease;
  }

  .plan-card:hover .plan-card__cta {
    border-color: rgba(255,255,255,0.9);
  }
</style>

<script>
  /* Desktop-only enhancements for the Insider Plans rail:
       1. Pointer click-and-drag with velocity tracking and inertial
          decay after release.
       2. Mouse-wheel-to-horizontal: vertical wheel translates to
          horizontal motion while hovering the rail.
       3. Drag-vs-click discrimination so a deliberate tap on a card
          still navigates.
     On TOUCH devices we skip this entirely — the browser's native
     -webkit-overflow-scrolling momentum is faster, lower-latency,
     and indistinguishable from a native app carousel. Any JS we
     add on touch can only make it worse. The hover + fine-pointer
     media query is the canonical way to detect a real cursor.
  */
  function bindInsiderPlansRail() {
    // Hard gate: skip JS interactions on touch devices entirely.
    if (typeof window === 'undefined') return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.querySelectorAll('.insider-plans__scroll-wrapper').forEach((track) => {
      const el = track as HTMLElement;
      if (el.dataset.dragBound === 'true') return;
      el.dataset.dragBound = 'true';

      const DRAG_THRESHOLD = 6;        // pixels before we count as a drag
      const INERTIA_DECAY  = 0.94;     // velocity multiplier per frame (0..1)
      const INERTIA_MIN    = 0.04;     // px/ms below which we stop the loop

      let pointerId: number | null = null;
      let isDown        = false;
      let isDragging    = false;        // moved past threshold
      let startX        = 0;
      let startScrollLeft = 0;
      let lastX         = 0;
      let lastTime      = 0;
      let velocity      = 0;            // px per ms, positive = pointer moved right
      let inertiaRaf: number | null = null;

      function cancelInertia() {
        if (inertiaRaf !== null) {
          cancelAnimationFrame(inertiaRaf);
          inertiaRaf = null;
        }
      }

      function startInertia() {
        cancelInertia();
        let last = performance.now();
        function step(now: number) {
          const dt = now - last;
          last = now;
          velocity *= Math.pow(INERTIA_DECAY, dt / 16);
          if (Math.abs(velocity) < INERTIA_MIN) {
            inertiaRaf = null;
            return;
          }
          el.scrollLeft -= velocity * dt;
          inertiaRaf = requestAnimationFrame(step);
        }
        inertiaRaf = requestAnimationFrame(step);
      }

      el.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;     // left mouse / primary touch only
        cancelInertia();
        isDown      = true;
        isDragging  = false;
        pointerId   = e.pointerId;
        startX      = e.clientX;
        lastX       = e.clientX;
        lastTime    = performance.now();
        startScrollLeft = el.scrollLeft;
        velocity    = 0;
      });

      el.addEventListener('pointermove', (e) => {
        if (!isDown || pointerId !== e.pointerId) return;
        const dx = e.clientX - startX;
        if (!isDragging && Math.abs(dx) > DRAG_THRESHOLD) {
          isDragging = true;
          el.classList.add('is-dragging');
          try { el.setPointerCapture(e.pointerId); } catch (_e) {}
        }
        if (!isDragging) return;
        e.preventDefault();
        el.scrollLeft = startScrollLeft - dx;
        const now = performance.now();
        const dt  = Math.max(1, now - lastTime);
        velocity  = (e.clientX - lastX) / dt;
        lastX     = e.clientX;
        lastTime  = now;
      });

      function endPointer(e: PointerEvent) {
        if (pointerId !== e.pointerId) return;
        const wasDragging = isDragging;
        isDown = false;
        isDragging = false;
        pointerId = null;
        el.classList.remove('is-dragging');
        try { el.releasePointerCapture(e.pointerId); } catch (_e) {}
        if (wasDragging) {
          // Don't fire the click that follows — user was scrolling.
          const swallowClick = (ev: MouseEvent) => {
            ev.stopPropagation();
            ev.preventDefault();
            el.removeEventListener('click', swallowClick, true);
          };
          el.addEventListener('click', swallowClick, true);
          startInertia();
        }
      }

      el.addEventListener('pointerup',     endPointer);
      el.addEventListener('pointercancel', endPointer);

      // Translate vertical wheel deltas into horizontal scroll on the
      // rail. If the user is producing a primarily-horizontal gesture
      // (trackpad two-finger), let it through unchanged.
      el.addEventListener('wheel', (e) => {
        const absX = Math.abs(e.deltaX);
        const absY = Math.abs(e.deltaY);
        if (absX > absY) return;        // already horizontal — let it run
        if (absY < 1) return;
        e.preventDefault();
        cancelInertia();
        // Scale wheel delta a little so a single notch feels generous.
        el.scrollLeft += e.deltaY * 1.15;
      }, { passive: false });
    });
  }

  bindInsiderPlansRail();
  document.addEventListener('astro:page-load', bindInsiderPlansRail);
</script>
