---
/* AuthModal - sign in via Google or magic link.
   Hidden by default; opened by any element with [data-open-auth].
   Inline CSS + JS so the component is self-contained. */
---

<div class="v2-auth" id="v2-auth-modal" hidden aria-hidden="true" role="dialog" aria-labelledby="v2-auth-title" aria-modal="true">
  <div class="v2-auth__backdrop" data-close-auth></div>
  <div class="v2-auth__panel" role="document">
    <button class="v2-auth__close" type="button" aria-label="Close" data-close-auth>&times;</button>

    <div class="v2-auth__head">
      <span class="v2-auth__eyebrow">Peninsula Insider</span>
      <h2 class="v2-auth__title" id="v2-auth-title">Save places, plans and <em>future Peninsula weekends.</em></h2>
      <p class="v2-auth__dek">Save places, plans and future Peninsula weekends to revisit later. No password required.</p>
    </div>

    <div class="v2-auth__body">
      <button class="v2-auth__google" type="button" data-auth-google>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.79 2.71v2.26h2.9c1.7-1.56 2.69-3.86 2.69-6.61z"/>
          <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.83.86-3.05.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.32A9 9 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.97 10.71a5.4 5.4 0 0 1 0-3.43V4.96H.96a9 9 0 0 0 0 8.07l3-2.32z"/>
          <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.34l2.58-2.58A9 9 0 0 0 9 0a9 9 0 0 0-8.04 4.96l3 2.32C4.68 5.16 6.66 3.58 9 3.58z"/>
        </svg>
        <span>Continue with Google</span>
      </button>

      <div class="v2-auth__divider"><span>or</span></div>

      <form class="v2-auth__email-form" data-auth-magic>
        <label class="v2-auth__label" for="v2-auth-email">Email</label>
        <input
          id="v2-auth-email"
          class="v2-auth__email"
          type="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <button class="v2-auth__send" type="submit">Send magic link</button>
        <p class="v2-auth__status" role="status" aria-live="polite"></p>
      </form>

      <p class="v2-auth__legal">
        By signing in you agree to our <a href="/terms/">terms</a> and <a href="/privacy/">privacy policy</a>.
        Subscribing to The Insider Note is a separate, opt-in step from your account settings.
      </p>
    </div>
  </div>
</div>

<script>
  import { signInWithGoogle, signInWithMagicLink, isAuthEnabled } from '../../lib/auth';

  function init() {
    const modal = document.getElementById('v2-auth-modal');
    if (!modal || (modal as any)._init) return;
    (modal as any)._init = true;

    const open = () => {
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // focus the email input by default - magic link is the lower-friction path
      requestAnimationFrame(() => {
        (document.getElementById('v2-auth-email') as HTMLInputElement | null)?.focus();
      });
    };
    const close = () => {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLElement>('[data-open-auth]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        if (!isAuthEnabled()) {
          alert('Sign-in is not yet configured in this preview build.');
          return;
        }
        open();
      });
    });

    modal.querySelectorAll<HTMLElement>('[data-close-auth]').forEach((el) => {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });

    // Google
    const googleBtn = modal.querySelector<HTMLButtonElement>('[data-auth-google]');
    googleBtn?.addEventListener('click', async () => {
      googleBtn.disabled = true;
      googleBtn.textContent = 'Redirecting…';
      try { await signInWithGoogle(); }
      catch (e: any) {
        googleBtn.disabled = false;
        googleBtn.textContent = 'Continue with Google';
        const status = modal.querySelector('.v2-auth__status') as HTMLElement | null;
        if (status) {
          status.textContent = e?.message || 'Could not start Google sign-in.';
          status.className = 'v2-auth__status v2-auth__status--err';
        }
      }
    });

    // Magic link
    const form = modal.querySelector<HTMLFormElement>('[data-auth-magic]');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type=email]') as HTMLInputElement;
      const btn = form.querySelector('.v2-auth__send') as HTMLButtonElement;
      const status = form.querySelector('.v2-auth__status') as HTMLElement;
      const email = (input.value || '').trim();
      if (!email) { input.focus(); return; }
      btn.disabled = true;
      btn.textContent = 'Sending…';
      status.textContent = '';
      status.className = 'v2-auth__status';
      const r = await signInWithMagicLink(email);
      if (r.ok) {
        status.textContent = 'Check your inbox - the sign-in link is on its way.';
        status.className = 'v2-auth__status v2-auth__status--ok';
        btn.textContent = 'Link sent';
        input.disabled = true;
      } else {
        btn.disabled = false;
        btn.textContent = 'Send magic link';
        status.textContent = r.error || 'Could not send the link.';
        status.className = 'v2-auth__status v2-auth__status--err';
      }
    });

    // Listen for any element-level "open auth" custom event so other
    // components (like-button-locked, save-button-locked) can trigger.
    document.addEventListener('pi:open-auth', open as EventListener);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  .v2-auth { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 1.5rem; font-family: var(--sans, 'Inter', system-ui, sans-serif); }
  .v2-auth[hidden] { display: none; }
  .v2-auth__backdrop { position: absolute; inset: 0; background: rgba(15,12,10,0.55); backdrop-filter: blur(4px); }
  .v2-auth__panel {
    position: relative;
    background: var(--paper, #FAF7F0);
    color: var(--ink, #171413);
    width: min(100%, 26rem);
    border-radius: 4px;
    padding: 2.4rem 2rem 1.8rem;
    box-shadow: 0 30px 80px -20px rgba(0,0,0,.4), 0 8px 18px -4px rgba(0,0,0,.18);
  }
  .v2-auth__close {
    position: absolute; top: 0.6rem; right: 0.7rem;
    background: transparent; border: 0; cursor: pointer;
    width: 2rem; height: 2rem; font-size: 1.4rem;
    color: var(--ink-soft, #3A3531);
    line-height: 1; padding: 0;
  }
  .v2-auth__close:hover { color: var(--ink, #171413); }

  .v2-auth__head { text-align: center; margin-bottom: 1.4rem; }
  .v2-auth__eyebrow {
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--ochre, #A0541F);
  }
  .v2-auth__title {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-size: 1.45rem; font-weight: 500; line-height: 1.2;
    margin: 0.4rem 0 0.5rem;
    letter-spacing: -0.012em;
    font-variation-settings: 'opsz' 32;
  }
  .v2-auth__title em { font-style: normal; color: var(--ochre, #A0541F); font-weight: 400; }
  .v2-auth__dek {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-size: 0.92rem; line-height: 1.5;
    color: var(--ink-soft, #3A3531);
    margin: 0;
  }

  .v2-auth__google {
    display: flex; align-items: center; justify-content: center; gap: 0.7rem;
    width: 100%; padding: 0.8rem 1rem;
    background: var(--paper, #FAF7F0);
    color: var(--ink, #171413);
    border: 1px solid var(--line, #D9D1BE);
    border-radius: 100px;
    font-family: inherit;
    font-size: 0.9rem; font-weight: 500;
    cursor: pointer;
    transition: background .2s ease, border-color .2s ease;
  }
  .v2-auth__google:hover { background: var(--paper-warm, #F3EDDE); border-color: var(--ink, #171413); }
  .v2-auth__google:disabled { opacity: 0.6; cursor: default; }

  .v2-auth__divider {
    display: flex; align-items: center; gap: 0.7rem;
    margin: 1.1rem 0;
    color: var(--ink-muted, #6E655C); font-size: 0.72rem;
    letter-spacing: 0.18em; text-transform: uppercase;
  }
  .v2-auth__divider::before, .v2-auth__divider::after {
    content: ''; flex: 1; height: 1px; background: var(--line, #D9D1BE);
  }

  .v2-auth__email-form { display: grid; gap: 0.45rem; }
  .v2-auth__label {
    font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ink-muted, #6E655C); font-weight: 600;
  }
  .v2-auth__email {
    padding: 0.7rem 0.9rem; border: 1px solid var(--line, #D9D1BE);
    border-radius: 4px; font-family: inherit; font-size: 0.92rem;
    background: #fff; color: var(--ink, #171413); outline: none;
    transition: border-color .2s ease;
  }
  .v2-auth__email:focus { border-color: var(--ochre, #A0541F); }
  .v2-auth__email:disabled { opacity: 0.6; cursor: default; background: var(--paper-warm, #F3EDDE); }

  .v2-auth__send {
    margin-top: 0.45rem;
    padding: 0.75rem 1rem;
    background: var(--ink, #171413); color: var(--paper, #FAF7F0);
    border: 0; border-radius: 100px;
    font-family: inherit; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    cursor: pointer;
    transition: background .2s ease;
  }
  .v2-auth__send:hover { background: var(--ochre, #A0541F); }
  .v2-auth__send:disabled { opacity: 0.6; cursor: default; }

  .v2-auth__status {
    min-height: 1.1em; font-size: 0.84rem; line-height: 1.4;
    margin: 0.5rem 0 0; font-style: normal;
    color: var(--ink-muted, #6E655C);
    font-family: var(--serif, 'Newsreader', Georgia, serif);
  }
  .v2-auth__status--ok { color: var(--ochre, #A0541F); }
  .v2-auth__status--err { color: #B3261E; }

  .v2-auth__legal {
    margin: 1.2rem 0 0;
    font-size: 0.72rem; line-height: 1.45; color: var(--ink-muted, #6E655C);
    text-align: center;
  }
  .v2-auth__legal a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .v2-auth__legal a:hover { color: var(--ochre, #A0541F); }
</style>
