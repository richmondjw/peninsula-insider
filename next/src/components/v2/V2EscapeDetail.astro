---
import { routeSlug, titleize, stayTypes, wineTypes, typeLabel, placeLabel } from '../../lib/editorial';

export interface Props {
  itinerary: any;
  venueMap?: Map<string, any>;
  experienceMap?: Map<string, any>;
  featuredStays?: any[];
  highlightedExperiences?: any[];
  relatedItineraries?: any[];
}

const {
  itinerary,
  venueMap = new Map(),
  experienceMap = new Map(),
  featuredStays = [],
  highlightedExperiences = [],
  relatedItineraries = [],
} = Astro.props;

const data = itinerary.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const audienceLabel: Record<string, string> = {
  couple: 'Couples',
  family: 'Families',
  friends: 'Friends',
  solo: 'Solo',
  locals: 'Locals',
};
const moodLabel: Record<string, string> = {
  slow: 'Slow',
  indulgent: 'Indulgent',
  wellness: 'Wellness',
  adventure: 'Adventure',
  'food-wine': 'Food & Wine',
  mixed: 'Mixed',
  quick: 'Quick',
};
const timeOfDayLabel: Record<string, string> = {
  morning: 'Morning',
  midday: 'Midday',
  afternoon: 'Afternoon',
  evening: 'Evening',
  night: 'Night',
};

function resolveImage(src?: string) {
  if (!src || src.includes('placeholder')) return `${base}images/sourced/home-cover.webp`;
  return src.startsWith('/') ? `${base}${src.slice(1)}` : src;
}

function venueHref(type: string) {
  if (stayTypes.includes(type)) return `${base}stay/`;
  if (wineTypes.includes(type)) return `${base}wine/`;
  return `${base}eat/`;
}

const heroImage = resolveImage(data.heroImage?.src);
const nightsLabel = `${data.lengthNights} night${data.lengthNights === 1 ? '' : 's'}`;
const slug = routeSlug(itinerary);

// Build grouped stops from raw stops array
const days = Array.from(new Set(data.stops.map((s: any) => s.day))).sort((a: any, b: any) => a - b);
const groupedStops = days.map((day: any) => ({
  day,
  stops: data.stops
    .filter((s: any) => s.day === day)
    .sort((a: any, b: any) => a.order - b.order)
    .map((stop: any) => {
      const venueSlug = String(stop.venue?.id ?? stop.venue ?? '');
      const experienceSlug = String(stop.experience?.id ?? stop.experience ?? '');
      const venue = venueSlug ? venueMap.get(venueSlug) : null;
      const experience = experienceSlug ? experienceMap.get(experienceSlug) : null;
      const href = venue
        ? `${venueHref(venue.data.type)}${routeSlug(venue)}/`
        : experience
          ? `${base}explore/${routeSlug(experience)}/`
          : undefined;
      const label = venue?.data.name ?? experience?.data.name ?? 'Stop';
      return { ...stop, href, label };
    }),
}));

const editorParas = String(data.editorNote ?? '').split(/\n\n+/).filter(Boolean);
---

<section class="hero" aria-label={`${data.title} cover`}>
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}escape/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Escape</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">{nightsLabel} <span class="ornament">·</span> {moodLabel[data.mood] ?? titleize(data.mood)}</span>
        </div>
        <h1 class="hero__headline">{data.title}</h1>
        <p class="hero__dek">{data.dek}</p>
        <div class="hero__byline">
          <span> - For <strong>{audienceLabel[data.audience] ?? titleize(data.audience)}</strong></span>
          {data.totalDriveMinutes && (
            <span class="hero__byline-read">{data.totalDriveMinutes} min driving</span>
          )}
        </div>
      </div>
      <figure>
        <img class="hero__image" src={heroImage} alt={data.heroImage?.alt ?? data.title} loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>{data.title}</span>
          <span>Peninsula Insider <span class="ornament">/</span> Escape plan</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby={`escape-${slug}`}>
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's note</span>
        </div>
        <h2 class="letter__head" id={`escape-${slug}`}>Why this plan, in this <em>order</em>.</h2>
        <div class="letter__prose">
          {editorParas.map((p: string) => <p>{p}</p>)}
        </div>
      </div>

      <aside class="letter__side">
        <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
          <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">At a glance</p>
          <dl style="display:grid; grid-template-columns:auto 1fr; gap:.6rem 1rem; font-family:var(--sans,'Inter'),sans-serif; font-size:.92rem;">
            <dt style="font-weight:500;">Length</dt>
            <dd style="margin:0;">{nightsLabel}</dd>

            <dt style="font-weight:500;">For</dt>
            <dd style="margin:0;">{audienceLabel[data.audience] ?? titleize(data.audience)}</dd>

            <dt style="font-weight:500;">Mood</dt>
            <dd style="margin:0;">{moodLabel[data.mood] ?? titleize(data.mood)}</dd>

            <dt style="font-weight:500;">Stops</dt>
            <dd style="margin:0;">{data.stops.length} sequenced</dd>

            {data.totalDriveMinutes && (<>
              <dt style="font-weight:500;">Driving</dt>
              <dd style="margin:0;">{data.totalDriveMinutes} min total</dd>
            </>)}
          </dl>

          <a class="masthead__cta" href={`${base}stay/`} style="display:inline-block;margin-top:1.5rem;">
            Choose the stay
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby="stops-title">
  <div class="container">
    <div class="letter__frame" style="display:block; max-width:50rem; margin-inline:auto;">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">The sequence</span>
        </div>
        <h2 class="letter__head" id="stops-title">Stop by <em>stop</em>.</h2>
        <div class="letter__prose">
          {groupedStops.map((group: any) => (
            <div style="margin-bottom:2rem;">
              <h3 style="font-family:var(--serif,'Newsreader'),serif;font-weight:500;font-size:1.35rem;margin-top:1.5rem;margin-bottom:.75rem;">Day {group.day}</h3>
              <ol style="list-style:none;padding:0;margin:0;">
                {group.stops.map((stop: any) => (
                  <li style="display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding:1rem 0;border-top:1px solid rgba(0,0,0,0.08);">
                    <div style="font-family:var(--sans,'Inter'),sans-serif;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ochre,#a0612d);">
                      {timeOfDayLabel[stop.timeOfDay] ?? titleize(stop.timeOfDay)}
                    </div>
                    <div>
                      <h4 style="font-family:var(--serif,'Newsreader'),serif;font-weight:500;font-size:1.15rem;margin:0 0 .35rem;">
                        {stop.href ? <a href={stop.href} style="color:inherit;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;">{stop.label}</a> : stop.label}
                      </h4>
                      {stop.note && <p style="margin:0;font-size:.95rem;line-height:1.55;">{stop.note}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

{featuredStays.length > 0 && (
  <section class="dept" aria-labelledby="sleep-title">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Sleep here</span>
          <h2 class="dept__title" id="sleep-title">Stays that <em>anchor</em> this plan.</h2>
          <p class="dept__dek">The beds that position you properly for the stops above.</p>
        </div>
        <a href={`${base}stay/`} class="well__head-link">All stays →</a>
      </div>
      <div class="dept__grid">
        {featuredStays.map((v: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(v.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{typeLabel[v.data.type] ?? titleize(v.data.type)}</span>
            </div>
            <div class="venue__meta">
              <span>{placeLabel(v.data.place)}</span>
              <span class="venue__meta-sep"></span>
              <span>{v.data.priceBand}</span>
            </div>
            <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{v.data.name}</h3></a>
            <p class="venue__sig">{v.data.signature}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{highlightedExperiences.length > 0 && (
  <section class="dept" aria-labelledby="explore-stops">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Take it outside</span>
          <h2 class="dept__title" id="explore-stops">Explore stops <em>inside</em> this plan.</h2>
        </div>
        <a href={`${base}explore/`} class="well__head-link">All experiences →</a>
      </div>
      <div class="dept__grid">
        {highlightedExperiences.slice(0, 3).map((e: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(e.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{titleize(e.data.type)}</span>
            </div>
            <div class="venue__meta">
              <span>{placeLabel(e.data.place)}</span>
              {e.data.durationMinutes && (<>
                <span class="venue__meta-sep"></span>
                <span>{e.data.durationMinutes} min</span>
              </>)}
            </div>
            <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{relatedItineraries.length > 0 && (
  <section class="escapes" aria-labelledby="more-escapes">
    <div class="container">
      <div class="escapes__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Try another shape</span>
          <h2 class="dept__title" id="more-escapes" style="margin-top:.5rem;">More <em>escape plans</em>.</h2>
        </div>
        <a href={`${base}escape/`} class="well__head-link">All escapes →</a>
      </div>
      <div class="escapes__grid">
        {relatedItineraries.map((it: any) => (
          <article class="escape">
            <div class="escape__image" style={`background-image:url(${resolveImage(it.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="escape__image-tag"><strong>{it.data.lengthNights}</strong> night{it.data.lengthNights === 1 ? '' : 's'}</span>
            </div>
            <div class="escape__body">
              <span class="escape__eyebrow">Plan <span class="ornament">·</span> {moodLabel[it.data.mood] ?? titleize(it.data.mood)}</span>
              <a href={`${base}escape/${routeSlug(it)}/`}><h3 class="escape__title">{it.data.title}</h3></a>
              <p class="escape__dek">{it.data.dek}</p>
              <div class="escape__foot">
                <span>{audienceLabel[it.data.audience] ?? titleize(it.data.audience)}</span>
                <span class="escape__foot-read">Plan →</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
