---
import {
  eventCategoryLabel,
  eventDateLabel,
  eventLensLabel,
  routeSlug,
  stayTypes,
  wineTypes,
  titleize,
  weatherCopy,
} from '../../lib/editorial';

export interface Props {
  event: any;
  place?: any;
  venue?: any;
  related?: any[];
}

const { event, place = null, venue = null, related = [] } = Astro.props;
const data = event.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const recurrenceCopy: Record<string, string> = {
  'one-off': 'One-off',
  weekly: 'Weekly programme',
  monthly: 'Monthly recurring',
  annual: 'Annual',
  seasonal: 'Seasonal',
  ongoing: 'Ongoing',
};

function resolveImage(src?: string) {
  if (!src || src.includes('placeholder')) return `${base}images/sourced/home-cover.webp`;
  return src.startsWith('/') ? `${base}${src.slice(1)}` : src;
}

function venueHref(type: string) {
  if (stayTypes.includes(type)) return `${base}stay/`;
  if (wineTypes.includes(type)) return `${base}wine/`;
  return `${base}eat/`;
}

const placeName = place?.data?.name ?? 'Mornington Peninsula';
const heroImage = resolveImage(data.heroImage?.src);
const dateLabel = eventDateLabel(data.startDate, data.endDate);

const editorParas = String(data.editorNote ?? '').split(/\n\n+/).filter(Boolean);
const lensList = (data.lens ?? []).map((k: string) => ({ key: k, label: eventLensLabel[k] ?? titleize(k) }));
const slug = routeSlug(event);
---

<section class="hero" aria-label={`${data.title} cover`}>
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}whats-on/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">What's On</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">{eventCategoryLabel[data.category] ?? titleize(data.category)} <span class="ornament">·</span> {recurrenceCopy[data.recurrence] ?? titleize(data.recurrence)}</span>
        </div>
        <h1 class="hero__headline">{data.title}</h1>
        <p class="hero__dek">{data.summary}</p>
        <div class="hero__byline">
          <span>— {dateLabel}</span>
          {data.bookingUrl && (
            <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer" class="hero__byline-read">Book / info →</a>
          )}
        </div>
      </div>
      <figure>
        <img class="hero__image" src={heroImage} alt={data.title} loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>{data.title} <span class="ornament">—</span> {placeName}</span>
          <span>Peninsula Insider <span class="ornament">/</span> What's On</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

{data.skipThis && (
  <section class="letter">
    <div class="container">
      <div class="letter__frame" style="display:block;">
        <blockquote class="pullquote">Worth knowing — {data.skipReason ?? data.editorVerdict ?? data.summary}</blockquote>
      </div>
    </div>
  </section>
)}

<section class="letter" aria-labelledby={`event-${slug}`}>
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">Editor's verdict</span>
        </div>
        <h2 class="letter__head" id={`event-${slug}`}>On <em>{data.title}</em>.</h2>
        <div class="letter__prose">
          {data.editorVerdict && (
            <blockquote class="pullquote">{data.editorVerdict}</blockquote>
          )}
          {editorParas.map((p: string) => <p>{p}</p>)}
          {editorParas.length === 0 && !data.editorVerdict && (
            <p>{data.summary}</p>
          )}

          {lensList.length > 0 && (
            <p style="margin-top:1.5rem;">
              {lensList.map((lens: { key: string; label: string }) => (
                <span class="sl-item__tag" style="margin-right:.4rem;">{lens.label}</span>
              ))}
            </p>
          )}
        </div>
      </div>

      <aside class="letter__side">
        <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
          <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">At a glance</p>
          <dl style="display:grid; grid-template-columns:auto 1fr; gap:.6rem 1rem; font-family:var(--sans,'Inter'),sans-serif; font-size:.92rem;">
            <dt style="font-weight:500;">When</dt>
            <dd style="margin:0;">{dateLabel}</dd>

            <dt style="font-weight:500;">How often</dt>
            <dd style="margin:0;">{recurrenceCopy[data.recurrence] ?? titleize(data.recurrence)}</dd>

            {place && (<>
              <dt style="font-weight:500;">Where</dt>
              <dd style="margin:0;"><a href={`${base}places/${routeSlug(place)}/`} style="color:inherit;">{place.data.name}</a></dd>
            </>)}

            {venue && (<>
              <dt style="font-weight:500;">Venue</dt>
              <dd style="margin:0;"><a href={`${venueHref(venue.data.type)}${routeSlug(venue)}/`} style="color:inherit;">{venue.data.name}</a></dd>
            </>)}

            <dt style="font-weight:500;">Weather</dt>
            <dd style="margin:0;">{weatherCopy[data.weather] ?? 'Weather flexible'}</dd>

            {data.worthTheDrive && (<>
              <dt style="font-weight:500;">Worth the drive</dt>
              <dd style="margin:0;">Yes — unprompted</dd>
            </>)}

            {data.firstTimer && (<>
              <dt style="font-weight:500;">First-timer</dt>
              <dd style="margin:0;">Start here</dd>
            </>)}

            <dt style="font-weight:500;">Category</dt>
            <dd style="margin:0;">{eventCategoryLabel[data.category] ?? titleize(data.category)}</dd>
          </dl>

          {data.bookingUrl && (
            <a class="masthead__cta" href={data.bookingUrl} target="_blank" rel="noopener noreferrer" style="display:inline-block;margin-top:1.5rem;">
              Book / info
            </a>
          )}
        </div>
      </aside>
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="dept" aria-labelledby="more-events">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Keep planning</span>
          <h2 class="dept__title" id="more-events">More from <em>What's On</em>.</h2>
        </div>
        <a href={`${base}whats-on/`} class="well__head-link">All events →</a>
      </div>
      <div class="dept__grid">
        {related.map((e: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(e.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{eventCategoryLabel[e.data.category] ?? titleize(e.data.category)}</span>
            </div>
            <div class="venue__meta">
              <span>{eventDateLabel(e.data.startDate, e.data.endDate)}</span>
              <span class="venue__meta-sep"></span>
              <span>{recurrenceCopy[e.data.recurrence] ?? titleize(e.data.recurrence)}</span>
            </div>
            <a href={`${base}whats-on/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.title}</h3></a>
            <p class="venue__sig">{e.data.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
