---
export interface Props {
  section?: string;
}
const { section = '' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const nav = [
  { key: 'eat',      href: `${base}eat/`,      label: 'Eat & Drink' },
  { key: 'stay',     href: `${base}stay/`,     label: 'Stay' },
  { key: 'wine',     href: `${base}wine/`,     label: 'Wine Country' },
  { key: 'explore',  href: `${base}explore/`,  label: 'Explore' },
  { key: 'golf',     href: `${base}golf/`,     label: 'Golf' },
  { key: 'spa',      href: `${base}spa/`,      label: 'Spa & Wellness' },
  { key: 'escape',   href: `${base}escape/`,   label: 'Escape' },
  { key: 'whats-on', href: `${base}whats-on/`, label: "What's On" },
  { key: 'journal',  href: `${base}journal/`,  label: 'Journal' },
];
---
<header class="masthead">
  <div class="container">
    <div class="masthead__top">
      <div class="masthead__util-left">
        <button class="masthead__icon-btn" id="v2MobileNavToggle" aria-label="Menu" aria-expanded="false" aria-controls="v2MobileNav">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
      <div class="masthead__logo">
        <a href={base} style="text-decoration:none;color:inherit;display:block;">
          <span class="masthead__wordmark">Peninsula <em>Insider</em></span>
          <span class="masthead__tagline">The Mornington Peninsula Guide</span>
        </a>
      </div>
      <div class="masthead__util-right">
        <a href="#newsletter" class="masthead__cta pi-btn pi-btn--ghost pi-btn--sm">
          Subscribe
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14m-4-4 4 4-4 4"/></svg>
        </a>
      </div>
    </div>
    <nav class="masthead__nav" aria-label="Sections">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={section === item.key ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<nav id="v2MobileNav" class="v2-mobile-nav" aria-label="Mobile menu" hidden>
  <ul>
    {nav.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
    <li><a href={`${base}about/`}>About</a></li>
    <li><a href={`${base}contact/`}>Contact</a></li>
  </ul>
</nav>

<script is:inline>
  (function () {
    function init() {
      var btn = document.getElementById('v2MobileNavToggle');
      var nav = document.getElementById('v2MobileNav');
      if (!btn || !nav || btn._bound) return;
      btn._bound = true;
      btn.addEventListener('click', function () {
        var open = nav.hasAttribute('hidden');
        if (open) { nav.removeAttribute('hidden'); btn.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; }
        else { nav.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; }
      });
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
