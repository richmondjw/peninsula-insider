---
import { placeLabel, typeLabel, routeSlug, titleize, wineTypes } from '../../lib/editorial';

export interface Props {
  place: any;
  eatVenues?: any[];
  wineVenues?: any[];
  stayVenues?: any[];
  experiences?: any[];
  itineraries?: any[];
  articles?: any[];
  relatedPlaces?: any[];
}

const {
  place,
  eatVenues = [],
  wineVenues = [],
  stayVenues = [],
  experiences = [],
  itineraries = [],
  articles = [],
  relatedPlaces = [],
} = Astro.props;

const data = place.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const placeSlug = routeSlug(place);

const heroImage = data.heroImage?.src && !data.heroImage.src.includes('placeholder')
  ? (data.heroImage.src.startsWith('/') ? `${base}${data.heroImage.src.slice(1)}` : data.heroImage.src)
  : `${base}images/sourced/home-cover.webp`;

const zoneLabel: Record<string, string> = {
  'bayside': 'Bay Coast',
  'hinterland': 'Hinterland',
  'red-hill-plateau': 'Red Hill Plateau',
  'ocean-coast': 'Ocean Coast',
  'back-beaches': 'Back Beaches',
  'tip': 'Tip of the Peninsula',
};

const introParas = String(data.intro ?? '').split(/\n\n+/).filter(Boolean);

const totalVenues = (eatVenues?.length ?? 0) + (wineVenues?.length ?? 0) + (stayVenues?.length ?? 0);

// Helper for resolving a venue's detail href based on type
function venueHref(type: string) {
  if (stayTypes.includes(type)) return `${base}stay/`;
  if (wineTypes.includes(type)) return `${base}wine/`;
  return `${base}eat/`;
}

function resolveImage(src?: string) {
  if (!src || src.includes('placeholder')) return `${base}images/sourced/home-cover.webp`;
  return src.startsWith('/') ? `${base}${src.slice(1)}` : src;
}
/* Humanised duration: nobody thinks in "600 min". */
function formatDuration(m: number): string {
  if (m < 60) return `${m} min`;
  const whole = Math.floor(m / 60);
  return m % 60 >= 30 ? `${whole}.5 h` : `${whole} h`;
}

---

<section class="hero" aria-label={`${data.name} cover`}>
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <a href={`${base}places/`} class="hero__meta-tag" style="color:inherit;text-decoration:none;">Places</a>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">{zoneLabel[data.zone] ?? titleize(data.zone)} <span class="ornament">·</span> {titleize(data.kind)}</span>
        </div>
        <h1 class="hero__headline">{data.name}</h1>
        {introParas[0] && <p class="hero__dek">{introParas[0]}</p>}
        <div class="hero__byline">
          <span> - A guide to <strong>{data.name}</strong></span>
          {totalVenues > 0 && (
            <span class="hero__byline-read">{totalVenues} venue{totalVenues === 1 ? '' : 's'} mapped</span>
          )}
        </div>
      </div>
      <figure>
        <img class="hero__image" src={heroImage} alt={`${data.name}, Mornington Peninsula`} loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>{data.name} <span class="ornament"> - </span> {zoneLabel[data.zone] ?? titleize(data.zone)}</span>
          <span>Photography <span class="ornament">/</span> The Insider</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-labelledby={`place-${placeSlug}`}>
  <div class="container">
    <div class="letter__frame">
      <div class="letter__body">
        <div class="letter__eyebrow">
          <span class="letter__eyebrow-rule"></span>
          <span class="eyebrow eyebrow--ochre">The Insider's take</span>
        </div>
        <h2 class="letter__head" id={`place-${placeSlug}`}>On <em>{data.name}</em>.</h2>
        <div class="letter__prose">
          {introParas.slice(1).map((p: string) => <p>{p}</p>)}
          {introParas.length === 1 && <p>{introParas[0]}</p>}
          {data.tldr && data.tldr.length > 0 && (
            <>
              <blockquote class="pullquote">{data.tldr[0]}</blockquote>
              {data.tldr.length > 1 && (
                <ul>
                  {data.tldr.slice(1).map((line: string) => <li>{line}</li>)}
                </ul>
              )}
            </>
          )}
        </div>
      </div>

      <aside class="letter__side">
        <div class="facts-card" style="background:rgba(0,0,0,0.03); padding:1.75rem; border:1px solid rgba(0,0,0,0.08);">
          <p class="eyebrow eyebrow--ochre" style="margin-bottom:1rem;">At a glance</p>
          <dl style="display:grid; grid-template-columns:auto 1fr; gap:.6rem 1rem; font-family:var(--sans,'Inter'),sans-serif; font-size:.92rem;">
            <dt style="font-weight:500;">Kind</dt>
            <dd style="margin:0;">{titleize(data.kind)}</dd>

            <dt style="font-weight:500;">Subregion</dt>
            <dd style="margin:0;">{zoneLabel[data.zone] ?? titleize(data.zone)}</dd>

            {data.driveTime && (<>
              <dt style="font-weight:500;">From Melbourne</dt>
              <dd style="margin:0;">{data.driveTime}</dd>
            </>)}

            {eatVenues.length > 0 && (<>
              <dt style="font-weight:500;">Eat &amp; drink</dt>
              <dd style="margin:0;">{eatVenues.length} venue{eatVenues.length === 1 ? '' : 's'}</dd>
            </>)}

            {wineVenues.length > 0 && (<>
              <dt style="font-weight:500;">Wine</dt>
              <dd style="margin:0;">{wineVenues.length} cellar door{wineVenues.length === 1 ? '' : 's'}</dd>
            </>)}

            {stayVenues.length > 0 && (<>
              <dt style="font-weight:500;">Stay</dt>
              <dd style="margin:0;">{stayVenues.length} place{stayVenues.length === 1 ? '' : 's'} to sleep</dd>
            </>)}

            {experiences.length > 0 && (<>
              <dt style="font-weight:500;">Explore</dt>
              <dd style="margin:0;">{experiences.length} walk{experiences.length === 1 ? '' : 's'} &amp; lookout{experiences.length === 1 ? '' : 's'}</dd>
            </>)}
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>

{eatVenues.length > 0 && (
  <section class="dept" aria-labelledby="eat-drink-title" id="eat-drink">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> I</span>
          <h2 class="dept__title" id="eat-drink-title">Eat <em>&amp;</em> drink in {data.name}</h2>
          <p class="dept__dek">The restaurants, cafés, bakeries, and pubs on our current list - visited this season and worth the seat.</p>
        </div>
        <a href={`${base}eat/`} class="well__head-link">All restaurants →</a>
      </div>
      <div class="dept__grid">
        {eatVenues.map((v: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(v.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{typeLabel[v.data.type] ?? titleize(v.data.type)}</span>
              {v.data.authority?.hats > 0 && <span class="venue__image-hat">{v.data.authority.hats} hat{v.data.authority.hats > 1 ? 's' : ''}</span>}
            </div>
            <div class="venue__meta">
              <span>{data.name}</span>
              <span class="venue__meta-sep"></span>
              <span>{v.data.priceBand}</span>
            </div>
            <a href={`${base}eat/${routeSlug(v)}/`}><h3 class="venue__name">{v.data.name}</h3></a>
            <p class="venue__sig">{v.data.signature}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{wineVenues.length > 0 && (
  <section class="dept" aria-labelledby="wine-title" id="wine">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> II</span>
          <h2 class="dept__title" id="wine-title">Wine <em>&amp;</em> producers</h2>
          <p class="dept__dek">Cellar doors, producers, and makers close enough to fit into a half day from {data.name}.</p>
        </div>
        <a href={`${base}wine/`} class="well__head-link">All cellar doors →</a>
      </div>
      <div class="dept__grid">
        {wineVenues.map((v: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(v.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{typeLabel[v.data.type] ?? titleize(v.data.type)}</span>
            </div>
            <div class="venue__meta">
              <span>{data.name}</span>
              <span class="venue__meta-sep"></span>
              <span>{v.data.priceBand}</span>
            </div>
            <a href={`${base}wine/${routeSlug(v)}/`}><h3 class="venue__name">{v.data.name}</h3></a>
            <p class="venue__sig">{v.data.signature}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{stayVenues.length > 0 && (
  <section class="dept" aria-labelledby="stay-title" id="stay">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> III</span>
          <h2 class="dept__title" id="stay-title">Stay in <em>{data.name}</em></h2>
          <p class="dept__dek">The hotels, villas, cottages, and farmstays that turn {data.name} from a stop into a base.</p>
        </div>
        <a href={`${base}stay/`} class="well__head-link">All stays →</a>
      </div>
      <div class="dept__grid">
        {stayVenues.map((v: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(v.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{typeLabel[v.data.type] ?? titleize(v.data.type)}</span>
            </div>
            <div class="venue__meta">
              <span>{data.name}</span>
              <span class="venue__meta-sep"></span>
              <span>{v.data.priceBand}</span>
            </div>
            <a href={`${base}stay/${routeSlug(v)}/`}><h3 class="venue__name">{v.data.name}</h3></a>
            <p class="venue__sig">{v.data.signature}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{experiences.length > 0 && (
  <section class="dept" aria-labelledby="explore-title" id="explore">
    <div class="container">
      <div class="dept__head">
        <div class="dept__titles">
          <span class="eyebrow eyebrow--ochre">Department <span class="ornament">·</span> IV</span>
          <h2 class="dept__title" id="explore-title">Walks, beaches <em>&amp;</em> lookouts</h2>
          <p class="dept__dek">Experiences connected into {data.name} rather than floating off on their own.</p>
        </div>
        <a href={`${base}explore/`} class="well__head-link">All experiences →</a>
      </div>
      <div class="dept__grid">
        {experiences.map((e: any) => (
          <article class="venue">
            <div class="venue__image" style={`background-image:url(${resolveImage(e.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="venue__image-marker">{titleize(e.data.type)}</span>
            </div>
            <div class="venue__meta">
              <span>{data.name}</span>
              {e.data.durationMinutes && (<>
                <span class="venue__meta-sep"></span>
                <span>{formatDuration(e.data.durationMinutes)}</span>
              </>)}
            </div>
            <a href={`${base}explore/${routeSlug(e)}/`}><h3 class="venue__name">{e.data.name}</h3></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{itineraries.length > 0 && (
  <section class="escapes" aria-labelledby="place-escapes">
    <div class="container">
      <div class="escapes__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Plans that pass through</span>
          <h2 class="dept__title" id="place-escapes" style="margin-top:.5rem;">Escapes that work out of <em>{data.name}</em>.</h2>
        </div>
        <a href={`${base}escape/`} class="well__head-link">All escape plans →</a>
      </div>
      <div class="escapes__grid">
        {itineraries.map((it: any) => (
          <article class="escape">
            <div class="escape__image" style={`background-image:url(${resolveImage(it.data.heroImage?.src)});background-size:cover;background-position:center;`}>
              <span class="escape__image-tag"><strong>{it.data.lengthNights}</strong> night{it.data.lengthNights === 1 ? '' : 's'}</span>
            </div>
            <div class="escape__body">
              <span class="escape__eyebrow">Plan <span class="ornament">·</span> {titleize(it.data.mood)}</span>
              <a href={`${base}escape/${routeSlug(it)}/`}><h3 class="escape__title">{it.data.title}</h3></a>
              <p class="escape__dek">{it.data.dek}</p>
              <div class="escape__foot">
                <span>{titleize(it.data.audience)} <span class="ornament">·</span> {it.data.stops.length} stops</span>
                <span class="escape__foot-read">Plan →</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{articles.length > 0 && (
  <section class="well" aria-labelledby="place-reads">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">From the journal</span>
          <h2 class="well__head-title" id="place-reads" style="margin-top:.5rem;">Further <em>reading</em> on {data.name}.</h2>
        </div>
        <a href={`${base}journal/`} class="well__head-link">All journal →</a>
      </div>
      <div class="well__grid">
        {articles.map((a: any, i: number) => (
          <article class={i === 0 ? 'feat feat--lead' : 'feat feat--std'}>
            <img class="feat__image" src={resolveImage(a.data.heroImage?.src)} alt={a.data.title} loading="lazy">
            <div class="feat__body">
              <div class="feat__eyebrow">Journal <span class="ornament"> - </span> {titleize(a.data.format ?? 'guide')}</div>
              <a href={`${base}journal/${routeSlug(a)}/`}><h3 class="feat__title">{a.data.title}</h3></a>
              {a.data.dek && <p class="feat__excerpt">{a.data.dek}</p>}
              <div class="feat__byline">
                <span>{a.data.publishedAt?.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' }) ?? ''}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{relatedPlaces.length > 0 && (
  <section class="places" aria-labelledby="related-places">
    <div class="container">
      <div class="places__head">
        <div>
          <span class="eyebrow eyebrow--ochre">Nearby</span>
          <h2 class="dept__title" id="related-places" style="margin-top:.5rem;">Other towns <em>worth pairing</em>.</h2>
        </div>
        <a href={`${base}places/`} class="well__head-link">All places →</a>
      </div>
      <div class="places__grid">
        {relatedPlaces.map((p: any) => (
          <a href={`${base}places/${routeSlug(p)}/`} class="place">
            <div class="place__image" style={`background-image:url(${resolveImage(p.data.heroImage?.src)});background-size:cover;background-position:center;`}></div>
            <div class="place__name">{p.data.name}</div>
            <div class="place__count">{zoneLabel[p.data.zone] ?? titleize(p.data.zone)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
