---
import { routeSlug, titleize } from '../../lib/editorial';

export interface Props {
  article: any;
  Content: any;
  related?: any[];
  relatedVenues?: any[];
}

const { article, Content, related = [] } = Astro.props;
const data = article.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const heroImage = data.heroImage?.src && !data.heroImage.src.includes('placeholder')
  ? (data.heroImage.src.startsWith('/') ? `${base}${data.heroImage.src.slice(1)}` : data.heroImage.src)
  : `${base}images/sourced/home-cover.webp`;

const pubDate = data.publishedAt
  ? data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

const byline = data.author ?? 'The Editors';
const readMin = data.readingMinutes ?? Math.max(5, Math.round((data.wordCount ?? 1200) / 220));
const format = data.format ?? 'guide';
---

<section class="hero" aria-label="Article cover">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__above">
        <div class="hero__meta">
          <span class="hero__meta-tag">Journal</span>
          <span class="hero__meta-divider"></span>
          <span class="hero__meta-date">{titleize(format)} <span class="ornament">—</span> {pubDate}</span>
        </div>
        <h1 class="hero__headline">{data.title}</h1>
        {data.excerpt && <p class="hero__dek">{data.excerpt}</p>}
        <div class="hero__byline">
          <span>— By <strong>{byline}</strong></span>
          <span class="hero__byline-read">{readMin} min read</span>
        </div>
      </div>
      <figure>
        <img class="hero__image" src={heroImage} alt={data.title} loading="eager" fetchpriority="high">
        <figcaption class="hero__image-cap">
          <span>{data.title}</span>
          <span>Peninsula Insider <span class="ornament">/</span> {pubDate}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="letter" aria-label="Article body">
  <div class="container">
    <div class="letter__frame" style="display:block; max-width:46rem; margin-inline:auto;">
      <div class="letter__body">
        <div class="letter__prose v2-article-body">
          <Content />
        </div>
        <div class="letter__sig">
          <span class="letter__sig-mark">—</span>
          <div>
            <div class="letter__sig-name">{byline}</div>
            <div class="letter__sig-role">Peninsula Insider <span class="ornament">·</span> {pubDate}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="well" aria-labelledby="more-reading">
    <div class="container">
      <div class="well__head">
        <div>
          <span class="eyebrow eyebrow--ochre">More like this</span>
          <h2 class="well__head-title" id="more-reading" style="margin-top:.5rem;">Keep <em>reading</em>.</h2>
        </div>
        <a href={`${base}journal/`} class="well__head-link">All journal →</a>
      </div>
      <div class="well__grid">
        {related.map((a: any, i: number) => {
          const aData = a.data;
          const aHero = aData.heroImage?.src && !aData.heroImage.src.includes('placeholder')
            ? (aData.heroImage.src.startsWith('/') ? `${base}${aData.heroImage.src.slice(1)}` : aData.heroImage.src)
            : `${base}images/sourced/home-cover.webp`;
          return (
            <article class={i === 0 ? 'feat feat--lead' : 'feat feat--std'}>
              <img class="feat__image" src={aHero} alt={aData.title} loading="lazy">
              <div class="feat__body">
                <div class="feat__eyebrow">Journal <span class="ornament">—</span> {titleize(aData.format ?? 'guide')}</div>
                <a href={`${base}journal/${routeSlug(a)}/`}><h3 class="feat__title">{aData.title}</h3></a>
                {aData.excerpt && <p class="feat__excerpt">{aData.excerpt}</p>}
                <div class="feat__byline">
                  <span>{aData.publishedAt?.toLocaleDateString('en-AU', { month: 'long', year: 'numeric' }) ?? ''}</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style is:global>
  .v2-article-body h2 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-feature-settings: 'opsz' 32;
  }
  .v2-article-body h3 {
    font-family: var(--serif, 'Newsreader'), serif;
    font-weight: 500;
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
  .v2-article-body p { margin-bottom: 1.2rem; }
  .v2-article-body blockquote {
    border-left: 3px solid var(--ochre, #a0612d);
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-family: var(--serif, 'Newsreader'), serif;
    font-style: italic;
    font-size: 1.2rem;
  }
  .v2-article-body ul, .v2-article-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .v2-article-body li { margin-bottom: .5rem; }
  .v2-article-body a {
    color: var(--ochre, #a0612d);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>
