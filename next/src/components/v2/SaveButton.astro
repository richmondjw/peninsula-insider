---
/* SaveButton — bookmark an article to /account/saved/. */

export interface Props {
  slug: string;
  section: string;
  title?: string;
  dek?: string;
  imageUrl?: string;
}
const { slug, section, title, dek, imageUrl } = Astro.props;
---

<button
  class="v2-save"
  type="button"
  data-save-slug={slug}
  data-save-section={section}
  data-save-title={title}
  data-save-dek={dek}
  data-save-image={imageUrl}
  aria-pressed="false"
  aria-label="Save this article"
>
  <svg class="v2-save__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
  </svg>
  <span class="v2-save__label">Save</span>
</button>

<script>
  import { onAuthChange } from '../../lib/auth';
  import * as Saves from '../../lib/saves/store';

  /**
   * Article SaveButton — thin UI on top of the unified `pi:saves:v2` local
   * store. The cloud mirror happens transparently via lib/saves/cloud.ts
   * when the user is signed in (installed from BaseLayout).
   *
   * Wave 3 of the Save & Share rebuild replaces this widget entirely with
   * `<PiArticleActions />`. Keeping the existing button alive in the
   * interim so the journal article surface still works.
   */

  async function hydrateButton(btn: HTMLButtonElement) {
    if ((btn as any)._init) return;
    (btn as any)._init = true;

    const slug = btn.dataset.saveSlug as string;
    const section = btn.dataset.saveSection as string;
    const snapshot = {
      title: btn.dataset.saveTitle || slug,
      dek: btn.dataset.saveDek,
      image_url: btn.dataset.saveImage,
    };
    const labelEl = btn.querySelector('.v2-save__label') as HTMLElement;

    function paint(saved: boolean) {
      btn.classList.toggle('is-saved', saved);
      btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
      labelEl.textContent = saved ? 'Saved' : 'Save';
    }

    function refresh() {
      paint(Saves.isSaved('article', slug));
    }

    btn.addEventListener('click', () => {
      Saves.toggle({
        kind: 'article',
        slug,
        section,
        title: snapshot.title,
        dek: snapshot.dek,
        image_url: snapshot.image_url,
        href: `/${section}/${slug}/`,
      });
      // Repaint via the change listener below; this branch left intentionally
      // empty for the optimistic write to settle.
      void 0;
    });

    refresh();
    Saves.onChange(refresh);
    onAuthChange(refresh);
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>('.v2-save').forEach(hydrateButton);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  .v2-save {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.55rem 1rem;
    background: transparent;
    border: 1px solid var(--line, #D9D1BE);
    border-radius: 100px;
    font: inherit;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.82rem; font-weight: 500;
    color: var(--ink-soft, #3A3531);
    cursor: pointer;
    transition: border-color .18s ease, color .18s ease, background .18s ease;
  }
  .v2-save:hover { border-color: var(--ink, #171413); color: var(--ink, #171413); }
  .v2-save.is-saved {
    border-color: var(--ink, #171413);
    background: var(--ink, #171413);
    color: var(--paper, #FAF7F0);
  }
  .v2-save.is-saved .v2-save__icon { fill: var(--paper, #FAF7F0); }
  .v2-save.is-disabled { opacity: 0.6; cursor: not-allowed; }
  .v2-save__label { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; }
</style>
