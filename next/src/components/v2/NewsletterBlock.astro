---
export interface Props {
  title?: string;
  body?: string;
  issueNumber?: string;
  issueDate?: string;
  previewHeadline?: string;
  previewItems?: string[];
}
const {
  title = 'The briefing that <em>arrives weekly</em>.',
  body = 'One email. The weekend\'s pick, the tables that have opened up, the cellar doors with windows this week, and the walk worth doing before it\'s too cold. Read in five minutes, used all weekend.',
  issueNumber = '№ 214',
  issueDate = 'Latest edition',
  previewHeadline = 'A <em>quiet</em> autumn weekend — the post-Easter reset.',
  previewItems = [
    'The cellar-door shortlist lands — five producers, ranked.',
    'Laura opens three extra Sunday lunches for autumn.',
    'The long-lunch piece — three Italian rooms that actually matter.',
    'Weather brief: dry, cool, best light of the year.',
    'One walk worth doing: Bushrangers Bay before sunset.',
  ],
} = Astro.props;
---
<section class="newsletter" id="newsletter" aria-labelledby="newsletter-title">
  <div class="container">
    <div class="newsletter__frame">
      <div class="newsletter__copy">
        <div class="newsletter__eyebrow">Peninsula This Weekend</div>
        <h2 class="newsletter__title" id="newsletter-title" set:html={title} />
        <p class="newsletter__body">{body}</p>

        <form class="newsletter__form" data-subscribe-form onsubmit="event.preventDefault();">
          <input class="newsletter__input" type="email" name="email" placeholder="your@email.com" aria-label="Email address" required>
          <button class="newsletter__submit" type="submit">Subscribe</button>
        </form>

        <div class="newsletter__meta">
          <span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
            Unsubscribe any time
          </span>
        </div>
      </div>

      <div class="newsletter__preview" aria-hidden="true">
        <div class="np__head">
          <span class="np__mark">Peninsula This Weekend</span>
          <span class="np__issue">{issueNumber} · {issueDate}</span>
        </div>
        <h3 class="np__title" set:html={previewHeadline} />
        <ul class="np__items">
          {previewItems.map((item) => <li>{item}</li>)}
        </ul>
        <div class="np__foot">Read in 4 minutes · Used all weekend</div>
      </div>
    </div>
  </div>
</section>
