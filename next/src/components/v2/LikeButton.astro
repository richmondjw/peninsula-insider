---
/* LikeButton — heart count for an article.
   Anonymous users: greyed out, click opens auth modal.
   Signed-in users: click toggles like, count updates optimistically. */

export interface Props {
  slug: string;        // path slug, e.g. 'the-cellar-door-short-list'
  section: string;     // 'journal' | 'eat' | 'stay' | etc.
}
const { slug, section } = Astro.props;
---

<button
  class="v2-like"
  type="button"
  data-like-slug={slug}
  data-like-section={section}
  aria-pressed="false"
  aria-label="Like this article"
>
  <svg class="v2-like__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
  </svg>
  <span class="v2-like__count" data-like-count>—</span>
  <span class="v2-like__label">Like</span>
</button>

<script>
  import { getUser, getLikeCount, isLikedByUser, toggleLike, onAuthChange, isAuthEnabled } from '../../lib/auth';

  async function hydrateButton(btn: HTMLButtonElement) {
    if ((btn as any)._init) return;
    (btn as any)._init = true;

    const slug = btn.dataset.likeSlug as string;
    const section = btn.dataset.likeSection as string;
    const countEl = btn.querySelector('[data-like-count]') as HTMLElement;

    async function refresh() {
      const count = await getLikeCount(slug);
      countEl.textContent = String(count);
      const u = await getUser();
      if (u) {
        const liked = await isLikedByUser(slug, u.id);
        btn.classList.toggle('is-liked', liked);
        btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
      } else {
        btn.classList.remove('is-liked');
        btn.setAttribute('aria-pressed', 'false');
      }
    }

    btn.addEventListener('click', async () => {
      const u = await getUser();
      if (!u) {
        document.dispatchEvent(new CustomEvent('pi:open-auth'));
        return;
      }
      // optimistic
      const wasLiked = btn.classList.contains('is-liked');
      btn.classList.toggle('is-liked', !wasLiked);
      const cur = parseInt(countEl.textContent || '0', 10) || 0;
      countEl.textContent = String(Math.max(0, cur + (wasLiked ? -1 : 1)));
      btn.setAttribute('aria-pressed', wasLiked ? 'false' : 'true');
      try {
        const { liked, count } = await toggleLike(slug, section, u.id);
        btn.classList.toggle('is-liked', liked);
        btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
        countEl.textContent = String(count);
      } catch {
        // rollback
        btn.classList.toggle('is-liked', wasLiked);
        countEl.textContent = String(cur);
        btn.setAttribute('aria-pressed', wasLiked ? 'true' : 'false');
      }
    });

    refresh();
    onAuthChange(refresh);
  }

  function init() {
    if (!isAuthEnabled()) {
      document.querySelectorAll<HTMLButtonElement>('.v2-like').forEach((b) => {
        b.classList.add('is-disabled');
        b.title = 'Sign-in not yet configured';
      });
      return;
    }
    document.querySelectorAll<HTMLButtonElement>('.v2-like').forEach(hydrateButton);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  .v2-like {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.55rem 1rem;
    background: transparent;
    border: 1px solid var(--line, #D9D1BE);
    border-radius: 100px;
    font: inherit;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.82rem; font-weight: 500;
    color: var(--ink-soft, #3A3531);
    cursor: pointer;
    transition: border-color .18s ease, color .18s ease, background .18s ease;
  }
  .v2-like:hover { border-color: var(--ochre, #A0541F); color: var(--ochre, #A0541F); }
  .v2-like.is-liked {
    border-color: var(--ochre, #A0541F);
    background: var(--paper-warm, #F3EDDE);
    color: var(--ochre, #A0541F);
  }
  .v2-like.is-liked .v2-like__icon { fill: var(--ochre, #A0541F); }
  .v2-like.is-disabled { opacity: 0.6; cursor: not-allowed; }
  .v2-like__count { font-variant-numeric: tabular-nums; min-width: 1.2em; text-align: right; }
  .v2-like__label { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; }

  /* Wrapper around like + save on the journal article */
  .v2-article-actions {
    display: flex;
    gap: 0.6rem;
    margin: 2.5rem 0 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line, #D9D1BE);
  }
</style>
