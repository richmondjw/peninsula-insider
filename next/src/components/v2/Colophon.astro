---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<footer class="colophon">
  <div class="container">
    <div class="colophon__head">
      <div class="colophon__wordmark">Peninsula <em>Insider</em></div>
      <div class="colophon__motto">— the independent guide to the Mornington Peninsula.</div>
    </div>

    <div class="colophon__grid">
      <div class="col-sect col-sect--brand">
        <p>An editorial product about one small, well-defined place. Every venue visited. Every opinion earned. Dispatched every Wednesday at 6 pm.</p>
        <span class="label">Vol 04 <span class="ornament">·</span> Autumn 2026 issue <span class="ornament">·</span> Published in Victoria.</span>
      </div>

      <nav class="col-sect" aria-label="Departments">
        <p class="col-sect__title">Departments</p>
        <ul>
          <li><a href={`${base}eat/`}>Eat &amp; Drink</a></li>
          <li><a href={`${base}stay/`}>Stay</a></li>
          <li><a href={`${base}wine/`}>Wine Country</a></li>
          <li><a href={`${base}explore/`}>Explore</a></li>
          <li><a href={`${base}golf/`}>Golf</a></li>
          <li><a href={`${base}spa/`}>Spa &amp; Wellness</a></li>
          <li><a href={`${base}escape/`}>Escape</a></li>
          <li><a href={`${base}journal/`}>Journal</a></li>
        </ul>
      </nav>

      <nav class="col-sect" aria-label="Places">
        <p class="col-sect__title">Places</p>
        <ul>
          <li><a href={`${base}places/red-hill/`}>Red Hill</a></li>
          <li><a href={`${base}places/sorrento/`}>Sorrento</a></li>
          <li><a href={`${base}places/flinders/`}>Flinders</a></li>
          <li><a href={`${base}places/mornington/`}>Mornington</a></li>
          <li><a href={`${base}places/portsea/`}>Portsea</a></li>
          <li><a href={`${base}places/main-ridge/`}>Main Ridge</a></li>
          <li><a href={`${base}places/`}>All places</a></li>
        </ul>
      </nav>

      <nav class="col-sect" aria-label="Colophon">
        <p class="col-sect__title">Colophon</p>
        <ul>
          <li><a href={`${base}about/`}>About the Insider</a></li>
          <li><a href={`${base}about/`}>Editorial standards</a></li>
          <li><a href={`${base}contact/`}>Contact</a></li>
          <li><a href={`${base}newsletter/`}>Newsletter</a></li>
          <li><a href={`${base}privacy/`}>Privacy</a></li>
          <li><a href={`${base}terms/`}>Terms</a></li>
        </ul>
      </nav>
    </div>

    <div class="colophon__foot">
      <span>© 2026 Peninsula Insider <span class="ornament">·</span> All rights reserved.</span>
      <span><em>Built on the Peninsula, for the Peninsula.</em></span>
    </div>
  </div>
</footer>
