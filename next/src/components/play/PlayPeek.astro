---
/**
 * PlayPeek - the one gentle nudge.
 *
 * PI's hat slides up in the corner once, with a line of copy, on content
 * pages only. Rules, all enforced in the script below:
 *   - detail pages only (journal, eat, wine, stay, explore, whats-on);
 *     never the homepage, account, plan, pass, partner or admin surfaces
 *   - never the ranked editorial guides (/explore/walks/, golf, beaches,
 *     plans), nor any page that marks <body> or <main> with data-no-peek:
 *     a toast over a ranking covers the page's most important fold
 *   - waits for the cookie banner to be answered, and stands down for the
 *     session if the Insider Note popup has already shown itself
 *   - fires only once the reader has scrolled past 70% of the page, and
 *     never within 4s of load, so it lands after the reading, not on it
 *   - docks 24px from the viewport corner on desktop
 *   - once per 7 days per browser; dismiss remembered for 30 days
 *   - reduce-motion: no slide, just appears
 *   - mobile: a slim bar above the bottom quick-actions bar
 */
import { PLAY, playUrl, PRIZE_LINE } from '../../lib/play';
const href = playUrl('peek');
---

{PLAY.enabled && (
  <aside class="play-peek" id="play-peek" hidden aria-label="Where in the Peninsula is PI?">
    <img class="play-peek__mark" src="/images/play/pi-mark-still-96.png" srcset="/images/play/pi-mark-still-96.png 1x, /images/play/pi-mark-still-192.png 2x" width="56" height="52" alt="" decoding="async" />
    <div class="play-peek__text">
      <p class="play-peek__lead">She&rsquo;s out again.</p>
      <p class="play-peek__copy">Play Case {PLAY.case.id}, find her before sunset. {PRIZE_LINE}</p>
    </div>
    <a class="play-peek__cta pi-btn pi-btn--solid pi-btn--sm" href={href} data-evt="pi_play_promo" data-surface="peek" data-position="cta">Play</a>
    <button type="button" class="play-peek__close" aria-label="Not now" data-play-peek-close>&times;</button>
  </aside>
)}

<script>
  const KEY = 'pi-play-peek-v1';
  const SHOW_EVERY = 7 * 24 * 3600 * 1000;
  const DISMISS_FOR = 30 * 24 * 3600 * 1000;
  const CONTENT = /^\/(journal|eat|wine|stay|explore|whats-on)\/[^/]+\/?/;
  // Ranked editorial guides: the ranking is the page, so nothing floats on it.
  const GUIDES = /^\/explore\/(walks|golf|beaches|plans)\/?$/;
  const SCROLL_AT = 0.7;
  const QUIET_MS = 4000;

  function optedOut() {
    return document.body?.hasAttribute('data-no-peek') || !!document.querySelector('main[data-no-peek]');
  }

  function read(): { shown?: number; dismissed?: number } {
    try { return JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch { return {}; }
  }
  function write(v: Record<string, number>) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} }
  function consentAnswered() { try { return !!localStorage.getItem('pi-consent-v1'); } catch { return true; } }

  // `document` and `window` outlive an Astro client-router swap, but
  // initPlayPeek() re-runs on every astro:page-load and the `dataset.bound`
  // guard sits on #play-peek, which the swap replaces. The guard was therefore
  // always fresh while the listeners were not: each navigation added another
  // inote pair, another scroll listener and another 45s timer, all closed over
  // the previous page's element. A stale timer firing still wrote the shown
  // timestamp and sent a pi_play_promo impression for a peek nobody could see.
  // Everything global is registered once at module scope here; initPlayPeek()
  // publishes the current page's element into the slot, and clears it (and the
  // pending timer) when the page is left.
  let activeEl: HTMLElement | null = null;
  let activeState: { shown?: number; dismissed?: number } = {};
  let noteShown = false;
  let fired = false;
  let timer = 0;
  let loadedAt = 0;

  function stopTimer() {
    if (timer) { clearTimeout(timer); timer = 0; }
  }

  function show() {
    const el = activeEl;
    if (!el || fired) return;
    const quietLeft = QUIET_MS - (Date.now() - loadedAt);
    if (quietLeft > 0) {
      stopTimer();
      timer = window.setTimeout(show, quietLeft);
      return;
    }
    if (noteShown || !consentAnswered() || document.querySelector('#inote:not([hidden])')) {
      stopTimer();
      timer = window.setTimeout(show, 5000);
      return;
    }
    fired = true;
    stopTimer();
    el.hidden = false;
    requestAnimationFrame(() => { el.dataset.in = 'true'; });
    write({ ...activeState, shown: Date.now() });
    (window as any).gtag?.('event', 'pi_play_promo', { surface: 'peek', position: 'impression' });
  }

  document.addEventListener('inote_open', () => { noteShown = true; });
  document.addEventListener('inote_impression', () => { noteShown = true; });

  window.addEventListener('scroll', () => {
    if (!activeEl || fired) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (max > 0 && window.scrollY / max >= SCROLL_AT) show();
  }, { passive: true });

  function initPlayPeek() {
    const el = document.getElementById('play-peek');
    // Same element as last run (first load calls this twice): leave the
    // pending timer and the slot exactly as they are.
    if (el && el.dataset.bound) return;
    stopTimer();
    activeEl = null;
    noteShown = false;
    fired = false;
    if (!el) return;
    el.dataset.bound = '1';
    if (!CONTENT.test(location.pathname) || GUIDES.test(location.pathname) || optedOut()) return;
    const s = read();
    const now = Date.now();
    if (s.dismissed && now - s.dismissed < DISMISS_FOR) return;
    if (s.shown && now - s.shown < SHOW_EVERY) return;

    // No time-based trigger: the scroll listener above is the only way in,
    // and show() holds anything that arrives inside the quiet window.
    activeEl = el;
    activeState = s;
    loadedAt = now;

    el.querySelector('[data-play-peek-close]')?.addEventListener('click', () => {
      el.dataset.in = 'false';
      setTimeout(() => { el.hidden = true; }, 320);
      write({ ...read(), dismissed: Date.now() });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPlayPeek);
  else initPlayPeek();
  document.addEventListener('astro:page-load', initPlayPeek);
</script>

<style>
  .play-peek {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: min(22rem, calc(100vw - 2 * var(--space-5)));
    max-width: 22rem;
    padding: var(--space-3) 3rem var(--space-3) var(--space-4);
    background: var(--white);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    box-shadow: 0 16px 40px rgba(11, 46, 74, 0.16);
    font-family: var(--font-ui);
    transform: translateY(24px);
    opacity: 0;
    transition: transform 0.32s ease, opacity 0.32s ease;
  }
  .play-peek[data-in="true"] { transform: none; opacity: 1; }
  .play-peek__mark { flex: none; width: 56px; height: auto; }
  .play-peek__text { flex: 1 1 auto; min-width: 0; }
  .play-peek__lead { margin: 0 0 2px; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1.1; }
  .play-peek__copy { margin: 0; font-size: var(--fs-200); line-height: 1.4; color: var(--soft, #5B6770); }
  .play-peek__cta { flex: none; }
  .play-peek__close {
    position: absolute; top: 2px; right: 2px;
    width: 44px; height: 44px; border: 0; background: transparent; color: var(--soft);
    font-size: 20px; line-height: 1; cursor: pointer; border-radius: 50%;
  }
  .play-peek__close:hover { background: var(--bg-alt, #F7F4EE); color: var(--text); }
  @media (max-width: 767px) {
    .play-peek {
      right: var(--space-3); left: var(--space-3); width: auto; max-width: none;
      bottom: calc(56px + env(safe-area-inset-bottom) + var(--space-3));
      padding: var(--space-2) 3rem var(--space-2) var(--space-3);
    }
    .play-peek__mark { width: 40px; }
    .play-peek__copy { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .play-peek { transition: opacity 0.2s ease; transform: none; }
  }
  @media print { .play-peek { display: none; } }
</style>
