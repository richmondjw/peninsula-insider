---
/**
 * DispatchPickCard - one structured pick (Lead / Saturday / Sunday / Rainy day)
 * inside the Peninsula This Weekend dispatch. Renders a print-shaped card
 * with eyebrow label, title, structured details list, summary, and CTA row.
 *
 * Powered by the `dispatch.{lead|saturday|sunday|rainyDay}` frontmatter
 * payload on weekend-picker articles. Keeps the page and the weekly HTML
 * email in lockstep - same data shape, different rendering.
 */

interface Pick {
  title: string;
  when: string;
  where: string;
  price?: string;
  who?: string;
  summary: string;
  bookingLabel?: string;
  bookingUrl?: string;
  eventRef?: string;
}

interface Props {
  eyebrow: string;       // "The lead booking", "Saturday", "Sunday", "If the weather changes"
  rank?: string;         // "01", "02", "03" for numeral
  variant?: 'lead' | 'standard' | 'backup';
  pick: Pick;
}

const { eyebrow, rank, variant = 'standard', pick } = Astro.props;
const eventHref = pick.eventRef ? `/whats-on/${pick.eventRef}/` : null;
---

<article class={`dispatch-pick dispatch-pick--${variant}`}>
  <header class="dispatch-pick__head">
    <div class="dispatch-pick__eyebrow-row">
      {rank && <span class="dispatch-pick__rank" aria-hidden="true">{rank}</span>}
      <p class="dispatch-pick__eyebrow">{eyebrow}</p>
    </div>
    <h3 class="dispatch-pick__title">{pick.title}</h3>
  </header>

  <dl class="dispatch-pick__facts">
    <div class="dispatch-pick__fact">
      <dt>When</dt>
      <dd>{pick.when}</dd>
    </div>
    <div class="dispatch-pick__fact">
      <dt>Where</dt>
      <dd>{pick.where}</dd>
    </div>
    {pick.price && (
      <div class="dispatch-pick__fact">
        <dt>Price</dt>
        <dd>{pick.price}</dd>
      </div>
    )}
    {pick.who && (
      <div class="dispatch-pick__fact">
        <dt>Who</dt>
        <dd>{pick.who}</dd>
      </div>
    )}
  </dl>

  <p class="dispatch-pick__summary">{pick.summary}</p>

  <div class="dispatch-pick__actions">
    {pick.bookingUrl ? (
      <a
        class="pi-btn pi-btn--solid pi-btn--sm"
        href={pick.bookingUrl}
        rel="nofollow noreferrer"
        target="_blank"
      >
        {pick.bookingLabel ?? 'Book this'} →
      </a>
    ) : pick.bookingLabel ? (
      <span class="dispatch-pick__cta dispatch-pick__cta--plain">{pick.bookingLabel}</span>
    ) : null}
    {eventHref && (
      <a class="dispatch-pick__secondary" href={eventHref}>
        Insider's full notes →
      </a>
    )}
  </div>
</article>

<style>
  .dispatch-pick {
    position: relative;
    padding: 1.75rem 1.6rem 1.6rem;
    border: 1px solid rgba(33, 30, 28, 0.12);
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .dispatch-pick--lead {
    background: #fbf7ef;
    border-color: rgba(11, 90, 72, 0.22);
    padding: 2rem 1.8rem 1.8rem;
  }
  .dispatch-pick--backup {
    background: rgba(33, 30, 28, 0.03);
    border-style: dashed;
  }
  .dispatch-pick__head { display: flex; flex-direction: column; gap: 0.6rem; }
  .dispatch-pick__eyebrow-row {
    display: flex; align-items: baseline; gap: 0.7rem;
  }
  .dispatch-pick__rank {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: normal;
    font-weight: 400;
    font-size: 1.7rem;
    color: var(--accent, var(--accent));
    line-height: 1;
  }
  .dispatch-pick__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, var(--accent));
    font-weight: 600;
  }
  .dispatch-pick__title {
    margin: 0;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.15;
    color: var(--ink, #211e1c);
  }
  .dispatch-pick--lead .dispatch-pick__title {
    font-size: clamp(1.55rem, 3vw, 2rem);
  }
  .dispatch-pick__facts {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem 1.2rem;
    padding: 0.85rem 0;
    border-top: 1px solid rgba(33, 30, 28, 0.08);
    border-bottom: 1px solid rgba(33, 30, 28, 0.08);
  }
  .dispatch-pick__fact { display: contents; }
  .dispatch-pick__fact dt {
    grid-column: 1;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft, #7A726A);
    font-weight: 600;
  }
  .dispatch-pick__fact dd {
    grid-column: 2;
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink, #211e1c);
    line-height: 1.5;
  }
  .dispatch-pick__summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft, #433d39);
  }
  .dispatch-pick__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    align-items: center;
    padding-top: 0.3rem;
  }
  .dispatch-pick__cta {
    display: inline-flex;
    align-items: center;
    background: var(--ink, #211e1c);
    color: #fff;
    padding: 0.7rem 1.1rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 2px;
    font-weight: 500;
  }
  .dispatch-pick__cta:hover { background: #000; }
  .dispatch-pick__cta--plain {
    background: transparent;
    color: var(--ink-soft, #6b6b6b);
    border: 1px solid rgba(33, 30, 28, 0.18);
    padding: 0.65rem 1rem;
  }
  .dispatch-pick__secondary {
    font-size: 0.88rem;
    text-decoration: underline;
    color: var(--accent, var(--accent));
  }
  .dispatch-pick__secondary:hover { color: var(--acc-h); }

  @media (max-width: 600px) {
    .dispatch-pick { padding: 1.5rem 1.25rem 1.4rem; }
    .dispatch-pick__facts { grid-template-columns: 1fr; gap: 0.25rem; }
    .dispatch-pick__fact dt, .dispatch-pick__fact dd { grid-column: 1; }
    .dispatch-pick__fact dd { margin-bottom: 0.6rem; }
  }
</style>
