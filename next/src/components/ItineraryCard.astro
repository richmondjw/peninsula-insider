---
import { routeSlug } from '../lib/editorial';
import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';
import { resolveHero } from '../lib/inline-edit/resolve-hero';

export interface Props {
  itinerary: any;
}

const { itinerary } = Astro.props;
const data = itinerary.data;
const slug = routeSlug(itinerary);
const hero = await resolveHero('itinerary', slug, data);
const regionLabel = (() => {
  const source = `${slug} ${data.title ?? ''}`.toLowerCase();
  if (/red-hill|ridge|vineyard/.test(source)) return 'Red Hill';
  if (/sorrento|portsea|tip/.test(source)) return 'Sorrento';
  if (/flinders|cape/.test(source)) return 'Flinders';
  if (/family|mornington/.test(source)) return 'Mornington';
  if (/golf|rye/.test(source)) return 'Rye';
  return 'Peninsula';
})();
const tripType = data.lengthNights <= 1 ? 'One-night escape' : data.lengthNights === 2 ? 'Two-night escape' : `${data.lengthNights}-night escape`;
const audienceLabel = String(data.audience ?? 'weekend').replace(/-/g, ' ');
const driveLabel = data.totalDriveMinutes ? `${data.totalDriveMinutes} min drive` : null;
const metaLine = [tripType, `Best for ${audienceLabel}`, regionLabel, driveLabel].filter(Boolean).join(' · ');
---

<article class="itinerary-card">
  {(hero.override || data.heroImage) && (
    <a
      href={`/explore/plans/${slug}/`}
      class="itinerary-card__hero"
      style={hero.style}
      aria-hidden="true"
      tabindex="-1"
      {...editableImage({
        entityType: 'itinerary',
        entitySlug: slug,
        fieldPath: 'heroImage',
        label: `${data.title} hero`,
        purpose: 'hero',
      })}
    ></a>
  )}
  <div class="itinerary-card__top itinerary-card__top--brand">
    <span class="itinerary-card__label itinerary-card__label--plan" aria-label="Peninsula Insider Plan">
      <span class="itinerary-card__monogram" aria-hidden="true">PI</span>
      <span>Plan</span>
    </span>
  </div>
  <h3 class="itinerary-card__title">
    <a href={`/explore/plans/${slug}/`}>{data.title}</a>
  </h3>
  <p class="itinerary-card__dek">{data.dek}</p>
  <p class="itinerary-card__meta">{metaLine}</p>
  <div class="itinerary-card__actions">
    <a href={`/explore/plans/${slug}/`} class="itinerary-card__cta pi-btn pi-btn--text">View Plan →</a>
    <PiSaveActions
      kind="itinerary"
      slug={slug}
      title={data.title}
      href={`/explore/plans/${slug}/`}
      dek={data.dek}
      imageUrl={hero.src}
      floating={false}
    />
  </div>
</article>
