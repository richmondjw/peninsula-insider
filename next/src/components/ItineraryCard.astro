---
import { routeSlug, heroBackgroundStyle } from '../lib/editorial';
import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';

export interface Props {
  itinerary: any;
}

const { itinerary } = Astro.props;
const data = itinerary.data;
const slug = routeSlug(itinerary);
---

<article class="itinerary-card">
  {data.heroImage && (
    <a
      href={`/plans/${slug}`}
      class="itinerary-card__hero"
      style={heroBackgroundStyle(data)}
      aria-hidden="true"
      tabindex="-1"
      {...editableImage({
        entityType: 'itinerary',
        entitySlug: slug,
        fieldPath: 'hero',
        label: `${data.title} hero`,
        purpose: 'hero',
      })}
    ></a>
  )}
  <div class="itinerary-card__top itinerary-card__top--brand">
    <span class="itinerary-card__label itinerary-card__label--plan" aria-label="Peninsula Insider Plan">
      <span class="itinerary-card__monogram" aria-hidden="true">PI</span>
      <span>Plan</span>
    </span>
  </div>
  <h3 class="itinerary-card__title">
    <a href={`/plans/${slug}`}>{data.title}</a>
  </h3>
  <p class="itinerary-card__dek">{data.dek}</p>
  <a href={`/plans/${slug}`} class="itinerary-card__cta">View Plan →</a>
  <PiSaveActions
    kind="itinerary"
    slug={slug}
    title={data.title}
    href={`/plans/${slug}/`}
    dek={data.dek}
    imageUrl={data.heroImage?.src}
  />
</article>
