---
/**
 * BfAnalytics - delegated GA4 event listener for /fishing/ and /boating/.
 *
 * Drop this once on any /fishing/* or /boating/* page (typically inside the
 * hub or detail layout). It binds a single document-level click handler that
 * fires gtag events for any element carrying:
 *
 *   <a data-bf-event="bf_charter_click" data-bf-operator="im-hooked" ...>
 *
 * Mirrors the 12 events documented in
 * peninsula_insider_boating_fishing_v1/bf_measurement_spec.md §3.
 *
 * Scroll-depth events (50/80) are emitted from a separate IntersectionObserver
 * keyed off the page body height, so deep-engagement tracking does not depend
 * on individual elements being annotated.
 */
---

<script>
  type BfEventName =
    | 'bf_charter_click'
    | 'bf_hire_click'
    | 'bf_species_view'
    | 'bf_ramp_view'
    | 'bf_tide_lookup'
    | 'bf_licence_click'
    | 'bf_tackle_click'
    | 'bf_comparison_click'
    | 'bf_cross_vertical_click'
    | 'bf_eat_cross_link'
    | 'bf_scroll_depth_50'
    | 'bf_scroll_depth_80';

  declare global {
    interface Window {
      dataLayer?: unknown[];
      gtag?: (...args: unknown[]) => void;
    }
  }

  const KNOWN_EVENTS: ReadonlySet<BfEventName> = new Set<BfEventName>([
    'bf_charter_click',
    'bf_hire_click',
    'bf_species_view',
    'bf_ramp_view',
    'bf_tide_lookup',
    'bf_licence_click',
    'bf_tackle_click',
    'bf_comparison_click',
    'bf_cross_vertical_click',
    'bf_eat_cross_link',
    'bf_scroll_depth_50',
    'bf_scroll_depth_80',
  ]);

  function emit(name: BfEventName, params: Record<string, unknown>) {
    if (typeof window.gtag === 'function') {
      window.gtag('event', name, params);
    } else {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: name, ...params });
    }
  }

  function payloadFromEl(el: HTMLElement): Record<string, unknown> {
    const out: Record<string, unknown> = {};
    for (const key of Object.keys(el.dataset)) {
      if (key.startsWith('bf') && key !== 'bfEvent') {
        // dataset key bfOperator -> "operator"; bfSpecies -> "species" etc.
        const short = key.slice(2).replace(/^./, (c) => c.toLowerCase());
        out[short] = el.dataset[key];
      }
    }
    out.path = window.location.pathname;
    return out;
  }

  document.addEventListener('click', (ev) => {
    const target = (ev.target as HTMLElement | null)?.closest('[data-bf-event]');
    if (!target) return;
    const name = (target as HTMLElement).dataset.bfEvent as BfEventName | undefined;
    if (!name || !KNOWN_EVENTS.has(name)) return;
    emit(name, payloadFromEl(target as HTMLElement));
  });

  // Scroll depth - fire once per page load at 50% and 80% of the article body.
  const fired = new Set<BfEventName>();
  const article = document.querySelector('main, article, [data-bf-article]');
  if (article) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const evName = (entry.target as HTMLElement).dataset.bfDepth as BfEventName | undefined;
          if (!evName || fired.has(evName)) continue;
          fired.add(evName);
          emit(evName, { path: window.location.pathname });
        }
      },
      { threshold: 0.01 },
    );

    const rect = (article as HTMLElement).getBoundingClientRect();
    const docHeight = (article as HTMLElement).scrollHeight;
    if (docHeight > 0 && rect) {
      const make = (depth: number, name: BfEventName) => {
        const sentinel = document.createElement('div');
        sentinel.style.position = 'absolute';
        sentinel.style.left = '0';
        sentinel.style.width = '1px';
        sentinel.style.height = '1px';
        sentinel.style.top = `${Math.round(docHeight * depth)}px`;
        sentinel.dataset.bfDepth = name;
        sentinel.setAttribute('aria-hidden', 'true');
        (article as HTMLElement).style.position = (article as HTMLElement).style.position || 'relative';
        (article as HTMLElement).appendChild(sentinel);
        observer.observe(sentinel);
      };
      make(0.5, 'bf_scroll_depth_50');
      make(0.8, 'bf_scroll_depth_80');
    }
  }
</script>
