---
interface Props {
  title?: string;
  summary?: string;
  placement?: 'top' | 'mid' | 'end';
}

const { title, summary, placement = 'end' } = Astro.props;
const pageTitle = title || 'Peninsula Insider';
const pageUrl = Astro.url?.href || '';

const endBlock = placement === 'end';
const topBlock = placement === 'top';
---

{topBlock && (
  <div class="share-block share-block--top">
    <button class="share-btn share-btn--inline" data-share-title={pageTitle} data-share-url={pageUrl}>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
      Send this plan
    </button>
  </div>
)}

{endBlock && (
  <div class="share-block share-block--end">
    <div class="share-block__inner">
      <p class="share-block__prompt">Worth sending?</p>
      <button class="share-btn share-btn--primary" data-share-title={pageTitle} data-share-text={summary} data-share-url={pageUrl}>
        Send this plan
      </button>
      <div class="share-block__secondary">
        <a href="/newsletter/" class="share-block__subscribe">Get this every week →</a>
      </div>
    </div>
  </div>
)}

<script>
  document.querySelectorAll('[data-share-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const title = btn.getAttribute('data-share-title') || document.title;
      const text = btn.getAttribute('data-share-text') || '';
      const url = btn.getAttribute('data-share-url') || window.location.href;

      if (navigator.share) {
        try {
          await navigator.share({ title, text, url });
        } catch (e) {
          // User dismissed — no action needed
        }
      } else {
        // Fallback: copy to clipboard
        try {
          await navigator.clipboard.writeText(url);
          btn.textContent = 'Link copied';
          setTimeout(() => {
            btn.textContent = btn.classList.contains('share-btn--primary') ? 'Send this plan' : 'Send this plan';
          }, 2000);
        } catch (e) {
          // Clipboard not available — do nothing
        }
      }
    });
  });
</script>

<style>
  .share-block--top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
  }

  .share-block--end {
    margin: 3rem 0 1.5rem;
    padding: 2rem;
    background: var(--surface-warm, #FAF7F2);
    border-top: 2px solid var(--ink, #1A1208);
    text-align: center;
  }

  .share-block__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .share-block__prompt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    margin: 0;
  }

  .share-btn--primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    background: var(--ink, #1A1208);
    color: var(--paper, #F5F0E8);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .share-btn--primary:hover {
    background: var(--ink-rich, #2C2415);
  }

  .share-btn--inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    background: transparent;
    color: var(--ink-muted, #6E655C);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--line, #D9D1BE);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .share-btn--inline:hover {
    border-color: var(--ink, #1A1208);
    color: var(--ink, #1A1208);
  }

  .share-block__secondary {
    font-size: 0.82rem;
    color: var(--ink-muted, #6E655C);
  }

  .share-block__subscribe {
    color: var(--ink-muted, #6E655C);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .share-block__subscribe:hover {
    color: var(--ink, #1A1208);
  }
</style>
