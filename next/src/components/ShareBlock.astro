---
/**
 * ShareBlock — content-type-aware share CTA
 *
 * contentType:
 *   "plan"      → "Send this plan" / "Share this weekend"
 *   "picks"     → "Send this list" / "Share these picks"
 *   "editorial" → "Send this" / "Share this"
 *   auto        → resolved from `format` field if provided
 */
interface Props {
  title?: string;
  summary?: string;
  placement?: 'top' | 'end';
  format?: string;
  contentType?: 'plan' | 'picks' | 'editorial';
}

const { title, summary, placement = 'end', format, contentType } = Astro.props;

// Resolve content type from format if not explicitly passed
function resolveType(ct?: string, fmt?: string): 'plan' | 'picks' | 'editorial' {
  if (ct) return ct;
  const planFormats = [
    'itinerary', 'escape', 'weekend-picker', 'weekend-plan',
    'hub-guide', 'slow-peninsula', 'stay-notes', 'long-lunch-list'
  ];
  const picksFormats = [
    'cellar-door-dispatch', 'insider-edit', 'service', 'shortlist'
  ];
  if (fmt && planFormats.includes(fmt)) return 'plan';
  if (fmt && picksFormats.includes(fmt)) return 'picks';
  return 'editorial';
}

const type = resolveType(contentType, format);

const copy = {
  plan: {
    topLabel: 'Send this plan',
    endPrompt: 'Planning with someone?',
    endCTA: 'Send this plan',
  },
  picks: {
    topLabel: 'Share these picks',
    endPrompt: 'Worth passing on?',
    endCTA: 'Send this list',
  },
  editorial: {
    topLabel: 'Share this',
    endPrompt: 'Worth knowing?',
    endCTA: 'Send this',
  },
};

const c = copy[type];
const pageTitle = title || 'Peninsula Insider';
---

{placement === 'top' && (
  <div class="share-block share-block--top">
    <button class="share-btn share-btn--inline" data-share-title={pageTitle} data-share-url="">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
      {c.topLabel}
    </button>
  </div>
)}

{placement === 'end' && (
  <div class="share-block share-block--end">
    <div class="share-block__inner">
      <p class="share-block__prompt">{c.endPrompt}</p>
      <button class="share-btn share-btn--primary" data-share-title={pageTitle} data-share-text={summary} data-share-url="">
        {c.endCTA}
      </button>
      <div class="share-block__secondary">
        <a href="/newsletter/" class="share-block__subscribe">Get this every week →</a>
      </div>
    </div>
  </div>
)}

<script>
  document.querySelectorAll('[data-share-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const title = btn.getAttribute('data-share-title') || document.title;
      const text = btn.getAttribute('data-share-text') || '';
      const url = window.location.href;

      if (navigator.share) {
        try {
          await navigator.share({ title, text, url });
        } catch (_) {
          // User dismissed — no action needed
        }
      } else {
        try {
          await navigator.clipboard.writeText(url);
          const original = btn.textContent?.trim();
          btn.textContent = 'Link copied ✓';
          setTimeout(() => { if (original) btn.textContent = original; }, 2000);
        } catch (_) {
          // Clipboard unavailable
        }
      }
    });
  });
</script>

<style>
  .share-block--top {
    display: flex;
    align-items: center;
    margin: 0.5rem 0 1.5rem;
  }

  .share-block--end {
    margin: 3rem 0 1.5rem;
    padding: 2rem;
    background: var(--surface-warm, #FAF7F2);
    border-top: 2px solid var(--ink, #1A1208);
    text-align: center;
  }

  .share-block__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .share-block__prompt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    margin: 0;
  }

  .share-btn--primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    background: var(--ink, #1A1208);
    color: var(--paper, #F5F0E8);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .share-btn--primary:hover {
    background: var(--ink-rich, #2C2415);
  }

  .share-btn--inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    background: transparent;
    color: var(--ink-muted, #6E655C);
    font-size: 0.78rem;
    font-weight: 500;
    border: 1px solid var(--line, #D9D1BE);
    cursor: pointer;
    transition: all 0.15s ease;
    line-height: 1;
  }

  .share-btn--inline:hover {
    border-color: var(--ink, #1A1208);
    color: var(--ink, #1A1208);
  }

  .share-block__secondary {
    font-size: 0.82rem;
  }

  .share-block__subscribe {
    color: var(--ink-muted, #6E655C);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .share-block__subscribe:hover {
    color: var(--ink, #1A1208);
  }
</style>
