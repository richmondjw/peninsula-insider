---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import ItineraryCard from './ItineraryCard.astro';
import { loadRelationships } from '../lib/load-relationships';
import { routeSlug } from '../lib/editorial';
import EventStrip from './EventStrip.astro';
interface Props { venue: any; compact?: boolean }
const {venue,compact=false}=Astro.props;
const index=await loadRelationships();
const articles=new Map((await getCollection('articles')).map(a=>[String(routeSlug(a)),a]));
const plans=new Map((await getCollection('itineraries')).map(a=>[String(routeSlug(a)),a]));
const links=index.byVenue.get(String(routeSlug(venue)));
const groups=links ? [
  {key:'mentions',title:'Guides that link to this place',items:links.mentions},
  {key:'selections',title:'Related editorial selections',items:links.selections},
  {key:'plans',title:'Plans with this stop or overnight stay',items:links.plans},
  {key:'nearby',title:'Nearby places',items:links.nearby.slice(0,6)},
].filter(group=>group.items.length) : [];
const Heading=compact?'h3':'h2';
---
{groups.length>0 && <section class:list={['venue-connections',{compact}]} data-venue-relationships={routeSlug(venue)} aria-label={`Explore around ${venue.data.name}`}>
  <div class="container connections-grid">
    {groups.map(group=><div data-relationship-kind={group.key}>
      <Heading>{group.title}</Heading>
      {group.key==='selections' && <p>Selected as related reading; these pieces may not mention this place in their text.</p>}
      {group.key==='nearby' && <p>Within 5 km using stored map locations. Approximate straight-line distances, not walking or driving routes.</p>}
      {!compact && ['mentions','selections','plans'].includes(group.key) ? <div class="connection-cards">{group.items.slice(0,3).map((item:any)=><div data-relationship-target={item.href}>{group.key==='plans' ? <ItineraryCard itinerary={plans.get(item.id)} /> : <ArticleCard article={articles.get(item.id)} />}</div>)}{group.items.length>3 && <details><summary>More {group.key==='plans'?'plans':'reading'} ({group.items.length-3})</summary><ul>{group.items.slice(3).map((item:any)=><li data-relationship-target={item.href}><a href={item.href}>{item.label}</a></li>)}</ul></details>}</div> : <ul>{group.items.map((item:any)=><li data-relationship-target={item.href} data-relationship-distance={item.distanceKm}><a href={item.href}>{item.label}</a>{typeof item.distanceKm==='number' && <span> · {item.distanceKm<0.1?'under 100 m':`${item.distanceKm.toFixed(1)} km`}</span>}</li>)}</ul>}
    </div>)}
  </div>
</section>}
{links?.events.length>0 && <div data-venue-events={routeSlug(venue)}><EventStrip events={links.events} limit={Infinity} eyebrow="On the calendar here" heading={`Upcoming at ${venue.data.name}`} intro="Eligible events with this place recorded as their location. Check the event for session and booking details." /></div>}
<style>
.venue-connections { padding-block:var(--space-10,3rem); border-top:1px solid var(--line,#dce3e6); }
.connection-cards { display:grid; gap:1rem; }
.connections-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; }
h2,h3 { font-family:var(--font-display); color:var(--text); font-size:1.5rem; line-height:1.3; margin:0 0 .8rem; }
p { font-size:1rem; line-height:1.6; max-width:65ch; }
ul { padding-left:1.2rem; margin:.8rem 0 0; }
li { margin:.35rem 0; line-height:1.6; overflow-wrap:anywhere; }
a { display:inline-block; color:var(--accent,#10527e); text-decoration:underline; text-underline-offset:.18em; padding-block:.5rem; }
a:focus-visible { outline:3px solid var(--accent,#10527e); outline-offset:3px; }
span { font-size:.95rem; }
summary { cursor:pointer; padding-block:.75rem; color:var(--accent,#10527e); }
summary:focus-visible {outline:3px solid var(--accent,#10527e);outline-offset:3px;}
.compact { grid-column:1/-1; padding-block:1.5rem; }
.compact .container { width:100%; padding-inline:0; }
@media(max-width:700px) { .connections-grid {grid-template-columns:1fr;} h2,h3 {font-size:1.35rem;} }
</style>
