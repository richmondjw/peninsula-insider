---
/**
 * Masthead — Peninsula Insider
 *
 * Three-row editorial flag, all sticky:
 *   1. utility — issue stamp · Peninsula conditions · subscribe / about
 *   2. brand   — wordmark + italic tagline
 *   3. nav     — section pillars (Journal in italic) + Subscribe pill
 *
 * Replaces the previous UtilityBar+Masthead two-component pattern with a
 * single unified header zone. UtilityBar component is no longer rendered
 * by BaseLayout (its content lives here).
 *
 * All CSS lives in global.css under "MASTHEAD V3".
 */
import { mastheadNav as navItems, mastheadMoreNav as moreItems } from '../lib/nav';
import Typeahead from './Typeahead.astro';

export interface Props {
  section?: string;
  issueMark?: string;
  issueLabel?: string;
  port?: string;
  portTemp?: string;
  sunset?: string;
}

const {
  section = 'home',
  issueMark = '',
  issueLabel = 'Autumn Insider · May 2026',
  port = 'Port Phillip',
  portTemp = '16°C',
  sunset = '5:48 pm',
} = Astro.props;
---

<header class="masthead">
  <!-- Row 1 — Utility -->
  <div class="masthead__utility">
    <div class="container">
      <div class="masthead__utility-inner">
        <span class="masthead__edition">
          <span class="masthead__edition-mark">{issueMark}</span>
          <span class="masthead__edition-label" set:html={issueLabel} />
        </span>
        <span class="masthead__weather">
          <span class="masthead__weather-item"><strong>{port}</strong> {portTemp}</span>
          <span class="masthead__weather-sep" aria-hidden="true">·</span>
          <span class="masthead__weather-item"><strong>Sunset</strong> {sunset}</span>
        </span>
        <div class="masthead__utility-links v2-util__links">
          <a href="/saved/" class="masthead__saved-link" data-saved-link hidden>
            Saved <span class="masthead__saved-count" data-saved-count hidden>0</span>
          </a>
          <a href="/itinerary/" class="masthead__saved-link" data-saved-link hidden>Itinerary</a>
          <a href="/alerts/" class="masthead__saved-link">Alerts</a>
          <a href="/#newsletter" data-auth-anonymous>Join</a>
          <a href="/editorial-approach/">Editorial Approach</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 2 — Brand -->
  <div class="masthead__brand">
    <div class="container">
      <div class="masthead__brand-inner">
        <a href="/" class="masthead__logo" aria-label="Peninsula Insider, home">
          Peninsula <span>Insider</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Row 3 — Nav (on mobile this row absorbs the wordmark too: burger
       left, wordmark centred, subscribe right — single-row magazine
       pattern used by NYT, Atlantic, Monocle, etc.) -->
  <div class="masthead__nav-row">
    <div class="container">
      <div class="masthead__nav-inner">
        <!-- Source order matches visual order: wordmark first (left),
             concierge pill (middle), burger last (right). Avoids any
             reliance on CSS `order` to re-stack flex items. -->
        <a href="/" class="masthead__logo-mobile" aria-label="Peninsula Insider, home">
          Peninsula <span>Insider</span>
        </a>
        <button
          type="button"
          class="masthead__concierge-mobile"
          aria-label="Ask The Insider, the Peninsula concierge"
          data-pi-trigger="true"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 L13.4 8.6 L19 10 L13.4 11.4 L12 17 L10.6 11.4 L5 10 L10.6 8.6 Z" />
            <path d="M19 4 L19.6 5.6 L21 6 L19.6 6.4 L19 8 L18.4 6.4 L17 6 L18.4 5.6 Z" />
          </svg>
          <span class="masthead__concierge-mobile__label">Ask</span>
        </button>
        <button class="masthead__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
          <span></span><span></span><span></span>
        </button>
        <nav aria-label="Primary">
          <ul class="masthead__nav">
            {navItems.map((item) => (
              <li class={item.key === 'journal' ? 'masthead__nav-item--journal' : ''}>
                <a
                  href={item.href}
                  aria-current={section === item.key ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="masthead__nav-item--more" data-more-root>
              <button
                type="button"
                class="masthead__nav-more-trigger"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="mastheadMorePanel"
                aria-current={moreItems.some((m) => m.key === section) ? 'page' : undefined}
                data-more-trigger
              >
                More
                <svg viewBox="0 0 12 8" width="10" height="6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="masthead__nav-more-chev">
                  <path d="M1 1.5 L6 6.5 L11 1.5" />
                </svg>
              </button>
              <div
                class="masthead__more-panel"
                id="mastheadMorePanel"
                role="menu"
                aria-label="More sections"
                hidden
                data-more-panel
              >
                <ul class="masthead__more-list">
                  {moreItems.map((item) => (
                    <li role="none">
                      <a
                        href={item.href}
                        role="menuitem"
                        class="masthead__more-link"
                        aria-current={section === item.key ? 'page' : undefined}
                      >
                        <span class="masthead__more-link-label">{item.label}</span>
                        {item.dek && <span class="masthead__more-link-dek">{item.dek}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          </ul>
        </nav>
        <!-- Visual order: typeahead (instant search), then Subscribe.
             Phase 3 WS3A — replaces the prior search-icon button which
             opened the SearchOverlay. The overlay component is still
             mounted by BaseLayout as a fallback path; the typeahead's
             "View all results" footer link routes there if needed. -->
        <Typeahead />
        <a href="/dispatch/" class="masthead__cta">Join</a>
        <a href="/dispatch/" class="masthead__cta-mobile" aria-label="Join the Dispatch">Join</a>
      </div>
    </div>
  </div>
</header>

<!-- Mobile-nav full-screen overlay — opened by the burger toggle in BaseLayout -->
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
  <div class="mobile-nav__inner">
    <div class="mobile-nav__brand">
      <a href="/" class="mobile-nav__logo">Peninsula <span>Insider</span></a>
      <p class="mobile-nav__tagline-top">A thoughtful editorial guide</p>
      <p class="mobile-nav__edition">{issueMark} · {issueLabel}</p>
    </div>
    {navItems.map((item) => (
      item.children && item.children.length > 0 ? (
        /* Split-button item: text navigates to hub, chevron expands submenu */
        <div class={`mobile-nav__split${item.key === 'journal' ? ' mobile-nav__split--journal' : ''}${section === item.key ? ' mobile-nav__split--current' : ''}`} data-split-root>
          <a
            href={item.href}
            class="mobile-nav__split-link"
            aria-current={section === item.key ? 'page' : undefined}
          >
            <span>{item.label}</span>
          </a>
          <button
            type="button"
            class="mobile-nav__split-toggle"
            aria-expanded="false"
            aria-label={`Explore ${item.label} sections`}
            data-split-toggle
          >
            <svg viewBox="0 0 12 8" width="10" height="7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mobile-nav__split-chev" aria-hidden="true">
              <path d="M1 1.5 L6 6.5 L11 1.5" />
            </svg>
          </button>
          <ul class="mobile-nav__submenu" hidden data-split-panel>
            {item.children.map((child) => (
              <li>
                <a href={child.href} class="mobile-nav__submenu-link">{child.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        /* Simple link item — no submenu */
        <a
          href={item.href}
          class={`mobile-nav__link${item.key === 'journal' ? ' mobile-nav__link--journal' : ''}`}
          aria-current={section === item.key ? 'page' : undefined}
        >
          <span>{item.label}</span>
          <span class="mobile-nav__arrow" aria-hidden="true">→</span>
        </a>
      )
    ))}
    <p class="mobile-nav__group-label">More from the Peninsula</p>
    {moreItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav__link mobile-nav__link--more"
        aria-current={section === item.key ? 'page' : undefined}
      >
        <span>{item.label}</span>
        <span class="mobile-nav__arrow" aria-hidden="true">→</span>
      </a>
    ))}
    <p class="mobile-nav__group-label">About</p>
    <a
      href="/editorial-approach/"
      class="mobile-nav__link"
      aria-current={section === 'editorial-approach' ? 'page' : undefined}
    >
      <span>Editorial Approach</span>
      <span class="mobile-nav__arrow" aria-hidden="true">→</span>
    </a>
    <a
      href="/partners/"
      class="mobile-nav__link"
      aria-current={section === 'partners' ? 'page' : undefined}
    >
      <span>Partner With Us</span>
      <span class="mobile-nav__arrow" aria-hidden="true">→</span>
    </a>
    <a
      href="/contact/"
      class="mobile-nav__link"
      aria-current={section === 'contact' ? 'page' : undefined}
    >
      <span>Contact</span>
      <span class="mobile-nav__arrow" aria-hidden="true">→</span>
    </a>
    <div class="mobile-nav__footer">
      <a href="/ask/" class="mobile-nav__cta mobile-nav__cta--ask" data-pi-trigger="true">
        Ask The Insider for a recommendation
      </a>
      <a href="/dispatch/" class="mobile-nav__cta">Join the Peninsula Dispatch</a>
      <p class="mobile-nav__tagline">Independent editorial. Sent when it's worth sending.</p>
    </div>
  </div>
</nav>

<!-- Trigger drawer when an Ask link is clicked (progressive enhancement) -->
<script is:inline>
(function () {
  function bindTriggers() {
    document.querySelectorAll('[data-pi-trigger="true"]').forEach((el) => {
      if (el._piTrigBound) return;
      el._piTrigBound = true;
      el.addEventListener('click', (e) => {
        if (typeof window.openConcierge !== 'function') return;
        e.preventDefault();
        window.openConcierge();
      });
    });
  }
  bindTriggers();
  document.addEventListener('astro:page-load', bindTriggers);
})();
</script>

<!-- Masthead "More" mega-menu controller.
     Click-only. Predictable. The dual hover/click mode in the previous
     version fought itself: a click after a hover toggled state in a way
     that could close the panel unexpectedly, and the 250ms mouseleave
     close timer made the issue feel like a flash. This version is
     simpler and bulletproof:
       • Click trigger → open. Click trigger again → close.
       • Outside click → close. Esc → close + return focus.
       • Hover does nothing.
     Idempotent across astro:page-load. -->
<script is:inline>
(function () {
  function bindMore() {
    document.querySelectorAll('[data-more-root]').forEach((root) => {
      if (root._piMoreBound) return;
      root._piMoreBound = true;
      const trigger = root.querySelector('[data-more-trigger]');
      const panel = root.querySelector('[data-more-panel]');
      if (!trigger || !panel) return;

      let isOpen = false;

      const apply = () => {
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen) {
          panel.removeAttribute('hidden');
          root.classList.add('is-open');
        } else {
          panel.setAttribute('hidden', '');
          root.classList.remove('is-open');
        }
      };
      const open  = () => { if (!isOpen) { isOpen = true;  apply(); } };
      const close = () => { if ( isOpen) { isOpen = false; apply(); } };
      const toggle = () => { isOpen = !isOpen; apply(); };

      // Trigger click toggles. stopPropagation prevents the document
      // click listener below from immediately closing what we just opened.
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggle();
      });

      // Outside click closes. Listen on document at the bubble phase;
      // the trigger handler stops propagation for its own clicks, and
      // any click inside the panel is recognised via root.contains.
      document.addEventListener('click', (e) => {
        if (!isOpen) return;
        if (root.contains(e.target)) return;
        close();
      });

      // Esc closes and returns focus to the trigger so keyboard users
      // pick up where they were.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) {
          close();
          trigger.focus();
        }
      });

      // Clicking a link inside the panel should navigate AND close.
      // The default <a> navigation runs first; close the panel after.
      panel.addEventListener('click', (e) => {
        const link = e.target.closest('a[href]');
        if (link && root.contains(link)) close();
      });

      // Keyboard: focus leaving the entire menu structure also closes.
      root.addEventListener('focusout', (e) => {
        if (!isOpen) return;
        if (e.relatedTarget && root.contains(e.relatedTarget)) return;
        close();
      });
    });
  }
  bindMore();
  document.addEventListener('astro:page-load', bindMore);
})();
</script>

<!-- Mobile nav split-button controller.
     Each [data-split-root] has:
       [data-split-toggle] — the chevron button
       [data-split-panel]  — the hidden submenu <ul>
     Tap text = navigate (default <a> behaviour).
     Tap chevron = toggle submenu.
     Idempotent across astro:page-load. -->
<script is:inline>
(function () {
  function bindSplits() {
    document.querySelectorAll('[data-split-root]').forEach(function (root) {
      if (root._piSplitBound) return;
      root._piSplitBound = true;
      var toggle = root.querySelector('[data-split-toggle]');
      var panel  = root.querySelector('[data-split-panel]');
      if (!toggle || !panel) return;

      var isOpen = false;

      function apply() {
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.classList.toggle('is-open', isOpen);
        root.classList.toggle('is-open', isOpen);
        if (isOpen) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      }

      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        isOpen = !isOpen;
        apply();
      });

      // Submenu links close the mobile nav overlay on tap
      panel.addEventListener('click', function (e) {
        var link = e.target.closest('a[href]');
        if (!link) return;
        // Close the entire mobile nav after a short delay (let navigation run)
        setTimeout(function () {
          var nav = document.getElementById('mobileNav');
          var burger = document.querySelector('.masthead__burger');
          if (nav) nav.classList.remove('is-open');
          if (burger) burger.setAttribute('aria-expanded', 'false');
        }, 50);
      });
    });
  }
  bindSplits();
  document.addEventListener('astro:page-load', bindSplits);
})();
</script>
