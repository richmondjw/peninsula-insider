---
/**
 * Masthead — Peninsula Insider
 *
 * Three-row editorial flag, all sticky:
 *   1. utility — issue stamp · Peninsula conditions · subscribe / about
 *   2. brand   — wordmark + italic tagline
 *   3. nav     — section pillars (Journal in italic) + Subscribe pill
 *
 * Replaces the previous UtilityBar+Masthead two-component pattern with a
 * single unified header zone. UtilityBar component is no longer rendered
 * by BaseLayout (its content lives here).
 *
 * All CSS lives in global.css under "MASTHEAD V3".
 */
import { mastheadNav as navItems, mastheadMoreNav as moreItems } from '../lib/nav';

export interface Props {
  section?: string;
  issueMark?: string;
  issueLabel?: string;
  port?: string;
  portTemp?: string;
  sunset?: string;
}

const {
  section = 'home',
  issueMark = 'Vol 04',
  issueLabel = 'The May Issue · May 2026',
  port = 'Port Phillip',
  portTemp = '16°C',
  sunset = '5:48 pm',
} = Astro.props;
---

<header class="masthead">
  <!-- Row 1 — Utility -->
  <div class="masthead__utility">
    <div class="container">
      <div class="masthead__utility-inner">
        <span class="masthead__edition">
          <span class="masthead__edition-mark">{issueMark}</span>
          <span class="masthead__edition-label" set:html={issueLabel} />
        </span>
        <span class="masthead__weather">
          <span class="masthead__weather-item"><strong>{port}</strong> {portTemp}</span>
          <span class="masthead__weather-sep" aria-hidden="true">·</span>
          <span class="masthead__weather-item"><strong>Sunset</strong> {sunset}</span>
        </span>
        <div class="masthead__utility-links v2-util__links">
          <a href="/#newsletter" data-auth-anonymous>Subscribe</a>
          <a href="/about/">About</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Row 2 — Brand -->
  <div class="masthead__brand">
    <div class="container">
      <div class="masthead__brand-inner">
        <a href="/" class="masthead__logo" aria-label="Peninsula Insider, home">
          Peninsula <span>Insider</span>
        </a>
        <p class="masthead__tagline">An editorial guide, not a directory · Mornington Peninsula</p>
      </div>
    </div>
  </div>

  <!-- Row 3 — Nav (on mobile this row absorbs the wordmark too: burger
       left, wordmark centred, subscribe right — single-row magazine
       pattern used by NYT, Atlantic, Monocle, etc.) -->
  <div class="masthead__nav-row">
    <div class="container">
      <div class="masthead__nav-inner">
        <!-- Source order matches visual order: wordmark first (left),
             concierge pill (middle), burger last (right). Avoids any
             reliance on CSS `order` to re-stack flex items. -->
        <a href="/" class="masthead__logo-mobile" aria-label="Peninsula Insider, home">
          Peninsula <span>Insider</span>
        </a>
        <button
          type="button"
          class="masthead__concierge-mobile"
          aria-label="Ask The Insider, the Peninsula concierge"
          data-pi-trigger="true"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 L13.4 8.6 L19 10 L13.4 11.4 L12 17 L10.6 11.4 L5 10 L10.6 8.6 Z" />
            <path d="M19 4 L19.6 5.6 L21 6 L19.6 6.4 L19 8 L18.4 6.4 L17 6 L18.4 5.6 Z" />
          </svg>
          <span class="masthead__concierge-mobile__label">Ask</span>
        </button>
        <button class="masthead__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
          <span></span><span></span><span></span>
        </button>
        <nav aria-label="Primary">
          <ul class="masthead__nav">
            {navItems.map((item) => (
              <li class={item.key === 'journal' ? 'masthead__nav-item--journal' : ''}>
                <a
                  href={item.href}
                  aria-current={section === item.key ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="masthead__nav-item--more" data-more-root>
              <button
                type="button"
                class="masthead__nav-more-trigger"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="mastheadMorePanel"
                aria-current={moreItems.some((m) => m.key === section) ? 'page' : undefined}
                data-more-trigger
              >
                More
                <svg viewBox="0 0 12 8" width="10" height="6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="masthead__nav-more-chev">
                  <path d="M1 1.5 L6 6.5 L11 1.5" />
                </svg>
              </button>
              <div
                class="masthead__more-panel"
                id="mastheadMorePanel"
                role="menu"
                aria-label="More sections"
                hidden
                data-more-panel
              >
                <ul class="masthead__more-list">
                  {moreItems.map((item) => (
                    <li role="none">
                      <a
                        href={item.href}
                        role="menuitem"
                        class="masthead__more-link"
                        aria-current={section === item.key ? 'page' : undefined}
                      >
                        <span class="masthead__more-link-label">{item.label}</span>
                        {item.dek && <span class="masthead__more-link-dek">{item.dek}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          </ul>
        </nav>
        <!-- Visual order: search icon, then Subscribe, far-right.
             Search sits to the immediate left of the Subscribe pill. -->
        <button
          type="button"
          class="masthead__search-icon"
          data-open-search
          aria-label="Search Peninsula Insider"
          aria-haspopup="dialog"
          aria-controls="siteSearchOverlay"
        >
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="9" r="6" />
            <path d="M14 14l4 4" />
          </svg>
        </button>
        <a href="/newsletter/" class="masthead__cta">Subscribe</a>
        <a href="/newsletter/" class="masthead__cta-mobile" aria-label="Subscribe to the newsletter">Subscribe</a>
      </div>
    </div>
  </div>
</header>

<!-- Mobile-nav full-screen overlay — opened by the burger toggle in BaseLayout -->
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
  <div class="mobile-nav__inner">
    <div class="mobile-nav__brand">
      <a href="/" class="mobile-nav__logo">Peninsula <span>Insider</span></a>
      <p class="mobile-nav__tagline-top">An editorial guide, not a directory</p>
      <p class="mobile-nav__edition">{issueMark} · {issueLabel}</p>
    </div>
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`mobile-nav__link${item.key === 'journal' ? ' mobile-nav__link--journal' : ''}`}
        aria-current={section === item.key ? 'page' : undefined}
      >
        <span>{item.label}</span>
        <span class="mobile-nav__arrow" aria-hidden="true">→</span>
      </a>
    ))}
    <p class="mobile-nav__group-label">More from the Peninsula</p>
    {moreItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav__link mobile-nav__link--more"
        aria-current={section === item.key ? 'page' : undefined}
      >
        <span>{item.label}</span>
        <span class="mobile-nav__arrow" aria-hidden="true">→</span>
      </a>
    ))}
    <a
      href="/contact/"
      class="mobile-nav__link"
      aria-current={section === 'contact' ? 'page' : undefined}
    >
      <span>Contact</span>
      <span class="mobile-nav__arrow" aria-hidden="true">→</span>
    </a>
    <div class="mobile-nav__footer">
      <a href="/ask/" class="mobile-nav__cta mobile-nav__cta--ask" data-pi-trigger="true">
        Ask The Insider for a recommendation
      </a>
      <a href="/newsletter/" class="mobile-nav__cta">Get the weekly dispatch</a>
      <p class="mobile-nav__tagline">Independent editorial. Weekly.</p>
    </div>
  </div>
</nav>

<!-- Trigger drawer when an Ask link is clicked (progressive enhancement) -->
<script is:inline>
(function () {
  function bindTriggers() {
    document.querySelectorAll('[data-pi-trigger="true"]').forEach((el) => {
      if (el._piTrigBound) return;
      el._piTrigBound = true;
      el.addEventListener('click', (e) => {
        if (typeof window.openConcierge !== 'function') return;
        e.preventDefault();
        window.openConcierge();
      });
    });
  }
  bindTriggers();
  document.addEventListener('astro:page-load', bindTriggers);
})();
</script>

<!-- Masthead "More" mega-menu controller.
     Hover opens softly (closes on mouseleave with a 250ms grace period to
     bridge the cursor traversal between trigger and panel). Click locks the
     panel open until Escape, outside-click, or another click on the trigger.
     Touch input takes the click path because mouseenter is unreliable.
     Idempotent across astro:page-load. -->
<script is:inline>
(function () {
  function bindMore() {
    document.querySelectorAll('[data-more-root]').forEach((root) => {
      if (root._piMoreBound) return;
      root._piMoreBound = true;
      const trigger = root.querySelector('[data-more-trigger]');
      const panel = root.querySelector('[data-more-panel]');
      if (!trigger || !panel) return;

      // mode: 'closed' | 'hover' | 'click'
      // 'hover' closes on mouseleave (with grace period). 'click' is sticky
      // and only closes on Escape, outside-click, or click on the trigger.
      let mode = 'closed';
      let leaveTimer = null;

      const apply = () => {
        var isOpen = mode !== 'closed';
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen) {
          panel.removeAttribute('hidden');
          root.classList.add('is-open');
        } else {
          panel.setAttribute('hidden', '');
          root.classList.remove('is-open');
        }
      };
      const setMode = (next) => {
        if (mode === next) return;
        mode = next;
        apply();
      };
      const cancelLeave = () => {
        if (leaveTimer) {
          clearTimeout(leaveTimer);
          leaveTimer = null;
        }
      };

      // Click toggles between sticky-open and closed. Cancels any in-flight
      // hover-close so a tap that follows a hover doesn't immediately drop.
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        cancelLeave();
        setMode(mode === 'click' ? 'closed' : 'click');
      });

      // Hover only opens if nothing's already happening. If the panel was
      // click-locked, hover does nothing — leave the user's explicit choice
      // alone.
      root.addEventListener('mouseenter', () => {
        cancelLeave();
        if (mode === 'closed') setMode('hover');
      });

      // Hover-leave closes after a grace period; click-locked stays open.
      // The grace period prevents the panel disappearing while the cursor
      // travels from trigger to panel content.
      root.addEventListener('mouseleave', () => {
        if (mode !== 'hover') return;
        cancelLeave();
        leaveTimer = setTimeout(() => {
          if (mode === 'hover') setMode('closed');
          leaveTimer = null;
        }, 250);
      });

      // Keyboard: focus moves out of the menu structure → close.
      root.addEventListener('focusout', (e) => {
        if (!root.contains(e.relatedTarget)) {
          cancelLeave();
          setMode('closed');
        }
      });

      // Escape closes regardless of mode and returns focus to the trigger.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mode !== 'closed') {
          cancelLeave();
          setMode('closed');
          trigger.focus();
        }
      });

      // Outside click only kills 'click' mode. 'hover' mode handles itself
      // via mouseleave — using the document click listener for hover would
      // cause it to close on the panel's own clicks (link navigation).
      document.addEventListener('click', (e) => {
        if (mode === 'click' && !root.contains(e.target)) {
          cancelLeave();
          setMode('closed');
        }
      });
    });
  }
  bindMore();
  document.addEventListener('astro:page-load', bindMore);
})();
</script>
