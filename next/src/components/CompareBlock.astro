---
/**
 * CompareBlock  -  side-by-side comparison card for editorial A vs B
 * frames. Bay vs Ocean, Peninsula Hot Springs vs Alba, Red Hill vs
 * Sorrento, and any other "two genuinely different things visitors
 * conflate" page section.
 *
 * Each column has a chip label, a single hero attribute line, and a
 * definition list of differentiating rows. Two columns side by side on
 * desktop, stacked on mobile.
 */
export interface CompareRow {
  label: string;
  value: string;
}

export interface CompareColumn {
  /** Short uppercase chip, e.g. "BAY". */
  label: string;
  /** The single declarative attribute line, e.g. "Calm. Family-safe. Year-round swimming." */
  title: string;
  /** Definition rows: each label/value pair becomes a definition list entry. */
  rows: CompareRow[];
}

export interface Props {
  eyebrow?: string;
  heading: string;
  dek?: string;
  left: CompareColumn;
  right: CompareColumn;
}

const { eyebrow, heading, dek, left, right } = Astro.props;
const cols = [left, right];
---

<section class="compare-block" aria-label={heading}>
  <div class="container">
    <div class="compare-block__intro">
      {eyebrow && <p class="label label--accent">{eyebrow}</p>}
      <h2 class="compare-block__heading">{heading}</h2>
      {dek && <p class="compare-block__dek">{dek}</p>}
    </div>
    <div class="compare-block__grid">
      {cols.map((col) => (
        <article class="compare-block__col">
          <span class="compare-block__chip">{col.label}</span>
          <h3 class="compare-block__title">{col.title}</h3>
          <dl class="compare-block__rows">
            {col.rows.map((row) => (
              <div class="compare-block__row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>
