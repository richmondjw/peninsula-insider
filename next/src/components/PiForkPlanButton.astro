---
import type { EditorialPlan } from '../lib/editorial-plan-import';
export interface Props { plan: EditorialPlan; label?: string; variant?: 'solid' | 'ghost' }
const { plan, label = 'Use this plan', variant = 'solid' } = Astro.props;
---
<div class="pi-fork-plan">
  <button type="button" class={`pi-btn pi-btn--${variant} pi-btn--sm`} data-pi-fork-plan data-pi-plan={JSON.stringify(plan)}>{label}</button>
</div>
<style>
  .pi-fork-plan { display: inline-flex; }
</style>
<script>
  import { useEditorialPlan } from '../lib/plan-trip-client';
  import { trackEvent } from '../lib/v5-analytics';
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element)?.closest<HTMLButtonElement>('[data-pi-fork-plan]');
    if (!button || button.disabled) return;
    try {
      const plan = JSON.parse(button.dataset.piPlan || 'null');
      if (!plan) return;
      button.disabled = true;
      const outcome = await useEditorialPlan(plan, button);
      if (outcome === 'added') trackEvent('trip_fork', { entity_type: 'itinerary', entity_slug: plan.slug, surface: 'plan-detail' });
    } finally { button.disabled = false; }
  });
</script>
