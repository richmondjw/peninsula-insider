---
/* NewsletterBlock - V2 design, namespaced (.v2-newsletter*).
   Strangler-fig migration of the V1 newsletter band.
   Every page that imports this component now ships the V2 magazine
   newsletter band: dark, two-column, preview-card, ochre-on-paper.
   CSS is inline in this file so it travels with the component
   without depending on V1's main stylesheet.

   Inline-editable surfaces are tagged against entity_type='page',
   entity_slug='home' - matches the existing override schema. */

import { getCollection } from 'astro:content';
import { editableText } from '../lib/inline-edit/attrs';
import { routeSlug } from '../lib/editorial';
import { isPeninsulaThisWeekend, ptwArchivePath, ptwWeekendEndIso } from '../lib/peninsula-this-weekend';

export interface Props {
  title?: string;
  body?: string;
  sub?: string;
  issueNumber?: string;
  issueDate?: string;
  previewHeadline?: string;
  previewItems?: string[];
  endpoint?: string;
  source?: string;
  /**
   * Hide the preview card on the right entirely. Useful for footer/embedded
   * placements where the card would crowd the surface. Default false - the
   * preview card renders when there's a published weekend-picker article
   * to source from.
   */
  hidePreview?: boolean;
}

const {
  title = 'The Insider Note',
  body = 'The Peninsula worth knowing. An occasional email. What’s on, where we’d go and what’s worth knowing next.',
  // A short sub is a reassurance, so it renders as a second tick item beside
  // "Unsubscribe any time" under the form (see subAsTick below).
  sub = 'Independent editorial',
  issueNumber = '',
  issueDate = '',
  previewHeadline = '',
  previewItems = [],
  endpoint = 'https://tjjhpvslpysfklwpqmgz.supabase.co/functions/v1/pi-newsletter-subscribe',
  source = 'footer',
  hidePreview = false,
} = Astro.props;

// ─── Preview card data ─────────────────────────────────────────────────
// Pulls from the most recent published weekend-picker article so the
// card on the right of the newsletter band is always in sync with the
// dispatch that's currently live. This solves the staleness that drove
// Remy to hide the card in d1903b2fc0 - the card can't go stale because
// it reads from the canonical article each build. Explicit props still
// win when a caller wants to override (e.g. for a campaign page).
const dispatchArticles = await getCollection(
  'articles',
  ({ data }) => data.status === 'published' && data.format === 'weekend-picker',
);
const latestDispatch = dispatchArticles
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0] ?? null;

// Staleness guard (2026-08-16): the editorial dispatch pipeline can miss a
// week (or several), and this card has no other cutoff - it would otherwise
// keep presenting a weeks-old "this weekend" edition as current indefinitely.
// Mirrors the hasCurrentDispatch check on /whats-on/this-weekend/. Non-PTW
// weekend-picker articles (no weekend window) are exempt.
const dispatchIsStale =
  latestDispatch &&
  isPeninsulaThisWeekend(latestDispatch) &&
  new Date(ptwWeekendEndIso(latestDispatch)) < new Date();
const dispatch = dispatchIsStale ? null : latestDispatch;

// "Peninsula This Weekend - 16 to 17 May" → "16 to 17 May"
function deriveIssueLabel(d: any | null): string {
  if (!d) return '';
  const t = String(d.data.title ?? '');
  const m = t.match(/[---]\s*(.+)$/);
  if (m) return m[1].trim();
  return d.data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long' });
}

// 3 short picks for the bullet list. Cluster links are editor-curated and
// already short labels, so they're the cleanest source. Fall back to the
// first 3 FAQ questions (truncated) if cluster links aren't populated.
function derivePicks(d: any | null): string[] {
  if (!d) return [];
  const cluster = (d.data.clusterLinks ?? []) as Array<{ label: string }>;
  if (cluster.length > 0) return cluster.slice(0, 3).map((c) => c.label);
  const faq = (d.data.faq ?? []) as Array<{ question: string }>;
  return faq.slice(0, 3).map((f) => {
    const q = String(f.question ?? '').replace(/\s+/g, ' ').trim();
    return q.length > 70 ? q.slice(0, 67).trim() + '...' : q;
  });
}

const resolvedHeadline = previewHeadline || (dispatch?.data?.dek ?? '');
const resolvedIssueLabel =
  issueNumber && issueDate
    ? `${issueNumber} · ${issueDate}`
    : (issueNumber || issueDate || deriveIssueLabel(dispatch));
const resolvedPicks = previewItems.length > 0 ? previewItems : derivePicks(dispatch);
// Link the canonical archive URL, not the legacy /journal/ one. The journal
// path emits a consolidate redirect into /whats-on/this-weekend/archive/,
// and this component renders on 730 pages - so pointing at the legacy URL
// made the single most-linked target on the entire site a redirect hop.
// Measured 2026-08-15: 730 inbound links, more than any real page receives.
const dispatchHref = dispatch
  ? (isPeninsulaThisWeekend(dispatch) ? ptwArchivePath(dispatch) : `/journal/${routeSlug(dispatch)}/`)
  : '';
const readMinutes = dispatch?.data?.readingTimeMinutes ?? 4;
const resolvedFoot = dispatch
  ? `Read in ${readMinutes} ${readMinutes === 1 ? 'minute' : 'minutes'} · Used all weekend`
  : '';

const showPreview = !hidePreview && resolvedHeadline && resolvedPicks.length > 0;

// A short, single-phrase sub ("Independent editorial") is a reassurance and
// joins the tick row under the form, matching "Unsubscribe any time". A few
// older callers still pass a full sentence as the sub; that stays a
// paragraph under the body, where a sentence belongs.
const subText = (sub ?? '').trim().replace(/'/g, '’');
const subAsTick = subText !== '' && subText.length <= 40 && !/[.!?]\s+\S/.test(subText);
const tickSub = subAsTick ? subText.replace(/\.$/, '') : '';
const paraSub = subAsTick ? '' : subText;
---

<section class="v2-newsletter" id="newsletter" aria-labelledby="newsletter-title">
  <div class="v2-newsletter__container">
    <div class={`v2-newsletter__frame${showPreview ? ' v2-newsletter__frame--has-preview' : ''}`}>
      <div class="v2-newsletter__copy">
        <h2
          class="v2-newsletter__title"
          id="newsletter-title"
          set:html={title}
          {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'newsletter.title', label: 'Newsletter title' })}
        />
        <p
          class="v2-newsletter__body"
          {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'newsletter.body', label: 'Newsletter body' })}
        >{body}</p>
        {paraSub && <p class="v2-newsletter__sub">{paraSub}</p>}
      </div>

      <div class="v2-newsletter__action">
        <form
          class="v2-newsletter__form"
          novalidate
          data-source={source}
          data-endpoint={endpoint}
        >
          <input
            class="v2-newsletter__input"
            type="email"
            name="email"
            placeholder="your@email.com"
            aria-label="Email address"
            autocomplete="email"
            required
          />
          <button class="v2-newsletter__submit" type="submit">Join</button>
        </form>

        <ul class="v2-newsletter__meta" role="list">
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Unsubscribe any time
          </li>
          {tickSub && (
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {tickSub}
            </li>
          )}
        </ul>
      </div>

      {showPreview && (
        <a
          href={dispatchHref || '/whats-on/this-weekend/'}
          class="v2-newsletter__preview"
        >
          <div class="v2-np__head">
            <span class="v2-np__mark">Peninsula This Weekend</span>
            {resolvedIssueLabel && <span class="v2-np__issue">{resolvedIssueLabel}</span>}
          </div>
          <h3 class="v2-np__title" set:html={resolvedHeadline} />
          {resolvedPicks.length > 0 && (
            <ul class="v2-np__items">
              {resolvedPicks.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {resolvedFoot && <div class="v2-np__foot">{resolvedFoot}</div>}
        </a>
      )}
    </div>
  </div>
</section>

<script is:inline>
  /* V2 newsletter - namespaced submit handler. Survives view transitions. */
  (function () {
    function emailValid(s) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s); }
    function setStatus(form, msg, kind) {
      var parent = form.parentNode;
      var st = parent && parent.querySelector(':scope > .v2-newsletter__status');
      if (!st) {
        st = document.createElement('p');
        st.className = 'v2-newsletter__status';
        st.setAttribute('role', 'status');
        st.setAttribute('aria-live', 'polite');
        parent && parent.insertBefore(st, form.nextSibling);
      }
      st.textContent = msg;
      st.className = 'v2-newsletter__status' + (kind ? ' v2-newsletter__status--' + kind : '');
    }
    function init() {
      document.querySelectorAll('.v2-newsletter__form').forEach(function (form) {
        if (form._v2nlInit) return;
        form._v2nlInit = true;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (form._v2nlBusy || form._v2nlDone) return;
          var input = form.querySelector('.v2-newsletter__input');
          var btn   = form.querySelector('.v2-newsletter__submit');
          var email = ((input && input.value) || '').trim();
          if (!emailValid(email)) {
            setStatus(form, 'Please enter a valid email address.', 'err');
            input && input.focus();
            return;
          }
          var endpoint = form.dataset.endpoint || '';
          var source   = form.dataset.source   || 'v2-newsletter';
          form._v2nlBusy = true;
          if (btn) { btn.disabled = true; btn.textContent = 'Joining...'; }
          setStatus(form, '', '');
          function ok() {
            form._v2nlDone = true;
            if (typeof window.piTrack === 'function') window.piTrack('newsletter_signup_succeeded', { surface: source }, { component: 'NewsletterBlock' });
            if (btn) btn.textContent = 'Done';
            setStatus(form, 'You’re in. The next edition will land in your inbox soon.', 'ok');
            if (input) { input.value = ''; input.disabled = true; }
          }
          function fail(msg) {
            form._v2nlBusy = false;
            if (btn) { btn.textContent = 'Join'; btn.disabled = false; }
            setStatus(form, msg || 'Something went wrong. Please try again.', 'err');
          }
          if (!endpoint) {
            fail('Signups are briefly offline. Email hello@peninsulainsider.com.au and we will add you.');
            return;
          }
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, source: source }),
          })
            .then(function (r) { if (!r.ok) throw new Error('Subscription rejected'); return r.json().catch(function () { return {}; }); })
            .then(function (d) { if (d && (d.ok === true || d.success === true)) ok(); else fail(d && d.message); })
            .catch(function () { fail(); });
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style is:global>
  .v2-newsletter {
    position: relative;
    background: var(--deep, #0B2E4A);
    color: var(--paper, #FAF7F0);
    padding: var(--section-space, clamp(4rem, 2.8rem + 4vw, 6rem)) 0;
    overflow: hidden;
    font-family: var(--font-ui);
  }
  .v2-newsletter::before {
    content: '';
    position: absolute;
    top: 0; right: -30%;
    width: 70%; height: 100%;
    background: radial-gradient(circle at center, rgba(11, 90, 72,0.15), transparent 65%);
    pointer-events: none;
  }
  /* On the shared 1280 frame: same width and gutters as .container, so
     the band's heading starts on the 80px edge the page and footer use. */
  .v2-newsletter__container {
    position: relative;
    z-index: 1;
    width: min(var(--max-w, 1280px), calc(100% - 80px));
    max-width: none;
    margin-inline: auto;
    padding: 0;
  }
  @media (max-width: 1100px) {
    .v2-newsletter__container { width: calc(100% - 48px); }
  }
  @media (max-width: 767px) {
    .v2-newsletter__container { width: calc(100% - 32px); }
  }

  /* One column on small screens. From 64em the band is always two
     columns: copy on the left, the form on the right. When a current
     dispatch preview exists it takes the right column and the form
     moves under the copy. */
  .v2-newsletter__frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  @media (min-width: 64em) {
    .v2-newsletter__frame {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'copy action';
      column-gap: var(--space-8);
      align-items: end;
    }
    .v2-newsletter__frame--has-preview {
      grid-template-areas:
        'copy preview'
        'action preview';
      row-gap: var(--space-6);
      align-items: start;
    }
    .v2-newsletter__copy { grid-area: copy; }
    .v2-newsletter__action { grid-area: action; }
    .v2-newsletter__preview { grid-area: preview; align-self: center; }
  }

  .v2-newsletter__copy,
  .v2-newsletter__action { min-width: 0; }
  .v2-newsletter__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.14);
    letter-spacing: var(--ls-display, -0.02em);
    color: var(--paper, #FAF7F0);
    text-wrap: balance;
    margin: 0 0 var(--space-4);
  }
  .v2-newsletter__title em {
    color: var(--sand, #F5C177);
    font-style: normal;
    font-weight: inherit;
  }
  .v2-newsletter__body {
    font-family: var(--font-ui);
    font-size: var(--fs-500);
    line-height: var(--lh-dek, 1.45);
    color: rgb(250 247 240 / .85);
    max-width: 52ch;
    text-wrap: pretty;
    margin: 0;
  }
  /* Only a sentence-length sub from an older caller renders here; the
     default short sub is a tick item under the form. */
  .v2-newsletter__sub {
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    line-height: var(--lh-ui, 1.4);
    color: rgb(250 247 240 / .85);
    max-width: 52ch;
    margin: var(--space-3) 0 0;
  }

  /* Two separate controls, not a shared capsule: an 8px-radius field and
     an 8px-radius sand button, both 48px tall. */
  .v2-newsletter__form {
    display: flex;
    gap: var(--space-3);
    max-width: 34rem;
  }
  .v2-newsletter__input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--fs-400); /* 17px: >=16px prevents iOS focus-zoom */
    background: rgb(255 255 255 / .06);
    color: var(--paper, #FAF7F0);
    border: 1px solid rgb(255 255 255 / .35);
    border-radius: var(--radius-s, 8px);
    transition: border-color var(--dur-med, 200ms) ease, background-color var(--dur-med, 200ms) ease;
  }
  .v2-newsletter__input:hover { border-color: rgb(255 255 255 / .55); }
  .v2-newsletter__input:focus {
    outline: 2px solid var(--focus-ring-color-inverse, #F5C177);
    outline-offset: 2px;
    border-color: rgb(255 255 255 / .7);
    background: rgb(255 255 255 / .1);
  }
  .v2-newsletter__input::placeholder { color: rgb(250 247 240 / .7); }
  .v2-newsletter__input:disabled { opacity: 0.7; }
  .v2-newsletter__submit {
    min-height: 48px;
    padding: 0 var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--fs-400);
    font-weight: var(--fw-bold, 700);
    letter-spacing: normal;
    text-transform: none;
    /* Sand on the dark ground: the palette's one warm pop, 8.9:1 with
       the deep-navy label (the old bronze-on-navy pairing was 4.3:1). */
    background: var(--sand, #F5C177);
    color: var(--bg-dark, #0B2E4A);
    border: 0;
    border-radius: var(--radius-s, 8px);
    cursor: pointer;
    transition: background-color var(--dur-med, 200ms) ease;
    white-space: nowrap;
  }
  .v2-newsletter__submit:hover { background: #EDB05F; }
  .v2-newsletter__submit:focus-visible {
    outline: 2px solid var(--focus-ring-color-inverse, #F5C177);
    outline-offset: 2px;
  }
  .v2-newsletter__submit:disabled { opacity: 0.6; cursor: default; }
  .v2-newsletter__status {
    margin: var(--space-3) 0 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    line-height: var(--lh-ui, 1.4);
    color: rgb(250 247 240 / .85);
    min-height: 1.2em;
  }
  .v2-newsletter__status:empty { display: none; }
  .v2-newsletter__status--err { color: var(--error-text-inverse, #FF9A8F); }
  .v2-newsletter__status--ok  { color: var(--sand, #F5C177); }
  /* Reassurance row: matching tick items under the form ("Unsubscribe any
     time", plus a short sub such as "Independent editorial"). */
  .v2-newsletter__meta {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    font-size: var(--fs-200);
    line-height: var(--lh-ui, 1.4);
    color: rgb(250 247 240 / .85);
    display: flex;
    gap: var(--space-2) var(--space-5);
    flex-wrap: wrap;
  }
  .v2-newsletter__meta li { display: inline-flex; align-items: center; gap: var(--space-2); margin: 0; padding: 0; white-space: nowrap; }
  .v2-newsletter__meta li::before { content: none; }
  .v2-newsletter__meta svg { color: var(--sand, #F5C177); flex: none; }

  @media (max-width: 640px) {
    .v2-newsletter__form {
      flex-direction: column;
      max-width: none;
    }
    .v2-newsletter__input,
    .v2-newsletter__submit { width: 100%; }
    .v2-newsletter__preview {
      padding: var(--space-5) var(--space-4);
    }
  }

  .v2-newsletter__preview {
    position: relative;
    background: var(--paper, #FAF7F0);
    color: var(--ink, #171413);
    padding: 2rem 2rem 1.8rem;
    border-radius: 2px;
    transform: rotate(-1deg);
    box-shadow: 0 40px 80px -20px rgba(0,0,0,0.4), 0 8px 18px -4px rgba(0,0,0,0.25);
    max-width: 28rem;
    justify-self: end;
    /* The whole card is a link to the current dispatch - reset the default
       anchor decoration and tighten the hover affordance so the card lifts
       slightly instead of underlining. */
    display: block;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.25s ease;
  }
  .v2-newsletter__preview:hover {
    transform: rotate(-0.5deg) translateY(-2px);
    box-shadow: 0 48px 90px -20px rgba(0,0,0,0.45), 0 10px 22px -4px rgba(0,0,0,0.28);
  }
  @media (max-width: 63.99em) {
    .v2-newsletter__preview { transform: none; justify-self: stretch; max-width: none; }
  }
  .v2-newsletter__preview:focus-visible {
    outline: 2px solid var(--focus-ring-color-inverse, #F5C177);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-newsletter__preview,
    .v2-newsletter__preview:hover { transition: none; }
  }
  .v2-newsletter__preview::before {
    content: '';
    position: absolute;
    top: -10px; left: 20px; right: 20px;
    height: 20px;
    background: var(--gold, #56b6a0);
    z-index: -1;
    border-radius: 2px;
    transform: rotate(0.5deg);
  }
  .v2-np__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line, #bed9d3);
    margin-bottom: 1.2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .v2-np__mark {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ochre, #26997e);
  }
  .v2-np__issue {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted, #6E655C);
  }
  .v2-np__title {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.012em;
    color: var(--ink, #171413);
    margin: 0 0 1rem;
    font-variation-settings: 'opsz' 32;
  }
  .v2-np__title em { font-style: normal; color: var(--ochre, #26997e); font-weight: 400; }
  .v2-np__items {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    font-family: var(--serif, 'Newsreader', serif);
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--ink-soft, #3A3531);
    font-variation-settings: 'opsz' 18;
  }
  .v2-np__items li { padding-left: 1rem; position: relative; margin-bottom: 0.4rem; }
  .v2-np__items li::before { content: '\2022'; position: absolute; left: 0; color: var(--ochre, #26997e); }
  .v2-np__foot {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    border-top: 1px solid var(--line, #bed9d3);
    padding-top: 0.85rem;
  }
</style>
