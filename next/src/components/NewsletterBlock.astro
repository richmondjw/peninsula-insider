---
/* NewsletterBlock - V2 design, namespaced (.v2-newsletter*).
   Strangler-fig migration of the V1 newsletter band.
   Every page that imports this component now ships the V2 magazine
   newsletter band: dark, two-column, preview-card, ochre-on-paper.
   CSS is inline in this file so it travels with the component
   without depending on V1's main stylesheet.

   Inline-editable surfaces are tagged against entity_type='page',
   entity_slug='home' - matches the existing override schema. */

import { getCollection } from 'astro:content';
import { editableText } from '../lib/inline-edit/attrs';
import { routeSlug } from '../lib/editorial';

export interface Props {
  title?: string;
  body?: string;
  sub?: string;
  issueNumber?: string;
  issueDate?: string;
  previewHeadline?: string;
  previewItems?: string[];
  endpoint?: string;
  source?: string;
  /**
   * Hide the preview card on the right entirely. Useful for footer/embedded
   * placements where the card would crowd the surface. Default false - the
   * preview card renders when there's a published weekend-picker article
   * to source from.
   */
  hidePreview?: boolean;
}

const {
  title = 'Peninsula This Weekend',
  body = 'One useful Peninsula email. Where to book, what changed, what\'s worth the drive - sent when there\'s actually something worth knowing.',
  sub = 'Independent. No affiliate links. Unsubscribe any time.',
  issueNumber = '',
  issueDate = '',
  previewHeadline = '',
  previewItems = [],
  endpoint = 'https://tjjhpvslpysfklwpqmgz.supabase.co/functions/v1/pi-newsletter-subscribe',
  source = 'footer',
  hidePreview = false,
} = Astro.props;

// ─── Preview card data ─────────────────────────────────────────────────
// Pulls from the most recent published weekend-picker article so the
// card on the right of the newsletter band is always in sync with the
// dispatch that's currently live. This solves the staleness that drove
// Remy to hide the card in d1903b2fc0 - the card can't go stale because
// it reads from the canonical article each build. Explicit props still
// win when a caller wants to override (e.g. for a campaign page).
const dispatchArticles = await getCollection(
  'articles',
  ({ data }) => data.status === 'published' && data.format === 'weekend-picker',
);
const dispatch = dispatchArticles
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0] ?? null;

// "Peninsula This Weekend - 16 to 17 May" → "16 to 17 May"
function deriveIssueLabel(d: any | null): string {
  if (!d) return '';
  const t = String(d.data.title ?? '');
  const m = t.match(/[---]\s*(.+)$/);
  if (m) return m[1].trim();
  return d.data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long' });
}

// 3 short picks for the bullet list. Cluster links are editor-curated and
// already short labels, so they're the cleanest source. Fall back to the
// first 3 FAQ questions (truncated) if cluster links aren't populated.
function derivePicks(d: any | null): string[] {
  if (!d) return [];
  const cluster = (d.data.clusterLinks ?? []) as Array<{ label: string }>;
  if (cluster.length > 0) return cluster.slice(0, 3).map((c) => c.label);
  const faq = (d.data.faq ?? []) as Array<{ question: string }>;
  return faq.slice(0, 3).map((f) => {
    const q = String(f.question ?? '').replace(/\s+/g, ' ').trim();
    return q.length > 70 ? q.slice(0, 67).trim() + '...' : q;
  });
}

const resolvedHeadline = previewHeadline || (dispatch?.data?.dek ?? '');
const resolvedIssueLabel =
  issueNumber && issueDate
    ? `${issueNumber} · ${issueDate}`
    : (issueNumber || issueDate || deriveIssueLabel(dispatch));
const resolvedPicks = previewItems.length > 0 ? previewItems : derivePicks(dispatch);
const dispatchHref = dispatch ? `/journal/${routeSlug(dispatch)}/` : '';
const readMinutes = dispatch?.data?.readingTimeMinutes ?? 4;
const resolvedFoot = dispatch
  ? `Read in ${readMinutes} ${readMinutes === 1 ? 'minute' : 'minutes'} · Used all weekend`
  : '';

const showPreview = !hidePreview && resolvedHeadline && resolvedPicks.length > 0;
---

<section class="v2-newsletter" id="newsletter" aria-labelledby="newsletter-title">
  <div class="v2-newsletter__container">
    <div class={`v2-newsletter__frame${showPreview ? ' v2-newsletter__frame--has-preview' : ''}`}>
      <div class="v2-newsletter__copy">
        <div
          class="v2-newsletter__eyebrow"
          {...editableText({ entityType: 'page', entitySlug: '_global', fieldPath: 'newsletter.eyebrow', label: 'Newsletter eyebrow' })}
        >Curated by our editors.</div>
        <h2
          class="v2-newsletter__title"
          id="newsletter-title"
          set:html={title}
          {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'newsletter.title', label: 'Newsletter title' })}
        />
        <p
          class="v2-newsletter__body"
          {...editableText({ entityType: 'page', entitySlug: 'home', fieldPath: 'newsletter.body', label: 'Newsletter body' })}
        >{body}</p>
        {sub && <p class="v2-newsletter__sub">{sub}</p>}

        <form
          class="v2-newsletter__form"
          novalidate
          data-source={source}
          data-endpoint={endpoint}
        >
          <input
            class="v2-newsletter__input"
            type="email"
            name="email"
            placeholder="your@email.com"
            aria-label="Email address"
            autocomplete="email"
            required
          />
          <button class="v2-newsletter__submit" type="submit">Join</button>
        </form>

        <div class="v2-newsletter__meta">
          <span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
            Unsubscribe any time
          </span>
        </div>
      </div>

      {showPreview && (
        <a
          href={dispatchHref || '/whats-on/this-weekend/'}
          class="v2-newsletter__preview"
          aria-label={`Read this issue: ${resolvedHeadline}`}
        >
          <div class="v2-np__head">
            <span class="v2-np__mark">Peninsula This Weekend</span>
            {resolvedIssueLabel && <span class="v2-np__issue">{resolvedIssueLabel}</span>}
          </div>
          <h3 class="v2-np__title" set:html={resolvedHeadline} />
          {resolvedPicks.length > 0 && (
            <ul class="v2-np__items">
              {resolvedPicks.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {resolvedFoot && <div class="v2-np__foot">{resolvedFoot}</div>}
        </a>
      )}
    </div>
  </div>
</section>

<script is:inline>
  /* V2 newsletter - namespaced submit handler. Survives view transitions. */
  (function () {
    function emailValid(s) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s); }
    function setStatus(form, msg, kind) {
      var parent = form.parentNode;
      var st = parent && parent.querySelector(':scope > .v2-newsletter__status');
      if (!st) {
        st = document.createElement('p');
        st.className = 'v2-newsletter__status';
        st.setAttribute('role', 'status');
        st.setAttribute('aria-live', 'polite');
        parent && parent.insertBefore(st, form.nextSibling);
      }
      st.textContent = msg;
      st.className = 'v2-newsletter__status' + (kind ? ' v2-newsletter__status--' + kind : '');
    }
    function init() {
      document.querySelectorAll('.v2-newsletter__form').forEach(function (form) {
        if (form._v2nlInit) return;
        form._v2nlInit = true;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var input = form.querySelector('.v2-newsletter__input');
          var btn   = form.querySelector('.v2-newsletter__submit');
          var email = ((input && input.value) || '').trim();
          if (!emailValid(email)) {
            setStatus(form, 'Please enter a valid email address.', 'err');
            input && input.focus();
            return;
          }
          var endpoint = form.dataset.endpoint || '';
          var source   = form.dataset.source   || 'v2-newsletter';
          if (btn) { btn.disabled = true; btn.textContent = 'Joining...'; }
          setStatus(form, '', '');
          function ok() {
            if (btn) btn.textContent = 'Done';
            setStatus(form, "You're in. The next edition will land in your inbox soon.", 'ok');
            if (input) { input.value = ''; input.disabled = true; }
          }
          function fail(msg) {
            if (btn) { btn.textContent = 'Join'; btn.disabled = false; }
            setStatus(form, msg || 'Something went wrong. Please try again.', 'err');
          }
          if (!endpoint) {
            fail('Signups are briefly offline. Email hello@peninsulainsider.com.au and we will add you.');
            return;
          }
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, source: source }),
          })
            .then(function (r) { return r.json().catch(function () { return {}; }); })
            .then(function (d) { if (d && (d.ok || d.success)) ok(); else fail(d && d.message); })
            .catch(function () { fail(); });
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style is:global>
  .v2-newsletter {
    position: relative;
    background: var(--deep, #201B17);
    color: var(--paper, #FAF7F0);
    padding: clamp(4rem, 9vw, 7rem) 0;
    overflow: hidden;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
  }
  .v2-newsletter::before {
    content: '';
    position: absolute;
    top: 0; right: -30%;
    width: 70%; height: 100%;
    background: radial-gradient(circle at center, rgba(11, 90, 72,0.15), transparent 65%);
    pointer-events: none;
  }
  .v2-newsletter__container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }
  .v2-newsletter__frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  /* Two columns when a preview card is present - the right column
     carries the magazine-style "this issue" teaser. Type column is
     slightly wider so the hero headline still leads the band. */
  .v2-newsletter__frame--has-preview {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  @media (max-width: 880px) {
    .v2-newsletter__frame,
    .v2-newsletter__frame--has-preview { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .v2-newsletter {
      padding: 3.25rem 0;
    }
    .v2-newsletter__container {
      padding: 0 1rem;
    }
    .v2-newsletter__copy,
    .v2-newsletter__body {
      max-width: none;
    }
    .v2-newsletter__title {
      font-size: clamp(2rem, 10vw, 3rem);
      line-height: 0.98;
    }
    .v2-newsletter__body {
      font-size: 1rem;
      line-height: 1.55;
    }
    .v2-newsletter__form {
      max-width: none;
      width: 100%;
      flex-direction: column;
      border-radius: 1.25rem;
    }
    .v2-newsletter__input {
      width: 100%;
      padding: 1rem 1.1rem;
    }
    .v2-newsletter__submit {
      width: 100%;
      padding: 1rem 1.1rem;
      text-align: center;
    }
    .v2-newsletter__meta {
      gap: 0.75rem 1rem;
    }
    .v2-newsletter__preview {
      padding: 1.35rem 1.15rem 1.2rem;
      margin-top: 1.35rem;
    }
  }
  .v2-newsletter__copy { max-width: 64ch; }
  .v2-newsletter__eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--gold, #56b6a0);
    margin-bottom: 1.2rem;
  }
  .v2-newsletter__title {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--paper, #FAF7F0);
    margin: 0 0 1.4rem;
    font-variation-settings: 'opsz' 60;
  }
  .v2-newsletter__title em {
    color: var(--gold, #56b6a0);
    font-style: normal;
    font-weight: 300;
  }
  .v2-newsletter__body {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(250,247,240,0.7);
    max-width: 48ch;
    font-variation-settings: 'opsz' 20;
    margin: 0 0 0.65rem;
  }
  .v2-newsletter__sub {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: normal;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(250,247,240,0.5);
    max-width: 48ch;
    margin: 0 0 2rem;
  }
  .v2-newsletter__form {
    display: flex;
    max-width: 460px;
    background: rgba(250,247,240,0.05);
    border: 1px solid rgba(250,247,240,0.15);
    border-radius: 100px;
    overflow: hidden;
    transition: border-color .25s ease;
  }
  .v2-newsletter__form:focus-within { border-color: rgba(86, 182, 160,0.5); }
  .v2-newsletter__input {
    flex: 1;
    padding: 1rem 1.5rem;
    font-family: var(--font-ui);
    font-size: var(--fs-400); /* 17px: >=16px prevents iOS focus-zoom */
    background: transparent;
    color: var(--paper, #FAF7F0);
    border: none;
    outline: none;
    min-width: 0;
  }
  .v2-newsletter__input::placeholder { color: rgba(250,247,240,0.4); }
  .v2-newsletter__submit {
    padding: 1rem 1.8rem;
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: var(--gold, #56b6a0);
    color: var(--deep, #201B17);
    border: 0;
    cursor: pointer;
    transition: background .25s ease;
    white-space: nowrap;
  }
  .v2-newsletter__submit:hover { background: #67c9b2; }
  .v2-newsletter__submit:disabled { opacity: 0.6; cursor: default; }
  .v2-newsletter__status {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    color: rgba(250,247,240,0.7);
    min-height: 1.2em;
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-style: normal;
  }
  .v2-newsletter__status--err { color: #a3e7d7; }
  .v2-newsletter__status--ok  { color: var(--gold, #56b6a0); }
  .v2-newsletter__meta {
    margin-top: 1.5rem;
    font-size: 0.78rem;
    color: rgba(250,247,240,0.4);
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .v2-newsletter__meta span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .v2-newsletter__meta svg { color: var(--gold, #56b6a0); }

  .v2-newsletter__preview {
    position: relative;
    background: var(--paper, #FAF7F0);
    color: var(--ink, #171413);
    padding: 2rem 2rem 1.8rem;
    border-radius: 2px;
    transform: rotate(-1deg);
    box-shadow: 0 40px 80px -20px rgba(0,0,0,0.4), 0 8px 18px -4px rgba(0,0,0,0.25);
    max-width: 28rem;
    justify-self: end;
    /* The whole card is a link to the current dispatch - reset the default
       anchor decoration and tighten the hover affordance so the card lifts
       slightly instead of underlining. */
    display: block;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.25s ease;
  }
  .v2-newsletter__preview:hover {
    transform: rotate(-0.5deg) translateY(-2px);
    box-shadow: 0 48px 90px -20px rgba(0,0,0,0.45), 0 10px 22px -4px rgba(0,0,0,0.28);
  }
  @media (max-width: 880px) {
    .v2-newsletter__preview { transform: none; margin-top: 2rem; justify-self: stretch; max-width: none; }
  }
  .v2-newsletter__preview::before {
    content: '';
    position: absolute;
    top: -10px; left: 20px; right: 20px;
    height: 20px;
    background: var(--gold, #56b6a0);
    z-index: -1;
    border-radius: 2px;
    transform: rotate(0.5deg);
  }
  .v2-np__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line, #bed9d3);
    margin-bottom: 1.2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .v2-np__mark {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ochre, #26997e);
  }
  .v2-np__issue {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted, #6E655C);
  }
  .v2-np__title {
    font-family: var(--serif, 'Newsreader', 'Times New Roman', serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.012em;
    color: var(--ink, #171413);
    margin: 0 0 1rem;
    font-variation-settings: 'opsz' 32;
  }
  .v2-np__title em { font-style: normal; color: var(--ochre, #26997e); font-weight: 400; }
  .v2-np__items {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    font-family: var(--serif, 'Newsreader', serif);
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--ink-soft, #3A3531);
    font-variation-settings: 'opsz' 18;
  }
  .v2-np__items li { padding-left: 1rem; position: relative; margin-bottom: 0.4rem; }
  .v2-np__items li::before { content: '\2022'; position: absolute; left: 0; color: var(--ochre, #26997e); }
  .v2-np__foot {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    border-top: 1px solid var(--line, #bed9d3);
    padding-top: 0.85rem;
  }
</style>
