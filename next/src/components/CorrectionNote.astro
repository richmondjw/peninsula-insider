---
export interface Props {
  compact?: boolean;
  /** Where the prompt is rendered. Rides the analytics attribute only. */
  surface?: string;
}

const { compact = false, surface = 'article-note' } = Astro.props;
---

<p class:list={["correction-note", compact && "correction-note--compact"]}>
  Something wrong on this page, or is this your business?
  <a href="/contact/?type=correction" data-pi-intent="correction" data-pi-surface={surface}>Tell us what to fix</a>
  and you get a case reference back.
  <a href="mailto:corrections@peninsulainsider.com.au" data-pi-intent="correction" data-pi-surface={surface}>corrections@peninsulainsider.com.au</a>
  reaches the same desk.
</p>

<style>
  .correction-note {
    margin: 2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft, #433d39);
  }

  .correction-note--compact {
    margin-top: 1.5rem;
    font-size: 0.88rem;
  }

  .correction-note a {
    color: var(--accent, #3e7a6c);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
