---
export interface Props {
  compact?: boolean;
  /** Where the prompt is rendered. Rides the analytics attribute only. */
  surface?: string;
}

const { compact = false, surface = 'article-note' } = Astro.props;
---

<p class:list={["correction-note", compact && "correction-note--compact"]}>
  Something wrong on this page, or is this your business?
  <a href="/contact/?type=correction" data-pi-intent="correction" data-pi-surface={surface}>Tell us what to fix</a>
  and you get a case reference back.
  <a href="mailto:corrections@peninsulainsider.com.au" data-pi-intent="correction" data-pi-surface={surface}>corrections@peninsulainsider.com.au</a>
  reaches the same desk.
</p>

<style>
  /* A strip with room on both sides: 24px above and below its text, and
     48px of clearance from whatever band follows (the footer, the Insider
     Note band), so it never sits jammed in the seam between two grounds. */
  .correction-note {
    margin: var(--space-7, 3rem) 0;
    padding-block: var(--space-5, 1.5rem);
    border-top: 1px solid var(--border, rgba(0, 0, 0, 0.1));
    font-size: var(--fs-300, 0.9375rem);
    line-height: 1.6;
    color: var(--soft, #4B5862);
    text-wrap: pretty;
  }

  /* G23: after a padded section (the hub FAQ) the section's own bottom
     padding is the gap; a second 48px on top would double it. As the last
     thing on the page the strip closes on its own 24px padding, meeting
     the footer's top rule as a matched pair of hairlines. */
  :global(.pi-section) + .correction-note,
  :global(.pi-section + .container) > .correction-note:first-child {
    margin-top: 0;
  }
  :global(main > .container:last-child) > .correction-note:last-child {
    margin-bottom: 0;
  }

  .correction-note--compact {
    margin-top: var(--space-5, 1.5rem);
    font-size: 0.875rem;
  }

  .correction-note a {
    color: var(--harbour, #10527E);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
</style>
