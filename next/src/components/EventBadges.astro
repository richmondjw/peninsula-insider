---
/**
 * EventBadges  -  the editorial differentiators rendered as a small
 * badge strip on event cards and event detail pages.
 *
 * These are the Peninsula Insider wedge against the DMO:
 * Worth The Drive, First Timer, Weather flag, and an explicit
 * planning note when set.
 */
import { weatherCopy } from '../lib/editorial';

export interface Props {
  worthTheDrive?: boolean;
  firstTimer?: boolean;
  weather?: 'all-weather' | 'sunny-only' | 'rainy-day-rescue' | 'weather-proof' | 'mixed';
  skipThis?: boolean;
  size?: 'sm' | 'md';
}

const {
  worthTheDrive = false,
  firstTimer = false,
  weather,
  skipThis = false,
  size = 'sm',
} = Astro.props;

const weatherLabel = weather && weather !== 'mixed' ? weatherCopy[weather] : undefined;
---

<div class={`event-badges event-badges--${size}`}>
  {skipThis && (
    <span class="event-badge event-badge--skip" title="Planning note from the editor">Worth knowing</span>
  )}
  {worthTheDrive && (
    <span class="event-badge event-badge--drive" title="Worth the 90-minute drive from Melbourne">Worth the drive</span>
  )}
  {firstTimer && (
    <span class="event-badge event-badge--first" title="If you've never been  -  start here">First timer</span>
  )}
  {weatherLabel && (
    <span class="event-badge event-badge--weather">{weatherLabel}</span>
  )}
</div>
