---
import {imageAlt, imageUrl} from '../../lib/sanity/page-builder'

export interface Props {
  section: Record<string, any>
}

const {section} = Astro.props
const cards = Array.isArray(section.cards) ? section.cards : []
---

{(section.heading || cards.length > 0) && (
  <section class="pb-card-grid">
    <div class="container">
      <div class="pb-card-grid__head">
        {section.eyebrow && <p class="label label--accent">{section.eyebrow}</p>}
        {section.heading && <h2>{section.heading}</h2>}
        {section.intro && <p>{section.intro}</p>}
      </div>
      {cards.length > 0 && (
        <div class="pb-card-grid__grid">
          {cards.map((card) => {
            const src = imageUrl(card.image, 'card')
            const body = (
              <>
                {src && <img src={src} alt={imageAlt(card.image, card.title || '')} loading="lazy" decoding="async" />}
                <div class="pb-card-grid__body">
                  {card.label && <p class="pb-card-grid__label">{card.label}</p>}
                  {card.title && <h3>{card.title}</h3>}
                  {card.description && <p>{card.description}</p>}
                </div>
              </>
            )
            return card.url ? <a class="pb-card" href={card.url}>{body}</a> : <article class="pb-card">{body}</article>
          })}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .pb-card-grid {
    padding: clamp(3rem, 6vw, 5rem) 0;
    background: #fff;
  }
  .pb-card-grid__head {
    max-width: 760px;
    margin-bottom: clamp(1.7rem, 4vw, 3rem);
  }
  .pb-card-grid__head h2 {
    margin: 0.35rem 0 0.8rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
  }
  .pb-card-grid__head p:not(.label) {
    margin: 0;
    color: var(--soft, #6f675f);
    line-height: 1.6;
  }
  .pb-card-grid__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2rem);
  }
  .pb-card {
    color: inherit;
    text-decoration: none;
  }
  .pb-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .pb-card-grid__body {
    padding-top: 1rem;
  }
  .pb-card-grid__label {
    margin: 0 0 0.45rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent, #a0541f);
  }
  .pb-card h3 {
    margin: 0 0 0.4rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.08;
  }
  .pb-card p:not(.pb-card-grid__label) {
    margin: 0;
    color: var(--soft, #6f675f);
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .pb-card-grid__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

