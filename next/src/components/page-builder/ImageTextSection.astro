---
import PortableTextBody from '../PortableTextBody.astro'
import {imageAlt, imageUrl} from '../../lib/sanity/page-builder'

export interface Props {
  section: Record<string, any>
}

const {section} = Astro.props
const src = imageUrl(section.image, 'gallery')
const alt = imageAlt(section.image, section.heading || '')
const blocks = Array.isArray(section.body) ? section.body : []
const flip = section.imagePosition === 'left'
---

<section class={`pb-image-text ${flip ? 'pb-image-text--flip' : ''}`}>
  <div class="container pb-image-text__inner">
    {src && (
      <figure class="pb-image-text__media">
        <img src={src} alt={alt} loading="lazy" decoding="async" />
        {section.image?.caption && <figcaption>{section.image.caption}</figcaption>}
      </figure>
    )}
    <div class="pb-image-text__copy">
      {section.eyebrow && <p class="label label--accent">{section.eyebrow}</p>}
      {section.heading && <h2>{section.heading}</h2>}
      {blocks.length > 0 && <div class="prose"><PortableTextBody blocks={blocks} /></div>}
      {section.primaryCtaLabel && section.primaryCtaUrl && <a class="pb-text-link" href={section.primaryCtaUrl}>{section.primaryCtaLabel} →</a>}
    </div>
  </div>
</section>

<style>
  .pb-image-text {
    padding: clamp(3rem, 6vw, 5rem) 0;
    background: #fff;
  }
  .pb-image-text__inner {
    display: grid;
    grid-template-columns: minmax(280px, 0.95fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .pb-image-text--flip .pb-image-text__media {
    order: -1;
  }
  .pb-image-text:not(.pb-image-text--flip) .pb-image-text__copy {
    order: -1;
  }
  .pb-image-text__media {
    margin: 0;
  }
  .pb-image-text__media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .pb-image-text__media figcaption {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    color: var(--soft, #6f675f);
  }
  .pb-image-text h2 {
    margin: 0.35rem 0 1rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.02;
  }
  .pb-text-link {
    display: inline-block;
    margin-top: 1.3rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, #a0541f);
    text-decoration: none;
  }
  @media (max-width: 780px) {
    .pb-image-text__inner {
      grid-template-columns: 1fr;
    }
    .pb-image-text__media,
    .pb-image-text__copy {
      order: initial !important;
    }
  }
</style>

