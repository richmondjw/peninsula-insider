---
export interface Props {
  section: Record<string, any>
}

const {section} = Astro.props
const variant = section.styleVariant || 'warm'
---

{(section.heading || section.text) && (
  <section class={`pb-cta pb-cta--${variant}`}>
    <div class="container pb-cta__inner">
      <div>
        {section.heading && <h2>{section.heading}</h2>}
        {section.text && <p>{section.text}</p>}
      </div>
      {(section.primaryCtaLabel || section.secondaryCtaLabel) && (
        <div class="pb-cta__actions">
          {section.primaryCtaLabel && section.primaryCtaUrl && <a class="pb-cta__btn pb-cta__btn--primary" href={section.primaryCtaUrl}>{section.primaryCtaLabel}</a>}
          {section.secondaryCtaLabel && section.secondaryCtaUrl && <a class="pb-cta__btn pb-cta__btn--secondary" href={section.secondaryCtaUrl}>{section.secondaryCtaLabel}</a>}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .pb-cta {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .pb-cta__inner {
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) 0;
    border-top: 1px solid rgba(23, 20, 19, 0.14);
    border-bottom: 1px solid rgba(23, 20, 19, 0.14);
  }
  .pb-cta--warm {
    background: #f8f4ec;
  }
  .pb-cta--dark {
    background: #171413;
    color: #fffaf0;
  }
  .pb-cta h2 {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
  }
  .pb-cta p {
    margin: 0.7rem 0 0;
    max-width: 44rem;
    color: inherit;
    opacity: 0.78;
    line-height: 1.55;
  }
  .pb-cta__actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }
  .pb-cta__btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.8rem 1.1rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .pb-cta__btn--primary {
    background: currentColor;
    color: #fffaf0;
  }
  .pb-cta--dark .pb-cta__btn--primary {
    background: #fffaf0;
    color: #171413;
  }
  .pb-cta__btn--secondary {
    color: inherit;
    border-bottom: 1px solid currentColor;
  }
  @media (max-width: 760px) {
    .pb-cta__inner {
      display: block;
    }
    .pb-cta__actions {
      margin-top: 1.3rem;
    }
  }
</style>

