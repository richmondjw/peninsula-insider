---
/**
 * CellarDoorList - designed list of cellar-door reviews inside a hub-guide
 * MDX article. Each item is one venue (by slug) plus a hand-written
 * editorial verdict that overlays the venue's canonical card data.
 *
 * Why this exists: the previous prose pattern wrote a 2-3 sentence mini-
 * review per venue under an H3, then the template rendered generic
 * "Mentioned in this piece" VenueCards below for the SAME venues with
 * no editorial detail. Reader got the same venue twice in two formats.
 * This component fuses the two - single rendered card with hero image,
 * canonical hours/location, AND the writer's specific verdict.
 *
 * Usage in MDX:
 *
 *   import CellarDoorList from '../../components/hub-guide/CellarDoorList.astro';
 *
 *   <CellarDoorList items={[
 *     {
 *       slug: "montalto",
 *       eyebrow: "Red Hill South",
 *       verdict: "Daily. Hatted restaurant plus Piazza walk-in tier…",
 *     },
 *     …
 *   ]} />
 */
import { getCollection } from 'astro:content';
import { resolveHeroSrc, formatHeroCredit } from '../../lib/editorial';
import PiSaveActions from '../PiSaveActions.astro';

export interface CellarDoorItem {
  /** Slug into venues collection. */
  slug: string;
  /** Optional small-caps eyebrow above the title (e.g. sub-region). */
  eyebrow?: string;
  /** Required hand-written editorial verdict. The whole point of the
   *  component - the writer's specific opinion on this venue. */
  verdict: string;
  /** Optional list of small badge tags ("Dog-friendly", "Walk-in", etc).
   *  Render below the verdict as chip badges. */
  badges?: string[];
}
export interface Props {
  items: CellarDoorItem[];
  eyebrow?: string;
  heading?: string;
  /** Prefix for the venue detail URL. Defaults to /wine. */
  hrefPrefix?: string;
}

const { items, eyebrow = "Editor's cellar-door list", heading, hrefPrefix = '/wine' } = Astro.props;

const allVenues = await getCollection('venues');
const venueBySlug = new Map<string, any>();
for (const v of allVenues) {
  venueBySlug.set(v.data.slug ?? v.id, v);
}

const resolved = items
  .map((item) => {
    const venue = venueBySlug.get(item.slug);
    return venue ? { ...item, venue } : null;
  })
  .filter((x): x is (CellarDoorItem & { venue: any }) => x !== null);
---

<section class="hub-cellars">
  {(eyebrow || heading) && (
    <header class="hub-cellars__head">
      {eyebrow && <p class="hub-cellars__eyebrow">{eyebrow}</p>}
      {heading && <h2 class="hub-cellars__heading">{heading}</h2>}
    </header>
  )}
  <ol class="hub-cellars__list">
    {resolved.map(({ slug, eyebrow: itemEyebrow, verdict, badges, venue }) => {
      const href = `${hrefPrefix}/${slug}/`;
      const heroSrc = resolveHeroSrc(venue.data);
      const heroAlt = venue.data.heroImage?.alt ?? `${venue.data.name}, Mornington Peninsula`;
      return (
        <li class="hub-cellar">
          <a href={href} class="hub-cellar__image" aria-hidden="true" tabindex="-1">
            {heroSrc
              ? <img src={heroSrc} alt={heroAlt} loading="lazy" decoding="async" />
              : <span class="hub-cellar__image-placeholder" aria-hidden="true"></span>
            }
          </a>
          <div class="hub-cellar__body">
            {itemEyebrow && <p class="hub-cellar__eyebrow">{itemEyebrow}</p>}
            <h3 class="hub-cellar__title"><a href={href}>{venue.data.name}</a></h3>
            <p class="hub-cellar__verdict">{verdict}</p>
            {(badges?.length || venue.data.authority?.hallidayScore) && (
              <ul class="hub-cellar__badges">
                {badges?.map((b) => (
                  <li class="hub-cellar__badge">{b}</li>
                ))}
                {venue.data.authority?.hallidayScore && (
                  <li class="hub-cellar__badge hub-cellar__badge--authority">Halliday {venue.data.authority.hallidayScore}</li>
                )}
              </ul>
            )}
            <div class="hub-cellar__actions">
              <a href={href} class="hub-cellar__cta">Open the editor's note <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <PiSaveActions
            kind="venue"
            slug={slug}
            title={venue.data.name}
            href={href}
            dek={verdict}
            imageUrl={heroSrc}
          />
        </li>
      );
    })}
  </ol>
</section>

<style>
  .hub-cellars {
    margin: clamp(2rem, 4vw, 3rem) 0;
  }
  .hub-cellars__head {
    margin: 0 0 clamp(1.25rem, 2vw, 1.75rem);
    max-width: 50rem;
  }
  .hub-cellars__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #26997e);
    margin: 0 0 0.5rem;
  }
  .hub-cellars__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink, #171413);
  }
  .hub-cellars__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  @media (min-width: 760px) {
    .hub-cellars__list { grid-template-columns: 1fr 1fr; }
  }
  .hub-cellar {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(251, 253, 252, 0.7);
    border: 1px solid rgba(74, 90, 87, 0.14);
    border-radius: 6px;
    overflow: hidden;
    padding-bottom: 3.25rem; /* room for floating save/share pills */
  }
  .hub-cellar__image {
    display: block;
    aspect-ratio: 16 / 10;
    background: rgba(74, 90, 87, 0.08);
    overflow: hidden;
  }
  .hub-cellar__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .hub-cellar:hover .hub-cellar__image img { transform: scale(1.03); }
  .hub-cellar__image-placeholder {
    display: block;
    height: 100%;
    background: linear-gradient(135deg, #9ac9be 0%, #78a89d 60%, #558b7e 100%);
  }
  .hub-cellar__body {
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.25rem, 2vw, 1.6rem) 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .hub-cellar__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, #26997e);
    margin: 0;
  }
  .hub-cellar__title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink, #171413);
  }
  .hub-cellar__title a {
    color: inherit;
    text-decoration: none;
  }
  .hub-cellar__title a:hover { color: var(--accent, #26997e); }
  .hub-cellar__verdict {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft, #3A3531);
    margin: 0;
  }
  .hub-cellar__badges {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hub-cellar__badge {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    background: rgba(74, 90, 87, 0.08);
    color: var(--ink-soft, #3A3531);
    border: 1px solid rgba(74, 90, 87, 0.15);
    border-radius: 999px;
  }
  .hub-cellar__badge--authority {
    background: rgba(11, 90, 72, 0.1);
    color: var(--accent, #26997e);
    border-color: rgba(11, 90, 72, 0.25);
  }
  .hub-cellar__actions {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .hub-cellar__cta {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent, #26997e);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .hub-cellar__cta:hover { opacity: 0.75; }
</style>
