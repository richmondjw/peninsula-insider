---
/**
 * SubregionGrid — designed grid for "places within a region" data inside
 * a hub-guide MDX article.
 *
 * Replaces the prose pattern of H3 + description + bold winery names. The
 * writer passes an array of items; the component renders a card per item
 * with the sub-region's character text and a chip row of linked wineries
 * (resolved against the venues collection so each chip becomes a real
 * link with the canonical /wine/[slug]/ URL).
 *
 * Usage in MDX:
 *
 *   import SubregionGrid from '../../components/hub-guide/SubregionGrid.astro';
 *
 *   <SubregionGrid items={[
 *     {
 *       title: "Red Hill South",
 *       lede: "The plateau's highest elevations…",
 *       wineries: ["montalto", "port-phillip-estate", "paringa-estate"],
 *     },
 *     …
 *   ]} />
 */
import { getCollection } from 'astro:content';

export interface SubregionItem {
  title: string;
  /** Optional eyebrow above the title (e.g. "Red Hill plateau"). */
  eyebrow?: string;
  /** Short character paragraph. 1-3 sentences. */
  lede: string;
  /** Slugs into the venues collection. Rendered as chip links. */
  wineries?: string[];
  /** Optional href for the title to link to (e.g. /wine/red-hill/). */
  href?: string;
}
export interface Props {
  items: SubregionItem[];
  /** Optional eyebrow above the grid. Defaults to "By sub-region". */
  eyebrow?: string;
  /** Optional heading above the grid. */
  heading?: string;
}

const { items, eyebrow = 'By sub-region', heading } = Astro.props;

// Resolve winery slugs to venues so we can render real links with proper
// labels. Unknown slugs are dropped from the chip row (writer sees only
// the bare slug in the dev preview which makes the typo obvious).
const allVenues = await getCollection('venues');
const venueBySlug = new Map<string, any>();
for (const v of allVenues) {
  venueBySlug.set(v.data.slug ?? v.id, v);
}

const resolved = items.map((item) => ({
  ...item,
  wineryChips: (item.wineries ?? []).map((slug) => {
    const v = venueBySlug.get(slug);
    return v
      ? { slug, label: v.data.name, href: `/wine/${slug}/` }
      : { slug, label: slug, href: null };
  }),
}));
---

<section class="hub-subregions">
  {(eyebrow || heading) && (
    <header class="hub-subregions__head">
      {eyebrow && <p class="hub-subregions__eyebrow">{eyebrow}</p>}
      {heading && <h2 class="hub-subregions__heading">{heading}</h2>}
    </header>
  )}
  <ol class="hub-subregions__grid">
    {resolved.map((item) => (
      <li class="hub-subregion">
        {item.eyebrow && <p class="hub-subregion__eyebrow">{item.eyebrow}</p>}
        <h3 class="hub-subregion__title">
          {item.href ? <a href={item.href}>{item.title}</a> : item.title}
        </h3>
        <p class="hub-subregion__lede">{item.lede}</p>
        {item.wineryChips.length > 0 && (
          <ul class="hub-subregion__chips">
            {item.wineryChips.map((chip) => (
              <li>
                {chip.href
                  ? <a href={chip.href} class="hub-subregion__chip">{chip.label}</a>
                  : <span class="hub-subregion__chip hub-subregion__chip--missing">{chip.label}</span>
                }
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .hub-subregions {
    margin: clamp(2rem, 4vw, 3rem) 0;
  }
  .hub-subregions__head {
    margin: 0 0 clamp(1.25rem, 2vw, 1.75rem);
    max-width: 50rem;
  }
  .hub-subregions__eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #A0541F);
    margin: 0 0 0.5rem;
  }
  .hub-subregions__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink, #171413);
  }
  /* Container queries — grid reacts to its own width, not the viewport.
     See VarietyGuide.astro for the rationale: hub-guide layouts have a
     sticky TOC eating ~250px of the content column on desktop, so a
     viewport-based 3-col rule at 980px collapses cards to ~250px each
     and squeezes the editorial text. Using @container makes the grid
     correct in both hub-guide and standalone contexts. */
  .hub-subregions {
    container-type: inline-size;
  }
  .hub-subregions__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @container (min-width: 520px) {
    .hub-subregions__grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  }
  @container (min-width: 900px) {
    .hub-subregions__grid { grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
  }
  .hub-subregion {
    padding: clamp(1.1rem, 2vw, 1.5rem);
    background: rgba(255, 252, 247, 0.7);
    border: 1px solid rgba(121, 92, 58, 0.14);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .hub-subregion__eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, #A0541F);
    margin: 0;
  }
  .hub-subregion__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink, #171413);
  }
  .hub-subregion__title a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .hub-subregion__title a:hover {
    color: var(--accent, #A0541F);
    border-bottom-color: currentColor;
  }
  .hub-subregion__lede {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft, #3A3531);
    margin: 0;
  }
  .hub-subregion__chips {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hub-subregion__chip {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--accent, #A0541F);
    text-decoration: none;
    background: rgba(160, 84, 31, 0.07);
    border: 1px solid rgba(160, 84, 31, 0.18);
    border-radius: 999px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .hub-subregion__chip:hover {
    background: var(--accent, #A0541F);
    color: var(--paper, #FAF6EE);
  }
  .hub-subregion__chip--missing {
    opacity: 0.5;
    text-decoration: line-through;
  }
</style>
