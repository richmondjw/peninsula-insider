---
/**
 * PracticalCallout — designed callout for the "before you go" logistics
 * paragraph that's typically buried at the bottom of hub-guide articles.
 * Pulls the trip-planning intelligence out of the prose flow and gives
 * it a visually distinct treatment so it scans as actionable rather than
 * reading as a footnote.
 *
 * Also used for verification statements ("how we sourced this") via the
 * `variant="trust"` prop — same visual rhythm, different colour intent.
 *
 * Usage in MDX:
 *
 *   import PracticalCallout from '../../components/hub-guide/PracticalCallout.astro';
 *
 *   <PracticalCallout eyebrow="Before you drive">
 *     Most cellar doors operate Thursday to Monday. Tuesday and Wednesday
 *     closures are standard. Bookings essential at Ten Minutes by Tractor…
 *   </PracticalCallout>
 *
 *   <PracticalCallout variant="trust" eyebrow="How we verify">
 *     Cellar door hours and dog policies are sourced from each venue's
 *     primary website. Dog-friendly status is listed as confirmed only
 *     when explicitly stated by the venue itself.
 *   </PracticalCallout>
 */
export interface Props {
  eyebrow?: string;
  heading?: string;
  variant?: 'practical' | 'trust';
}

const { eyebrow, heading, variant = 'practical' } = Astro.props;
---

<aside class={`hub-callout hub-callout--${variant}`} role="note">
  <div class="hub-callout__inner">
    {eyebrow && <p class="hub-callout__eyebrow">{eyebrow}</p>}
    {heading && <h3 class="hub-callout__heading">{heading}</h3>}
    <div class="hub-callout__body">
      <slot />
    </div>
  </div>
</aside>

<style>
  .hub-callout {
    margin: clamp(2rem, 4vw, 3rem) 0;
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 6px;
    background: rgba(160, 84, 31, 0.05);
    border-left: 3px solid var(--accent, #A0541F);
  }
  .hub-callout--trust {
    background: rgba(121, 92, 58, 0.04);
    border-left-color: rgba(121, 92, 58, 0.4);
  }
  .hub-callout__inner {
    max-width: 50rem;
  }
  .hub-callout__eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #A0541F);
    margin: 0 0 0.65rem;
  }
  .hub-callout--trust .hub-callout__eyebrow {
    color: rgba(121, 92, 58, 0.7);
  }
  .hub-callout__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0 0 0.85rem;
    color: var(--ink, #171413);
  }
  .hub-callout__body {
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--ink, #171413);
  }
  .hub-callout__body :global(p) {
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    line-height: 1.65;
    margin: 0 0 0.75rem;
  }
  .hub-callout__body :global(p:last-child) { margin-bottom: 0; }
  .hub-callout__body :global(strong) {
    font-weight: 600;
    color: var(--ink, #171413);
  }
  .hub-callout--trust .hub-callout__body {
    font-style: italic;
  }
  .hub-callout--trust .hub-callout__body :global(p) {
    font-size: clamp(0.92rem, 1vw, 1rem);
    color: var(--ink-soft, #3A3531);
  }
</style>
