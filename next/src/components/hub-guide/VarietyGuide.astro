---
/**
 * VarietyGuide - designed 2/3/4-up grid for "what to drink / eat / try"
 * sections inside a hub-guide MDX article. Replaces the bare H3 + para
 * pattern with a card per variety, with optional linked producer chips.
 *
 * Usage in MDX:
 *
 *   import VarietyGuide from '../../components/hub-guide/VarietyGuide.astro';
 *
 *   <VarietyGuide items={[
 *     {
 *       name: "Pinot Noir",
 *       eyebrow: "The signature grape",
 *       body: "The Peninsula's signature variety…",
 *       producers: ["main-ridge-estate", "ten-minutes-by-tractor"],
 *     },
 *     …
 *   ]} />
 */
import { getCollection } from 'astro:content';

export interface VarietyItem {
  /** Variety / category name (e.g. "Pinot Noir"). */
  name: string;
  /** Optional eyebrow above the name. */
  eyebrow?: string;
  /** Body text - the editorial description. */
  body: string;
  /** Optional list of venue slugs to render as chip links. */
  producers?: string[];
  /** Optional href for the title (e.g. /wine/pinot-noir/). */
  href?: string;
}
export interface Props {
  items: VarietyItem[];
  eyebrow?: string;
  heading?: string;
  /** Prefix for producer chip URLs. Defaults to /wine. */
  producerHrefPrefix?: string;
}

const { items, eyebrow = 'By variety', heading, producerHrefPrefix = '/wine' } = Astro.props;

const allVenues = await getCollection('venues');
const venueBySlug = new Map<string, any>();
for (const v of allVenues) {
  venueBySlug.set(v.data.slug ?? v.id, v);
}

const resolved = items.map((item) => ({
  ...item,
  producerChips: (item.producers ?? []).map((slug) => {
    const v = venueBySlug.get(slug);
    return v
      ? { slug, label: v.data.name, href: `${producerHrefPrefix}/${slug}/` }
      : { slug, label: slug, href: null };
  }),
}));
---

<section class="hub-variety">
  {(eyebrow || heading) && (
    <header class="hub-variety__head">
      {eyebrow && <p class="hub-variety__eyebrow">{eyebrow}</p>}
      {heading && <h2 class="hub-variety__heading">{heading}</h2>}
    </header>
  )}
  <ol class={`hub-variety__grid hub-variety__grid--${Math.min(items.length, 4)}`}>
    {resolved.map((item) => (
      <li class="hub-variety-card">
        {item.eyebrow && <p class="hub-variety-card__eyebrow">{item.eyebrow}</p>}
        <h3 class="hub-variety-card__name">
          {item.href ? <a href={item.href}>{item.name}</a> : item.name}
        </h3>
        <p class="hub-variety-card__body">{item.body}</p>
        {item.producerChips.length > 0 && (
          <ul class="hub-variety-card__chips" aria-label={`${item.name} producers`}>
            {item.producerChips.map((c) => (
              <li>
                {c.href
                  ? <a href={c.href} class="hub-variety-card__chip">{c.label}</a>
                  : <span class="hub-variety-card__chip hub-variety-card__chip--missing">{c.label}</span>
                }
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .hub-variety {
    margin: clamp(2rem, 4vw, 3rem) 0;
  }
  .hub-variety__head {
    margin: 0 0 clamp(1.25rem, 2vw, 1.75rem);
    max-width: 50rem;
  }
  .hub-variety__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #26997e);
    margin: 0 0 0.5rem;
  }
  .hub-variety__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink, #171413);
  }
  /* Container queries - the grid responds to its OWN available width,
     not the viewport. Hub-guide articles put a sticky ~250px TOC at the
     left of the content column on desktop, so the same grid has very
     different room to play with depending on which article it's inside.
     With viewport-based queries, the "By variety" cards collapsed to
     ~150px wide on hub-guide pages, which broke headings and turned
     body text into 6-word columns. */
  .hub-variety {
    container-type: inline-size;
  }
  .hub-variety__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @container (min-width: 520px) {
    .hub-variety__grid--2,
    .hub-variety__grid--3,
    .hub-variety__grid--4 {
      grid-template-columns: 1fr 1fr;
    }
  }
  @container (min-width: 880px) {
    .hub-variety__grid--3 { grid-template-columns: repeat(3, 1fr); }
  }
  @container (min-width: 1200px) {
    .hub-variety__grid--4 { grid-template-columns: repeat(4, 1fr); }
  }
  .hub-variety-card {
    padding: clamp(1.25rem, 2vw, 1.75rem);
    background: rgba(251, 253, 252, 0.7);
    border: 1px solid rgba(74, 90, 87, 0.14);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .hub-variety-card__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, #26997e);
    margin: 0;
  }
  .hub-variety-card__name {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.9vw, 1.55rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink, #171413);
  }
  .hub-variety-card__name a {
    color: inherit;
    text-decoration: none;
  }
  .hub-variety-card__name a:hover { color: var(--accent, #26997e); }
  .hub-variety-card__body {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft, #3A3531);
    margin: 0;
  }
  .hub-variety-card__chips {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hub-variety-card__chip {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent, #26997e);
    text-decoration: none;
    background: rgba(11, 90, 72, 0.07);
    border: 1px solid rgba(11, 90, 72, 0.18);
    border-radius: 999px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .hub-variety-card__chip:hover {
    background: var(--accent, #26997e);
    color: var(--paper, #FAF6EE);
  }
  .hub-variety-card__chip--missing {
    opacity: 0.5;
    text-decoration: line-through;
  }
</style>
