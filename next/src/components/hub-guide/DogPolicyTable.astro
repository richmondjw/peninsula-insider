---
/**
 * DogPolicyTable — designed table for "what's confirmed / what's denied"
 * matrix data inside a hub-guide MDX article. Originally for dog
 * policies but generic enough to work for any boolean-matrix dataset
 * with source attribution (allergy-friendly, walk-in only, etc).
 *
 * Renders as:
 *   - Stacked card list at mobile
 *   - Two-column table-style grid at desktop
 *   - Visual divide between "Confirmed" and "Denied" / "Explicit no"
 *
 * Usage in MDX:
 *
 *   import DogPolicyTable from '../../components/hub-guide/DogPolicyTable.astro';
 *
 *   <DogPolicyTable
 *     confirmed={[
 *       { venue: "stonier-wines", policy: "Lawn is dog-friendly", source: "Venue site" },
 *       …
 *     ]}
 *     denied={[
 *       { venue: "foxeys-hangout", policy: "Please leave your lovely dogs at home", source: "Venue site" },
 *       …
 *     ]}
 *   />
 */
import { getCollection } from 'astro:content';

export interface PolicyEntry {
  /** Slug into venues collection. */
  venue: string;
  /** Policy text — what the rule actually is. */
  policy: string;
  /** Where the verification came from. */
  source?: string;
  /** Optional override label if venue isn't in collection. */
  venueLabel?: string;
  /** Optional venue href override. */
  href?: string;
}
export interface Props {
  confirmed?: PolicyEntry[];
  denied?: PolicyEntry[];
  eyebrow?: string;
  heading?: string;
  /** Title for the confirmed column. Defaults to "Confirmed". */
  confirmedTitle?: string;
  /** Title for the denied column. Defaults to "Explicit no". */
  deniedTitle?: string;
  /** Prefix for venue URLs. Defaults to /wine. */
  hrefPrefix?: string;
}

const {
  confirmed = [],
  denied = [],
  eyebrow = 'Verified policies',
  heading,
  confirmedTitle = 'Confirmed',
  deniedTitle = 'Explicit no',
  hrefPrefix = '/wine',
} = Astro.props;

const allVenues = await getCollection('venues');
const venueBySlug = new Map<string, any>();
for (const v of allVenues) {
  venueBySlug.set(v.data.slug ?? v.id, v);
}

function resolveEntry(e: PolicyEntry) {
  const v = venueBySlug.get(e.venue);
  return {
    ...e,
    label: e.venueLabel ?? v?.data?.name ?? e.venue,
    href: e.href ?? (v ? `${hrefPrefix}/${e.venue}/` : null),
  };
}

const resolvedConfirmed = confirmed.map(resolveEntry);
const resolvedDenied = denied.map(resolveEntry);
---

<section class="hub-policy">
  {(eyebrow || heading) && (
    <header class="hub-policy__head">
      {eyebrow && <p class="hub-policy__eyebrow">{eyebrow}</p>}
      {heading && <h2 class="hub-policy__heading">{heading}</h2>}
    </header>
  )}
  <div class="hub-policy__grid">
    {resolvedConfirmed.length > 0 && (
      <div class="hub-policy__col hub-policy__col--ok">
        <h3 class="hub-policy__col-title">
          <span class="hub-policy__dot" aria-hidden="true"></span>
          {confirmedTitle}
        </h3>
        <ul class="hub-policy__list">
          {resolvedConfirmed.map((e) => (
            <li class="hub-policy__row">
              <div class="hub-policy__row-head">
                {e.href
                  ? <a href={e.href} class="hub-policy__venue">{e.label}</a>
                  : <span class="hub-policy__venue">{e.label}</span>
                }
                {e.source && <span class="hub-policy__source">{e.source}</span>}
              </div>
              <p class="hub-policy__rule">{e.policy}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
    {resolvedDenied.length > 0 && (
      <div class="hub-policy__col hub-policy__col--no">
        <h3 class="hub-policy__col-title">
          <span class="hub-policy__dot hub-policy__dot--no" aria-hidden="true"></span>
          {deniedTitle}
        </h3>
        <ul class="hub-policy__list">
          {resolvedDenied.map((e) => (
            <li class="hub-policy__row">
              <div class="hub-policy__row-head">
                {e.href
                  ? <a href={e.href} class="hub-policy__venue">{e.label}</a>
                  : <span class="hub-policy__venue">{e.label}</span>
                }
                {e.source && <span class="hub-policy__source">{e.source}</span>}
              </div>
              <p class="hub-policy__rule">{e.policy}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .hub-policy {
    margin: clamp(2rem, 4vw, 3rem) 0;
  }
  .hub-policy__head {
    margin: 0 0 clamp(1.25rem, 2vw, 1.75rem);
    max-width: 50rem;
  }
  .hub-policy__eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #A0541F);
    margin: 0 0 0.5rem;
  }
  .hub-policy__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink, #171413);
  }
  .hub-policy__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  @media (min-width: 760px) {
    .hub-policy__grid { grid-template-columns: 1fr 1fr; }
  }
  .hub-policy__col {
    background: rgba(255, 252, 247, 0.7);
    border: 1px solid rgba(121, 92, 58, 0.14);
    border-radius: 6px;
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }
  .hub-policy__col--no {
    background: rgba(121, 92, 58, 0.04);
  }
  .hub-policy__col-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, #A0541F);
    margin: 0 0 1rem;
  }
  .hub-policy__col--no .hub-policy__col-title { color: rgba(121, 92, 58, 0.7); }
  .hub-policy__dot {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent, #A0541F);
  }
  .hub-policy__dot--no {
    background: transparent;
    border: 1.5px solid rgba(121, 92, 58, 0.4);
  }
  .hub-policy__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hub-policy__row {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(121, 92, 58, 0.1);
  }
  .hub-policy__row:last-child { border-bottom: 0; padding-bottom: 0; }
  .hub-policy__row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.3rem;
  }
  .hub-policy__venue {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink, #171413);
    text-decoration: none;
  }
  a.hub-policy__venue:hover {
    color: var(--accent, #A0541F);
    border-bottom: 1px solid currentColor;
  }
  .hub-policy__source {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(121, 92, 58, 0.55);
    flex-shrink: 0;
  }
  .hub-policy__rule {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft, #3A3531);
    margin: 0;
  }
  .hub-policy__col--no .hub-policy__rule { font-style: italic; }
</style>
