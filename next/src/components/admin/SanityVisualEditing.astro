---
/**
 * Sanity Visual Editing overlay.
 *
 * Only mounts when the perspective cookie (set by /api/preview/enable/)
 * is present, meaning we are in a Sanity Presentation draft-mode session.
 * Uses the official @sanity/visual-editing React component (client:only)
 * so the ~25 KB bundle is never downloaded by public visitors.
 */
import {perspectiveCookieName} from '@sanity/preview-url-secret/constants'
import SanityVisualEditingReact from './SanityVisualEditingReact'

const draftMode = Astro.cookies.has(perspectiveCookieName)
---

{draftMode && <SanityVisualEditingReact client:only="react" />}
