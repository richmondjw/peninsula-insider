---
/** Load editing tools only after authentication; ordinary readers need no editor bundle. */
---
<script>
  import { getSupabase } from '../../lib/auth';

  let editor: Promise<typeof import('../../lib/inline-edit/client')> | undefined;
  async function refreshEditor() {
    const supabase = getSupabase();
    if (!supabase) return;
    const { data: { session } } = await supabase.auth.getSession();
    if (!session && !editor) return;
    editor ??= import('../../lib/inline-edit/client');
    await (await editor).bootInlineEditor();
  }

  // Defer session reads outside Supabase's auth callback lock. A sign-in on
  // the current page must activate editing without requiring a reload.
  getSupabase()?.auth.onAuthStateChange(() => {
    setTimeout(() => void refreshEditor(), 0);
  });
  document.addEventListener('astro:page-load', () => void refreshEditor());
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => void refreshEditor(), { once: true });
  } else {
    void refreshEditor();
  }
</script>
