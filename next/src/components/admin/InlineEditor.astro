---
/**
 * Inline editor - global mount.
 *
 * Drops a small client-side bundle on every page that:
 *   - Detects a signed-in admin session (via Supabase)
 *   - Renders a floating "Edit mode" toggle when authenticated
 *   - When edit mode is on, lets the admin click-to-edit text and
 *     right-click-to-replace images marked with `data-pi-edit`
 *
 * For non-authenticated visitors the bundle is essentially inert - it boots,
 * sees no session, returns. No visual chrome, no behaviour change.
 */
---

<script>
  import { bootInlineEditor } from '../../lib/inline-edit/client';

  // Initial boot - fires on cold page loads.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => void bootInlineEditor());
  } else {
    void bootInlineEditor();
  }

  // Re-boot after every Astro <ClientRouter /> navigation. Soft transitions
  // swap <body> and any DOM we appended (the floating toggle) gets wiped, so
  // we need to re-mount it. `bootInlineEditor()` is idempotent.
  document.addEventListener('astro:page-load', () => {
    void bootInlineEditor();
  });
</script>
