---
/**
 * PillarNav, magazine table-of-contents on the homepage.
 *
 * Replaces the 3x3 icon-tile grid (which read as oversized, empty,
 * and visually monotonous on a wide screen). Now: a single column,
 * numbered, each row showing the section name in Cormorant + a
 * one-line editorial dek. Reads like the contents page of a real
 * magazine. Compact, scannable, and unambiguous.
 *
 * Items + deks are sourced from `pillarNav` in lib/nav.ts so the
 * homepage and the rest of the site stay in sync.
 */
import { pillarNav } from '../lib/nav';
---

<nav class="pillars" aria-label="Sections">
  <div class="container">
    <div class="pillars__head">
      <span class="pillars__eyebrow">In this issue</span>
      <h2 class="pillars__title">Sections</h2>
    </div>
    <ol class="pillars__list">
      {pillarNav.map((p, i) => (
        <li class="pillar-row">
          <a href={p.href} class="pillar-row__link" aria-label={`${p.label}, ${p.dek ?? ''}`}>
            <span class="pillar-row__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="pillar-row__name" set:html={p.label.replace('&', '&amp;')} />
            {p.dek && <span class="pillar-row__dek">{p.dek}</span>}
            <span class="pillar-row__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>
