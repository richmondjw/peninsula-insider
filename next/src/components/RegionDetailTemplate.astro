---
/**
 * RegionDetailTemplate: the /explore/regions/[slug] page body.
 *
 * Regions are the second tier of the geographic hierarchy (above places,
 * below the Peninsula). Surfaces editorial intro, the region's places, a
 * tab-filtered venue + experience grid, journal picks, adjacent regions,
 * and TouristDestination JSON-LD.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PlaceCard from './PlaceCard.astro';
import VenueCard from './VenueCard.astro';
import ExperienceCard from './ExperienceCard.astro';
import ArticleCard from './ArticleCard.astro';
import NewsletterBlock from './NewsletterBlock.astro';
import { venueHrefPrefix, routeSlug } from '../lib/editorial';
import { editableImage } from '../lib/inline-edit/attrs';
import { resolveHero } from '../lib/inline-edit/resolve-hero';

interface Props {
  region: CollectionEntry<'regions'>;
  places: any[];
  venues: any[];
  experiences: any[];
  articles: any[];
  adjacentRegionData: any[];
}
const { region, places, venues, experiences, articles, adjacentRegionData } = Astro.props;
const d = region.data;
const SITE = 'https://peninsulainsider.com.au';
const url = `${SITE}/explore/regions/${d.slug}/`;
const hero = await resolveHero('region', d.slug, d);
const regionHeroSrc = hero.src;
const regionHeroStyle = `background-image:linear-gradient(rgba(0,40,34,0.42) 0%,rgba(0,40,34,0.32) 40%,rgba(0,54,44,0.78) 100%),url('${regionHeroSrc}')`;
const heroAbs = regionHeroSrc.startsWith('http') ? regionHeroSrc : `${SITE}${regionHeroSrc}`;

const pillarOf = (type: string) => venueHrefPrefix(type).replace(/\//g, '');

const touristDestination = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: d.name,
  description: d.tagline ?? (d.intro.split('. ')[0] + '.'),
  url,
  image: heroAbs,
  ...(d.coordinates
    ? { geo: { '@type': 'GeoCoordinates', latitude: String(d.coordinates.lat), longitude: String(d.coordinates.lng) } }
    : {}),
  containsPlace: places.map((p) => ({
    '@type': 'Place',
    name: p.data.name,
    url: `${SITE}/explore/places/${routeSlug(p)}/`,
  })),
  touristType: ['Couples', 'Families', 'Food and wine lovers', 'Weekend travellers'],
  isLocatedIn: {
    '@type': 'AdministrativeArea',
    name: 'Mornington Peninsula',
    addressRegion: 'VIC',
    addressCountry: 'AU',
  },
};
---

<BaseLayout
  title={`${d.name} · Peninsula Insider`}
  description={d.tagline ?? d.intro.slice(0, 155)}
  section="explore"
  canonical={url}
  ogImage={regionHeroSrc}
  searchImage={regionHeroSrc}
>
  <script type="application/ld+json" set:html={JSON.stringify(touristDestination)} />
  <meta data-pagefind-filter="region_slug" content={d.slug} />
  <meta data-pagefind-filter="entity_type" content="region" />

  <section
    class="region-hero"
    style={regionHeroStyle}
    {...editableImage({
      entityType: 'region',
      entitySlug: d.slug,
      fieldPath: 'heroImage',
      label: `${d.name} hero`,
      purpose: 'hero',
    })}
  >
    <div class="container">
      <p class="region-hero__eyebrow">Explore · Regions</p>
      <h1 class="region-hero__title">{d.name}</h1>
      {d.tagline && <p class="region-hero__tagline">{d.tagline}</p>}
    </div>
  </section>

  <div class="container">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Explore', href: '/explore/' },
        { label: 'Regions', href: '/explore/regions/' },
        { label: d.name },
      ]}
    />

    <section class="region-intro prose">
      <p>{d.intro}</p>
    </section>

    {places.length > 0 && (
      <section class="region-places">
        <h2 class="region-section__title">Places in {d.name}</h2>
        <div class="region-places__rail">
          {places.map((p) => <PlaceCard place={p} />)}
        </div>
      </section>
    )}

    {(venues.length > 0 || experiences.length > 0) && (
      <section class="region-venues">
        <h2 class="region-section__title">Where to eat, drink, stay and explore</h2>
        <div class="region-tabs" role="tablist">
          <button data-tab="all" class="region-tab is-active" type="button">All</button>
          <button data-tab="eat" class="region-tab" type="button">Eat &amp; Drink</button>
          <button data-tab="stay" class="region-tab" type="button">Stay</button>
          <button data-tab="wine" class="region-tab" type="button">Wine</button>
          {experiences.length > 0 && <button data-tab="experiences" class="region-tab" type="button">Experiences</button>}
        </div>
        <div class="venues__grid" id="regionGrid">
          {venues.map((v) => (
            <div class="region-grid__item" data-pillar={pillarOf(v.data.type)}>
              <VenueCard venue={v} hrefPrefix={venueHrefPrefix(v.data.type)} />
            </div>
          ))}
          {experiences.map((e) => (
            <div class="region-grid__item" data-pillar="experiences">
              <ExperienceCard experience={e} />
            </div>
          ))}
        </div>
      </section>
    )}

    {articles.length > 0 && (
      <section class="region-journal">
        <h2 class="region-section__title">From the Journal</h2>
        <div class="venues__grid">
          {articles.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
    )}

    {adjacentRegionData.length > 0 && (
      <section class="region-adjacent">
        <h2 class="region-section__title">Nearby regions</h2>
        <div class="region-adjacent__grid">
          {adjacentRegionData.map((r) => (
            <a class="region-adjacent__card" href={`/explore/regions/${r.data.slug}/`}>
              <span class="region-adjacent__name">{r.data.name}</span>
              {r.data.tagline && <span class="region-adjacent__tagline">{r.data.tagline}</span>}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <NewsletterBlock />

  <script is:inline>
    (function () {
      function initRegionTabs() {
        var tabs = document.querySelectorAll('.region-tab');
        var items = document.querySelectorAll('#regionGrid .region-grid__item');
        if (!tabs.length) return;
        tabs.forEach(function (btn) {
          if (btn._bound) return;
          btn._bound = true;
          btn.addEventListener('click', function () {
            var tab = btn.getAttribute('data-tab');
            items.forEach(function (card) {
              card.hidden = tab !== 'all' && card.getAttribute('data-pillar') !== tab;
            });
            tabs.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          });
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initRegionTabs, { once: true });
      else initRegionTabs();
      document.addEventListener('astro:page-load', initRegionTabs);
    })();
  </script>

  <style>
    .region-hero { background-size: cover; background-position: center; color: var(--white); padding: clamp(64px, 12vw, 160px) 0 clamp(40px, 7vw, 90px); }
    .region-hero__eyebrow { font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-eyebrow); font-size: var(--fs-100); font-weight: 600; margin: 0 0 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5); color: var(--mint); }
    .region-hero__title { font-family: var(--font-display); font-weight: 600; font-size: clamp(36px, 6vw, 72px); line-height: var(--lh-display); letter-spacing: var(--ls-display); margin: 0; text-shadow: 0 2px 12px rgba(0,0,0,0.45), 0 1px 3px rgba(0,0,0,0.3); color: var(--white); }
    .region-hero__tagline { font-family: var(--font-ui); font-style: normal; font-size: clamp(17px, 2.4vw, 24px); line-height: var(--lh-dek); max-width: 60ch; margin: 14px 0 0; text-shadow: 0 1px 6px rgba(0,0,0,0.5), 0 1px 2px rgba(0,0,0,0.3); color: rgba(255,255,255,0.92); }
    .region-intro { margin: 36px 0; max-width: var(--measure-prose); font-size: var(--fs-400); line-height: var(--lh-body); }
    .region-section__title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-700); line-height: var(--lh-heading); letter-spacing: var(--ls-display); margin: 40px 0 18px; }
    .region-places { position: relative; }
    .region-places::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 8px;
      width: 54px;
      height: calc(100% - 66px);
      pointer-events: none;
      background: linear-gradient(90deg, rgba(255,255,255,0), var(--bg, #fff));
    }
    .region-places__rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(260px, 1fr);
      gap: 20px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      padding-bottom: 8px;
    }
    .region-places__rail::-webkit-scrollbar { display: none; }
    .region-places__rail > * { scroll-snap-align: start; }
    @media (max-width: 760px) {
      .region-places__rail { grid-auto-columns: minmax(220px, 80%); }
      .region-places__rail .place-card__image { aspect-ratio: 4 / 3; }
    }
    :global(.region-venues .venue-card),
    :global(.region-venues .experience-card),
    :global(.region-journal .venue-card--editorial) {
      height: 100%;
      border: 0;
      border-radius: 0;
      overflow: visible;
      background: transparent;
      box-shadow: none;
    }
    :global(.region-venues .venue-card::before),
    :global(.region-journal .venue-card--editorial::before),
    :global(.region-venues .venue-card__wash),
    :global(.region-journal .venue-card__wash) {
      display: none;
    }
    :global(.region-venues .venue-card:hover),
    :global(.region-venues .experience-card:hover),
    :global(.region-journal .venue-card--editorial:hover) {
      transform: none;
      box-shadow: none;
      border-color: transparent;
    }
    :global(.region-venues .venue-card__hero),
    :global(.region-venues .experience-card__visual) {
      aspect-ratio: 4 / 3;
      border-radius: var(--tile-image-radius, 10px);
      border: 0;
      overflow: hidden;
    }
    :global(.region-venues .venue-card__hero) {
      margin-bottom: 0;
    }
    :global(.region-venues .venue-card > .venue-card__top),
    :global(.region-venues .venue-card > .venue-card__name),
    :global(.region-venues .venue-card > .venue-card__place),
    :global(.region-venues .venue-card > .venue-card__hats),
    :global(.region-venues .venue-card > .venue-card__signature),
    :global(.region-venues .venue-card > .venue-card__tags),
    :global(.region-venues .venue-card > .venue-card__actions),
    :global(.region-journal .venue-card--editorial > .venue-card__top),
    :global(.region-journal .venue-card--editorial > .venue-card__name),
    :global(.region-journal .venue-card--editorial > .venue-card__place),
    :global(.region-journal .venue-card--editorial > .venue-card__signature) {
      padding-left: 0;
      padding-right: 0;
    }
    :global(.region-venues .venue-card > .venue-card__top),
    :global(.region-venues .experience-card__body) {
      padding: 1.25rem 0 3.25rem;
      min-height: 0;
    }
    :global(.region-journal .venue-card--editorial) {
      padding: 1.35rem 0 3.25rem;
    }
    :global(.region-venues .venue-card__top),
    :global(.region-venues .experience-card__meta),
    :global(.region-journal .venue-card__top) {
      align-items: baseline;
      min-height: 1rem;
      margin-bottom: 0.72rem;
      font-size: 0.64rem;
      line-height: 1.35;
    }
    :global(.region-venues .venue-card__type),
    :global(.region-venues .venue-card__place-link),
    :global(.region-venues .experience-card__meta),
    :global(.region-journal .venue-card__type) {
      color: var(--accent);
    }
    :global(.region-venues .venue-card__name),
    :global(.region-venues .experience-card__title),
    :global(.region-journal .venue-card__name) {
      font-size: clamp(1.34rem, 1.65vw, 1.55rem);
      line-height: 1.08;
      margin-bottom: 0.62rem;
      letter-spacing: 0;
    }
    :global(.region-venues .venue-card__place) {
      margin-bottom: 0.7rem;
    }
    :global(.region-venues .venue-card__signature),
    :global(.region-venues .experience-card__summary),
    :global(.region-journal .venue-card__signature) {
      border-top: 0;
      padding-top: 0;
      color: var(--soft);
      font-size: 0.9rem;
      line-height: 1.62;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    :global(.region-venues .venue-card__tags) {
      margin-top: 0.2rem;
    }
    :global(.region-venues .venue-card__actions) {
      margin-top: 1rem;
    }
    :global(.region-venues .experience-card__cta) { margin-top: 18px; }
    .region-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
    .region-tab { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-ui); font-weight: 500; font-size: var(--fs-200); padding: 7px 16px; border: 1.5px solid var(--border); border-radius: var(--radius-pill); background: transparent; color: var(--text); cursor: pointer; transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast); }
    .region-tab.is-active, .region-tab:hover { background: var(--accent); border-color: var(--accent); color: var(--white); }
    .region-grid__item[hidden] { display: none; }
    .region-adjacent__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 44px; }
    .region-adjacent__card { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border: 1px solid var(--border); border-radius: var(--radius-m); background: var(--white); text-decoration: none; color: var(--text); transition: border-color var(--dur-med), box-shadow var(--dur-med); }
    .region-adjacent__card:hover { border-color: var(--accent); box-shadow: var(--elev-1); }
    .region-adjacent__name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-600); line-height: var(--lh-heading); letter-spacing: var(--ls-display); }
    .region-adjacent__tagline { font-size: var(--fs-200); color: var(--soft); }
  </style>
</BaseLayout>
