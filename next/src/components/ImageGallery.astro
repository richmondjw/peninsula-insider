---
/**
 * A grid of licensed photographs for a detail page, each with its caption,
 * its credit and, where the image does not show the subject, the provenance
 * disclosure.
 *
 * Only images whose rights are recorded and whose provenance a person has
 * verified are shown: a gallery is a positive claim about each photograph, so
 * an unrecorded one stays in the content record and off the page. The credit
 * sits beside every photograph because the Visit Victoria licence asks for the
 * creator and the supplier to be credited adjacent to the image
 * (ops/records/visit-victoria/README.md).
 *
 * Renders nothing when no image qualifies, so a host can include it
 * unconditionally inside its own section.
 */
import { altFor } from '../lib/media-provenance';
import { formatHeroCredit } from '../lib/editorial';
import MediaProvenanceNote from './MediaProvenanceNote.astro';

export interface Props {
  images?: Array<Record<string, any>> | null;
  /** The entity the photographs illustrate, used as the alt fallback. */
  subject: string;
}

const { images, subject } = Astro.props;
const shown = (images ?? []).filter(
  (image) => image?.src && image.rightsStatus === 'recorded' && image.provenanceReview === 'verified',
);
---
{shown.length > 0 && (
  <div class="image-gallery">
    {shown.map((image) => {
      const { alt, presentation } = altFor(image, subject);
      const credit = formatHeroCredit(image.credit);
      return (
        <figure class="image-gallery__item">
          <img src={image.src} alt={alt} role={presentation ? 'presentation' : undefined} loading="lazy" decoding="async" />
          {(image.caption || credit) && (
            <figcaption>
              {image.caption && <span class="image-gallery__caption">{image.caption}</span>}
              {credit && <span class="image-gallery__credit">{credit}</span>}
            </figcaption>
          )}
          <MediaProvenanceNote image={image} subject={subject} />
        </figure>
      );
    })}
  </div>
)}

<style>
  .image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }
  .image-gallery__item { margin: 0; }
  .image-gallery__item img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-m, 0);
  }
  .image-gallery figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .25rem .75rem;
    margin-top: .5rem;
    font-size: .875rem;
    line-height: 1.5;
  }
  .image-gallery__credit {
    font-family: var(--font-ui, inherit);
    font-size: .75rem;
    letter-spacing: .02em;
    color: var(--soft, currentColor);
  }
</style>
