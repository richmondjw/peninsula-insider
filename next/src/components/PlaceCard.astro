---
/**
 * PlaceCard  -  card used on the homepage and in place hubs.
 * Accepts an Astro content-collection `places` entry.
 */

export interface Props {
  place: any;
  variant?: 'vineyard' | 'bay' | 'sand';
  showDetails?: boolean;
  showMeta?: boolean;
  showActions?: boolean;
  introMaxLength?: number;
}

import { heroBackgroundStyle } from '../lib/editorial';
import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';

const { place, variant = 'vineyard', showDetails = true, showMeta = true, showActions = true, introMaxLength } = Astro.props;
const data = place.data;
const slug = place.id ?? data.slug;

const zoneLabel = String(data.zone ?? '')
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const imgClass = variant === 'bay'
  ? 'place-card__image place-card__image--bay'
  : variant === 'sand'
  ? 'place-card__image place-card__image--sand'
  : 'place-card__image';

const imgStyle = heroBackgroundStyle(data);

const intro = String(data.intro ?? '');
const displayIntro = introMaxLength && intro.length > introMaxLength
  ? `${intro.slice(0, introMaxLength).replace(/\s+\S*$/, '')}…`
  : intro;

// Capture the inline background-image URL for the saved-view preview.
const heroMatch = imgStyle.match(/url\(([^)]+)\)/);
const heroSrc = heroMatch ? heroMatch[1].replace(/^['"]|['"]$/g, '') : undefined;
---

<article class="place-card">
  <a
    href={`/places/${slug}`}
    class={imgClass}
    aria-hidden="true"
    tabindex="-1"
    style={imgStyle}
    {...editableImage({
      entityType: 'place',
      entitySlug: slug,
      fieldPath: 'heroImage',
      label: `${data.name} hero`,
      purpose: 'hero',
    })}
  ></a>
  <div class="place-card__body">
    {showDetails && showMeta && (<p class="place-card__zone">{zoneLabel} · {data.kind}</p>)}
    <h3 class="place-card__name">
      <a href={`/places/${slug}`}>{data.name}</a>
    </h3>
    {showDetails && (<p class="place-card__intro">{displayIntro}</p>)}
  </div>
  {showDetails && showActions && (<PiSaveActions
    kind="place"
    slug={slug}
    title={data.name}
    href={`/places/${slug}/`}
    dek={data.intro}
    imageUrl={heroSrc}
  />)}
</article>
