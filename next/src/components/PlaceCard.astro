---
/**
 * PlaceCard  -  card used on the homepage and in place hubs.
 * Accepts an Astro content-collection `places` entry.
 */

export interface Props {
  place: any;
  variant?: 'vineyard' | 'bay' | 'sand';
  showDetails?: boolean;
  showMeta?: boolean;
  showActions?: boolean;
  introMaxLength?: number;
  /** Use an editorial text card when the linked place has no rights-verified image. */
  mediaMode?: 'default' | 'text';
  /** Short contextual description supplied by the linking place. */
  summary?: string;
}

import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';
import { resolveHero } from '../lib/inline-edit/resolve-hero';

const { place, variant = 'vineyard', showDetails = true, showMeta = true, showActions = true, introMaxLength, mediaMode = 'default', summary } = Astro.props;
const data = place.data;
const slug = place.id ?? data.slug;

const zoneLabel = String(data.zone ?? '')
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const imgClass = variant === 'bay'
  ? 'place-card__image place-card__image--bay'
  : variant === 'sand'
  ? 'place-card__image place-card__image--sand'
  : 'place-card__image';

// The resolver applies the published CMS override during the static build,
// keeping cards aligned with the canonical detail-page hero.
const textOnly = mediaMode === 'text';
const hero = textOnly ? null : await resolveHero('place', slug, data, 'heroImage',
  slug === 'fingal' ? { requireOverrideMetadata: true } : {});

const intro = String(data.intro ?? '');
const displayIntro = summary ?? (introMaxLength && intro.length > introMaxLength
  ? `${intro.slice(0, introMaxLength).replace(/\s+\S*$/, '')}…`
  : intro);

---

<article class:list={['place-card', { 'place-card--text': textOnly }]}>
  {!textOnly && hero && <a
    href={`/explore/places/${slug}/`}
    class={imgClass}
    aria-hidden="true"
    tabindex="-1"
    {...editableImage({
      entityType: 'place',
      entitySlug: slug,
      fieldPath: 'heroImage',
      label: `${data.name} hero`,
      purpose: 'hero',
    })}
    data-pi-requires-image-metadata={slug === 'fingal' ? 'true' : undefined}
    data-pi-no-hydrate={slug === 'fingal' ? 'true' : undefined}
  ><img src={hero.src} alt="" loading="lazy" decoding="async" /></a>}
  <div class="place-card__body">
    {showDetails && showMeta && (<p class="place-card__zone">{zoneLabel} · {data.kind}</p>)}
    <h3 class="place-card__name">
      <a href={`/explore/places/${slug}/`}>{data.name}</a>
    </h3>
    {showDetails && (<p class="place-card__intro">{displayIntro}</p>)}
  </div>
  {showDetails && showActions && (<PiSaveActions
    kind="place"
    slug={slug}
    title={data.name}
    href={`/explore/places/${slug}/`}
    dek={data.intro}
    imageUrl={hero?.src}
  />)}
</article>
