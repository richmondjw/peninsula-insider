    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--teal-text);
    margin: 0 0 1rem;
  }
  .worth-knowing__grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.55rem 1.2rem;
    margin: 0;
  }
  .worth-knowing__grid dt {
    font-size: var(--fs-200);
    font-weight: 600;
    color: var(--soft);
    white-space: nowrap;
    padding-top: 0.05rem;
  }
  .worth-knowing__grid dd {
    font-size: var(--fs-300);
    color: var(--text);
    margin: 0;
    line-height: var(--lh-body);
  }
  @media (max-width: 480px) {
    .worth-knowing__grid {
