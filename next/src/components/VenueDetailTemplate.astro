  .venue-seasonal__title {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    font-weight: 600;
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    margin: 0.4rem 0 1.5rem;
    color: var(--text);
