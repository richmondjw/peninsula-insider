---
import { placeLabel, typeLabel, routeSlug, titleize, venueHrefPrefix, heroBackgroundStyle, formatHeroCredit } from '../lib/editorial';
import { resolveLiveStatusUrl, verifiedFreshnessLabel } from '../lib/venues';
import Breadcrumbs from './Breadcrumbs.astro';
import NewsletterBlock from './NewsletterBlock.astro';
import VenueCard from './VenueCard.astro';
import ArticleCard from './ArticleCard.astro';
import ItineraryCard from './ItineraryCard.astro';
import PiArticleActions from './PiArticleActions.astro';
import { getCollection } from 'astro:content';
import { loadOverrides } from '../lib/inline-edit/overrides';
import { editableImage, editableText } from '../lib/inline-edit/attrs';
import EstateCluster from './EstateCluster.astro';

export interface Props {
  venue: any;
  section: 'eat' | 'stay' | 'wine';
  related?: any[];
  articles?: any[];
  itineraries?: any[];
}

const { venue, section, related = [], articles = [], itineraries = [] } = Astro.props;
const data = venue.data;
const liveStatusUrl = resolveLiveStatusUrl(data);
const verifiedLabel = verifiedFreshnessLabel(data.lastVerified);

// New planning/recommendation layer
// Worth Knowing panel renders if worthKnowing object has any values, OR if bestFor tags are present
const hasWorthKnowing = (data.bestFor && data.bestFor.length > 0) ||
  (data.worthKnowing && Object.values(data.worthKnowing).some(Boolean));
const hasSeasonalNotes = data.seasonalNotes && Object.values(data.seasonalNotes).some(Boolean);
const seasonalNoteEntries: [string, string][] = data.seasonalNotes
  ? (Object.entries(data.seasonalNotes) as [string, string][]).filter(([, v]) => v)
  : [];
// Ask PI query: pre-built prompt connecting this venue to broader planning
const askPiQuery = encodeURIComponent(`What else is worth doing near ${data.name} on the Mornington Peninsula?`);
const sectionLabel = section === 'stay' ? 'Stay' : section === 'wine' ? 'Wine Country' : 'Eat & Drink';
const sectionHref = `/${section}`;
const hats = data.authority?.hats ?? 0;
const awards = data.authority?.awards ?? [];
const pressMentions = data.authority?.pressMentions ?? [];
const heroLabel = `${data.name} · ${placeLabel(data.place)}`;

// Per-venue CMS override consult. If an editor has uploaded a venue-specific
// hero via the inline editor, it wins over the content-JSON default.
const venueSlug = venue.id ?? data.slug;
const venueOverrides = await loadOverrides('venue', venueSlug);
const overrideHero = venueOverrides.image['hero'];
const heroStyle = overrideHero?.src
  ? `background-image: url('${overrideHero.src.replace(/["\\]/g, (m: string) => `\\${m}`)}'); background-size: cover; background-position: center;`
  : heroBackgroundStyle(data);
const heroAlt = overrideHero?.alt ?? data.heroImage?.alt ?? heroLabel;

// Sibling venues within a multi-venue estate (EstateCluster block).
const estateSlug = data.estateSlug as string | undefined;
let estateVenues: any[] = [];
if (estateSlug) {
  const allEstateVenues = await getCollection('venues');
  estateVenues = allEstateVenues.filter((v) => v.data.estateSlug === estateSlug);
}

const placeId = data.place?.id ?? data.place;
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: sectionLabel, href: sectionHref },
  { label: placeLabel(data.place), href: `/explore/places/${placeId}/` },
  { label: data.name },
];

const moodTags = data.tags?.mood ?? [];
const seasonTags = data.tags?.season ?? [];
const audienceTags = data.tags?.audience ?? [];
const allTags = [...moodTags, ...seasonTags, ...audienceTags];

const isWinery = section === 'wine';
const hasFaq = isWinery && data.faq?.length > 0;
const hasVisiting = isWinery && data.visiting;
const hasWines = isWinery && data.wines;
const hasRestaurant = isWinery && data.restaurant;
const hasAccommodation = isWinery && data.accommodation;
const isClosed = data.status === 'closed' || data.status === 'permanently_closed';

// Wine-specific derived signals
const isAppointmentOnly = isWinery && data.visiting?.bookingRequired === true;
const hallidayScore = data.authority?.hallidayScore as number | undefined;
const hallidayDescriptor = hallidayScore
  ? hallidayScore >= 99 ? 'Perfect'
  : hallidayScore >= 97 ? 'Exceptional'
  : hallidayScore >= 95 ? 'Outstanding'
  : hallidayScore >= 93 ? 'Highly Recommended'
  : hallidayScore >= 90 ? 'Recommended'
  : null
  : null;
const subregionLabel = isWinery && data.subregion
  ? String(data.subregion).split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')
  : null;
const wineKeyVarieties: string[] = isWinery ? (data.wines?.keyVarieties ?? []) : [];
const wineTopLabel: string | null = isWinery ? (data.wines?.topLabel ?? null) : null;
const winemakerName: string | null = isWinery ? (data.wines?.winemaker ?? null) : null;
// Best season signal for wine pages (from season tags)
const wineBestSeason: string | null = isWinery && seasonTags.length > 0 && !seasonTags.includes('all-year')
  ? seasonTags.map((s: string) => s.charAt(0).toUpperCase() + s.slice(1)).join(' and ')
  : null;
---

<Breadcrumbs items={breadcrumbItems} />

<section class="venue-detail">
  <div class="container">
    <div class="venue-detail__meta">
      <a href={sectionHref} class="venue-detail__type">{sectionLabel}</a>
      <span class="venue-detail__dot" aria-hidden="true"></span>
      <span class="venue-detail__price">{typeLabel[data.type] ?? data.type}</span>
      <span class="venue-detail__dot" aria-hidden="true"></span>
      <a href={`/explore/places/${data.place?.id ?? data.place}`} class="venue-detail__place">{placeLabel(data.place)}</a>
      {subregionLabel && (
        <><span class="venue-detail__dot" aria-hidden="true"></span>
        <span class="venue-detail__subregion">{subregionLabel}</span></>
      )}
      <span class="venue-detail__dot" aria-hidden="true"></span>
      <span class="venue-detail__price-band">{data.priceBand}</span>
    </div>

    <h1 class="venue-detail__title" {...editableText({
      entityType: 'venue', entitySlug: venueSlug, fieldPath: 'name',
      label: `${data.name} - name`,
    })}>{data.name}</h1>
    {isClosed && (
      <p class="venue-detail__closed-notice">This cellar door is permanently closed. The page is preserved for historical reference.</p>
    )}
    <p class="venue-detail__signature" {...editableText({
      entityType: 'venue', entitySlug: venueSlug, fieldPath: 'signature',
      label: `${data.name} - signature`,
    })}>{data.signature}</p>

    {/* ── KNOWN FOR - entity-signal line (editorial highlights, not buttons).
        Also emitted as schema.org additionalProperty in the page JSON-LD. ── */}
    {data.knownFor && data.knownFor.length > 0 && (
      <p class="venue-known-for" aria-label="Known for">
        <span class="venue-known-for__label">Known for</span>
        <span class="venue-known-for__items">
          {data.knownFor.map((item: string, i: number) => (
            <>{i > 0 && <span class="venue-known-for__sep" aria-hidden="true"> · </span>}{item}</>
          ))}
        </span>
      </p>
    )}

    {(data.bookingUrl || data.phone) && (
      <div class="venue-detail__booking-bar">
        {data.bookingUrl && (
          <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer" class="venue-detail__book-btn">
            {data.type === 'hotel' || data.type === 'villa' || data.type === 'cottage' || data.type === 'glamping' || data.type === 'farm-stay'
              ? 'Check availability'
              : data.type === 'winery'
                ? 'Book a tasting'
                : data.type === 'spa'
                  ? 'Book a treatment'
                  : 'Reserve a table'}
          </a>
        )}
        {data.phone && (
          <a href={`tel:${data.phone.replace(/\s/g, '')}`} class="venue-detail__phone-btn">
            {data.phone}
          </a>
        )}
      </div>
    )}

    {/* Appointment-only planning signal - wine venues only.
        Positioned before the hero so it's seen before the reader
        commits to the page. Not a warning, a planning note. */}
    {isAppointmentOnly && (
      <div class="venue-appointment-note" role="note">
        <span class="venue-appointment-note__icon" aria-hidden="true"> - </span>
        <span class="venue-appointment-note__text">
          <strong>By appointment.</strong> This producer doesn't take walk-ins.
          {data.phone
            ? <> Call <a href={`tel:${data.phone.replace(/\s/g,'')}`}>{data.phone}</a> to arrange a visit.</>  
            : data.bookingUrl
              ? <> <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer">Book online</a> to arrange a visit.</>
              : ' Contact the winery directly to arrange a visit.'}
        </span>
      </div>
    )}

    <div
      class="venue-detail__hero"
      aria-hidden="true"
      style={heroStyle}
      aria-label={heroAlt}
      {...editableImage({
        entityType: 'venue',
        entitySlug: venueSlug,
        fieldPath: 'heroImage',
        label: `${data.name} hero`,
        purpose: 'hero',
      })}
    >
      <div class="venue-detail__hero-fog"></div>
      <span class="venue-detail__hero-label">{heroLabel}</span>
    </div>
    {data.heroImage?.credit && (
      <p class="venue-detail__hero-credit">{formatHeroCredit(data.heroImage.credit)}</p>
    )}

    <div class="venue-detail__grid">
      <div>
        {/* ── INSIDER VERDICT - the editorial hook, leads the page.
            "Best for" lives once, in Worth Knowing below - not duplicated here. ── */}
        {venue.data.venueTier === 'destination' && data.whyWeGo && (
          <div class="venue-verdict">
            <blockquote class="venue-verdict__why">
              <span class="venue-verdict__label">Why we&rsquo;d go</span>
              <p class="venue-verdict__text">{data.whyWeGo}</p>
            </blockquote>
          </div>
        )}

        {/* ── EDITOR NOTE - context and detail ── */}
        <div class="prose">
          {data.editorNote.split(/\n\n+/).map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>

        {estateSlug && (
          <EstateCluster
            estateSlug={estateSlug}
            estateLabel={data.estateLabel ?? estateSlug}
            currentVenueSlug={venueSlug}
            siblingVenues={estateVenues}
          />
        )}

        {/* ── WORTH KNOWING - quick-scan trust layer ── */}
        {hasWorthKnowing && (
          <div class="worth-knowing">
            <p class="worth-knowing__heading">Worth knowing</p>
            <dl class="worth-knowing__grid">
              {data.bestFor && data.bestFor.length > 0 && (
                <>
                  <dt>Best for</dt>
                  <dd>{data.bestFor.join(' · ')}</dd>
                </>
              )}
              {data.worthKnowing?.bestSeason && (
                <>
                  <dt>Best season</dt>
                  <dd>{data.worthKnowing.bestSeason}</dd>
                </>
              )}
              {data.worthKnowing?.timing && (
                <>
                  <dt>Timing</dt>
                  <dd>{data.worthKnowing.timing}</dd>
                </>
              )}
              {data.worthKnowing?.atmosphere && (
                <>
                  <dt>Atmosphere</dt>
                  <dd>{data.worthKnowing.atmosphere}</dd>
                </>
              )}
              {data.worthKnowing?.worksWellWith && data.worthKnowing.worksWellWith.length > 0 && (
                <>
                  <dt>Works well with</dt>
                  <dd>{data.worthKnowing.worksWellWith.join(' · ')}</dd>
                </>
              )}
              {data.worthKnowing?.goodFor && data.worthKnowing.goodFor.length > 0 && (
                <>
                  <dt>Good for</dt>
                  <dd>{data.worthKnowing.goodFor.join(' · ')}</dd>
                </>
              )}
              {data.worthKnowing?.lessIdealFor && (
                <>
                  <dt>Less ideal for</dt>
                  <dd>{data.worthKnowing.lessIdealFor}</dd>
                </>
              )}
            </dl>
          </div>
        )}

        {/* ── INSIDER ACTIONS strip ── */}
        {(data.ifOnlyOneThing || data.pairWith) && (
          <div class="venue-actions-strip">
            {data.ifOnlyOneThing && (
              <div class="venue-actions-strip__item">
                <p class="venue-actions-strip__label">If you only do one thing</p>
                <p class="venue-actions-strip__value">{data.ifOnlyOneThing}</p>
              </div>
            )}
            {data.pairWith && (
              <div class="venue-actions-strip__item">
                <p class="venue-actions-strip__label">Works well with</p>
                <p class="venue-actions-strip__value">{Array.isArray(data.pairWith) ? data.pairWith.join(' · ') : data.pairWith}</p>
              </div>
            )}
          </div>
        )}

        {allTags.length > 0 && (
          <p class="venue-detail__filed">
            <span class="venue-detail__filed-label">Filed under</span>
            <span class="venue-detail__filed-items">
              {allTags.map((tag: string, i: number) => (
                <>{i > 0 && <span class="venue-detail__filed-sep" aria-hidden="true"> · </span>}{titleize(tag)}</>
              ))}
            </span>
          </p>
        )}

        {/* Wine identity panel - surfaces schema-rich wine signals with
            editorial weight. Winemaker, key varieties, signature label,
            seasonal context. Visible on wine pages only.
            Design principle: structured but understated - no luxury-wine
            clichés, no gold leaf, no overdesigned badges. */}
        {isWinery && (wineKeyVarieties.length > 0 || winemakerName || wineTopLabel || wineBestSeason) && (
          <div class="wine-identity">
            {winemakerName && (
              <div class="wine-identity__row">
                <span class="wine-identity__label">Winemaker</span>
                <span class="wine-identity__value">{winemakerName}</span>
              </div>
            )}
            {wineKeyVarieties.length > 0 && (
              <div class="wine-identity__row">
                <span class="wine-identity__label">Varieties</span>
                <span class="wine-identity__varieties">
                  {wineKeyVarieties.map((v: string) => (
                    <span class="wine-identity__variety">{v}</span>
                  ))}
                </span>
              </div>
            )}
            {wineTopLabel && (
              <div class="wine-identity__row">
                <span class="wine-identity__label">Worth seeking</span>
                <span class="wine-identity__value wine-identity__value--italic">{wineTopLabel}</span>
              </div>
            )}
            {wineBestSeason && (
              <div class="wine-identity__row">
                <span class="wine-identity__label">Best in</span>
                <span class="wine-identity__value">{wineBestSeason}</span>
              </div>
            )}
          </div>
        )}
      </div>

      <aside class="facts">
        <p class="facts__title">At a glance</p>
        <dl>
          <dt>Type</dt>
          <dd>{typeLabel[data.type] ?? data.type}</dd>

          <dt>Location</dt>
          <dd>
            {data.address}
            {data.address && (
              <>
                {' '}·{' '}
                <a
                  href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${data.name}, ${data.address}`)}`}
                  target="_blank"
                  rel="noopener"
                >Directions</a>
              </>
            )}
          </dd>

          <dt>Spend</dt>
          <dd>{data.priceBand}</dd>

          {data.phone && (
            <>
              <dt>Call</dt>
              <dd>{data.phone}</dd>
            </>
          )}

          {hats > 0 && (
            <>
              <dt>Guide</dt>
              <dd>{hats} Good Food Guide hat{hats > 1 ? 's' : ''}</dd>
            </>
          )}

          {hallidayScore && (
            <>
              <dt>Halliday</dt>
              <dd>
                <span class="facts__halliday-score">{hallidayScore}</span>
                {hallidayDescriptor && <span class="facts__halliday-desc">{hallidayDescriptor}</span>}
              </dd>
            </>
          )}

          {awards.length > 0 && (
            <>
              <dt>Awards</dt>
              <dd>{awards.join(' · ')}</dd>
            </>
          )}

          {pressMentions.length > 0 && (
            <>
              <dt>Press</dt>
              <dd>{pressMentions.join(' · ')}</dd>
            </>
          )}

          {data.website && (
            <>
              <dt>Website</dt>
              <dd><a href={data.website}>{data.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd>
            </>
          )}

          {data.hoursNote && (
            <>
              <dt>Hours</dt>
              <dd>{data.hoursNote}</dd>
            </>
          )}

          <>
            <dt>Live status</dt>
            <dd>
              <a href={liveStatusUrl} target="_blank" rel="noopener noreferrer">
                Check current hours →
              </a>
            </dd>
          </>

          {hasWines && data.wines.winemaker && (
            <>
              <dt>Winemaker</dt>
              <dd>{data.wines.winemaker}</dd>
            </>
          )}

          {hasVisiting && data.visiting.tastingFee && (
            <>
              <dt>Tasting fee</dt>
              <dd>{data.visiting.tastingFee}</dd>
            </>
          )}

          {hasVisiting && data.visiting.bookingRequired && (
            <>
              <dt>Booking</dt>
              <dd>Required</dd>
            </>
          )}

          {data.sameAs?.mpva && (
            <>
              <dt>MPVA</dt>
              <dd><a href={data.sameAs.mpva} target="_blank" rel="noopener noreferrer">Region listing</a></dd>
            </>
          )}

          {data.sameAs?.halliday && (
            <>
              <dt>Halliday</dt>
              <dd><a href={data.sameAs.halliday} target="_blank" rel="noopener noreferrer">Halliday listing</a></dd>
            </>
          )}

          {data.featuredPartner && (
            <>
              <dt>Partnership</dt>
              <dd>Featured partner - <a href="/about/">editorial standards</a></dd>
            </>
          )}
        </dl>

        {data.bookingUrl && <a class="facts__cta" href={data.bookingUrl}>Book now</a>}
        {data.affiliateNote && <p class="facts__affiliate-note">{data.affiliateNote}</p>}
      </aside>
    </div>

    {data.editorVerdict && (
      <div class="venue-detail__verdict">
        <p class="label label--accent">Editor's verdict</p>
        <blockquote class="venue-detail__verdict-text">{data.editorVerdict}</blockquote>
      </div>
    )}
  </div>
</section>

{hasVisiting && (
  <section class="venue-detail-section">
    <div class="container">
      <h2 class="venue-detail-section__title">Visiting</h2>
      <div class="prose">
        {data.visiting.tastingNote && <p>{data.visiting.tastingNote}</p>}
        {data.visiting.openingHours?.length > 0 && (
          <ul>
            {data.visiting.openingHours.map((h: any) => (
              <li>{Array.isArray(h.days) ? h.days.join(', ') : h.days}: {h.opens}–{h.closes}</li>
            ))}
          </ul>
        )}
        {data.visiting.bookingRequired && (
          <p><strong>Booking required.</strong>{' '}
            {data.bookingUrl
              ? <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer">Reserve a tasting</a>
              : 'Contact the winery directly.'}
          </p>
        )}
      </div>
    </div>
  </section>
)}

{hasWines && (
  <section class="venue-detail-section">
    <div class="container">
      <h2 class="venue-detail-section__title">The wines</h2>
      <div class="prose">
        {data.wines.signature && <p>{data.wines.signature}</p>}
        {data.wines.keyVarieties?.length > 0 && (
          <p><strong>Key varieties:</strong> {data.wines.keyVarieties.join(', ')}.</p>
        )}
        {data.wines.topLabel && (
          <p><strong>Worth seeking out:</strong> {data.wines.topLabel}.</p>
        )}
      </div>
    </div>
  </section>
)}

{hasRestaurant && (
  <section class="venue-detail-section" id="restaurant">
    <div class="container">
      <h2 class="venue-detail-section__title">{data.restaurant.name ?? 'Restaurant'}</h2>
      <div class="prose">
        {data.restaurant.hats > 0 && (
          <p class="venue-detail__hat-note">{data.restaurant.hats} Good Food Guide hat{data.restaurant.hats > 1 ? 's' : ''}.</p>
        )}
        {data.restaurant.description && <p>{data.restaurant.description}</p>}
        {data.restaurant.cuisine && <p><strong>Cuisine:</strong> {data.restaurant.cuisine}.</p>}
        {data.restaurant.reservations !== false && data.bookingUrl && (
          <p><a href={data.bookingUrl} target="_blank" rel="noopener noreferrer">Reserve a table →</a></p>
        )}
      </div>
    </div>
  </section>
)}

{hasAccommodation && (
  <section class="venue-detail-section" id="accommodation">
    <div class="container">
      <h2 class="venue-detail-section__title">{data.accommodation.name ?? 'Stay'}</h2>
      <div class="prose">
        {data.accommodation.description && <p>{data.accommodation.description}</p>}
        {data.accommodation.units && <p>{data.accommodation.units} accommodation unit{data.accommodation.units > 1 ? 's' : ''}.</p>}
      </div>
    </div>
  </section>
)}

{hasFaq && (
  <section class="faq-section">
    <div class="container">
      <div class="prose">
        <h2>Frequently asked questions</h2>
        {data.faq.map((item: any) => (
          <>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </>
        ))}
      </div>
    </div>
  </section>
)}

{/* ── SEASONAL INTELLIGENCE - optional per-season guidance ── */}
{hasSeasonalNotes && (
  <section class="venue-seasonal">
    <div class="container">
      <p class="label label--accent">Seasonal intelligence</p>
      <h2 class="venue-seasonal__title">When to visit {data.name}</h2>
      <div class="venue-seasonal__grid">
        {seasonalNoteEntries.map(([season, note]) => (
          <div class="venue-seasonal__block">
            <p class="venue-seasonal__season">{season.charAt(0).toUpperCase() + season.slice(1)}</p>
            <p class="venue-seasonal__note">{note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{/* ── ASK PI - light planning integration ── */}
<section class="venue-ask-pi">
  <div class="container">
    <div class="venue-ask-pi__inner">
      <p class="venue-ask-pi__prompt">Not sure how to build a day around {data.name}?</p>
      <a href={`/ask/?q=${askPiQuery}`} class="venue-ask-pi__cta" data-pi-trigger="true">
        Ask The Insider
        <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 10h10M11 5l5 5-5 5" />
        </svg>
      </a>
    </div>
  </div>
</section>

{articles.length > 0 && (
  <section class="venues venues--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">In the journal</p>
          <h2 class="venues__title">Stories that mention {data.name}</h2>
          <p class="venues__sub">These pieces give you the context a listing page never does - the when, the why, and the who-it’s-for.</p>
        </div>
        <a href="/journal/" class="venues__link">Journal →</a>
      </div>
      <div class="venues__grid">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
)}

{itineraries.length > 0 && (
  <section class="escape-callout">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Part of an escape</p>
          <h2 class="venues__title">Weekend plans that already include {data.name}</h2>
          <p class="venues__sub">Skip the planning  -  these itineraries sequence this venue into a proper Peninsula weekend.</p>
        </div>
        <a href="/plans/" class="venues__link">All plans →</a>
      </div>
      <div class="itinerary-grid">
        {itineraries.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
      </div>
    </div>
  </section>
)}

{related.length > 0 && (
  <section class="venues venues--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Nearby picks</p>
