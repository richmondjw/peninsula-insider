---
import { placeLabel, typeLabel, routeSlug, titleize, venueHrefPrefix, heroBackgroundStyle, formatHeroCredit } from '../lib/editorial';
import { resolveLiveStatusUrl, verifiedFreshnessLabel } from '../lib/venues';
import Breadcrumbs from './Breadcrumbs.astro';
import NewsletterBlock from './NewsletterBlock.astro';
import VenueCard from './VenueCard.astro';
import ArticleCard from './ArticleCard.astro';
import ItineraryCard from './ItineraryCard.astro';
import PiArticleActions from './PiArticleActions.astro';
import CorrectionNote from './CorrectionNote.astro';
import { loadOverrides } from '../lib/inline-edit/overrides';
import { editableImage } from '../lib/inline-edit/attrs';

export interface Props {
  venue: any;
  section: 'eat' | 'stay' | 'wine';
  related?: any[];
  articles?: any[];
  itineraries?: any[];
}

const { venue, section, related = [], articles = [], itineraries = [] } = Astro.props;
const data = venue.data;
const liveStatusUrl = resolveLiveStatusUrl(data);
const verifiedLabel = verifiedFreshnessLabel(data.lastVerified);
const sectionLabel = section === 'stay' ? 'Stay' : section === 'wine' ? 'Wine Country' : 'Eat & Drink';
const sectionHref = `/${section}`;
const hats = data.authority?.hats ?? 0;
const awards = data.authority?.awards ?? [];
const pressMentions = data.authority?.pressMentions ?? [];
const heroLabel = `${data.name} · ${placeLabel(data.place)}`;

// Per-venue CMS override consult. If an editor has uploaded a venue-specific
// hero via the inline editor, it wins over the content-JSON default.
const venueSlug = venue.id ?? data.slug;
const venueOverrides = await loadOverrides('venue', venueSlug);
const overrideHero = venueOverrides.image['hero'];
const heroStyle = overrideHero?.src
  ? `background-image: url('${overrideHero.src.replace(/["\\]/g, (m: string) => `\\${m}`)}'); background-size: cover; background-position: center;`
  : heroBackgroundStyle(data);
const heroAlt = overrideHero?.alt ?? data.heroImage?.alt ?? heroLabel;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: sectionLabel, href: sectionHref },
  { label: data.name },
];

const moodTags = data.tags?.mood ?? [];
const seasonTags = data.tags?.season ?? [];
const audienceTags = data.tags?.audience ?? [];
const allTags = [...moodTags, ...seasonTags, ...audienceTags];

const isWinery = section === 'wine';
const hasFaq = isWinery && data.faq?.length > 0;
const hasVisiting = isWinery && data.visiting;
const hasWines = isWinery && data.wines;
const hasRestaurant = isWinery && data.restaurant;
const hasAccommodation = isWinery && data.accommodation;
const isClosed = data.status === 'closed';
---

<Breadcrumbs items={breadcrumbItems} />

<section class="venue-detail">
  <div class="container">
    <div class="venue-detail__meta">
      <a href={sectionHref} class="venue-detail__type">{sectionLabel}</a>
      <span class="venue-detail__dot" aria-hidden="true"></span>
      <span class="venue-detail__price">{typeLabel[data.type] ?? data.type}</span>
      <span class="venue-detail__dot" aria-hidden="true"></span>
      <a href={`/places/${data.place?.id ?? data.place}`} class="venue-detail__place">{placeLabel(data.place)}</a>
      <span class="venue-detail__dot" aria-hidden="true"></span>
      <span class="venue-detail__price-band">{data.priceBand}</span>
    </div>

    <h1 class="venue-detail__title">{data.name}</h1>
    {isClosed && (
      <p class="venue-detail__closed-notice">This cellar door is permanently closed. The page is preserved for historical reference.</p>
    )}
    <p class="venue-detail__signature">{data.signature}</p>

    {(data.bookingUrl || data.phone) && (
      <div class="venue-detail__booking-bar">
        {data.bookingUrl && (
          <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer" class="venue-detail__book-btn">
            {data.type === 'hotel' || data.type === 'villa' || data.type === 'cottage' || data.type === 'glamping' || data.type === 'farm-stay'
              ? 'Check availability'
              : data.type === 'winery'
                ? 'Book a tasting'
                : data.type === 'spa'
                  ? 'Book a treatment'
                  : 'Reserve a table'}
          </a>
        )}
        {data.phone && (
          <a href={`tel:${data.phone.replace(/\s/g, '')}`} class="venue-detail__phone-btn">
            {data.phone}
          </a>
        )}
      </div>
    )}

    <div
      class="venue-detail__hero"
      aria-hidden="true"
      style={heroStyle}
      aria-label={heroAlt}
      {...editableImage({
        entityType: 'venue',
        entitySlug: venueSlug,
        fieldPath: 'hero',
        label: `${data.name} hero`,
        purpose: 'hero',
      })}
    >
      <div class="venue-detail__hero-fog"></div>
      <span class="venue-detail__hero-label">{heroLabel}</span>
    </div>
    {data.heroImage?.credit && (
      <p class="venue-detail__hero-credit">{formatHeroCredit(data.heroImage.credit)}</p>
    )}

    <div class="venue-detail__grid">
      <div>
        {/* ── INSIDER VERDICT — leads the page ── */}
        {(data.whyWeGo || data.bestFor) && (
          <div class="venue-verdict">
            {data.whyWeGo && (
              <blockquote class="venue-verdict__why">
                <span class="venue-verdict__label">Why we&rsquo;d go</span>
                <p class="venue-verdict__text">{data.whyWeGo}</p>
              </blockquote>
            )}
            {data.bestFor && (
              <div class="venue-verdict__best-for">
                <span class="venue-verdict__best-for-label">Best for</span>
                <ul class="venue-verdict__tags" role="list">
                  {(Array.isArray(data.bestFor) ? data.bestFor : [data.bestFor]).map((tag: string) => (
                    <li class="venue-verdict__tag">{tag}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        {/* ── EDITOR NOTE — context and detail ── */}
        <div class="prose">
          {data.editorNote.split(/\n\n+/).map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>

        {/* ── INSIDER ACTIONS strip ── */}
        {(data.ifOnlyOneThing || data.pairWith) && (
          <div class="venue-actions-strip">
            {data.ifOnlyOneThing && (
              <div class="venue-actions-strip__item">
                <p class="venue-actions-strip__label">If you only do one thing</p>
                <p class="venue-actions-strip__value">{data.ifOnlyOneThing}</p>
              </div>
            )}
            {data.pairWith && (
              <div class="venue-actions-strip__item">
                <p class="venue-actions-strip__label">Pair it with</p>
                <p class="venue-actions-strip__value">{Array.isArray(data.pairWith) ? data.pairWith.join(' · ') : data.pairWith}</p>
              </div>
            )}
          </div>
        )}

        {allTags.length > 0 && (
          <div class="venue-detail__tags">
            {allTags.map((tag: string) => (
              <span class="venue-detail__tag">{titleize(tag)}</span>
            ))}
          </div>
        )}

        <CorrectionNote compact={true} />
      </div>

      <aside class="facts">
        <p class="facts__title">At a glance</p>
        <dl>
          <dt>Type</dt>
          <dd>{typeLabel[data.type] ?? data.type}</dd>

          <dt>Location</dt>
          <dd>{data.address}</dd>

          <dt>Spend</dt>
          <dd>{data.priceBand}</dd>

          {data.phone && (
            <>
              <dt>Call</dt>
              <dd>{data.phone}</dd>
            </>
          )}

          {hats > 0 && (
            <>
              <dt>Guide</dt>
              <dd>{hats} Good Food Guide hat{hats > 1 ? 's' : ''}</dd>
            </>
          )}

          {data.authority?.hallidayScore && (
            <>
              <dt>Halliday</dt>
              <dd>{data.authority.hallidayScore} points</dd>
            </>
          )}

          {awards.length > 0 && (
            <>
              <dt>Awards</dt>
              <dd>{awards.join(' · ')}</dd>
            </>
          )}

          {pressMentions.length > 0 && (
            <>
              <dt>Press</dt>
              <dd>{pressMentions.join(' · ')}</dd>
            </>
          )}

          {data.website && (
            <>
              <dt>Website</dt>
              <dd><a href={data.website}>{data.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd>
            </>
          )}

          {data.hoursNote && (
            <>
              <dt>Hours</dt>
              <dd>{data.hoursNote}</dd>
            </>
          )}

          <>
            <dt>Live status</dt>
            <dd>
              <a href={liveStatusUrl} target="_blank" rel="noopener noreferrer">
                Check current hours →
              </a>
            </dd>
          </>

          {hasWines && data.wines.winemaker && (
            <>
              <dt>Winemaker</dt>
              <dd>{data.wines.winemaker}</dd>
            </>
          )}

          {hasVisiting && data.visiting.tastingFee && (
            <>
              <dt>Tasting fee</dt>
              <dd>{data.visiting.tastingFee}</dd>
            </>
          )}

          {hasVisiting && data.visiting.bookingRequired && (
            <>
              <dt>Booking</dt>
              <dd>Required</dd>
            </>
          )}

          {data.sameAs?.mpva && (
            <>
              <dt>MPVA</dt>
              <dd><a href={data.sameAs.mpva} target="_blank" rel="noopener noreferrer">Region listing</a></dd>
            </>
          )}

          {data.sameAs?.halliday && (
            <>
              <dt>Halliday</dt>
              <dd><a href={data.sameAs.halliday} target="_blank" rel="noopener noreferrer">Halliday listing</a></dd>
            </>
          )}

          {data.featuredPartner && (
            <>
              <dt>Partnership</dt>
              <dd>Featured partner — <a href="/about/editorial-standards/">editorial standards</a></dd>
            </>
          )}
        </dl>

        {data.bookingUrl && <a class="facts__cta" href={data.bookingUrl}>Book now</a>}
        {data.affiliateNote && <p class="facts__affiliate-note">{data.affiliateNote}</p>}
      </aside>
    </div>

    {data.editorVerdict && (
      <div class="venue-detail__verdict">
        <p class="label label--accent">Editor's verdict</p>
        <blockquote class="venue-detail__verdict-text">{data.editorVerdict}</blockquote>
      </div>
    )}
  </div>
</section>

{hasVisiting && (
  <section class="venue-detail-section">
    <div class="container">
      <h2 class="venue-detail-section__title">Visiting</h2>
      <div class="prose">
        {data.visiting.tastingNote && <p>{data.visiting.tastingNote}</p>}
        {data.visiting.openingHours?.length > 0 && (
          <ul>
            {data.visiting.openingHours.map((h: any) => (
              <li>{Array.isArray(h.days) ? h.days.join(', ') : h.days}: {h.opens}–{h.closes}</li>
            ))}
          </ul>
        )}
        {data.visiting.bookingRequired && (
          <p><strong>Booking required.</strong>{' '}
            {data.bookingUrl
              ? <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer">Reserve a tasting</a>
              : 'Contact the winery directly.'}
          </p>
        )}
      </div>
    </div>
  </section>
)}

{hasWines && (
  <section class="venue-detail-section">
    <div class="container">
      <h2 class="venue-detail-section__title">The wines</h2>
      <div class="prose">
        {data.wines.signature && <p>{data.wines.signature}</p>}
        {data.wines.keyVarieties?.length > 0 && (
          <p><strong>Key varieties:</strong> {data.wines.keyVarieties.join(', ')}.</p>
        )}
        {data.wines.topLabel && (
          <p><strong>Worth seeking out:</strong> {data.wines.topLabel}.</p>
        )}
      </div>
    </div>
  </section>
)}

{hasRestaurant && (
  <section class="venue-detail-section" id="restaurant">
    <div class="container">
      <h2 class="venue-detail-section__title">{data.restaurant.name ?? 'Restaurant'}</h2>
      <div class="prose">
        {data.restaurant.hats > 0 && (
          <p class="venue-detail__hat-note">{data.restaurant.hats} Good Food Guide hat{data.restaurant.hats > 1 ? 's' : ''}.</p>
        )}
        {data.restaurant.description && <p>{data.restaurant.description}</p>}
        {data.restaurant.cuisine && <p><strong>Cuisine:</strong> {data.restaurant.cuisine}.</p>}
        {data.restaurant.reservations !== false && data.bookingUrl && (
          <p><a href={data.bookingUrl} target="_blank" rel="noopener noreferrer">Reserve a table →</a></p>
        )}
      </div>
    </div>
  </section>
)}

{hasAccommodation && (
  <section class="venue-detail-section" id="accommodation">
    <div class="container">
      <h2 class="venue-detail-section__title">{data.accommodation.name ?? 'Stay'}</h2>
      <div class="prose">
        {data.accommodation.description && <p>{data.accommodation.description}</p>}
        {data.accommodation.units && <p>{data.accommodation.units} accommodation unit{data.accommodation.units > 1 ? 's' : ''}.</p>}
      </div>
    </div>
  </section>
)}

{hasFaq && (
  <section class="faq-section">
    <div class="container">
      <div class="prose">
        <h2>Frequently asked questions</h2>
        {data.faq.map((item: any) => (
          <>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </>
        ))}
      </div>
    </div>
  </section>
)}

{articles.length > 0 && (
  <section class="venues venues--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">In the journal</p>
          <h2 class="venues__title">Stories that mention {data.name}</h2>
          <p class="venues__sub">These pieces give you the context a listing page never does  -  the when, the why, and the who-it's-for.</p>
        </div>
        <a href="/journal/" class="venues__link">Journal →</a>
      </div>
      <div class="venues__grid">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
)}

{itineraries.length > 0 && (
  <section class="escape-callout">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Part of an escape</p>
          <h2 class="venues__title">Weekend plans that already include {data.name}</h2>
          <p class="venues__sub">Skip the planning  -  these itineraries sequence this venue into a proper Peninsula weekend.</p>
        </div>
        <a href="/plans/" class="venues__link">All plans →</a>
      </div>
      <div class="itinerary-grid">
        {itineraries.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
      </div>
    </div>
  </section>
)}

{related.length > 0 && (
  <section class="venues venues--plain">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Nearby picks</p>
          <h2 class="venues__title">More from {placeLabel(data.place)}</h2>
        </div>
        <a href={sectionHref} class="venues__link">Back to {sectionLabel} →</a>
      </div>
      <div class="venues__grid">
        {related.map((item) => <VenueCard venue={item} hrefPrefix={sectionHref} />)}
      </div>
    </div>
  </section>
)}

{/* Contextual guide links — connect venue pages into the editorial mesh */}
<section class="venues venues--plain">
  <div class="container">
    <div class="venues__header">
      <div>
        <p class="label label--accent">Plan around this</p>
        <h2 class="venues__title">Guides that help you use {data.name} properly</h2>
        <p class="venues__sub">Service pieces that put a single venue into the context of a whole weekend.</p>
      </div>
    </div>
    <div class="venues__grid venues__grid--links">
      <a href="/journal/mornington-peninsula-itinerary/" class="venue-card__cta">3-Day Peninsula Itinerary →</a>
      {(section === 'eat') && (
        <>
          <a href="/journal/best-brunch-mornington-peninsula/" class="venue-card__cta">Best Brunch Guide →</a>
          <a href="/journal/mornington-peninsula-winery-tour/" class="venue-card__cta">Winery Tour Route →</a>
        </>
      )}
      {(section === 'wine') && (
        <>
          <a href="/journal/mornington-peninsula-winery-tour/" class="venue-card__cta">Self-Drive Winery Tour →</a>
          <a href="/eat/best-restaurants/" class="venue-card__cta">Best Restaurants →</a>
        </>
      )}
      {(section === 'stay') && (
        <>
          <a href="/journal/mornington-peninsula-in-winter/" class="venue-card__cta">Winter Peninsula Guide →</a>
          <a href="/journal/free-things-to-do-mornington-peninsula/" class="venue-card__cta">Free Things to Do →</a>
        </>
      )}
      <a href="/journal/mornington-peninsula-hot-springs-guide/" class="venue-card__cta">Hot Springs Guide →</a>
    </div>
  </div>
</section>

<PiArticleActions
  kind="venue"
  slug={venue.id ?? data.slug}
  section={section}
  title={data.name}
  href={`/${venueHrefPrefix(data, section)}/${venue.id ?? data.slug}/`}
  dek={data.editorNote}
  imageUrl={data.heroImage?.src}
/>
<NewsletterBlock />

<style>
  /* ── Insider Verdict block ── */
  .venue-verdict {
    margin: 1.5rem 0 2rem;
    padding: 1.75rem 2rem;
    background: var(--ink, #1A1208);
    color: var(--paper, #F5F0E8);
  }

  .venue-verdict__why {
    margin: 0 0 1.25rem;
    padding: 0;
    border: none;
  }

  .venue-verdict__label {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sand, #C9B99A);
    margin-bottom: 0.4rem;
  }

  .venue-verdict__text {
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--paper, #F5F0E8);
    margin: 0;
  }

  .venue-verdict__best-for {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .venue-verdict__best-for-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sand, #C9B99A);
    white-space: nowrap;
  }

  .venue-verdict__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .venue-verdict__tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(255,255,255,0.25);
    color: var(--paper, #F5F0E8);
    letter-spacing: 0.02em;
  }

  /* ── Actions strip (if only / pair with) ── */
  .venue-actions-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--line, #D9D1BE);
    border-bottom: 1px solid var(--line, #D9D1BE);
  }
  .venue-actions-strip__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .venue-actions-strip__label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    margin: 0;
  }
  .venue-actions-strip__value {
    font-size: 0.9rem;
    color: var(--ink, #1A1208);
    margin: 0;
    line-height: 1.45;
  }

  /* legacy strip kept for backward compat */
  .venue-editorial-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--surface-warm, #FAF7F2);
    border-top: 2px solid var(--ink, #1A1208);
    border-bottom: 1px solid var(--line, #D9D1BE);
  }
  .venue-editorial-strip__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .venue-editorial-strip__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted, #6E655C);
    margin: 0;
  }
  .venue-editorial-strip__value {
    font-size: 0.92rem;
    color: var(--ink, #1A1208);
    margin: 0;
    line-height: 1.45;
  }
</style>
