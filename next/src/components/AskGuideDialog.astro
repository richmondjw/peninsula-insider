---
/**
 * Ask PI as a dialog opened from the masthead. The shell (native modal, focus
 * return, scroll lock, teardown around Astro navigation) is the reviewed one
 * from the 20 November 2026 editorial-chat fixture; the conversation inside is
 * AskGuidePanel.
 *
 * Without JavaScript the masthead link is an ordinary link to /ask/.
 */
import AskGuidePanel from './AskGuidePanel.astro';
---
<dialog id="ask-guide-dialog" class="ask-dialog" data-ask-guide-dialog aria-labelledby="ask-guide-title" aria-describedby="ask-dialog-scope">
  <header class="ask-dialog__header">
    <img src="/images/pi/pi-avatar-96.webp" alt="" width="36" height="36" />
    <h2 id="ask-guide-title">Ask PI <span>From our guides</span></h2>
    <button type="button" class="ask-dialog__close" data-ask-guide-close aria-label="Close Ask PI">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12m0-12L6 18"/></svg>
    </button>
  </header>
  <div class="ask-dialog__body">
    <AskGuidePanel id="ask-dialog" />
  </div>
</dialog>

<script>
  import { loadAskIndex } from '../scripts/ask-guide-ui';

  let dispose: (() => void) | undefined;
  let closeForNavigation: (() => void) | undefined;

  function mountAskGuideDialog() {
    if (dispose) return;
    const dialog = document.querySelector<HTMLDialogElement>('[data-ask-guide-dialog]');
    const link = document.querySelector<HTMLAnchorElement>('[data-ask-guide-open]');
    if (!dialog || !link || typeof dialog.showModal !== 'function') return;

    const input = dialog.querySelector<HTMLInputElement>('[data-ask-guide-input]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-ask-guide-close]')!;
    const controller = new AbortController();
    const { signal } = controller;
    const root = document.documentElement;
    let overflow: { value: string; priority: string } | undefined;
    let restoreFocus = false;

    function unlock() {
      if (!overflow) return;
      if (overflow.value) root.style.setProperty('overflow', overflow.value, overflow.priority);
      else root.style.removeProperty('overflow');
      overflow = undefined;
    }

    function finish() {
      if (dialog.open) return;
      unlock();
      if (restoreFocus && link.isConnected && link.getClientRects().length) link.focus({ preventScroll: true });
      restoreFocus = false;
    }

    function dismiss(returnFocus: boolean) {
      restoreFocus = returnFocus && dialog.open;
      if (dialog.open) dialog.close();
      finish();
    }

    link.setAttribute('aria-haspopup', 'dialog');
    link.setAttribute('aria-controls', dialog.id);
    link.addEventListener('click', event => {
      if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      // On /ask/ the conversation is already on the page: go to its question box.
      const onPage = document.querySelector<HTMLInputElement>('main [data-ask-guide-input]');
      if (onPage) {
        event.preventDefault();
        onPage.focus();
        return;
      }
      const otherModals = document.querySelectorAll<HTMLElement>('dialog[open], [role="dialog"][aria-modal="true"]');
      if ([...otherModals].some(node => !node.closest('[hidden], [inert], [aria-hidden="true"]')
          && node.getClientRects().length && getComputedStyle(node).visibility === 'visible')) return;
      try { dialog.showModal(); } catch { return; }
      event.preventDefault();
      overflow = { value: root.style.getPropertyValue('overflow'), priority: root.style.getPropertyPriority('overflow') };
      root.style.setProperty('overflow', 'hidden');
      void loadAskIndex().catch(() => {});
      // A touch keyboard would cover the examples: focus the close button instead.
      if (event instanceof PointerEvent && event.pointerType === 'touch') close.focus({ preventScroll: true });
      else input.focus({ preventScroll: true });
    }, { signal });

    close.addEventListener('click', () => dismiss(true), { signal });
    dialog.addEventListener('cancel', event => {
      event.preventDefault();
      dismiss(true);
    }, { signal });
    dialog.addEventListener('close', finish, { signal });
    dialog.addEventListener('keydown', event => {
      // The site's own "/" shortcut must not install a second focus trap
      // under this native modal. Do not interfere with typing in the composer.
      if (dialog.open && event.key === '/' && event.target !== input
          && !event.altKey && !event.ctrlKey && !event.metaKey) event.stopPropagation();
    }, { signal });

    closeForNavigation = () => dismiss(false);
    dispose = () => {
      dismiss(false);
      controller.abort();
      dispose = undefined;
      closeForNavigation = undefined;
    };
  }

  mountAskGuideDialog();
  document.addEventListener('astro:page-load', mountAskGuideDialog);
  document.addEventListener('astro:before-preparation', () => closeForNavigation?.());
  document.addEventListener('astro:before-swap', () => dispose?.());
  window.addEventListener('popstate', () => closeForNavigation?.());
  window.addEventListener('pagehide', () => closeForNavigation?.());
</script>

<style>
  .ask-dialog { box-sizing: border-box; position: fixed; inset: auto var(--space-5) var(--space-5) auto; width: min(32rem, calc(100% - 2 * var(--space-5))); height: min(46rem, calc(100dvh - 2 * var(--space-5))); max-height: none; margin: 0; padding: 0; overflow: hidden; color: var(--text); background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-m); box-shadow: var(--elev-3); }
  .ask-dialog:not([open]) { display: none; }
  .ask-dialog[open] { display: flex; flex-direction: column; }
  .ask-dialog::backdrop { background: rgb(11 46 74 / .58); }
  .ask-dialog__header { display: flex; flex: none; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border); }
  .ask-dialog__header img { border-radius: 50%; }
  .ask-dialog__header h2 { margin: 0; font: var(--fw-display) var(--fs-500)/1.15 var(--font-display); }
  .ask-dialog__header h2 span { display: block; margin-top: var(--space-1); color: var(--soft); font: var(--fw-medium) var(--fs-200)/1.2 var(--font-ui); }
  .ask-dialog__close { display: grid; flex: none; place-items: center; width: 44px; height: 44px; margin-inline-start: auto; border: 0; border-radius: 50%; background: var(--bg-alt); color: var(--text); cursor: pointer; }
  .ask-dialog__close:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .ask-dialog__body { display: flex; flex: 1 1 auto; min-height: 0; }
  .ask-dialog__body :global(.ask-guide) { flex: 1 1 auto; }
  .ask-dialog__body :global(.ask-guide__scroll) { padding: var(--space-4) var(--space-5); }
  .ask-dialog__body :global(.ask-guide__form) { padding: var(--space-3) var(--space-5) max(var(--space-3), env(safe-area-inset-bottom)); border-top: 1px solid var(--border); }
  @media (max-width: 767px) {
    .ask-dialog { inset: auto 0 0; width: 100%; max-width: none; height: min(40rem, 100dvh); border-radius: var(--radius-m) var(--radius-m) 0 0; }
    .ask-dialog__header { padding-inline: var(--space-4); }
    .ask-dialog__body :global(.ask-guide__scroll), .ask-dialog__body :global(.ask-guide__form) { padding-inline: var(--space-4); }
  }
</style>
