---
/**
 * AskPICTA - editorial pull-tag inviting the reader to ask PI.
 *
 * Drop into article / venue templates near the end of body copy.
 * Pre-fills the drawer's input with a context-aware question if `prefill` is provided.
 *
 * Usage:
 *   <AskPICTA />
 *   <AskPICTA prefill="Tell me more about Foxeys Hangout" />
 *   <AskPICTA prefill="What pairs with Paringa pinot?" label="Ask The Insider" />
 *   <AskPICTA variant="rule" />   <!-- horizontal rule + centered tag -->
 */
export interface Props {
  prefill?: string;
  label?: string;
  hint?: string;
  variant?: 'inline' | 'rule';
}

const {
  prefill = '',
  label = "Ask The Insider about this",
  hint = "She knows the staff, the table, and what to actually order.",
  variant = 'rule',
} = Astro.props;
---

<aside
  class={`pi-cta pi-cta--${variant}`}
  data-pi-trigger="true"
  data-pi-prefill={prefill}
  role="complementary"
>
  <span class="pi-cta__rule" aria-hidden="true"></span>
  <button class="pi-btn pi-btn--solid" type="button" aria-label={label}>
    <span class="pi-cta__avatar" aria-hidden="true">
      <span class="pi-cta__fallback">PI</span>
      <img src="/images/pi-concierge.svg" alt="" width="36" height="36" onerror="this.remove()" />
    </span>
    <span class="pi-cta__text">
      <span class="pi-cta__eyebrow">Ask The Insider <span aria-hidden="true">✦</span></span>
      <span class="pi-cta__label">{label}</span>
      {hint && <span class="pi-cta__hint">{hint}</span>}
    </span>
    <span class="pi-cta__arrow" aria-hidden="true">→</span>
  </button>
  <span class="pi-cta__rule" aria-hidden="true"></span>
</aside>

<style is:global>
  /* ── Editorial "Ask The Insider" pull-tag ── for end-of-article placement ── */
  .pi-cta {
    --pi-cta-paper:  #FFFCF6;
    --pi-cta-terra:  var(--accent);
    --pi-cta-ink:    var(--text);
    --pi-cta-rule:   rgba(11, 90, 72, 0.2);

    margin: 3rem auto;
    max-width: 680px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .pi-cta--inline { margin: 1.5rem 0; }

  .pi-cta__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--pi-cta-rule), transparent);
  }
  .pi-cta--inline .pi-cta__rule:first-child,
  .pi-cta--inline .pi-cta__rule:last-child { display: none; }

  .pi-cta__avatar {
    position: relative;
    width: 44px; height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: radial-gradient(circle at 30% 30%, #e1f8f2 0%, #c7f0e6 70%, #afe5d8 100%);
    border: 1px solid rgba(11, 90, 72, 0.22);
    display: grid;
    place-items: center;
    box-shadow: 0 1px 4px rgba(0, 40, 34, 0.08);
  }
  .pi-cta__avatar img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .pi-cta__fallback {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    color: var(--pi-cta-terra);
    font-size: 1rem;
    line-height: 1;
  }

  .pi-cta__text {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 0;
  }
  .pi-cta__eyebrow {
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pi-cta-terra);
  }
  .pi-cta__label {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-style: normal;
    font-weight: 600;
    color: var(--pi-cta-ink);
    line-height: 1.18;
    letter-spacing: -0.005em;
  }
  .pi-cta__hint {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: rgba(18, 33, 30, 0.6);
    line-height: 1.4;
  }
  .pi-cta__arrow {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(18, 33, 30, 0.55);
    flex-shrink: 0;
    transition: transform 0.22s ease, color 0.22s ease;
    margin-left: 0.5rem;
  }

  @media (max-width: 640px) {
    .pi-cta { gap: 0.85rem; margin: 2.25rem auto; }
    .pi-cta__hint { display: none; }
    .pi-cta__label { font-size: 1.05rem; }
  }
</style>

<script is:inline>
(function () {
  function bindCTAs() {
    document.querySelectorAll('.pi-cta[data-pi-trigger="true"]').forEach((el) => {
      if (el._piCtaBound) return;
      el._piCtaBound = true;
      const prefill = el.getAttribute('data-pi-prefill') || '';
      el.querySelector('button[type="button"]').addEventListener('click', () => {
        if (typeof window.openConcierge === 'function') {
          window.openConcierge(prefill);
        } else {
          const url = '/ask/' + (prefill ? '?q=' + encodeURIComponent(prefill) : '');
          window.location.href = url;
        }
      });
    });
  }
  bindCTAs();
  document.addEventListener('astro:page-load', bindCTAs);
})();
</script>
