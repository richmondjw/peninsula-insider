---
/**
 * AskPICTA — editorial pull-tag inviting the reader to ask PI.
 *
 * Drop into article / venue templates near the end of body copy.
 * Pre-fills the drawer's input with a context-aware question if `prefill` is provided.
 *
 * Usage:
 *   <AskPICTA />
 *   <AskPICTA prefill="Tell me more about Foxeys Hangout" />
 *   <AskPICTA prefill="What pairs with Paringa pinot?" label="Ask The Insider" />
 *   <AskPICTA variant="rule" />   <!-- horizontal rule + centered tag -->
 */
export interface Props {
  prefill?: string;
  label?: string;
  hint?: string;
  variant?: 'inline' | 'rule';
}

const {
  prefill = '',
  label = "Ask The Insider about this",
  hint = "She knows the staff, the table, and what to actually order.",
  variant = 'rule',
} = Astro.props;
---

<aside
  class={`pi-cta pi-cta--${variant}`}
  data-pi-trigger="true"
  data-pi-prefill={prefill}
  role="complementary"
>
  <span class="pi-cta__rule" aria-hidden="true"></span>
  <button class="pi-cta__btn" type="button" aria-label={label}>
    <span class="pi-cta__avatar" aria-hidden="true">
      <span class="pi-cta__fallback">PI</span>
      <img src="/images/pi-concierge.svg" alt="" width="36" height="36" onerror="this.remove()" />
    </span>
    <span class="pi-cta__text">
      <span class="pi-cta__eyebrow">Ask The Insider <span aria-hidden="true">✦</span></span>
      <span class="pi-cta__label">{label}</span>
      {hint && <span class="pi-cta__hint">{hint}</span>}
    </span>
    <span class="pi-cta__arrow" aria-hidden="true">→</span>
  </button>
  <span class="pi-cta__rule" aria-hidden="true"></span>
</aside>

<style is:global>
  /* ── Editorial "Ask The Insider" pull-tag ── for end-of-article placement ── */
  .pi-cta {
    --pi-cta-paper:  #FFFCF6;
    --pi-cta-terra:  #8B4E3B;
    --pi-cta-ink:    #2B2520;
    --pi-cta-rule:   rgba(139, 78, 59, 0.2);

    margin: 3rem auto;
    max-width: 680px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .pi-cta--inline { margin: 1.5rem 0; }

  .pi-cta__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--pi-cta-rule), transparent);
  }
  .pi-cta--inline .pi-cta__rule:first-child,
  .pi-cta--inline .pi-cta__rule:last-child { display: none; }

  .pi-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.35rem 0.85rem 0.95rem;
    background: var(--pi-cta-paper);
    border: 1px solid rgba(139, 78, 59, 0.22);
    border-radius: 100px;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    text-align: left;
    box-shadow:
      0 1px 0 rgba(255, 252, 247, 0.8) inset,
      0 1px 2px rgba(34, 24, 16, 0.04),
      0 8px 22px rgba(34, 24, 16, 0.06);
    transition:
      transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.22s cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .pi-cta__btn:hover {
    transform: translateY(-2px);
    border-color: rgba(139, 78, 59, 0.45);
    box-shadow:
      0 1px 0 rgba(255, 252, 247, 0.8) inset,
      0 4px 12px rgba(34, 24, 16, 0.07),
      0 16px 36px rgba(34, 24, 16, 0.10);
  }
  .pi-cta__btn:hover .pi-cta__arrow {
    transform: translateX(4px);
    color: var(--pi-cta-terra);
  }

  .pi-cta__avatar {
    position: relative;
    width: 44px; height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: radial-gradient(circle at 30% 30%, #FBF1DE 0%, #F0E2C7 70%, #E5D2AF 100%);
    border: 1px solid rgba(139, 78, 59, 0.22);
    display: grid;
    place-items: center;
    box-shadow: 0 1px 4px rgba(34, 24, 16, 0.08);
  }
  .pi-cta__avatar img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .pi-cta__fallback {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    color: var(--pi-cta-terra);
    font-size: 1rem;
    line-height: 1;
  }

  .pi-cta__text {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 0;
  }
  .pi-cta__eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pi-cta-terra);
  }
  .pi-cta__label {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.18rem;
    font-style: italic;
    font-weight: 600;
    color: var(--pi-cta-ink);
    line-height: 1.18;
    letter-spacing: -0.005em;
  }
  .pi-cta__hint {
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    color: rgba(43, 37, 32, 0.6);
    line-height: 1.4;
  }
  .pi-cta__arrow {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(43, 37, 32, 0.55);
    flex-shrink: 0;
    transition: transform 0.22s ease, color 0.22s ease;
    margin-left: 0.5rem;
  }

  @media (max-width: 640px) {
    .pi-cta { gap: 0.85rem; margin: 2.25rem auto; }
    .pi-cta__btn { gap: 0.7rem; padding: 0.7rem 1rem 0.7rem 0.7rem; }
    .pi-cta__hint { display: none; }
    .pi-cta__label { font-size: 1.05rem; }
  }
</style>

<script is:inline>
(function () {
  function bindCTAs() {
    document.querySelectorAll('.pi-cta[data-pi-trigger="true"]').forEach((el) => {
      if (el._piCtaBound) return;
      el._piCtaBound = true;
      const prefill = el.getAttribute('data-pi-prefill') || '';
      el.querySelector('.pi-cta__btn').addEventListener('click', () => {
        if (typeof window.openConcierge === 'function') {
          window.openConcierge(prefill);
        } else {
          const url = '/ask/' + (prefill ? '?q=' + encodeURIComponent(prefill) : '');
          window.location.href = url;
        }
      });
    });
  }
  bindCTAs();
  document.addEventListener('astro:page-load', bindCTAs);
})();
</script>
