---
/**
 * EditorialSurface.astro
 *
 * The core component for the Peninsula Insider editorial surface system.
 * Renders a curated editorial moment at one of three restraint levels.
 *
 * Placement: post-hero, pre-grid. One per hub page, maximum.
 *
 * Three levels (locked 2026-05-16):
 *   1 — Editorial Card: flagship destination-led moments (Long Lunch, Cellar Door)
 *   2 — Editorial Strip: scalable system language across all hub surfaces
 *   3 — Editorial Annotation: supporting contextual layer only, not a primary slot
 *
 * Eyebrow structure (Phase 1):
 *   "Selected by Peninsula Insider · [surface] · [season]"
 *
 * Phase 2 evolution (no redesign required):
 *   PI ownership line stays; partner line appears beneath or replaces season slot.
 *   Example: "Selected by Peninsula Insider · Featured Long Lunch · with [Partner]"
 *   The structural position is identical — the label evolves.
 *
 * Usage:
 *   <EditorialSurface
 *     level={1}
 *     surface="Featured Long Lunch"
 *     season="Autumn 2026"
 *     name="Laura, Merricks"
 *     verdict="Sit at the bar if you can. Four courses at their pace, not yours..."
 *     meta={["Red Hill region", "Bookings required", "Lunch Thu–Sun"]}
 *     href="/eat/laura/"
 *     image="/images/sourced/article-long-lunch-01.webp"
 *     imageAlt="The long lunch, Mornington Peninsula"
 *   />
 */

export interface Props {
  /** Visual weight level: 1 = editorial card, 2 = editorial strip, 3 = annotation */
  level: 1 | 2 | 3;
  /** Surface label, e.g. "Featured Long Lunch" or "Featured Cellar Door" */
  surface: string;
  /** Season string, e.g. "Autumn 2026" */
  season?: string;
  /** Venue or experience name */
  name: string;
  /** PI-voice editorial verdict — 1–3 sentences */
  verdict: string;
  /** Secondary context chips: location, booking, hours */
  meta?: string[];
  /** Link to full venue page, article, or sub-page */
  href: string;
  /** Image path — required for level 1, optional for level 2, unused for level 3 */
  image?: string;
  imageAlt?: string;
}

const {
  level,
  surface,
  season,
  name,
  verdict,
  meta = [],
  href,
  image,
  imageAlt = '',
} = Astro.props;

const eyebrowOwnership = 'Selected by Peninsula Insider';
const eyebrowFull = season
  ? `${eyebrowOwnership} · ${surface} · ${season}`
  : `${eyebrowOwnership} · ${surface}`;
---

{level === 1 && (
  <section class="es es--l1" aria-label={surface}>
    {image && (
      <div class="es-l1__image">
        <img src={image} alt={imageAlt} loading="lazy" />
      </div>
    )}
    <div class="es-l1__body">
      <p class="es__eyebrow">{eyebrowFull}</p>
      <h2 class="es-l1__name">{name}</h2>
      <p class="es-l1__verdict">{verdict}</p>
      {meta.length > 0 && (
        <ul class="es-l1__meta" aria-label="Venue details">
          {meta.map((item, i) => (
            <li>{i > 0 && <span class="es-l1__meta-sep" aria-hidden="true">·</span>}{item}</li>
          ))}
        </ul>
      )}
      <a href={href} class="es-l1__link">Read the full recommendation</a>
    </div>
  </section>
)}

{level === 2 && (
  <section class="es es--l2" aria-label={surface}>
    {image && (
      <div class="es-l2__image">
        <img src={image} alt={imageAlt} loading="lazy" />
      </div>
    )}
    <div class="es-l2__body">
      <p class="es__eyebrow">{eyebrowFull}</p>
      <h2 class="es-l2__name">{name}</h2>
      <p class="es-l2__verdict">{verdict}</p>
    </div>
    <div class="es-l2__action">
      <a href={href} class="es-l2__link">Read the verdict</a>
    </div>
  </section>
)}

{level === 3 && (
  <section class="es es--l3" aria-label={surface}>
    <div class="es-l3__label">
      <p class="es__eyebrow">{eyebrowOwnership}</p>
      <p class="es-l3__surface">{surface}{season ? ` · ${season}` : ''}</p>
    </div>
    <div class="es-l3__content">
      <span class="es-l3__name">{name}</span>
      <span class="es-l3__sep" aria-hidden="true">—</span>
      <p class="es-l3__verdict">{verdict}</p>
      <a href={href} class="es-l3__link">Verdict</a>
    </div>
  </section>
)}

<style>
  /* ── Shared ──────────────────────────────────────────────────────── */
  .es {
    /* container-type removed: element cannot observe its own container context.
       Breakpoints use @media queries instead — surfaces are always full-width
       on hub pages so viewport width is the correct signal. */
  }

  .es__eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  /* ── Level 1 — Editorial Card ────────────────────────────────────── */
  .es--l1 {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    overflow: hidden;
  }

  @media (max-width: 680px) {
    .es--l1 { grid-template-columns: 1fr; }
  }

  .es-l1__image {
    overflow: hidden;
    min-height: 280px;
  }

  @media (max-width: 680px) {
    .es-l1__image { min-height: 220px; }
    .es-l1__body { padding: 1.5rem; }
  }

  .es-l1__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s var(--ease, ease);
  }

  .es--l1:hover .es-l1__image img {
    transform: scale(1.02);
  }

  .es-l1__body {
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }

  @media (max-width: 680px) {
    .es-l1__body { padding: 1.75rem 1.5rem; }
  }

  .es-l1__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.65rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    color: var(--text);
    margin: 0;
  }

  .es-l1__verdict {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--soft);
    margin: 0;
  }

  .es-l1__meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    font-size: 0.78rem;
    color: var(--soft);
  }

  .es-l1__meta li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .es-l1__meta-sep {
    color: var(--border);
  }

  .es-l1__link {
    display: inline-block;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    padding-bottom: 1px;
    border-bottom: 1px solid currentColor;
    align-self: flex-start;
    transition: color 0.15s;
    margin-top: 0.25rem;
  }

  .es-l1__link:hover {
    color: var(--text);
  }

  /* ── Level 2 — Editorial Strip ───────────────────────────────────── */
  .es--l2 {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0 2rem;
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.625rem 2.5rem;
  }

  @media (max-width: 680px) {
    .es--l2 {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      gap: 1rem 1.25rem;
      padding: 1.5rem;
    }
    .es-l2__action {
      grid-column: 1 / -1;
    }
  }

  .es-l2__image {
    width: 96px;
    height: 68px;
    border-radius: 2px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .es-l2__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .es-l2__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .es-l2__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
    margin: 0;
  }

  .es-l2__verdict {
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--soft);
    margin: 0;
  }

  .es-l2__action {
    flex-shrink: 0;
  }

  .es-l2__link {
    display: inline-block;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--bg);
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
  }

  .es-l2__link:hover {
    border-color: var(--text);
    color: var(--accent);
  }

  /* ── Level 3 — Editorial Annotation ─────────────────────────────── */
  .es--l3 {
    display: flex;
    align-items: baseline;
    gap: 0 2rem;
    flex-wrap: wrap;
    padding: 1.125rem 0 1.25rem;
    border-top: 1px solid var(--border);
  }

  .es-l3__label {
    flex-shrink: 0;
    width: 150px;
  }

  .es-l3__surface {
    font-size: 0.75rem;
    color: var(--soft);
    font-style: italic;
    margin: 0.2rem 0 0;
  }

  .es-l3__content {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .es-l3__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  .es-l3__sep {
    color: var(--border);
    flex-shrink: 0;
  }

  .es-l3__verdict {
    font-size: 0.85rem;
    color: var(--soft);
    line-height: 1.6;
    flex: 1;
    min-width: 180px;
    margin: 0;
  }

  .es-l3__link {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.78rem;
    color: var(--soft);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s;
  }

  .es-l3__link:hover {
    color: var(--text);
  }
</style>
