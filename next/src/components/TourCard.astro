---
/**
 * TourCard  -  editorial card for a single tour entry.
 * Expects a full Astro content-collection entry from `tours`.
 */

import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';
import { resolveHero } from '../lib/inline-edit/resolve-hero';
import MediaProvenanceNote from './MediaProvenanceNote.astro';

export interface Props {
  tour: any;
  operatorName?: string;
}

const { tour, operatorName } = Astro.props;
const data = tour.data;
const slug = tour.id ?? data.slug;
const href = `/tour/${slug}/`;
const hero = await resolveHero('tour', slug, data);
const showHero = Boolean(hero.override) || Boolean(data.heroImage?.src);
const commonsCredit = !hero.override && data.heroImage?.license === 'wikimedia-cc-by-sa' && data.heroImage?.sourceUrl;

const durationLabel: Record<string, string> = {
  'under-2h': 'Under 2 hours',
  'around-2h': 'About 2 hours',
  'half-day': 'Half day',
  'full-day': 'Full day',
  'multi-2n': '2-night',
  'multi-3n': '3-night',
  'multi-extended': 'Extended',
};

const audienceLabel: Record<string, string> = {
  'adults': 'Adults',
  'families': 'Families',
  'solo': 'Solo',
  'couples': 'Couples',
  'seniors': 'Seniors',
  'accessible': 'Accessible',
  'general': 'All guests',
};

const excerpt = data.intro
  ? data.intro.length > 120
    ? data.intro.slice(0, 117) + '...'
    : data.intro
  : '';

// Pricing is intentionally not rendered. BRAND-PI rule (2026-05-15):
// "No pricing on site. Ever." Readers book direct with the operator
// where the current price is live. Data fields on the content remain
// for future use but never reach the page.
---

<article class="tour-card">
  {showHero && (
    <div class="tour-card__image">
      <a href={href} tabindex="-1" aria-hidden="true">
        <img
          src={hero.src}
          alt={hero.alt}
          loading="lazy"
          decoding="async"
          {...editableImage({
            entityType: 'tour',
            entitySlug: slug,
            fieldPath: 'heroImage',
            label: `${data.name} hero`,
            purpose: 'hero',
          })}
        />
      </a>
    </div>
  )}
  <div class="tour-card__body">
    <MediaProvenanceNote image={hero.override ? null : data.heroImage} subject={data.name} />
    {commonsCredit && (
      <p class="tour-card__photo-credit">
        Photo by <a href={data.heroImage.sourceUrl} rel="external">{data.heroImage.rightsHolder ?? data.heroImage.credit}</a>,
        {' '}<a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="external">CC BY-SA 4.0</a>. Resized.
      </p>
    )}
    <div class="tour-card__meta">
      {data.duration && (
        <span class="tour-card__badge">{durationLabel[data.duration] ?? data.duration}</span>
      )}
      {data.audience && (
        <span class="tour-card__badge tour-card__badge--accent">{audienceLabel[data.audience] ?? data.audience}</span>
      )}

    </div>
    <h3 class="tour-card__name">
      <a href={href}>{data.name}</a>
    </h3>
    {(operatorName || data.operatorSlug) && (
      <p class="tour-card__operator">
        by <a href={`/tour/operators/${data.operatorSlug}/`}>{operatorName ?? data.operatorSlug.replace(/-/g, ' ')}</a>
      </p>
    )}
    <p class="tour-card__excerpt">{excerpt}</p>
    <a href={href} class="tour-card__cta pi-btn pi-btn--text">Read notes &rarr;</a>
  </div>
  <PiSaveActions
    kind="tour"
    slug={slug}
    title={data.name}
    href={href}
    dek={excerpt}
    imageUrl={commonsCredit ? undefined : hero.src}
  />
</article>

<style>
  .tour-card__photo-credit { margin: .65rem 0 .35rem; font-size: .75rem; line-height: 1.45; color: var(--soft); }
  .tour-card__photo-credit a { text-decoration: underline; text-underline-offset: .12em; }
</style>
