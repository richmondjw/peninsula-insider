---
import { routeSlug, formatHeroCredit } from '../../lib/editorial';
import { resolveHero } from '../../lib/inline-edit/resolve-hero';
import { editableImage } from '../../lib/inline-edit/attrs';
import MediaProvenanceNote from '../MediaProvenanceNote.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
// author: a named contributor only. The house byline is omitted from card meta.
const { display = {}, article, large = false, lead = false, author = '' } = Astro.props;
const slug=routeSlug(article);
const hero=await resolveHero('article',slug,article.data,'hero');
const available=!hero.src.startsWith('/') || existsSync(resolve('public',hero.src.slice(1)));
const showPhoto=hero.hasPhoto && available;
const provenance=hero.override ? undefined : article.data.heroImage;
const title=display.title || article.data.title;
// Keep hyphenated compounds ('late-afternoon', 'cellar-door') on one line.
const titleParts=String(title).split(/(\S+-\S+)/).filter(Boolean);
const sizes=lead ? "(max-width: 767px) 100vw, (max-width: 1100px) 85vw, 920px" : large ? "(max-width: 767px) 100vw, (max-width: 1100px) 90vw, 840px" : "(max-width: 767px) 100vw, 426px";
const readTime=article.data.readingTimeMinutes;
---
<article class:list={['story',large && 'large',lead && 'cover',!showPhoto && 'no-photo']}>
 {showPhoto && <figure><a href={`/journal/${slug}/`}><img src={hero.src} data-pi-responsive={sizes} alt={hero.alt} loading={lead?'eager':'lazy'} fetchpriority={lead?'high':'auto'} decoding="async" width="1200" height="800" {...editableImage({entityType:'article',entitySlug:slug,fieldPath:'hero',label:`${article.data.title} hero`,purpose:'hero'})}/></a>{!hero.override && article.data.heroImage?.credit && <figcaption class="image-credit">{formatHeroCredit(article.data.heroImage.credit)}</figcaption>}<MediaProvenanceNote image={provenance}/></figure>}
 <div class:list={['story-body',lead && 'cover-copy']}>
 <p class="eyebrow">{display.eyebrow || article.data.tags?.[0]?.replaceAll('-',' ') || 'The Journal'}</p>
 {lead ? <h2><a href={`/journal/${slug}/`}>{titleParts.map(part => /-/.test(part) && !/\s/.test(part) ? <span class="nowrap">{part}</span> : part)}</a></h2> : <h3><a href={`/journal/${slug}/`}>{titleParts.map(part => /-/.test(part) && !/\s/.test(part) ? <span class="nowrap">{part}</span> : part)}</a></h3>}
 <p class={lead?'cover-dek':'dek'}>{display.dek || article.data.dek}</p>
 <p class="meta">{author && <span class="meta-item">{author}</span>}<span class="meta-item">Published <time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'})}</time></span>{readTime && <span class="meta-item">{readTime} min read</span>}</p>
 {lead && <a class="text-link" href={`/journal/${slug}/`}>Read the story <span aria-hidden="true">→</span></a>}
 </div>
</article>
