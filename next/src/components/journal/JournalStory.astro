---
import { routeSlug } from '../../lib/editorial';
import { resolveJournalImage } from '../../lib/journal-image';
import { journalCredit, journalRecoveryAttrs } from '../../lib/journal-image-policy.mjs';
import { editableImage } from '../../lib/inline-edit/attrs';
import { isArtwork } from '../../lib/image-caption.mjs';
const { display = {}, article, large = false, lead = false, author = 'Peninsula Insider' } = Astro.props;
const slug=routeSlug(article);
const hero=await resolveJournalImage(slug,article.data);
---
<article class:list={['story',large && 'large',lead && 'cover']}>
 <figure><a href={`/journal/${slug}/`}><img src={hero.src} data-pi-responsive={lead ? "(max-width: 767px) 100vw, (max-width: 1100px) 85vw, 920px" : "(max-width: 767px) 100vw, 426px"} alt={hero.alt} role={hero.decorative ? 'presentation' : undefined} loading={lead?'eager':'lazy'} fetchpriority={lead?'high':'auto'} decoding="async" width="1200" height="800" {...journalRecoveryAttrs(hero)} {...editableImage({entityType:'article',entitySlug:slug,fieldPath:'hero',label:`${article.data.title} hero`,purpose:'hero'})}/></a><figcaption class="image-credit" data-journal-artwork={isArtwork(hero) ? "" : undefined}><span data-journal-image-caption>{hero.caption}</span>{hero.caption && ' '}<span data-journal-image-credit>{journalCredit(hero)}</span></figcaption></figure>
 <div class:list={[lead && 'cover-copy']}>
 {lead ? <h2><a href={`/journal/${slug}/`}>{display.title || article.data.title}</a></h2> : <h3><a href={`/journal/${slug}/`}>{display.title || article.data.title}</a></h3>}
 <p class={lead?'cover-dek':'dek'}>{display.dek || article.data.dek}</p>
 {/* Round 2 (2026-11-10): image, headline, one line, date. No kicker; the
     house byline is omitted on our own site and a named author is kept. */}
 <p class="meta">{author !== 'Peninsula Insider' && <>{author} · </>}<time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'})}</time></p>
 </div>
</article>
