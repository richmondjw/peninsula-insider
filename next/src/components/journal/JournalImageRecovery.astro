<script>
  import { journalCredit } from '../../lib/journal-image-policy.mjs';
  function recover(img: HTMLImageElement) {
    let choices: any[];
    try { choices = JSON.parse(img.dataset.journalRecovery || '[]'); } catch { return; }
    const original = img.dataset.piImageOriginalSrc || img.getAttribute('src');
    const next = choices.findIndex(choice => choice.src.split(/[?#]/)[0] !== original?.split(/[?#]/)[0]);
    if (next < 0) return;
    const image = choices[next];
    img.dataset.journalRecovery = JSON.stringify(choices.slice(next + 1));
    img.removeAttribute('srcset');
    img.removeAttribute('sizes');
    delete img.dataset.piImageOriginalSrc;
    img.alt = image.alt;
    img.removeAttribute('role');
    const figure = img.closest('figure');
    const credit = figure?.querySelector('[data-journal-image-credit]');
    if (credit) credit.textContent = journalCredit(image);
    const caption = figure?.querySelector('[data-journal-image-caption]');
    if (caption) caption.textContent = image.caption;
    // The replacement's caption discloses context; discard the old image's note.
    figure?.querySelector('[data-pi-media-disclosure]')?.remove();
    img.src = image.src;
  }
  document.addEventListener('error', event => {
    if (event.target instanceof HTMLImageElement && event.target.hasAttribute('data-journal-image')) recover(event.target);
  }, true);
  const check = () => document.querySelectorAll<HTMLImageElement>('img[data-journal-image]').forEach(img => {
    if (img.complete && img.naturalWidth === 0) recover(img);
  });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', check, { once: true });
  else check();
  document.addEventListener('astro:page-load', check);
</script>
