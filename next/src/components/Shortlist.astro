---
/**
 * Shortlist, magazine-style numbered list. The signature editorial
 * device from v2: a sticky intro on the left, a numbered list of 5
 * picks on the right with location · time · type meta, big serif
 * names, "why we'd send a friend" body, and pill tags.
 *
 * Uses production typography (Cormorant + Outfit) and tokens.
 */
export interface ShortlistItem {
  /** Display rank, usually "01"–"05" or "I"–"V". */
  rank: string;
  /** Up to 3 meta items, joined by hairline dots. */
  meta: string[];
  /** Article / venue name (the headline of the entry). */
  name: string;
  /** Link target. */
  href: string;
  /** The "why" body, usually 2-3 sentences. */
  why: string;
  /** Optional tags rendered as pill chips. Set isHat: true for gold border. */
  tags?: { label: string; isHat?: boolean }[];
}

export interface Props {
  eyebrow?: string;
  title: string;
  dek?: string;
  /** Optional read-the-methodology link. */
  link?: { label: string; href: string };
  items: ShortlistItem[];
}

const { eyebrow = 'The Shortlist', title, dek, link, items } = Astro.props;
---

<section class="shortlist" aria-labelledby="shortlist-title">
  <div class="container">
    <div class="shortlist__frame">
      <div class="shortlist__intro">
        <p class="shortlist__eyebrow">{eyebrow}</p>
        <h2 class="shortlist__heading" id="shortlist-title" set:html={title} />
        {dek && <p class="shortlist__body">{dek}</p>}
        {link && (
          <a href={link.href} class="shortlist__link">
            {link.label}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
          </a>
        )}
      </div>

      <ol class="shortlist__list">
        {items.map((item) => (
          <li class="sl-item">
            <span class="sl-item__num">{item.rank}</span>
            <div class="sl-item__body">
              {item.meta.length > 0 && (
                <div class="sl-item__meta">
                  {item.meta.map((m, i) => (
                    <>
                      {i > 0 && <span class="sl-item__meta-sep" aria-hidden="true"></span>}
                      <span>{m}</span>
                    </>
                  ))}
                </div>
              )}
              <a href={item.href} class="sl-item__name">{item.name}</a>
              <p class="sl-item__why">{item.why}</p>
              {item.tags && item.tags.length > 0 && (
                <div class="sl-item__tags">
                  {item.tags.map((t) => (
                    <span class={`sl-item__tag${t.isHat ? ' sl-item__tag--hat' : ''}`}>{t.label}</span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
