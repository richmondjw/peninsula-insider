  .pi-fig__hair { transform-origin: 37% 60%; animation: pi-wind-hair 7s ease-in-out infinite; }
  .pi-fig__hat { transform-origin: 48% 52%; animation: pi-wind-hat 7s ease-in-out infinite; }
  @keyframes pi-wind-hair { 0%, 58%, 100% { transform: none; } 66% { transform: rotate(6deg) skewX(-3deg); } 74% { transform: rotate(-2deg); } 82% { transform: rotate(3deg) skewX(-1deg); } 91% { transform: rotate(-.8deg); } }
  @keyframes pi-wind-hat { 0%, 56%, 100% { transform: none; } 65% { transform: rotate(-1.1deg) translateY(-.7%); } 76% { transform: rotate(.4deg); } 86% { transform: rotate(-.4deg); } }
  .pi-fig__go { transition: transform 520ms cubic-bezier(.2, .8, .3, 1); }
  .pi-fig__go--hat { transition-delay: 60ms; }
  .pi-chat:has(.pi-msg.is-live) .pi-chat__head-face .pi-fig__go { transform: translate(105%, 18%) rotate(8deg); transition: transform 460ms cubic-bezier(.6, 0, .9, .4); }
  .pi-chat:has(.pi-msg.is-live) .pi-chat__head-face .pi-fig__go--hat { transition-delay: 170ms; }

  .pi-chat__head-id { flex: 1; min-width: 0; }
  .pi-chat__name { margin: 0; font: var(--fw-display) var(--fs-500)/1.1 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-chat__role { margin: 2px 0 0; color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-chat__tools { display: flex; gap: 2px; }
  .pi-chat__tool {
    display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: var(--radius-s);
    background: transparent; color: var(--soft); cursor: pointer;
  }
  .pi-chat__tool:hover { color: var(--text); background: var(--bg-alt); }
  .pi-chat__tool:focus-visible, .pi-chat__chip:focus-visible, .pi-chat__send:focus-visible,
  .pi-chat a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 79.99em) { .pi-chat .pi-chat__tool--mode { display: none; } }
  .pi-chat[data-mode="dock"] .pi-chat__icon-dock, .pi-chat[data-mode="float"] .pi-chat__icon-float { display: none; }

