---
/**
 * PiChat - PI, the Peninsula Insider, as a chat on every page (2026-11-13).
 *
 * Brings back the July 2026 concierge drawer in the simplified design:
 * her hat portrait, her greeting, answers that stream in her voice, picture
 * tiles that link to the pages she recommends, and "ask me next" chips.
 *
 *   Closed      a small pill at the corner: her avatar and "Ask PI".
 *   Open        desktop: docks to the right and pushes the page over, or
 *               floats as a card (the reader's choice, remembered).
 *               phone: a full-height sheet.
 *   Minimised   back to the pill; the conversation is kept for the visit.
 *
 * Any link to /ask/?q=... and any Ask PI form on the site opens the chat
 * instead of leaving the page. /ask/ itself stays as the shareable page,
 * and the chat hides there. The character is specified in BRAND-PI.md.
 */
/**
 * 2026-11-20: the window is back over a different engine. PI's picks are
 * matched in the browser from /ask/index.json (lib/ask-guide.mjs), where every
 * fact on a tile is copied from the page it links to. Her note above them is
 * written by the platform API from those same pages and checked sentence by
 * sentence before it is returned (/concierge/pi/voice). The tiles never wait
 * for the note, and stand on their own if it does not come.
 */
/**
 * 2026-11-20 (later): PI as a character (lib/ask-pi.mjs, lib/pi-lines.mjs).
 * She plans a day as a notebook page of stops, each one a published page, and
 * a reader can swap a stop, send the plan to My Trip or share it. Her modes
 * (surprise me, talk me out of it, settle an argument, rainy day rescue), her
 * refusals and her asides are fixed lines written by a person. None of it is
 * generated and none of it is sent anywhere. SHOW_ASK_PERSONA turns it off.
 */
import { ASK_GUIDE_ON, SHOW_ASK_VOICE, SHOW_ASK_PERSONA, SHOW_ASK_COMPOSE, SHOW_ASK_TALK, SHOW_ASK_SPEECH, SHOW_ASK_LIVE } from '../lib/features';
import { CONCIERGE_API_URL as API_URL } from '../lib/concierge-config';

const starters = SHOW_ASK_PERSONA
  ? ['Plan my day', 'Surprise me', 'Talk me out of it', 'Settle an argument', 'Put it to a vote', 'Rainy day rescue', 'A long lunch in Red Hill', "What's on this weekend"]
  : ['A long lunch in Red Hill', "What's on this weekend", 'Somewhere to stay for our anniversary'];
---

{ASK_GUIDE_ON && (
  <div class="pi-chat" id="pi-chat" data-api={API_URL} data-voice={SHOW_ASK_VOICE ? 'on' : 'off'} data-speech={SHOW_ASK_SPEECH ? 'on' : 'off'} data-live-ready={SHOW_ASK_LIVE ? 'on' : 'off'} data-persona={SHOW_ASK_PERSONA ? 'on' : 'off'} data-compose={SHOW_ASK_PERSONA && SHOW_ASK_VOICE && SHOW_ASK_COMPOSE ? 'on' : 'off'} data-talk={SHOW_ASK_PERSONA && SHOW_ASK_VOICE && SHOW_ASK_TALK ? 'on' : 'off'} data-state="closed" data-mode="dock" transition:persist="pi-chat" data-pagefind-ignore>
    <svg class="pi-chat__sr" width="0" height="0" aria-hidden="true" focusable="false"><filter id="pi-ink" x="-6%" y="-12%" width="112%" height="124%"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="11" result="grain" /><feDisplacementMap in="SourceGraphic" in2="grain" scale="1.3" /></filter></svg>
    <button type="button" class="pi-chat__launch" id="pi-chat-launch" aria-controls="pi-chat-panel" aria-expanded="false">
      <img class="pi-chat__launch-face" src="/images/pi/pi-avatar-96.webp" alt="" width="44" height="44" decoding="async" />
      <span class="pi-chat__launch-text">
        <span class="pi-chat__launch-name">Ask PI</span>
        <span class="pi-chat__launch-sub">The Peninsula Insider</span>
      </span>
      <span class="pi-chat__launch-dot" aria-hidden="true"></span>
    </button>

    <section class="pi-chat__panel" id="pi-chat-panel" aria-labelledby="pi-chat-name" hidden>
      <header class="pi-chat__head">
        <button type="button" class="pi-chat__dial-open" id="pi-chat-dial-open" aria-haspopup="true" aria-expanded="false" aria-controls="pi-chat-dial" aria-label="How much PI: change how she talks"><span class="pi-fig pi-fig--round pi-chat__head-face" aria-hidden="true"><span class="pi-fig__art"><span class="pi-fig__go pi-fig__go--body"><img class="pi-fig__part pi-fig__body" src="/images/pi/pi-layer-body-160.webp" srcset="/images/pi/pi-layer-body-160.webp 160w, /images/pi/pi-layer-body-320.webp 320w" sizes="45px" alt="" width="40" height="40" decoding="async" /></span><span class="pi-fig__go pi-fig__go--strap"><img class="pi-fig__part pi-fig__strap" src="/images/pi/pi-layer-strap-160.webp" srcset="/images/pi/pi-layer-strap-160.webp 160w, /images/pi/pi-layer-strap-320.webp 320w" sizes="45px" alt="" width="40" height="40" decoding="async" /></span><span class="pi-fig__go pi-fig__go--hat"><img class="pi-fig__part pi-fig__hat" src="/images/pi/pi-layer-hat-160.webp" srcset="/images/pi/pi-layer-hat-160.webp 160w, /images/pi/pi-layer-hat-320.webp 320w" sizes="45px" alt="" width="40" height="40" decoding="async" /></span><span class="pi-fig__go pi-fig__go--hair"><img class="pi-fig__part pi-fig__hair" src="/images/pi/pi-layer-hair-160.webp" srcset="/images/pi/pi-layer-hair-160.webp 160w, /images/pi/pi-layer-hair-320.webp 320w" sizes="45px" alt="" width="40" height="40" decoding="async" /></span></span></span></button>
        <div class="pi-chat__head-id">
          <h2 class="pi-chat__name" id="pi-chat-name">PI</h2>
          <p class="pi-chat__role">The Peninsula Insider</p>
        </div>
        <div class="pi-chat__tools">
          <button type="button" class="pi-chat__live-btn" id="pi-chat-live" aria-pressed="false" title="Talk to PI live"{...(SHOW_ASK_LIVE ? {} : { hidden: true })}><span class="pi-chat__live-dot" aria-hidden="true"></span><span class="pi-chat__live-label">Go Live</span></button>
          <button type="button" class="pi-chat__tool pi-chat__tool--mode" id="pi-chat-mode" aria-label="Float the chat over the page" title="Float over the page">
            <svg class="pi-chat__icon-float" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="3.5" width="15" height="13" rx="2"/><rect x="10" y="9" width="5.5" height="5.5" rx="1" fill="currentColor" stroke="none"/></svg>
            <svg class="pi-chat__icon-dock" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="3.5" width="15" height="13" rx="2"/><path d="M12 3.5v13"/><rect x="12" y="3.5" width="5.5" height="13" fill="currentColor" stroke="none"/></svg>
          </button>
          <button type="button" class="pi-chat__tool pi-chat__tool--speak" id="pi-chat-speak" aria-label="Have PI read her replies aloud" aria-pressed="false" title="Read replies aloud" hidden>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8v4h2.8l3.7 3V5L6.3 8z"/><path class="pi-chat__speak-on" d="M13 7.5a3.5 3.5 0 0 1 0 5M15 5.5a6.5 6.5 0 0 1 0 9"/><path class="pi-chat__speak-off" d="M13.5 8l3.5 4M17 8l-3.5 4"/></svg>
          </button>
          <button type="button" class="pi-chat__tool" id="pi-chat-new" aria-label="Start a new conversation" title="New conversation">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 10a6 6 0 1 0 1.8-4.3"/><path d="M4 3.5v3h3"/></svg>
          </button>
          <button type="button" class="pi-chat__tool" id="pi-chat-min" aria-label="Minimise the chat" title="Minimise">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 10h10"/></svg>
          </button>
        </div>
      </header>

      <div class="pi-chat__dial" id="pi-chat-dial" role="group" aria-label="How much PI" hidden>
        <button type="button" class="pi-chat__dial-opt" data-pi-dial="straight" aria-pressed="false">Straight<span>Just the answer</span></button>
        <button type="button" class="pi-chat__dial-opt" data-pi-dial="pi" aria-pressed="true">PI<span>As she comes</span></button>
        <button type="button" class="pi-chat__dial-opt" data-pi-dial="full" aria-pressed="false">Full hat<span>Let her talk</span></button>
        <button type="button" class="pi-chat__forget" id="pi-chat-forget">Forget what you know about me</button>
      </div>
      <div class="pi-chat__thread" id="pi-chat-thread" data-lenis-prevent>
        <div class="pi-chat__hello" id="pi-chat-hello">
          <span class="pi-fig pi-fig--disc pi-chat__portrait" aria-hidden="true"><span class="pi-fig__art"><span class="pi-fig__go pi-fig__go--body"><img class="pi-fig__part pi-fig__body" src="/images/pi/pi-layer-body-320.webp" srcset="/images/pi/pi-layer-body-320.webp 320w, /images/pi/pi-layer-body-640.webp 640w" sizes="168px" alt="" width="168" height="168" decoding="async" /></span><span class="pi-fig__go pi-fig__go--strap"><img class="pi-fig__part pi-fig__strap" src="/images/pi/pi-layer-strap-320.webp" srcset="/images/pi/pi-layer-strap-320.webp 320w, /images/pi/pi-layer-strap-640.webp 640w" sizes="168px" alt="" width="168" height="168" decoding="async" /></span><span class="pi-fig__go pi-fig__go--hat"><img class="pi-fig__part pi-fig__hat" src="/images/pi/pi-layer-hat-320.webp" srcset="/images/pi/pi-layer-hat-320.webp 320w, /images/pi/pi-layer-hat-640.webp 640w" sizes="168px" alt="" width="168" height="168" decoding="async" /></span><span class="pi-fig__go pi-fig__go--hair"><img class="pi-fig__part pi-fig__hair" src="/images/pi/pi-layer-hair-320.webp" srcset="/images/pi/pi-layer-hair-320.webp 320w, /images/pi/pi-layer-hair-640.webp 640w" sizes="168px" alt="" width="168" height="168" decoding="async" /></span></span></span>
          <p class="pi-chat__hello-lead">Tell me what you're after.</p>
          <p class="pi-chat__hello-body">{SHOW_ASK_PERSONA
            ? "A long lunch, a walk, somewhere to stay, what's on this weekend. Or hand me the whole day and I'll put it in order."
            : "A long lunch, a walk, somewhere to stay, what's on this weekend. Name a town and I'll narrow it."}</p>
          <div class="pi-chat__here" id="pi-chat-back" hidden>
            <p class="pi-chat__here-label" id="pi-chat-back-label"></p>
            <ul class="pi-chat__chips" role="list" id="pi-chat-back-chips" aria-labelledby="pi-chat-back-label"></ul>
          </div>
          <div class="pi-chat__here" id="pi-chat-here" hidden>
            <p class="pi-chat__here-label" id="pi-chat-here-label"></p>
            <ul class="pi-chat__chips" role="list" id="pi-chat-here-chips" aria-labelledby="pi-chat-here-label"></ul>
          </div>
          <ul class="pi-chat__chips" role="list" aria-label="Try asking">
            {starters.map((q) => <li><button type="button" class="pi-chat__chip" data-pi-q={q}>{q}</button></li>)}
          </ul>
        </div>
        <ol class="pi-chat__log" id="pi-chat-log" role="list" aria-live="polite"></ol>
      </div>

      <footer class="pi-chat__foot">
        <form class="pi-chat__form" id="pi-chat-form" action="/ask/" method="get">
          <label class="pi-chat__sr" for="pi-chat-input">Ask PI a question</label>
          <textarea id="pi-chat-input" name="q" rows="1" maxlength="500" enterkeyhint="send" placeholder="Ask PI anything about the Peninsula" aria-describedby={SHOW_ASK_VOICE ? 'pi-chat-privacy' : undefined} required></textarea>
          <button type="button" class="pi-chat__mic" id="pi-chat-mic" aria-label="Talk to PI" aria-pressed="false" title="Talk to PI" hidden>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="7.5" y="2.5" width="5" height="9" rx="2.5"/><path d="M4.5 9.5a5.5 5.5 0 0 0 11 0M10 15v2.5"/></svg>
          </button>
          <button type="submit" class="pi-chat__send" id="pi-chat-send" aria-label="Send">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 16V4M5 9l5-5 5 5"/></svg>
          </button>
        </form>
        {SHOW_ASK_VOICE && (
          <p class="pi-chat__fine" id="pi-chat-privacy">
            AI replies can send your messages to our AI providers. We may keep those messages and replies for up to 180 days. Avoid personal details. <a href="/privacy/">Privacy policy</a>
          </p>
        )}
        <p class="pi-chat__live-note" id="pi-chat-live-note" role="status" hidden></p>
        <p class="pi-chat__fine" id="pi-chat-fine">
          {SHOW_ASK_VOICE
            ? "PI's picks and plans come from our published guides. Her notes are written by AI from those pages. Check hours and bookings before you go."
            : "PI matches your question to our published guides in this browser. Nothing you ask is sent or stored. Press Go Live to talk to her. Check hours and bookings before you go."}
        </p>
      </footer>
    </section>
  </div>
)}

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
  import { paragraphs, READER_ERROR, sessionId, sse } from '../lib/ask-client';
  import { isGeneralDiscussion } from '../lib/ask-discussion.mjs';
  import { converse, requestedStopSwap, swapStop, pageOffers, composeRequest, applyCompose, talkPages, cardsFor, hasSubject, declines } from '../lib/ask-pi.mjs';
  import { loadAskIndex } from '../scripts/ask-guide-ui';

  type Place = { href: string; title: string; why: string; section: string; image: string | null; alt: string; credit?: string | null; facts?: [string, string][]; badge?: string | null; note?: string | null; book?: { label: string; href: string } | null; line?: string | null };
  type Card = { href: string; title: string; meta: string; summary?: string; facts: [string, string][]; badge: string | null; image?: string | null; credit?: string | null; book?: { label: string; href: string } | null; line?: string | null };
  type Plan = { title: string; town: string; trip: string | null; stops: { label: string; card: Card; swappable: boolean; line?: string | null }[] };
  type Turn =
    | { role: 'you'; text: string }
    | { role: 'pi'; text: string; places: Place[]; next: string[]; notes?: string[]; links?: { href: string; label: string }[]; error?: boolean;
        kind?: string; mood?: string; aside?: string | null; plan?: Plan; offer?: { line: string; label: string; href: string }; call?: string; fb?: boolean;
        strike?: { over: boolean; strikes: number; offers?: number; final?: boolean; line?: string };
        vote?: { over: boolean; total: number; tied?: boolean; line?: string } };
  type PiTurn = Extract<Turn, { role: 'pi' }>;
  const toPlaces = (cards: Card[]): Place[] => cards.map((card) => ({
    href: card.href, title: card.title, why: card.summary || '', section: card.meta, image: card.image || null, alt: '', credit: card.credit || null, facts: card.facts, badge: card.badge, book: card.book || null, line: card.line || null,
  }));
  // What she is doing while a reader waits for her note.
  const THINKING = ['Checking my notebook…', 'Reading what our pages say…', 'Making the call…'];
  // Her note goes first or not at all: past this she answers with the picks and the plain line.
  const NOTE_WAIT_MS = 8000;
  // A composed plan is three or four model calls, so it gets a little longer.
  const COMPOSE_WAIT_MS = 14000;
  // A conversation turn is a write, a check and sometimes a rewrite.
  const TALK_WAIT_MS = 18000;
  // Once her first sentence is on screen, the rest of the reply has this long.
  const TALK_REST_MS = 25000;
  // Replies she talks through herself. Plans, the three taps, critiques and the
  // things she cannot check keep their own authored paths.
  const TALKABLE = new Set(['results', 'named', 'place', 'none', 'help', 'nightlife', 'with']);
  // Replies that are a step in a conversation, not an answer a reader would open as a page.
  const NOT_A_PAGE = new Set(['interview', 'plan', 'critique', 'with', 'talk', 'sources', 'discussion']);
  const FEEDBACK: [string, string][] = [['wrong-place', 'Wrong sort of place'], ['missed-point', 'Missed the point'], ['out-of-date', 'Out of date'], ['not-funny', 'Not funny']];

  // Version the session namespace whenever the answer engine's privacy boundary
  // changes, so a thread from one mode never carries into the other.
  const HISTORY = 'pi-chat-history-talk-v3';
  const ENGINE = 'pi-chat-engine-talk-v3';
  const STATE = 'pi-chat-state';
  const MODE = 'pi-chat-mode';
  const DESKTOP = window.matchMedia('(min-width: 64em)');
  const WIDE = window.matchMedia('(min-width: 80em)'); // room to dock beside the page

  const store = {
    get(area: Storage, key: string) { try { return area.getItem(key); } catch { return null; } },
    set(area: Storage, key: string, v: string) { try { area.setItem(key, v); } catch { /* private mode */ } },
    del(area: Storage, key: string) { try { area.removeItem(key); } catch { /* private mode */ } },
  };

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  const root = document.getElementById('pi-chat');
  if (root && !root.dataset.booted) {
    root.dataset.booted = '1';
    const api = root.dataset.api || '';
    const launch = document.getElementById('pi-chat-launch') as HTMLButtonElement;
    const panel = document.getElementById('pi-chat-panel') as HTMLElement;
    const thread = document.getElementById('pi-chat-thread') as HTMLElement;
    const hello = document.getElementById('pi-chat-hello') as HTMLElement;
    const log = document.getElementById('pi-chat-log') as HTMLOListElement;
    const form = document.getElementById('pi-chat-form') as HTMLFormElement;
    const input = document.getElementById('pi-chat-input') as HTMLTextAreaElement;
    const send = document.getElementById('pi-chat-send') as HTMLButtonElement;
    const modeBtn = document.getElementById('pi-chat-mode') as HTMLButtonElement;

    const personaOn = root.dataset.persona === 'on';
    // Guide-only by default: the chat answers in the browser and sends nothing.
    // Go Live flips a session up to a real conversation on the platform.
    const BUILD = { voice: root.dataset.voice === 'on' && !!api, compose: root.dataset.compose === 'on', talk: root.dataset.talk === 'on', speech: root.dataset.speech === 'on' };
    let isLive = false;
    let voiceOn = BUILD.voice;
    let composeOn = BUILD.voice && BUILD.compose;
    let talkOn = BUILD.voice && BUILD.talk;
    const here = document.getElementById('pi-chat-here') as HTMLElement;
    const hereLabel = document.getElementById('pi-chat-here-label') as HTMLElement;
    const hereChips = document.getElementById('pi-chat-here-chips') as HTMLElement;
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    // Where "Surprise me" starts. Different on each visit, so it is not the same town every time.
    const shuffle = Math.floor(Math.random() * 1000);
    // What she has learned about this reader between visits, kept on this device only:
    // places they told her they have done, kinds of place they ruled out, and the
    // last place she called for them (a page address and its title, nothing they typed).
    const LEDGER = 'pi-ledger';
    type Last = { u: string; t: string };
    type Ledger = { done: string[]; noKinds: string[]; caught?: boolean; last?: Last | null };
    const ledger = (): Ledger => { try { return { done: [], noKinds: [], ...JSON.parse(store.get(localStorage, LEDGER) || '{}') }; } catch { return { done: [], noKinds: [] }; } };
    const learn = (patch: Partial<Ledger>) => {
      const was = ledger();
      store.set(localStorage, LEDGER, JSON.stringify({ done: [...new Set([...was.done, ...(patch.done || [])])].slice(-60), noKinds: patch.noKinds ? patch.noKinds.slice(0, 2) : was.noKinds, caught: patch.caught ?? was.caught, last: patch.last === undefined ? was.last || null : patch.last }));
    };
    // The call she made on an earlier visit. Read once, so a call made in this visit is not "last time".
    const seenLast = ledger().last;
    let back: Last | null = seenLast && typeof seenLast.u === 'string' && typeof seenLast.t === 'string' ? seenLast : null;
    const BACK = {
      label: (place: string) => `Back again. Last time I sent you to ${place}. Did you go?`,
      loved: 'Went. Loved it',
      meh: 'Went. Not for me',
      no: 'Didn’t go',
      forget: 'Forget me',
      say: {
        loved: 'Of course you did. That one comes off your list, and the next one is on me.',
        meh: 'Noted, and not held against you. I won’t send you back.',
        no: 'Then it’s still waiting for you. So am I.',
        forgot: 'Gone. Clean page, and I never saw you.',
      },
    };
    const SAY_FORGET = /^forget (?:me|everything|all of it|what you know(?: about me)?)[.!]?$/i;
    const matchGuides = (index: any, q: string, state: any, context: Record<string, unknown>): any => converse(index, q, state, { ...context, persona: personaOn, shuffle, done: ledger().done, noKinds: ledger().noKinds });

    /* ---------- the dial ---------- */
    // How much of her the reader wants: straight, pi or full. It changes how she
    // talks and never what she recommends. Set by saying so, by a chip, or by
    // tapping her hat. Remembered on this device.
    type Dial = 'straight' | 'pi' | 'full';
    const DIAL = 'pi-dial';
    const SAY_STRAIGHT = /\b(?:give it to me straight|straight answer|just (?:the answer|tell me|answer)|be serious|seriously(?: though)?|less chat|no jokes|cut the (?:chat|act)|shorter)\b/i;
    const SAY_FULL = /^(?:go on(?: then)?[.!]?|more|be honest|let her talk|full hat|say more|go off)$/i;
    const SAY_PI = /\b(?:back to normal|normal again|as you were|be yourself)\b/i;
    const DIAL_LINE: Record<Dial, string> = {
      straight: 'Straight it is. I’ll save the commentary.',
      pi: 'As I come, then.',
      full: 'You asked. Don’t say I didn’t warn you.',
    };
    const dialBox = document.getElementById('pi-chat-dial') as HTMLElement;
    const dialOpen = document.getElementById('pi-chat-dial-open') as HTMLButtonElement;
    let dial: Dial = (['straight', 'pi', 'full'] as Dial[]).find((d) => d === store.get(localStorage, DIAL)) || 'pi';
    function setDial(next: Dial, how: string) {
      if (next !== dial) track('ask_dial', { variant: next, action: how });
      dial = next;
      store.set(localStorage, DIAL, next);
      for (const b of dialBox.querySelectorAll<HTMLButtonElement>('[data-pi-dial]')) b.setAttribute('aria-pressed', String(b.dataset.piDial === next));
    }
    setDial(dial, 'restore');
    dialOpen.addEventListener('click', () => { dialBox.hidden = !dialBox.hidden; dialOpen.setAttribute('aria-expanded', String(!dialBox.hidden)); });
    dialBox.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pi-dial]');
      if (!b) return;
      setDial(b.dataset.piDial as Dial, 'tap');
      dialBox.hidden = true;
      dialOpen.setAttribute('aria-expanded', 'false');
      say(DIAL_LINE[dial]);
    });
    const backBox = document.getElementById('pi-chat-back') as HTMLElement;
    function showBack() {
      backBox.hidden = !(back && personaOn);
      if (backBox.hidden || !back) return;
      document.getElementById('pi-chat-back-label')!.textContent = BACK.label(back.t);
      document.getElementById('pi-chat-back-chips')!.replaceChildren(...[BACK.loved, BACK.meh, BACK.no, BACK.forget].map((q) => {
        const li = el('li');
        const b = el('button', 'pi-chat__chip', q) as HTMLButtonElement;
        b.type = 'button';
        b.dataset.piQ = q;
        li.append(b);
        return li;
      }));
    }
    function forget() {
      store.del(localStorage, LEDGER);
      store.del(localStorage, DIAL);
      store.del(localStorage, 'pi-speak');
      back = null;
      setDial('pi', 'forget');
      showBack();
      track('ask_memory', { action: 'forget' });
    }
    /** A message that is only about what she remembers is answered by her own line. */
    function memoryReply(q: string): string | null {
      const said = q.trim();
      if (SAY_FORGET.test(said)) { forget(); return BACK.say.forgot; }
      if (!back) return null;
      const which = said === BACK.loved ? 'loved' : said === BACK.meh ? 'meh' : said === BACK.no ? 'no' : null;
      if (!which) return null;
      learn({ done: which === 'no' ? [] : [back.u], last: null });
      back = null;
      showBack();
      track('ask_memory', { action: which });
      return BACK.say[which];
    }
    showBack();
    document.getElementById('pi-chat-forget')!.addEventListener('click', () => {
      forget();
      dialBox.hidden = true;
      dialOpen.setAttribute('aria-expanded', 'false');
      say(BACK.say.forgot);
    });

    /* ---------- her two gestures ---------- */
    // The tilt marks a call. Once a reply, and she skips it when she has made a
    // call in each of the last three, so it stays a gesture. The catch is a
    // reaction: once a conversation at most, and not on two visits running.
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    let calls = 0;
    let caught = false;
    const caughtLast = Boolean(ledger().caught);
    learn({ caught: false });
    function gesture(name: 'tilt' | 'catch') {
      if (still.matches || root.dataset.state !== 'open' || root.dataset.gesture) return;
      if (name === 'tilt') { calls += 1; if (calls % 4 === 0) return; }
      if (name === 'catch') { if (caught || caughtLast) return; caught = true; learn({ caught: true }); }
      root.dataset.gesture = name;
      window.setTimeout(() => { delete root.dataset.gesture; }, name === 'catch' ? 1100 : 680);
    }
    const track = (name: string, params: Record<string, unknown>) => { try { (window as any).piTrack?.(name, params, { component: 'pi-chat' }); } catch { /* never breaks the chat */ } };
    const ephemeral = new WeakSet<Turn>();
    let turns: Turn[] = [];
    try { turns = JSON.parse(store.get(sessionStorage, HISTORY) || '[]'); } catch { turns = []; }
    // What the last answer matched, so "in Flinders" refines it.
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    let engine: any = null;
    try { engine = JSON.parse(store.get(sessionStorage, ENGINE) || 'null'); } catch { engine = null; }
    let controller: AbortController | null = null;

    const onAskPage = () => location.pathname.replace(/\/?$/, '/') === '/ask/';

    /* ---------- layout state ---------- */

    // The docked sidebar starts at the masthead's bottom edge, so the masthead keeps
    // the full width and nothing in it is covered.
    let pinFrame = 0;
    function placeUnderMasthead() {
      pinFrame = 0;
      if (!document.documentElement.classList.contains('pi-chat-docked')) return;
      const mast = document.querySelector('[data-v5-masthead]');
      const top = mast ? Math.max(0, Math.round(mast.getBoundingClientRect().bottom)) : 0;
      root!.style.setProperty('--pi-top', `${top}px`);
    }

    function applyChrome() {
      const state = root!.dataset.state;
      const docked = state === 'open' && root!.dataset.mode === 'dock' && WIDE.matches;
      const modal = state === 'open' && !DESKTOP.matches;
      document.documentElement.classList.toggle('pi-chat-docked', docked);
      document.documentElement.classList.toggle('pi-chat-open', state === 'open');
      panel.classList.toggle('is-docked', docked);
      placeUnderMasthead();
      document.documentElement.classList.toggle('pi-chat-sheet', modal);
      panel.setAttribute('role', modal ? 'dialog' : 'region');
      if (modal) panel.setAttribute('aria-modal', 'true');
      else panel.removeAttribute('aria-modal');
      // On phones the sheet covers the complete viewport. Remove the covered
      // page from both focus order and the accessibility tree until PI closes.
      for (const child of [...document.body.children] as HTMLElement[]) {
        if (child === root) continue;
        if (modal && !child.inert) {
          child.inert = true;
          child.dataset.piChatInert = 'true';
        } else if (!modal && child.dataset.piChatInert === 'true') {
          child.inert = false;
          delete child.dataset.piChatInert;
        }
      }
      launch.classList.toggle('has-thread', turns.length > 0);
    }

    function setMode(mode: string) {
      delete root!.dataset.anchor;
      root!.dataset.mode = mode === 'float' ? 'float' : 'dock';
      store.set(localStorage, MODE, root!.dataset.mode);
      const toFloat = root!.dataset.mode === 'dock';
      modeBtn.setAttribute('aria-label', toFloat ? 'Float the chat over the page' : 'Dock the chat beside the page');
      modeBtn.title = toFloat ? 'Float over the page' : 'Dock beside the page';
      applyChrome();
    }

    // The control that opened the panel (the masthead Ask PI link, a page form), so
    // closing returns focus there rather than to the hidden launcher.
    let opener: HTMLElement | null = null;
    let greeted = false;
    function open(focus = true) {
      if (!greeted) {
        greeted = true;
        root!.classList.add('is-greeting');
        window.setTimeout(() => root!.classList.remove('is-greeting'), 1400);
      }
      root!.dataset.state = 'open';
      store.set(sessionStorage, STATE, 'open');
      panel.hidden = false;
      launch.setAttribute('aria-expanded', 'true');
      applyChrome();
      offerHere();
      requestAnimationFrame(() => {
        if (root!.dataset.state !== 'open') return;
        root!.classList.add('is-in');
        if (focus) input.focus({ preventScroll: true });
      });
    }

    // Opens as a pop-up dialogue in the place of the element that asked for it (the
    // cover's Ask PI badge), dropping down from its top-right corner. This opening
    // only: the reader's saved dock/float choice is restored on minimise.
    function popUpFrom(el: HTMLElement) {
      if (!DESKTOP.matches) { open(); return; }
      const r = el.getBoundingClientRect();
      root!.style.setProperty('--pi-pop-top', `${Math.max(16, Math.round(r.top))}px`);
      root!.style.setProperty('--pi-pop-right', `${Math.max(16, Math.round(window.innerWidth - r.right))}px`);
      root!.dataset.mode = 'float';
      root!.dataset.anchor = 'badge';
      open();
    }

    function minimise(focus = true) {
      try { window.speechSynthesis?.cancel(); } catch { /* nothing was being said */ }
      root!.classList.remove('is-in');
      root!.dataset.state = 'closed';
      store.set(sessionStorage, STATE, 'closed');
      launch.setAttribute('aria-expanded', 'false');
      applyChrome();
      window.setTimeout(() => {
        if (root!.dataset.state === 'open') return;
        panel.hidden = true;
        if (root!.dataset.anchor) {
          delete root!.dataset.anchor;
          root!.dataset.mode = store.get(localStorage, MODE) === 'float' ? 'float' : 'dock';
        }
      }, 220);
      if (focus) {
        const mastheadAsk = document.querySelector<HTMLElement>('.ask-link');
        const returnTo = opener && opener.isConnected ? opener : mastheadAsk || launch;
        // Wait until the modal peers are focusable again. Focusing the hidden
        // fallback launcher leaves keyboard users on the document body.
        requestAnimationFrame(() => returnTo.focus({ preventScroll: true }));
      }
    }

    /* ---------- rendering ---------- */

    // On a venue page she offers a day built around it. Reads the index only;
    // nothing about the page or the reader is sent.
    function offerHere() {
      if (!personaOn || root!.dataset.state !== 'open') return;
      const path = location.pathname;
      loadAskIndex().then((index) => {
        if (path !== location.pathname) return;
        const offer = pageOffers(index, path) as { title: string; chips: string[] } | null;
        here.hidden = !offer;
        if (!offer) return;
        hereLabel.textContent = `You're looking at ${offer.title}.`;
        hereChips.replaceChildren(...offer.chips.map((q) => {
          const li = el('li');
          const b = el('button', 'pi-chat__chip', q) as HTMLButtonElement;
          b.type = 'button';
          b.dataset.piQ = q;
          li.append(b);
          return li;
        }));
      }).catch(() => { here.hidden = true; });
    }

    /** "PI" in her hand: three strokes and a line under them, drawn in order. */
    function signature() {
      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'pi-sign');
      svg.setAttribute('viewBox', '0 0 46 34');
      svg.setAttribute('aria-hidden', 'true');
      ['M9 22 C10 16 11.5 10 14 4', 'M9 7 C16 1 27 3 25 10 C23 16 15 17 11 15', 'M34 4 C33.5 10 32.8 15 32 21', 'M5 31.5 C17 29.5 30 29.5 42 30.5'].forEach((d, i) => {
        const stroke = document.createElementNS(NS, 'path');
        stroke.setAttribute('class', 'pi-sign__ink');
        stroke.setAttribute('pathLength', '1');
        stroke.setAttribute('d', d);
        stroke.style.setProperty('--pi-s', String(i));
        svg.append(stroke);
      });
      return svg;
    }

    function byline(mood?: string) {
      const b = el('p', 'pi-msg__by');
      const face = el('img', 'pi-msg__face') as HTMLImageElement;
      if (mood) face.classList.add(`is-${mood}`);
      face.src = '/images/pi/pi-avatar-96.webp';
      face.alt = '';
      face.width = 28;
      face.height = 28;
      b.append(face, el('span', 'pi-msg__name', 'PI'));
      return b;
    }

    /** Prose with the recommended places linked where PI names them. */
    function proseNodes(text: string, places: Place[]) {
      return paragraphs(text).map((para) => {
        const p = el('p');
        const linked = new Set<string>();
        let rest = para;
        while (rest) {
          let hit: { i: number; place: Place } | null = null;
          for (const place of places) {
            if (linked.has(place.href)) continue;
            const i = rest.indexOf(place.title);
            if (i >= 0 && (!hit || i < hit.i)) hit = { i, place };
          }
          if (!hit) { p.append(rest); break; }
          p.append(rest.slice(0, hit.i));
          const a = el('a', 'pi-msg__inline', hit.place.title) as HTMLAnchorElement;
          a.href = hit.place.href;
          p.append(a);
          linked.add(hit.place.href);
          rest = rest.slice(hit.i + hit.place.title.length);
        }
        return p;
      });
    }

    /**
     * Her picks, as a list down the thread: nothing to swipe sideways. Her call
     * comes first and larger. A tile carries a photograph only when the page it
     * links to shows that photograph itself, with the credit that page prints.
     */
    function tiles(places: Place[], call?: string) {
      const list = el('ul', 'pi-tiles');
      list.setAttribute('role', 'list');
      list.setAttribute('aria-label', 'Places PI recommends');
      const ordered = call ? [...places].sort((a, b) => Number(b.href === call) - Number(a.href === call)) : places;
      for (const [at, place] of ordered.entries()) {
        const li = el('li');
        li.style.setProperty('--pi-i', String(at));
        const a = el('a', 'pi-tile') as HTMLAnchorElement;
        a.href = place.href;
        const called = Boolean(call) && place.href === call;
        if (called) a.classList.add('pi-tile--call');
        const body = el('span', 'pi-tile__body');
        if (called) body.append(el('strong', 'pi-tile__call', 'PI’s call'));
        if (place.section) body.append(el('span', 'pi-tile__section', place.section));
        body.append(el('span', 'pi-tile__title', place.title));
        if (place.badge) body.append(el('strong', 'pi-tile__badge', place.badge));
        // What she says about it: her checked note for this reply, or else the line its page prints.
        if (place.note) body.append(el('span', 'pi-tile__note', place.note));
        else if (place.line && (called || ordered.length === 1)) body.append(el('span', 'pi-tile__note', place.line));
        for (const [label, value] of place.facts ?? []) body.append(el('span', 'pi-tile__fact', `${label}: ${value}`));
        if (place.why) body.append(el('span', 'pi-tile__why', place.why));
        if (place.image) {
          const media = el('span', 'pi-tile__media');
          const img = el('img') as HTMLImageElement;
          img.alt = '';
          img.width = 640;
          img.height = 480;
          img.loading = 'lazy';
          img.decoding = 'async';
          const credit = place.credit ? el('span', 'pi-tile__credit', `Photo · ${place.credit}`) : null;
          img.addEventListener('load', () => media.classList.add('is-loaded'), { once: true });
          img.addEventListener('error', () => { media.remove(); credit?.remove(); a.classList.add('pi-tile--text'); }, { once: true });
          img.src = place.image;
          media.append(img);
          if (credit) body.append(credit);
          a.append(media, body);
        } else {
          // The page has no photograph of its own, so neither does the tile.
          a.classList.add('pi-tile--text');
          a.append(body);
        }
        li.append(a);
        // Under her call, or a lone pick: the booking button that place's own page prints.
        if (place.book && (called || ordered.length === 1)) {
          const row = el('span', 'pi-tile__book');
          const go = el('a', 'pi-tile__book-go', `${place.book.label} ↗`) as HTMLAnchorElement;
          go.href = place.book.href;
          go.target = '_blank';
          go.rel = 'noopener noreferrer';
          go.addEventListener('click', () => track('ask_book', { variant: place.href.split('/').filter(Boolean)[0] || 'place', action: called ? 'call' : 'only' }));
          row.append(go, el('span', 'pi-tile__book-note', 'Their own booking page. Opens in a new tab.'));
          li.append(row);
        }
        list.append(li);
      }
      return list;
    }

    /** What PI cannot check, and where else to look. Fixed wording from the matcher. */
    function smallPrint(turn: Extract<Turn, { role: 'pi' }>) {
      const wrap = el('div', 'pi-msg__small');
      for (const note of turn.notes ?? []) wrap.append(el('p', '', note));
      if (turn.links?.length) {
        const p = el('p', 'pi-msg__links');
        for (const item of turn.links) {
          const a = el('a', '', item.label) as HTMLAnchorElement;
          a.href = item.href;
          p.append(a);
        }
        wrap.append(p);
      }
      return wrap;
    }

    function nextChips(items: string[], label = 'Ask me next') {
      const wrap = el('div', 'pi-msg__next');
      wrap.append(el('p', 'pi-msg__next-label', label));
      const ul = el('ul', 'pi-chat__chips');
      ul.setAttribute('role', 'list');
      for (const q of items.slice(0, 4)) {
        const li = el('li');
        const b = el('button', 'pi-chat__chip', q) as HTMLButtonElement;
        b.type = 'button';
        b.dataset.piQ = q;
        li.append(b);
        ul.append(li);
      }
      wrap.append(ul);
      return wrap;
    }

    /** A plan as a page from her notebook: ordered stops, each one a published page. */
    function notebook(turn: PiTurn, live: boolean) {
      const plan = turn.plan!;
      const note = el('div', 'pi-note');
      if (live) note.dataset.piLive = '1';
      note.append(el('p', 'pi-note__title', plan.title));
      const list = el('ol', 'pi-note__stops');
      list.setAttribute('role', 'list');
      for (const [at, stop] of plan.stops.entries()) {
        const li = el('li', 'pi-note__stop');
        li.style.setProperty('--pi-i', String(at));
        const text = el('div', 'pi-note__text');
        text.append(el('span', 'pi-note__when', stop.label));
        const name = el('a', 'pi-note__name', stop.card.title) as HTMLAnchorElement;
        name.href = stop.card.href;
        text.append(name);
        if (stop.card.meta) text.append(el('span', 'pi-note__meta', stop.card.meta));
        // Her own line about this stop, where one passed the check, above the page's words.
        if (stop.line) text.append(el('span', 'pi-note__line', stop.line));
        if (stop.card.summary) text.append(el('span', 'pi-note__why', stop.card.summary));
        li.append(text);
        if (live && stop.swappable) {
          const swap = el('button', 'pi-note__swap', 'Not that one') as HTMLButtonElement;
          swap.type = 'button';
          swap.dataset.piSwap = String(at);
          swap.setAttribute('aria-label', `Not ${stop.card.title}: show another`);
          li.append(swap);
        }
        list.append(li);
      }
      note.append(list);
      const scribble = el('p', 'pi-note__scribble', turn.aside || '');
      scribble.setAttribute('role', 'status');
      scribble.hidden = !turn.aside;
      const sign = el('p', 'pi-note__sign');
      sign.style.setProperty('--pi-stops', String(plan.stops.length));
      const initials = el('span', 'pi-note__initials', 'PI');
      sign.append(signature(), initials);
      note.append(scribble, sign);
      const acts = el('div', 'pi-note__acts');
      if (plan.trip) {
        const trip = el('a', 'pi-note__act', 'Add to My Trip') as HTMLAnchorElement;
        trip.href = plan.trip;
        trip.dataset.piTrip = '1';
        acts.append(trip);
        const share = el('button', 'pi-note__act', 'Share this plan') as HTMLButtonElement;
        share.type = 'button';
        share.dataset.piShare = '1';
        acts.append(share);
      }
      const status = el('p', 'pi-note__status');
      status.setAttribute('role', 'status');
      note.append(acts, status);
      return note;
    }

    function feedback(turn: PiTurn) {
      const wrap = el('div', 'pi-msg__fb');
      if (turn.fb) { wrap.append(el('p', '', 'Noted.')); return wrap; }
      const b = el('button', 'pi-msg__fb-open', 'PI got it wrong') as HTMLButtonElement;
      b.type = 'button';
      b.dataset.piFb = 'open';
      wrap.append(b);
      return wrap;
    }

    function youNode(text: string) {
      const li = el('li', 'pi-msg pi-msg--you');
      li.append(el('p', 'pi-msg__bubble', text));
      return li;
    }

    function piNode(turn: PiTurn, question?: string, live = false) {
      const li = el('li', 'pi-msg pi-msg--pi');
      const prose = el('div', 'pi-msg__prose');
      if (turn.error) prose.append(el('p', 'pi-msg__error', turn.text));
      else prose.append(...proseNodes(turn.text, turn.plan ? [] : turn.places));
      // Her aside sits under her line; on a plan it is written on the notebook page instead.
      if (turn.aside && !turn.plan) prose.append(el('p', 'pi-msg__aside', turn.aside));
      li.append(byline(turn.mood), prose);
      if (turn.plan) li.append(notebook(turn, live));
      else if (turn.places.length) li.append(tiles(turn.places, turn.call));
      if (turn.strike && !turn.strike.over) {
        const marks = el('p', 'pi-strikes');
        marks.setAttribute('aria-label', `${turn.strike.strikes} of 3 rejections used`);
        for (let i = 0; i < 3; i += 1) marks.append(el('span', `pi-strikes__mark${i < turn.strike.strikes ? ' is-used' : ''}`));
        marks.append(el('span', '', turn.strike.final ? 'My call stands' : `${3 - turn.strike.strikes} left`));
        li.append(marks);
      }
      if (turn.strike?.over && turn.strike.line) li.append(el('p', 'pi-strikes__score', turn.strike.line));
      if (turn.vote?.over && turn.vote.line) li.append(el('p', 'pi-strikes__score', turn.vote.line));
      else if (turn.vote && turn.vote.total > 0) li.append(el('p', 'pi-strikes', `${turn.vote.total} ${turn.vote.total === 1 ? 'vote' : 'votes'} in`));
      if (turn.notes?.length || turn.links?.length) li.append(smallPrint(turn));
      if (turn.offer) {
        const p = el('p', 'pi-msg__offer', `${turn.offer.line} `);
        const a = el('a', '', turn.offer.label) as HTMLAnchorElement;
        a.href = turn.offer.href;
        p.append(a);
        li.append(p);
      }
      if (turn.next.length) li.append(nextChips(turn.next, turn.strike && !turn.strike.over ? 'Your move' : turn.vote && !turn.vote.over ? 'Your vote' : turn.kind === 'interview' ? 'Your answer' : undefined));
      if (personaOn && !turn.error && turn.kind !== 'interview') li.append(feedback(turn));
      if (question && !turn.error && !NOT_A_PAGE.has(turn.kind || '')) {
        const pg = el('a', 'pi-msg__page', 'Open as a page') as HTMLAnchorElement;
        pg.href = `/ask/?q=${encodeURIComponent(question)}`;
        pg.dataset.piPage = '1';
        li.append(pg);
      }
      return li;
    }

    function render() {
      hello.hidden = turns.length > 0;
      const nodes: HTMLElement[] = [];
      let lastQ = '';
      const livePlan = latestPlan();
      for (const t of turns) {
        if (t.role === 'you') { lastQ = t.text; nodes.push(youNode(t.text)); }
        else nodes.push(piNode(t, lastQ, t === livePlan));
      }
      log.replaceChildren(...nodes);
      applyChrome();
    }

    /** The plan the engine still holds: the only one whose stops can be swapped. */
    function latestPlan(): PiTurn | null {
      if (!engine?.pi?.plan) return null;
      for (let i = turns.length - 1; i >= 0; i -= 1) {
        const t = turns[i];
        if (t.role === 'pi' && t.plan) return t;
      }
      return null;
    }

    function save() {
      store.set(sessionStorage, HISTORY, JSON.stringify(turns.filter(turn => !ephemeral.has(turn)).slice(-12)));
      store.set(sessionStorage, ENGINE, JSON.stringify(engine));
    }

    /** The pages on screen in her last reply, so a follow-up can be about them. */
    function shownBefore(): string[] {
      for (let i = turns.length - 1; i >= 0; i -= 1) {
        const t = turns[i];
        if (t.role === 'pi' && t.places.length) return t.places.map((place) => place.href);
      }
      return [];
    }

    /** The last few exchanges, so her note and the front desk follow the thread. */
    function recent(count = 3, discussion = false) {
      const out: { q: string; say?: string }[] = [];
      for (let i = 0; i < turns.length - 1; i += 1) {
        const you = turns[i];
        const pi = turns[i + 1];
        if (you.role === 'you' && pi?.role === 'pi' && !pi.error && ephemeral.has(you) === discussion && ephemeral.has(pi) === discussion) out.push({ q: you.text, say: pi.text });
      }
      return out.slice(-count);
    }

    /** One call to PI's voice. Any failure is simply "no voice this time". */
    async function voice<T>(path: 'voice' | 'front-desk' | 'compose' | 'talk' | 'discuss', body: unknown, signal: AbortSignal): Promise<T | null> {
      const timeout = AbortSignal.timeout(path === 'compose' || path === 'talk' || path === 'discuss' ? 20_000 : 14_000);
      try {
        const res = await fetch(`${api}/concierge/pi/${path}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Session-Id': sessionId() },
          body: JSON.stringify(body),
          signal: AbortSignal.any([signal, timeout]),
        });
        return res.ok ? ((await res.json()) as T) : null;
      } catch {
        return null;
      }
    }

    // Bring an answer into view from its beginning: the reader's own question
    // stays at the top of the thread with her first words under it. Measured
    // against the thread itself; offsetTop is relative to the panel and put
    // the start of a long answer above the fold.
    /**
     * One conversation turn, read as it arrives. Each sentence the platform
     * sends has already passed its check there, so it is shown at once:
     * `onSentence` puts it on screen. Resolves with the whole reply and its
     * closing details, or null when nothing of hers came back in time.
     */
    async function streamTalk(body: unknown, signal: AbortSignal, onSentence: (text: string, first: boolean) => void): Promise<{ say: string; picks: string[]; next: string[]; why: Record<string, string> } | null> {
      const waited = new AbortController();
      let timer = window.setTimeout(() => waited.abort(), TALK_WAIT_MS);
      const said: string[] = [];
      let meta: { picks?: unknown; next?: unknown; why?: unknown } = {};
      try {
        const res = await fetch(`${api}/concierge/pi/talk/stream`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream', 'X-Session-Id': sessionId() },
          body: JSON.stringify(body),
          signal: AbortSignal.any([signal, waited.signal]),
        });
        if (!res.ok || !res.body) return null;
        for await (const { event, data } of sse(res)) {
          if (event === 'sentence' && typeof data.text === 'string' && data.text.trim()) {
            if (!said.length) { window.clearTimeout(timer); timer = window.setTimeout(() => waited.abort(), TALK_REST_MS); }
            said.push(data.text.trim());
            onSentence(data.text.trim(), said.length === 1);
          } else if (event === 'meta') meta = data;
          else if (event === 'none' || event === 'done') break;
        }
      } catch {
        // Cut off part-way: what was shown had already been checked, so it stands.
      } finally {
        window.clearTimeout(timer);
      }
      if (!said.length) return null;
      return {
        say: said.join(' ').slice(0, 1600),
        // The platform can add pages it found by meaning, so a pick need not be
        // one that was sent. It must be a published page: cardsFor() drops the rest.
        picks: (Array.isArray(meta.picks) ? meta.picks : []).filter((href): href is string => typeof href === 'string'),
        next: (Array.isArray(meta.next) ? meta.next : []).filter((item): item is string => typeof item === 'string' && Boolean(item.trim())).map((item) => item.trim().slice(0, 60)).slice(0, 3),
        why: meta.why && typeof meta.why === 'object' ? (meta.why as Record<string, string>) : {},
      };
    }

    function scrollToMsg(node: HTMLElement) {
      requestAnimationFrame(() => {
        const asked = node.previousElementSibling?.classList.contains('pi-msg--you') ? (node.previousElementSibling as HTMLElement) : node;
        const top = thread.scrollTop + asked.getBoundingClientRect().top - thread.getBoundingClientRect().top - 12;
        thread.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      });
    }

    /** A line of hers that answers nothing: a setting confirmed. No model, no page. */
    function say(text: string, next: string[] = []) {
      speak(text);
      const turn: PiTurn = { role: 'pi', text, places: [], next, kind: 'interview' };
      turns.push(turn);
      save();
      const node = piNode(turn);
      node.classList.add('is-arriving');
      log.append(node);
      hello.hidden = true;
      scrollToMsg(node);
    }

    /* ---------- her voice, and the reader's ---------- */
    // Both use what the browser already has. She reads only what is on screen,
    // which has been checked before it got there. Speech is turned into text
    // by the browser; the chat only ever receives the text.
    const SPEAK = 'pi-speak';
    const speakBtn = document.getElementById('pi-chat-speak') as HTMLButtonElement;
    const micBtn = document.getElementById('pi-chat-mic') as HTMLButtonElement;
    const synth: SpeechSynthesis | null = 'speechSynthesis' in window ? window.speechSynthesis : null;
    const Recognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition || null;
    // Her read-aloud setting, and the live conversation it belongs to.
    let speechOn = BUILD.speech;
    let speakOn = speechOn && Boolean(synth) && store.get(localStorage, SPEAK) === 'on';
    const liveBtn = document.getElementById('pi-chat-live') as HTMLButtonElement;
    const liveNote = document.getElementById('pi-chat-live-note') as HTMLElement | null;
    const fine = document.getElementById('pi-chat-fine') as HTMLElement | null;
    const fineGuide = fine ? (fine.textContent || '') : '';
    const FINE_LIVE = "You\u2019re live with PI. Your messages are sent to our platform, which writes and checks her reply and gives her a voice. New conversation ends it.";
    let herVoice: SpeechSynthesisVoice | null = null;
    function pickVoice() {
      if (!synth) return;
      const all = synth.getVoices();
      const named = /karen|catherine|natasha|matilda|olivia|lee|female|woman/i;
      const fit = (v: SpeechSynthesisVoice) => (/^en[-_]AU/i.test(v.lang) ? 0 : /^en[-_]GB/i.test(v.lang) ? 10 : /^en/i.test(v.lang) ? 20 : 99) + (named.test(v.name) ? 0 : 1);
      // Her real voice comes from the platform when live; a device voice is only the fallback.
      herVoice = all.filter((v) => /^en/i.test(v.lang) && (voiceOn || v.localService)).map((v) => ({ v, rank: fit(v) })).sort((a, b) => a.rank - b.rank)[0]?.v || null;
    }
    if (synth) { pickVoice(); synth.addEventListener?.('voiceschanged', pickVoice); }

    // Her voice, from the platform, one checked sentence at a time, in order.
    const player = new Audio();
    let saying: Promise<void> = Promise.resolve();
    let spell = 0;
    function hush() {
      spell += 1;
      saying = Promise.resolve();
      try { player.pause(); } catch { /* nothing playing */ }
      try { synth?.cancel(); } catch { /* nothing said */ }
    }
    async function clip(text: string): Promise<string | null> {
      if (!isLive || !api) return null;
      try {
        const r = await fetch(`${api}/concierge/pi/speech`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Session-Id': sessionId() }, body: JSON.stringify({ text }) });
        return r.ok ? URL.createObjectURL(await r.blob()) : null;
      } catch { return null; }
    }
    const playClip = (url: string) => new Promise<void>((done) => {
      const end = () => { player.removeEventListener('ended', end); player.removeEventListener('error', end); player.removeEventListener('pause', end); URL.revokeObjectURL(url); done(); };
      player.addEventListener('ended', end); player.addEventListener('error', end); player.addEventListener('pause', end);
      player.src = url; player.play().catch(end);
    });
    const deviceSay = (text: string) => new Promise<void>((done) => {
      if (!synth) { done(); return; }
      const u = new SpeechSynthesisUtterance(text);
      if (herVoice) { u.voice = herVoice; u.lang = herVoice.lang; } else u.lang = 'en-AU';
      u.rate = 1.03; u.pitch = 1.05;
      const timer = window.setTimeout(done, Math.max(2500, text.length * 95));
      u.onend = u.onerror = () => { window.clearTimeout(timer); done(); };
      try { synth.speak(u); } catch { window.clearTimeout(timer); done(); }
    });
    function speak(raw: string) {
      const text = raw.trim();
      // A guide-only session sends nothing, so it never speaks. Only a live one does.
      if (!isLive || !speakOn || !text) return;
      const mine = spell;
      const ready = clip(text.slice(0, 420));
      saying = saying.then(async () => {
        if (mine !== spell) return;
        const url = await ready;
        if (mine !== spell) { if (url) URL.revokeObjectURL(url); return; }
        if (url) await playClip(url); else await deviceSay(text);
      });
    }
    function showSpeak() {
      speakBtn.setAttribute('aria-pressed', String(speakOn));
      speakBtn.setAttribute('aria-label', speakOn ? 'Stop PI reading her replies aloud' : 'Have PI read her replies aloud');
    }
    function setSpeak(on: boolean, how: string) {
      if (on === speakOn) return;
      speakOn = on;
      store.set(localStorage, SPEAK, on ? 'on' : 'off');
      if (!on) hush();
      // Phones only let a page speak or play after a tap: an empty line and silence, played now, open the way.
      else { try { synth?.speak(new SpeechSynthesisUtterance(' ')); } catch { /* no voice */ } try { player.src = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA='; player.play().catch(() => {}); } catch { /* no player */ } }
      showSpeak();
      track('ask_voice', { action: on ? 'speak_on' : 'speak_off', variant: how });
    }
    speakBtn.addEventListener('click', () => setSpeak(!speakOn, 'tap'));

    let hearing: any = null;
    function stopHearing() { try { hearing?.stop(); } catch { /* already stopped */ } }
    function listen() {
      if (!Recognition || !isLive) return;
      if (hearing) { stopHearing(); return; }
      hush();
      if (synth || api) setSpeak(true, 'mic');
      const r = new Recognition();
      r.lang = 'en-AU'; r.interimResults = true; r.maxAlternatives = 1;
      let heard = ''; const was = input.placeholder;
      r.onstart = () => { hearing = r; micBtn.setAttribute('aria-pressed', 'true'); input.placeholder = 'Listening\u2026'; };
      r.onresult = (e: any) => { heard = Array.from(e.results as ArrayLike<any>).map((res: any) => res[0]?.transcript || '').join(' ').replace(/\s+/g, ' ').trim(); input.value = heard.slice(0, 500); autoGrow(); };
      r.onerror = (e: any) => { if (e?.error === 'not-allowed' || e?.error === 'service-not-allowed') { input.placeholder = 'The microphone is blocked for this site. Type instead.'; track('ask_voice', { action: 'blocked' }); window.setTimeout(() => { input.placeholder = was; }, 5000); } };
      r.onend = () => { hearing = null; micBtn.setAttribute('aria-pressed', 'false'); if (input.placeholder === 'Listening\u2026') input.placeholder = was; if (heard.length >= 2) { track('ask_voice', { action: 'mic' }); ask(heard); } };
      try { r.start(); } catch { hearing = null; }
    }
    micBtn.addEventListener('click', listen);

    // Go Live: a session steps up from guide-only to a live conversation. She
    // answers in full, talks back in her own voice, and takes the microphone;
    // her messages now go to the platform. Guide-only stays everyone's default.
    const liveReady = root.dataset.liveReady === 'on';
    function applyLive() {
      liveBtn.hidden = !liveReady;
      if (!liveReady) { voiceOn = BUILD.voice; composeOn = BUILD.voice && BUILD.compose; talkOn = BUILD.voice && BUILD.talk; speechOn = BUILD.speech; root.dataset.live = 'off'; speakBtn.hidden = true; micBtn.hidden = true; if (liveNote) liveNote.hidden = true; return; }
      voiceOn = isLive || BUILD.voice;
      composeOn = voiceOn && (isLive || BUILD.compose);
      talkOn = voiceOn && (isLive || BUILD.talk);
      speechOn = isLive || BUILD.speech;
      root.dataset.live = isLive ? 'on' : 'off';
      liveBtn.setAttribute('aria-pressed', String(isLive));
      const label = liveBtn.querySelector('.pi-chat__live-label');
      if (label) label.textContent = isLive ? 'Live' : 'Go Live';
      liveBtn.title = isLive ? 'End the live conversation' : 'Talk to PI live';
      speakBtn.hidden = !(isLive && (synth || api));
      micBtn.hidden = !(isLive && Recognition);
      if (liveNote) { liveNote.hidden = !isLive; liveNote.textContent = isLive ? 'You\u2019re live \u2014 talking to PI. Press Live again to step back.' : ''; }
      if (fine) fine.textContent = isLive ? FINE_LIVE : fineGuide;
    }
    function goLive() {
      if (isLive) { endLive(); return; }
      isLive = true;
      applyLive();
      pickVoice();
      setSpeak(true, 'live');
      track('ask_voice', { action: 'live_on' });
      input.focus();
    }
    function endLive() {
      isLive = false;
      hush(); stopHearing();
      speakOn = false; showSpeak();
      applyLive();
      pickVoice();
      track('ask_voice', { action: 'live_off' });
    }
    if (liveReady) liveBtn.addEventListener('click', goLive);
    applyLive();

    /* ---------- asking ---------- */

    async function ask(raw: string) {
      const q = raw.trim().slice(0, 500);
      if (q.length < 2) return;
      open(false);
      hush();
      stopHearing();
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;
      input.value = '';
      autoGrow();
      const questionTurn: Turn = { role: 'you', text: q };
      // Until routing finishes this question could be a memory-only discussion.
      ephemeral.add(questionTurn);
      turns.push(questionTurn);
      render();
      log.lastElementChild?.classList.add('is-new');
      const memo = memoryReply(q);
      if (memo) { ephemeral.delete(questionTurn); say(memo, ['Plan my day', 'Surprise me']); return; }
      // A message that is only about how she talks changes the dial and is answered by her own line.
      const cue: Dial | null = SAY_PI.test(q) ? 'pi' : SAY_FULL.test(q.trim()) && !engine?.pi?.strikes ? 'full' : SAY_STRAIGHT.test(q) ? 'straight' : null;
      if (cue) {
        setDial(cue, 'said');
        if (q.trim().split(/\s+/).length <= 6) { ephemeral.delete(questionTurn); say(DIAL_LINE[cue]); return; }
      }

      const live = el('li', 'pi-msg pi-msg--pi is-live');
      const prose = el('div', 'pi-msg__prose');
      const status = el('p', 'pi-msg__status', THINKING[0]);
      status.setAttribute('role', 'status');
      prose.append(status);
      live.append(byline(), prose);
      log.append(live);
      scrollToMsg(live);
      send.disabled = true;
      let step = 0;
      const thinking = window.setInterval(() => {
        if (!live.isConnected) return;
        step = Math.min(step + 1, THINKING.length - 1);
        status.textContent = THINKING[step];
      }, 1800);

      try {
        const at = requestedStopSwap(q);
        if (at !== null) {
          ephemeral.delete(questionTurn);
          const plan = latestPlan();
          const before = plan?.plan?.stops[at];
          if (before?.swappable) await swap(at, signal);
          if (signal.aborted) { live.remove(); return; }
          live.remove();
          const after = latestPlan()?.plan?.stops[at];
          if (!plan) say('Which day would you like to plan first?', ['Plan my day']);
          else if (!before) say(`This plan has ${plan.plan!.stops.length} stops. Which one would you like to swap?`);
          else if (after && before.card.href !== after.card.href) say(`That stop is now ${after.card.title}. The updated plan is above.`);
          else say('I don’t have another guide-backed option for that stop in this plan.');
          return;
        }
        const index = await loadAskIndex();
        const previous = [...turns].reverse().find((turn): turn is PiTurn => turn.role === 'pi');
        const previousOptions = previous?.kind === 'sources' ? previous.links : previous?.places;
        const context = { pagePath: location.pathname, previousOptions: previousOptions?.map((item) => item.href) || [] };
        let result = matchGuides(index, q, engine, context);
        if (!result) throw new Error(READER_ERROR);

        if (isGeneralDiscussion(index, q, result.reply, previous?.kind)) {
          const response = talkOn ? await voice<{ answer?: string }>('discuss', { question: q, history: recent(3, true) }, signal) : null;
          if (signal.aborted) { live.remove(); return; }
          const text = response?.answer || 'I can’t answer that conversation turn right now. You can try again or ask me about the Peninsula guides.';
          const turn: PiTurn = { role: 'pi', text, places: [], next: [], kind: 'discussion' };
          ephemeral.add(turn);
          turns.push(turn);
          // The local planner is suspended while the reader changes subjects.
          save();
          const node = piNode(turn);
          live.replaceWith(node);
          scrollToMsg(node);
          return;
        }
        ephemeral.delete(questionTurn);
        save();

        // Conversation first. For an ordinary message she replies as herself,
        // from the thread and the guide pages the site judges relevant: what the
        // matcher found, what was on screen a moment ago, and pages whose words
        // overlap what the reader has been saying. Her reply is checked on the
        // platform; here it is only shown. If none comes back in time, the
        // matcher's answer stands and the older note and front desk take over.
        let spoken: { say: string; picks: string[]; next: string[]; why: Record<string, string> } | null = null;
        // Her reply was already on screen as it arrived, so it does not ease in again.
        let streamed = false;
        const thinPlan = result.reply.kind === 'none' && result.reply.mood;
        // Event answers must keep the calendar matcher’s dated, directly linked results.
        const calendarReply = result.state?.filter?.kinds?.includes('event')
          || result.reply.cards.some((card: Card) => card.href.startsWith('/whats-on/'));
        if (!calendarReply && talkOn && !result.reply.plan && !thinPlan && TALKABLE.has(result.reply.kind)) {
          const waited = new AbortController();
          const timer = window.setTimeout(() => waited.abort(), TALK_WAIT_MS);
          const said = turns.filter((t) => t.role === 'you' && !ephemeral.has(t)).slice(0, -1).map((t) => t.text);
          const pages = talkPages(index, q, said, result.reply, shownBefore(), context) as string[];
          // Her words appear in the waiting bubble as each sentence arrives.
          let saying: HTMLElement | null = null;
          spoken = await streamTalk({ message: q, history: recent(8), pages, onPage: location.pathname, followUp: !hasSubject(index, q, context), dial }, AbortSignal.any([signal, waited.signal]), (text, first) => {
            if (first) {
              window.clearTimeout(timer);
              window.clearInterval(thinking);
              saying = el('p', 'pi-say');
              prose.replaceChildren(saying);
              live.classList.remove('is-live');
              live.classList.add('is-saying');
            }
            // The thread already sits at the reader's question, so her words fill in below it.
            saying?.append(el('span', 'pi-say__s', `${text} `));
            speak(text);
          });
          window.clearTimeout(timer);
          if (signal.aborted) { live.remove(); return; }
          streamed = Boolean(spoken);
        }

        // The matcher did not follow. Ask the front desk what was meant, then
        // run the matcher again on its reading. What it says is PI talking; it
        // never carries a fact about a place.
        let aside: string | null = null;
        if (!calendarReply && !spoken && voiceOn && !result.reply.mood && (result.reply.kind === 'none' || result.reply.kind === 'help')) {
          const desk = await voice<{ say: string | null; rewrite: string | null }>('front-desk', { question: q, history: recent() }, signal);
          if (signal.aborted) { live.remove(); return; }
          if (typeof desk?.rewrite === 'string' && desk.rewrite.trim()) {
            const again = matchGuides(index, desk.rewrite, engine?.pi ? { pi: engine.pi } : null, context);
            if (again && again.reply.cards.length) result = again;
          }
          aside = typeof desk?.say === 'string' && desk.say.trim() ? desk.say.trim().slice(0, 400) : null;
        }

        // A plan: let her choose among the pages the site found for each part
        // of the day and write her lines. What comes back is checked again in
        // applyCompose; if it is late, missing or unusable the plan is shown as
        // the site built it, with her authored line.
        const asking = composeOn && result.reply.plan ? composeRequest(result.state) : null;
        if (asking) {
          const waited = new AbortController();
          const timer = window.setTimeout(() => waited.abort(), COMPOSE_WAIT_MS);
          const composed = await voice<{ picks: string[] | null; opening: string | null; lines: Record<string, string> }>('compose', { question: q, title: asking.title, slots: asking.slots, history: recent() }, AbortSignal.any([signal, waited.signal]));
          window.clearTimeout(timer);
          if (signal.aborted) { live.remove(); return; }
          const applied = composed ? applyCompose(index, result.state, asking, composed) as { state: unknown; plan: Plan; opening: string | null } | null : null;
          if (applied) {
            result = { state: applied.state, reply: { ...result.reply, plan: applied.plan, cards: applied.plan.stops.map((stop) => stop.card), lead: applied.opening || result.reply.lead } };
          }
        }

        const hadPlan = Boolean(engine?.pi?.plan);
        engine = result.state;
        const reply = result.reply;
        // In conversation the tiles are the places she named, in her order; a
        // reply that names none shows none.
        // One exception: the reader named a town or a kind of place the guides do have
        // ("a great beach in Sorrento") and she named nothing, usually because
        // her sentences about the places did not pass their check. Then the
        // guides' own best matches go under her words, so the question is
        // still answered.
        const unanswered = Boolean(spoken) && !declines(spoken!.say) && !cardsFor(index, spoken!.picks).length && ['results', 'named', 'place'].includes(reply.kind) && reply.cards.length > 0 && hasSubject(index, q, { pagePath: location.pathname });
        const places = spoken && !unanswered ? toPlaces(cardsFor(index, spoken.picks) as Card[]) : toPlaces(unanswered ? reply.cards.slice(0, 3) : reply.cards);
        // Her own line on a pick, where one passed the check on the platform.
        if (spoken) for (const place of places) { const line = spoken.why[place.href]; if (typeof line === 'string' && line.trim()) place.note = line.trim().slice(0, 260); }
        const turn: PiTurn = {
          role: 'pi',
          text: spoken ? spoken.say : places.length ? reply.lead : aside || reply.lead,
          places,
          next: spoken ? (spoken.next.length ? spoken.next : places.length ? reply.chips : []) : reply.chips,
          // Her own reply already says what it has to; the small print is only the source line.
          notes: spoken ? (places.length ? reply.notes.slice(-1) : []) : reply.notes,
          links: spoken ? (places.length ? reply.links : []) : reply.links,
          kind: spoken ? 'talk' : reply.kind,
          mood: reply.mood,
          aside: reply.aside || null,
          plan: reply.plan,
          offer: reply.offer,
        };
        // Three Strikes: one place, stamped as her call, with the strikes under it.
        if (reply.kind === 'strike' && reply.strike) {
          turn.strike = reply.strike;
          // An offer is a compact tile, so the reader's move stays on screen. Her stamp goes on only when her call stands.
          if (places.length && (reply.strike.final || reply.strike.over)) turn.call = places[0].href;
          if (reply.strike.learned) learn(reply.strike.learned);
          track('ask_game', { variant: 'strikes', action: reply.strike.over ? (reply.strike.forced ? 'forced' : 'accepted') : reply.strike.offers === 1 ? 'start' : 'rejected', value: reply.strike.strikes });
          // A second rejection in a row, or being asked to surprise them, is what catches her out.
          if (!reply.strike.over && (reply.strike.strikes === 2 || reply.strike.offers === 1)) gesture('catch');
        }
        // The Tie-breaker: the winner is her call, and the tally sits under it.
        if (reply.kind === 'vote' && reply.vote) {
          turn.vote = reply.vote;
          if (reply.vote.over && places.length) turn.call = places[0].href;
          if (reply.vote.over || reply.vote.total === 0) track('ask_game', { variant: 'tiebreak', action: reply.vote.over ? (reply.vote.tied ? 'tied' : 'counted') : 'start', value: reply.vote.total });
          // Being asked to referee is the other thing that catches her out.
          if (!reply.vote.over && reply.vote.total === 0) gesture('catch');
        }
        // The dial is found where it is wanted: a way to get less after a long reply, more after a short one.
        if (spoken && places.length && turn.next.length < 3) {
          const count = spoken.say.split(/(?<=[.!?])\s+/).length;
          if (dial !== 'straight' && count >= 5) turn.next = [...turn.next.slice(0, 2), 'Shorter'];
          else if (dial !== 'full' && count <= 2) turn.next = [...turn.next.slice(0, 2), 'Go on'];
        }

        // Her words come first, then the picks. So for a list of picks the
        // answer is held until her checked note is back, or until the wait is
        // up, and then everything arrives in order. A note that comes later
        // than that is dropped rather than rewriting text a reader is already
        // past. Plans, critiques and refusals keep her own authored lines.
        let voiced = Boolean(spoken);
        if (spoken && places.length > 1 && personaOn) turn.call = places[0].href;
        if (!calendarReply && !spoken && voiceOn && places.length && ['results', 'named', 'place', 'nightlife', 'with'].includes(reply.kind)) {
          const waited = new AbortController();
          const timer = window.setTimeout(() => waited.abort(), NOTE_WAIT_MS);
          const said = await voice<{ say: string | null }>('voice', { question: q, cards: places.map((place) => place.href), history: recent() }, AbortSignal.any([signal, waited.signal]));
          window.clearTimeout(timer);
          if (signal.aborted) { live.remove(); return; }
          if (typeof said?.say === 'string' && said.say.trim()) {
            turn.text = said.say.trim().slice(0, 900);
            voiced = true;
            // Her call is the first of the picks her note names.
            const first = places.map((place) => ({ place, at: turn.text.indexOf(place.title) })).filter((hit) => hit.at >= 0).sort((a, b) => a.at - b.at)[0];
            if (personaOn && first && places.length > 1) turn.call = first.place.href;
          }
        }

        turns.push(turn);
        save();
        // Her call is what she asks about next visit.
        const calledPlace = turn.call ? places.find((place) => place.href === turn.call) : null;
        if (calledPlace) learn({ last: { u: calledPlace.href, t: calledPlace.title } });
        // Only the plan the engine holds can be swapped. When that changes,
        // redraw the thread so an older plan's buttons go.
        const redraw = Boolean(reply.plan) || (hadPlan && !engine?.pi?.plan);
        if (redraw) render();
        if (reply.plan) track('ask_plan', { variant: String(reply.plan.stops.length), action: 'shown' });

        const node = redraw ? (log.lastElementChild as HTMLElement) : piNode(turn, q);
        node.classList.add('is-arriving');
        // Her hat dips as she makes the call.
        // In the game an offer is not yet a call: she nods only when her call stands.
        if (turn.call && !turn.strike?.over) gesture('tilt');
        if (streamed) node.classList.add('is-streamed');
        if (voiced) node.querySelector('.pi-msg__prose')?.classList.add('is-voiced');
        // A reply that did not arrive sentence by sentence is read once it is on screen.
        if (!streamed) speak(turn.text);
        if (redraw) live.remove(); else live.replaceWith(node);
        if (!streamed) scrollToMsg(node);
      } catch (err) {
        if ((err as Error).name === 'AbortError') { live.remove(); return; }
        const turn: Turn = { role: 'pi', text: READER_ERROR, places: [], next: [], error: true };
        turns.push(turn);
        save();
        live.replaceWith(piNode(turn));
      } finally {
        window.clearInterval(thinking);
        send.disabled = false;
        applyChrome();
      }
    }

    function autoGrow() {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 132)}px`;
    }

    /* ---------- wiring (each listener bound once; this script runs once) ---------- */

    launch.addEventListener('click', () => open());
    document.getElementById('pi-chat-min')!.addEventListener('click', () => minimise());
    document.getElementById('pi-chat-new')!.addEventListener('click', () => {
      try { window.speechSynthesis?.cancel(); } catch { /* nothing was being said */ }
      hush(); stopHearing();
      controller?.abort();
      turns = [];
      engine = null;
      store.del(sessionStorage, HISTORY);
      store.del(sessionStorage, ENGINE);
      render();
      input.focus();
    });
    modeBtn.addEventListener('click', () => setMode(root.dataset.mode === 'dock' ? 'float' : 'dock'));
    form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
    input.addEventListener('input', autoGrow);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); ask(input.value); }
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.stopPropagation(); minimise(); return; }
      if (e.key !== 'Tab' || DESKTOP.matches) return;
      const focusable = [...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])')]
        .filter((el) => !el.hidden && el.getClientRects().length > 0);
      if (!focusable.length) { e.preventDefault(); input.focus(); return; }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    async function swap(at: number, signal?: AbortSignal) {
      const turn = latestPlan();
      if (!turn) return;
      const swapped = swapStop(await loadAskIndex(), engine, at) as { state: unknown; plan: Plan; remark: string } | null;
      if (!swapped || signal?.aborted || latestPlan() !== turn) return;
      engine = swapped.state;
      turn.plan = swapped.plan;
      turn.places = toPlaces(swapped.plan.stops.map((stop) => stop.card));
      turn.aside = swapped.remark;
      save();
      const old = log.querySelector('.pi-note[data-pi-live]');
      const fresh = notebook(turn, true);
      old?.replaceWith(fresh);
      (fresh.querySelector<HTMLElement>(`[data-pi-swap="${at}"]`) || fresh.querySelector<HTMLElement>('.pi-note__name'))?.focus({ preventScroll: true });
      track('ask_plan', { action: 'swap', position: at + 1 });
    }

    async function share(button: HTMLElement) {
      const note = button.closest('.pi-note');
      const turn = (turns.filter((t) => t.role === 'pi' && t.plan) as PiTurn[])[[...log.querySelectorAll('.pi-note')].indexOf(note as Element)];
      const status = note?.querySelector<HTMLElement>('.pi-note__status');
      if (!turn?.plan?.trip || !status) return;
      const url = new URL(turn.plan.trip, location.origin).href;
      const text = [turn.plan.title, ...turn.plan.stops.map((stop, i) => `${i + 1}. ${stop.card.title}${stop.card.meta ? ` (${stop.card.meta})` : ''}`), 'From PI at Peninsula Insider. Check hours and bookings before you go.'].join('\n');
      track('ask_plan', { action: 'share' });
      try {
        if (navigator.share) { await navigator.share({ title: turn.plan.title, text, url }); status.textContent = ''; return; }
        await navigator.clipboard.writeText(`${text}\n${url}`);
        status.textContent = 'Copied. Send it to whoever is always late.';
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
        // No share sheet and no clipboard: show the link so it can be copied by hand.
        status.textContent = '';
        const link = el('a', '', url) as HTMLAnchorElement;
        link.href = url;
        status.append('Copy this link: ', link);
      }
    }

    function giveFeedback(button: HTMLElement) {
      const wrap = button.closest<HTMLElement>('.pi-msg__fb');
      const node = button.closest('.pi-msg--pi');
      const turn = turns.filter((t) => t.role === 'pi')[[...log.querySelectorAll('.pi-msg--pi')].indexOf(node as Element)] as PiTurn | undefined;
      if (!wrap || !turn) return;
      if (button.dataset.piFb === 'open') {
        const group = el('div', 'pi-msg__fb-group');
        group.setAttribute('role', 'group');
        group.setAttribute('aria-label', 'What went wrong?');
        for (const [key, label] of FEEDBACK) {
          const b = el('button', 'pi-chat__chip', label) as HTMLButtonElement;
          b.type = 'button';
          b.dataset.piFb = key;
          group.append(b);
        }
        wrap.replaceChildren(group);
        group.querySelector<HTMLElement>('button')?.focus({ preventScroll: true });
        return;
      }
      // The button pressed and the kind of reply. Never the question or the answer.
      track('ask_feedback', { action: button.dataset.piFb, variant: turn.kind || 'reply' });
      turn.fb = true;
      save();
      const done = el('p', '', 'Noted. If you allow analytics, the editors see which button you pressed and nothing you typed.');
      done.setAttribute('role', 'status');
      wrap.replaceChildren(done);
    }

    panel.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const chip = target.closest<HTMLElement>('[data-pi-q]');
      if (chip) {
        const said = chip.dataset.piQ || '';
        if (said === 'Shorter' || said === 'Go on') {
          setDial(said === 'Shorter' ? 'straight' : 'full', 'chip');
          const last = [...turns].reverse().find((t) => t.role === 'you');
          if (last) { ask(last.text); return; }
        }
        ask(said);
        return;
      }
      const swapper = target.closest<HTMLElement>('[data-pi-swap]');
      if (swapper) { void swap(Number(swapper.dataset.piSwap)); return; }
      const sharer = target.closest<HTMLElement>('[data-pi-share]');
      if (sharer) { void share(sharer); return; }
      const fb = target.closest<HTMLElement>('[data-pi-fb]');
      if (fb) giveFeedback(fb);
    });
    DESKTOP.addEventListener('change', applyChrome);
    WIDE.addEventListener('change', applyChrome);
    window.addEventListener('scroll', () => { if (!pinFrame) pinFrame = requestAnimationFrame(placeUnderMasthead); }, { passive: true });
    window.addEventListener('resize', placeUnderMasthead, { passive: true });

    // Hand-offs from the rest of the site: links to /ask/?q=..., Ask PI
    // forms, and the search overlay's "Ask PI" row. Modified clicks and the
    // chat's own "Open as a page" link still navigate. Both listeners capture,
    // because Astro's ClientRouter claims same-site links and forms on the way up.
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!a) return;
      // Close before ClientRouter navigation so the persisted chat does not cover
      // the destination. Keep the conversation and leave normal link behaviour alone.
      if (panel.contains(a)) {
        minimise(false);
        return;
      }
      if (a.dataset.piPage || a.target === '_blank') return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin || url.pathname !== '/ask/') return;
      e.preventDefault();
      opener = a;
      (window as any).__piSearchClose?.();
      const q = url.searchParams.get('q');
      if (q) ask(q);
      else if (a.hasAttribute('data-pi-popup')) popUpFrom(a);
      else open();
    }, true); // capture: run before the page router claims the link
    document.addEventListener('submit', (e) => {
      const f = e.target as HTMLFormElement;
      if (f === form || !f.matches('form[action="/ask/"]')) return;
      const q = (new FormData(f).get('q') || '').toString();
      if (q.trim().length < 3) return;
      e.preventDefault();
      ask(q);
    }, true); // capture, as above

    // A navigation snapshot can sit above the persisted chat and swallow taps
    // and swipes even after the destination is visible. Chat recommendations
    // need an immediately usable destination, not a decorative page fade.
    // Use the actual navigation source, so cancelled/external links cannot
    // accidentally disable a later, unrelated transition.
    document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
      if (event.sourceElement && panel.contains(event.sourceElement)) {
        event.viewTransition.skipTransition();
      }
    });

    // The router swaps <html> attributes on navigation; restore ours.
    document.addEventListener('astro:after-swap', applyChrome);
    // /ask/ is her own page: the chat opens there, and a question in the address is asked once.
    let arrived = '';
    function arrive() {
      if (!onAskPage() || arrived === location.href) return;
      arrived = location.href;
      const q = (new URLSearchParams(location.search).get('q') || '').trim();
      const asked = [...turns].reverse().find((turn) => turn.role === 'you');
      if (q.length >= 3 && asked?.text !== q.slice(0, 500)) ask(q);
      else open();
    }
    document.addEventListener('astro:page-load', () => { applyChrome(); offerHere(); arrive(); });

    (window as any).PIChat = { open, ask, minimise };

    setMode(store.get(localStorage, MODE) || 'dock');
    render();
    if (onAskPage()) arrive();
    else if (store.get(sessionStorage, STATE) === 'open') open(false);
  }
</script>

<style is:global>
  /* Every selector is under .pi-chat or html.pi-chat-*: messages are made by
     script, so Astro's scoped attribute never reaches them. */
  .pi-chat {
    /* One curve for everything that arrives: quick off the mark, a long soft landing. */
    --pi-ease: cubic-bezier(.16, 1, .3, 1);
    --pi-w: 25rem;
    --pi-cream: #F4EADB;
    --pi-terracotta: #B4532F;
    position: relative;
    z-index: calc(var(--z-chrome) + 100);
  }
  .pi-chat[hidden] { display: none; }
  .pi-chat__sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Launcher */
  .pi-chat__launch {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; gap: var(--space-3);
    min-height: 56px; padding: 6px var(--space-5) 6px 6px;
    background: var(--white); color: var(--text);
    border: 1px solid var(--border); border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px -12px rgba(20, 32, 42, .35), 0 2px 6px -2px rgba(20, 32, 42, .12);
    cursor: pointer; text-align: left;
    transition: transform var(--dur-fast) var(--ease-enter), box-shadow var(--dur-fast) var(--ease-enter), opacity var(--dur-fast);
  }
  .pi-chat__launch:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -14px rgba(20, 32, 42, .42), 0 2px 6px -2px rgba(20, 32, 42, .12); }
  .pi-chat__launch:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .pi-chat[data-state="open"] .pi-chat__launch,
  html.pi-hero-ask .pi-chat__launch { opacity: 0; pointer-events: none; transform: translateY(8px); visibility: hidden; transition: opacity var(--dur-fast), transform var(--dur-fast), visibility 0s linear var(--dur-fast); }
  .pi-chat__launch-face { width: 44px; height: 44px; border-radius: 50%; background: var(--pi-cream); }
  .pi-chat__launch-text { display: grid; line-height: 1.15; }
  .pi-chat__launch-name { font: var(--fw-display) var(--fs-500)/1.1 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-chat__launch-sub { color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-chat__launch-dot {
    position: absolute; top: 6px; left: 40px; width: 10px; height: 10px; border-radius: 50%;
    background: var(--pi-terracotta); box-shadow: 0 0 0 2px var(--white);
    opacity: 0; transform: scale(.4); transition: opacity var(--dur-fast), transform var(--dur-fast);
  }
  .pi-chat__launch.has-thread .pi-chat__launch-dot { opacity: 1; transform: none; }
  /* 2026-11-16: Ask PI lives in the masthead on every page, so the floating launcher
     no longer sits over page text. The button stays in the DOM for the panel's own
     state (aria-expanded, unread dot) and as the fallback focus target. */
  .pi-chat__launch { display: none; }
  /* Phones: the launcher shrinks to her portrait so it never sits over a page's text.
     The name stays in the accessibility tree. */
  @media (max-width: 47.99em) {
    .pi-chat__launch { padding: 5px; gap: 0; }
    .pi-chat__launch-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }

  /* Panel: phone sheet by default */
  .pi-chat__panel {
    position: fixed; inset: 0; display: flex; flex-direction: column;
    background: var(--white); color: var(--text);
    opacity: 0; transform: translateY(16px);
    /* Leaving is quicker than arriving. The surface is solid almost at once, so the
       page behind never shows through her words; then it settles into place. */
    transition: opacity 120ms linear, transform 160ms cubic-bezier(.4, 0, 1, 1);
  }
  .pi-chat.is-in .pi-chat__panel { opacity: 1; transform: none; transition: opacity 110ms linear, transform 340ms var(--pi-ease); }
  .pi-chat__panel[hidden] { display: none; }
  /* A closing sheet must stop swallowing taps before its exit animation ends. */
  .pi-chat[data-state="closed"] .pi-chat__panel { pointer-events: none; }
  html.pi-chat-sheet { overflow: hidden; }

  /* Desktop. Docked (80em and up): a sidebar under the masthead; the page content moves
     aside and the masthead keeps the full width. Below 80em there isn't room for both,
     so "dock" opens as the floating card. */
  @media (min-width: 80em) {
    .pi-chat[data-mode="dock"] .pi-chat__panel {
      inset: var(--pi-top, 0px) 0 0 auto; width: var(--pi-w);
      border-left: 1px solid var(--border);
      transform: translateX(16px);
    }
    html.pi-chat-docked .pi-chat { z-index: calc(var(--z-chrome) - 1); }
    html.pi-chat-docked body { margin-right: var(--pi-w, 25rem); }
    html.pi-chat-docked [data-v5-masthead] { margin-right: calc(-1 * var(--pi-w, 25rem)); }
  }
  @media (min-width: 64em) {
    .pi-chat[data-mode="float"] .pi-chat__panel,
    .pi-chat[data-mode="dock"] .pi-chat__panel:not(.is-docked) {
      inset: auto 24px 24px auto; width: var(--pi-w); height: min(44rem, calc(100dvh - 48px));
      border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden;
      box-shadow: 0 30px 60px -24px rgba(20, 32, 42, .38), 0 4px 12px -4px rgba(20, 32, 42, .12);
      transform: translateY(10px) scale(.97); transform-origin: bottom right;
    }
    /* Opened from the cover badge: a pop-up dialogue that grows from the badge's corner. */
    .pi-chat[data-anchor="badge"] .pi-chat__panel {
      inset: var(--pi-pop-top, 24px) var(--pi-pop-right, 24px) auto auto;
      height: min(40rem, calc(100dvh - var(--pi-pop-top, 24px) - 24px));
      transform: translateY(-8px) scale(.97); transform-origin: top right;
    }
    .pi-chat[data-anchor="badge"] .pi-chat__portrait { width: 120px; height: 120px; margin-bottom: var(--space-3); }
    .pi-chat[data-anchor="badge"] .pi-chat__hello { padding-top: 0; }
    .pi-chat.is-in .pi-chat__panel { transform: none; }
  }

  /* Header */
  .pi-chat__head {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    padding-top: max(var(--space-3), env(safe-area-inset-top));
    border-bottom: 1px solid var(--border);
  }
  .pi-chat__head-face { width: 44px; height: 44px; border-radius: 50%; background: var(--pi-cream); flex: none; }

  /* ── Her figure, in parts ──
     The hat illustration cut into three layers from the approved mark (scripts/build-pi-layers.mjs):
     shoulder, strap, hat, hair. Stacked they are the mark. She looks up, hat then hair, the first
     time the panel opens on a page. After that she is still, except for two gestures tied to the
     conversation (below). Nothing moves on a timer. The small mark steps aside while the large
     portrait is on show. */
  .pi-fig { position: relative; display: block; flex: none; }
  .pi-fig__art, .pi-fig__go, .pi-fig__part { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pi-fig--round { overflow: hidden; }
  /* The round crop: the same circle the avatar files use, 0.445 of the canvas. */
  .pi-fig--round .pi-fig__art { inset: -6.18%; width: auto; height: auto; }
  .pi-fig--disc::before { content: ''; position: absolute; inset: 5.5%; border-radius: 50%; background: #F4EAD3; }
  .pi-fig__hair { transform-origin: 37% 60%; }
  .pi-fig__hat { transform-origin: 48% 52%; }
  .pi-fig__go--hair { transform-origin: 37% 60%; }
  .pi-fig__strap { transform-origin: 71% 70%; }
  .pi-chat.is-in.is-greeting .pi-chat__portrait .pi-fig__go--strap { transform-origin: 48% 52%; animation: pi-hat-in 700ms var(--pi-ease) both; }

  /* ── Two gestures, and only two ──
     Motion here is punctuation: she moves when something happened in the conversation and at no
     other time. Nothing loops. Both play on the small mark in the header, once, and are over in
     under a second.
     The tilt: the brim dips toward the reader as she makes a call. Fast in, slower back, one degree past rest.
     The catch: the wind gets under the brim, the strap pulls taut, she seats the hat again. Rare:
     at most once a conversation, and never on two visits running. */
  @keyframes pi-tilt-hat { 0% { transform: none; } 25% { transform: rotate(6deg); } 82% { transform: rotate(-1deg); } 100% { transform: none; } }
  @keyframes pi-tilt-hair { 0%, 12% { transform: none; } 38% { transform: rotate(-3.5deg); } 88% { transform: rotate(.6deg); } 100% { transform: none; } }
  @keyframes pi-tilt-strap { 0% { transform: none; } 25% { transform: rotate(3deg); } 82% { transform: rotate(-.5deg); } 100% { transform: none; } }
  .pi-chat[data-gesture="tilt"] .pi-chat__head-face .pi-fig__hat { animation: pi-tilt-hat 540ms cubic-bezier(.3, .7, .3, 1) both; }
  .pi-chat[data-gesture="tilt"] .pi-chat__head-face .pi-fig__hair { animation: pi-tilt-hair 620ms cubic-bezier(.3, .7, .3, 1) both; }
  .pi-chat[data-gesture="tilt"] .pi-chat__head-face .pi-fig__strap { animation: pi-tilt-strap 540ms cubic-bezier(.3, .7, .3, 1) both; }
  @keyframes pi-catch-hat { 0% { transform: none; } 34% { transform: translateY(-8%) rotate(-4deg); } 53% { transform: translateY(-8%) rotate(-4deg); } 90% { transform: translateY(.8%) rotate(.5deg); } 100% { transform: none; } }
  @keyframes pi-catch-strap { 0% { transform: none; } 34% { transform: scaleY(1.2) skewX(-3deg); } 53% { transform: scaleY(1.2) skewX(-3deg); } 90% { transform: scaleY(.98); } 100% { transform: none; } }
  @keyframes pi-catch-hair { 0% { transform: none; } 30% { transform: rotate(11deg) skewX(-5deg); } 55% { transform: rotate(9deg) skewX(-4deg); } 82% { transform: rotate(-2.5deg); } 100% { transform: none; } }
  .pi-chat[data-gesture="catch"] .pi-chat__head-face .pi-fig__hat { animation: pi-catch-hat 640ms cubic-bezier(.3, .6, .3, 1) both; }
  .pi-chat[data-gesture="catch"] .pi-chat__head-face .pi-fig__strap { animation: pi-catch-strap 640ms cubic-bezier(.3, .6, .3, 1) both; }
  .pi-chat[data-gesture="catch"] .pi-chat__head-face .pi-fig__hair { animation: pi-catch-hair 1040ms cubic-bezier(.3, .6, .3, 1) both; }

  /* ── The dial: how much of her ── */
  .pi-chat__dial-open { flex: none; width: 44px; height: 44px; padding: 0; border: 0; background: none; border-radius: 50%; cursor: pointer; line-height: 0; }
  .pi-chat__dial-open:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .pi-chat__dial { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--border); background: var(--bg); }
  .pi-chat__dial[hidden] { display: none; }
  .pi-chat__dial-opt { display: grid; gap: 2px; min-height: 44px; padding: var(--space-2); border: 1px solid var(--border-control); border-radius: var(--radius-m); background: transparent; color: var(--text); font: 600 var(--fs-300)/1.2 var(--font-ui); text-align: center; cursor: pointer; }
  .pi-chat__dial-opt span { color: var(--soft); font: 400 var(--fs-200)/1.2 var(--font-ui); }
  .pi-chat__dial-opt[aria-pressed="true"] { border-color: var(--pi-terracotta); background: var(--pi-cream); }
  .pi-chat__dial-opt:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  /* ── Three Strikes ── */
  .pi-strikes { display: flex; align-items: center; gap: var(--space-2); margin: var(--space-3) 0 0; color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-strikes__mark { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--pi-terracotta); }
  .pi-strikes__mark.is-used { background: var(--pi-terracotta); }
  .pi-strikes__score { margin: var(--space-3) 0 0; padding: var(--space-3) var(--space-4); border-radius: var(--radius-m); background: var(--pi-cream); color: var(--text); font: italic 500 var(--fs-300)/1.4 var(--font-ui); }
  .pi-fig__go--hat { transform-origin: 48% 52%; }
  /* One portrait at a time. */
  .pi-chat__head-face { transition: opacity 200ms linear; }
  .pi-chat:has(.pi-chat__hello:not([hidden])) .pi-chat__head-face { opacity: 0; }
  /* The greeting: her hat comes up as you arrive, her hair a moment behind, then the words. */
  @keyframes pi-rise { from { opacity: 0; transform: translateY(6px); } }
  @keyframes pi-hat-in { from { transform: rotate(-6deg) translateY(-2%); } }
  @keyframes pi-hair-in { from { transform: rotate(7deg); } }
  .pi-chat.is-in.is-greeting .pi-chat__hello > * { animation: pi-rise 240ms var(--pi-ease) both; }
  .pi-chat.is-in.is-greeting .pi-chat__hello > :nth-child(2) { animation-delay: 40ms; }
  .pi-chat.is-in.is-greeting .pi-chat__hello > :nth-child(3) { animation-delay: 80ms; }
  .pi-chat.is-in.is-greeting .pi-chat__hello > :nth-child(n+4) { animation-delay: 120ms; }
  .pi-chat.is-in.is-greeting .pi-chat__portrait .pi-fig__go--hat { animation: pi-hat-in 700ms var(--pi-ease) both; }
  .pi-chat.is-in.is-greeting .pi-chat__portrait .pi-fig__go--hair { animation: pi-hair-in 700ms var(--pi-ease) 60ms both; }

  .pi-chat__head-id { flex: 1; min-width: 0; }
  .pi-chat__name { margin: 0; font: var(--fw-display) var(--fs-500)/1.1 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-chat__role { margin: 2px 0 0; color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-chat__tools { display: flex; gap: 2px; }
  .pi-chat__tool {
    display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: var(--radius-s);
    background: transparent; color: var(--soft); cursor: pointer;
  }
  .pi-chat__tool:hover { color: var(--text); background: var(--bg-alt); }
  .pi-chat__tool:focus-visible, .pi-chat__chip:focus-visible, .pi-chat__send:focus-visible,
  .pi-chat a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 79.99em) { .pi-chat .pi-chat__tool--mode { display: none; } }
  .pi-chat[data-mode="dock"] .pi-chat__icon-dock, .pi-chat[data-mode="float"] .pi-chat__icon-float { display: none; }

  /* Thread */
  .pi-chat__thread { flex: 1; min-height: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; padding: var(--space-5) var(--space-4) var(--space-6); }
  .pi-chat__hello { text-align: center; padding: var(--space-4) var(--space-2) 0; }
  .pi-chat__hello[hidden] { display: none; }
  .pi-chat__portrait { display: block; width: 168px; height: 168px; margin: 0 auto var(--space-4); }
  .pi-chat__hello-lead { margin: 0; font: italic var(--fw-display) var(--fs-600)/1.15 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-chat__hello-body { margin: var(--space-2) auto var(--space-5); max-width: 21rem; color: var(--soft); font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); text-wrap: pretty; }
  .pi-chat__hello .pi-chat__chips { justify-content: center; }

  .pi-chat__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .pi-chat__chip {
    max-width: 100%; min-height: 44px; padding: 8px 14px; text-align: left;
    background: var(--white); color: var(--text);
    border: 1px solid var(--border-control); border-radius: var(--radius-pill);
    font: 400 var(--fs-300)/1.3 var(--font-ui); cursor: pointer;
    transition: background var(--dur-fast), border-color var(--dur-fast);
  }
  .pi-chat__chip:hover { background: var(--bg-alt); border-color: var(--text); }

  .pi-chat__log { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .pi-msg { min-width: 0; }
  .pi-msg--you { display: flex; justify-content: flex-end; }
  .pi-msg__bubble {
    margin: 0; max-width: 85%; padding: 10px 14px;
    background: var(--bg-alt); border-radius: 18px 18px 4px 18px;
    font: 400 var(--fs-400)/1.45 var(--font-ui); text-wrap: pretty;
  }
  .pi-msg__by { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-2); }
  .pi-msg__face { width: 28px; height: 28px; border-radius: 50%; background: var(--pi-cream); }
  .pi-msg__name { font: 600 var(--fs-300)/1 var(--font-ui); }
  .pi-msg__prose p { margin: 0 0 var(--space-3); font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); }
  .pi-msg__prose p:last-child { margin-bottom: 0; }
  .pi-msg__inline { color: var(--accent); font-weight: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: .2em; }
  .pi-msg__inline:hover { text-decoration-color: currentColor; }
  /* While she works: one quiet line of words that breathes. Nothing is drawn. */
  .pi-msg.is-live .pi-msg__status { animation: pi-wait 1.8s ease-in-out infinite; }
  .pi-msg__status { color: var(--soft); font-style: italic; }
  .pi-msg__error { color: var(--soft); }

  /* Her picks: a list down the thread, so a phone never has to scroll sideways
     inside a sheet that scrolls up and down. A photograph sits beside the text;
     her call is first, with the photograph across the top. */
  .pi-tiles { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .pi-tile {
    display: grid; grid-template-columns: 5.75rem minmax(0, 1fr); gap: var(--space-3); align-items: start;
    padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-m);
    background: var(--white); color: inherit; text-decoration: none;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .pi-tile--text { grid-template-columns: minmax(0, 1fr); padding: var(--space-3) var(--space-4); }
  .pi-tile__media { display: block; aspect-ratio: 1; border-radius: var(--radius-s); overflow: hidden; background: var(--pi-cream); }
  .pi-tile__media img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 320ms var(--ease-enter), transform var(--dur-med) var(--ease-enter); }
  .pi-tile__media.is-loaded img { opacity: 1; }
  .pi-tile__body { display: grid; gap: 3px; min-width: 0; }
  .pi-tile__section { color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-tile__title { font: var(--fw-display) var(--fs-400)/1.35 var(--font-display); }
  .pi-tile__note { color: var(--text); font: italic 500 var(--fs-300)/1.4 var(--font-ui); }
  .pi-tile__fact { color: var(--text); font: 500 var(--fs-200)/1.35 var(--font-ui); }
  .pi-tile__why { color: var(--soft); font: 400 var(--fs-300)/1.4 var(--font-ui); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pi-tile--text .pi-tile__why { -webkit-line-clamp: 3; }
  .pi-tile__credit { margin-top: 2px; color: var(--soft); font: 400 0.6875rem/1.3 var(--font-ui); overflow-wrap: anywhere; }
  .pi-tile__badge { justify-self: start; padding: 1px var(--space-2); border: 1px solid currentColor; border-radius: var(--radius-s); color: var(--pi-terracotta); font: 600 var(--fs-200)/1.4 var(--font-ui); }
  .pi-chat__forget { grid-column: 1 / -1; justify-self: center; min-height: 44px; padding: 0 var(--space-3); border: 0; background: none; color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  .pi-tile__book { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-top: var(--space-2); }
  .pi-tile__book-go { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4); border-radius: 999px; background: var(--text); color: var(--bg); font: 600 var(--fs-300)/1 var(--font-ui); text-decoration: none; }
  .pi-tile__book-go:focus-visible { outline: 2px solid var(--pi-terracotta); outline-offset: 2px; }
  .pi-tile__book-note { color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  @media (hover: hover) { .pi-tile__book-go:hover { background: var(--accent); } }
  /* Her call */
  .pi-tile--call { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0; overflow: hidden; border-color: color-mix(in srgb, var(--pi-terracotta) 55%, var(--border)); }
  .pi-tile--call .pi-tile__media { aspect-ratio: 16 / 9; border-radius: 0; }
  .pi-tile--call .pi-tile__body { padding: var(--space-3) var(--space-4) var(--space-4); }
  .pi-tile--call .pi-tile__title { font-size: var(--fs-500); }
  .pi-tile--call .pi-tile__why { -webkit-line-clamp: 3; }
  @media (hover: hover) {
    .pi-tile:hover { border-color: var(--text); box-shadow: 0 8px 20px -14px rgba(20, 32, 42, .45); }
    .pi-tile:hover .pi-tile__title { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
    .pi-tile:hover .pi-tile__media img { transform: scale(1.04); }
  }


  /* Her reply as it arrives: each checked sentence settles in behind the last. */
  .pi-say { margin: 0; font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); }
  .pi-say__s { animation: pi-word 240ms cubic-bezier(.2, .6, .2, 1) both; }
  @keyframes pi-word { from { opacity: 0; } }

  /* Her call is pressed onto the card once the card has landed. One press, no swing. */
  @keyframes pi-stamp { from { opacity: 0; transform: rotate(-3deg) scale(1.22); } 70% { opacity: .92; } to { opacity: .92; transform: rotate(-3deg); } }
  .pi-msg.is-arriving .pi-tile__call { animation: pi-stamp 240ms cubic-bezier(.2, .9, .3, 1) both; animation-delay: 400ms; }

  /* PI's call: the pick her checked note names first. */
  .pi-tile__call, .pi-note__stamp { justify-self: start; padding: 1px var(--space-2); border: 1.5px solid currentColor; border-radius: 3px; color: var(--pi-terracotta); font: 600 var(--fs-200)/1.4 var(--font-ui); letter-spacing: .1em; text-transform: uppercase; transform: rotate(-3deg); opacity: .92; mix-blend-mode: multiply; filter: url(#pi-ink); margin-bottom: var(--space-2); }
  /* With no photograph above it, the stamp sits in the corner of the card rather than taking a row. */
  .pi-tile--text .pi-tile__body { position: relative; }
  .pi-tile--text .pi-tile__call { position: absolute; top: 0; right: 0; margin: 0; }
  .pi-tile--call.pi-tile--text .pi-tile__call { top: var(--space-2); right: var(--space-3); }
  .pi-tile--call.pi-tile--text .pi-tile__section { padding-right: 7.5rem; }
  .pi-tile--call.pi-tile--text .pi-tile__body { padding-top: var(--space-4); }
  .pi-msg__aside { color: var(--soft); font-style: italic; }

  /* A plan: a page from her notebook. Stops are links to published pages. */
  .pi-note { margin-top: var(--space-4); padding: var(--space-4); background: var(--pi-cream); border-radius: var(--radius-m); border: 1px solid color-mix(in srgb, var(--pi-terracotta) 20%, transparent); color: var(--text); }
  .pi-note__title { margin: 0 0 var(--space-2); font: var(--fw-display) var(--fs-500)/1.2 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-note__stops { list-style: none; margin: 0; padding: 0; }
  .pi-note__stop { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0 0 var(--space-1) 1.25rem; }
  /* The route: a mark at each stop and a dotted line on to the next, like a travel line on a map. */
  .pi-note__stop::before { content: ''; position: absolute; left: 0; top: 1.05rem; width: 8px; height: 8px; border-radius: 50%; background: var(--pi-terracotta); }
  .pi-note__stop:not(:last-child)::after { content: ''; position: absolute; left: 2.5px; width: 3px; top: calc(1.05rem + 13px); bottom: calc(-1.05rem + 5px); background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--pi-terracotta) 75%, transparent) 1.2px, transparent 1.5px) 0 0 / 3px 7px repeat-y; }
  @keyframes pi-mark { from { opacity: 0; transform: scale(0); } }
  @keyframes pi-route { from { opacity: 0; } }
  .pi-msg.is-arriving .pi-note__stop::before { animation: pi-mark 200ms var(--pi-ease) both; animation-delay: calc(100ms + min(var(--pi-i, 0), 4) * 70ms); }
  .pi-msg.is-arriving .pi-note__stop:not(:last-child)::after { animation: pi-route 220ms cubic-bezier(.2, .6, .2, 1) both; animation-delay: calc(180ms + min(var(--pi-i, 0), 4) * 70ms); }
  .pi-note__text { display: grid; gap: 2px; min-width: 0; padding-top: var(--space-3); border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent); }
  .pi-note__when { color: var(--pi-terracotta); font: 600 var(--fs-200)/1.3 var(--font-ui); letter-spacing: .06em; text-transform: uppercase; }
  .pi-note__name { color: var(--text); font: var(--fw-display) var(--fs-400)/1.25 var(--font-display); text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: .2em; }
  .pi-note__name:hover { color: var(--accent); text-decoration-color: currentColor; }
  .pi-note__meta { color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-note__line { margin: 2px 0; color: var(--text); font: italic 500 var(--fs-300)/1.4 var(--font-ui); }
  .pi-note__line + .pi-note__why { color: var(--soft); -webkit-line-clamp: 2; }
  .pi-note__why { color: var(--text); font: 400 var(--fs-300)/1.4 var(--font-ui); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pi-note__swap { justify-self: start; min-height: 44px; padding: 0; background: transparent; color: var(--soft); border: 0; font: 400 var(--fs-200)/1.2 var(--font-ui); text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); text-underline-offset: .2em; white-space: nowrap; cursor: pointer; }
  .pi-note__swap:hover { color: var(--text); text-decoration-color: currentColor; }
  .pi-note__stop:not(:has(.pi-note__swap)) { padding-bottom: var(--space-3); }
  .pi-note__swap:focus-visible, .pi-note__act:focus-visible, .pi-msg__fb-open:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .pi-note__scribble { margin: var(--space-2) 0 0; padding-top: var(--space-3); border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent); font: italic var(--fw-display) var(--fs-400)/1.3 var(--font-display); }
  .pi-note__scribble[hidden] { display: none; }
  .pi-note__sign { position: relative; display: flex; justify-content: flex-end; margin: var(--space-2) 0 0; font: italic 600 var(--fs-300)/1 var(--font-display); }
  .pi-note__initials { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Her initials, written at the foot of a plan once the stops are in. */
  .pi-sign { width: 46px; height: 34px; overflow: visible; }
  .pi-sign__ink { fill: none; stroke: var(--pi-terracotta); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .pi-note__acts { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .pi-note__act { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4); border: 1px solid var(--accent); border-radius: var(--radius-pill); background: var(--accent); color: var(--white); font: 500 var(--fs-300)/1.2 var(--font-ui); text-decoration: none; cursor: pointer; }
  .pi-note__act + .pi-note__act { background: transparent; color: var(--accent); }
  .pi-note__status { margin: var(--space-2) 0 0; color: var(--text); font: 400 var(--fs-300)/1.4 var(--font-ui); overflow-wrap: anywhere; }
  .pi-note__status:empty { margin: 0; }
  /* A plan: the page lands, the stops follow down the route, and she signs it. */
  .pi-msg.is-arriving .pi-note { animation: pi-arrive 340ms var(--pi-ease) both; animation-delay: 80ms; }
  .pi-msg.is-arriving .pi-note__stop { animation: pi-fade 240ms cubic-bezier(.2, .6, .2, 1) both; animation-delay: calc(80ms + min(var(--pi-i, 0), 4) * 70ms); }


  .pi-chat__here { margin: 0 auto var(--space-4); padding: var(--space-3); max-width: 21rem; background: var(--pi-cream); border-radius: var(--radius-m); }
  .pi-chat__here[hidden] { display: none; }
  .pi-chat__here-label { margin: 0 0 var(--space-2); font: 500 var(--fs-300)/1.35 var(--font-ui); }
  .pi-chat__here .pi-chat__chips { justify-content: center; }

  .pi-msg__offer { margin: var(--space-4) 0 0; color: var(--soft); font: 400 var(--fs-300)/1.45 var(--font-ui); }
  .pi-msg__offer a { color: var(--accent); text-underline-offset: .2em; }
  .pi-msg__fb { margin-top: var(--space-3); color: var(--soft); font: 400 var(--fs-200)/1.4 var(--font-ui); }
  .pi-msg__fb p { margin: 0; }
  .pi-msg__fb-open { min-height: 44px; padding: 0; border: 0; background: transparent; color: var(--soft); font: inherit; text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  .pi-msg__fb-open:hover { color: var(--text); }
  .pi-msg__fb-group { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  .pi-msg__small { margin-top: var(--space-3); color: var(--soft); font: 400 var(--fs-300)/1.45 var(--font-ui); }
  .pi-msg__small p { margin: 0 0 var(--space-1); text-wrap: pretty; }
  .pi-msg__links { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
  .pi-msg__links a { display: inline-flex; align-items: center; min-height: 40px; color: var(--accent); text-underline-offset: .2em; }

  /* An answer settles as one gesture, done in a little over half a second: her line, the
     picks close behind it, then the small print. Things that carry meaning rise
     a little; the small print only fades. */
  @keyframes pi-arrive { from { opacity: 0; transform: translateY(6px); } }
  @keyframes pi-fade { from { opacity: 0; } }
  .pi-msg.is-arriving .pi-msg__by, .pi-msg.is-arriving .pi-msg__prose { animation: pi-arrive 300ms var(--pi-ease) both; }
  .pi-msg.is-arriving .pi-tiles > li { animation: pi-arrive 340ms var(--pi-ease) both; animation-delay: calc(120ms + min(var(--pi-i, 0), 4) * 70ms); }
  .pi-msg.is-arriving .pi-msg__small, .pi-msg.is-arriving .pi-msg__offer { animation: pi-fade 200ms cubic-bezier(.2, .6, .2, 1) both; animation-delay: 320ms; }
  .pi-msg.is-arriving .pi-msg__next, .pi-msg.is-arriving .pi-msg__fb, .pi-msg.is-arriving .pi-msg__page { animation: pi-fade 200ms cubic-bezier(.2, .6, .2, 1) both; animation-delay: 380ms; }
  .pi-msg__status { animation: pi-fade 200ms linear both; }
  /* Already read as it arrived: her words stay exactly where they are. Only the
     links take their colour, and what follows comes in sooner. These rules sit
     after the ones above so they win. */
  @keyframes pi-link { from { color: var(--text); text-decoration-color: transparent; } }
  .pi-msg.is-arriving.is-streamed .pi-msg__by, .pi-msg.is-arriving.is-streamed .pi-msg__prose { animation: none; }
  .pi-msg.is-arriving.is-streamed .pi-msg__inline { animation: pi-link 120ms linear both; }
  .pi-msg.is-arriving.is-streamed .pi-tiles > li { animation-delay: calc(40ms + min(var(--pi-i, 0), 4) * 70ms); }
  .pi-msg.is-arriving.is-streamed .pi-tile__call { animation-delay: 320ms; }
  .pi-msg.is-arriving.is-streamed .pi-msg__small, .pi-msg.is-arriving.is-streamed .pi-msg__offer { animation-delay: 240ms; }
  .pi-msg.is-arriving.is-streamed .pi-msg__next, .pi-msg.is-arriving.is-streamed .pi-msg__fb, .pi-msg.is-arriving.is-streamed .pi-msg__page { animation-delay: 300ms; }
  /* Only the bubble just sent. The class is set once in ask(), so a redraw of the thread does not replay it. */
  .pi-chat__log > .pi-msg--you.is-new { animation: pi-arrive 180ms var(--pi-ease) both; }

  .pi-msg__next { margin-top: var(--space-5); }
  .pi-msg__next-label { margin: 0 0 var(--space-2); color: var(--soft); font: 400 var(--fs-300)/1.3 var(--font-ui); }
  .pi-msg__page { display: inline-block; margin-top: var(--space-4); color: var(--soft); font: 400 var(--fs-300)/1.3 var(--font-ui); text-underline-offset: .2em; }
  .pi-msg__page:hover { color: var(--accent); }

  /* Composer */
  .pi-chat__foot { padding: var(--space-3) var(--space-4) max(var(--space-3), env(safe-area-inset-bottom)); border-top: 1px solid var(--border); }
  .pi-chat__form {
    display: flex; align-items: flex-end; gap: var(--space-2);
    padding: 6px 6px 6px var(--space-4);
    border: 1px solid var(--border-control); border-radius: 26px; background: var(--white);
  }
  .pi-chat__form:focus-within { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .pi-chat__form textarea {
    flex: 1; min-width: 0; min-height: 44px; max-height: 132px; padding: 11px 0; resize: none;
    border: 0; background: transparent; color: var(--text); font: 400 var(--fs-400)/1.4 var(--font-ui);
  }
  .pi-chat .pi-chat__form textarea:focus, .pi-chat .pi-chat__form textarea:focus-visible { outline: none; box-shadow: none; }
  .pi-chat__form textarea::placeholder { color: var(--soft); }
  .pi-chat__send {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: var(--accent); color: var(--white); cursor: pointer;
  }
  .pi-chat__send:disabled { opacity: .5; cursor: progress; }
  .pi-chat__mic { flex: none; display: grid; place-items: center; width: 44px; height: 44px; margin-right: var(--space-1); border: 0; border-radius: 50%; background: transparent; color: var(--soft); cursor: pointer; }
  .pi-chat__mic[hidden], .pi-chat__tool--speak[hidden] { display: none; }
  .pi-chat__mic:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pi-chat__mic[aria-pressed="true"] { background: var(--pi-terracotta); color: var(--white); animation: pi-mic 1.2s ease-in-out infinite; }
  @keyframes pi-mic { 50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--pi-terracotta) 25%, transparent); } }
  @media (prefers-reduced-motion: reduce) { .pi-chat__mic[aria-pressed="true"] { animation: none; } }
  .pi-chat__tool--speak[aria-pressed="true"] { color: var(--pi-terracotta); }
  .pi-chat__tool--speak[aria-pressed="true"] .pi-chat__speak-off, .pi-chat__tool--speak[aria-pressed="false"] .pi-chat__speak-on { display: none; }
