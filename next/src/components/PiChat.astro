---
/**
 * PiChat - PI, the Peninsula Insider, as a chat on every page (2026-11-13).
 *
 * Brings back the July 2026 concierge drawer in the simplified design:
 * her hat portrait, her greeting, answers that stream in her voice, picture
 * tiles that link to the pages she recommends, and "ask me next" chips.
 *
 *   Closed      a small pill at the corner: her avatar and "Ask PI".
 *   Open        desktop: docks to the right and pushes the page over, or
 *               floats as a card (the reader's choice, remembered).
 *               phone: a full-height sheet.
 *   Minimised   back to the pill; the conversation is kept for the visit.
 *
 * Any link to /ask/?q=... and any Ask PI form on the site opens the chat
 * instead of leaving the page. /ask/ itself stays as the shareable page,
 * and the chat hides there. The character is specified in BRAND-PI.md.
 */
/**
 * 2026-11-20: the window is back over a different engine. PI's picks are
 * matched in the browser from /ask/index.json (lib/ask-guide.mjs), where every
 * fact on a tile is copied from the page it links to. Her note above them is
 * written by the platform API from those same pages and checked sentence by
 * sentence before it is returned (/concierge/pi/voice). The tiles never wait
 * for the note, and stand on their own if it does not come.
 */
/**
 * 2026-11-20 (later): PI as a character (lib/ask-pi.mjs, lib/pi-lines.mjs).
 * She plans a day as a notebook page of stops, each one a published page, and
 * a reader can swap a stop, send the plan to My Trip or share it. Her modes
 * (surprise me, talk me out of it, settle an argument, rainy day rescue), her
 * refusals and her asides are fixed lines written by a person. None of it is
 * generated and none of it is sent anywhere. SHOW_ASK_PERSONA turns it off.
 */
import { ASK_GUIDE_ON, SHOW_ASK_VOICE, SHOW_ASK_PERSONA } from '../lib/features';
import { CONCIERGE_API_URL as API_URL } from '../lib/concierge-config';

const starters = SHOW_ASK_PERSONA
  ? ['Plan my day', 'Surprise me', 'Talk me out of it', 'Settle an argument', 'Rainy day rescue', 'A long lunch in Red Hill', "What's on this weekend"]
  : ['A long lunch in Red Hill', "What's on this weekend", 'Somewhere to stay for our anniversary'];
---

{ASK_GUIDE_ON && (
  <div class="pi-chat" id="pi-chat" data-api={API_URL} data-voice={SHOW_ASK_VOICE ? 'on' : 'off'} data-persona={SHOW_ASK_PERSONA ? 'on' : 'off'} data-state="closed" data-mode="dock" transition:persist="pi-chat" data-pagefind-ignore>
    <button type="button" class="pi-chat__launch" id="pi-chat-launch" aria-controls="pi-chat-panel" aria-expanded="false">
      <img class="pi-chat__launch-face" src="/images/pi/pi-avatar-96.webp" alt="" width="44" height="44" decoding="async" />
      <span class="pi-chat__launch-text">
        <span class="pi-chat__launch-name">Ask PI</span>
        <span class="pi-chat__launch-sub">The Peninsula Insider</span>
      </span>
      <span class="pi-chat__launch-dot" aria-hidden="true"></span>
    </button>

    <section class="pi-chat__panel" id="pi-chat-panel" aria-labelledby="pi-chat-name" hidden>
      <header class="pi-chat__head">
        <img class="pi-chat__head-face" src="/images/pi/pi-avatar-96.webp" alt="" width="40" height="40" decoding="async" />
        <div class="pi-chat__head-id">
          <h2 class="pi-chat__name" id="pi-chat-name">PI</h2>
          <p class="pi-chat__role">The Peninsula Insider</p>
        </div>
        <div class="pi-chat__tools">
          <button type="button" class="pi-chat__tool pi-chat__tool--mode" id="pi-chat-mode" aria-label="Float the chat over the page" title="Float over the page">
            <svg class="pi-chat__icon-float" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="3.5" width="15" height="13" rx="2"/><rect x="10" y="9" width="5.5" height="5.5" rx="1" fill="currentColor" stroke="none"/></svg>
            <svg class="pi-chat__icon-dock" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="3.5" width="15" height="13" rx="2"/><path d="M12 3.5v13"/><rect x="12" y="3.5" width="5.5" height="13" fill="currentColor" stroke="none"/></svg>
          </button>
          <button type="button" class="pi-chat__tool" id="pi-chat-new" aria-label="Start a new conversation" title="New conversation">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 10a6 6 0 1 0 1.8-4.3"/><path d="M4 3.5v3h3"/></svg>
          </button>
          <button type="button" class="pi-chat__tool" id="pi-chat-min" aria-label="Minimise the chat" title="Minimise">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 10h10"/></svg>
          </button>
        </div>
      </header>

      <div class="pi-chat__thread" id="pi-chat-thread" data-lenis-prevent>
        <div class="pi-chat__hello" id="pi-chat-hello">
          <img class="pi-chat__portrait" src="/images/pi/pi-portrait-320.webp" srcset="/images/pi/pi-portrait-320.webp 320w, /images/pi/pi-portrait-640.webp 640w" sizes="168px" alt="" width="168" height="168" decoding="async" />
          <p class="pi-chat__hello-lead">Tell me what you're after.</p>
          <p class="pi-chat__hello-body">{SHOW_ASK_PERSONA
            ? "A long lunch, a walk, somewhere to stay, what's on this weekend. Or hand me the whole day and I'll put it in order."
            : "A long lunch, a walk, somewhere to stay, what's on this weekend. Name a town and I'll narrow it."}</p>
          <div class="pi-chat__here" id="pi-chat-here" hidden>
            <p class="pi-chat__here-label" id="pi-chat-here-label"></p>
            <ul class="pi-chat__chips" role="list" id="pi-chat-here-chips" aria-labelledby="pi-chat-here-label"></ul>
          </div>
          <ul class="pi-chat__chips" role="list" aria-label="Try asking">
            {starters.map((q) => <li><button type="button" class="pi-chat__chip" data-pi-q={q}>{q}</button></li>)}
          </ul>
        </div>
        <ol class="pi-chat__log" id="pi-chat-log" role="list" aria-live="polite"></ol>
      </div>

      <footer class="pi-chat__foot">
        <form class="pi-chat__form" id="pi-chat-form" action="/ask/" method="get">
          <label class="pi-chat__sr" for="pi-chat-input">Ask PI a question</label>
          <textarea id="pi-chat-input" name="q" rows="1" maxlength="500" enterkeyhint="send" placeholder="Ask PI anything about the Peninsula" required></textarea>
          <button type="submit" class="pi-chat__send" id="pi-chat-send" aria-label="Send">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 16V4M5 9l5-5 5 5"/></svg>
          </button>
        </form>
        <p class="pi-chat__fine">PI's picks and plans come from our published guides. Her notes are written by AI from those pages. Check hours and bookings before you go.</p>
      </footer>
    </section>
  </div>
)}

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
  import { paragraphs, READER_ERROR, sessionId } from '../lib/ask-client';
  import { converse, swapStop, pageOffers } from '../lib/ask-pi.mjs';
  import { loadAskIndex } from '../scripts/ask-guide-ui';

  type Place = { href: string; title: string; why: string; section: string; image: string | null; alt: string; facts?: [string, string][]; badge?: string | null };
  type Card = { href: string; title: string; meta: string; summary?: string; facts: [string, string][]; badge: string | null };
  type Plan = { title: string; town: string; trip: string | null; stops: { label: string; card: Card; swappable: boolean }[] };
  type Turn =
    | { role: 'you'; text: string }
    | { role: 'pi'; text: string; places: Place[]; next: string[]; notes?: string[]; links?: { href: string; label: string }[]; error?: boolean;
        kind?: string; mood?: string; aside?: string | null; plan?: Plan; offer?: { line: string; label: string; href: string }; call?: string; fb?: boolean };
  type PiTurn = Extract<Turn, { role: 'pi' }>;
  const toPlaces = (cards: Card[]): Place[] => cards.map((card) => ({
    href: card.href, title: card.title, why: card.summary || '', section: card.meta, image: null, alt: '', facts: card.facts, badge: card.badge,
  }));
  // Replies that are a step in a conversation, not an answer a reader would open as a page.
  const NOT_A_PAGE = new Set(['interview', 'plan', 'critique', 'with']);
  const FEEDBACK: [string, string][] = [['wrong-place', 'Wrong sort of place'], ['missed-point', 'Missed the point'], ['out-of-date', 'Out of date'], ['not-funny', 'Not funny']];

  const HISTORY = 'pi-chat-history';
  const ENGINE = 'pi-chat-engine';
  const STATE = 'pi-chat-state';
  const MODE = 'pi-chat-mode';
  const DESKTOP = window.matchMedia('(min-width: 64em)');
  const WIDE = window.matchMedia('(min-width: 80em)'); // room to dock beside the page

  const store = {
    get(area: Storage, key: string) { try { return area.getItem(key); } catch { return null; } },
    set(area: Storage, key: string, v: string) { try { area.setItem(key, v); } catch { /* private mode */ } },
    del(area: Storage, key: string) { try { area.removeItem(key); } catch { /* private mode */ } },
  };

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  const root = document.getElementById('pi-chat');
  if (root && !root.dataset.booted) {
    root.dataset.booted = '1';
    const api = root.dataset.api || '';
    const launch = document.getElementById('pi-chat-launch') as HTMLButtonElement;
    const panel = document.getElementById('pi-chat-panel') as HTMLElement;
    const thread = document.getElementById('pi-chat-thread') as HTMLElement;
    const hello = document.getElementById('pi-chat-hello') as HTMLElement;
    const log = document.getElementById('pi-chat-log') as HTMLOListElement;
    const form = document.getElementById('pi-chat-form') as HTMLFormElement;
    const input = document.getElementById('pi-chat-input') as HTMLTextAreaElement;
    const send = document.getElementById('pi-chat-send') as HTMLButtonElement;
    const modeBtn = document.getElementById('pi-chat-mode') as HTMLButtonElement;

    const voiceOn = root.dataset.voice === 'on' && !!api;
    const personaOn = root.dataset.persona === 'on';
    const here = document.getElementById('pi-chat-here') as HTMLElement;
    const hereLabel = document.getElementById('pi-chat-here-label') as HTMLElement;
    const hereChips = document.getElementById('pi-chat-here-chips') as HTMLElement;
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const matchGuides = (index: any, q: string, state: any, context: Record<string, unknown>): any => converse(index, q, state, { ...context, persona: personaOn });
    const track = (name: string, params: Record<string, unknown>) => { try { (window as any).piTrack?.(name, params, { component: 'pi-chat' }); } catch { /* never breaks the chat */ } };
    let turns: Turn[] = [];
    try { turns = JSON.parse(store.get(sessionStorage, HISTORY) || '[]'); } catch { turns = []; }
    // What the last answer matched, so "in Flinders" refines it.
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    let engine: any = null;
    try { engine = JSON.parse(store.get(sessionStorage, ENGINE) || 'null'); } catch { engine = null; }
    let controller: AbortController | null = null;

    const onAskPage = () => location.pathname.replace(/\/?$/, '/') === '/ask/';

    /* ---------- layout state ---------- */

    // The docked sidebar starts at the masthead's bottom edge, so the masthead keeps
    // the full width and nothing in it is covered.
    let pinFrame = 0;
    function placeUnderMasthead() {
      pinFrame = 0;
      if (!document.documentElement.classList.contains('pi-chat-docked')) return;
      const mast = document.querySelector('[data-v5-masthead]');
      const top = mast ? Math.max(0, Math.round(mast.getBoundingClientRect().bottom)) : 0;
      root!.style.setProperty('--pi-top', `${top}px`);
    }

    function applyChrome() {
      const state = root!.dataset.state;
      const docked = state === 'open' && root!.dataset.mode === 'dock' && WIDE.matches;
      document.documentElement.classList.toggle('pi-chat-docked', docked);
      document.documentElement.classList.toggle('pi-chat-open', state === 'open');
      panel.classList.toggle('is-docked', docked);
      placeUnderMasthead();
      document.documentElement.classList.toggle('pi-chat-sheet', state === 'open' && !DESKTOP.matches);
      root!.hidden = onAskPage();
      launch.classList.toggle('has-thread', turns.length > 0);
    }

    function setMode(mode: string) {
      delete root!.dataset.anchor;
      root!.dataset.mode = mode === 'float' ? 'float' : 'dock';
      store.set(localStorage, MODE, root!.dataset.mode);
      const toFloat = root!.dataset.mode === 'dock';
      modeBtn.setAttribute('aria-label', toFloat ? 'Float the chat over the page' : 'Dock the chat beside the page');
      modeBtn.title = toFloat ? 'Float over the page' : 'Dock beside the page';
      applyChrome();
    }

    // The control that opened the panel (the masthead Ask PI link, a page form), so
    // closing returns focus there rather than to the hidden launcher.
    let opener: HTMLElement | null = null;
    function open(focus = true) {
      if (onAskPage()) return;
      root!.dataset.state = 'open';
      store.set(sessionStorage, STATE, 'open');
      panel.hidden = false;
      launch.setAttribute('aria-expanded', 'true');
      applyChrome();
      offerHere();
      requestAnimationFrame(() => {
        if (root!.dataset.state !== 'open') return;
        root!.classList.add('is-in');
        if (focus) input.focus({ preventScroll: true });
      });
    }

    // Opens as a pop-up dialogue in the place of the element that asked for it (the
    // cover's Ask PI badge), dropping down from its top-right corner. This opening
    // only: the reader's saved dock/float choice is restored on minimise.
    function popUpFrom(el: HTMLElement) {
      if (!DESKTOP.matches) { open(); return; }
      const r = el.getBoundingClientRect();
      root!.style.setProperty('--pi-pop-top', `${Math.max(16, Math.round(r.top))}px`);
      root!.style.setProperty('--pi-pop-right', `${Math.max(16, Math.round(window.innerWidth - r.right))}px`);
      root!.dataset.mode = 'float';
      root!.dataset.anchor = 'badge';
      open();
    }

    function minimise(focus = true) {
      root!.classList.remove('is-in');
      root!.dataset.state = 'closed';
      store.set(sessionStorage, STATE, 'closed');
      launch.setAttribute('aria-expanded', 'false');
      applyChrome();
      window.setTimeout(() => {
        if (root!.dataset.state === 'open') return;
        panel.hidden = true;
        if (root!.dataset.anchor) {
          delete root!.dataset.anchor;
          root!.dataset.mode = store.get(localStorage, MODE) === 'float' ? 'float' : 'dock';
        }
      }, 220);
      if (focus) (opener && opener.isConnected ? opener : launch).focus({ preventScroll: true });
    }

    /* ---------- rendering ---------- */

    // On a venue page she offers a day built around it. Reads the index only;
    // nothing about the page or the reader is sent.
    function offerHere() {
      if (!personaOn || root!.dataset.state !== 'open') return;
      const path = location.pathname;
      loadAskIndex().then((index) => {
        if (path !== location.pathname) return;
        const offer = pageOffers(index, path) as { title: string; chips: string[] } | null;
        here.hidden = !offer;
        if (!offer) return;
        hereLabel.textContent = `You're looking at ${offer.title}.`;
        hereChips.replaceChildren(...offer.chips.map((q) => {
          const li = el('li');
          const b = el('button', 'pi-chat__chip', q) as HTMLButtonElement;
          b.type = 'button';
          b.dataset.piQ = q;
          li.append(b);
          return li;
        }));
      }).catch(() => { here.hidden = true; });
    }

    function byline(mood?: string) {
      const b = el('p', 'pi-msg__by');
      const face = el('img', 'pi-msg__face') as HTMLImageElement;
      if (mood) face.classList.add(`is-${mood}`);
      face.src = '/images/pi/pi-avatar-48.webp';
      face.alt = '';
      face.width = 24;
      face.height = 24;
      b.append(face, el('span', 'pi-msg__name', 'PI'));
      return b;
    }

    /** Prose with the recommended places linked where PI names them. */
    function proseNodes(text: string, places: Place[]) {
      return paragraphs(text).map((para) => {
        const p = el('p');
        const linked = new Set<string>();
        let rest = para;
        while (rest) {
          let hit: { i: number; place: Place } | null = null;
          for (const place of places) {
            if (linked.has(place.href)) continue;
            const i = rest.indexOf(place.title);
            if (i >= 0 && (!hit || i < hit.i)) hit = { i, place };
          }
          if (!hit) { p.append(rest); break; }
          p.append(rest.slice(0, hit.i));
          const a = el('a', 'pi-msg__inline', hit.place.title) as HTMLAnchorElement;
          a.href = hit.place.href;
          p.append(a);
          linked.add(hit.place.href);
          rest = rest.slice(hit.i + hit.place.title.length);
        }
        return p;
      });
    }

    function tiles(places: Place[], call?: string) {
      const list = el('ul', 'pi-tiles');
      list.setAttribute('role', 'list');
      list.setAttribute('aria-label', 'Places PI recommends');
      for (const [at, place] of places.entries()) {
        const li = el('li');
        li.style.setProperty('--pi-i', String(at));
        const a = el('a', 'pi-tile') as HTMLAnchorElement;
        a.href = place.href;
        const body = el('span', 'pi-tile__body');
        if (place.section) body.append(el('span', 'pi-tile__section', place.section));
        body.append(el('span', 'pi-tile__title', place.title));
        if (call && place.href === call) body.append(el('strong', 'pi-tile__call', 'PI’s call'));
        if (place.badge) body.append(el('strong', 'pi-tile__badge', place.badge));
        for (const [label, value] of place.facts ?? []) body.append(el('span', 'pi-tile__fact', `${label}: ${value}`));
        if (place.why) body.append(el('span', 'pi-tile__why', place.why));
        if (place.image) {
          const media = el('span', 'pi-tile__media');
          const img = el('img') as HTMLImageElement;
          img.src = place.image;
          img.alt = '';
          img.loading = 'lazy';
          img.decoding = 'async';
          img.addEventListener('error', () => { media.remove(); a.classList.add('pi-tile--text'); }, { once: true });
          media.append(img);
          a.append(media, body);
        } else {
          // No photograph travels with the index yet: a tile of the page's own words.
          a.classList.add('pi-tile--text');
          a.append(body);
        }
        li.append(a);
        list.append(li);
      }
      return list;
    }

    /** What PI cannot check, and where else to look. Fixed wording from the matcher. */
    function smallPrint(turn: Extract<Turn, { role: 'pi' }>) {
      const wrap = el('div', 'pi-msg__small');
      for (const note of turn.notes ?? []) wrap.append(el('p', '', note));
      if (turn.links?.length) {
        const p = el('p', 'pi-msg__links');
        for (const item of turn.links) {
          const a = el('a', '', item.label) as HTMLAnchorElement;
          a.href = item.href;
          p.append(a);
        }
        wrap.append(p);
      }
      return wrap;
    }

    function nextChips(items: string[]) {
      const wrap = el('div', 'pi-msg__next');
      wrap.append(el('p', 'pi-msg__next-label', 'Ask me next'));
      const ul = el('ul', 'pi-chat__chips');
      ul.setAttribute('role', 'list');
      for (const q of items.slice(0, 3)) {
        const li = el('li');
        const b = el('button', 'pi-chat__chip', q) as HTMLButtonElement;
        b.type = 'button';
        b.dataset.piQ = q;
        li.append(b);
        ul.append(li);
      }
      wrap.append(ul);
      return wrap;
    }

    /** A plan as a page from her notebook: ordered stops, each one a published page. */
    function notebook(turn: PiTurn, live: boolean) {
      const plan = turn.plan!;
      const note = el('div', 'pi-note');
      if (live) note.dataset.piLive = '1';
      note.append(el('p', 'pi-note__title', plan.title));
      const list = el('ol', 'pi-note__stops');
      list.setAttribute('role', 'list');
      for (const [at, stop] of plan.stops.entries()) {
        const li = el('li', 'pi-note__stop');
        li.style.setProperty('--pi-i', String(at));
        const text = el('div', 'pi-note__text');
        text.append(el('span', 'pi-note__when', stop.label));
        const name = el('a', 'pi-note__name', stop.card.title) as HTMLAnchorElement;
        name.href = stop.card.href;
        text.append(name);
        if (stop.card.meta) text.append(el('span', 'pi-note__meta', stop.card.meta));
        if (stop.card.summary) text.append(el('span', 'pi-note__why', stop.card.summary));
        li.append(text);
        if (live && stop.swappable) {
          const swap = el('button', 'pi-note__swap', 'Not that one') as HTMLButtonElement;
          swap.type = 'button';
          swap.dataset.piSwap = String(at);
          swap.setAttribute('aria-label', `Not ${stop.card.title}: show another`);
          li.append(swap);
        }
        list.append(li);
      }
      note.append(list);
      const scribble = el('p', 'pi-note__scribble', turn.aside || '');
      scribble.setAttribute('role', 'status');
      scribble.hidden = !turn.aside;
      const sign = el('p', 'pi-note__sign');
      const face = el('img') as HTMLImageElement;
      face.src = '/images/pi/pi-avatar-48.webp';
      face.alt = '';
      face.width = 24;
      face.height = 24;
      sign.append(face, el('span', '', 'PI'));
      note.append(scribble, sign);
      const acts = el('div', 'pi-note__acts');
      if (plan.trip) {
        const trip = el('a', 'pi-note__act', 'Add to My Trip') as HTMLAnchorElement;
        trip.href = plan.trip;
        trip.dataset.piTrip = '1';
        acts.append(trip);
        const share = el('button', 'pi-note__act', 'Share this plan') as HTMLButtonElement;
        share.type = 'button';
        share.dataset.piShare = '1';
        acts.append(share);
      }
      const status = el('p', 'pi-note__status');
      status.setAttribute('role', 'status');
      note.append(acts, status);
      return note;
    }

    function feedback(turn: PiTurn) {
      const wrap = el('div', 'pi-msg__fb');
      if (turn.fb) { wrap.append(el('p', '', 'Noted.')); return wrap; }
      const b = el('button', 'pi-msg__fb-open', 'PI got it wrong') as HTMLButtonElement;
      b.type = 'button';
      b.dataset.piFb = 'open';
      wrap.append(b);
      return wrap;
    }

    function youNode(text: string) {
      const li = el('li', 'pi-msg pi-msg--you');
      li.append(el('p', 'pi-msg__bubble', text));
      return li;
    }

    function piNode(turn: PiTurn, question?: string, live = false) {
      const li = el('li', 'pi-msg pi-msg--pi');
      const prose = el('div', 'pi-msg__prose');
      if (turn.error) prose.append(el('p', 'pi-msg__error', turn.text));
      else prose.append(...proseNodes(turn.text, turn.plan ? [] : turn.places));
      // Her aside sits under her line; on a plan it is written on the notebook page instead.
      if (turn.aside && !turn.plan) prose.append(el('p', 'pi-msg__aside', turn.aside));
      li.append(byline(turn.mood), prose);
      if (turn.plan) li.append(notebook(turn, live));
      else if (turn.places.length) li.append(tiles(turn.places, turn.call));
      if (turn.notes?.length || turn.links?.length) li.append(smallPrint(turn));
      if (turn.offer) {
        const p = el('p', 'pi-msg__offer', `${turn.offer.line} `);
        const a = el('a', '', turn.offer.label) as HTMLAnchorElement;
        a.href = turn.offer.href;
        p.append(a);
        li.append(p);
      }
      if (turn.next.length) li.append(nextChips(turn.next));
      if (personaOn && !turn.error && turn.kind !== 'interview') li.append(feedback(turn));
      if (question && !turn.error && !NOT_A_PAGE.has(turn.kind || '')) {
        const pg = el('a', 'pi-msg__page', 'Open as a page') as HTMLAnchorElement;
        pg.href = `/ask/?q=${encodeURIComponent(question)}`;
        pg.dataset.piPage = '1';
        li.append(pg);
      }
      return li;
    }

    function render() {
      hello.hidden = turns.length > 0;
      const nodes: HTMLElement[] = [];
      let lastQ = '';
      const livePlan = latestPlan();
      for (const t of turns) {
        if (t.role === 'you') { lastQ = t.text; nodes.push(youNode(t.text)); }
        else nodes.push(piNode(t, lastQ, t === livePlan));
      }
      log.replaceChildren(...nodes);
      applyChrome();
    }

    /** The plan the engine still holds: the only one whose stops can be swapped. */
    function latestPlan(): PiTurn | null {
      if (!engine?.pi?.plan) return null;
      for (let i = turns.length - 1; i >= 0; i -= 1) {
        const t = turns[i];
        if (t.role === 'pi' && t.plan) return t;
      }
      return null;
    }

    function save() {
      store.set(sessionStorage, HISTORY, JSON.stringify(turns.slice(-12)));
      store.set(sessionStorage, ENGINE, JSON.stringify(engine));
    }

    /** The last few exchanges, so her note and the front desk follow the thread. */
    function recent() {
      const out: { q: string; say?: string }[] = [];
      for (let i = 0; i < turns.length - 1; i += 1) {
        const you = turns[i];
        const pi = turns[i + 1];
        if (you.role === 'you' && pi?.role === 'pi' && !pi.error) out.push({ q: you.text, say: pi.text });
      }
      return out.slice(-3);
    }

    /** One call to PI's voice. Any failure is simply "no voice this time". */
    async function voice<T>(path: 'voice' | 'front-desk', body: unknown, signal: AbortSignal): Promise<T | null> {
      const timeout = AbortSignal.timeout(14_000);
      try {
        const res = await fetch(`${api}/concierge/pi/${path}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Session-Id': sessionId() },
          body: JSON.stringify(body),
          signal: AbortSignal.any([signal, timeout]),
        });
        return res.ok ? ((await res.json()) as T) : null;
      } catch {
        return null;
      }
    }

    function scrollToMsg(node: HTMLElement) {
      requestAnimationFrame(() => {
        thread.scrollTo({ top: Math.max(0, node.offsetTop - 12), behavior: 'smooth' });
      });
    }

    /* ---------- asking ---------- */

    async function ask(raw: string) {
      const q = raw.trim().slice(0, 500);
      if (q.length < 2) return;
      open(false);
      controller?.abort();
      controller = new AbortController();
      const { signal } = controller;
      input.value = '';
      autoGrow();
      turns.push({ role: 'you', text: q });
      save();
      render();

      const live = el('li', 'pi-msg pi-msg--pi is-live');
      const prose = el('div', 'pi-msg__prose');
      const status = el('p', 'pi-msg__status', 'Checking my notebook…');
      status.setAttribute('role', 'status');
      prose.append(status);
      live.append(byline(), prose);
      log.append(live);
      scrollToMsg(live);
      send.disabled = true;

      try {
        const index = await loadAskIndex();
        const context = { pagePath: location.pathname };
        let result = matchGuides(index, q, engine, context);
        if (!result) throw new Error(READER_ERROR);

        // The matcher did not follow. Ask the front desk what was meant, then
        // run the matcher again on its reading. What it says is PI talking; it
        // never carries a fact about a place.
        let aside: string | null = null;
        if (voiceOn && !result.reply.mood && (result.reply.kind === 'none' || result.reply.kind === 'help')) {
          const desk = await voice<{ say: string | null; rewrite: string | null }>('front-desk', { question: q, history: recent() }, signal);
          if (signal.aborted) { live.remove(); return; }
          if (typeof desk?.rewrite === 'string' && desk.rewrite.trim()) {
            const again = matchGuides(index, desk.rewrite, engine?.pi ? { pi: engine.pi } : null, context);
            if (again && again.reply.cards.length) result = again;
          }
          aside = typeof desk?.say === 'string' && desk.say.trim() ? desk.say.trim().slice(0, 400) : null;
        }

        const hadPlan = Boolean(engine?.pi?.plan);
        engine = result.state;
        const reply = result.reply;
        const places = toPlaces(reply.cards);
        const turn: PiTurn = {
          role: 'pi',
          text: places.length ? reply.lead : aside || reply.lead,
          places,
          next: reply.chips,
          notes: reply.notes,
          links: reply.links,
          kind: reply.kind,
          mood: reply.mood,
          aside: reply.aside || null,
          plan: reply.plan,
          offer: reply.offer,
        };
        turns.push(turn);
        save();
        // Only the plan the engine holds can be swapped. When that changes,
        // redraw the thread so an older plan's buttons go.
        const redraw = Boolean(reply.plan) || (hadPlan && !engine?.pi?.plan);
        if (redraw) render();
        if (reply.plan) track('ask_plan', { variant: String(reply.plan.stops.length), action: 'shown' });

        // The picks are on screen now. Her note follows when it has been checked.
        const node = redraw ? (log.lastElementChild as HTMLElement) : piNode(turn, q);
        node.classList.add('is-arriving');
        if (redraw) live.remove(); else live.replaceWith(node);
        scrollToMsg(node);
        // Plans, critiques and refusals keep her own authored lines. The
        // checked note is for lists of picks, where she makes the call.
        if (voiceOn && places.length && ['results', 'named', 'place', 'nightlife', 'with'].includes(reply.kind)) {
          node.classList.add('is-live');
          const said = await voice<{ say: string | null }>('voice', { question: q, cards: places.map((place) => place.href), history: recent().slice(0, -1) }, signal);
          node.classList.remove('is-live');
          if (typeof said?.say === 'string' && said.say.trim() && turns.includes(turn)) {
            turn.text = said.say.trim().slice(0, 900);
            // Her call is the first of the picks her checked note names.
            const first = turn.places.map((place) => ({ place, at: turn.text.indexOf(place.title) })).filter((hit) => hit.at >= 0).sort((a, b) => a.at - b.at)[0];
            if (personaOn && first && turn.places.length > 1) {
              turn.call = first.place.href;
              const tile = [...node.querySelectorAll<HTMLAnchorElement>('.pi-tile')].find((a) => a.getAttribute('href') === turn.call);
              tile?.querySelector('.pi-tile__title')?.after(el('strong', 'pi-tile__call', 'PI’s call'));
            }
            save();
            const noted = node.querySelector('.pi-msg__prose');
            if (noted) {
              noted.replaceChildren(...proseNodes(turn.text, turn.places), ...(turn.aside ? [el('p', 'pi-msg__aside', turn.aside)] : []));
              noted.classList.add('is-voiced');
              // Her note is longer than the holding line: bring its start back into view.
              if (thread.scrollTop > node.offsetTop - 12) scrollToMsg(node);
            }
          }
        }
      } catch (err) {
        if ((err as Error).name === 'AbortError') { live.remove(); return; }
        const turn: Turn = { role: 'pi', text: READER_ERROR, places: [], next: [], error: true };
        turns.push(turn);
        save();
        live.replaceWith(piNode(turn));
      } finally {
        send.disabled = false;
        applyChrome();
      }
    }

    function autoGrow() {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 132)}px`;
    }

    /* ---------- wiring (each listener bound once; this script runs once) ---------- */

    launch.addEventListener('click', () => open());
    document.getElementById('pi-chat-min')!.addEventListener('click', () => minimise());
    document.getElementById('pi-chat-new')!.addEventListener('click', () => {
      controller?.abort();
      turns = [];
      engine = null;
      store.del(sessionStorage, HISTORY);
      store.del(sessionStorage, ENGINE);
      render();
      input.focus();
    });
    modeBtn.addEventListener('click', () => setMode(root.dataset.mode === 'dock' ? 'float' : 'dock'));
    form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
    input.addEventListener('input', autoGrow);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); ask(input.value); }
    });
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.stopPropagation(); minimise(); } });
    async function swap(at: number) {
      const turn = latestPlan();
      if (!turn) return;
      const swapped = swapStop(await loadAskIndex(), engine, at) as { state: unknown; plan: Plan; remark: string } | null;
      if (!swapped || latestPlan() !== turn) return;
      engine = swapped.state;
      turn.plan = swapped.plan;
      turn.places = toPlaces(swapped.plan.stops.map((stop) => stop.card));
      turn.aside = swapped.remark;
      save();
      const old = log.querySelector('.pi-note[data-pi-live]');
      const fresh = notebook(turn, true);
      old?.replaceWith(fresh);
      (fresh.querySelector<HTMLElement>(`[data-pi-swap="${at}"]`) || fresh.querySelector<HTMLElement>('.pi-note__name'))?.focus({ preventScroll: true });
      track('ask_plan', { action: 'swap', position: at + 1 });
    }

    async function share(button: HTMLElement) {
      const note = button.closest('.pi-note');
      const turn = (turns.filter((t) => t.role === 'pi' && t.plan) as PiTurn[])[[...log.querySelectorAll('.pi-note')].indexOf(note as Element)];
      const status = note?.querySelector<HTMLElement>('.pi-note__status');
      if (!turn?.plan?.trip || !status) return;
      const url = new URL(turn.plan.trip, location.origin).href;
      const text = [turn.plan.title, ...turn.plan.stops.map((stop, i) => `${i + 1}. ${stop.card.title}${stop.card.meta ? ` (${stop.card.meta})` : ''}`), 'From PI at Peninsula Insider. Check hours and bookings before you go.'].join('\n');
      track('ask_plan', { action: 'share' });
      try {
        if (navigator.share) { await navigator.share({ title: turn.plan.title, text, url }); status.textContent = ''; return; }
        await navigator.clipboard.writeText(`${text}\n${url}`);
        status.textContent = 'Copied. Send it to whoever is always late.';
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
        // No share sheet and no clipboard: show the link so it can be copied by hand.
        status.textContent = '';
        const link = el('a', '', url) as HTMLAnchorElement;
        link.href = url;
        status.append('Copy this link: ', link);
      }
    }

    function giveFeedback(button: HTMLElement) {
      const wrap = button.closest<HTMLElement>('.pi-msg__fb');
      const node = button.closest('.pi-msg--pi');
      const turn = turns.filter((t) => t.role === 'pi')[[...log.querySelectorAll('.pi-msg--pi')].indexOf(node as Element)] as PiTurn | undefined;
      if (!wrap || !turn) return;
      if (button.dataset.piFb === 'open') {
        const group = el('div', 'pi-msg__fb-group');
        group.setAttribute('role', 'group');
        group.setAttribute('aria-label', 'What went wrong?');
        for (const [key, label] of FEEDBACK) {
          const b = el('button', 'pi-chat__chip', label) as HTMLButtonElement;
          b.type = 'button';
          b.dataset.piFb = key;
          group.append(b);
        }
        wrap.replaceChildren(group);
        group.querySelector<HTMLElement>('button')?.focus({ preventScroll: true });
        return;
      }
      // The button pressed and the kind of reply. Never the question or the answer.
      track('ask_feedback', { action: button.dataset.piFb, variant: turn.kind || 'reply' });
      turn.fb = true;
      save();
      const done = el('p', '', 'Noted. If you allow analytics, the editors see which button you pressed and nothing you typed.');
      done.setAttribute('role', 'status');
      wrap.replaceChildren(done);
    }

    panel.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const chip = target.closest<HTMLElement>('[data-pi-q]');
      if (chip) { ask(chip.dataset.piQ || ''); return; }
      const swapper = target.closest<HTMLElement>('[data-pi-swap]');
      if (swapper) { void swap(Number(swapper.dataset.piSwap)); return; }
      const sharer = target.closest<HTMLElement>('[data-pi-share]');
      if (sharer) { void share(sharer); return; }
      const fb = target.closest<HTMLElement>('[data-pi-fb]');
      if (fb) giveFeedback(fb);
    });
    DESKTOP.addEventListener('change', applyChrome);
    WIDE.addEventListener('change', applyChrome);
    window.addEventListener('scroll', () => { if (!pinFrame) pinFrame = requestAnimationFrame(placeUnderMasthead); }, { passive: true });
    window.addEventListener('resize', placeUnderMasthead, { passive: true });

    // Hand-offs from the rest of the site: links to /ask/?q=..., Ask PI
    // forms, and the search overlay's "Ask PI" row. Modified clicks and the
    // chat's own "Open as a page" link still navigate. Both listeners capture,
    // because Astro's ClientRouter claims same-site links and forms on the way up.
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || onAskPage()) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!a) return;
      // Close before ClientRouter navigation so the persisted chat does not cover
      // the destination. Keep the conversation and leave normal link behaviour alone.
      if (panel.contains(a)) {
        minimise(false);
        return;
      }
      if (a.dataset.piPage || a.target === '_blank') return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin || url.pathname !== '/ask/') return;
      e.preventDefault();
      opener = a;
      (window as any).__piSearchClose?.();
      const q = url.searchParams.get('q');
      if (q) ask(q);
      else if (a.hasAttribute('data-pi-popup')) popUpFrom(a);
      else open();
    }, true); // capture: run before the page router claims the link
    document.addEventListener('submit', (e) => {
      const f = e.target as HTMLFormElement;
      if (f === form || onAskPage() || !f.matches('form[action="/ask/"]')) return;
      const q = (new FormData(f).get('q') || '').toString();
      if (q.trim().length < 3) return;
      e.preventDefault();
      ask(q);
    }, true); // capture, as above

    // A navigation snapshot can sit above the persisted chat and swallow taps
    // and swipes even after the destination is visible. Chat recommendations
    // need an immediately usable destination, not a decorative page fade.
    // Use the actual navigation source, so cancelled/external links cannot
    // accidentally disable a later, unrelated transition.
    document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
      if (event.sourceElement && panel.contains(event.sourceElement)) {
        event.viewTransition.skipTransition();
      }
    });

    // The router swaps <html> attributes on navigation; restore ours.
    document.addEventListener('astro:after-swap', applyChrome);
    document.addEventListener('astro:page-load', () => { applyChrome(); offerHere(); });

    (window as any).PIChat = { open, ask, minimise };

    setMode(store.get(localStorage, MODE) || 'dock');
    render();
    if (store.get(sessionStorage, STATE) === 'open' && !onAskPage()) open(false);
  }
</script>

<style is:global>
  /* Every selector is under .pi-chat or html.pi-chat-*: messages are made by
     script, so Astro's scoped attribute never reaches them. */
  .pi-chat {
    --pi-w: 25rem;
    --pi-cream: #F4EADB;
    --pi-terracotta: #B4532F;
    position: relative;
    z-index: calc(var(--z-chrome) + 100);
  }
  .pi-chat[hidden] { display: none; }
  .pi-chat__sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Launcher */
  .pi-chat__launch {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; gap: var(--space-3);
    min-height: 56px; padding: 6px var(--space-5) 6px 6px;
    background: var(--white); color: var(--text);
    border: 1px solid var(--border); border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px -12px rgba(20, 32, 42, .35), 0 2px 6px -2px rgba(20, 32, 42, .12);
    cursor: pointer; text-align: left;
    transition: transform var(--dur-fast) var(--ease-enter), box-shadow var(--dur-fast) var(--ease-enter), opacity var(--dur-fast);
  }
  .pi-chat__launch:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -14px rgba(20, 32, 42, .42), 0 2px 6px -2px rgba(20, 32, 42, .12); }
  .pi-chat__launch:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .pi-chat[data-state="open"] .pi-chat__launch,
  html.pi-hero-ask .pi-chat__launch { opacity: 0; pointer-events: none; transform: translateY(8px); visibility: hidden; transition: opacity var(--dur-fast), transform var(--dur-fast), visibility 0s linear var(--dur-fast); }
  .pi-chat__launch-face { width: 44px; height: 44px; border-radius: 50%; background: var(--pi-cream); }
  .pi-chat__launch-text { display: grid; line-height: 1.15; }
  .pi-chat__launch-name { font: var(--fw-display) var(--fs-500)/1.1 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-chat__launch-sub { color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-chat__launch-dot {
    position: absolute; top: 6px; left: 40px; width: 10px; height: 10px; border-radius: 50%;
    background: var(--pi-terracotta); box-shadow: 0 0 0 2px var(--white);
    opacity: 0; transform: scale(.4); transition: opacity var(--dur-fast), transform var(--dur-fast);
  }
  .pi-chat__launch.has-thread .pi-chat__launch-dot { opacity: 1; transform: none; }
  /* 2026-11-16: Ask PI lives in the masthead on every page, so the floating launcher
     no longer sits over page text. The button stays in the DOM for the panel's own
     state (aria-expanded, unread dot) and as the fallback focus target. */
  .pi-chat__launch { display: none; }
  /* Phones: the launcher shrinks to her portrait so it never sits over a page's text.
     The name stays in the accessibility tree. */
  @media (max-width: 47.99em) {
    .pi-chat__launch { padding: 5px; gap: 0; }
    .pi-chat__launch-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }

  /* Panel: phone sheet by default */
  .pi-chat__panel {
    position: fixed; inset: 0; display: flex; flex-direction: column;
    background: var(--white); color: var(--text);
    opacity: 0; transform: translateY(24px);
    transition: opacity var(--dur-med) var(--ease-enter), transform var(--dur-med) var(--ease-enter);
  }
  .pi-chat.is-in .pi-chat__panel { opacity: 1; transform: none; }
  .pi-chat__panel[hidden] { display: none; }
  /* A closing sheet must stop swallowing taps before its exit animation ends. */
  .pi-chat[data-state="closed"] .pi-chat__panel { pointer-events: none; }
  html.pi-chat-sheet { overflow: hidden; }

  /* Desktop. Docked (80em and up): a sidebar under the masthead; the page content moves
     aside and the masthead keeps the full width. Below 80em there isn't room for both,
     so "dock" opens as the floating card. */
  @media (min-width: 80em) {
    .pi-chat[data-mode="dock"] .pi-chat__panel {
      inset: var(--pi-top, 0px) 0 0 auto; width: var(--pi-w);
      border-left: 1px solid var(--border);
      transform: translateX(24px);
    }
    html.pi-chat-docked .pi-chat { z-index: calc(var(--z-chrome) - 1); }
    html.pi-chat-docked body { margin-right: var(--pi-w, 25rem); transition: margin-right var(--dur-med) var(--ease-enter); }
    html.pi-chat-docked [data-v5-masthead] { margin-right: calc(-1 * var(--pi-w, 25rem)); }
  }
  @media (min-width: 64em) {
    .pi-chat[data-mode="float"] .pi-chat__panel,
    .pi-chat[data-mode="dock"] .pi-chat__panel:not(.is-docked) {
      inset: auto 24px 24px auto; width: var(--pi-w); height: min(44rem, calc(100dvh - 48px));
      border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden;
      box-shadow: 0 30px 60px -24px rgba(20, 32, 42, .38), 0 4px 12px -4px rgba(20, 32, 42, .12);
      transform: translateY(16px) scale(.98); transform-origin: bottom right;
    }
    /* Opened from the cover badge: a pop-up dialogue that grows from the badge's corner. */
    .pi-chat[data-anchor="badge"] .pi-chat__panel {
      inset: var(--pi-pop-top, 24px) var(--pi-pop-right, 24px) auto auto;
      height: min(40rem, calc(100dvh - var(--pi-pop-top, 24px) - 24px));
      transform: translateY(-10px) scale(.96); transform-origin: top right;
    }
    .pi-chat[data-anchor="badge"] .pi-chat__portrait { width: 120px; height: 120px; margin-bottom: var(--space-3); }
    .pi-chat[data-anchor="badge"] .pi-chat__hello { padding-top: 0; }
    .pi-chat.is-in .pi-chat__panel { transform: none; }
  }

  /* Header */
  .pi-chat__head {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    padding-top: max(var(--space-3), env(safe-area-inset-top));
    border-bottom: 1px solid var(--border);
  }
  .pi-chat__head-face { width: 40px; height: 40px; border-radius: 50%; background: var(--pi-cream); flex: none; }
  .pi-chat__head-id { flex: 1; min-width: 0; }
  .pi-chat__name { margin: 0; font: var(--fw-display) var(--fs-500)/1.1 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-chat__role { margin: 2px 0 0; color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-chat__tools { display: flex; gap: 2px; }
  .pi-chat__tool {
    display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: var(--radius-s);
    background: transparent; color: var(--soft); cursor: pointer;
  }
  .pi-chat__tool:hover { color: var(--text); background: var(--bg-alt); }
  .pi-chat__tool:focus-visible, .pi-chat__chip:focus-visible, .pi-chat__send:focus-visible,
  .pi-chat a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 79.99em) { .pi-chat .pi-chat__tool--mode { display: none; } }
  .pi-chat[data-mode="dock"] .pi-chat__icon-dock, .pi-chat[data-mode="float"] .pi-chat__icon-float { display: none; }

  /* Thread */
  .pi-chat__thread { flex: 1; min-height: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; padding: var(--space-5) var(--space-4) var(--space-6); }
  .pi-chat__hello { text-align: center; padding: var(--space-4) var(--space-2) 0; }
  .pi-chat__hello[hidden] { display: none; }
