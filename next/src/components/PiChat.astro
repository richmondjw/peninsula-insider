  .pi-chat__hello[hidden] { display: none; }
  .pi-chat__portrait { display: block; width: 168px; height: 168px; margin: 0 auto var(--space-4); }
  .pi-chat__hello-lead { margin: 0; font: italic var(--fw-display) var(--fs-600)/1.15 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-chat__hello-body { margin: var(--space-2) auto var(--space-5); max-width: 21rem; color: var(--soft); font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); text-wrap: pretty; }
  .pi-chat__hello .pi-chat__chips { justify-content: center; }

