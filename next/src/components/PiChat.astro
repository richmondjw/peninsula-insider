  .pi-tile__media { display: block; aspect-ratio: 1; border-radius: var(--radius-s); overflow: hidden; background: var(--pi-cream); }
  .pi-tile__media img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 320ms var(--ease-enter), transform var(--dur-med) var(--ease-enter); }
  .pi-tile__media.is-loaded img { opacity: 1; }
  .pi-tile__body { display: grid; gap: 3px; min-width: 0; }
  .pi-tile__section { color: var(--soft); font: 400 var(--fs-200)/1.3 var(--font-ui); }
  .pi-tile__title { font: var(--fw-display) var(--fs-400)/1.2 var(--font-display); }
  .pi-tile__note { color: var(--text); font: italic 500 var(--fs-300)/1.4 var(--font-ui); }
  .pi-tile__fact { color: var(--text); font: 500 var(--fs-200)/1.35 var(--font-ui); }
  .pi-tile__why { color: var(--soft); font: 400 var(--fs-300)/1.4 var(--font-ui); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pi-tile--text .pi-tile__why { -webkit-line-clamp: 3; }
  .pi-tile__credit { margin-top: 2px; color: var(--soft); font: 400 0.6875rem/1.3 var(--font-ui); overflow-wrap: anywhere; }
  .pi-tile__badge { justify-self: start; padding: 1px var(--space-2); border: 1px solid currentColor; border-radius: var(--radius-s); color: var(--pi-terracotta); font: 600 var(--fs-200)/1.4 var(--font-ui); }
  /* Her call */
  .pi-tile--call { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0; overflow: hidden; border-color: color-mix(in srgb, var(--pi-terracotta) 55%, var(--border)); }
  .pi-tile--call .pi-tile__media { aspect-ratio: 16 / 9; border-radius: 0; }
  .pi-tile--call .pi-tile__body { padding: var(--space-3) var(--space-4) var(--space-4); }
  .pi-tile--call .pi-tile__title { font-size: var(--fs-500); }
  .pi-tile--call .pi-tile__why { -webkit-line-clamp: 3; }
  @media (hover: hover) {
    .pi-tile:hover { border-color: var(--text); box-shadow: 0 8px 20px -14px rgba(20, 32, 42, .45); }
    .pi-tile:hover .pi-tile__title { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
    .pi-tile:hover .pi-tile__media img { transform: scale(1.04); }
  }

  /* Thinking is writing: a line of ink drawn along a rule, then lifted. */
  .pi-pen { display: block; width: 10rem; max-width: 60%; height: 1.4rem; margin: 0 0 var(--space-1); overflow: visible; }
  .pi-pen__rule { fill: none; stroke: var(--border); stroke-width: 1; }
  .pi-pen__ink { fill: none; stroke: var(--pi-terracotta); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 230; stroke-dashoffset: 230; animation: pi-write 2.2s ease-in-out infinite; }
  @keyframes pi-write { 0% { stroke-dashoffset: 230; opacity: 1; } 70% { stroke-dashoffset: 0; opacity: 1; } 90%, 100% { stroke-dashoffset: 0; opacity: 0; } }

  /* Her reply as it arrives: each checked sentence settles in behind the last. */
  .pi-say { margin: 0; font: 400 var(--fs-400)/var(--lh-body) var(--font-ui); text-wrap: pretty; }
  .pi-say__s { animation: pi-word 360ms var(--ease-enter) both; }
  @keyframes pi-word { from { opacity: 0; } }
  /* Already read as it arrived: only what follows her words eases in. */
  .pi-msg.is-streamed .pi-msg__by, .pi-msg.is-streamed .pi-msg__prose, .pi-msg.is-streamed .pi-msg__prose p { animation: none; }
  .pi-msg.is-streamed .pi-tiles > li { animation-delay: calc(60ms + var(--pi-i, 0) * 110ms); }
  .pi-msg.is-streamed .pi-msg__small, .pi-msg.is-streamed .pi-msg__offer { animation-delay: 520ms; }
  .pi-msg.is-streamed .pi-msg__next, .pi-msg.is-streamed .pi-msg__fb, .pi-msg.is-streamed .pi-msg__page { animation-delay: 640ms; }

  /* Her call lands like a rubber stamp: down hard, a little skew, then still. */
  @keyframes pi-stamp { 0% { opacity: 0; transform: scale(2.1) rotate(-16deg); } 55% { opacity: 1; transform: scale(.92) rotate(0deg); } 75% { transform: scale(1.04) rotate(-3deg); } 100% { opacity: 1; transform: rotate(-2deg); } }
  .pi-msg.is-arriving .pi-tile__call { animation: pi-stamp 460ms cubic-bezier(.3, .9, .4, 1) both; animation-delay: 620ms; transform-origin: 20% 60%; }
  .pi-msg.is-streamed .pi-tile__call { animation-delay: 320ms; }

  /* PI's call: the pick her checked note names first. */
  .pi-tile__call, .pi-note__stamp { justify-self: start; padding: 1px var(--space-2); border: 1.5px solid currentColor; border-radius: var(--radius-s); color: var(--pi-terracotta); font: 600 var(--fs-200)/1.4 var(--font-ui); letter-spacing: .04em; text-transform: uppercase; transform: rotate(-2deg); }
  .pi-msg__aside { color: var(--soft); font-style: italic; }

  /* A plan: a page from her notebook. Stops are links to published pages. */
  .pi-note { margin-top: var(--space-4); padding: var(--space-4); background: var(--pi-cream); border-radius: var(--radius-m); border-left: 3px solid var(--pi-terracotta); color: var(--text); }
  .pi-note__title { margin: 0 0 var(--space-2); font: var(--fw-display) var(--fs-500)/1.2 var(--font-display); letter-spacing: var(--ls-display); }
  .pi-note__stops { list-style: none; margin: 0; padding: 0; }
  .pi-note__stop { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-2); padding: var(--space-3) 0 var(--space-3) 1.25rem; border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent); }
