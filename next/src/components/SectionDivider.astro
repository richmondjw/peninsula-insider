---
/**
 * SectionDivider — magazine-style section break.
 *
 * A short gold gradient rule centered between two soft rules and a small
 * fleuron in the middle. Used between major sections of long pages where
 * the eye needs a beat of rest. Used sparingly — not between every
 * section, only at meaningful transitions.
 */
export interface Props {
  /** Optional small label (e.g. "II", "ii.", "from the journal") set
   *  centered under the rule. Use sparingly. */
  label?: string;
  /** Use a different glyph (default ✦). Common alternatives: ⁂ ✤ ❦ ❀ ◆ */
  mark?: string;
}
const { label, mark = '✦' } = Astro.props;
---

<div class="section-divider" role="presentation" aria-hidden="true">
  <span class="section-divider__rule"></span>
  <span class="section-divider__mark">{mark}</span>
  <span class="section-divider__rule"></span>
  {label && <p class="section-divider__label">{label}</p>}
</div>
