---
/**
 * PlaceDetailTemplate — canonical place page template (consolidated May 2026).
 *
 * Merges PlaceDetailTemplateV2 (upper structure) with PlaceDetailTemplate v1
 * (mature downstream substance). Resolves the two-template situation into one
 * scalable place experience.
 *
 * Structure:
 *   1. Full-bleed cinematic hero (V2)
 *   2. Editorial lede — 2-col factual prose + At a glance card (V2)
 *   3. Signature pull-quote band (V2)
 *   4. Who this place rewards — fit panel, bestFor/notFor/skip (V1)
 *   5. TL;DR — numbered editorial summary (V1)
 *   6. A Perfect Day — signature PI feature (V1)
 *   7. Chapter navigation — numbered, links to downstream (V2)
 *   8. Scoreboard — what's mapped, with anchor links (V1)
 *   9. Downstream sections: eat, wine, stay, explore, escapes, journal (V1 copy)
 *  10. Service guide links — internal linking + SEO (V1)
 *  11. Location map — lazy Leaflet (V1)
 *  12. Related places (both)
 *  13. Reader submission CTA (V1)
 *  14. Newsletter block
 */

import Breadcrumbs from './Breadcrumbs.astro';
import PlaceCard from './PlaceCard.astro';
import VenueCard from './VenueCard.astro';
import ExperienceCard from './ExperienceCard.astro';
import ItineraryCard from './ItineraryCard.astro';
import ArticleCard from './ArticleCard.astro';
import NewsletterBlock from './NewsletterBlock.astro';
import { titleize, resolveHeroSrc, formatHeroCredit } from '../lib/editorial';
import { editableText, editableImage } from '../lib/inline-edit/attrs';
import { loadOverrides } from '../lib/inline-edit/overrides';

export interface Props {
  place: any;
  eatVenues?: any[];
  wineVenues?: any[];
  stayVenues?: any[];
  experiences?: any[];
  itineraries?: any[];
  articles?: any[];
  relatedPlaces?: any[];
}

const {
  place,
  eatVenues = [],
  wineVenues = [],
  stayVenues = [],
  experiences = [],
  itineraries = [],
  articles = [],
  relatedPlaces = [],
} = Astro.props;

const zoneLabel = titleize(place.data.zone);
const kindLabel = titleize(place.data.kind);
const placeSlug = place.id ?? place.slug ?? place.data?.slug ?? place.data?.id;

// CMS override consult at SSR — if an editor uploaded a place-specific
// hero via the inline editor, it wins over the content-JSON default and
// ships in the static HTML. No client-side swap, no flicker. Restores the
// override propagation the client-side patcher used to provide before
// PR #162 gated it to admin-click.
const placeOverrides = placeSlug ? await loadOverrides('place', placeSlug) : null;
const overrideHero = placeOverrides?.image['hero'];
const heroSrc = overrideHero?.src ?? resolveHeroSrc(place.data);
const heroCredit = formatHeroCredit(place.data.heroImage?.credit);

// Category sub-page lookup — editorial, not file-system-driven.
// Extend this map as new place-specific sub-pages are created.
type SubpageLink = { label: string; href: string; desc: string };
const PLACE_SUBPAGES: Record<string, SubpageLink[]> = {
  'red-hill': [
    { label: 'Red Hill Wine',      href: '/wine/red-hill/',         desc: 'Cellar doors, terroir and the sub-region’s anchor producers' },
    { label: 'Red Hill Stays',     href: '/stay/red-hill/',         desc: 'Vineyard villas, design hotels and hinterland bases' },
  ],
  'main-ridge': [
    { label: 'Main Ridge Wine',    href: '/wine/main-ridge/',       desc: 'Highest-altitude sub-region, small producers and appointment tastings' },
  ],
  'flinders': [
    { label: 'Flinders Wine',      href: '/wine/flinders/',         desc: 'Southern-tip producers, cool climate and coastal cellar doors' },
    { label: 'Flinders Stays',     href: '/stay/flinders/',         desc: 'Coastal accommodation and back-beach bases' },
  ],
  'merricks': [
    { label: 'Merricks Wine',      href: '/wine/merricks/',         desc: 'Benchmark producers in a quiet farming corridor' },
  ],
  'balnarring': [
    { label: 'Balnarring Wine',    href: '/wine/balnarring/',       desc: 'Southern sub-region, appointment-focused producers' },
  ],
  'sorrento': [
    { label: 'Sorrento Stays',     href: '/stay/sorrento/',         desc: 'Tip-of-the-Peninsula accommodation, coastal and heritage' },
  ],
  'mornington': [
    { label: 'Mornington Stays',   href: '/stay/mornington/',       desc: 'Bay-side bases, walkable and good for first-timers' },
  ],
  'cape-schanck': [
    { label: 'Cape Schanck Stays', href: '/stay/cape-schanck/',     desc: 'Southern-tip accommodation with lighthouse and surf access' },
  ],
  'fingal': [
    { label: 'Hot Springs & Wellness', href: '/explore/hot-springs/',          desc: 'Peninsula Hot Springs, thermal pools and spa stays' },
    { label: 'Hot Springs Stays',      href: '/stay/hot-springs-accommodation/', desc: 'Where to stay for a thermal wellness weekend' },
    { label: 'Fingal Golf',            href: '/explore/golf/',                 desc: 'Moonah Links and the best Peninsula courses' },
  ],
  'dromana': [
    { label: 'Arthurs Seat',          href: '/explore/things-to-do/', desc: 'Arthurs Seat Eagle gondola and lookout, family experiences' },
  ],
  'moorooduc': [
    { label: 'Moorooduc Wine',     href: '/wine/moorooduc-tuerong/', desc: 'Dromana-edge sub-region, diverse producers and bay views' },
  ],
};
const placeSubpages: SubpageLink[] = PLACE_SUBPAGES[placeSlug] ?? [];

// Wine sub-page exists for these places — link directly rather than to the hub
const WINE_SUBPAGE_SLUGS = new Set([
  'red-hill', 'main-ridge', 'merricks', 'balnarring', 'flinders', 'moorooduc',
]);
// Stay sub-page exists for these places — link directly
const STAY_SUBPAGE_SLUGS = new Set([
  'red-hill', 'flinders', 'mornington', 'sorrento', 'cape-schanck',
]);
const wineHref = WINE_SUBPAGE_SLUGS.has(placeSlug)
  ? `/wine/${placeSlug}/`
  : '/wine/';
const stayHref = STAY_SUBPAGE_SLUGS.has(placeSlug)
  ? `/stay/${placeSlug}/`
  : '/stay/';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Explore', href: '/explore/' },
  { label: 'Places', href: '/explore/places/' },
  { label: place.data.name },
];

// Chapter navigation — built from what data exists.
// "A perfect day" chapter only added when bestDay is present.
const chapters: { href: string; label: string }[] = [];
if (place.data.bestDay)     chapters.push({ href: '#perfect-day', label: 'A perfect day' });
if (eatVenues.length > 0)   chapters.push({ href: '#eat-drink',   label: 'Eat & drink' });
if (wineVenues.length > 0)  chapters.push({ href: '#wine',        label: 'Wine & producers' });
if (stayVenues.length > 0)  chapters.push({ href: '#stay',        label: 'Stay' });
if (experiences.length > 0) chapters.push({ href: '#explore',     label: 'Explore' });
if (itineraries.length > 0) chapters.push({ href: '#escapes',     label: 'Escape plans' });
if (articles.length > 0)    chapters.push({ href: '#journal',     label: 'From the journal' });

// Scoreboard gate — only shown when at least one downstream section has content.
const hasContent = eatVenues.length > 0 || wineVenues.length > 0 || stayVenues.length > 0
  || experiences.length > 0 || itineraries.length > 0 || articles.length > 0;

// Category-specific local guides linked from this place page.
// Only surfaces guides that actually exist — no placeholder links.
// Maintained here as a data mapping rather than a data field to keep it
// lightweight and easy to extend when new category sub-pages are built.
const categoryGuides: Record<string, Array<{ label: string; href: string; desc: string }>> = {
  'red-hill': [
    { label: 'Red Hill Wine', href: '/wine/red-hill/', desc: 'Cellar doors, terroir, tasting routes and producers on the plateau.' },
  ],
  'main-ridge': [
    { label: 'Main Ridge Wine', href: '/wine/main-ridge/', desc: 'The highest, coolest sub-region — small producers, serious pinot.' },
  ],
  'merricks': [
    { label: 'Merricks Wine', href: '/wine/merricks/', desc: 'Pt. Leo Estate, Stonier, Scorpo and the eastern slope producers.' },
  ],
  'flinders': [
    { label: 'Flinders Wine', href: '/wine/flinders/', desc: 'Southern-edge producers with a cooler, ocean-facing character.' },
  ],
  'balnarring': [
    { label: 'Balnarring Wine', href: '/wine/balnarring/', desc: 'The Western Port edge — Quealy, Hurley and a quieter wine scene.' },
  ],
  'moorooduc': [
    { label: 'Moorooduc & Tuerong Wine', href: '/wine/moorooduc-tuerong/', desc: 'Bay-facing slopes — warmer, more approachable, Yabby Lake country.' },
  ],
};
const placeGuides = categoryGuides[placeSlug] ?? [];

const factual = place.data.factualLede ?? '';
---

<Breadcrumbs items={breadcrumbItems} />

<!-- ═══════════════════════════════════════════════════════════════════════
     1. FULL-BLEED CINEMATIC HERO
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="pdv2-hero" style={`background-image: url(${heroSrc});`}
  {...editableImage({
    entityType: 'place', entitySlug: placeSlug, fieldPath: 'heroImage',
    label: `${place.data.name} hero`, purpose: 'hero',
  })}>
  <div class="pdv2-hero__scrim"></div>
  <div class="pdv2-hero__inner container">
    <p class="pdv2-hero__eyebrow">{zoneLabel} · {kindLabel}</p>
    {place.data.regionSlug && (
      <a
        href={`/explore/regions/${place.data.regionSlug}/`}
        class="pdv2-hero__eyebrow pdv2-hero__region"
        style="display:inline-block;text-decoration:none;border-bottom:1px solid currentColor;margin:2px 0 8px;"
      >{place.data.regionLabel ?? place.data.regionSlug}</a>
    )}
    <h1 class="pdv2-hero__title"
      {...editableText({ entityType: 'place', entitySlug: placeSlug, fieldPath: 'name', label: `${place.data.name} — name` })}
    >{place.data.name}</h1>
    {place.data.heroImage?.alt && (
      <p class="pdv2-hero__alt">{place.data.heroImage.alt}</p>
    )}
  </div>
  {heroCredit && <p class="pdv2-hero__credit">{heroCredit}</p>}
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     2. EDITORIAL LEDE — factual prose + at-a-glance sidebar card
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="pdv2-lede">
  <div class="container pdv2-lede__grid">
    <div class="pdv2-lede__main">
      {factual && (
        <p class="pdv2-lede__factual"
          {...editableText({ entityType: 'place', entitySlug: placeSlug, fieldPath: 'factualLede', label: `${place.data.name} — factual lede` })}>
          {factual}
        </p>
      )}
      {place.data.intro && (
        <p class="pdv2-lede__intro"
          {...editableText({ entityType: 'place', entitySlug: placeSlug, fieldPath: 'intro', label: `${place.data.name} — intro` })}>
          {place.data.intro}
        </p>
      )}
    </div>

    <aside class="pdv2-card" aria-label={`${place.data.name} at a glance`}>
      <p class="pdv2-card__label">At a glance</p>
      <dl class="pdv2-card__list">
        {place.data.driveTime && (
          <div><dt>From Melbourne</dt><dd>{place.data.driveTime}</dd></div>
        )}
        {place.data.bestSeason && (
          <div><dt>Best season</dt><dd>{titleize(place.data.bestSeason)}</dd></div>
        )}
        {place.data.stayDuration && (
          <div><dt>Stay</dt><dd>{place.data.stayDuration}</dd></div>
        )}
        {Array.isArray(place.data.bestFor) && place.data.bestFor.length > 0 && (
          <div><dt>Best for</dt><dd>{place.data.bestFor.slice(0, 2).join(', ')}</dd></div>
        )}
        {place.data.worstTime && (
          <div><dt>Avoid</dt><dd>{place.data.worstTime}</dd></div>
        )}
      </dl>
      {place.data.insiderNote && (
        <p class="pdv2-card__note"><span>Insider</span> {place.data.insiderNote}</p>
      )}
    </aside>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════
     3. SIGNATURE PULL-QUOTE
     ═══════════════════════════════════════════════════════════════════════ -->
{place.data.signature && (
  <section class="pdv2-quote">
    <div class="container">
      <blockquote class="pdv2-quote__text"
        {...editableText({ entityType: 'place', entitySlug: placeSlug, fieldPath: 'signature', label: `${place.data.name} — signature` })}>
        <span class="pdv2-quote__mark" aria-hidden="true">&ldquo;</span>
        {place.data.signature}
      </blockquote>
      <p class="pdv2-quote__byline">Peninsula Insider — editor's note</p>
    </div>
  </section>
)}

<!-- ═══════════════════════════════════════════════════════════════════════
     4. WHO THIS PLACE REWARDS — editorial fit panel
     bestFor / notFor / skip: the most differentiated editorial layer.
     ═══════════════════════════════════════════════════════════════════════ -->
{(place.data.bestFor?.length || place.data.notFor?.length || place.data.skip) && (
  <section class="place-fit">
    <div class="container">
      <div class="place-fit__intro">
        <p class="label label--accent">Is {place.data.name} the right base?</p>
        <h2 class="place-fit__title">Who this place rewards — and who should keep driving</h2>
      </div>
      <div class="place-fit__grid">
        {place.data.bestFor?.length > 0 && (
          <div class="place-fit__col place-fit__col--for">
            <h3 class="place-fit__col-title">It's for</h3>
            <ul class="place-fit__list">
              {place.data.bestFor.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        )}
        {(place.data.notFor?.length || place.data.skip) && (
          <div class="place-fit__col place-fit__col--not">
            {place.data.notFor?.length > 0 && (
              <>
                <h3 class="place-fit__col-title">It's not for</h3>
                <ul class="place-fit__list place-fit__list--not">
                  {place.data.notFor.map((item: string) => <li>{item}</li>)}
                </ul>
              </>
            )}
            {place.data.skip && (
              <blockquote class="place-fit__skip"><p>{place.data.skip}</p></blockquote>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<!-- ═══════════════════════════════════════════════════════════════════════
     5. TL;DR — numbered editorial summary
     ═══════════════════════════════════════════════════════════════════════ -->
{place.data.tldr?.length > 0 && (
  <section class="place-tldr">
    <div class="container">
      <div class="place-tldr__intro">
        <p class="label label--accent">{place.data.name} in brief</p>
        <h2 class="place-tldr__title">{place.data.name} in four lines</h2>
      </div>
      <ol class="place-tldr__list">
        {place.data.tldr.map((item: string, i: number) => (
          <li>
            <span class="place-tldr__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="place-tldr__body">{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<!-- ═══════════════════════════════════════════════════════════════════════
     6. A PERFECT DAY — the signature Peninsula Insider planning feature
     ═══════════════════════════════════════════════════════════════════════ -->
{place.data.bestDay && (
  <section class="place-day" id="perfect-day">
    <div class="container">
      <div class="place-day__intro">
        <p class="label label--accent">A perfect day here</p>
        <h2 class="place-day__title">A day in {place.data.name}</h2>
      </div>
      <p class="place-day__body">{place.data.bestDay}</p>
      {place.data.insiderNote && (
        <blockquote class="place-day__note">
          <p>{place.data.insiderNote}</p>
          <cite>— Editor's note</cite>
        </blockquote>
      )}
    </div>
  </section>
)}

<!-- ═══════════════════════════════════════════════════════════════════════
     7. CHAPTER NAVIGATION — numbered, links to each downstream section
     ═══════════════════════════════════════════════════════════════════════ -->
{chapters.length > 0 && (
  <nav class="pdv2-chapters" aria-label={`${place.data.name} guide contents`}>
    <div class="container">
      <p class="pdv2-chapters__label">In this guide</p>
      <ol class="pdv2-chapters__list">
        {chapters.map((chapter, i) => (
          <li>
            <a href={chapter.href}>
              <span class="pdv2-chapters__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="pdv2-chapters__name">{chapter.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<!-- ═══════════════════════════════════════════════════════════════════════
     8. SCOREBOARD — what's mapped, counts with anchor links
     ═══════════════════════════════════════════════════════════════════════ -->
{hasContent && (
  <section class="place-scoreboard" aria-label={`${place.data.name} contents`}>
    <div class="container">
      <p class="place-scoreboard__label label label--accent">What's mapped here</p>
      <ul class="place-scoreboard__list">
        {eatVenues.length > 0 && (
          <li><a href="#eat-drink"><strong>{eatVenues.length}</strong><span>places to eat</span></a></li>
        )}
        {wineVenues.length > 0 && (
          <li><a href="#wine"><strong>{wineVenues.length}</strong><span>cellar doors & makers</span></a></li>
        )}
        {stayVenues.length > 0 && (
          <li><a href="#stay"><strong>{stayVenues.length}</strong><span>stays</span></a></li>
        )}
        {experiences.length > 0 && (
          <li><a href="#explore"><strong>{experiences.length}</strong><span>ways to explore</span></a></li>
        )}
        {itineraries.length > 0 && (
          <li><a href="#escapes"><strong>{itineraries.length}</strong><span>escape plans</span></a></li>
        )}
        {articles.length > 0 && (
          <li><a href="#journal"><strong>{articles.length}</strong><span>journal pieces</span></a></li>
        )}
      </ul>
    </div>
  </section>
)}

<!-- ═══════════════════════════════════════════════════════════════════════
     8b. EXPLORE BY EXPERIENCE — category-specific local guides
     Connects destination overview to deeper category guides that exist.
     Only renders when placeGuides has entries — no placeholder links.
     ═══════════════════════════════════════════════════════════════════════ -->
{placeGuides.length > 0 && (
  <section class="place-category-guides" aria-label={`${place.data.name} category guides`}>
    <div class="container">
      <div class="place-category-guides__intro">
        <p class="label label--accent">Explore {place.data.name} by experience</p>
        <h2 class="place-category-guides__title">Category guides for {place.data.name}</h2>
        <p class="place-category-guides__sub">Deeper editorial guides focused on one experience category within {place.data.name}.</p>
      </div>
      <ul class="place-category-guides__list">
        {placeGuides.map((guide) => (
          <li class="place-category-guides__item">
            <a href={guide.href} class="place-category-guides__link">
              <span class="place-category-guides__label">{guide.label}</span>
              <span class="place-category-guides__desc">{guide.desc}</span>
              <span class="place-category-guides__cta" aria-hidden="true">Read the guide →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- ═══════════════════════════════════════════════════════════════════════
     9. DOWNSTREAM SECTIONS
     ═══════════════════════════════════════════════════════════════════════ -->

{eatVenues.length > 0 && (
  <section class="venues" id="eat-drink">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Eat & drink</p>
          <h2 class="venues__title">Where to eat and drink in {place.data.name}</h2>
          <p class="venues__sub">Restaurants, cafés, bakeries, and pubs — each with an editor note, not a star rating.</p>
        </div>
        <a href="/eat/" class="venues__link">More to eat in {place.data.name} →</a>
      </div>
      <div class="venues__grid">
        {eatVenues.map((venue) => <VenueCard venue={venue} hrefPrefix="/eat" />)}
      </div>
      <p class="venues__rankings-link">
        <a href="/eat/best-restaurants/">See the editorial rankings → Best Restaurants on the Peninsula</a>
      </p>
    </div>
  </section>
)}

{wineVenues.length > 0 && (
  <section class="venues venues--plain" id="wine">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Wine & producers</p>
          <h2 class="venues__title">Cellar doors and makers around {place.data.name}</h2>
          <p class="venues__sub">The producers worth the appointment — and the ones already shaping the region's vintage conversation.</p>
        </div>
        <a href={wineHref} class="venues__link">{WINE_SUBPAGE_SLUGS.has(placeSlug) ? `${place.data.name} wine guide` : "All cellar doors"} →</a>
      </div>
      <div class="venues__grid">
        {wineVenues.map((venue) => <VenueCard venue={venue} hrefPrefix="/wine" />)}
      </div>
      <p class="venues__rankings-link">
        <a href="/wine/best-cellar-doors/">See the editorial rankings → Best Cellar Doors on the Peninsula</a>
      </p>
    </div>
  </section>
)}

{stayVenues.length > 0 && (
  <section class="venues" id="stay">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Stay</p>
          <h2 class="venues__title">Sleep in {place.data.name}</h2>
          <p class="venues__sub">When a place has a workable bed attached, it stops being a stop and starts becoming a base.</p>
        </div>
        <a href={stayHref} class="venues__link">{STAY_SUBPAGE_SLUGS.has(placeSlug) ? `${place.data.name} stays` : "All stays"} →</a>
      </div>
      <div class="venues__grid">
        {stayVenues.map((venue) => <VenueCard venue={venue} hrefPrefix="/stay" />)}
      </div>
      <p class="venues__rankings-link">
        <a href="/stay/best-accommodation/">See the editorial rankings → Best Places to Stay on the Peninsula</a>
      </p>
    </div>
  </section>
)}

{experiences.length > 0 && (
  <section class="experience-index" id="explore">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Get outside</p>
          <h2 class="venues__title">Explore moves anchored to {place.data.name}</h2>
          <p class="venues__sub">Walks, beaches, lookouts, and markets worth scheduling around the meals.</p>
        </div>
        <a href="/explore/" class="venues__link">Explore near {place.data.name} →</a>
      </div>
      <div class="experience-grid">
        {experiences.map((experience) => <ExperienceCard experience={experience} />)}
      </div>
    </div>
  </section>
)}

{itineraries.length > 0 && (
  <section class="escape-callout" id="escapes">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Use it in sequence</p>
          <h2 class="venues__title">Escapes that already route through {place.data.name}</h2>
          <p class="venues__sub">These plans have been written around the landscape here — not bolted on after.</p>
        </div>
        <a href="/explore/plans/" class="venues__link">Plan a {place.data.name} weekend →</a>
      </div>
      <div class="itinerary-grid">
        {itineraries.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
      </div>
    </div>
  </section>
)}

{articles.length > 0 && (
  <section class="venues venues--plain" id="journal">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Read this place properly</p>
          <h2 class="venues__title">Journal pieces connected to {place.data.name}</h2>
