---
import Breadcrumbs from './Breadcrumbs.astro';
import PlaceCard from './PlaceCard.astro';
import VenueCard from './VenueCard.astro';
import ExperienceCard from './ExperienceCard.astro';
import ItineraryCard from './ItineraryCard.astro';
import ArticleCard from './ArticleCard.astro';
import NewsletterBlock from './NewsletterBlock.astro';
import CorrectionNote from './CorrectionNote.astro';
import { titleize, resolveHeroSrc, formatHeroCredit } from '../lib/editorial';
import { editableText, editableImage } from '../lib/inline-edit/attrs';

export interface Props {
  place: any;
  eatVenues?: any[];
  wineVenues?: any[];
  stayVenues?: any[];
  experiences?: any[];
  itineraries?: any[];
  articles?: any[];
  relatedPlaces?: any[];
  snapshotCards?: { label: string; title: string; body: string; href?: string }[];
}

const {
  place,
  eatVenues = [],
  wineVenues = [],
  stayVenues = [],
  experiences = [],
  itineraries = [],
  articles = [],
  relatedPlaces = [],
  snapshotCards = [],
} = Astro.props;
const zoneLabel = titleize(place.data.zone);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Places', href: '/places' },
  { label: place.data.name },
];

// Map zone to a hero gradient so place pages stop all looking identical.
const zoneGradient: Record<string, string> = {
  'red-hill-plateau': 'hero-grad--hinterland',
  hinterland: 'hero-grad--hinterland',
  bayside: 'hero-grad--bay',
  'ocean-coast': 'hero-grad--sand',
  'back-beaches': 'hero-grad--sand',
  tip: 'hero-grad--stay',
};
const heroGradientClass = zoneGradient[place.data.zone] ?? 'hero-grad--vineyard';
const placeSlug = place.id ?? place.slug ?? place.data?.slug ?? place.data?.id;

// `anchors` is used as a gate for the scoreboard section — if no
// venues/experiences/articles exist at all we hide the scoreboard.
const anchors: { href: string }[] = [];
if (eatVenues.length > 0) anchors.push({ href: '#eat-drink' });
if (wineVenues.length > 0) anchors.push({ href: '#wine' });
if (stayVenues.length > 0) anchors.push({ href: '#stay' });
if (experiences.length > 0) anchors.push({ href: '#explore' });
if (itineraries.length > 0) anchors.push({ href: '#escapes' });
if (articles.length > 0) anchors.push({ href: '#journal' });
// Head metadata (title/description/canonical/og/JSON-LD) is owned by the
// parent page (places/[slug].astro) which passes the correct values to
// BaseLayout. Emitting them here too produced duplicate <title> tags and a
// broken <link rel="canonical" href=".../places/undefined"> on every place
// page (the local var read place.slug, which is undefined; the correct
// property is place.id). Removed 2026-05-01 — see ops/reports/seo/experiments.md
// experiment 2026-05-01-01.
---

<Breadcrumbs items={breadcrumbItems} />

{/* ═══════════════════════════════════════════════════════════════════════
    WAVE 1 — Magazine hero, designed factsheet, fit panel (bestFor/notFor)
    Replaces the old single-column "eyebrow → title → factualLede → intro
    → background-image → tldr → stats DL → nav row" stack. The new top
    section surfaces the editor's voice (signature, bestFor, notFor, skip)
    and reads as a magazine spread rather than a directory header.
═══════════════════════════════════════════════════════════════════════ */}

<!-- HERO — type column + cinematic image column. Stacks at mobile. -->
<section class="place-hero">
  <div class="container">
    <div class="place-hero__grid">
      <div class="place-hero__type">
        <p class="place-hero__eyebrow">{zoneLabel} · {titleize(place.data.kind)}</p>
        <h1
          class="place-hero__title"
          {...editableText({
            entityType: 'place', entitySlug: placeSlug, fieldPath: 'name',
            label: `${place.data.name} — name`,
          })}
        >{place.data.name}</h1>
        {place.data.signature && (
          <p
            class="place-hero__signature"
            {...editableText({
              entityType: 'place', entitySlug: placeSlug, fieldPath: 'signature',
              label: `${place.data.name} — signature line`,
            })}
          >"{place.data.signature}"</p>
        )}
        {place.data.factualLede && (
          <p
            class="place-hero__factual-lede"
            {...editableText({
              entityType: 'place', entitySlug: placeSlug, fieldPath: 'factualLede',
              label: `${place.data.name} — factual lede`,
            })}
          >{place.data.factualLede}</p>
        )}
      </div>
      <figure
        class={`place-hero__image ${heroGradientClass}`}
        {...editableImage({
          entityType: 'place', entitySlug: placeSlug, fieldPath: 'hero',
          label: `${place.data.name} hero`, purpose: 'hero',
        })}
      >
        <img
          src={resolveHeroSrc(place.data)}
          alt={place.data.heroImage?.alt ?? `${place.data.name}, Mornington Peninsula`}
          loading="eager"
          decoding="async"
        />
        {place.data.heroImage?.credit && (
          <figcaption class="place-hero__credit">{formatHeroCredit(place.data.heroImage.credit)}</figcaption>
        )}
      </figure>
    </div>

    <p
      class="place-hero__intro"
      {...editableText({
        entityType: 'place', entitySlug: placeSlug, fieldPath: 'intro',
        label: `${place.data.name} — intro`,
      })}
    >{place.data.intro}</p>
  </div>
</section>

<!-- FACTSHEET — 6-cell designed grid replacing the old <dl> strip. -->
<section class="place-factsheet">
  <div class="container">
    <dl class="place-factsheet__grid">
      {place.data.driveTime && (
        <div class="place-factsheet__cell">
          <dt>From Melbourne</dt>
          <dd>{place.data.driveTime}</dd>
        </div>
      )}
      {place.data.stayDuration && (
        <div class="place-factsheet__cell">
          <dt>Stay duration</dt>
          <dd>{place.data.stayDuration}</dd>
        </div>
      )}
      {place.data.bestSeason && (
        <div class="place-factsheet__cell">
          <dt>Best season</dt>
          <dd>{place.data.bestSeason}</dd>
        </div>
      )}
      <div class="place-factsheet__cell">
        <dt>Zone</dt>
        <dd>{zoneLabel}</dd>
      </div>
      <div class="place-factsheet__cell">
        <dt>Kind</dt>
        <dd>{titleize(place.data.kind)}</dd>
      </div>
      {place.data.worstTime && (
        <div class="place-factsheet__cell">
          <dt>When to skip</dt>
          <dd>{place.data.worstTime}</dd>
        </div>
      )}
    </dl>
  </div>
</section>

<!-- IS IT FOR YOU? — bestFor / notFor panel with skip pull-quote. -->
{(place.data.bestFor?.length || place.data.notFor?.length) && (
  <section class="place-fit">
    <div class="container">
      <div class="place-fit__intro">
        <p class="label label--accent">Is {place.data.name} the right base?</p>
        <h2 class="place-fit__title">Who this place rewards — and who should keep driving</h2>
      </div>
      <div class="place-fit__grid">
        {place.data.bestFor && place.data.bestFor.length > 0 && (
          <div class="place-fit__col place-fit__col--for">
            <h3 class="place-fit__col-title">It's for</h3>
            <ul class="place-fit__list">
              {place.data.bestFor.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
        {(place.data.notFor?.length || place.data.skip) && (
          <div class="place-fit__col place-fit__col--not">
            {place.data.notFor && place.data.notFor.length > 0 && (
              <>
                <h3 class="place-fit__col-title">It's not for</h3>
                <ul class="place-fit__list place-fit__list--not">
                  {place.data.notFor.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </>
            )}
            {place.data.skip && (
              <blockquote class="place-fit__skip">
                <p>{place.data.skip}</p>
              </blockquote>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
)}

{/* ═══════════════════════════════════════════════════════════════════════
    WAVE 2 — Quick take, perfect-day timeline, at-a-glance scoreboard
═══════════════════════════════════════════════════════════════════════ */}

<!-- QUICK TAKE — re-treated TLDR. -->
{place.data.tldr && place.data.tldr.length > 0 && (
  <section class="place-tldr">
    <div class="container">
      <div class="place-tldr__intro">
        <p class="label label--accent">Quick take</p>
        <h2 class="place-tldr__title">{place.data.name} in four lines</h2>
      </div>
      <ol class="place-tldr__list">
        {place.data.tldr.map((item: string, i: number) => (
          <li>
            <span class="place-tldr__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="place-tldr__body">{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<!-- A PERFECT DAY HERE — renders bestDay + insiderNote pull-quote. -->
{place.data.bestDay && (
  <section class="place-day">
    <div class="container">
      <div class="place-day__intro">
        <p class="label label--accent">A perfect day here</p>
        <h2 class="place-day__title">A day in {place.data.name}</h2>
      </div>
      <p class="place-day__body">{place.data.bestDay}</p>
      {place.data.insiderNote && (
        <blockquote class="place-day__note">
          <p>{place.data.insiderNote}</p>
          <cite>— Editor's note</cite>
        </blockquote>
      )}
    </div>
  </section>
)}

<!-- AT-A-GLANCE SCOREBOARD — counts as designed anchor strip. -->
{anchors.length > 0 && (
  <section class="place-scoreboard" aria-label={`${place.data.name} contents`}>
    <div class="container">
      <p class="place-scoreboard__label label label--accent">What's mapped here</p>
      <ul class="place-scoreboard__list">
        {eatVenues.length > 0 && (
          <li><a href="#eat-drink"><strong>{eatVenues.length}</strong><span>places to eat</span></a></li>
        )}
        {wineVenues.length > 0 && (
          <li><a href="#wine"><strong>{wineVenues.length}</strong><span>cellar doors & makers</span></a></li>
        )}
        {stayVenues.length > 0 && (
          <li><a href="#stay"><strong>{stayVenues.length}</strong><span>stays</span></a></li>
        )}
        {experiences.length > 0 && (
          <li><a href="#explore"><strong>{experiences.length}</strong><span>ways to explore</span></a></li>
        )}
        {itineraries.length > 0 && (
          <li><a href="#escapes"><strong>{itineraries.length}</strong><span>escape plans</span></a></li>
        )}
        {articles.length > 0 && (
          <li><a href="#journal"><strong>{articles.length}</strong><span>journal pieces</span></a></li>
        )}
      </ul>
    </div>
  </section>
)}

<section class="place-correction-row">
  <div class="container">
    <CorrectionNote compact={true} />
  </div>
</section>

{snapshotCards.length > 0 && (
  <section class="zone-intro">
    <div class="container">
      <div class="split-intro">
        <div>
          <p class="label label--accent">How this hub works</p>
          <h2 class="split-intro__title">The place layer is now doing real editorial work</h2>
        </div>
        <p class="split-intro__body">Instead of acting like a geography label, the place page connects tables, beds, walks, and weekend logic around one part of the Peninsula.</p>
      </div>
      <div class="zone-intro__grid zone-intro__grid--four">
        {snapshotCards.map((card) => (
          card.href
            ? (
              <a href={card.href} class="zone-card zone-card--link">
                <p class="zone-card__label">{card.label}</p>
                <h3 class="zone-card__title">{card.title}</h3>
                <p class="zone-card__body">{card.body}</p>
              </a>
            )
            : (
              <article class="zone-card">
                <p class="zone-card__label">{card.label}</p>
                <h3 class="zone-card__title">{card.title}</h3>
                <p class="zone-card__body">{card.body}</p>
              </article>
            )
        ))}
      </div>
    </div>
  </section>
)}

{eatVenues.length > 0 && (
  <section class="venues" id="eat-drink">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Eat & drink</p>
          <h2 class="venues__title">Where to eat and drink in {place.data.name}</h2>
          <p class="venues__sub">Restaurants, cafés, bakeries, and pubs  -  each with an editor note, not a star rating.</p>
        </div>
        <a href="/eat/" class="venues__link">All venues →</a>
      </div>
      <div class="venues__grid">
        {eatVenues.map((venue) => <VenueCard venue={venue} hrefPrefix="/eat" />)}
      </div>
      <p class="venues__rankings-link"><a href="/eat/best-restaurants/">See the editorial rankings → Best Restaurants on the Peninsula</a></p>
    </div>
  </section>
)}

{wineVenues.length > 0 && (
  <section class="venues venues--plain" id="wine">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Wine & producers</p>
          <h2 class="venues__title">Cellar doors and makers around {place.data.name}</h2>
          <p class="venues__sub">The producers worth the appointment  -  and the ones already shaping the region's vintage conversation.</p>
        </div>
        <a href="/wine/" class="venues__link">All wine →</a>
      </div>
      <div class="venues__grid">
        {wineVenues.map((venue) => <VenueCard venue={venue} hrefPrefix="/wine" />)}
      </div>
      <p class="venues__rankings-link"><a href="/wine/best-cellar-doors/">See the editorial rankings → Best Cellar Doors on the Peninsula</a></p>
    </div>
  </section>
)}

{stayVenues.length > 0 && (
  <section class="venues" id="stay">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Stay</p>
          <h2 class="venues__title">Sleep in {place.data.name}</h2>
          <p class="venues__sub">When a place has a workable bed attached, it stops being a stop and starts becoming a base.</p>
        </div>
        <a href="/stay/" class="venues__link">All stays →</a>
      </div>
      <div class="venues__grid">
        {stayVenues.map((venue) => <VenueCard venue={venue} hrefPrefix="/stay" />)}
      </div>
      <p class="venues__rankings-link"><a href="/stay/best-accommodation/">See the editorial rankings → Best Places to Stay on the Peninsula</a></p>
    </div>
  </section>
)}

{experiences.length > 0 && (
  <section class="experience-index" id="explore">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Get outside</p>
          <h2 class="venues__title">Explore moves anchored to {place.data.name}</h2>
          <p class="venues__sub">Walks, beaches, lookouts, and markets worth scheduling around the meals.</p>
        </div>
        <a href="/explore/" class="venues__link">Explore all →</a>
      </div>
      <div class="experience-grid">
        {experiences.map((experience) => <ExperienceCard experience={experience} />)}
      </div>
    </div>
  </section>
)}

{itineraries.length > 0 && (
  <section class="escape-callout" id="escapes">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Use it in sequence</p>
          <h2 class="venues__title">Escapes that already route through {place.data.name}</h2>
          <p class="venues__sub">These plans have been written around the landscape here  -  not bolted on after.</p>
        </div>
        <a href="/plans/" class="venues__link">Plans →</a>
      </div>
      <div class="itinerary-grid">
        {itineraries.map((itinerary) => <ItineraryCard itinerary={itinerary} />)}
      </div>
    </div>
  </section>
)}

{articles.length > 0 && (
  <section class="venues venues--plain" id="journal">
    <div class="container">
      <div class="venues__header">
        <div>
          <p class="label label--accent">Read this place properly</p>
          <h2 class="venues__title">Journal pieces connected to {place.data.name}</h2>
        </div>
        <a href="/journal/" class="venues__link">Journal →</a>
      </div>
      <div class="venues__grid">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
)}

{/* Service guide links — connect town pages into the article mesh */}
<section class="venues venues--plain">
  <div class="container">
    <div class="venues__header">
      <div>
        <p class="label label--accent">Planning guides</p>
        <h2 class="venues__title">Service guides for your {place.data.name} trip</h2>
        <p class="venues__sub">Long-form editorial that helps you build a weekend, not just a list of places.</p>
      </div>
      <a href="/journal/" class="venues__link">All guides →</a>
    </div>
    <div class="venues__grid venues__grid--links">
      <a href="/journal/mornington-peninsula-itinerary/" class="venue-card__cta">3-Day Peninsula Itinerary →</a>
      {(place.data.zone === 'red-hill-plateau' || place.data.zone === 'hinterland') && (
        <a href="/journal/mornington-peninsula-winery-tour/" class="venue-card__cta">Self-Drive Winery Tour →</a>
      )}
      {(place.data.zone === 'tip' || place.data.zone === 'back-beaches' || place.data.zone === 'bayside') && (
        <a href="/journal/free-things-to-do-mornington-peninsula/" class="venue-card__cta">Free Things to Do →</a>
      )}
      <a href="/journal/best-brunch-mornington-peninsula/" class="venue-card__cta">Best Brunch Guide →</a>
      <a href="/journal/mornington-peninsula-hot-springs-guide/" class="venue-card__cta">Hot Springs Guide →</a>
      <a href="/journal/mornington-peninsula-in-winter/" class="venue-card__cta">Winter Guide →</a>
      {(place.data.kind === 'town') && (
        <a href="/journal/mornington-peninsula-wedding-venues/" class="venue-card__cta">Wedding Venues →</a>
      )}
      {(place.data.zone === 'ocean-coast' || place.data.zone === 'back-beaches' || place.data.zone === 'tip') && (
        <a href="/golf/" class="venue-card__cta">Best Golf Courses →</a>
      )}
    </div>
  </div>
</section>

{/* ═══════════════════════════════════════════════════════════════════════
    WAVE 3 — Embedded location map
    Leaflet loads lazily via IntersectionObserver so the JS doesn't block
    the page render. Falls back to a static link if Leaflet fails to load.
═══════════════════════════════════════════════════════════════════════ */}
{place.data.coordinates && (
  <section class="place-map" aria-label={`${place.data.name} location`}>
    <div class="container">
      <div class="place-map__intro">
        <p class="label label--accent">Where it sits</p>
        <h2 class="place-map__title">{place.data.name} on the Peninsula</h2>
        <p class="place-map__sub">
          <a href="/map/" class="place-map__full-link">See the full Peninsula map →</a>
        </p>
      </div>
      <div
        class="place-map__embed"
        data-place-map
        data-lat={String(place.data.coordinates.lat)}
        data-lng={String(place.data.coordinates.lng)}
        data-name={place.data.name}
        role="img"
        aria-label={`Map of ${place.data.name} on the Mornington Peninsula`}
      >
        <noscript>
          <p class="place-map__noscript">Enable JavaScript to view the map of {place.data.name}, or <a href="/map/">open the full Peninsula map</a>.</p>
        </noscript>
      </div>
    </div>
  </section>
)}

{relatedPlaces.length > 0 && (
  <section class="places">
    <div class="container">
      <div class="places__header">
        <p class="label label--accent places__label">Keep going</p>
        <h2 class="places__title">Nearby places worth knowing next</h2>
        <p class="places__sub">Because a Peninsula trip is always made up of two or three pockets, not one.</p>
      </div>
      <div class="places__grid">
        {relatedPlaces.map((item, index) => (
          <PlaceCard place={item} variant={index % 2 === 0 ? 'bay' : 'sand'} />
        ))}
      </div>
    </div>
  </section>
)}

<!-- Phase 4 WS4D — reader-contribution CTA. Same shape on every place hub. -->
<aside class="place-submit-cta">
  <div class="container place-submit-cta__inner">
    <p class="place-submit-cta__label">Got a {place.data.name} secret?</p>
    <p class="place-submit-cta__body">If there's a {place.data.name} corner you think we'd cover better with your help — a back-bay swimming hole, a producer's farm-gate, a local pub that hits — send it through. Editorial review, named credit if we publish it.</p>
    <a href="/submit/" class="place-submit-cta__link">Tell us about {place.data.name} →</a>
  </div>
</aside>

<NewsletterBlock />

{/* ═══════════════════════════════════════════════════════════════════════
    Lazy Leaflet bootstrap for the per-place map embed.
    Loads CSS+JS only when the .place-map__embed enters the viewport, so
    initial paint isn't blocked. Idempotent — if Leaflet is already loaded
    (e.g. by the /map/ page during navigation), reuses it. Falls back
    silently if the script fails to load (the noscript message stays in
    place); the user can still click through to the full /map/ page.
═══════════════════════════════════════════════════════════════════════ */}
<script is:inline>
  (function () {
    const LEAFLET_CSS = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    const LEAFLET_JS  = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';

    function ensureLeaflet() {
      if (window._leafletLoading) return window._leafletLoading;
      if (window.L) return Promise.resolve(window.L);
      window._leafletLoading = new Promise((resolve, reject) => {
        if (!document.querySelector('link[data-leaflet]')) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = LEAFLET_CSS;
          link.setAttribute('data-leaflet', '1');
          document.head.appendChild(link);
        }
        const script = document.createElement('script');
        script.src = LEAFLET_JS;
        script.async = true;
        script.onload = () => resolve(window.L);
        script.onerror = reject;
        document.head.appendChild(script);
      });
      return window._leafletLoading;
    }

    function initMap(el) {
      if (el._piMapInit) return;
      el._piMapInit = true;
      const lat = parseFloat(el.dataset.lat);
      const lng = parseFloat(el.dataset.lng);
      const name = el.dataset.name || 'This place';
      if (!isFinite(lat) || !isFinite(lng)) return;

      ensureLeaflet().then((L) => {
        const map = L.map(el, {
          center: [lat, lng],
          zoom: 12,
          scrollWheelZoom: false,
          zoomControl: true,
          attributionControl: true,
        });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 18,
        }).addTo(map);
        L.marker([lat, lng]).addTo(map).bindPopup(name);
      }).catch(() => {
        // Network/library failure — leave the noscript fallback in place.
        el._piMapInit = false;
      });
    }

    function bindMaps() {
      const els = document.querySelectorAll('[data-place-map]:not([data-bound])');
      if (!els.length) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            initMap(e.target);
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: '200px' });
      els.forEach((el) => {
        el.setAttribute('data-bound', '1');
        io.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindMaps);
    } else {
      bindMaps();
    }
