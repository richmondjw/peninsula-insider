---
/**
 * VenueCard  -  the standard editorial card for any venue
 * (restaurant / winery / hotel / stay / etc.)
 *
 * Expects a full Astro content-collection entry from `venues`.
 */

import { resolveHeroSrc, hasOwnHeroImage } from '../lib/editorial';
import { verifiedFreshnessLabel, verificationFreshness } from '../lib/venues';
import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';
import { loadOverrides } from '../lib/inline-edit/overrides';

const typeLabel: Record<string, string> = {
  restaurant:  'Restaurant',
  winery:      'Winery',
  cafe:        'Café',
  bakery:      'Bakery',
  pub:         'Pub',
  brewery:     'Brewery',
  distillery:  'Distillery',
  producer:    'Producer',
  market:      'Market',
  hotel:       'Hotel',
  villa:       'Villa',
  cottage:     'Cottage',
  glamping:    'Glamping',
  'farm-stay': 'Farm Stay',
  spa:         'Spa',
};

export interface Props {
  venue: any;
  /** override the section/route prefix (defaults to /eat) */
  hrefPrefix?: string;
}

const { venue, hrefPrefix = '/eat' } = Astro.props;
const data = venue.data;
const slug = venue.id ?? data.slug;
const href = `${hrefPrefix}/${slug}`;

const placeLabel = String(data.place?.id ?? data.place ?? '')
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const shortAddress = data.address?.split(',').slice(-2).join(',').trim() ?? '';
const hats = data.authority?.hats ?? 0;
const moodTags = Array.isArray(data.tags?.mood) ? data.tags.mood.slice(0, 2) : [];
const summaryLine = [shortAddress, data.priceBand].filter(Boolean).join(' · ');

// Resolve CMS image override at SSR. When an editor has replaced this venue's
// hero via the inline editor, the published row overrides whatever the content
// file specifies — so the rebuilt page renders the new image directly.
const overrides = await loadOverrides('venue', slug);
const heroOverride = overrides.image['heroImage'];
const heroSrc = heroOverride?.src ?? resolveHeroSrc(data);
const heroAlt = heroOverride?.alt ?? data.heroImage?.alt ?? data.name ?? '';
const hasPhoto = !!heroOverride || hasOwnHeroImage(data);
const verifiedLabel = verifiedFreshnessLabel(data.lastVerified);
const verifiedTier = verificationFreshness(data.lastVerified);
---

<article class="venue-card">
  <div class="venue-card__wash"></div>
  <a
    href={href}
    class={`venue-card__hero${hasPhoto ? '' : ' venue-card__hero--placeholder'}`}
    aria-hidden="true"
    tabindex="-1"
    style={hasPhoto ? `background-image: url(${heroSrc})` : undefined}
    {...editableImage({
      entityType: 'venue',
      entitySlug: slug,
      fieldPath: 'heroImage',
      label: `${data.name} hero`,
      purpose: 'hero',
    })}
  ></a>
  <div class="venue-card__top">
    <span class="venue-card__type">
      {typeLabel[data.type] ?? data.type}
    </span>
    <a href={`/places/${data.place?.id ?? data.place}`} class="venue-card__place-link">{placeLabel}</a>
  </div>
  <h3 class="venue-card__name">
    <a href={href}>{data.name}</a>
  </h3>
  {summaryLine && <p class="venue-card__place">{summaryLine}</p>}
  {hats > 0 && (
    <div class="venue-card__hats" aria-label={`${hats} Good Food Guide hat${hats > 1 ? 's' : ''}`}>
      {Array.from({ length: hats }).map(() => (
        <span class="venue-card__hat" aria-hidden="true"></span>
      ))}
    </div>
  )}
  <p class="venue-card__signature">{data.signature}</p>
  {moodTags.length > 0 && (
    <div class="venue-card__tags">
      {moodTags.map((tag: string) => <span class="venue-card__tag">{tag.replace(/-/g, ' ')}</span>)}
    </div>
  )}
  <div class="venue-card__actions">
    <a href={href} class="venue-card__cta">Read notes</a>
    {data.bookingUrl && data.bookingProvider !== 'none' && (
      <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer" class="venue-card__book" onClick={(e: any) => e.stopPropagation()}>{hrefPrefix === '/stay' ? 'View stay' : 'Book'}</a>
    )}
  </div>
  {data.featuredPartner && (
    <p class="venue-card__partner-note">Partner venue</p>
  )}
  <PiSaveActions
    kind="venue"
    slug={slug}
    title={data.name}
    href={href}
    dek={data.signature}
    imageUrl={heroSrc}
  />
</article>

<style>
  .venue-card__partner-note {
    font-size: 0.7rem;
    color: var(--color-text-muted, #9a9a9a);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0.25rem 0 0;
  }
</style>
