---
/**
 * VenueCard  -  the standard editorial card for any venue
 * (restaurant / winery / hotel / stay / etc.)
 *
 * Expects a full Astro content-collection entry from `venues`.
 */

import { verifiedFreshnessLabel, verificationFreshness } from '../lib/venues';
import { informationCheckedOn } from '../lib/verification-date.mjs';
import { routeSlug, venueHref } from '../lib/editorial';
import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';
import { resolveHero } from '../lib/inline-edit/resolve-hero';

const typeLabel: Record<string, string> = {
  restaurant:  'Restaurant',
  winery:      'Winery',
  cafe:        'Café',
  bakery:      'Bakery',
  pub:         'Pub',
  brewery:     'Brewery',
  distillery:  'Distillery',
  producer:    'Producer',
  market:      'Market',
  hotel:       'Hotel',
  villa:       'Villa',
  suite:       'Suite',
  cottage:     'Cottage',
  lodge:       'Lodge',
  glamping:    'Glamping',
  'farm-stay': 'Farm Stay',
  spa:         'Spa',
};

export interface Props {
  venue: any;
  /** override the section/route prefix (defaults to /eat) */
  hrefPrefix?: string;
  /**
   * Full href override for venues whose canonical destination isn't a
   * `${hrefPrefix}/${slug}/` route - e.g. a day spa that lives as an anchor
   * on /explore/spas-and-wellness/ rather than its own page. Takes priority
   * over hrefPrefix so the card links straight at the canonical URL instead
   * of through a redirect stub.
   */
  href?: string;
}

const { venue, hrefPrefix = '/eat', href: hrefOverride } = Astro.props;
const data = venue.data;
// Keep card links on the same canonical slug resolver used by getStaticPaths
// and every venue detail template.  Using the raw collection id here allowed
// cards to diverge from the route when an entry exposed a normalised `slug`.
const slug = routeSlug(venue);
// Normalise the prefix before joining. Callers legitimately hold a trailing
// slash (VenueDetailTemplate's `sectionHref` is "/wine/" for its breadcrumb
// and back-links), and naive interpolation turned that into "/wine//slug/":
// 1,644 hard-404 links across 138 built pages before this guard. (2026-08-18)
const href = hrefOverride ?? venueHref(venue, hrefPrefix);

const placeLabel = String(data.place?.id ?? data.place ?? '')
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const shortAddress = data.address?.split(',').slice(-2).join(',').trim() ?? '';
const hats = data.authority?.hats ?? 0;
/* Dedupe before the slice, otherwise a repeated value in tags.mood spends
   one of the two visible chip slots on a label the reader already sees.
   Case-insensitive and separator-tolerant: the chips render hyphens as
   spaces, so "first-date" and "First Date" are the same chip. */
const moodTagSeen = new Set<string>();
const moodTags: string[] = (Array.isArray(data.tags?.mood) ? data.tags.mood : [])
  .filter((tag: unknown): tag is string => typeof tag === 'string' && tag.trim() !== '')
  .filter((tag: string) => {
    const key = tag.trim().toLowerCase().replace(/[\s_-]+/g, ' ');
    if (moodTagSeen.has(key)) return false;
    moodTagSeen.add(key);
    return true;
  })
  .slice(0, 2);
const summaryLine = shortAddress;

// Resolve CMS image override at SSR. When an editor has replaced this venue's
// hero via the inline editor, the published row overrides whatever the content
// file specifies - so the rebuilt page renders the new image directly.
const hero = await resolveHero('venue', slug, data);
// A CMS replacement is a different photograph. If its own alt or credit is
// missing, use the existing typographic card plate until that upload is reviewed.
// Never borrow the content record's metadata for the replacement.
const hasPhoto = hero.hasPhoto && (hero.override
  ? Boolean(hero.override.alt?.trim() && hero.override.credit?.trim())
  : Boolean(data.heroImage?.credit?.trim()));
const photoCredit = hero.override ? hero.override.credit : data.heroImage?.credit;
const photoNote = hasPhoto && photoCredit
  ? (slug === 'hotel-sorrento' && !hero.override ? 'Exterior photographed in 2006. ' : '') + 'Photo: ' + photoCredit
  : '';
const flindersCommonsPhoto = slug === 'flinders-hotel' && !hero.override && hasPhoto;
const photoSourceUrl = !hero.override && hasPhoto ? data.heroImage?.sourceUrl : undefined;
const photoLicenceUrl = !hero.override && hasPhoto ? data.heroImage?.licenseUrl ?? (flindersCommonsPhoto ? 'https://creativecommons.org/licenses/by-sa/3.0/' : undefined) : undefined;
const verifiedLabel = verifiedFreshnessLabel(informationCheckedOn(data));
const verifiedTier = verificationFreshness(data.lastVerified);
---

<article class="venue-card">
  <div class="venue-card__wash"></div>
  <a
    href={href}
    class={`venue-card__hero${hasPhoto ? '' : ' venue-card__hero--placeholder'}`}
    aria-hidden="true"
    tabindex="-1"
    {...editableImage({
      entityType: 'venue',
      entitySlug: slug,
      fieldPath: 'heroImage',
      label: `${data.name} hero`,
      purpose: 'hero',
    })}
  >{hasPhoto && <img src={hero.src} alt="" loading="lazy" decoding="async" />}</a>
  {photoNote && <p class="venue-card__photo-credit">{photoNote}{photoSourceUrl && <span class="venue-card__photo-links">{' '}<a href={photoSourceUrl} aria-label={data.name + " image source"}>Source</a>{photoLicenceUrl && <><span aria-hidden="true">·</span><a href={photoLicenceUrl} aria-label={data.name + " image licence"}>Licence</a></>}</span>}</p>}
  <div class="venue-card__top">
    <span class="venue-card__type">
      {typeLabel[data.type] ?? data.type}
    </span>
    <a href={`/explore/places/${data.place?.id ?? data.place}/`} class="venue-card__place-link">{placeLabel}</a>
  </div>
  <h3 class="venue-card__name">
    <a href={href}>{data.name}</a>
  </h3>
  {summaryLine && <p class="venue-card__place">{summaryLine}</p>}
  {hats > 0 && (
    <div class="venue-card__hats" aria-label={`${hats} Good Food Guide hat${hats > 1 ? 's' : ''}`}>
      {Array.from({ length: hats }).map(() => (
        <span class="venue-card__hat" aria-hidden="true"></span>
      ))}
    </div>
  )}
  <p class="venue-card__signature">{data.signature}</p>
  {moodTags.length > 0 && (
    <div class="venue-card__tags">
      {moodTags.map((tag: string) => <span class="venue-card__tag">{tag.replace(/-/g, ' ')}</span>)}
    </div>
  )}
  <div class="venue-card__actions">
    <a href={href} class="pi-btn pi-btn--solid">Read notes</a>
    {data.bookingUrl && data.bookingProvider !== 'none' && (
      <a
        href={data.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="pi-btn pi-btn--ghost"
        data-pi-book="booking"
        data-pi-entity-type={data.type}
        data-pi-entity-slug={slug}
        data-pi-surface="venue-card"
        data-pi-provider={data.bookingProvider}
      >{hrefPrefix === '/stay' ? 'View stay' : 'Book'}</a>
    )}
  </div>
  {data.featuredPartner && (
    <p class="venue-card__partner-note">Sponsored placement</p>
  )}
  <PiSaveActions
    kind="venue"
    slug={slug}
    title={data.name}
    href={href}
    dek={data.signature}
    imageUrl={hasPhoto ? hero.src : undefined}
  />
</article>

<style>
  .venue-card__photo-credit { margin: .5rem 1rem 0; color: var(--soft, #5c6267); font: 400 .72rem/1.45 var(--font-ui, sans-serif); }
  .venue-card__photo-links { display: inline-flex; align-items: center; gap: .15rem; margin-left: .35rem; white-space: nowrap; }
  .venue-card__photo-credit a { display: inline-flex; align-items: center; min-height: 1.5rem; padding-inline: .2rem; color: #0B2E4A; text-decoration: underline; text-underline-offset: 2px; }
  .venue-card__photo-credit a:focus-visible { outline: 2px solid #10527E; outline-offset: 2px; }
  .venue-card__partner-note {
    font-size: 0.7rem;
    color: var(--color-text-muted, #9a9a9a);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0.25rem 0 0;
  }
</style>
