---
/**
 * ThreeMissionBar — simplified homepage start panel.
 *
 * One primary job: ask for a useful recommendation. Secondary routes are
 * quiet text links so the homepage no longer stacks competing entry systems.
 */

import type { CollectionEntry } from 'astro:content';
import { eventDateLabel, routeSlug } from '../lib/editorial';

type Event = CollectionEntry<'events'>;

export interface Props {
  /** Date range label, e.g. "31 May - 1 June". From dispatchWeekend(). */
  weekendLabel: string;
  /** href to the current weekend dispatch article. */
  dispatchHref: string;
  /** Up to 3 upcoming events to list in the "This Weekend" link group. */
  events: Event[];
}

const { weekendLabel, dispatchHref, events } = Astro.props;
const visible = events.slice(0, 2);
---

<section class="tmb" aria-label="Start planning">
  <div class="container">
    <div class="tmb__inner">
      <div class="tmb__copy">
        <p class="tmb__eyebrow">Start here</p>
        <h2 class="tmb__heading">Ask for the Peninsula you want.</h2>
        <p class="tmb__dek">A table, walk, beach, cellar door, or full day, narrowed to what is worth doing.</p>
      </div>

      <div class="tmb__action">
        <form class="tmb__form" id="tmb-form" autocomplete="off">
          <label for="tmb-input" class="tmb__visually-hidden">Ask The Insider</label>
          <input
            id="tmb-input"
            class="tmb__input"
            type="text"
            placeholder="Wine lunch, rainy day, dog-friendly beach..."
            maxlength="200"
            data-pi-trigger="true"
          />
          <button type="submit" class="tmb__ask-btn" aria-label="Ask The Insider">
            Ask
          </button>
        </form>

        <nav class="tmb__routes" aria-label="Quick starts">
          <a class="tmb__route" href={dispatchHref}>
            <span>This weekend</span>
            <strong>{weekendLabel}</strong>
          </a>
          <a class="tmb__route" href="/explore/plans/">
            <span>Plans</span>
            <strong>Build the weekend</strong>
          </a>
          {visible.map((event) => {
            const slug = routeSlug(event);
            const hasEnd = Boolean(event.data.endDate);
            const dateStr = hasEnd
              ? eventDateLabel(event.data.startDate, event.data.endDate)
              : eventDateLabel(event.data.startDate);
            return (
              <a class="tmb__route tmb__route--event" href={`/whats-on/${slug}/`}>
                <span>{dateStr}</span>
                <strong>{event.data.title}</strong>
              </a>
            );
          })}
        </nav>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const form = document.getElementById('tmb-form') as HTMLFormElement | null;
    const input = document.getElementById('tmb-input') as HTMLInputElement | null;
    if (!form || !input) return;

    const open = (q: string) => {
      const fn = (window as any).openConcierge;
      if (typeof fn === 'function') {
        fn(q || undefined);
      } else {
        const enc = encodeURIComponent(q);
        window.location.href = q ? `/ask/#q=${enc}` : '/ask/';
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      open(input.value.trim());
    });

    input.addEventListener('focus', () => {
      if (!input.value) open('');
    });
  })();
</script>

<style>
  .tmb {
    background: #f8f5ef;
    border-bottom: 1px solid var(--border);
    padding: clamp(2.4rem, 5vw, 4.5rem) 0;
  }

  .tmb__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .tmb__copy {
    max-width: 29rem;
  }

  .tmb__eyebrow {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.7rem;
  }

  .tmb__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.018em;
    color: var(--text);
    margin: 0;
  }

  .tmb__dek {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    line-height: 1.6;
    color: var(--soft);
    margin: 1rem 0 0;
    max-width: 31rem;
  }

  .tmb__action {
    min-width: 0;
  }

  .tmb__form {
    display: flex;
    gap: 0.65rem;
    padding: 0.45rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: 0 10px 30px -24px rgba(30, 27, 24, 0.28);
  }

  .tmb__input {
    flex: 1;
    min-width: 0;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 1rem;
    color: var(--text);
    background: transparent;
    border: 0;
    padding: 0.7rem 0.75rem 0.7rem 1rem;
    line-height: 1.4;
    outline: none;
  }
  .tmb__input::placeholder { color: rgba(122, 114, 106, 0.78); }

  .tmb__form:focus-within {
    border-color: rgba(139, 78, 59, 0.45);
    box-shadow: 0 0 0 3px rgba(139, 78, 59, 0.08);
  }

  .tmb__ask-btn {
    flex-shrink: 0;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
    background: var(--accent);
    border: none;
    border-radius: 999px;
    padding: 0 1.35rem;
    cursor: pointer;
    min-height: 42px;
    transition: background 0.15s ease;
  }
  .tmb__ask-btn:hover { background: var(--text); }

  .tmb__routes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.1rem;
    border: 1px solid var(--border);
    background: var(--border);
  }

  .tmb__route {
    min-width: 0;
    background: #f8f5ef;
    color: var(--text);
    text-decoration: none;
    padding: 0.95rem 1rem;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .tmb__route:hover {
    background: var(--white);
    color: var(--accent);
  }

  .tmb__route span {
    display: block;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .tmb__route strong {
    display: block;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.35;
    color: inherit;
  }

  .tmb__route--event strong {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tmb__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 980px) {
    .tmb__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .tmb__copy {
      max-width: 42rem;
    }
    .tmb__routes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tmb {
      padding: 2rem 0;
    }
    .tmb__form {
      border-radius: 20px;
      align-items: stretch;
    }
    .tmb__input {
      font-size: 0.94rem;
      padding-left: 0.75rem;
    }
    .tmb__ask-btn {
      padding: 0 1rem;
      min-height: 40px;
    }
    .tmb__routes {
      grid-template-columns: 1fr;
    }
  }
</style>
