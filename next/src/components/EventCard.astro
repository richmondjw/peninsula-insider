---
/**
 * EventCard  -  the primary card for the What's On index.
 *
 * Standard card structure: category, title, location, short description,
 * and CTA. No plain directory rows — every event carries at least one
 * sentence of context.
 */
import PiSaveActions from './PiSaveActions.astro';
import { eventCategoryLabel, routeSlug } from '../lib/editorial';
import { editableImage } from '../lib/inline-edit/attrs';
import { loadOverrides } from '../lib/inline-edit/overrides';

export interface Props {
  event: any;
  featured?: boolean;
  /**
   * Deprecated no-op. Verdict blocks were removed from cards to keep
   * What's On surfaces cleaner and less review-site driven.
   */
  showVerdict?: boolean;
}

const { event, featured = false } = Astro.props;
const slug = routeSlug(event);
const category = event.data.category;

const placeId =
  typeof event.data.place === 'string' ? event.data.place : event.data.place?.id;
const placeLabel = placeId
  ? String(placeId).replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())
  : null;
const placeHref = placeId ? `/places/${placeId}/` : null;

function conciseSummary(value: unknown, maxWords = 22): string {
  const text = String(value ?? '').replace(/\s+/g, ' ').trim();
  if (!text) return '';
  const firstSentence = text.match(/^[^.!?]+[.!?]/)?.[0]?.trim();
  const base = firstSentence && firstSentence.split(/\s+/).length <= maxWords
    ? firstSentence
    : text;
  const words = base.split(/\s+/);
  if (words.length <= maxWords) return base;
  return `${words.slice(0, maxWords).join(' ')}…`;
}
const summary = conciseSummary(event.data.summary);

// Date at-a-glance: prefer recurrenceNote for recurring events;
// fall back to a short formatted startDate for dated events.
function shortDate(d: Date): string {
  return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', timeZone: 'Australia/Melbourne' });
}
const dateLabel: string | null =
  event.data.recurrenceNote
    ? event.data.recurrenceNote
    : event.data.nextOccurrence
    ? shortDate(event.data.nextOccurrence)
    : event.data.startDate
    ? shortDate(event.data.startDate)
    : null;

// CTA label varies by category — editorial voice, not generic "Read more".
const ctaByCategory: Record<string, string> = {
  market: 'Market detail \u2192',
  'food-wine': 'Plan this \u2192',
  'cellar-door': 'Plan this \u2192',
  wellness: 'Plan this \u2192',
  'family-programs': 'Plan this \u2192',
  nature: 'Plan this \u2192',
  festival: 'Read the guide \u2192',
  'live-music': 'Read the guide \u2192',
  exhibition: 'Read the guide \u2192',
  arts: 'Read the guide \u2192',
  'writers-ideas': 'Read the guide \u2192',
  'racing-sport': 'Read the guide \u2192',
  community: 'See the detail \u2192',
  civic: 'See the detail \u2192',
};
const ctaLabel = ctaByCategory[category] ?? 'See the detail \u2192';

const fallbackHeroByCategory: Record<string, string> = {
  'food-wine': '/images/sourced/category-winery-01.webp',
  market: '/images/sourced/category-market-02.webp',
  festival: '/images/sourced/category-market-01.webp',
  'cellar-door': '/images/sourced/category-winery-02.webp',
  community: '/images/sourced/place-mornington-01.webp',
  arts: '/images/sourced/explore-mprg-01.webp',
  wellness: '/images/sourced/spa-coastal-pool-01.webp',
  'live-music': '/images/sourced/article-sunset-01.webp',
  'racing-sport': '/images/sourced/golf-rye-sunrise-01.webp',
  'family-programs': '/images/sourced/article-kids-peninsula-01.webp',
  exhibition: '/images/sourced/explore-mprg-01.webp',
  civic: '/images/sourced/place-mornington-01.webp',
  nature: '/images/sourced/explore-greens-bush-01.webp',
  'writers-ideas': '/images/sourced/article-sorrento-weekend-01.webp',
};
// Resolve CMS image override at SSR — editor replacements survive refresh
// without waiting for a rebuild on tagged slots.
const eventOverrides = await loadOverrides('event', slug);
const eventHeroOverride = eventOverrides.image['heroImage'];
const heroImageSrc = eventHeroOverride?.src
  ?? event.data.heroImage?.src
  ?? fallbackHeroByCategory[category]
  ?? '/images/sourced/category-market-02.webp';
---

<article class={`event-card ${featured ? 'event-card--featured' : ''}`}>
  <a
    href={`/whats-on/${slug}`}
    class="event-card__hero"
    style={`background-image: url(${heroImageSrc});`}
    aria-hidden="true"
    tabindex="-1"
    {...editableImage({
      entityType: 'event',
      entitySlug: slug,
      fieldPath: 'heroImage',
      label: `${event.data.title} hero`,
      purpose: 'hero',
    })}
  ></a>
  <div class="event-card__top">
    <span class="event-card__category">{eventCategoryLabel[category] ?? category}</span>
    {dateLabel && <span class="event-card__date">{dateLabel}</span>}
  </div>
  <h3 class="event-card__name">
    <a href={`/whats-on/${slug}`}>{event.data.title}</a>
  </h3>
  {placeLabel && (
    <p class="event-card__place">
      {placeHref ? <a href={placeHref}>{placeLabel}</a> : placeLabel}
    </p>
  )}
  {summary && (<p class="event-card__summary">{summary}</p>)}
  <div class="event-card__actions">
    <a href={`/whats-on/${slug}`} class="event-card__cta">{ctaLabel}</a>
  </div>
  <PiSaveActions
    kind="event"
    slug={slug}
    title={event.data.title}
    href={`/whats-on/${slug}/`}
    dek={event.data.summary}
    imageUrl={event.data.heroImage?.src}
  />
</article>
