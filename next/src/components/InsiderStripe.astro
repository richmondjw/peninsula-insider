---
/**
 * InsiderStripe, slim mid-page newsletter conversion block.
 *
 * Sits between major sections of the homepage. Two columns on
 * desktop: an editorial pitch on the LEFT (eyebrow, italic
 * standfirst with em accent, supporting line), and the email
 * form RIGHT. Dark surface so it visually punctuates the page
 * rhythm without competing with the lighter editorial sections.
 */
import SubscribeForm from './SubscribeForm.astro';

export interface Props {
  eyebrow?: string;
  /** Headline. <em> tags inside render in italic accent. */
  title?: string;
  /** Supporting copy under the headline. */
  body?: string;
  /** Trust line shown beneath the form. */
  trust?: string;
}

const {
  eyebrow = "The Insider's Dispatch",
  title = "The <em>weekly</em> dispatch lands.",
  body = "One pick, one weather-proof backup, one thing to skip. The weekly email that shapes the weekend ahead, written by editors who live on the Peninsula.",
  trust = '3,500+ Peninsula readers · No spam · One-click unsubscribe',
} = Astro.props;
---

<section class="insider-stripe" aria-label="Subscribe to The Insider's Dispatch">
  <div class="container">
    <div class="insider-stripe__frame">
      <div class="insider-stripe__pitch">
        <p class="insider-stripe__eyebrow">{eyebrow}</p>
        <h2 class="insider-stripe__title" set:html={title} />
        {body && <p class="insider-stripe__body">{body}</p>}
      </div>
      <div class="insider-stripe__form">
        <SubscribeForm variant="dark" source="newsletter-page" />
        {trust && <p class="insider-stripe__trust">{trust}</p>}
      </div>
    </div>
  </div>
</section>
