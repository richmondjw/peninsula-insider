---
/**
 * HomeHeroCarousel — the homepage full-screen cover slider.
 *
 * SINGLE SOURCE OF TRUTH, per slide:
 *   image / text = published CMS override  ->  home-hero-slides.json default
 * Nothing else. No resolveHero, no article-hero derivation, no page/home
 * cover.image, no filename auto-detect. This is what finally stops the
 * "images flip back and forth" problem.
 *
 * How it stays reliable AND editable on the fly:
 *  - Each slide's image + editorial text carry an EXPLICIT inline-edit binding
 *    under a DEDICATED entity slug `home-hero` (never `home`), keyed by the
 *    slide's STABLE id (slide.<id>.image, slide.<id>.headline, ...). Keying by
 *    id (not array index) means reordering / adding / removing slides in the
 *    JSON never re-targets an override onto the wrong slide.
 *  - Because the <img> carries data-pi-edit/-entity-slug/-field-path, the inline
 *    editor's basename auto-detect ("Pass 2" in lib/inline-edit/client.ts) skips
 *    it (`.closest('[data-pi-edit="image"]...')`). That auto-detect was the
 *    sole cause of the edit-mode flip. DO NOT remove the bindings, and there is
 *    NO need to touch client.ts.
 *  - Build-time `loadOverrides('page','home-hero')` bakes published overrides
 *    into the SSR HTML (no flash). For all visitors, BaseLayout's inline
 *    hydration also applies a freshly published slot live, so an edit goes out
 *    instantly and then bakes on the next rebuild.
 *
 * CSS: the `.cover*` rules live in the homepage `<style is:global>` in
 * src/pages/index.astro (kept there deliberately — they depend on load order
 * to neutralise the legacy sitewide /assets/styles.css `.cover` reset). This
 * component owns the markup + carousel script; index.astro owns the styling.
 *
 * To change a slide's DEFAULT image/text or the deck order/links: edit
 * src/data/home-hero-slides.json. To change an image/headline live: use edit
 * mode (right-click the photo / click the text). The JSON stays locked from
 * automation.
 */
import { editableImage, editableText } from '../lib/inline-edit/attrs';
import { loadOverrides } from '../lib/inline-edit/overrides';
import heroSlides from '../data/home-hero-slides.json';

const ENTITY_TYPE = 'page' as const;
const ENTITY_SLUG = 'home-hero';

const slides = heroSlides.slides;

// Stable ids are the override keys — a duplicate would silently collide two
// slides' overrides, so fail the build loudly instead.
const ids = slides.map((s) => s.id);
if (new Set(ids).size !== ids.length) {
  throw new Error('[HomeHeroCarousel] duplicate slide id in home-hero-slides.json');
}

const overrides = await loadOverrides(ENTITY_TYPE, ENTITY_SLUG);

const resolved = slides.map((slide) => {
  const fp = (field: string) => `slide.${slide.id}.${field}`;
  const img = overrides.image[fp('image')];
  return {
    ...slide,
    fp,
    image: img?.src ?? slide.image,
    imageAlt: img?.alt ?? slide.imageAlt,
    headline: overrides.text[fp('headline')] ?? slide.headline,
    dispatch: overrides.text[fp('dispatch')] ?? slide.dispatch,
    label: overrides.text[fp('label')] ?? slide.label,
    hours: overrides.text[fp('hours')] ?? slide.hours,
  };
});
---

{/* ── ZONE 1: Cover carousel — Vivid-style full-screen slides. Full-bleed
    photo, warm-dark scrim, headline + CTA overlaid bottom-left, arrows + dash
    pager in a control strip along the hero's bottom edge. The dispatch
    standfirst shows on desktop only — mobile keeps the headline + CTA economy.
    Images and editorial text are editable in place (see file header). */}
<section class="cover" aria-label="Cover stories">
  <div class="cover__carousel" id="cover-carousel">
    {resolved.map((scene, i) => (
      <div
        class={`cover__slide${i === 0 ? ' is-active' : ''}`}
        data-slide-index={i}
        style={scene.scrim != null ? `--scrim: ${scene.scrim}` : undefined}
      >
        <figure class="cover__media">
          <img
            src={scene.image}
            alt={scene.imageAlt}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            {...editableImage({
              entityType: ENTITY_TYPE,
              entitySlug: ENTITY_SLUG,
              fieldPath: scene.fp('image'),
              purpose: 'hero',
              label: `Hero slide image: ${scene.label}`,
            })}
          />
        </figure>
        <div class="cover__scrim" aria-hidden="true"></div>
        <div class="container cover__overlay">
          <p class="cover__meta">
            <span
              class="cover__chip"
              {...editableText({
                entityType: ENTITY_TYPE,
                entitySlug: ENTITY_SLUG,
                fieldPath: scene.fp('label'),
                label: 'Hero slide tag',
              })}
            >{scene.label}</span>
            <span class="cover__dot" aria-hidden="true">·</span>
            <span
              class="cover__hours"
              {...editableText({
                entityType: ENTITY_TYPE,
                entitySlug: ENTITY_SLUG,
                fieldPath: scene.fp('hours'),
                label: 'Hero slide read time',
              })}
            >{scene.hours}</span>
          </p>
          <a href={scene.primaryHref} class="cover__headline-link">
            {i === 0
              ? <h1
                  class="cover__headline"
                  set:html={scene.headline}
                  {...editableText({
                    entityType: ENTITY_TYPE,
                    entitySlug: ENTITY_SLUG,
                    fieldPath: scene.fp('headline'),
                    label: 'Hero slide headline',
                    kind: 'richtext',
                  })}
                />
              : <p
                  class="cover__headline"
                  set:html={scene.headline}
                  {...editableText({
                    entityType: ENTITY_TYPE,
                    entitySlug: ENTITY_SLUG,
                    fieldPath: scene.fp('headline'),
                    label: 'Hero slide headline',
                    kind: 'richtext',
                  })}
                />
            }
          </a>
          <p
            class="cover__dispatch"
            {...editableText({
              entityType: ENTITY_TYPE,
              entitySlug: ENTITY_SLUG,
              fieldPath: scene.fp('dispatch'),
              label: 'Hero slide standfirst',
            })}
          >{scene.dispatch}</p>
          <a href={scene.primaryHref} class="cover__cta">
            {scene.primaryLabel}
            <svg viewBox="0 0 16 12" width="15" height="11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1 6h13M10 1.5 14.5 6 10 10.5" />
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>

  {/* Control strip — prev/next arrows at the edges, dash pager centred,
      all overlaid on the hero's bottom edge like Vivid Sydney. Accessible
      names carry the story headlines. */}
  <div class="container cover__controls">
    <button class="cover__arrow" type="button" data-cover-prev aria-label="Previous story">
      <svg viewBox="0 0 10 16" width="9" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 1.5 2 8l6 6.5" />
      </svg>
    </button>
    <nav class="cover__nav" aria-label="Switch story">
      {resolved.map((scene, i) => (
        <button
          class={`cover__nav-btn${i === 0 ? ' is-active' : ''}`}
          data-target={i}
          type="button"
          aria-label={`Story ${i + 1} of ${resolved.length}: ${scene.headline.replace(/<[^>]+>/g, '')}`}
        >
          <span class="cover__nav-bar" aria-hidden="true"></span>
        </button>
      ))}
    </nav>
    <button class="cover__arrow" type="button" data-cover-next aria-label="Next story">
      <svg viewBox="0 0 10 16" width="9" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 1.5 8 8l-6 6.5" />
      </svg>
    </button>
  </div>
</section>

{/* Cover carousel controller. Scoped to #cover-carousel, self-guards via
    el.dataset.carouselReady, idempotent across astro:page-load. Moved verbatim
    from index.astro in the 2026-06-18 rebuild — behaviour unchanged. */}
<script is:inline>
  (function () {
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var INTERVAL_MS = 10000;

    function initCarousel(el) {
      if (el.dataset.carouselReady) return; /* guard against double-init */
      var slides = Array.from(el.querySelectorAll('.cover__slide'));
      var navBtns = Array.from(document.querySelectorAll('.cover__nav-btn'));
      if (slides.length < 2) return;

      /* find initial active index from SSR class */
      var current = Math.max(0, slides.findIndex(function(s) { return s.classList.contains('is-active'); }));
      var timer;

      function setInert(slide, on) {
        if (on) { slide.setAttribute('inert', ''); slide.setAttribute('aria-hidden', 'true'); }
        else    { slide.removeAttribute('inert'); slide.removeAttribute('aria-hidden'); }
      }

      function goTo(idx) {
        var prev = current;
        current = ((idx % slides.length) + slides.length) % slides.length;
        if (prev === current) return;

        slides[prev].classList.remove('is-active');
        setInert(slides[prev], true);
        if (navBtns[prev]) navBtns[prev].classList.remove('is-active');

        slides[current].classList.add('is-active');
        setInert(slides[current], false);
        if (navBtns[current]) {
          navBtns[current].classList.remove('is-active');
          void navBtns[current].offsetWidth; /* force reflow to restart progress-bar animation */
          navBtns[current].classList.add('is-active');
        }
      }

      /* initialise inert on non-active slides */
      slides.forEach(function (s, i) { if (i !== current) setInert(s, true); });
      el.dataset.carouselReady = '1';

      /* Size slides to exactly fill the viewport below the (sticky)
         masthead — measure the hero's real offset rather than guessing
         chrome height. CSS defaults cover the no-JS case. */
      var coverEl = el.closest('.cover');
      function sizeCover() {
        var top = Math.max(0, Math.round(coverEl.getBoundingClientRect().top + window.scrollY));
        coverEl.style.setProperty('--masthead-h', top + 'px');
      }
      sizeCover();
      window.addEventListener('resize', sizeCover);
      window.addEventListener('load', sizeCover);
      /* The chrome above the hero reflows late (webfonts, utility row) —
         watch the masthead and also re-measure on a short cascade so a
         missed observer tick can't leave a stale height behind. */
      var mastheadEl = document.querySelector('.masthead');
      if (window.ResizeObserver && mastheadEl) {
        new ResizeObserver(sizeCover).observe(mastheadEl);
      }
      [120, 400, 900, 1800, 3200].forEach(function (ms) { setTimeout(sizeCover, ms); });

      function restartTimer() {
        clearInterval(timer);
        if (!reducedMotion) timer = setInterval(function () { goTo(current + 1); }, INTERVAL_MS);
      }

      navBtns.forEach(function (btn, i) {
        btn.addEventListener('click', function () {
          goTo(i);
          restartTimer();
        });
      });

      /* Prev/next arrows (Vivid-style control strip) */
      var prevBtn = document.querySelector('[data-cover-prev]');
      var nextBtn = document.querySelector('[data-cover-next]');
      if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); restartTimer(); });
      if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); restartTimer(); });

      /* Swipe — horizontal drags switch stories; vertical scrolls pass through. */
      var touchX = null, touchY = null;
      el.addEventListener('touchstart', function (e) {
        touchX = e.touches[0].clientX; touchY = e.touches[0].clientY;
      }, { passive: true });
      el.addEventListener('touchend', function (e) {
        if (touchX === null) return;
        var dx = e.changedTouches[0].clientX - touchX;
        var dy = e.changedTouches[0].clientY - touchY;
        touchX = touchY = null;
        if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        goTo(dx < 0 ? current + 1 : current - 1);
        restartTimer();
      }, { passive: true });

      if (!reducedMotion) {
        timer = setInterval(function () { goTo(current + 1); }, INTERVAL_MS);
      }
    }

    function setup() {
      var el = document.getElementById('cover-carousel');
      if (el) initCarousel(el);
    }
    document.addEventListener('astro:page-load', setup);
    setup();
  })();
</script>
