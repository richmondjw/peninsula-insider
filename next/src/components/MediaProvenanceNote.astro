---
/**
 * MediaProvenanceNote - the visible illustrative-image disclosure.
 *
 * Renders a label beneath an image that the record explicitly marks
 * `depictionStatus: "illustrative"`, and renders absolutely nothing for
 * anything else. Not for `actual`, not for `unverified`, not for a missing
 * image, not for a malformed status string.
 *
 * It is wired into the venue and place hero surfaces and outputs nothing
 * today, because no record in the corpus carries the field yet. That empty
 * state is the design, not an oversight: the same shape as the disclosure
 * tripwire in audit-commercial-firewall.mjs, armed before the first image it
 * has to catch rather than after. When an editor marks the first illustrative
 * image, the disclosure appears on that page in the same commit as the data,
 * with no template change needed and no window in which a marked image ships
 * undisclosed.
 *
 * The wording is assembled in lib/media-provenance.ts from fields the record
 * carries. Nothing here infers what a photograph shows, who made it, or what
 * licence covers it.
 *
 * 2026-10-15 (James, site-wide rule): the explanatory sentence no longer sits
 * in the page as permanent visible prose - it was reading as clutter on card
 * and detail layouts. It still has to be visible to a sighted reader somehow,
 * because that is the entire reason this component exists (see A28 above):
 * an illustrative photo with its explanation ONLY in alt text/metadata is
 * exactly the undisclosed-stock-photo failure this was built to stop. So the
 * compact label stays on the page and carries the full sentence as metadata
 * a sighted reader can still reach - a native `title` tooltip on hover/press
 * - plus a `data-detail` attribute for tooling, while screen-reader users get
 * it via `aria-describedby` on an `sr-only` node so nothing regresses for
 * them either.
 */
import { illustrativeDisclosure, type ProvenanceImage } from '../lib/media-provenance';

export interface Props {
  /** The image record. Anything without an explicit illustrative mark renders nothing. */
  image?: ProvenanceImage | null;
  /** The entity the page is about, used in the disclosure sentence. */
  subject?: string | null;
  /** Optional extra class so a surface can position the note in its own layout. */
  class?: string;
}

const { image = null, subject = null, class: className = '' } = Astro.props;

const disclosure = illustrativeDisclosure(image, subject);
const detailId = disclosure
  ? `media-provenance-detail-${Math.random().toString(36).slice(2, 9)}`
  : undefined;
---

{disclosure && (
  <p class:list={['media-provenance', className]} data-pi-media-disclosure="illustrative">
    <span
      class="media-provenance__label"
      title={disclosure.detail}
      data-detail={disclosure.detail}
      aria-describedby={detailId}
      tabindex="0"
    >
      {disclosure.label}
    </span>
    <span id={detailId} class="sr-only">{disclosure.detail}</span>
  </p>
)}

<style>
  .media-provenance {
    display: flex;
    align-items: baseline;
    margin: 0.35rem 0 0;
  }

  .media-provenance__label {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border: 1px solid currentcolor;
    border-radius: 2px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft, #433d39);
    opacity: 0.85;
    cursor: help;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
