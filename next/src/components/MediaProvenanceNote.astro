---
/** Context photographs retain truthful subject notes. Original illustrations
 * have no visible disclosure; their alt and rights records are preserved. */
import { isOriginalIllustration } from '../lib/illustration-presentation.mjs';
import { illustrativeDisclosure, type ProvenanceImage } from '../lib/media-provenance';

export interface Props {
  /** The image record. Anything without an explicit illustrative mark renders nothing. */
  image?: ProvenanceImage | null;
  /** The entity the page is about, used in the disclosure sentence. */
  subject?: string | null;
  /** Optional extra class so a surface can position the note in its own layout. */
  class?: string;
}

const { image = null, subject = null, class: className = '' } = Astro.props;

const disclosure = isOriginalIllustration(image) ? null : illustrativeDisclosure(image, subject);
---

{disclosure && (
  <p class:list={['media-provenance', className]} data-pi-media-disclosure="illustrative">
    <span class="media-provenance__detail">{disclosure.detail}</span>
  </p>
)}

<style>
  .media-provenance {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft, #433d39);
  }

  .media-provenance__label {
    flex: none;
    padding: 0.1rem 0.45rem;
    border: 1px solid currentcolor;
    border-radius: 2px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .media-provenance__detail {
    flex: 1 1 12rem;
    min-width: 0;
  }
</style>
