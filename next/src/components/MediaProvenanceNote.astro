---
/** One concise description for contextual imagery. Identity/rights stay in source metadata. */
import { illustrativeDisclosure, type ProvenanceImage } from '../lib/media-provenance';

export interface Props {
  /** The image record. Anything without an explicit illustrative mark renders nothing. */
  image?: ProvenanceImage | null;
  /** The entity the page is about, used in the disclosure sentence. */
  subject?: string | null;
  /** Optional extra class so a surface can position the note in its own layout. */
  class?: string;
}

const { image = null, subject = null, class: className = '' } = Astro.props;

const disclosure = illustrativeDisclosure(image, subject);
---

{disclosure && (
  <p class:list={['media-provenance', className]} data-pi-media-disclosure="illustrative">
    {disclosure.label !== 'Illustration' && !disclosure.detail.toLowerCase().startsWith(disclosure.label.toLowerCase()) && <span class="media-provenance__label">{disclosure.label}</span>}
    <span class="media-provenance__detail">{disclosure.detail}</span>
  </p>
)}

<style>
  .media-provenance {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft, #433d39);
  }

  .media-provenance__label {
    flex: none;


    border-radius: 2px;
    font-size: inherit;
    font-weight: 600;


    opacity: 0.85;
  }

  .media-provenance__detail {
    flex: 1 1 12rem;
    min-width: 0;
  }
</style>
