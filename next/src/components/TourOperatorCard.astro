---
/**
 * TourOperatorCard  -  editorial card for a tour operator profile.
 * Expects a full Astro content-collection entry from `tourOperators`.
 */

import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';
import { resolveHero } from '../lib/inline-edit/resolve-hero';

export interface Props {
  operator: any;
}

const { operator } = Astro.props;
const data = operator.data;
const slug = operator.id ?? data.slug;
const href = `/tour/operators/${slug}/`;
const hero = await resolveHero('tour-operator', slug, data);
const showHero = Boolean(hero.override) || Boolean(data.heroImage?.src);

const typeLabel: Record<string, string> = {
  'volume': 'Group Tours',
  'wine-specialist': 'Wine Specialist',
  'premium-private': 'Premium Private',
  'activity-specialist': 'Activity Specialist',
};

const excerpt = data.intro
  ? data.intro.length > 120
    ? data.intro.slice(0, 117) + '...'
    : data.intro
  : '';
---

<article class="tour-card">
  {showHero && (
    <div class="tour-card__image">
      <a href={href} tabindex="-1" aria-hidden="true">
        <img
          src={hero.src}
          alt={hero.alt}
          loading="lazy"
          decoding="async"
          {...editableImage({
            entityType: 'tour-operator',
            entitySlug: slug,
            fieldPath: 'heroImage',
            label: `${data.name} hero`,
            purpose: 'hero',
          })}
        />
      </a>
    </div>
  )}
  <div class="tour-card__body">
    <div class="tour-card__meta">
      {data.operatorType && (
        <span class="tour-card__badge tour-card__badge--accent">
          {typeLabel[data.operatorType] ?? data.operatorType}
        </span>
      )}
      {data.vetted && (
        <span class="tour-card__badge">Verified</span>
      )}
    </div>
    <h3 class="tour-card__name">
      <a href={href}>{data.name}</a>
    </h3>
    <p class="tour-card__excerpt">{excerpt}</p>
    <a href={href} class="tour-card__cta pi-btn pi-btn--text">View operator &rarr;</a>
  </div>
  <PiSaveActions
    kind="tour-operator"
    slug={slug}
    title={data.name}
    href={href}
    dek={excerpt}
    imageUrl={hero.src}
  />
</article>
