---
import { placeLabel, titleize, routeSlug } from '../lib/editorial';
import PiSaveActions from './PiSaveActions.astro';
import { editableImage } from '../lib/inline-edit/attrs';
import { resolveHero } from '../lib/inline-edit/resolve-hero';

const difficultyLabel: Record<string, string> = {
  easy: 'Easy',
  moderate: 'Moderate',
  hard: 'Hard',
};

const typeLabel: Record<string, string> = {
  walk: 'Walk',
  beach: 'Beach',
  wellness: 'Wellness',
  tour: 'Tour',
  attraction: 'Attraction',
  gallery: 'Gallery',
  park: 'Park',
  lookout: 'Lookout',
  market: 'Market',
  workshop: 'Workshop',
};

export interface Props {
  experience: any;
}

const { experience } = Astro.props;
const data = experience.data;
const slug = routeSlug(experience);
const duration = data.durationMinutes ? `${data.durationMinutes} min` : null;
const difficulty = data.difficulty ? difficultyLabel[data.difficulty] ?? titleize(data.difficulty) : null;
const hero = await resolveHero('experience', slug, data);
---

<article class="experience-card">
  <a
    href={`/explore/${slug}/`}
    class={`experience-card__visual experience-card__visual--${data.type}`}
    aria-hidden="true"
    tabindex="-1"
  >
    <img
      src={hero.src}
      alt=""
      loading="lazy"
      decoding="async"
      {...editableImage({
        entityType: 'experience',
        entitySlug: slug,
        fieldPath: 'heroImage',
        label: `${data.name} hero`,
        purpose: 'hero',
      })}
    />
    <div class="experience-card__fog"></div>
    <span class="experience-card__tag">{typeLabel[data.type] ?? titleize(data.type)}</span>
  </a>
  <div class="experience-card__body">
    <div class="experience-card__meta">
      <a href={`/explore/places/${data.place?.id ?? data.place}/`} class="experience-card__place-link">{placeLabel(data.place)}</a>
      {(duration || difficulty) && (
        <span>{[duration, difficulty].filter(Boolean).join(' · ')}</span>
      )}
    </div>
    <h3 class="experience-card__title">
      <a href={`/explore/${slug}/`}>{data.name}</a>
    </h3>
    <p class="experience-card__summary">{data.editorNote}</p>
    <a href={`/explore/${slug}/`} class="experience-card__cta pi-btn pi-btn--text">Open the guide →</a>
  </div>
  <PiSaveActions
    kind="experience"
    slug={slug}
    title={data.name}
    href={`/explore/${slug}/`}
    dek={data.editorNote}
    imageUrl={hero.src}
  />
</article>
