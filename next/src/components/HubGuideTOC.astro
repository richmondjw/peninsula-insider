---
/**
 * HubGuideTOC — sticky in-page table of contents for hub-guide / service
 * / trail-guide / venue-guide articles.
 *
 * Renders a list of anchor links to the article's H2 headings. At desktop
 * (≥1080px) the nav becomes a sticky left rail; at mobile/tablet it
 * collapses to a horizontal scroll bar at the top of the article body.
 *
 * Active-section tracking via IntersectionObserver — the heading currently
 * intersecting the top portion of the viewport gets `is-active` on its
 * TOC link, with a small lookahead so the active state changes just
 * before the heading scrolls past.
 *
 * Idempotent across `astro:page-load` so view transitions don't double-
 * bind observers.
 */
export interface Heading {
  slug: string;
  text: string;
  depth: number;
}
export interface Props {
  headings: Heading[];
  title?: string;
}
const { headings, title = 'On this page' } = Astro.props;
// Only top-level (H2) entries — H3s/H4s would make the rail noisy at
// desktop and unscannable at mobile.
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 0 && (
  <nav class="hub-toc" aria-label="On this page">
    <p class="hub-toc__title">{title}</p>
    <ol class="hub-toc__list">
      {items.map((h) => (
        <li class="hub-toc__item">
          <a href={`#${h.slug}`} class="hub-toc__link" data-toc-link={h.slug}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script is:inline>
  (function () {
    function init() {
      const links = Array.from(document.querySelectorAll('[data-toc-link]'));
      if (!links.length) return;
      // Avoid double-binding across page transitions.
      if (links[0]._piTocBound) return;
      links.forEach(function (l) { l._piTocBound = true; });

      const linkBySlug = new Map();
      links.forEach(function (l) { linkBySlug.set(l.dataset.tocLink, l); });

      const targets = links
        .map(function (l) { return document.getElementById(l.dataset.tocLink); })
        .filter(Boolean);
      if (!targets.length) return;

      function setActive(slug) {
        links.forEach(function (l) { l.classList.remove('is-active'); });
        const a = linkBySlug.get(slug);
        if (a) a.classList.add('is-active');
      }

      // rootMargin tuned so the active state flips when a heading is in
      // the top third of the viewport, rather than only when it's fully
      // visible. Avoids the "nothing is active" gap between sections.
      const io = new IntersectionObserver(function (entries) {
        // Among visible entries, pick the topmost.
        let topmost = null;
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            if (!topmost || e.target.getBoundingClientRect().top < topmost.getBoundingClientRect().top) {
              topmost = e.target;
            }
          }
        });
        if (topmost) setActive(topmost.id);
      }, { rootMargin: '0% 0% -65% 0%', threshold: 0 });

      targets.forEach(function (t) { io.observe(t); });

      // Smooth-scroll on click — overrides the default jump so the
      // sticky masthead doesn't cover the anchor target.
      links.forEach(function (l) {
        l.addEventListener('click', function (e) {
          const slug = l.dataset.tocLink;
          const target = document.getElementById(slug);
          if (!target) return;
          e.preventDefault();
          const top = target.getBoundingClientRect().top + window.scrollY - 90;
          window.scrollTo({ top: top, behavior: 'smooth' });
          history.replaceState(null, '', '#' + slug);
          setActive(slug);
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style>
  /* Mobile / tablet — horizontal scroll bar above the article body. */
  .hub-toc {
    overflow-x: auto;
    padding: 0.85rem 0;
    margin: 0 0 1.75rem;
    border-bottom: 1px solid rgba(121, 92, 58, 0.14);
    -webkit-overflow-scrolling: touch;
  }
  .hub-toc__title { display: none; }
  .hub-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 1.5rem;
    white-space: nowrap;
  }
  .hub-toc__link {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft, #3A3531);
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .hub-toc__link:hover { color: var(--accent, #A0541F); }
  .hub-toc__link.is-active {
    color: var(--accent, #A0541F);
    border-bottom-color: var(--accent, #A0541F);
  }

  /* Desktop — sticky left rail. */
  @media (min-width: 1080px) {
    .hub-toc {
      position: sticky;
      top: 6.5rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      overflow-x: visible;
      padding: 0;
      margin: 0;
      border: 0;
    }
    .hub-toc__title {
      display: block;
      font-family: 'Outfit', system-ui, sans-serif;
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent, #A0541F);
      margin: 0 0 1.15rem;
    }
    .hub-toc__list {
      flex-direction: column;
      gap: 0;
      white-space: normal;
    }
    .hub-toc__item {
      border-left: 2px solid rgba(121, 92, 58, 0.12);
      padding: 0;
    }
    .hub-toc__link {
      display: block;
      padding: 0.5rem 0 0.5rem 1rem;
      border-bottom: none;
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-transform: none;
      line-height: 1.45;
      white-space: normal;
      color: var(--ink-soft, #3A3531);
    }
    .hub-toc__item:has(.hub-toc__link.is-active),
    .hub-toc__item:has(.hub-toc__link:hover) {
      border-left-color: var(--accent, #A0541F);
      background: rgba(160, 84, 31, 0.04);
    }
    .hub-toc__link.is-active,
    .hub-toc__link:hover {
      color: var(--accent, #A0541F);
    }
  }
</style>
