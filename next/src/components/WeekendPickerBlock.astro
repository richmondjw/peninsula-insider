---
/**
 * WeekendPickerBlock - prominent "Peninsula This Weekend" dispatch block
 * rendered at the top of the What's On index and the homepage.
 *
 * Pulls the newest published article with format=weekend-picker and
 * showcases its dek + CTA, plus a simple cadence line to telegraph the
 * weekly editorial rhythm for the weekend ahead.
 *
 * Inline-editable surfaces (Phase B, 2026-05-11):
 *   - Static labels (eyebrow / cadence / CTA labels) → entity '_global'
 *   - Dispatch title + dek → entity_type='article', slug=dispatch.slug
 */

import { editableText } from '../lib/inline-edit/attrs';
import { loadOverrides } from '../lib/inline-edit/overrides';

export interface Props {
  dispatch: any;
  weekend?: string;
}

const { dispatch, weekend } = Astro.props;
const target = '/whats-on/this-weekend/';

// Astro 6 glob-loader collections use `id` as the unique key - no separate
// `slug` property. Falls back to the file id (filename without extension).
const dispatchSlug: string | undefined = dispatch?.slug ?? dispatch?.id;

const globalOv = await loadOverrides('page', '_global');
const articleOv = dispatchSlug ? await loadOverrides('article', dispatchSlug) : { text: {}, image: {} };

// Simplified 2026-06-10 (homepage cognitive-load pass): the eyebrow +
// cadence label column repeated what the kicker and the dispatch title
// already say. One label, one title, one dek, two CTAs.
const ctaPrimary   = globalOv.text['weekend.cta.primary'] ?? "Read this week's dispatch →";
const ctaGhostRaw  = globalOv.text['weekend.cta.ghost']   ?? 'View What’s On →';
const ctaGhost     = /all events/i.test(ctaGhostRaw) ? 'View What’s On →' : ctaGhostRaw;

const dispatchTitle = articleOv.text['title'] ?? dispatch?.data?.title ?? '';
const dispatchDek   = articleOv.text['dek']   ?? dispatch?.data?.dek   ?? '';
---

<section class="weekend-picker" aria-label="Peninsula This Weekend">
  <div class="container">
    <div class="weekend-picker__inner">
      <div class="weekend-picker__content">
        <p class="weekend-picker__kicker">
          {weekend ?? 'This weekend'}
        </p>
        <h2 class="weekend-picker__title">
          <a
            href={target}
            {...(dispatchSlug ? editableText({
              entityType: 'article', entitySlug: dispatchSlug,
              fieldPath: 'title', label: 'Dispatch title',
            }) : {})}
          >{dispatchTitle}</a>
        </h2>
        <p
          class="weekend-picker__dek"
          {...(dispatchSlug ? editableText({
            entityType: 'article', entitySlug: dispatchSlug,
            fieldPath: 'dek', label: 'Dispatch dek',
          }) : {})}
        >{dispatchDek}</p>
      </div>

      <div class="weekend-picker__actions">
        <div class="weekend-picker__ctas">
          <a
            href={target}
            class="weekend-picker__cta pi-btn pi-btn--ghost"
            {...editableText({
              entityType: 'page', entitySlug: '_global',
              fieldPath: 'weekend.cta.primary', label: 'Primary CTA label',
            })}
          >{ctaPrimary}</a>
          <a
            href="/whats-on/"
            class="weekend-picker__cta pi-btn pi-btn--ghost"
            {...editableText({
              entityType: 'page', entitySlug: '_global',
              fieldPath: 'weekend.cta.ghost', label: 'Ghost CTA label',
            })}
          >{ctaGhost}</a>
        </div>
        <p class="weekend-picker__melb">
          Coming from Melbourne?
          <a href="/explore/plans/?intent=melbourne-weekend">Here&rsquo;s where to start →</a>
        </p>
      </div>

    </div>
  </div>
</section>
