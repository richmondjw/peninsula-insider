---
/* UtilityBar — V2 design, top utility ribbon.
   Issue stamp · weekend conditions · Subscribe / About.
   Renders above the masthead site-wide.
   Strangler-fig migration: namespaced .v2-util* so it can coexist with
   any existing V1 utility rules (currently none — but pattern is consistent
   with the V2 newsletter migration).
   CSS inlined so the component is self-contained. */

export interface Props {
  issueMark?: string;
  issueLabel?: string;
  port?: string;
  portTemp?: string;
  sunset?: string;
  nextDispatch?: string;
}

const {
  issueMark = 'Vol 04',
  issueLabel = 'The Autumn Issue · April 2026',
  port = 'Port Phillip',
  portTemp = '16°C',
  sunset = '5:48 pm',
  nextDispatch = 'Wed 6 pm',
} = Astro.props;
---

<div class="v2-util">
  <div class="v2-util__inner">
    <span class="v2-util__issue">
      <span class="v2-util__issue-mark">{issueMark}</span>
      <span set:html={issueLabel} />
    </span>
    <div class="v2-util__now">
      <span><strong>{port}</strong> {portTemp}</span>
      <span><strong>Sunset</strong> {sunset}</span>
      <span><strong>Next dispatch</strong> {nextDispatch}</span>
    </div>
    <div class="v2-util__links">
      <a href="/#newsletter">Subscribe</a>
      <a href="/about/">About</a>
    </div>
  </div>
</div>

<style is:global>
  .v2-util {
    background: var(--deep, #201B17);
    color: rgba(250,247,240,0.72);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(250,247,240,0.08);
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    /* Pinned to the very top of every page, always visible. The
       Masthead has its top offset bumped down by 34px (the bar's
       height) in global.css so they stack cleanly. */
    position: sticky;
    top: 0;
    z-index: 10000;
  }
  .v2-util__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    gap: 1rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }
  .v2-util__issue {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-weight: 400;
    font-style: italic;
    font-size: 0.85rem;
    color: rgba(250,247,240,0.85);
    font-variation-settings: 'opsz' 16;
  }
  .v2-util__issue-mark {
    font-family: var(--sans, 'Inter', system-ui, sans-serif);
    font-style: normal;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold, #B69456);
    padding: 0.18rem 0.5rem;
    border: 1px solid rgba(182,148,86,0.4);
    border-radius: 2px;
  }
  .v2-util__now {
    display: flex;
    gap: 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: rgba(250,247,240,0.55);
  }
  .v2-util__now strong {
    color: rgba(250,247,240,0.85);
    font-weight: 500;
    margin-right: 0.35rem;
  }
  .v2-util__links {
    display: flex;
    gap: 1.1rem;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .v2-util__links a {
    color: rgba(250,247,240,0.55);
    text-decoration: none;
    transition: color .2s ease;
  }
  .v2-util__links a:hover { color: var(--gold, #B69456); }

  @media (max-width: 760px) {
    .v2-util__now { display: none; }
    .v2-util__inner { padding: 0 1rem; }
  }
</style>
