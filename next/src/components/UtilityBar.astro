---
/**
 * UtilityBar - the Peninsula Insider conditions strip.
 *
 * Two brand assets in one row: the conditions read on the left
 * (SORRENTO 16° · SUNSET 5:26 PM · BAY GLASSY, TIDE LOW) and the issue
 * stamp on the right (WINTER INSIDER · JULY 2026). Both shipped in v5 and
 * were dropped in the v6 "Evergreen Coast" migration. Reinstated per the
 * visual design review (finding #1, P0-1 / P0-2): live local sensory data
 * as masthead furniture is the most ownable thing on the site, and the
 * issue stamp is what makes it an edition rather than a database.
 *
 * DATA HONESTY. There is no weather or tide feed in this repo.
 *   - Sunset is computed from the date and the Peninsula's coordinates
 *     (src/lib/sunset.ts). No API, no network, deterministic.
 *   - The issue label is derived from the current date.
 *   - Temperature and the sea/tide read come from the editorially
 *     maintained src/data/conditions.json, and are DROPPED (not faked)
 *     when unset or stale. See src/lib/conditions.ts.
 * The strip therefore degrades to whatever it can honestly say. In the
 * worst case it is just the issue stamp, and that is the correct outcome.
 *
 * Not sticky. The v6 masthead owns `position: sticky; top: 0` in
 * global.css, so the strip sits above it in normal flow and scrolls away
 * like a printed dateline. That avoids fighting the masthead's offset and
 * leaves the --masthead-h measurement in BaseLayout untouched.
 *
 * Styles are scoped to this component (global.css is not ours to edit) and
 * use only v6 tokens: no hardcoded hex.
 */
import { getConditionsStrip } from '../lib/conditions';

export interface Props {
  /** Override the reference instant. Defaults to build time. */
  now?: Date;
}

const { now = new Date() } = Astro.props;
const c = getConditionsStrip(now);

// "Sorrento 16°" reads as one unit; if there is no temperature it is just
// the place, and if there is no place the whole item is dropped.
const placeLabel = c.place && c.temperature
  ? `${c.place} ${c.temperature}°`
  : c.place ?? null;
---

<div class="pi-conditions">
  <div class="pi-conditions__inner">
    {!c.isBare && (
      <p class="pi-conditions__now">
        {placeLabel && (
          <span class="pi-conditions__item pi-conditions__item--place">{placeLabel}</span>
        )}
        {c.sunset && (
          <span class="pi-conditions__item pi-conditions__item--sunset">Sunset {c.sunset}</span>
        )}
        {c.sea && (
          <span class="pi-conditions__item pi-conditions__item--sea">{c.sea}</span>
        )}
      </p>
    )}
    <p class="pi-conditions__issue">
      <span class="pi-conditions__issue-full">{c.issue}</span>
      <span class="pi-conditions__issue-short">{c.issueShort}</span>
    </p>
  </div>
</div>

<style>
  /* Ground: the signature forest-teal. Text colours are the tokenised
     inverse pair, both measured against --bg-dark (#00362C):
       --soft-inverse  7.21:1  (conditions)
       --white        13.14:1  (issue stamp)
     Both clear WCAG AA for normal text (4.5:1) with room to spare. */
  .pi-conditions {
    background: var(--bg-dark);
    color: var(--soft-inverse);
    font-family: var(--font-ui);
    border-bottom: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
    /* viewport-fit=cover: clear the status bar / notch, since this is now
       the topmost painted element on the page. */
    padding-top: env(safe-area-inset-top);
  }

  .pi-conditions__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 34px;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 calc(var(--space-5) + env(safe-area-inset-right)) 0
             calc(var(--space-5) + env(safe-area-inset-left));
  }

  .pi-conditions__now,
  .pi-conditions__issue {
    margin: 0;
    font-size: var(--fs-100);
    font-weight: var(--fw-medium);
    line-height: var(--lh-label);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* The conditions group yields first when space is short; the issue stamp
     never gets pushed off the row. */
  .pi-conditions__now {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
    overflow: hidden;
  }

  /* Separators are generated, so hiding an item at a breakpoint removes its
     separator with it. */
  .pi-conditions__item + .pi-conditions__item::before {
    content: '·';
    margin-right: var(--space-3);
    color: color-mix(in srgb, var(--white) 55%, transparent);
  }

  .pi-conditions__issue {
    flex: none;
    /* Stays right-aligned even when the conditions group is empty. */
    margin-left: auto;
    color: var(--white);
    font-weight: var(--fw-semibold);
  }
  .pi-conditions__issue-short { display: none; }

  /* Tablet: the sea and tide read is the longest and least critical item. */
  @media (max-width: 899px) {
    .pi-conditions__item--sea { display: none; }
  }

  /* Mobile (390px target): reduce to sunset plus a short issue stamp rather
     than squashing four items into one row. `.pi-conditions__item--sunset`
     becomes the first visible item, so its generated separator is cleared
     explicitly (display:none siblings still match the adjacency selector). */
  @media (max-width: 639px) {
    .pi-conditions__item--place { display: none; }
    /* Selector matches the generated-separator rule's specificity (two
       classes plus the pseudo-element) and comes later, so it wins. */
    .pi-conditions__item--place + .pi-conditions__item--sunset::before {
      content: none;
      margin-right: 0;
    }
    .pi-conditions__issue-full { display: none; }
    .pi-conditions__issue-short { display: inline; }
    .pi-conditions__inner {
      gap: var(--space-3);
      padding: 0 calc(var(--space-4) + env(safe-area-inset-right)) 0
               calc(var(--space-4) + env(safe-area-inset-left));
    }
  }

  /* The strip is furniture, not content: it adds nothing to a printed page. */
  @media print {
    .pi-conditions { display: none; }
  }
</style>
