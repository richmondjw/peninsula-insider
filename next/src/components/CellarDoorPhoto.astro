---
import { resolveHero } from '../lib/inline-edit/resolve-hero';
import { reviewedCellarPhoto } from '../lib/cellar-door-media.mjs';
const { venue, eager = false } = Astro.props;
const photo = reviewedCellarPhoto(venue.data);
// CMS uploads lack the full rights/subject record required here. Resolve the
// reviewed source through the shared resolver and retain its own metadata.
const hero = photo ? await resolveHero('venue', venue.data.slug, {...venue.data, heroImage:photo}, 'heroImage', {ignoreOverride:true}) : null;
---
<figure class="cellar-photo" data-cellar-photo>
  <div class="cellar-photo__frame">
    {hero && <img src={hero.src} alt={hero.alt} width="1200" height="800" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" data-pi-avif="true" data-pi-avif-quality="35" data-pi-responsive="(max-width: 700px) calc(100vw - 32px), (max-width: 1200px) 50vw, 600px" data-pi-no-hydrate />}
    <p class="cellar-photo__unavailable" hidden={Boolean(hero)}>Photograph unavailable. Visit details remain below.</p>
  </div>
  {photo && <figcaption><span>{photo.caption}</span> Photo: {photo.credit}. <a href="/photography/" aria-label={`Credits & rights for ${venue.data.name} photography`}>Credits & rights</a></figcaption>}
</figure>
<style>
  .cellar-photo { margin:0; min-width:0; }
  .cellar-photo__frame { aspect-ratio:3/2; background:#e6ecef; overflow:hidden; }
  img { width:100%; height:100%; object-fit:cover; display:block; } img[hidden] { display:none; }
  figcaption { font:400 13px/1.5 var(--font-ui); color:#465460; padding:8px 0; }
  figcaption>span { display:block; }
  figcaption a { color:#10527e; text-decoration:underline; display:inline-flex; align-items:center; min-height:44px; }
  .cellar-photo__unavailable { padding:2rem; color:#0b2e4a; }
</style>
