---
/**
 * PiSaveActions - card-level Save + Share affordance.
 *
 * Standardised across every card type on Peninsula Insider: positioned
 * bottom-right, icon-only, with a hover label on desktop. Save toggles
 * the unified pi:saves:v2 store; Share invokes the native share sheet on
 * supported devices and falls back to copy-link on desktop.
 *
 * Wave 2 of the Save & Share rebuild. Wave 3 builds the article-level
 * equivalent (`<PiArticleActions />`) for journal pieces; this card-level
 * surface stays as-is across both passes.
 *
 * Usage:
 *   <PiSaveActions
 *     kind="venue"
 *     slug="laura"
 *     title="Laura"
 *     dek="..."
 *     imageUrl="/images/..."
 *     href="/eat/laura-pt-leo/"
 *   />
 */

export interface Props {
  /** Save kind - articles, venues, places, events, experiences, itineraries, tours, operators, packages. */
  kind: 'article' | 'venue' | 'place' | 'event' | 'experience' | 'itinerary' | 'tour' | 'tour-operator' | 'tour-package';
  slug: string;
  title: string;
  href: string;
  /** Editorial section, required for articles. */
  section?: string;
  /** Short summary; carried into the saved-plan view. */
  dek?: string;
  /** Cover image; carried into the saved-plan view and the share preview. */
  imageUrl?: string;
  /**
   * When true (default), the actions float absolutely in the bottom-right
   * of the nearest positioned ancestor (typically the card). The card needs
   * `position: relative` on its root for this to anchor correctly. Set to
   * false to render inline inside an existing actions row.
   */
  floating?: boolean;
}

const { kind, slug, title, href, section, dek, imageUrl, floating = true } = Astro.props;
---

<div
  class:list={['pi-actions', floating && 'pi-actions--floating']}
  data-pi-actions
  data-pi-kind={kind}
  data-pi-slug={slug}
  data-pi-section={section}
  data-pi-title={title}
  data-pi-dek={dek}
  data-pi-image={imageUrl}
  data-pi-href={href}
>
  <button
    type="button"
    class="pi-actions__btn pi-actions__btn--save"
    aria-pressed="false"
    aria-label={`Save ${title}`}
    data-pi-save
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
    </svg>
    <span class="pi-actions__label">Save</span>
  </button>
  <button
    type="button"
    class="pi-actions__btn pi-actions__btn--share"
    aria-label={`Share ${title}`}
    data-pi-share
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
      <polyline points="16 6 12 2 8 6" />
      <line x1="12" y1="2" x2="12" y2="15" />
    </svg>
    <span class="pi-actions__label">Share</span>
  </button>
  <span class="pi-actions__status" role="status" aria-live="polite" data-pi-status></span>
</div>

<style is:global>
  .pi-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .pi-actions__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Floating placement: bottom-right of the nearest positioned ancestor.
     Cards must have `position: relative` for this to anchor correctly. */
  .pi-actions--floating {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    z-index: 3;
  }

  /* Floating controls need their own footer space. The shared cards used to
     reserve about 3.25rem for 32px buttons; 44px targets need 4rem so they
     clear the last link even when the card's actions wrap on narrow phones. */
  .venue-card:has(> .pi-actions--floating) { padding-bottom: 4rem; }
  .experience-card:has(> .pi-actions--floating) .experience-card__body,
  .tour-card:has(> .pi-actions--floating) .tour-card__body,
  .place-card:has(> .pi-actions--floating) .place-card__body { padding-bottom: 4rem; }
  .event-card:has(.pi-actions--floating) .event-card__cta { padding-bottom: 4rem; }

  .pi-actions__btn {
    appearance: none;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 999px;
    color: var(--ink-soft, #3A3531);

    /* Height is fixed; width is controlled by max-width so CSS can
       transition smoothly between collapsed (circle) and expanded (pill).
       `width: auto` + `max-width: 2.75rem` starts as a circle; expanding
       max-width to a concrete value gives the browser a fully transitionable
       range - unlike `width: 2.75rem → width: auto` which snaps and flickers. */
    height: 2.75rem;
    min-width: 2.75rem;
    max-width: 2.75rem;
    width: 2.75rem;

    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Collapsed state: no gap, so the icon sits truly centred in the circle.
       Hover state below restores the gap when the pill expands and the label
       becomes visible. */
    gap: 0;
    cursor: pointer;
    overflow: hidden;
    white-space: nowrap;

    transition:
      max-width    0.24s cubic-bezier(0.4, 0, 0.2, 1),
      padding      0.24s cubic-bezier(0.4, 0, 0.2, 1),
      background   0.18s ease,
      border-color 0.18s ease,
      color        0.18s ease,
      transform    0.08s ease;

    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Keep the icon from shrinking when the label appears */
  .pi-actions__btn svg {
    flex-shrink: 0;
  }

  .pi-actions__btn:hover {
    border-color: rgba(11, 90, 72, 0.4);
    color: var(--ochre, #26997e);
  }

  .pi-actions__btn:active { transform: scale(0.95); }

  /* Hover label - desktop only. Fades in after the button has started
     expanding so text never appears clipped mid-animation.
     `max-width: 0` is critical: `opacity: 0` alone does not remove the
     element from the flex layout, so the label would still claim its
     natural text width and shove the icon off-centre inside the 2.75rem
     collapsed circle. Zeroing max-width + overflow:hidden makes the
     label contribute zero width when collapsed; the icon then sits
     truly centred. */
  .pi-actions__label {
    opacity: 0;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
    transition:
      opacity   0.14s ease 0.12s,
      max-width 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .pi-actions__btn:hover {
      width: auto;
      max-width: 8rem;
      padding: 0 0.9rem 0 0.7rem;
      gap: 0.45rem;
    }
    .pi-actions__btn:hover .pi-actions__label {
      opacity: 1;
      max-width: 6rem;
    }
  }

  /* Saved state - solid ink fill, paper text */
  .pi-actions__btn--save[aria-pressed="true"] {
    background: var(--ink, #171413);
    color: var(--paper, #FAF7F0);
    border-color: var(--ink, #171413);
  }
  .pi-actions__btn--save[aria-pressed="true"] svg path {
    fill: var(--paper, #FAF7F0);
  }
  .pi-actions__btn--save[aria-pressed="true"]:hover {
    background: var(--ochre, #26997e);
    border-color: var(--ochre, #26997e);
    color: var(--paper, #FAF7F0);
  }

  /* Mid-flight share state - brief outcome feedback. */
  .pi-actions__btn--share[data-feedback] {
    background: var(--ochre, #26997e);
    color: var(--paper, #FAF7F0);
    border-color: var(--ochre, #26997e);
  }
  .pi-copy-dialog {
    position: fixed;
    inset: 0;
    width: min(28rem, calc(100vw - 2rem));
    height: fit-content;
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow: auto;
    border: 1px solid #B9C6C8;
    border-radius: 0.75rem;
    padding: 1.5rem;
    background: #FFFFFF;
    color: #14202A;
    box-shadow: 0 1rem 3rem rgba(11, 46, 74, 0.22);
    font-family: var(--font-ui, sans-serif);
  }
  .pi-copy-dialog::backdrop { background: rgba(11, 46, 74, 0.58); }
  .pi-copy-dialog h2 { margin: 0 0 .5rem; font: 600 1.55rem/1.2 var(--font-display, serif); }
  .pi-copy-dialog p { margin: 0 0 1rem; line-height: 1.5; }
  .pi-copy-dialog label { display: block; margin-bottom: .35rem; font-weight: 700; }
  .pi-copy-dialog input { box-sizing: border-box; width: 100%; min-height: 44px; padding: .6rem; border: 1px solid #607781; border-radius: .25rem; font: 400 1rem/1.3 var(--font-ui, sans-serif); }
  .pi-copy-dialog__actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; }
  .pi-copy-dialog button { min-height: 44px; padding: .6rem 1rem; border: 1px solid #0B2E4A; border-radius: .25rem; background: #FFFFFF; color: #0B2E4A; font: 700 .9rem/1.2 var(--font-ui, sans-serif); cursor: pointer; }
  .pi-copy-dialog button[data-pi-select-link] { background: #0B2E4A; color: #FFFFFF; }
  .pi-copy-dialog :focus-visible { outline: 3px solid #10527E; outline-offset: 2px; }
</style>

<script>
  import * as Saves from '../lib/saves/store';
  import type { SaveKind } from '../lib/saves/store';
  import { track } from '../lib/saves/analytics';
  import { emit } from '../lib/analytics-events';

  function hydrate(el: HTMLElement) {
    if ((el as any)._piInit) return;
    (el as any)._piInit = true;

    const kind = el.dataset.piKind as SaveKind;
    const slug = el.dataset.piSlug;
    const title = el.dataset.piTitle || slug || '';
    const href = el.dataset.piHref || (typeof location !== 'undefined' ? location.pathname : '/');
    const section = el.dataset.piSection;
    const dek = el.dataset.piDek;
    const image_url = el.dataset.piImage;
    if (!kind || !slug) return;

    const saveBtn = el.querySelector<HTMLButtonElement>('[data-pi-save]');
    const shareBtn = el.querySelector<HTMLButtonElement>('[data-pi-share]');

    function paint() {
      if (!saveBtn) return;
      const saved = Saves.isSaved(kind, slug!);
      saveBtn.setAttribute('aria-pressed', saved ? 'true' : 'false');
      const label = saveBtn.querySelector<HTMLElement>('.pi-actions__label');
      if (label) label.textContent = saved ? 'Saved' : 'Save';
    }

    saveBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const wasSaved = Saves.isSaved(kind, slug!);
      const result = Saves.toggle({ kind, slug: slug!, section, title, dek, image_url, href });
      if (!result.ok) {
        // Private mode / quota: the save did not land, so do not paint it.
        showFeedback(saveBtn!, 'Not saved');
        // PI-024: this branch was silent. A store that refuses every write
        // looked identical to a reader who never tried to save, which is the
        // single worst thing a save funnel can be blind to.
        emit(
          wasSaved ? 'unsave_failed' : 'save_failed',
          {
            entity_type: kind,
            entity_id: slug,
            section,
            surface: 'card',
            // The store reports ok/saved and no cause. Private-mode and quota
            // both land here; distinguishing them needs a change to
            // lib/saves/store.ts, which this ticket must not touch.
            reason: 'store-rejected',
          },
          { component: 'PiSaveActions' },
        );
        return;
      }
      track(wasSaved ? 'pi_unsave' : 'pi_save', {
        kind,
        slug,
        section,
        surface: 'card',
      });
      // save_succeeded is the contract event and fires only for an ADD that
      // the store confirmed. An unsave is not a save; it gets its own name so
      // no dashboard can quietly add the two together.
      emit(
        wasSaved ? 'unsave_succeeded' : 'save_succeeded',
        { entity_type: kind, entity_id: slug, section, surface: 'card' },
        { component: 'PiSaveActions', dedupKey: 'save:' + kind + ':' + slug },
      );
    });

    shareBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const url = new URL(href, location.origin).toString();
      const shareData: ShareData = { title: `${title} · Peninsula Insider`, text: dek, url };

      // Prefer the native share sheet. Fall through to clipboard only if
      // the payload is unsupported; closing the sheet leaves the page alone.
      if (typeof (navigator as any).share === 'function') {
        try {
          await (navigator as any).share(shareData);
          showFeedback(shareBtn!, 'Shared');
          track('pi_share_item', { kind, slug, section, surface: 'card', method: 'native' });
          return;
        } catch (error) {
          // Closing the native sheet is a choice, not a request to copy instead.
          if (error instanceof DOMException && error.name === 'AbortError') return;
          // Unsupported payloads can still use the clipboard fallback.
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        showFeedback(shareBtn!, 'Copied');
        track('pi_share_item', { kind, slug, section, surface: 'card', method: 'copy' });
      } catch {
        showFeedback(shareBtn!, 'Copy manually');
        showManualCopy(url, shareBtn!);
      }
    });

    paint();
    Saves.onChange(paint);
  }

  function showManualCopy(url: string, originButton: HTMLButtonElement) {
    const dialog = document.createElement('dialog');
    dialog.className = 'pi-copy-dialog';
    dialog.setAttribute('aria-labelledby', 'pi-copy-dialog-heading');
    dialog.innerHTML = `
      <h2 id="pi-copy-dialog-heading">Copy this link</h2>
      <p>Automatic copying is unavailable. Select the link below, then use your device's Copy command.</p>
      <label for="pi-copy-dialog-link">Page link</label>
      <input id="pi-copy-dialog-link" type="url" readonly spellcheck="false">
      <div class="pi-copy-dialog__actions">
        <button type="button" data-pi-select-link>Select link</button>
        <button type="button" data-pi-close>Close</button>
      </div>`;
    const input = dialog.querySelector<HTMLInputElement>('input')!;
    input.value = url;
    const selectLink = () => { input.focus(); input.select(); };
    dialog.querySelector('[data-pi-select-link]')?.addEventListener('click', selectLink);
    dialog.querySelector('[data-pi-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      dialog.remove();
      originButton.focus();
    }, { once: true });
    document.body.append(dialog);
    if (typeof dialog.showModal === 'function') {
      dialog.showModal();
      selectLink();
    } else {
      window.prompt('Copy this link', url);
      dialog.remove();
      originButton.focus();
    }
  }

  const feedbackTimers = new WeakMap<HTMLButtonElement, number>();

  function showFeedback(btn: HTMLButtonElement, text: string, persistent = false) {
    const previousTimer = feedbackTimers.get(btn);
    if (previousTimer) window.clearTimeout(previousTimer);
    const label = btn.querySelector<HTMLElement>('.pi-actions__label');
    const originalLabel = btn.dataset.piOriginalLabel || label?.textContent || 'Share';
    const originalAria = btn.dataset.piOriginalAria || btn.getAttribute('aria-label') || originalLabel;
    btn.dataset.piOriginalLabel = originalLabel;
    btn.dataset.piOriginalAria = originalAria;
    const message = text === 'Copied' ? 'Link copied to clipboard.'
      : text === 'Shared' ? 'Share completed.'
      : text === 'Not saved' ? 'Could not save this item.'
      : text === 'Copy manually' ? 'Automatic copying is unavailable. Select the link in the dialog.'
      : 'Could not copy this link.';
    btn.setAttribute('data-feedback', text);
    btn.setAttribute('aria-label', message);
    if (label) label.textContent = text;
    const status = btn.closest('[data-pi-actions]')?.querySelector<HTMLElement>('[data-pi-status]');
    if (status) status.textContent = message;
    if (persistent) return;
    feedbackTimers.set(btn, window.setTimeout(() => {
      btn.removeAttribute('data-feedback');
      btn.setAttribute('aria-label', originalAria);
      if (label) label.textContent = originalLabel;
      delete btn.dataset.piOriginalLabel;
      delete btn.dataset.piOriginalAria;
      feedbackTimers.delete(btn);
    }, 1400));
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-pi-actions]').forEach(hydrate);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
