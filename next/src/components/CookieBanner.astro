---
/**
 * CookieBanner - first-visit consent surface.
 *
 * The first-visit note sits in the document flow before main content, so it
 * cannot cover a hero action or image credit. Explicitly reopened preferences
 * use the compact corner card near the control that requested them.
 *
 * Two-tier consent (Accept all / Manage preferences). Strictly necessary
 * storage for sign-in and consent preferences is always on; analytics (Google Analytics)
 * is opt-in.
 *
 * Persistence: localStorage key `pi-consent-v1`. Shape:
 *   { necessary: true, analytics: boolean, ts: ISO date string, version: 1 }
 *
 * On consent change the component dispatches a `pi:consent-changed` window
 * event with the new state. BaseLayout listens for that to load gtag.js
 * lazily when analytics is opted into.
 *
 * Re-opening: any element with `data-pi-consent="open"` will re-show the
 * banner. The footer "Cookie settings" link uses this hook.
 *
 * Mobile: the first-visit note stays in flow. The reopened card clears
 * V5BottomBar (56px + safe-area) and the newsletter strip.
 *
 * Keyboard: Escape dismisses without recording a choice (analytics stays off
 * and the toast returns next visit), and focus is returned to whatever opened
 * it.
 */
---

<aside
  class="cookie-banner"
  id="cookie-banner"
  role="region"
  aria-label="Cookie preferences"
  aria-live="polite"
  data-state="visible"
  data-mode="initial"
>
  <div class="cookie-banner__inner">
    <div class="cookie-banner__copy">
      <p class="cookie-banner__title">A note on cookies</p>
      <p class="cookie-banner__body">
        Sign-in storage is essential. Analytics is optional.
        <a href="/privacy/">Privacy policy.</a>
      </p>
    </div>

    <div class="cookie-banner__actions" id="cookie-banner-actions">
      <button type="button" class="pi-btn pi-btn--solid pi-btn--sm" id="cookie-accept-all">
        Accept all
      </button>
      <button type="button" class="pi-btn pi-btn--ghost pi-btn--sm" id="cookie-manage">
        Manage preferences
      </button>
    </div>

    <div class="cookie-banner__manage" id="cookie-banner-manage" hidden>
      <ul class="cookie-banner__list">
        <li class="cookie-banner__row">
          <div class="cookie-banner__row-text">
            <p class="cookie-banner__row-title">Strictly necessary</p>
            <p class="cookie-banner__row-dek">Needed for sign-in and to remember your cookie choice. Always on.</p>
          </div>
          <span class="cookie-banner__toggle cookie-banner__toggle--locked" aria-hidden="true">
            <span class="cookie-banner__toggle-knob"></span>
          </span>
          <span class="visually-hidden">Strictly necessary cookies are always on</span>
        </li>
        <li class="cookie-banner__row">
          <div class="cookie-banner__row-text">
            <p class="cookie-banner__row-title">Analytics</p>
            <p class="cookie-banner__row-dek">Google Analytics 4 helps us understand visits and interactions when you opt in.</p>
          </div>
          <label class="cookie-banner__toggle">
            <input type="checkbox" id="cookie-toggle-analytics" />
            <span class="cookie-banner__toggle-knob" aria-hidden="true"></span>
            <span class="visually-hidden">Allow analytics cookies</span>
          </label>
        </li>
      </ul>
      <div class="cookie-banner__manage-actions">
        <button type="button" class="pi-btn pi-btn--solid pi-btn--sm" id="cookie-save">
          Save preferences
        </button>
        <button type="button" class="pi-btn pi-btn--ghost pi-btn--sm" id="cookie-reject-all">
          Reject non-essential
        </button>
      </div>
    </div>
  </div>
</aside>

<script is:inline data-astro-rerun>
  (function () {
    window.__piConsentCleanup?.();
    var controller = new AbortController();
    window.__piConsentAbort = controller;
    var KEY = 'pi-consent-v1';
    var VERSION = 1;
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    // Element that opened the toast, so focus can be returned on dismiss.
    var opener = null;

    function read() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || parsed.version !== VERSION) return null;
        return parsed;
      } catch (_e) {
        return null;
      }
    }

    function write(state) {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch (_e) {}
      window.dispatchEvent(new CustomEvent('pi:consent-changed', { detail: state }));
    }

    function show(fromEl) {
      opener = fromEl || null;
      banner.setAttribute('data-mode', 'reopen');
      banner.setAttribute('role', 'dialog');
      banner.setAttribute('data-state', 'visible');
      var manage = document.getElementById('cookie-banner-manage');
      var actions = document.getElementById('cookie-banner-actions');
      if (manage) manage.hidden = true;
      if (actions) actions.hidden = false;
      // Reopening is an explicit action, so move focus into the choices.
      var first = document.getElementById('cookie-accept-all');
      if (first) first.focus();
    }

    function hide() {
      banner.setAttribute('data-state', 'hidden');
      if (opener && typeof opener.focus === 'function' && document.contains(opener)) {
        opener.focus();
      } else if (banner.contains(document.activeElement)) {
        // Do not leave keyboard focus on a control that just disappeared.
        var main = document.getElementById('main-content');
        if (main) {
          main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
        }
      }
      opener = null;
    }

    function expandManage() {
      var manage = document.getElementById('cookie-banner-manage');
      var actions = document.getElementById('cookie-banner-actions');
      if (manage) manage.hidden = false;
      if (actions) actions.hidden = true;
      var toggle = document.getElementById('cookie-toggle-analytics');
      var existing = read();
      if (toggle && existing) toggle.checked = !!existing.analytics;
      // The button that was focused just got hidden with its row; move focus
      // into the panel rather than dropping it on <body>.
      if (toggle) toggle.focus();
    }

    function save(analyticsOn) {
      var state = {
        version: VERSION,
        necessary: true,
        analytics: !!analyticsOn,
        ts: new Date().toISOString(),
      };
      write(state);
      hide();
    }

    document.getElementById('cookie-accept-all').addEventListener('click', function () { save(true); });
    document.getElementById('cookie-manage').addEventListener('click', expandManage);
    document.getElementById('cookie-save').addEventListener('click', function () {
      var toggle = document.getElementById('cookie-toggle-analytics');
      save(toggle && toggle.checked);
    });
    document.getElementById('cookie-reject-all').addEventListener('click', function () { save(false); });

    // Escape dismisses the toast. No choice is recorded, so nothing is written
    // to storage, no consent event fires, and the toast returns next visit.
    function onConsentKeydown(e) {
      if (e.key !== 'Escape' && e.key !== 'Esc') return;
      if (banner.getAttribute('data-state') !== 'visible') return;
      // A modal promotional overlay (InsiderNotePopup sets body.inote-open)
      // owns Escape while it is open. One keystroke aimed at closing that
      // must not silently drop the consent prompt for the rest of the visit
      // as a side effect.
      if (document.body.classList.contains('inote-open')) return;
      hide();
    }
    document.addEventListener('keydown', onConsentKeydown);

    // Delegate reopen clicks: the footer is parsed after this component and
    // Astro transitions replace its links on every navigation.
    function onReopenClick(e) {
      var trigger = e.target && e.target.closest && e.target.closest('[data-pi-consent="open"]');
      if (!trigger) return;
      e.preventDefault();
      show(trigger);
    }
    document.addEventListener('click', onReopenClick);
    window.__piConsentCleanup = function () {
      controller.abort();
      document.removeEventListener('keydown', onConsentKeydown);
      document.removeEventListener('click', onReopenClick);
    };

    // Expose programmatic re-open
    window.openConsent = function () { show(); };

    // The first-visit note is present in the HTML before main. Hide it
    // synchronously for returning visitors, before following content paints.
    var existing = read();
    if (existing) {
      banner.setAttribute('data-state', 'hidden');
      window.dispatchEvent(new CustomEvent('pi:consent-changed', { detail: existing }));
    }
  })();
</script>

<style>
  /* ─────────────────────────────────────────────────────────────────────
     Corner toast. ~360px, never full-bleed.
     Local derived tokens only: no hardcoded hex.
     ───────────────────────────────────────────────────────────────────── */
  .cookie-banner {
    /* A hairline that actually reads: 3.24:1 on --white, so the ghost
       button and the toggle track meet WCAG 1.4.11. */
    --cb-line: color-mix(in srgb, var(--text) 50%, var(--white));
    /* Distance from the bottom edge, composed from independent parts
       rather than set in one place:
         --cb-gap     breathing room from whatever sits directly below
         --cb-chrome  persistent site chrome to clear (mobile tab strip)
         --cb-promo   promotional strip to clear (the newsletter bar)
       Two bottom-anchored fixed elements overlap whatever their stacking
       order, so the consent card RESERVES the space it needs instead of
       merely outranking what is down there. Splitting the parts means a
       rule that adjusts one can never silently discard another - the old
       single --cb-bottom had exactly that failure, with the newsletter
       clearance living in a max-width:1023px block that never fired at
       the desktop widths where the collision actually happens. */
    --cb-gap:    var(--space-5);
    --cb-chrome: 0px;
    --cb-promo:  0px;
    --cb-bottom: calc(var(--cb-gap) + var(--cb-chrome) + var(--cb-promo));

    position: fixed;
    left: var(--space-5);
    right: auto;
    bottom: var(--cb-bottom);
    width: min(360px, calc(100vw - var(--space-7)));
    max-height: calc(100dvh - var(--cb-bottom) - var(--space-6));
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: var(--z-consent);
    background: var(--white);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    box-shadow: var(--elev-3);
    font-family: var(--font-ui);
    color: var(--text);

    /* Entrance: slide up from the corner. Tokenised durations collapse to
       0ms under prefers-reduced-motion (v6-tokens.css), so this becomes an
       instant appearance rather than a jump-cut mid-animation. */
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(100% + var(--space-6)));
    transition:
      transform var(--dur-slow) var(--ease-enter),
      opacity var(--dur-slow) var(--ease-enter),
      bottom var(--dur-slow) var(--ease-enter),
      visibility 0s linear var(--dur-slow);
  }
  .cookie-banner[data-state='visible'] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      transform var(--dur-slow) var(--ease-enter),
      opacity var(--dur-slow) var(--ease-enter),
      bottom var(--dur-slow) var(--ease-enter),
      visibility 0s linear 0s;
  }

  /* First visit is in flow. A saved choice removes it entirely; an
     explicit reopen uses the fixed card above. */
  .cookie-banner[data-mode='initial'] {
    position: static;
    inset: auto;
    width: 100%;
    max-height: none;
    overflow: visible;
    overscroll-behavior: auto;
    z-index: auto;
    background: var(--paper-warm);
    border: 0;
    border-bottom: 1px solid var(--border-strong);
    border-radius: 0;
    box-shadow: none;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: none;
  }
  .cookie-banner[data-mode='initial'][data-state='hidden'] {
    display: none;
  }
  .cookie-banner[data-mode='initial'] .cookie-banner__inner {
    width: min(100%, 1280px);
    margin-inline: auto;
    padding: var(--space-1) clamp(16px, 3vw, 40px);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
  }
  .cookie-banner[data-mode='initial'] .cookie-banner__title {
    font-size: var(--fs-200);
    margin-bottom: 0;
  }
  .cookie-banner[data-mode='initial'] .cookie-banner__body {
    font-size: var(--fs-200);
  }
  .cookie-banner[data-mode='initial'] .cookie-banner__manage {
    grid-column: 1 / -1;
  }
  @media (max-width: 760px) {
    .cookie-banner[data-mode='initial'] .cookie-banner__inner {
      padding: var(--space-2) var(--space-3);
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
    .cookie-banner[data-mode='initial'] .cookie-banner__actions {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-2);
    }
    .cookie-banner[data-mode='initial'] .cookie-banner__actions .pi-btn {
      white-space: nowrap;
      padding-inline: var(--space-3);
    }
  }

  /* ─────────────────────────────────────────────────────────────────────
     Clear the newsletter strip (InsiderNotePopup.astro), at EVERY width.
     The strip is position:fixed, full-bleed, bottom:0, and it is live in
     production. Raising the consent card above it is not enough: both want
     the bottom of the viewport, so the card would simply sit on top of the
     strip. It steps clear of it instead.
     The strip publishes its measured height onto <html> as
     --pi-promo-bar-height, together with data-pi-promo-bar="visible". The
     fallback covers the frame before the first measurement and any future
     caller that sets the flag without the height.
     ───────────────────────────────────────────────────────────────────── */
  :global(html[data-pi-promo-bar='visible']) .cookie-banner {
    --cb-promo: calc(var(--pi-promo-bar-height, 4.5rem) + var(--space-3));
  }

  /* Clear desktop hero actions on the homepage and plan pages. */
  @media (min-width: 1024px) {
    .cookie-banner {
      left: auto;
      right: var(--space-5);
    }
  }

  .cookie-banner__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .cookie-banner__title {
    font-family: var(--font-display);
    font-size: var(--fs-400);
    font-weight: var(--fw-display);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    margin: 0 0 var(--space-1);
  }

  .cookie-banner__body {
    font-size: var(--fs-200);
    line-height: var(--lh-dek);
    color: var(--soft);          /* 7.11:1 on --white */
    margin: 0;
    max-width: none;
    text-wrap: pretty;
  }
  .cookie-banner__body a {
    color: var(--accent);        /* 8.00:1 on --white */
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-banner__body a:hover { color: var(--text); }

  .cookie-banner__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
  }

  .cookie-banner__actions .pi-btn,
  .cookie-banner__manage-actions .pi-btn { min-height: 44px; }

  .cookie-banner__manage {
    border-top: 1px solid var(--border-strong);
    padding-top: var(--space-4);
  }

  .cookie-banner__list {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cookie-banner__row {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .cookie-banner__row-text { flex: 1; min-width: 0; }
  .cookie-banner__row-title {
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-ui);
    margin: 0 0 var(--space-1);
    color: var(--text);          /* 16.29:1 on --white */
  }
  .cookie-banner__row-dek {
    font-size: var(--fs-100);
    line-height: var(--lh-dek);
    color: var(--soft);          /* 7.11:1 on --white */
    margin: 0;
  }

  .cookie-banner__toggle {
    position: relative;
    display: inline-block;
    width: 38px;
    height: 22px;
    flex-shrink: 0;
    background: var(--cb-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-enter);
  }
  .cookie-banner__toggle input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .cookie-banner__toggle:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  .cookie-banner__toggle-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    background: var(--white);
    border-radius: 50%;
    transition: transform var(--dur-fast) var(--ease-enter);
  }
  .cookie-banner__toggle input:checked ~ .cookie-banner__toggle-knob {
    transform: translateX(16px);
  }
  .cookie-banner__toggle:has(input:checked) {
    background: var(--accent);
  }
  .cookie-banner__toggle--locked {
    background: var(--accent);
    opacity: 0.55;
    cursor: not-allowed;
  }
  .cookie-banner__toggle--locked .cookie-banner__toggle-knob {
    transform: translateX(16px);
  }

  .cookie-banner__manage-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  /* ─────────────────────────────────────────────────────────────────────
     Mobile / tablet: clear the V5BottomBar tab strip (Ask / Map / Save /
     Trip). The bar is fixed at bottom:0, 56px tall plus the safe-area inset,
     and shows at <=1023px. The toast sits above it so the tab bar is never
     covered and never trapped behind the toast.
     ───────────────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .cookie-banner {
      --cb-gap:    var(--space-3);
      --cb-chrome: calc(56px + env(safe-area-inset-bottom));
    }

    /* Pages that never render the bar (journal reading, dispatch/account/
       access/ask flows) reclaim the reserved space. Browsers without :has()
       drop this rule and keep the safe, bar-clearing default above. Only
       the chrome part is released; any newsletter-strip clearance stands. */
    :global(body:not(:has(#v5BottomBar))) .cookie-banner {
      --cb-chrome: 0px;
    }
  }

  /* Phones: full-width inside the gutters, but short. At 390px the toast is
     366px wide and roughly 200px tall, still well clear of the tab bar. */
  @media (max-width: 560px) {
    .cookie-banner {
      left: var(--space-3);
      right: var(--space-3);
      width: auto;
      max-width: none;
    }
    .cookie-banner__inner {
      padding: var(--space-4);
      gap: var(--space-3);
    }
    .cookie-banner__actions .cookie-banner__btn {
      flex: 1 1 auto;
    }
  }

  /* On short phones the full heading repeats the dialog label. Collapse it
     only for the initial choice, keeping the explanation, Privacy link and
     both 44px actions visible above the persistent bottom chrome. The
     heading returns when preferences are expanded. */
  @media (max-width: 380px) and (max-height: 700px) {
    .cookie-banner__inner {
      padding: var(--space-2) var(--space-3);
      gap: var(--space-2);
    }
    .cookie-banner:has(.cookie-banner__actions:not([hidden])) .cookie-banner__title {
      display: none;
    }
  }

  @media print {
    .cookie-banner { display: none; }
  }
</style>
