---
/**
 * Alert (v5) - the one notice component (spec 2.31).
 *
 * Variants: info, warning (road/closure), correction (dated, per editorial
 * policy), success, banner (full-width site notices). Inline variants are
 * not dismissible; the banner persists its dismissal in localStorage under
 * pi:alert-dismissed:<id>. Static alerts are plain regions (icon
 * aria-hidden); pass live={true} only when inserting dynamically, which
 * adds role="status" (info/success) or role="alert" (warning).
 *
 * Body goes in the default slot (<= 60 words, plain English, no em-dashes;
 * corrections dated and specific; warnings state the thing affected and
 * the date checked).
 */
export interface Props {
  variant?: 'info' | 'warning' | 'correction' | 'success' | 'banner';
  /** Optional title, <= 6 words. Correction variant defaults its own. */
  title?: string;
  /** Single optional action link. */
  actionLabel?: string;
  actionHref?: string;
  /** Required for dismissible banners: the persistence key. */
  id?: string;
  dismissible?: boolean;
  /** True when inserted client-side after load. */
  live?: boolean;
}

const {
  variant = 'info',
  title = variant === 'correction' ? 'Correction' : undefined,
  actionLabel,
  actionHref,
  id,
  dismissible = variant === 'banner',
  live = false,
} = Astro.props;

const role = live ? (variant === 'warning' ? 'alert' : 'status') : undefined;
---

<div
  class:list={['v5-alert', `v5-alert--${variant}`]}
  role={role}
  data-v5-alert
  data-alert-id={dismissible ? id : undefined}
>
  <svg
    class="v5-alert__icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {variant === 'success' ? (
      <path d="M20 6L9 17l-5-5" />
    ) : variant === 'warning' ? (
      <>
        <path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
        <path d="M12 9v4" />
        <path d="M12 17h.01" />
      </>
    ) : (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5" />
        <path d="M12 8h.01" />
      </>
    )}
  </svg>
  <div class="v5-alert__content">
    {title && <p class="v5-alert__title">{title}</p>}
    <div class="v5-alert__body">
      <slot />
    </div>
    {actionLabel && actionHref && (
      <a href={actionHref} class="v5-alert__action">{actionLabel}</a>
    )}
  </div>
  {dismissible && (
    <button
      type="button"
      class="v5-alert__dismiss"
      aria-label="Dismiss notice"
      data-evt="alert_dismiss"
      data-variant={variant}
      data-v5-alert-dismiss
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6L6 18" />
        <path d="M6 6l12 12" />
      </svg>
    </button>
  )}
</div>

<style>
  .v5-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: var(--space-4, 1rem);
    border-radius: var(--radius-m, var(--tile-image-radius, 10px));
    background: var(--bg-alt);
    color: var(--text);
    max-width: var(--prose-w, 680px);
  }

  .v5-alert--warning {
    background: color-mix(in srgb, var(--gold) 14%, var(--bg, #fff));
  }
  .v5-alert--warning .v5-alert__icon,
  .v5-alert--warning .v5-alert__title {
    color: var(--gold-text);
  }

  .v5-alert--success {
    background: color-mix(in srgb, var(--sage) 14%, var(--bg, #fff));
  }
  .v5-alert--success .v5-alert__icon,
  .v5-alert--success .v5-alert__title {
    color: var(--sage-text);
  }

  .v5-alert--correction {
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-m);
  }

  .v5-alert--banner {
    max-width: none;
    border-radius: 0;
    align-items: center;
  }

  .v5-alert__icon {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--soft);
  }
  .v5-alert--banner .v5-alert__icon {
    margin-top: 0;
  }

  .v5-alert__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .v5-alert__title {
    margin: 0;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-100, 0.75rem);
    font-weight: var(--fw-semibold, 600);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .v5-alert__body {
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    line-height: var(--lh-ui, 1.4);
    color: var(--text);
  }
  .v5-alert__body :global(p) {
    margin: 0;
  }

  .v5-alert__action {
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-medium, 500);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    padding: 0.35rem 0;
    align-self: flex-start;
  }

  .v5-alert__dismiss {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    background: transparent;
    border: none;
    border-radius: var(--radius-s, 4px);
    color: var(--soft);
    cursor: pointer;
  }
  .v5-alert__dismiss:hover {
    color: var(--text);
  }

  .v5-alert__action:focus-visible,
  .v5-alert__dismiss:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
</style>

<script>
  import { initV5Analytics } from '../../lib/v5-analytics';

  initV5Analytics();

  const STORAGE_PREFIX = 'pi:alert-dismissed:';

  function hydrate(el: HTMLElement) {
    if ((el as any)._v5Init) return;
    (el as any)._v5Init = true;

    const id = el.dataset.alertId;
    const btn = el.querySelector<HTMLButtonElement>('[data-v5-alert-dismiss]');
    if (!btn) return;

    if (id) {
      try {
        if (localStorage.getItem(STORAGE_PREFIX + id) === '1') {
          el.hidden = true;
          return;
        }
      } catch {
        /* storage unavailable: show the alert */
      }
    }

    btn.addEventListener('click', () => {
      el.hidden = true;
      if (id) {
        try {
          localStorage.setItem(STORAGE_PREFIX + id, '1');
        } catch {
          /* non-persistent dismissal is fine */
        }
      }
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-v5-alert]').forEach(hydrate);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
