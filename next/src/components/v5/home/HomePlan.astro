---
/** Plan your day: the one homepage route into Plans.
 * A compact chooser (posts to the Plans matcher, works without scripts) sits
 * above three comparable editorial itineraries from the usable catalogue.
 * The first card rotates on a fixed five-day window. Cards carry image,
 * title, one line, one meta line and a quiet credit; the whole card is the
 * link. Copy/Save and per-plan booking notes live on the plan pages
 * (2026-11-10). Round 2: no intro or footer copy; "See all plans" sits in the
 * heading row; the selects stack full-width below 48em so none truncates.
 */
import Card from '../Card.astro';
import { buildPlansModel } from '../plans/plans-data';
import { compareEditorialPlans } from '../plans/plan-curation';
import { FACET_OPTIONS } from '../../../lib/facets';
import { loadOverrides } from '../../../lib/inline-edit/overrides';

const ROTATION_WINDOW_DAYS = 5;
const FAMILY_PLAN_SLUG = 'the-family-day-out';
const FAMILY_PLAN_SLOT = 'plan.family.image';
/* Licensed Victoria Content Hub asset 167058. Its metadata is also recorded
   on the Arthurs Seat Eagle tour; the gondola is this itinerary's first stop. */
const FAMILY_PLAN_PHOTO = {
  src: '/images/visit-victoria/vv-167058-arthurs-seat-eagle.webp',
  alt: 'A family looks out from inside an Arthurs Seat Eagle gondola over the bayside suburbs and Port Phillip below',
  caption: 'Arthurs Seat Eagle Gondola Ride, Mornington Peninsula.',
  credit: 'Courtesy of Visit Victoria',
};

/* The itinerary records have no season field. Use the same reviewed
   editorial order as the plans hub, then rotate among its three strongest
   starting points. */
const plansModel = await buildPlansModel();
const usablePlans = plansModel.plans.filter((plan) => plan.kind === 'itinerary' && plan.stops.length > 0);
const eligible = [...usablePlans].sort(compareEditorialPlans).slice(0, 3);

/* Chooser options: only facets that at least one published itinerary carries. */
const present = (key: 'party' | 'cat' | 'mood') => FACET_OPTIONS[key].filter(option => usablePlans.some(plan => (plan.facets[key] ?? []).includes(option.value)));
const interests = [...present('cat'), ...present('mood')]
  .filter(option => option.value !== 'plan' && option.value !== 'rainy-day')
  .filter((option, i, list) => list.findIndex(other => other.value === option.value) === i);

const epochDay = Math.floor(Date.now() / 86_400_000);
const rotationIndex = eligible.length
  ? Math.floor(epochDay / ROTATION_WINDOW_DAYS) % eligible.length
  : 0;

const featured = eligible[rotationIndex];
const slug = featured?.slug ?? '';
const familyPlanPublished = slug === FAMILY_PLAN_SLUG
  ? (await loadOverrides('page', 'home')).image[FAMILY_PLAN_SLOT]
  : undefined;
const familyPlanOverride = familyPlanPublished?.src && familyPlanPublished.alt?.trim() && familyPlanPublished.credit?.trim()
  ? familyPlanPublished
  : undefined;
const sameFamilyPhoto = !familyPlanOverride || familyPlanOverride.src === FAMILY_PLAN_PHOTO.src;
const featuredImage = slug === FAMILY_PLAN_SLUG
  ? {
      src: familyPlanOverride?.src ?? FAMILY_PLAN_PHOTO.src,
      alt: familyPlanOverride?.alt ?? (sameFamilyPhoto ? FAMILY_PLAN_PHOTO.alt : featured?.title ?? 'Family plan'),
      caption: (familyPlanOverride?.caption ?? (sameFamilyPhoto ? FAMILY_PLAN_PHOTO.caption : undefined)) ?? undefined,
      credit: (familyPlanOverride?.credit ?? (sameFamilyPhoto ? FAMILY_PLAN_PHOTO.credit : undefined)) ?? undefined,
    }
  : featured?.image;
const featuredImageEdit = slug === FAMILY_PLAN_SLUG
  ? { entityType: 'page' as const, entitySlug: 'home', fieldPath: FAMILY_PLAN_SLOT }
  : undefined;

/* Alternates use the same editorial ranking as the plans hub. */
const featuredId = `it-${slug}`;
const alternates = usablePlans
  .filter((p) => p.id !== featuredId && p.image)
  .sort(compareEditorialPlans)
  .slice(0, 2);

/* A complete one-sentence invitation fits the compact homepage cards.
   The plan pages retain their full editorial verdicts. */
const alternateSummary: Record<string, string> = {
  'ridge-to-sea-two-night-escape': 'Red Hill wine country to the southern coast.',
  'flinders-and-cape-reset': 'Coastal walks and one excellent meal.',
  'the-family-day-out': 'A gondola, brewery lunch and a bay beach.',
};

const cards = featured && featuredImage ? [
  { plan: featured, image: featuredImage, imageEdit: featuredImageEdit, surface: 'home-plan' },
  ...alternates.map((plan) => ({ plan, image: plan.image ?? undefined, imageEdit: undefined, surface: 'home-plan-alt' })),
] : [];
---

<section id="home-choose" class="home-plan home-choose" aria-labelledby="home-plan-title">
  <div class="container">
    <div class="home-plan__head">
      <h2 id="home-plan-title" class="home-plan__title">Plan your day</h2>
      <a class="home-plan__more" href="/explore/plans/">See all plans <span aria-hidden="true">→</span></a>
    </div>

    <form action="/explore/plans/#build" method="get" class="home-choose__form" aria-label="Find a Peninsula plan">
      <label>How long?<select name="length"><option value="">Any length</option><option value="one-day">One day</option><option value="weekend">A weekend</option><option value="longer">Two nights or more</option></select></label>
      <label>Who’s coming?<select name="who"><option value="">Anyone</option>{present('party').map(option => <option value={option.value}>{option.label}</option>)}</select></label>
      <label>What sounds good?<select name="into"><option value="">Anything</option>{interests.map(option => <option value={option.value}>{option.label}</option>)}</select></label>
      <button class="pi-btn pi-btn--solid" type="submit">Find my plan</button>
    </form>

    {cards.length > 0 && (
      <>
        <ul class="home-plan__choices" role="list" aria-label="More plans to explore">
          {cards.filter(({ plan }) => plan.slug !== 'flinders-and-cape-reset').map(({ plan, image, imageEdit, surface }, i) => (
            <li class:list={[i === 0 ? 'home-plan__card' : 'home-plan__alt']}>
              <Card preferAvif={true}
                as="article"
                variant="plan"
                title={plan.displayTitle}
                href={plan.href}
                entityType={plan.entityType}
                entitySlug={plan.slug}
                fieldPath={plan.imageField}
                imageEdit={imageEdit}
                requireImageMetadata={Boolean(imageEdit)}
                suppressImageHydration={true}
                image={image}
                verdict={alternateSummary[plan.slug] ?? plan.editorialReason ?? plan.verdict}
                showEyebrow={false}
                meta={plan.meta}
                surface={surface}
                position={i}
              />
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

<style>
  .home-plan { padding: var(--space-7) 0; scroll-margin-top: 9rem; }
  .home-plan__head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-bottom: var(--space-5); }
  .home-plan__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-700);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--text);
  }
  /* The one "more" link style on the homepage: section-head right, text only. */
  .home-plan__more { display: inline-flex; align-items: center; gap: .4em; min-height: 44px; color: var(--accent); font: 600 var(--fs-300)/1.4 var(--font-ui); text-decoration: none; }
  .home-plan__more:hover { text-decoration: underline; text-underline-offset: .2em; }

  /* Selects never truncate: three equal columns only where each has room,
     otherwise one full-width column. */
  .home-choose__form { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: var(--space-4); align-items: end; }
  .home-choose__form label { font-size: var(--fs-300); font-weight: 600; min-width: 0; }
  .home-choose__form select { display: block; width: 100%; margin-top: var(--space-2); min-height: 48px; padding: .65rem 2rem .65rem .75rem; background: var(--bg); border: 1px solid var(--border-control); border-radius: var(--radius-s); color: var(--text); font: 400 var(--fs-400)/1.4 var(--font-ui); }
  .home-choose__form button { min-height: 48px; }
  .home-choose__form select:focus-visible, .home-plan a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  /* Same card anatomy as This weekend: 3:2 image, title, one line, meta, then
     the photo credit as one quiet closing line. */
  .home-plan__choices { list-style: none; margin: var(--space-7) 0 0; padding: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  .home-plan__card, .home-plan__alt { min-width: 0; }
  .home-plan__choices :global(.pi-card) { width: 100%; }
  .home-plan__choices :global(.pi-card__media) { aspect-ratio: 3/2; height: auto; }
  .home-plan__choices :global(.pi-card__media img) { height: 100%; width: 100%; object-fit: cover; }
  .home-plan__choices :global(.pi-card__body) { display: flex; flex-direction: column; }
  .home-plan__choices :global(.pi-card__title) { font-size: var(--fs-500); line-height: 1.25; text-wrap: balance; }
  .home-plan__choices :global(.pi-card__dek) { display: block; -webkit-line-clamp: unset; line-clamp: unset; overflow: visible; font-size: var(--fs-400); line-height: var(--lh-body); }
  /* Copy and Save live on each plan page; the card is a single link here. */
  .home-plan__choices :global(.pi-card__actions) { display: none; }

  @media (max-width: 63.99rem) {
    .home-choose__form { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-choose__form button { grid-column: 1 / -1; justify-self: start; }
    /* Below the desktop grid the plans scroll sideways with a visible peek,
       exactly like This weekend. Reader-driven, no motion. */
    .home-plan__choices { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(21rem, 84vw); overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: var(--space-2); }
    .home-plan__choices::-webkit-scrollbar { display: none; }
    .home-plan__choices > li { scroll-snap-align: start; }
  }
  @media (max-width: 47.99em) {
    .home-plan { padding: var(--space-6) 0; }
    .home-plan__title { font-size: var(--fs-600); }
    .home-choose__form { grid-template-columns: 1fr; gap: var(--space-3); }
    .home-choose__form button { width: 100%; }
    .home-plan__choices { margin-top: var(--space-6); margin-right: -1rem; gap: var(--space-4); }
    .home-plan__choices :global(.pi-card__dek) { font-size: var(--fs-300); line-height: 1.45; }
  }
</style>
