---
/**
 * HomePlan - block 5, the featured plan (page-redesigns.md 1.9 item 5;
 * wireframes.html #home note 4: "The Decide door, one plan only").
 *
 * One plan Card (v5 plan variant: duration as the first meta chip, fork
 * SaveControl) chosen
 * deterministically at build time: in-season plans first, year-round next
 * form the eligible pool; within that pool the pick rotates on a fixed
 * calendar window (ROTATION_WINDOW_DAYS) rather than always favoring the
 * most recently published plan. Same UTC window always yields the same
 * plan (deterministic, reproducible for a given build), but the pick
 * changes once the window rolls over (rotating) - see
 * .github/workflows/build-and-deploy.yml `schedule` for the rebuild
 * cadence that makes the rotation actually reach the live site. Closes
 * with "All plans" into the hub.
 *
 * Two alternates follow the featured plan (2026-09-19; a full-width row
 * of two under the rail since the 2026-09-30 design pass), and the rail
 * now carries a chip strip instead of three fixed links. The chips do not
 * match anything here: they carry the reader's answers to the builder on
 * /explore/plans/ as query params, which is where the matching lives. Chip
 * values are derived from the catalogue, so the homepage cannot offer a
 * shape no plan has.
 */
import { getCollection } from 'astro:content';
import Card from '../Card.astro';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { getAustralianSeasonLower } from '../../../lib/season';
import { buildPlansModel, durationLabel } from '../plans/plans-data';
import { FACET_OPTIONS } from '../../../lib/facets';

const ROTATION_WINDOW_DAYS = 5;

const plans = await getCollection('itineraries');
const season = getAustralianSeasonLower();

const seasonScore = (p: any) =>
  p.data.season === season ? 2 : p.data.season === 'year-round' ? 1 : 0;

const topScore = plans.reduce((max, p) => Math.max(max, seasonScore(p)), 0);

// Eligibility: same season-priority tier as before (in-season beats
// year-round beats out-of-season). Everything tied for the top tier is a
// fair pick - this is where rotation replaces "always most recent".
const eligible = [...plans]
  .filter((p) => seasonScore(p) === topScore)
  .sort((a, b) => (a.data.slug ?? a.id).localeCompare(b.data.slug ?? b.id));

const epochDay = Math.floor(Date.now() / 86_400_000);
const rotationIndex = eligible.length
  ? Math.floor(epochDay / ROTATION_WINDOW_DAYS) % eligible.length
  : 0;

const featured = eligible[rotationIndex];

/* The plans model is the same one /explore/plans/ uses, so the alternates
   and the chip strip stay consistent with the hub they lead to. */
const plansModel = await buildPlansModel();
const usablePlans = plansModel.plans.filter((plan) => plan.kind === 'itinerary' && plan.stops.length > 0);

const slug = featured ? (featured.data.slug ?? featured.id) : '';
const hero = featured ? await resolveHero('itinerary', slug, featured.data) : null;

const moodLabel = featured
  ? String(featured.data.mood ?? '')
      .replace(/-/g, ' ')
      .replace(/^\w/, (c: string) => c.toUpperCase())
  : '';

const audienceLabel = featured
  ? ({ couple: 'Couples', family: 'Family', friends: 'Friends', solo: 'Solo', locals: 'Locals' } as Record<string, string>)[
      featured.data.audience
    ] ?? ''
  : '';

const dayCount = featured ? (featured.data.lengthNights ?? 0) + 1 : 0;
/* One humanised duration, phrased the way plan titles are ("Two nights",
   "One day"), so the featured card never reads "3 days" under a
   "Two-Night" title. */
const featuredDuration = featured
  ? durationLabel({ dayCount, nights: featured.data.lengthNights ?? 0 })
  : '';
/* One tag set for the featured plan: duration, mood, audience. It is the
   card's meta line and nothing else restates it, so the same plan is never
   tagged two different ways side by side. */
const planTags = [featuredDuration, moodLabel, audienceLabel].filter(
  (tag, i, all) => tag && all.indexOf(tag) === i,
);
const firstStop = featured
  ? [...(featured.data.stops ?? [])].sort((a: any, b: any) => a.day - b.day || a.order - b.order)[0]
  : null;
const firstStopDetail = firstStop?.note
  ? String(firstStop.note).split(/(?<=[.!?])\s+/)[0]
  : featured?.data.editorNote
    ? String(featured.data.editorNote).split(/(?<=[.!?])\s+/)[0]
    : '';
/* Alternates: the two strongest plans for the season that are not the
   featured one. Same ranking rule as the hub's default context. */
const featuredId = `it-${slug}`;
const alternates = usablePlans
  .filter((p) => p.id !== featuredId && p.image)
  .sort(
    (a, b) =>
      Number((b.facets.date ?? []).includes('this-season')) -
        Number((a.facets.date ?? []).includes('this-season')) ||
      b.publishedAt - a.publishedAt,
  )
  .slice(0, 2);

/* Chip strip vocabulary, derived: a chip exists only if a published plan
   carries that shape. */
const countOf = (key: 'party', value: string) =>
  usablePlans.filter((p) => (p.facets[key] ?? []).includes(value)).length;

const lengthChips = [
  { value: 'one-day', label: 'One day' },
  { value: 'weekend', label: 'Weekend' },
  { value: 'longer', label: 'Two nights +' },
].filter((o) =>
  usablePlans.some((p) =>
    o.value === 'one-day'
      ? (p.facets.date ?? []).includes('one-day') || p.dayCount === 1
      : o.value === 'weekend'
        ? (p.facets.date ?? []).includes('weekend') || p.dayCount === 2 || p.dayCount === 3
        : (p.dayCount ?? 0) >= 3,
  ),
);

const whoChips = (FACET_OPTIONS.party ?? [])
  .filter((o) => countOf('party', o.value) > 0)
  .slice(0, 4)
  .map((o) => ({ value: o.value, label: o.label }));

const buildHref = (key: 'length' | 'who', value: string) =>
  `/explore/plans/?${key}=${encodeURIComponent(value)}#build`;
---

{featured && hero && (
  <section class="home-plan pi-section" aria-labelledby="home-plan-title">
    <div class="container">
      <header class="pi-section-head">
        <div class="pi-section-head__text">
          <p class="pi-eyebrow">Plan it</p>
          <h2 id="home-plan-title" class="pi-h2">Featured plan</h2>
        </div>
        <a class="pi-section-link" href="/explore/plans/">All plans <span aria-hidden="true">&rarr;</span></a>
      </header>

      <div class="home-plan__layout">
        {/* showEyebrow is off: the section heading is already "Featured plan",
            so a PLAN stamp on the single card below it says nothing new.
            No dayCount: the duration travels as the first meta chip, so it
            renders once, in the plan title's own words. */}
        <div class="home-plan__card">
          <Card
            as="article"
            variant="plan"
            title={featured.data.title}
            href={`/explore/plans/${slug}/`}
            entityType="itinerary"
            entitySlug={slug}
            image={{ src: hero.src, alt: hero.alt || featured.data.title }}
            verdict={featured.data.dek}
            showEyebrow={false}
            meta={planTags}
            freshness={featured.data.lastVerified ? String(featured.data.lastVerified) : undefined}
            surface="home-plan"
            position={0}
          />
        </div>

        <aside class="home-plan__rail" aria-label="Plan details">
          {firstStopDetail && (
            <div class="home-plan__start">
              <p class="home-plan__rail-label">Start here</p>
              <p>{firstStopDetail}</p>
            </div>
          )}

          <div class="home-plan__build" data-surface="home-build">
            <p class="home-plan__rail-label">Build your own</p>
            {lengthChips.length > 0 && (
              <div class="home-plan__chiprow" role="group" aria-label="How long have you got?">
                {lengthChips.map((o) => (
                  <a
                    class="home-plan__chip"
                    href={buildHref('length', o.value)}
                    data-evt="card_click"
                    data-surface="home-build"
                    data-entity-type="page"
                    data-entity-slug="plans-build"
                  >{o.label}</a>
                ))}
              </div>
            )}
            {whoChips.length > 0 && (
              <div class="home-plan__chiprow" role="group" aria-label="Who’s coming?">
                {whoChips.map((o) => (
                  <a
                    class="home-plan__chip"
                    href={buildHref('who', o.value)}
                    data-evt="card_click"
                    data-surface="home-build"
                    data-entity-type="page"
                    data-entity-slug="plans-build"
                  >{o.label}</a>
                ))}
              </div>
            )}
          </div>
        </aside>

        {alternates.length > 0 && (
          <div class="home-plan__alts">
            <p class="home-plan__rail-label" id="home-plan-alts-label">Other plans</p>
            <ul class="home-plan__alts-list" aria-labelledby="home-plan-alts-label">
              {alternates.map((alt, i) => (
                <Card
                  variant="plan"
                  title={alt.title}
                  href={alt.href}
                  entityType={alt.entityType}
                  entitySlug={alt.slug}
                  image={alt.image ? { src: alt.image.src, alt: alt.image.alt } : undefined}
                  verdict={alt.verdict}
                  showEyebrow={false}
                  meta={alt.meta}
                  surface="home-plan-alt"
                  position={i + 1}
                />
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  /* Section head, link and vertical spacing come from the shared
     .pi-section-head / .pi-section canon (G1); nothing local pads the
     section, so it keeps the page's one section rhythm.

     Layout: one stacked reading order at every width, so no column can
     run past another. Feature, then its rail, then the two alternates.
     - Narrow: one column. Featured card, then the rail groups 24px apart,
       then the alternates as two stacked cards.
     - 48em and up: the featured plan is a horizontal card across the
       frame (image left, text right). The rail runs under it as a
       frame-width strip (where to start, then the chips) below one
       hairline that spans the frame, and the two alternates sit as a
       row of two equal horizontal cards (4:3 image left, text right).
     Card type is set here with a body[data-v4] prefix: the shared
     refinement.css card rules (body[data-v4] .pi-card:not(...) .pi-card__title,
     0,4,1) otherwise outrank a scoped selector, which is why the round-1
     compact sizes never rendered. */
  .home-plan__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  .home-plan__card,
  .home-plan__rail,
  .home-plan__alts {
    min-width: 0;
  }

  .home-plan__rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--text);
  }

  .home-plan__alts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  /* Featured title one step above every other card on the page (32 to
     36px at desktop), so the feature and the alternates read as lead and
     supporting. */
  :global(body[data-v4]) .home-plan__card :global(.pi-card .pi-card__title) {
    font-size: var(--fs-700);
    line-height: 1.12;
    letter-spacing: var(--ls-display);
  }

  /* Alternates: compact type that actually applies (19 to 21px titles,
     15px deks held to three lines at most). */
  :global(body[data-v4]) .home-plan__alts :global(.pi-card .pi-card__title) {
    font-size: var(--fs-500);
    line-height: 1.25;
    letter-spacing: var(--ls-display);
  }
  :global(body[data-v4]) .home-plan__alts :global(.pi-card .pi-card__dek) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    max-width: none;
    font-size: var(--fs-300);
    font-weight: var(--fw-body);
    line-height: var(--lh-dek);
  }

  /* Chip strip: links, not controls. They carry the answer to the builder
     on the plans page rather than matching anything here. Filter-chip
     standard: 48px tall, pill, outlined at rest. */
  .home-plan__chiprow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .home-plan__chiprow + .home-plan__chiprow {
    margin-top: var(--space-2);
  }

  .home-plan__chip {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-label);
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .home-plan__chip:hover {
    border-color: var(--harbour);
    color: var(--harbour);
  }
  .home-plan__chip:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 2px;
  }

  .home-plan__rail-label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--fs-100);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--teal-text);
  }

  .home-plan__start p:last-child {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-display);
    font-size: var(--fs-500);
    line-height: 1.3;
    letter-spacing: var(--ls-display);
    text-wrap: pretty;
  }

  /* ---- phones: alternates as cards with a shorter picture ---- */
  @media (max-width: 47.99em) {
    .home-plan__alts :global(.pi-card__media) {
      aspect-ratio: 16 / 9;
    }
  }

  /* ---- 48em and up: feature, strip, row of two ---- */
  @media (min-width: 48em) {
    /* Featured plan as a horizontal card: image left, text right. The
       selectors reach into the shared Card only for placement; its meta
       and actions stay the card's own. The picture fills its half with
       object-fit cover, so the card bottom is the text's bottom. */
    .home-plan__card :global(.pi-card) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
    }
    .home-plan__card :global(.pi-card__media) {
      grid-column: 1;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      height: 100%;
      min-height: 20rem;
    }
    .home-plan__card :global(.pi-card__body) {
      grid-column: 2;
      grid-row: 1;
      padding: var(--space-5);
    }
    .home-plan__card :global(.pi-card__actions) {
      grid-column: 2;
      grid-row: 2;
      padding: 0 var(--space-5) var(--space-5);
    }

    /* The rail strip shares the card's split, so "Build your own" starts
       on the card's text edge. One hairline spans the frame and ends with
       it; there is no vertical rule to overrun anything. */
    .home-plan__rail {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 0;
      row-gap: var(--space-5);
      align-items: start;
    }
    .home-plan__start {
      padding-right: var(--space-5);
    }
    .home-plan__start + .home-plan__build {
      padding-left: var(--space-5);
    }

    .home-plan__alts-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Alternates as two equal horizontal cards once each is wide enough to
     hold a 4:3 picture beside three lines of title. */
  @media (min-width: 64em) {
    .home-plan__alts :global(.pi-card) {
      display: grid;
      grid-template-columns: clamp(9rem, 34%, 12.5rem) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
    }
    .home-plan__alts :global(.pi-card__media) {
      grid-column: 1;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      height: 100%;
      min-height: 9.375rem;
    }
    .home-plan__alts :global(.pi-card__body) {
      grid-column: 2;
      grid-row: 1;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-5) 0;
    }
    .home-plan__alts :global(.pi-card__actions) {
      grid-column: 2;
      grid-row: 2;
      padding: var(--space-4) var(--space-5) var(--space-5);
    }
  }

  /* ---- 75em and up ---- */
  @media (min-width: 75em) {
    /* The feature leads with a wider picture (7:5) and a roomier text
       inset; the rail strip keeps the same split. */
    .home-plan__card :global(.pi-card),
    .home-plan__rail {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .home-plan__card :global(.pi-card__body) {
      gap: var(--space-3);
      padding: var(--space-6) var(--space-6) var(--space-5);
    }
    .home-plan__card :global(.pi-card__actions) {
      padding: 0 var(--space-6) var(--space-6);
    }
    .home-plan__start {
      padding-right: var(--space-6);
    }
    .home-plan__start + .home-plan__build {
      padding-left: var(--space-6);
    }
  }
</style>
