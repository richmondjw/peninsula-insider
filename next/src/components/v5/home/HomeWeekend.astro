---
/**
 * HomeWeekend - block 3, the homepage's ONLY temporal module
 * (page-redesigns.md 1.9 item 3; wireframes.html #home note 2).
 *
 * Three PI picks for the upcoming weekend, each a v5 event Card with Save
 * and "+ Trip", with an "All events" section link into /whats-on/.
 * The cards run without the type eyebrow: "This weekend" plus a date window
 * already declares that these are events, and three stacked EVENT stamps
 * read as machine output rather than an edited page.
 * Picks resolve from the editorial weekend-picks entry for this weekend
 * when one exists; otherwise a ranked fallback over the events collection
 * keeps the module honest between editorial pushes (see home-data.ts).
 *
 * List semantics via CardGrid; below 1024px the grid becomes a horizontal
 * scroller with a visible peek (mobile-strategy: swipe, no carousel, no
 * auto-motion). All server-rendered.
 */
import { getCollection } from 'astro:content';
import Card from '../Card.astro';
import CardGrid from '../CardGrid.astro';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { depictionStatusOf } from '../../../lib/media-provenance';
import {
  selectWeekendPicks,
  categoryLabel,
  placeLabel,
  pickDateISO,
  recurrenceChip,
  isFreeEvent,
} from './home-data';

const events = await getCollection('events');
const picksEntries = await getCollection('weekend-picks');
const now = new Date();
const { picks, window: weekend } = selectWeekendPicks(picksEntries, events, now);

const slugOf = (e: any) => e.data.slug ?? e.id;

// These library photographs show a different market and an unidentified gallery
// installation. Keep that distinction next to the image, never in alt alone.
// They are fallback artwork for this dated shortlist, not event hero records.
const contextPhotos: Record<string, { src: string; alt: string; caption: string; credit: string }> = {
  'hill-ridge-community-market-september-2026-restart': {
    src: '/images/visit-victoria/vv-143096-produce-at-mornington-farmers-market.webp',
    alt: 'A stallholder holds out a bunch of freshly pulled beetroot with leaves attached at Mornington Farmers Market',
    caption: "Mornington Farmers' Market, Mornington Peninsula. Context photo, not the Hill & Ridge Community Market.",
    credit: 'Courtesy of Visit Victoria',
  },
  'national-works-on-paper-2026-nwop': {
    src: '/images/visit-victoria/vv-143144-mornington-peninsula-regional-gallery.webp',
    alt: 'Gallery room at Mornington Peninsula Regional Gallery with framed prints on white walls and sculptures on plinths under a vaulted ceiling',
    caption: 'Mornington Peninsula Regional Gallery, Mornington Peninsula. Context photo; exhibition shown is not identified as National Works on Paper 2026.',
    credit: 'Robert Blackburn, courtesy of Visit Victoria',
  },
};

const cards = await Promise.all(
  picks.map(async ({ event, verdict }) => {
    const slug = slugOf(event);
    const hero = await resolveHero('event', slug, event.data);
    const place =
      event.data.venueName || placeLabel(event.data.place) || event.data.suburb || '';
    const meta = [
      place,
      recurrenceChip(event) ?? categoryLabel(event.data.category),
      isFreeEvent(event) ? 'Free' : '',
    ].filter(Boolean);
    const recorded = event.data.heroImage;
    const status = depictionStatusOf(recorded);
    const subcategory = String(event.data.subcategory ?? '').trim();
    const plateLabel = subcategory && subcategory.length <= 20 && !subcategory.includes('/')
      ? subcategory : categoryLabel(event.data.category);
    const overrideReady = Boolean(hero.override?.alt?.trim() && hero.override?.credit?.trim());
    // The CMS slot remains authoritative when its published replacement has
    // the minimum descriptive and credit fields. CMS has no depiction-status
    // field yet, so disclose the uncertainty rather than claim event coverage.
    const image = overrideReady ? {
      src: hero.src,
      alt: hero.override!.alt!,
      caption: [hero.override!.caption, 'Event depiction not verified.'].filter(Boolean).join(' '),
      credit: hero.override!.credit!,
      badge: 'Editorial image',
    } : contextPhotos[slug] ? {
      ...contextPhotos[slug],
    } : !hero.override && hero.hasPhoto && recorded?.alt && recorded?.credit && status !== 'unverified' ? {
      src: hero.src,
      alt: recorded.alt,
      caption: status === 'illustrative'
        ? [recorded.caption, 'Illustrative image, not this event.'].filter(Boolean).join(' ')
        : recorded.caption ?? '',
      credit: recorded.credit,
      badge: status === 'illustrative' ? 'Illustrative image' : '',
    } : undefined;
    return {
      slug,
      title: event.data.title,
      href: `/whats-on/${slug}/`,
      image,
      plateLabel,
      verdict,
      meta,
      dateISO: pickDateISO(event, now),
    };
  }),
);
---

{cards.length > 0 && (
  <section id="home-weekend" class="home-weekend pi-section" aria-labelledby="home-weekend-title">
    <div class="container">
      <header class="pi-section-head">
        <div class="pi-section-head__text">
          <p class="pi-eyebrow">The short list</p>
          <div class="home-weekend__titlerow">
            <h2 id="home-weekend-title" class="pi-h2">This weekend</h2>
            <p class="home-weekend__window">{weekend.label}</p>
          </div>
        </div>
        <a class="pi-section-link" href="/whats-on/">All events <span aria-hidden="true">&rarr;</span></a>
      </header>

      <p class="home-weekend__scroll-hint">Swipe or scroll for all three picks <span aria-hidden="true">&rarr;</span></p>

      <div class="home-weekend__scroller">
        <CardGrid label="This weekend's picks">
          {cards.map((card, i) => (
            <Card
              variant="event"
              title={card.title}
              href={card.href}
              entityType="event"
              entitySlug={card.slug}
              image={card.image}
              suppressImageHydration={true}
              requireImageMetadata={true}
              verdict={card.verdict}
              meta={card.meta}
              dateISO={card.dateISO}
              showEyebrow={false}
              mediaFallback={true}
              mediaFallbackLabel={card.plateLabel}
              trip={true}
              surface="home-weekend"
              position={i}
            >
              {card.image?.badge && <span slot="badges" class="home-weekend__media-badge">{card.image.badge}</span>}
            </Card>
          ))}
        </CardGrid>
      </div>
    </div>
  </section>
)}

<style>
  /* Section head, link and vertical spacing come from the shared
     .pi-section-head / .pi-section canon (G1). Only the date pill, the
     media badge, the scroll hint and the card rail are local. */
  :global(.home-weekend__media-badge) {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    max-width: calc(100% - 2 * var(--space-3));
    padding: .3rem .55rem;
    border-radius: var(--radius-s);
    background: var(--bg-dark);
    color: var(--white);
    font: var(--fw-semibold) var(--fs-100)/var(--lh-ui) var(--font-ui);
  }
  .home-weekend { scroll-margin-top: 9rem; }

  /* Three equal picks. The cards carry identical content and treatment,
     so an uneven 1.5fr lead read as a grid error, not a lead story. */
  @media (min-width: 64em) {
    .home-weekend__scroller :global(.v5-card-grid--grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
  .home-weekend__scroller :global(.pi-card__media) { height: 14.375rem; aspect-ratio: auto; }
  .home-weekend__scroller :global(.pi-card__dek) { font-size: var(--fs-400); line-height: var(--lh-body); display: block; overflow: visible; -webkit-line-clamp: unset; }

  .home-weekend__titlerow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  /* The single live/now marker: a restrained amber pill beside the H2. */
  .home-weekend__window {
    margin: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--signal) 16%, transparent);
    font-family: var(--font-ui);
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    color: var(--signal-text);
    white-space: nowrap;
  }

  .home-weekend__scroll-hint {
    display: none;
    margin: calc(-1 * var(--space-3)) 0 var(--space-3);
    color: var(--soft);
    font: var(--fw-semibold) var(--fs-200)/var(--lh-ui) var(--font-ui);
  }

  .home-weekend__scroll-hint span { color: var(--accent); }

  /* Below the desktop grid breakpoint the picks row scrolls horizontally
     with a visible peek (wireframe mobile frame: "swipe · 2 more"). The
     override targets CardGrid's ul from this wrapper; scroll is
     reader-driven, never automated. */
  @media (max-width: 63.94em) {
    .home-weekend__scroll-hint { display: block; }
    .home-weekend__scroller :global(.v5-card-grid--grid) {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(19rem, 72vw);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: var(--space-2, 0.5rem);
      -webkit-overflow-scrolling: touch;
    }

    .home-weekend__scroller :global(.v5-card-grid--grid > *) {
      scroll-snap-align: start;
    }

    /* House rail treatment: hide the native scrollbar (swipe affordance
       comes from the visible card peek, per audit-surface-hardening). */
    .home-weekend__scroller :global(.v5-card-grid--grid) {
      scrollbar-width: none;
    }

    .home-weekend__scroller :global(.v5-card-grid--grid)::-webkit-scrollbar {
      display: none;
    }
  }
</style>
