---
import { publicEventData } from '../../../lib/event-publication.mjs';
/**
 * HomeWeekend - block 3, the homepage's ONLY temporal module
 * (page-redesigns.md 1.9 item 3; wireframes.html #home note 2).
 *
 * Three PI picks for the upcoming weekend, each a v5 event Card with Save
 * and "+ Trip", closed by "Everything on this weekend" into /whats-on/.
 * The cards run without the type eyebrow: "This weekend" plus a date window
 * already declares that these are events, and three stacked EVENT stamps
 * read as machine output rather than an edited page.
 * Picks resolve from the editorial weekend-picks entry for this weekend
 * when one exists; otherwise a ranked fallback over the events collection
 * keeps the module honest between editorial pushes (see home-data.ts).
 *
 * List semantics via CardGrid; below 1024px the grid becomes a horizontal
 * scroller with a visible peek (mobile-strategy: swipe, no carousel, no
 * auto-motion). All server-rendered.
 */
import { eventContentKind } from '../../../lib/event-publication.mjs';
import { getCollection } from 'astro:content';
import Card from '../Card.astro';
import CardGrid from '../CardGrid.astro';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { depictionStatusOf } from '../../../lib/media-provenance';
import {
  selectWeekendPicks,
  categoryLabel,
  placeLabel,
  pickDateISO,
  recurrenceChip,
} from './home-data';

const events = await getCollection('events');
const picksEntries = await getCollection('weekend-picks');
const now = new Date();
const { picks, window: weekend } = selectWeekendPicks(picksEntries, events, now);

const slugOf = (e: any) => e.data.slug ?? e.id;

// These library photographs show a different market and an unidentified gallery
// installation. Keep that distinction next to the image, never in alt alone.
// They are fallback artwork for this dated shortlist, not event hero records.
const contextPhotos: Record<string, { src: string; alt: string; caption: string; credit: string }> = {
  'hill-ridge-community-market-september-2026-restart': {
    src: '/images/visit-victoria/vv-143096-produce-at-mornington-farmers-market.webp',
    alt: 'A stallholder holds out a bunch of freshly pulled beetroot with leaves attached at Mornington Farmers Market',
    caption: "Context photo: Mornington Farmers' Market, not this event.",
    credit: 'Courtesy of Visit Victoria',
  },
  'national-works-on-paper-2026-nwop': {
    src: '/images/visit-victoria/vv-143144-mornington-peninsula-regional-gallery.webp',
    alt: 'Gallery room at Mornington Peninsula Regional Gallery with framed prints on white walls and sculptures on plinths under a vaulted ceiling',
    caption: 'Context photo: Mornington Peninsula Regional Gallery, not this exhibition.',
    credit: 'Robert Blackburn, courtesy of Visit Victoria',
  },
};

const cards = await Promise.all(
  picks.map(async ({ event, verdict }) => {
    const slug = slugOf(event);
    const hero = await resolveHero('event', slug, event.data);
    const place =
      event.data.venueName || placeLabel(event.data.place) || event.data.suburb || '';
    const recurrence = recurrenceChip(event);
    const cadence = recurrence?.startsWith('Every Saturday evening year-round') ? 'Every Saturday' : recurrence;
    const kind = eventContentKind(event.data);
    const meta = [
      kind === 'event' ? '' : kind === 'offer' ? 'Offer · validity dates' : 'Experience session',
      place,
      cadence ?? categoryLabel(event.data.category),
    ].filter(Boolean);
    const recorded = event.data.heroImage;
    const status = depictionStatusOf(recorded);
    const subcategory = String(event.data.subcategory ?? '').trim();
    const plateLabel = subcategory && subcategory.length <= 20 && !subcategory.includes('/')
      ? subcategory : categoryLabel(event.data.category);
    const image = contextPhotos[slug] && status !== 'actual' ? {
      ...contextPhotos[slug],
    } : !hero.override && hero.hasPhoto && recorded?.alt && recorded?.credit && recorded?.rightsStatus === 'recorded' && status !== 'unverified' ? {
      src: hero.src,
      alt: recorded.alt,
      caption: status === 'illustrative'
        ? recorded.caption || 'Illustrative image, not this event.'
        : recorded.caption ?? '',
      credit: recorded.credit,
      badge: status === 'illustrative' ? 'Illustrative image' : '',
    } : { src: '/images/generated/coastal-punch-plate.svg', alt: 'Conceptual coastal artwork in Peninsula Insider colours', caption: 'Conceptual editorial artwork, not a depiction of this event.', credit: 'Illustration: Peninsula Insider', badge: 'Illustrative image' };
    const dateISO = pickDateISO(event, now);
    const dateLabel = dateISO ? new Date(dateISO + 'T00:00:00Z').toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
    const fullTitle = String(event.data.title);
    const title = dateLabel && fullTitle.endsWith(', ' + dateLabel)
      ? fullTitle.slice(0, -(', ' + dateLabel).length)
      : fullTitle;
    return {
      slug,
      promotion: event.data._promotionOriginal ?? event,
      title,
      href: `/whats-on/${slug}/`,
      image,
      plateLabel,
      verdict: slug === 'hill-ridge-community-market-september-2026-restart'
        ? 'Local produce and makers at Red Hill Recreation Reserve, Saturday 9am–2pm. Check the organiser if severe weather is forecast.'
        : verdict,
      meta,
      dateISO,
      sourceUrl: event.data.primarySourceUrl ?? event.data.officialEventUrl,
      checkedOn: event.data.lastCheckedDate,
    };
  }),
);
---

{cards.length > 0 && (
  <section id="home-weekend" class="home-weekend" aria-labelledby="home-weekend-title" data-event-promotions-section>
    <div class="container">
      <div class="home-weekend__head">
        <div class="home-weekend__heading">
          <p class="home-weekend__eyebrow">The short list</p>
          <h2 id="home-weekend-title" class="home-weekend__title">This weekend</h2>
        </div>
        <p class="home-weekend__window">{weekend.label}</p>
      </div>

      <p class="home-weekend__scroll-hint">Swipe or scroll for all three picks <span aria-hidden="true">&rarr;</span></p>

      <div class="home-weekend__scroller">
        <CardGrid label="This weekend's picks">
          {cards.map((card, i) => (
            <li data-event-promotion={JSON.stringify({id:card.promotion.id,data:publicEventData(card.promotion.data)})} data-event-promotion-day={card.dateISO}>
            <Card preferAvif={true} as="article"
              variant="event"
              title={card.title}
              href={card.href}
              entityType="event"
              entitySlug={card.slug}
              image={card.image}
              suppressImageHydration={true}
              requireImageMetadata={true}
              verdict={card.verdict}
              meta={card.meta}
              dateISO={card.dateISO}
              showEyebrow={false}
              mediaFallback={true}
              mediaFallbackLabel={card.plateLabel}
              trip={true}
              surface="home-weekend"
              position={i}
            >
              {card.image?.badge && <span slot="badges" class="home-weekend__media-badge">{card.image.badge}</span>}
            </Card>
            {card.sourceUrl?.startsWith('https://') && <p class="home-weekend__source">{card.checkedOn && <span>Event details checked {new Date(card.checkedOn).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})}.</span>} <a href={card.sourceUrl}>Check organiser <span aria-hidden="true">↗</span></a></p>}
            </li>
          ))}
        </CardGrid>
      </div>

      <p class="home-weekend__all">
        More happening this weekend. <a href="/whats-on/">See all events &rarr;</a>
      </p>


    </div>
  </section>
)}


<script>
  import { installEventPromotionRefresh } from '../../../lib/event-discovery.mjs';
  installEventPromotionRefresh(window, document);
</script>

<style>
  .home-weekend__source{font-size:.8125rem;line-height:1.5;color:var(--soft);margin:.6rem .25rem 0}
  .home-weekend__source>span{display:block}
  .home-weekend__source a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent);font-weight:600;text-underline-offset:.2em}
  .home-weekend__scroller :global(.v5-card-grid){align-items:stretch}
  .home-weekend__scroller :global(.v5-card-grid>li){display:flex;flex-direction:column;min-width:0}
  .home-weekend__scroller :global(.pi-card){width:100%;height:100%}
  .home-weekend__scroller :global(.pi-card__media){aspect-ratio:3/2}
  .home-weekend__scroller :global(.pi-card__image-note){min-height:7.5rem;font-size:.8125rem;line-height:1.45}

  :global(.home-weekend__media-badge) {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 1;
    max-width: calc(100% - 2 * var(--space-3));
    padding: .3rem .55rem;
    border-radius: var(--radius-s);
    background: var(--bg-dark);
    color: var(--white);
    font: var(--fw-semibold) var(--fs-100)/var(--lh-ui) var(--font-ui);
  }
  .home-weekend { scroll-margin-top: 9rem; }
  @media (min-width: 64em) {
    .home-weekend__scroller :global(.v5-card-grid--grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-weekend__scroller :global(.pi-card:first-child .pi-card__title) { font-size: 1.875rem; }
  }
  .home-weekend__scroller :global(.pi-card__media) { height: 14.375rem; aspect-ratio: auto; }
  .home-weekend__scroller :global(.pi-card__dek) { font-size: var(--fs-400); line-height: var(--lh-body); display: block; overflow: visible; -webkit-line-clamp: unset; }

  .home-weekend {
    padding: var(--space-7) 0;
  }

  .home-weekend__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .home-weekend__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .home-weekend__eyebrow {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-100);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--teal-text);
  }

  .home-weekend__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-700);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--text);
  }

  /* The single live/now marker: a restrained amber pill. */
  .home-weekend__window {
    margin: 0;
    align-self: center;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--signal) 16%, transparent);
    font-family: var(--font-ui);
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    color: var(--signal-text);
  }

  .home-weekend__scroll-hint {
    display: none;
    margin: calc(-1 * var(--space-3)) 0 var(--space-3);
    color: var(--soft);
    font: var(--fw-semibold) var(--fs-200)/var(--lh-ui) var(--font-ui);
  }

  .home-weekend__scroll-hint span { color: var(--accent); }

  .home-weekend__all {
    margin: var(--space-5) 0 0;
    font-family: var(--font-ui);
    font-weight: var(--fw-bold);
    font-size: var(--fs-400);
  }

  .home-weekend__all a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 2px;
    transition: color var(--dur-fast) var(--ease-enter);
  }

  .home-weekend__all a:hover {
    color: var(--accent);
  }

  /* Below the desktop grid breakpoint the picks row scrolls horizontally
     with a visible peek (wireframe mobile frame: "swipe · 2 more"). The
     override targets CardGrid's ul from this wrapper; scroll is
     reader-driven, never automated. */
  @media (max-width: 63.94em) {
    .home-weekend__scroll-hint { display: block; }
    .home-weekend__scroller :global(.v5-card-grid--grid) {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(21rem, 84vw);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: var(--space-2, 0.5rem);
      -webkit-overflow-scrolling: touch;
    }

    .home-weekend__scroller :global(.v5-card-grid--grid > *) {
      scroll-snap-align: start;
    }

    .home-weekend__scroller :global(.v5-card-grid--grid) {
      align-items: start;
    }

    /* House rail treatment: hide the native scrollbar (swipe affordance
       comes from the visible card peek, per audit-surface-hardening). */
    .home-weekend__scroller :global(.v5-card-grid--grid) {
      scrollbar-width: none;
    }

    .home-weekend__scroller :global(.v5-card-grid--grid)::-webkit-scrollbar {
      display: none;
    }
  }
  @media (max-width: 39.99em) {
    .home-weekend__scroller { margin-right: -1rem; }
    .home-weekend__scroller :global(.v5-card-grid--grid) { column-gap: 1rem; }
    .home-weekend__scroller :global(.pi-card__media) { height: 10.5rem; }
    .home-weekend__scroller :global(.pi-card__body) { padding: 1rem; }
    .home-weekend__scroller :global(.pi-card__title) { font-size: var(--fs-500); line-height: 1.22; }
    .home-weekend__scroller :global(.pi-card__dek) { font-size: var(--fs-300); line-height: 1.45; }
    .home-weekend__scroller :global(.pi-card__image-note) { font-size: .8125rem; line-height: 1.4; }
    .home-weekend__scroller :global(.pi-card__actions) { padding: 0 1rem 1rem; }
  }
</style>
