---
import { publicEventData } from '../../../lib/event-publication.mjs';
/**
 * HomeWeekend - block 3, the homepage's ONLY temporal module
 * (page-redesigns.md 1.9 item 3; wireframes.html #home note 2).
 *
 * Three PI picks for the upcoming weekend, each a v5 event Card with Save
 * and "+ Trip", closed by "Everything on this weekend" into /whats-on/.
 * The cards run without the type eyebrow: "This weekend" plus a date window
 * already declares that these are events, and three stacked EVENT stamps
 * read as machine output rather than an edited page.
 * Picks resolve from the editorial weekend-picks entry for this weekend
 * when one exists; otherwise a ranked fallback over the events collection
 * keeps the module honest between editorial pushes (see home-data.ts).
 *
 * List semantics via CardGrid; below 1024px the grid becomes a horizontal
 * scroller with a visible peek (mobile-strategy: swipe, no carousel, no
 * auto-motion). All server-rendered.
 */
import { eventContentKind } from '../../../lib/event-publication.mjs';
import { getCollection } from 'astro:content';
import Card from '../Card.astro';
import CardGrid from '../CardGrid.astro';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { depictionStatusOf } from '../../../lib/media-provenance';
import { cleanCaption } from '../../../lib/image-caption.mjs';
import {
  selectWeekendPicks,
  categoryLabel,
  placeLabel,
  pickDateISO,
  recurrenceChip,
} from './home-data';

const events = await getCollection('events');
const picksEntries = await getCollection('weekend-picks');
const now = new Date();
const { picks, window: weekend } = selectWeekendPicks(picksEntries, events, now);

const slugOf = (e: any) => e.data.slug ?? e.id;

// Library photographs used for this dated shortlist when the event has no
// photograph of its own. Captioned with the place they show (caption rule:
// src/lib/image-caption.mjs).
const contextPhotos: Record<string, { src: string; alt: string; caption: string; credit: string }> = {
  'hill-ridge-community-market-september-2026-restart': {
    src: '/images/visit-victoria/vv-143096-produce-at-mornington-farmers-market.webp',
    alt: 'A stallholder holds out a bunch of freshly pulled beetroot with leaves attached at Mornington Farmers Market',
    caption: "Mornington Farmers' Market, Mornington Peninsula",
    credit: 'Courtesy of Visit Victoria',
  },
  'national-works-on-paper-2026-nwop': {
    src: '/images/visit-victoria/vv-143144-mornington-peninsula-regional-gallery.webp',
    alt: 'Gallery room at Mornington Peninsula Regional Gallery with framed prints on white walls and sculptures on plinths under a vaulted ceiling',
    caption: 'Mornington Peninsula Regional Gallery, Mornington',
    credit: 'Robert Blackburn, courtesy of Visit Victoria',
  },
};

const cards = await Promise.all(
  picks.map(async ({ event, verdict }) => {
    const slug = slugOf(event);
    const hero = await resolveHero('event', slug, event.data);
    const place =
      event.data.venueName || placeLabel(event.data.place) || event.data.suburb || '';
    const recurrence = recurrenceChip(event);
    const cadence = recurrence?.startsWith('Every Saturday evening year-round') ? 'Every Saturday' : recurrence;
    const kind = eventContentKind(event.data);
    const pickISO = pickDateISO(event, now);
    const shortDate = pickISO ? new Date(pickISO + 'T00:00:00Z').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }) : '';
    const meta = [
      kind === 'event' ? '' : kind === 'offer' ? 'Offer · validity dates' : 'Experience session',
      shortDate,
      place,
      cadence ?? categoryLabel(event.data.category),
    ].filter(Boolean).slice(0, 3);
    const recorded = event.data.heroImage;
    const status = depictionStatusOf(recorded);
    const subcategory = String(event.data.subcategory ?? '').trim();
    const plateLabel = subcategory && subcategory.length <= 20 && !subcategory.includes('/')
      ? subcategory : categoryLabel(event.data.category);
    const image = contextPhotos[slug] && status !== 'actual' ? {
      ...contextPhotos[slug],
    } : !hero.override && hero.hasPhoto && recorded?.alt && recorded?.credit && recorded?.rightsStatus === 'recorded' && status !== 'unverified' ? {
      src: hero.src,
      alt: recorded.alt,
      caption: cleanCaption(recorded.caption),
      credit: recorded.credit,
    } : { src: '/images/generated/coastal-punch-plate.svg', alt: 'Conceptual coastal artwork in Peninsula Insider colours', caption: '', credit: '' };
    const dateISO = pickDateISO(event, now);
    const dateLabel = dateISO ? new Date(dateISO + 'T00:00:00Z').toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
    const fullTitle = String(event.data.title);
    const title = dateLabel && fullTitle.endsWith(', ' + dateLabel)
      ? fullTitle.slice(0, -(', ' + dateLabel).length)
      : fullTitle;
    return {
      slug,
      promotion: event.data._promotionOriginal ?? event,
      title,
      href: `/whats-on/${slug}/`,
      image,
      plateLabel,
      verdict: slug === 'hill-ridge-community-market-september-2026-restart'
        ? 'Local produce and makers at Red Hill Recreation Reserve, Saturday 9am–2pm.'
        : verdict,
      meta,
      dateISO,
      sourceUrl: event.data.primarySourceUrl ?? event.data.officialEventUrl,
      checkedOn: event.data.lastCheckedDate,
    };
  }),
);
---


  <section id="home-weekend" class="home-weekend" aria-labelledby="home-weekend-title" data-event-promotions-section>
    <div class="container">
      <div class="home-weekend__head">
        <div>
          <h2 id="home-weekend-title" class="home-weekend__title">This weekend</h2>
          <p class="home-weekend__window">{weekend.label}</p>
        </div>
        <a class="home-weekend__more" href="/whats-on/">See all events <span aria-hidden="true">→</span></a>
      </div>

      <p data-event-promotion-empty hidden={cards.length > 0}>No verified event picks remain for this weekend. <a href="/whats-on/?date=next-weekend">Browse next weekend</a> or <a href="/explore/">find a place to explore</a>.</p>
      <div data-event-promotion-content hidden={cards.length === 0}>
      <p class="home-weekend__scroll-hint" data-event-promotion-multi-hint hidden={cards.length < 2}>Swipe or scroll through the picks <span aria-hidden="true">&rarr;</span></p>

      <div class="home-weekend__scroller">
        <CardGrid label="This weekend's picks" maxCols={cards.length === 2 ? 2 : 3}>
          {cards.map((card, i) => (
            <li data-event-promotion={JSON.stringify({id:card.promotion.id,data:publicEventData(card.promotion.data)})} data-event-promotion-day={card.dateISO}>
            <Card preferAvif={true} as="article"
              variant="event"
              title={card.title}
              href={card.href}
              entityType="event"
              entitySlug={card.slug}
              image={card.image}
              suppressImageHydration={true}
              requireImageMetadata={true}
              verdict={card.verdict}
              meta={card.meta}
              dateISO={card.dateISO}
              showEyebrow={false}
              mediaFallback={true}
              mediaFallbackLabel={card.plateLabel}
              surface="home-weekend"
              position={i}
            >
            </Card>
            {card.sourceUrl?.startsWith('https://') && <p class="home-weekend__source">{card.checkedOn && <span>Event details checked {new Date(card.checkedOn).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})} · </span>}<a href={card.sourceUrl}>Organiser’s page</a></p>}
            </li>
          ))}
        </CardGrid>
      </div>
      </div>

    </div>
  </section>

<script>
  import { installEventPromotionRefresh } from '../../../lib/event-discovery.mjs';
  installEventPromotionRefresh(window, document);
</script>

<style>
  /* Round 2 (2026-11-10): the same card anatomy as Plan your day (3:2 image,
     title, one line, meta, a quiet credit), then the check date and organiser
     link as one quiet line. "See all events" sits in the heading row. */
  .home-weekend { padding: var(--space-7) 0; scroll-margin-top: 9rem; }
  .home-weekend__head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-bottom: var(--space-5); }
  .home-weekend__title { margin: 0; font-family: var(--font-display); font-weight: var(--fw-display); font-size: var(--fs-700); line-height: var(--lh-heading); letter-spacing: var(--ls-display); color: var(--text); }
  /* The weekend window is plain text under the heading. */
  .home-weekend__window { margin: var(--space-1) 0 0; background: none; color: var(--soft); font: 400 var(--fs-300)/1.4 var(--font-ui); }
  .home-weekend__more { display: inline-flex; align-items: center; gap: .4em; min-height: 44px; color: var(--accent); font: 600 var(--fs-300)/1.4 var(--font-ui); text-decoration: none; }
  .home-weekend__more:hover { text-decoration: underline; text-underline-offset: .2em; }
  .home-weekend a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  /* The visible card peek says "swipe"; the hint stays for assistive tech. */
  .home-weekend__scroll-hint { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .home-weekend__scroller :global(.v5-card-grid) { align-items: start; }
  .home-weekend__scroller :global(.v5-card-grid>li) { min-width: 0; }
  .home-weekend__scroller :global(.pi-card) { width: 100%; }
  /* Save and + Trip live on each event page; on the home short list the card is one link. */
  .home-weekend__scroller :global(.pi-card__actions) { display: none; }
  /* The date reads as plain text in the meta line, not a boxed tile over the picture. */
  .home-weekend__scroller :global(.pi-card__date-block) { display: none; }
  .home-weekend__scroller :global(.pi-card__media) { aspect-ratio: 3/2; height: auto; }
  .home-weekend__scroller :global(.pi-card__body) { display: flex; flex-direction: column; }
  .home-weekend__scroller :global(.pi-card__title) { font-size: var(--fs-500); line-height: 1.25; text-wrap: balance; }
  .home-weekend__scroller :global(.pi-card__dek) { font-size: var(--fs-400); line-height: var(--lh-body); display: block; overflow: visible; -webkit-line-clamp: unset; line-clamp: unset; }
  .home-weekend__source { margin: var(--space-1) 0 0; font-size: var(--fs-100); line-height: 1.45; color: var(--soft); }
  .home-weekend__source a { display: inline-flex; align-items: center; min-height: 24px; color: inherit; text-decoration: underline; text-underline-offset: .2em; }

  @media (min-width: 64em) {
    .home-weekend__scroller :global(.v5-card-grid--grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-weekend__scroller :global(.v5-card-grid--grid.v5-card-grid--two) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Below the desktop grid the picks row scrolls horizontally with a visible
     peek. Reader-driven, never automated; native scrollbar hidden. */
  @media (max-width: 63.94em) {
    .home-weekend__scroller :global(.v5-card-grid--grid) { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(21rem, 84vw); overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: var(--space-2); -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .home-weekend__scroller :global(.v5-card-grid--grid > *) { scroll-snap-align: start; }
    .home-weekend__scroller :global(.v5-card-grid--grid)::-webkit-scrollbar { display: none; }
    .home-weekend__source a { min-height: 44px; }
  }
  @media (max-width: 47.99em) {
    .home-weekend { padding: var(--space-6) 0; }
    .home-weekend__title { font-size: var(--fs-600); }
    .home-weekend__scroller { margin-right: -1rem; }
    .home-weekend__scroller :global(.v5-card-grid--grid) { column-gap: var(--space-4); }
    .home-weekend__scroller :global(.pi-card__dek) { font-size: var(--fs-300); line-height: 1.45; }
  }
</style>
