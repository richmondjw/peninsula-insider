---
import mornington from '../../../content/places/mornington.json';
import redHill from '../../../content/places/red-hill.json';
import sorrento from '../../../content/places/sorrento.json';
import land from '../../../data/home-orientation-land.json';
import { orientationFrame, orientationLandPath, projectOrientationPoint } from '../../../lib/home-orientation-map.mjs';
const areas = [
  {title:'Mornington & the bay',href:'/explore/places/mornington/',point:mornington.coordinates,text:'Town cafes and the bay foreshore. A useful first stop before heading further south.'},
  {title:'Red Hill & the ridge',href:'/explore/places/red-hill/',point:redHill.coordinates,text:'Cellar doors and a booked lunch. Arrange transport between stops.'},
  {title:'Sorrento & the southern coast',href:'/explore/places/sorrento/',point:sorrento.coordinates,text:'Start with the town, then choose a coastal walk. Check conditions before setting out.'},
];
const towns = [mornington, redHill, sorrento];
const labelOffsets = [{ x: 23, y: 6 }, { x: 23, y: 6 }, { x: -12, y: -26 }];
const landPaths = land.rings.map(orientationLandPath);
---
<section class="home-orientation container" aria-labelledby="home-orientation-title">
  <div class="home-orientation__heading"><h2 id="home-orientation-title">Three ways into the Peninsula</h2><a class="home-orientation__more" href="/map/">Open the full map <span aria-hidden="true">→</span></a></div>
  <div class="home-orientation__layout">
    <figure class="home-orientation__diagram">
      <svg viewBox={`0 0 ${orientationFrame.width} ${orientationFrame.height}`} role="img" aria-labelledby="home-town-map-title home-town-map-desc">
        <title id="home-town-map-title">Mornington, Red Hill and Sorrento on the Peninsula</title>
        <desc id="home-town-map-desc">A simplified north-up coastline map. Mornington is on Port Phillip, north of inland Red Hill. Sorrento is to the west near the southern end of the bay. Numbered town locations match the area links. For roads and other places, open the full map.</desc>
        <defs><clipPath id="home-town-map-frame"><rect width="400" height="340" rx="12" /></clipPath></defs>
        <rect width="400" height="340" rx="12" class="home-orientation__water" />
        <g class="home-orientation__land" clip-path="url(#home-town-map-frame)" aria-hidden="true">
          {landPaths.map(d => <path d={d} />)}
        </g>
        <g aria-hidden="true">
          <path d="M34 43V22m-5 7 5-7 5 7" class="home-orientation__compass" />
          <text x="34" y="65" text-anchor="middle" class="home-orientation__north">N</text>
          <text x="109" y="112" text-anchor="middle" class="home-orientation__sea">Port Phillip</text>
        </g>
        {areas.map((area, i) => {
          const p = projectOrientationPoint(area.point);
          const label = labelOffsets[i];
          return <g>
            <circle cx={p.x} cy={p.y} r="16" class="home-orientation__marker" />
            <text x={p.x} y={p.y + 6} text-anchor="middle" class="home-orientation__number">0{i + 1}</text>
            <text x={p.x + label.x} y={p.y + label.y} text-anchor="start" class="home-orientation__town">{towns[i].name}</text>
          </g>;
        })}
      </svg>
      <figcaption>
        <span class="home-orientation__credit">North at top. Coastline simplified from © Commonwealth of Australia (<a href="https://services.ga.gov.au/gis/rest/services/Australian_Shoreline/MapServer/0">Geoscience Australia</a>) 2016, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</span>
      </figcaption>
    </figure>
    <div class="home-orientation__list">
      <ol class="home-orientation__areas">{areas.map((area,i)=><li><span class="home-orientation__index" aria-hidden="true">0{i+1}</span><div><h3><a href={area.href}>{area.title}</a></h3><p>{area.text}</p></div></li>)}</ol>
    </div>
  </div>
</section>
<style>
  .home-orientation{padding-block:var(--space-7)}
  .home-orientation__heading{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:var(--space-2) var(--space-5);margin-bottom:var(--space-5)}
  h2{font:var(--fw-display) var(--fs-700)/var(--lh-heading) var(--font-display);letter-spacing:var(--ls-display);color:var(--text);margin:0}
  .home-orientation__layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:var(--space-7);align-items:start}
  .home-orientation__diagram{margin:0;min-width:0;max-width:400px}.home-orientation__diagram svg{display:block;width:100%}.home-orientation__diagram figcaption{margin-top:var(--space-2)}
  .home-orientation__credit{display:block;font-size:var(--fs-100);line-height:1.45;color:var(--soft)}.home-orientation__credit a{display:inline;min-height:0;font-weight:400;color:inherit;text-decoration:underline}
  .home-orientation__water{fill:#dceff0}.home-orientation__land{fill:#fff4dc;stroke:#769799;stroke-width:1;stroke-linejoin:round}
  .home-orientation__compass{fill:none;stroke:#102d42;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  .home-orientation__town,.home-orientation__number,.home-orientation__north,.home-orientation__sea{font:600 18px var(--font-ui);fill:#102d42}
  .home-orientation__sea{font-weight:400}.home-orientation__marker{fill:#f36b4f;stroke:#fff4dc;stroke-width:2}
  /* One hanging-number grid so the three headings share an edge. */
  ol{list-style:none;margin:0;padding:0}.home-orientation__areas li{display:grid;grid-template-columns:2.25rem minmax(0,1fr);padding-bottom:var(--space-4)}.home-orientation__index{color:var(--soft);font:600 var(--fs-200)/1.5 var(--font-ui);padding-top:.75rem;font-variant-numeric:tabular-nums}
  h3{margin:0;font:600 var(--fs-500)/1.3 var(--font-display)}h3 a{color:var(--text);text-decoration:none}h3 a:hover{text-decoration:underline;text-underline-offset:.2em}li p{font-size:var(--fs-400);line-height:1.5;color:var(--soft);margin:0}
  a{display:inline-flex;align-items:center;min-height:44px}a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
  .home-orientation__more{gap:.4em;color:var(--accent);font:600 var(--fs-300)/1.4 var(--font-ui);text-decoration:none}.home-orientation__more:hover{text-decoration:underline;text-underline-offset:.2em}
  @media(max-width:47.99em){.home-orientation{padding-block:var(--space-6)}.home-orientation__layout{grid-template-columns:1fr;gap:var(--space-5)}.home-orientation__heading h2{font-size:var(--fs-600)}li p{font-size:var(--fs-300)}}
</style>
