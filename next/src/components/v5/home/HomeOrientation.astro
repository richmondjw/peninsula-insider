---
const areas = [
  { title: 'Mornington & the bay', href: '/explore/places/mornington/', image: '/images/visit-victoria/vv-163841-bathing-boxes-at-mornington.webp', caption: 'Mornington, Mornington Peninsula.', credit: 'Courtesy of Visit Victoria', text: 'Start with town cafes and the bay foreshore. A useful first stop before heading further south.' },
  { title: 'Red Hill & the ridge', href: '/explore/places/red-hill/', image: '/images/visit-victoria/vv-160356-montalto.webp', caption: 'Montalto Vineyard & Olive Grove, Red Hill, Mornington Peninsula.', credit: 'Two Palms Australia, courtesy of Visit Victoria', text: 'Build the day around a booked lunch or cellar door. Arrange transport between stops.' },
  { title: 'Sorrento & the southern coast', href: '/explore/places/sorrento/', image: '/images/visit-victoria/vv-163884-millionaire-s-walk.webp', caption: 'Sorrento, Mornington Peninsula.', credit: 'Courtesy of Visit Victoria', text: 'Use the town as your starting point for the southern Peninsula. Check conditions before choosing a coastal walk.' },
];
const photoCredit = (credit: string) => credit === 'Courtesy of Visit Victoria'
  ? 'Photo courtesy of Visit Victoria'
  : `Photo: ${credit}`;
---
<section class="home-orientation container" aria-labelledby="home-orientation-title">
  <div class="home-orientation__heading">
    <div><h2 id="home-orientation-title">Explore by place</h2><p>Three starting points for finding your way around the Peninsula.</p></div>
    <a href="/map/">Open the map →</a>
  </div>
  <ul>{areas.map((area) => <li><figure class="home-orientation__figure"><a class="home-orientation__image" href={area.href} tabindex="-1" aria-hidden="true"><img src={area.image} alt="" loading="lazy" decoding="async" width="640" height="400" /></a><figcaption>{area.caption} <span>{photoCredit(area.credit)}</span></figcaption></figure><h3><a href={area.href}>{area.title} <span aria-hidden="true">&rarr;</span></a></h3><p>{area.text}</p></li>)}</ul>
</section>
<style>
  .home-orientation { padding-block: clamp(3rem, 5vw, 5rem); }
  .home-orientation__heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; }
  h2 { margin: 0; font-family: var(--font-display); font-size: var(--fs-600); line-height: 1.2; }
  .home-orientation__heading p { margin: .5rem 0 0; color: var(--soft); font-size: var(--fs-400); line-height: 1.5; }
  ul { list-style: none; padding: 0; margin: 1.75rem 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  li { border-top: 1px solid var(--border); padding-top: 1rem; min-width: 0; }
  .home-orientation__figure { margin: 0 0 var(--space-4); }
  .home-orientation__image { display: block; overflow: hidden; border-radius: var(--radius-m); }
  .home-orientation__image img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; transition: transform var(--dur-slow) var(--ease-enter); }
  li:hover .home-orientation__image img { transform: scale(1.035); }
  figcaption { color: var(--soft); font-size: .75rem; line-height: 1.45; margin-top: .45rem; }
  figcaption span { white-space: nowrap; }
  h3 { margin: 0; font-size: 1.125rem; line-height: 1.4; }
  h3 span { margin-left: .3em; }
  p { color: var(--soft); font-size: 0.9375rem; line-height: 1.6; margin: 0.5rem 0 0; }
  a { color: var(--teal-text); text-underline-offset: 0.2em; display: inline-flex; align-items: center; min-height: 44px; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media(max-width: 47.99em) {
    ul { grid-template-columns: 1fr; gap: 1rem; }
    /* Place choices read as a compact pictured guide on phones. The image
       remains large enough to establish the town, with the credit adjacent. */
    li { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); column-gap: 1rem; align-content: start; }
    .home-orientation__figure { grid-row: 1 / 3; margin: 0; }
    .home-orientation__image img { aspect-ratio: 1 / 1; }
    h3 { font-size: 1rem; line-height: 1.3; }
    p { font-size: .875rem; line-height: 1.45; margin-top: .35rem; }
  }
  @media(prefers-reduced-motion: reduce) { .home-orientation__image img { transition: none; } li:hover .home-orientation__image img { transform: none; } }
</style>
