---
const areas = [
  { title: 'Mornington & the bay', href: '/explore/places/mornington/', image: '/images/visit-victoria/vv-163841-bathing-boxes-at-mornington.webp', caption: 'Mornington, Mornington Peninsula.', credit: 'Courtesy of Visit Victoria', text: 'Start with town cafes and the bay foreshore. A useful first stop before heading further south.' },
  { title: 'Red Hill & the ridge', href: '/explore/places/red-hill/', image: '/images/visit-victoria/vv-160356-montalto.webp', caption: 'Montalto Vineyard & Olive Grove, Red Hill, Mornington Peninsula.', credit: 'Two Palms Australia, courtesy of Visit Victoria', text: 'Build the day around a booked lunch or cellar door. Arrange transport between stops.' },
  { title: 'Sorrento & the southern coast', href: '/explore/places/sorrento/', image: '/images/visit-victoria/vv-163884-millionaire-s-walk.webp', caption: 'Sorrento, Mornington Peninsula.', credit: 'Courtesy of Visit Victoria', text: 'Use the town as your starting point for the southern Peninsula. Check conditions before choosing a coastal walk.' },
];
const photoCredit = (credit: string) => credit === 'Courtesy of Visit Victoria'
  ? 'Photo courtesy of Visit Victoria'
  : `Photo: ${credit}`;
---
<section class="home-orientation pi-section" aria-labelledby="home-orientation-title">
  <div class="container">
    <header class="pi-section-head">
      <div class="pi-section-head__text">
        <p class="pi-eyebrow">Where to start</p>
        <h2 id="home-orientation-title" class="pi-h2">Explore by place</h2>
        <p class="pi-section-dek">Three starting points for finding your way around the Peninsula.</p>
      </div>
      <a class="pi-section-link" href="/map/">Open the map <span aria-hidden="true">&rarr;</span></a>
    </header>
    <ul class="home-orientation__list">{areas.map((area) => <li><figure class="home-orientation__figure"><a class="home-orientation__image" href={area.href} tabindex="-1" aria-hidden="true"><img src={area.image} alt="" loading="lazy" decoding="async" width="640" height="400" /></a><figcaption>{area.caption} <span>{photoCredit(area.credit)}</span></figcaption></figure><h3><a href={area.href}>{area.title}<span class="home-orientation__arrow" aria-hidden="true">&nbsp;&rarr;</span></a></h3><p>{area.text}</p></li>)}</ul>
  </div>
</section>
<style>
  /* Head, dek, link and vertical spacing come from the shared
     .pi-section-head and .pi-section canon (G1); the region list is local. */
  /* After the warm doors band this section starts on a new ground, so it
     keeps its full top padding even where same-ground sections collapse
     theirs (G23). */
  :global(body .home-doors.pi-section) + .home-orientation.pi-section { padding-top: var(--section-space); }
  .home-orientation__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .home-orientation__list li { border-top: 1px solid var(--border); padding-top: var(--space-4); min-width: 0; }
  .home-orientation__figure { margin: 0 0 var(--space-4); }
  .home-orientation__image { display: block; overflow: hidden; border-radius: var(--radius-m); }
  .home-orientation__image img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; transition: transform var(--dur-slow) var(--ease-enter); }
  .home-orientation__list li:hover .home-orientation__image img { transform: scale(1.035); }
  .home-orientation__figure figcaption { color: var(--soft); font-size: .75rem; line-height: 1.45; margin-top: .45rem; }
  .home-orientation__figure figcaption span { white-space: nowrap; }
  .home-orientation__list h3 { margin: 0; font-family: var(--font-display); font-weight: var(--fw-display); font-size: var(--fs-500); line-height: var(--lh-heading); letter-spacing: var(--ls-display); text-wrap: balance; }
  /* Region titles are links: a harbour arrow at rest says so. The link is
     inline text (not a flex box), so on hover one underline runs under the
     name and the arrow together; the arrow is joined to the last word by a
     no-break space so it never wraps alone. 10px of block padding lifts
     the hit area to 44px without moving the layout. */
  .home-orientation__list h3 a { display: inline; padding-block: 0.625rem; color: var(--text); text-decoration: none; transition: color var(--dur-fast) var(--ease-enter); }
  .home-orientation__list h3 { padding-block: 0.625rem; }
  .home-orientation__arrow { color: var(--harbour); }
  .home-orientation__list h3 a:hover { color: var(--harbour); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .home-orientation__list h3 a:focus-visible { outline: 2px solid var(--focus-ring-color); outline-offset: 3px; border-radius: 2px; }
  .home-orientation__list p { color: var(--soft); font-size: var(--fs-300); line-height: 1.6; margin: var(--space-1) 0 0; max-width: 48ch; text-wrap: pretty; }
  @media (max-width: 47.99em) {
    .home-orientation__list { grid-template-columns: 1fr; gap: var(--space-4); }
    /* Place choices read as a compact pictured guide on phones. The image
       remains large enough to establish the town, with the credit adjacent. */
    .home-orientation__list li { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); column-gap: 1rem; align-content: start; }
    .home-orientation__figure { grid-row: 1 / 3; margin: 0; }
    .home-orientation__image img { aspect-ratio: 1 / 1; }
    .home-orientation__list h3 { font-size: 1rem; line-height: 1.3; }
    .home-orientation__list p { font-size: .875rem; line-height: 1.45; margin-top: .35rem; }
  }
  @media (prefers-reduced-motion: reduce) { .home-orientation__image img { transition: none; } .home-orientation__list li:hover .home-orientation__image img { transform: none; } }
</style>
