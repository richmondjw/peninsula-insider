---
import { cleanCaption, isArtwork } from '../../../lib/image-caption.mjs';
import { editableText, editableImage } from '../../../lib/inline-edit/attrs';
import { loadOverrides } from '../../../lib/inline-edit/overrides';
import { getCollection } from 'astro:content';
import { isListableVenue } from '../../../lib/editorial';
import vvPageImages from '../../../data/visit-victoria-page-images.json';
import mornington from '../../../content/places/mornington.json';
import { checkedSpan } from '../../../lib/checked-span';
// Trust line: how many places the guide covers and when they were last checked.
const listed = (await getCollection('venues')).filter(isListableVenue);
const checked = checkedSpan(listed.map((v) => v.data));
const original = {
  src: '/images/visit-victoria/vv-143799-cape-schanck.webp',
  alt: 'Scrubby cliffs at Cape Schanck falling to a rocky shore and sunlit sea, with the lighthouse on the headland above',
  caption: 'Cape Schanck, Mornington Peninsula.',
  credit: 'Peter Tarasiuk, courtesy of Visit Victoria',
};
const overrides = await loadOverrides('page', 'home');
const published = overrides.image['cover.image'];
const replacement = published?.src && published.alt?.trim() && published.credit?.trim() ? published : undefined;
const photo = replacement ?? original;
const statement = overrides.text['cover.statement'] ?? 'Make a day of the Peninsula.';
const attribution = (image: typeof original) => {
  const credit = image.credit.trim().replace(/\.$/, '');
  const line = /illustration/i.test(credit) ? credit + '.' : /^Courtesy of /i.test(credit)
    ? 'Photo courtesy of ' + credit.slice('Courtesy of '.length) + '.' : 'Photo: ' + credit + '.';
  return cleanCaption(image.caption).replace(/\.$/, '') + '. ' + line;
};
const frames = [
  { key: 'coast', name: 'Coast: Cape Schanck', image: photo, label: 'Start with the coast',
    title: 'Flinders & the Cape', description: 'Coastal walks and one excellent meal.', href: '/explore/plans/flinders-and-cape-reset/' },
  { key: 'ridge', name: 'Ridge: Montalto', image: vvPageImages.images['wine-hub'], label: 'Start in wine country',
    title: 'Red Hill & the ridge', description: 'Cellar doors and a long lunch.', href: '/journal/area-guide-red-hill/' },
  { key: 'bay', name: 'Bay: Mornington bathing boxes', image: mornington.heroImage, label: 'Start by the bay',
    title: 'Mornington & the bay', description: 'Bathing boxes and a foreshore walk.', href: '/explore/places/mornington/' },
];
const editorialRotation = !replacement;
const first = frames[0];
---
<section id="peninsula-cover" class="home-cover" aria-label="Your Peninsula starts here" data-cover-rotation={editorialRotation ? "" : undefined}>
  <figure class="home-cover__plate">
    <img class="home-cover__media" data-cover-media="coast" data-pi-avif="true" src={photo.src} data-pi-responsive="100vw" alt={photo.alt} width="1280" height="853" fetchpriority="high" loading="eager" decoding="async" data-pi-no-hydrate="true" data-pi-requires-image-metadata="true" {...editableImage({entityType:'page',entitySlug:'home',fieldPath:'cover.image',label:'Cover image',purpose:'hero'})} />
    {!isArtwork(photo) && <figcaption>{attribution(photo)}</figcaption>}
  </figure>
  <div class="home-cover__content">
    <p class="home-cover__eyebrow">The independent guide to the Mornington Peninsula</p>
    <h1 class="home-cover__statement" {...editableText({entityType:'page',entitySlug:'home',fieldPath:'cover.statement',label:'Cover statement'})}>{statement === 'Make a day of the Peninsula.' ? <>Make a day<br />of the<br />Peninsula.</> : statement}</h1>
    <p class="home-cover__promise">An independent local guide to where to eat, stay and explore, and how to put the day together.</p>
    <nav class="home-cover__actions" aria-label="Start planning your Peninsula visit"><a href="#home-choose">Find a ready-made day <span aria-hidden="true">&#8595;</span></a></nav>
    <p class="home-cover__trust">Places chosen by our editors{checked ? `, ${checked}` : ''}. Never paid for. <a href="/about/#how-we-choose">How we choose</a></p>
  </div>
  <a class="home-cover__story" href={first.href}>
    <span class="home-cover__story-label">{first.label}</span>
    <strong>{first.title}</strong>
    <span data-cover-description>{first.description}</span>
    <b aria-hidden="true">&#8599;</b>
  </a>
  {editorialRotation && <>
    <div class="home-cover__controls" role="group" aria-label="Homepage cover controls" hidden>
      <div class="home-cover__dots" role="group" aria-label="Choose a cover">
        {frames.map((frame, index) => <button type="button" data-cover-dot={index} aria-label={'Show ' + frame.name} aria-current={index === 0 ? 'true' : undefined}><span></span></button>)}
      </div>
      <button class="home-cover__playback" type="button" aria-controls="peninsula-cover" aria-label="Pause cover rotation" title="Pause cover rotation">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4v8m4-8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <span class="home-cover__announcement" aria-live="polite"></span>
    </div>
    {frames.slice(1).map(frame => <template data-cover-frame={frame.key} data-credit={attribution(frame.image)}
      data-name={frame.name} data-label={frame.label} data-title={frame.title} data-description={frame.description} data-href={frame.href}>
      <div class="home-cover__layer" data-cover-layer={frame.key} aria-hidden="true">
        <img class="home-cover__media" data-cover-media={frame.key} src={frame.image.src} alt={frame.image.alt} decoding="async" />
      </div>
    </template>)}
  </>}
</section>
<nav class="home-cover-paths" aria-label="Find your Peninsula">
  <a href="/eat/">Eat &amp; drink <span aria-hidden="true">&#8599;</span></a>
  <a href="/wine/">Wine country <span aria-hidden="true">&#8599;</span></a>
  <a href="/explore/">Get outside <span aria-hidden="true">&#8599;</span></a>
  <a href="/whats-on/this-weekend/">This weekend <span aria-hidden="true">&#8599;</span></a>
</nav>

<script>
  import { initHomeCover } from "../../../scripts/home-cover";
  initHomeCover();
  document.addEventListener("astro:page-load", initHomeCover);
</script>

<style>
.home-cover{padding:0;position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);background:#0b2e4a;color:white;overflow:hidden;min-height:39.5rem}
.home-cover__plate{position:absolute;inset:0;margin:0;z-index:-2}.home-cover__media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.home-cover:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(4,27,39,.84),rgba(4,27,39,.5) 34%,transparent 58%),linear-gradient(0deg,rgba(4,27,39,.3),transparent 40%)}
.home-cover__content{position:relative;z-index:1;padding:3.75rem 1.5rem 4.75rem max(2rem,calc((var(--page-vw,100vw) - 1280px)/2));min-width:0;align-self:center}
.home-cover__eyebrow{font:600 .6875rem/1.6 var(--font-ui);letter-spacing:.09em;text-transform:uppercase;margin:0 0 1.625rem;color:#fff}
:global(body[data-anchor-page][data-path="/"] #main-content) .home-cover__statement{font:600 clamp(4rem,calc(var(--page-vw,100vw) * .064),5.75rem)/1.02 var(--font-display);letter-spacing:-.065em;max-width:11ch;margin:0 0 1.625rem;color:white;text-wrap:initial;overflow-wrap:anywhere}
.home-cover__promise{font:400 1.3125rem/1.45 var(--font-ui);max-width:30ch;margin:0 0 1.5rem;color:white}
.home-cover__trust{margin:1.125rem 0 0;max-width:34ch;font:400 .9375rem/1.5 var(--font-ui);color:rgba(255,255,255,.92)}.home-cover__trust a{color:#fff;font-weight:600;text-underline-offset:.2em;white-space:nowrap}
.home-cover__actions a{display:inline-flex;align-items:center;justify-content:space-between;gap:1.75rem;min-height:3.25rem;padding:.875rem 1.5rem;border-radius:100px;background:white;color:#0b2e4a;text-decoration:none;font:600 1rem/1.4 var(--font-ui)}.home-cover__actions span{font-size:1.5rem}
.home-cover__story{position:relative;align-self:end;justify-self:end;margin:0 max(2rem,calc((var(--page-vw,100vw) - 1280px)/2)) 4rem 1.5rem;max-width:21rem;display:grid;gap:.375rem;padding:1.375rem 3.25rem 1.375rem 1.5rem;background:#f2efea;color:#0b2e4a;border-radius:6px;text-decoration:none;min-width:0}
.home-cover__story-label{font:600 .6875rem/1.4 var(--font-ui);letter-spacing:.1em;text-transform:uppercase;color:#10527e}.home-cover__story strong{font:600 1.5rem/1.2 var(--font-display);letter-spacing:-.035em}.home-cover__story>span:last-of-type{font:400 .9375rem/1.4 var(--font-ui)}.home-cover__story b{position:absolute;right:1.5rem;top:50%;transform:translateY(-50%);font:400 1.75rem/1 var(--font-ui)}
.home-cover__plate figcaption{position:absolute;right:1rem;bottom:.5rem;z-index:2;background:#0b2e4a;color:white;font:400 .6875rem/1.4 var(--font-ui);padding:.375rem .5625rem;max-width:45ch}
/* Attribution stays above the decorative scrim, rather than darkening with it. */
.home-cover__plate{z-index:auto}.home-cover__media{z-index:-2}.home-cover__plate :global(picture){position:absolute;inset:0;z-index:-2}.home-cover__plate :global(picture img){z-index:auto}
.home-cover a:focus-visible,.home-cover-paths a:focus-visible{outline:3px solid #f5c177;outline-offset:4px}.home-cover__story:focus-visible{outline-color:white}.home-cover a:hover strong{text-decoration:underline;text-underline-offset:.2em}
.home-cover-paths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:#0b2e4a;padding:0 max(2rem,calc((var(--page-vw,100vw) - 1280px)/2))}.home-cover-paths a{display:flex;justify-content:space-between;align-items:center;gap:.75rem;padding:1.375rem 1.25rem;color:white;text-decoration:none;font:600 1rem/1.4 var(--font-ui);border-right:1px solid #315268;min-height:3.25rem}.home-cover-paths a:first-child{padding-left:0}.home-cover-paths a:last-child{border:0;padding-right:0}.home-cover-paths a:hover{text-decoration:underline}
@media(max-width:47.99em){
.home-cover{grid-template-columns:minmax(0,1fr);min-height:41.25rem;padding-bottom:3.5rem;gap:2rem}.home-cover__content{padding:2.5rem 1.5rem 0;align-self:start}.home-cover__eyebrow{font-size:.625rem;max-width:27ch;margin-bottom:1.75rem}:global(body[data-anchor-page][data-path="/"] #main-content) .home-cover__statement{font-size:clamp(2.75rem,13.85vw,3.375rem);line-height:1.03;max-width:10.5ch;margin-bottom:1.25rem}.home-cover__promise{font-size:1.125rem;line-height:1.5;max-width:25ch;margin-bottom:1.125rem}.home-cover__actions a{font-size:.9375rem;padding:.75rem 1.25rem;min-height:3.125rem;gap:1.5rem}
.home-cover__media{height:100%;top:0;object-position:96% top}.home-cover:before{background:linear-gradient(90deg,rgba(4,27,39,.88),rgba(4,27,39,.7) 55%,rgba(4,27,39,.25)),linear-gradient(0deg,rgba(4,27,39,.32),transparent 50%)}.home-cover__trust{font-size:.875rem;max-width:30ch}@media(max-width:22.5em){.home-cover__trust{display:none}}
.home-cover__story{justify-self:stretch;margin:0 1.5rem;max-width:none;padding:1.1875rem 3rem 1.1875rem 1.25rem}.home-cover__story strong{font-size:1.4375rem}.home-cover__story-label{font-size:.625rem}.home-cover__story>span:last-of-type{font-size:.8125rem}.home-cover__plate figcaption{left:0;right:0;bottom:0;max-width:none;font-size:.625rem;padding:.5rem .75rem}
.home-cover-paths{grid-template-columns:repeat(2,minmax(0,1fr));padding:0 1.25rem}.home-cover-paths a,.home-cover-paths a:first-child,.home-cover-paths a:last-child{font-size:.875rem;padding:1.125rem .625rem;min-height:3.625rem;border-right:1px solid #315268;border-bottom:1px solid #315268}.home-cover-paths a:nth-child(even){border-right:0}.home-cover-paths a:nth-child(n+3){border-bottom:0}
}
@media(max-width:22.5em){.home-cover__story strong{font-size:1.25rem}.home-cover__story{padding-right:2.5rem}}
/* The shared headline and links never move with the plates. Each photograph
   keeps its own crop and contrast treatment throughout the crossfade. */
.home-cover[data-cover-rotation]{container-type:inline-size;overflow-anchor:none;--hero-inset:max(2rem,calc((100cqw - 1280px)/2));--shade-left:.88;--shade-mid:.69;--shade-edge:.30;--shade-lower:.43}
.home-cover[data-cover-rotation]::before,.home-cover__layer::after{background:linear-gradient(90deg,rgb(4 23 35 / var(--shade-left)),rgb(4 23 35 / var(--shade-mid)) clamp(240px,calc((100% - 1280px)/2 + 290px),50%),rgb(4 23 35 / var(--shade-edge)) clamp(365px,calc((100% - 1280px)/2 + 520px),69%),transparent 76%),linear-gradient(0deg,rgb(4 23 35 / var(--shade-lower)),transparent 37%)}
.home-cover__layer{position:absolute;inset:0;z-index:0;isolation:isolate;opacity:0;pointer-events:none;transition:opacity 950ms ease}
.home-cover__layer[data-visible]{opacity:1}
.home-cover__layer::after{content:'';position:absolute;inset:0}
.home-cover__layer[data-cover-layer=ridge]{--shade-left:.89;--shade-mid:.72;--shade-edge:.32;--shade-lower:.45}
.home-cover__layer[data-cover-layer=bay]{--shade-left:.91;--shade-mid:.75;--shade-edge:.35;--shade-lower:.53}
.home-cover[data-cover-rotation] .home-cover__media{display:block;max-width:none}
.home-cover[data-cover-rotation] [data-cover-media=coast]{object-position:67% 34%}
.home-cover [data-cover-media=ridge]{object-position:57% 58%}
.home-cover [data-cover-media=bay]{object-position:63% 58%}
.home-cover[data-cover-rotation] .home-cover__content{padding-inline-start:var(--hero-inset)}
.home-cover[data-cover-rotation] .home-cover__story{z-index:1;margin-inline-end:var(--hero-inset);width:min(21rem,calc(100% - 4rem))}
.home-cover[data-cover-rotation] figcaption{inset-inline-end:var(--hero-inset);max-width:min(42ch,calc(50% - var(--hero-inset) - 6.5rem))}
.home-cover[data-cover-rotation] .home-cover__story,.home-cover[data-cover-rotation] .home-cover__plate figcaption,.home-cover__controls{pointer-events:auto}
.home-cover__controls{position:absolute;z-index:3;left:50%;bottom:.8rem;transform:translateX(-50%);display:flex;align-items:center;width:max-content;padding:0 2px;border-radius:999px;color:#fff;background:rgb(5 25 39 / .66);border:1px solid rgb(255 255 255 / .35);box-shadow:0 2px 10px rgb(0 0 0 / .12);backdrop-filter:blur(6px)}
.home-cover__controls[hidden]{display:none}
.home-cover__dots{display:flex}
.home-cover__controls button{appearance:none;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:none;color:inherit;cursor:pointer}
.home-cover__controls button:hover{background:rgb(255 255 255 / .12)}
.home-cover__controls button:focus-visible{outline:2px solid #f5c177;outline-offset:-4px}
.home-cover__dots span{width:7px;height:7px;border:1px solid currentColor;border-radius:50%}
.home-cover__dots [aria-current=true] span{background:#fff}
.home-cover__playback{position:relative}
.home-cover__playback::before{content:'';position:absolute;left:0;height:14px;border-left:1px solid rgb(255 255 255 / .35)}
.home-cover__playback svg{width:15px;height:15px}
.home-cover__announcement{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:47.99em){
  .home-cover[data-cover-rotation]::before,.home-cover__layer::after{background:linear-gradient(90deg,rgb(4 23 35 / .88),rgb(4 23 35 / .66) 65%,rgb(4 23 35 / .27)),linear-gradient(0deg,rgb(4 23 35 / .50),transparent 55%)}
  #peninsula-cover[data-cover-rotation]{padding:0 0 3.25rem;gap:.625rem}
  #peninsula-cover[data-cover-rotation] .home-cover__content{padding:1.75rem 1.5rem 0}
  .home-cover[data-cover-rotation] [data-cover-media=coast]{object-position:89% 40%}
  .home-cover [data-cover-media=ridge]{object-position:57% 51%}
  .home-cover [data-cover-media=bay]{object-position:65% 56%}
  .home-cover[data-cover-rotation] .home-cover__story{width:auto;margin-inline:1.5rem;min-height:7.8rem}
  .home-cover[data-cover-rotation] figcaption{inset-inline:0;max-width:none}
  .home-cover__controls{position:relative;left:auto;bottom:auto;transform:none;justify-self:center;margin-top:-.1rem}
}
@media(max-width:22.5em){.home-cover[data-cover-rotation] .home-cover__story{min-height:8.5rem}}
@media(prefers-reduced-motion:reduce){.home-cover__layer{transition:none}}
</style>
