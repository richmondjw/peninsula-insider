---
/**
 * HomeAsk - block 7, the Ask PI band (page-redesigns.md 1.9 item 7;
 * wireframes.html #home note 6).
 *
 * One line in PI's voice (Local archetype) plus a real labelled input.
 * Plain GET form to /ask/?q=... - the Ask page auto-fires on a ?q param
 * (pages/ask.astro), so this works with zero JS here and prefills the
 * unified Ask surface exactly as the spec asks. The submit carries
 * data-evt="ask_open" for the shared v5 analytics listener.
 */
---

<section class="home-ask" aria-labelledby="home-ask-title">
  <div class="container home-ask__inner">
    <h2 id="home-ask-title" class="home-ask__sr">Ask Peninsula Insider</h2>
    <p class="home-ask__line">
      Tell me what you're after. The more specific, the sharper the answer.
    </p>
    <form class="home-ask__form" action="/ask/" method="get">
      <label class="home-ask__sr" for="home-ask-q">Ask Peninsula Insider a question</label>
      <input
        class="home-ask__input"
        id="home-ask-q"
        name="q"
        type="text"
        placeholder="Long lunch, Red Hill, six people"
        autocomplete="off"
        minlength="3"
      />
      <button
        class="home-ask__submit"
        type="submit"
        data-evt="ask_open"
        data-src="home"
      >
        Ask PI
      </button>
    </form>
  </div>
</section>

<script>
  import { initV5Analytics } from '../../../lib/v5-analytics';
  initV5Analytics();
</script>

<style>
  .home-ask {
    padding: var(--space-7, 3rem) 0;
    background: var(--bg-alt, var(--bg));
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .home-ask__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .home-ask__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5, 1.5rem);
    flex-wrap: wrap;
  }

  .home-ask__line {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display, 600);
    font-size: var(--fs-600, 1.375rem);
    line-height: var(--lh-heading, 1.2);
    color: var(--ink);
    max-width: 26ch;
    flex: 1 1 18rem;
  }

  .home-ask__form {
    display: flex;
    gap: var(--space-2, 0.5rem);
    flex: 1 1 22rem;
    max-width: 32rem;
  }

  .home-ask__input {
    flex: 1;
    min-height: 48px;
    padding: 0 var(--space-4, 1rem);
    font-family: var(--font-ui);
    font-size: var(--fs-400, 1.0625rem);
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--border-strong, var(--border));
    border-radius: var(--radius-m, 10px);
  }

  .home-ask__input::placeholder {
    color: var(--soft);
  }

  .home-ask__input:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }

  .home-ask__submit {
    min-height: 48px;
    padding: 0 var(--space-5, 1.5rem);
    font-family: var(--font-ui);
    font-weight: var(--fw-semibold, 600);
    font-size: var(--fs-400, 1.0625rem);
    color: var(--bg);
    background: var(--ink);
    border: none;
    border-radius: var(--radius-m, 10px);
    cursor: pointer;
  }

  .home-ask__submit:hover {
    background: var(--accent);
  }

  .home-ask__submit:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }

  @media (max-width: 47.94em) {
    .home-ask__form {
      flex-wrap: wrap;
    }

    .home-ask__submit {
      flex: 1 1 auto;
    }
  }
</style>
