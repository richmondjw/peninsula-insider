---
/**
 * HomeDoors - block 4, the four front doors (page-redesigns.md 1.9 item 4;
 * wireframes.html #home note 3).
 *
 * Eat & Drink · Stay · Wine · Explore as four large door cards: one image,
 * one short editorial description each. Door images resolve through the SAME CMS slot as
 * each hub's GuideHero (page/<hub>, fieldPath "hero"), so an editor's hub
 * hero replacement updates the door too.
 *
 * 4-across desktop, 2x2 on tablet, horizontal image-and-copy cards on
 * phones. Every verdict line sits on a solid paper surface so CMS image
 * changes cannot reduce text contrast.
 */
import { pageImage } from '../../../lib/page-images';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { editableImage } from '../../../lib/inline-edit/attrs';

const doors = [
  {
    key: 'eat',
    label: 'Eat & Drink',
    href: '/eat/',
    line: 'Places worth planning lunch around',
    fallback: pageImage('home-door-eat'),
  },
  {
    key: 'stay',
    label: 'Stay',
    href: '/stay/',
    line: 'From a weekend shack to a cliff house',
    fallback: pageImage('home-door-stay'),
  },
  {
    key: 'wine',
    label: 'Wine',
    href: '/wine/',
    line: 'Cellar doors worth taking the turn for',
    fallback: pageImage('home-door-wine'),
  },
  {
    key: 'explore',
    label: 'Explore',
    href: '/explore/',
    line: 'Walks, beaches, springs, and the roads between them',
    fallback: pageImage('home-door-explore'),
  },
];

const resolved = await Promise.all(
  doors.map(async (door) => {
    const hero = await resolveHero(
      'page',
      door.key,
      { heroImage: door.fallback },
      'hero',
    );
    return { ...door, src: hero.src, alt: hero.alt || door.fallback.alt, credit: hero.override?.credit ?? (hero.src === door.fallback.src ? door.fallback.credit : undefined), caption: hero.override?.caption ?? (hero.src === door.fallback.src ? door.fallback.caption : undefined) };
  }),
);
---

<section class="home-doors" aria-labelledby="home-doors-title">
  <div class="container">
    <h2 id="home-doors-title" class="home-doors__title">Explore by interest</h2>
    <ul class="home-doors__grid">
      {resolved.map((door, i) => (
        <li class="home-doors__item">
          <a
            class="home-doors__card"
            href={door.href}
            data-evt="card_click"
            data-entity-type="page"
            data-entity-slug={door.key}
            data-surface="home-doors"
            data-position={i}
          >
            <span class="home-doors__media">
              <img data-pi-avif="true"
                src={door.src}
                alt=""
                loading="lazy"
                decoding="async"
                {...editableImage({
                  entityType: 'page',
                  entitySlug: door.key,
                  fieldPath: 'hero',
                  label: `${door.label} door image`,
                  purpose: 'card',
                })}
              />
            </span>
            <span class="home-doors__copy">
              <span class="home-doors__heading">
                <span class="home-doors__label">{door.label}</span>
                <span class="home-doors__arrow" aria-hidden="true">↗</span>
              </span>
              <span class="home-doors__line">{door.line}</span>
            </span>
            {door.credit && <span class="home-doors__credit">{door.caption?.replace(/, Mornington Peninsula\.$/, '')} Photo: {door.credit}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { initV5Analytics } from '../../../lib/v5-analytics';
  initV5Analytics();
</script>

<style>
  .home-doors {
    padding: var(--space-7) 0;
    background: var(--bg-alt);
  }

  .home-doors__title {
    margin: 0 0 var(--space-5);
    color: var(--text);
    font: var(--fw-display) var(--fs-700)/var(--lh-heading) var(--font-display);
    letter-spacing: var(--ls-display);
  }

  .home-doors__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  /* Photography and copy have distinct surfaces. Editors can replace any
     image without changing the readability of the title or verdict line. */
  .home-doors__card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-l);
    text-decoration: none;
    color: var(--text);
    background: var(--white);
  }
  .home-doors__card:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 3px;
  }

  .home-doors__media {
    position: relative;
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--bg-alt);
  }

  .home-doors__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-enter);
  }

  .home-doors__card:hover .home-doors__media img {
    transform: scale(1.04);
  }

  .home-doors__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 8.5rem;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .home-doors__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .home-doors__label {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-600);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--text);
  }

  .home-doors__arrow {
    flex: none;
    font: var(--fw-medium) var(--fs-300)/1 var(--font-ui);
    color: var(--accent);
    transition: transform var(--dur-med) var(--ease-enter);
  }

  .home-doors__card:hover .home-doors__arrow,
  .home-doors__card:focus-visible .home-doors__arrow {
    transform: translate(2px, -2px);
  }

  .home-doors__credit { display: block; padding: .55rem var(--space-5) var(--space-4); color: var(--soft); font-family: var(--font-ui); font-size: .75rem; font-weight: 400; line-height: 1.4; }
  .home-doors__line {
    margin-top: var(--space-1);
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    line-height: var(--lh-dek);
    color: var(--soft);
    max-width: 30ch;
  }

  @media (max-width: 63.94em) {
    .home-doors__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 47.94em) {
    .home-doors__label {
      font-size: var(--fs-500);
    }
  }

  /* Phone cards read like compact editorial postcards: image to the left,
     text on paper to the right, with no photo-dependent scrim. */
  @media (max-width: 35.94em) {
    .home-doors__grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .home-doors__card {
      grid-template-columns: 44% minmax(0, 1fr);
      grid-template-rows: auto;
    }
    .home-doors__media {
      grid-column: 1;
      grid-row: 1;
      aspect-ratio: auto;
      min-height: 10.5rem;
    }
    .home-doors__copy {
      grid-column: 2;
      grid-row: 1;
      min-height: 10.5rem;
      padding: var(--space-4);
    }
    .home-doors__credit { grid-column: 1 / -1; grid-row: 2; padding: .5rem var(--space-4) .75rem; }
    .home-doors__line {
      font-size: var(--fs-300);
      line-height: var(--lh-dek);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-doors__media img,
    .home-doors__arrow {
      transition: none;
    }
    .home-doors__card:hover .home-doors__media img,
    .home-doors__card:hover .home-doors__arrow,
    .home-doors__card:focus-visible .home-doors__arrow {
      transform: none;
    }
  }
</style>
