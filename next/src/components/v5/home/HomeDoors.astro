---
/**
 * HomeDoors - block 4, the four front doors (page-redesigns.md 1.9 item 4;
 * wireframes.html #home note 3).
 *
 * Eat & Drink · Stay · Wine · Explore as four large door cards: one image,
 * one short editorial description each. Door images resolve through the SAME CMS slot as
 * each hub's GuideHero (page/<hub>, fieldPath "hero"), so an editor's hub
 * hero replacement updates the door too.
 *
 * 4-across desktop, 2x2 from tablet down. Verdict lines are always
 * visible (spec 1.22 allows hover reveal; content must be visible by
 * default on touch, so we show it everywhere - no motion, no surprises).
 */
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { editableImage } from '../../../lib/inline-edit/attrs';

const doors = [
  {
    key: 'eat',
    label: 'Eat & Drink',
    href: '/eat/',
    line: 'Places worth planning lunch around',
    fallback: {
      src: '/images/sourced/venue-italian-dining-01.webp',
      alt: 'A Peninsula dining room, table laid, light low',
    },
  },
  {
    key: 'stay',
    label: 'Stay',
    href: '/stay/',
    line: 'From a weekend shack to a cliff house',
    fallback: {
      src: '/images/sourced/venue-jackalope-hotel-01.webp',
      alt: 'Jackalope Hotel, Merricks North vineyard at dusk',
    },
  },
  {
    key: 'wine',
    label: 'Wine',
    href: '/wine/',
    line: 'Cellar doors worth taking the turn for',
    fallback: {
      src: '/images/sourced/article-cellar-door-01.webp',
      alt: 'A Peninsula cellar door, bottles open, glasses poured',
    },
  },
  {
    key: 'explore',
    label: 'Explore',
    href: '/explore/',
    line: 'Walks, beaches, springs, and the roads between them',
    fallback: {
      src: '/images/sourced/explore-cape-schanck-lighthouse-01.webp',
      alt: 'Cape Schanck Lighthouse and the Bass Strait coast',
    },
  },
];

const resolved = await Promise.all(
  doors.map(async (door) => {
    const hero = await resolveHero(
      'page',
      door.key,
      { heroImage: door.fallback },
      'hero',
    );
    return { ...door, src: hero.src, alt: hero.alt || door.fallback.alt };
  }),
);
---

<section class="home-doors pi-section" aria-labelledby="home-doors-title">
  <div class="container">
    <header class="pi-section-head">
      <div class="pi-section-head__text">
        <p class="pi-eyebrow">The guide</p>
        <h2 id="home-doors-title" class="pi-h2">Explore by interest</h2>
      </div>
    </header>
    <ul class="home-doors__grid">
      {resolved.map((door, i) => (
        <li class="home-doors__item">
          <a
            class="home-doors__card"
            href={door.href}
            data-evt="card_click"
            data-entity-type="page"
            data-entity-slug={door.key}
            data-surface="home-doors"
            data-position={i}
          >
            <span class="home-doors__media">
              <img
                src={door.src}
                alt=""
                loading="lazy"
                decoding="async"
                {...editableImage({
                  entityType: 'page',
                  entitySlug: door.key,
                  fieldPath: 'hero',
                  label: `${door.label} door image`,
                  purpose: 'card',
                })}
              />
            </span>
            <span class="home-doors__scrim" aria-hidden="true"></span>
            <span class="home-doors__label">{door.label}</span>
            <span class="home-doors__line">{door.line}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { initV5Analytics } from '../../../lib/v5-analytics';
  initV5Analytics();
</script>

<style>
  /* Vertical rhythm comes from the shared .pi-section spacing token. */
  .home-doors {
    background: var(--bg-alt);
  }
  /* A band paints its own ground, so it keeps a full section-space inside
     its colour on both sides. The doubled class outranks any same-ground
     `.pi-section + .pi-section` padding collapse (G23). */
  :global(body) .home-doors.home-doors.pi-section {
    padding-block: var(--section-space);
  }

  /* The module heading is the shared .pi-section-head (eyebrow plus Sora
     H2), like every other section on the page. The old visually hidden
     h2 left this band as the only one with no visible title. */

  .home-doors__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  /* Tall rounded photo tile: image fills, dark scrim, text overlaid.
     justify-content:flex-end pins the label and line to the foot of the
     tile, inside the densest part of the bottom-up scrim. */
  .home-doors__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* aspect-ratio sets the preferred height; min-height:auto lets the card
       grow when the verdict line wraps, so overlaid text can never collide. */
    aspect-ratio: 3 / 4;
    padding: var(--space-5);
    overflow: hidden;
    /* The 16px card radius, the same corner as the event cards, the
       journal picture and the plan cards. */
    border-radius: var(--radius-m);
    text-decoration: none;
    color: var(--white);
  }
  .home-doors__card:focus-visible {
    outline: 2px solid var(--focus-ring-color-inverse);
    outline-offset: 3px;
  }

  .home-doors__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
    background: var(--bg-deep);
  }

  .home-doors__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-enter);
  }

  .home-doors__card:hover .home-doors__media img {
    transform: scale(1.04);
  }

  /* Cover scrim canon: harbour-deep, bottom-up, at least .82 alpha across
     the whole text zone, so the label and line hold 4.5:1 on any photo
     (bright sky, vine leaves, the white lighthouse) without text-shadow.
     The zone is confined to the text: the label and its reserved two-line
     line fill the bottom ~25% of a 3:4 tile, the .82 floor holds to 32%,
     and the tint is gone by 54%, so the top half of every photograph
     shows in natural colour. Worst case, white paper under .82
     harbour-deep composites to about rgb(55 84 107): 7.9:1 for white
     label text and about 6:1 for the .92 line. */
  .home-doors__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(11 46 74 / .88) 0%,
      rgb(11 46 74 / .82) 32%,
      rgb(11 46 74 / 0) 54%
    );
  }

  .home-doors__label {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-600);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--white);
  }

  .home-doors__card:hover .home-doors__label {
    color: var(--mint);
  }

  .home-doors__line {
    margin-top: var(--space-1);
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    line-height: var(--lh-dek);
    /* Brighter than --soft-inverse: over a photo the scrim floor is .82,
       not the solid ground that token was cut for. */
    color: rgb(237 241 245 / .92);
    max-width: 30ch;
    text-wrap: pretty;
    /* Two lines reserved on every tile, so a one-line line and a two-line
       line leave their labels on the same baseline across the row. Written
       in em times the line-height token rather than lh units so it holds
       in every browser. */
    min-height: calc(2em * var(--lh-dek));
  }

  @media (max-width: 63.94em) {
    .home-doors__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 47.94em) {
    .home-doors__label {
      font-size: var(--fs-500);
    }
  }

  /* Phones. Ordering: these max-width blocks must run largest to
     smallest, or the 2-column tablet rule wins at 375px.

     The doors stay photographic: a 2x2 grid of 4:5 photo tiles on the
     16px card radius, text bottom-anchored over the same harbour scrim.
     In a tile this narrow the longest line runs to three lines, so three
     are reserved on every tile, and the label, the reserved line block
     and the padding fill the bottom ~45%. The scrim holds its .84 floor
     to 50% and is gone by 74%, which keeps the top quarter of each
     photograph clear. aspect-ratio is a preferred height only (min-height
     stays auto), so a long line grows the tile instead of being cut off. */
  @media (max-width: 35.94em) {
    .home-doors__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
    }
    .home-doors__card {
      aspect-ratio: 4 / 5;
      padding: var(--space-4);
    }
    .home-doors__scrim {
      background: linear-gradient(
        to top,
        rgb(11 46 74 / .9) 0%,
        rgb(11 46 74 / .84) 50%,
        rgb(11 46 74 / 0) 74%
      );
    }
    .home-doors__label {
      font-size: var(--fs-500);
    }
    .home-doors__line {
      font-size: var(--fs-200);
      line-height: var(--lh-ui);
      max-width: none;
      min-height: calc(3em * var(--lh-ui));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-doors__media img {
      transition: none;
    }
    .home-doors__card:hover .home-doors__media img {
      transform: none;
    }
  }
</style>
