---
/**
 * HomeDoors - block 4, the four front doors (page-redesigns.md 1.9 item 4;
 * wireframes.html #home note 3).
 *
 * Eat & Drink · Stay · Wine · Explore as four large door cards: one image,
 * one verdict-flavoured count line each. Counts are computed from the
 * venues collection at build time so the numbers stay honest; the flavour
 * is fixed Critic copy. Door images resolve through the SAME CMS slot as
 * each hub's GuideHero (page/<hub>, fieldPath "hero"), so an editor's hub
 * hero replacement updates the door too.
 *
 * 4-across desktop, 2x2 from tablet down. Verdict lines are always
 * visible (spec 1.22 allows hover reveal; content must be visible by
 * default on touch, so we show it everywhere - no motion, no surprises).
 */
import { getCollection } from 'astro:content';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { editableImage } from '../../../lib/inline-edit/attrs';
import { stayTypes } from '../../../lib/editorial';
import { countWord } from './home-data';

const venues = (await getCollection('venues')).filter(
  (v) => v.data.status !== 'permanently_closed',
);

/* Same type buckets the hubs themselves count with. */
const eatTypes = ['restaurant', 'cafe', 'bakery', 'pub', 'market', 'winery'];
const eat = venues.filter((v) => eatTypes.includes(v.data.type));
const eatPicks = eat.filter((v) => v.data.editorPick).length;
const stays = venues.filter((v) => stayTypes.includes(v.data.type));
const wineries = venues.filter((v) => v.data.type === 'winery');

const doors = [
  {
    key: 'eat',
    label: 'Eat & Drink',
    href: '/eat/',
    count: `${eat.length} places`,
    line:
      eatPicks > 0
        ? `${eat.length} places, ${countWord(eatPicks)} worth planning around`
        : `${eat.length} places, the bookings sorted from the walk-ins`,
    fallback: {
      src: '/images/sourced/venue-italian-dining-01.webp',
      alt: 'A Peninsula dining room, table laid, light low',
    },
  },
  {
    key: 'stay',
    label: 'Stay',
    href: '/stay/',
    count: `${stays.length} stays`,
    line: `${stays.length} stays, from shack to cliff house`,
    fallback: {
      src: '/images/sourced/venue-jackalope-hotel-01.webp',
      alt: 'Jackalope Hotel, Merricks North vineyard at dusk',
    },
  },
  {
    key: 'wine',
    label: 'Wine',
    href: '/wine/',
    count: `${wineries.length} cellar doors`,
    line: `${wineries.length} cellar doors, ranked by the pour, not the view`,
    fallback: {
      src: '/images/sourced/article-cellar-door-01.webp',
      alt: 'A Peninsula cellar door, bottles open, glasses poured',
    },
  },
  {
    key: 'explore',
    label: 'Explore',
    href: '/explore/',
    count: 'Walks & beaches',
    line: 'Walks, beaches, springs, and the roads between them',
    fallback: {
      src: '/images/sourced/explore-cape-schanck-lighthouse-01.webp',
      alt: 'Cape Schanck Lighthouse and the Bass Strait coast',
    },
  },
];

const resolved = await Promise.all(
  doors.map(async (door) => {
    const hero = await resolveHero(
      'page',
      door.key,
      { heroImage: door.fallback },
      'hero',
    );
    return { ...door, src: hero.src, alt: hero.alt || door.fallback.alt };
  }),
);
---

<section class="home-doors" aria-labelledby="home-doors-title">
  <div class="container">
    <h2 id="home-doors-title" class="home-doors__title">The four ways in</h2>
    <ul class="home-doors__grid">
      {resolved.map((door, i) => (
        <li class="home-doors__item">
          <a
            class="home-doors__card"
            href={door.href}
            data-evt="card_click"
            data-entity-type="page"
            data-entity-slug={door.key}
            data-surface="home-doors"
            data-position={i}
          >
            <span class="home-doors__media">
              <img
                src={door.src}
                alt=""
                loading="lazy"
                decoding="async"
                {...editableImage({
                  entityType: 'page',
                  entitySlug: door.key,
                  fieldPath: 'hero',
                  label: `${door.label} door image`,
                  purpose: 'card',
                })}
              />
            </span>
            <span class="home-doors__scrim" aria-hidden="true"></span>
            <span class="home-doors__count">{door.count}</span>
            <span class="home-doors__label">{door.label}</span>
            <span class="home-doors__line">{door.line}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { initV5Analytics } from '../../../lib/v5-analytics';
  initV5Analytics();
</script>

<style>
  .home-doors {
    padding: var(--space-7) 0;
    background: var(--bg-alt);
  }

  /* Module heading is visually hidden (wireframe: "Four doors, h2 visually
     hidden") but stays in the document outline for AT users. */
  .home-doors__title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .home-doors__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  /* Tall rounded photo tile: image fills, dark scrim, text overlaid. */
  .home-doors__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 3 / 4;
    padding: var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-l);
    text-decoration: none;
    color: var(--white);
  }
  /* Small phones: 2-up tiles get too cramped (long verdict lines overflow),
     so drop to a single wider tile with tighter padding. */
  @media (max-width: 26em) {
    .home-doors__grid { grid-template-columns: 1fr; }
    .home-doors__card { aspect-ratio: 16 / 10; padding: var(--space-4); }
  }

  .home-doors__card:focus-visible {
    outline: 2px solid var(--focus-ring-color-inverse);
    outline-offset: 3px;
  }

  .home-doors__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
    background: var(--bg-deep);
  }

  .home-doors__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-enter);
  }

  .home-doors__card:hover .home-doors__media img {
    transform: scale(1.04);
  }

  .home-doors__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--bg-deep) 88%, transparent) 0%,
      color-mix(in srgb, var(--bg-deep) 32%, transparent) 46%,
      transparent 100%
    );
  }

  /* Verdict-count eyebrow, mint, top-left. */
  .home-doors__count {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--fs-100);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--mint);
  }

  .home-doors__label {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-600);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--white);
  }

  .home-doors__card:hover .home-doors__label {
    color: var(--mint);
  }

  .home-doors__line {
    margin-top: var(--space-1);
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    line-height: var(--lh-dek);
    color: var(--soft-inverse);
    max-width: 30ch;
  }

  @media (max-width: 63.94em) {
    .home-doors__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 47.94em) {
    .home-doors__label {
      font-size: var(--fs-500);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-doors__media img {
      transition: none;
    }
    .home-doors__card:hover .home-doors__media img {
      transform: none;
    }
  }
</style>
