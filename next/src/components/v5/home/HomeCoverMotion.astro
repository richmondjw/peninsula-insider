<video class="cover-motion" data-cover-motion muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-src="/video/pi-homepage-motion-20261002.mp4?v=8d56bf63"></video>
<script>
  let refreshMotion = () => {};
  let cleanupMotion = () => {};
  document.addEventListener('visibilitychange', () => refreshMotion());
  document.addEventListener('astro:before-swap', () => cleanupMotion());
  function initCoverMotion() {
    const video = document.querySelector<HTMLVideoElement>('[data-cover-motion]');
    const root = video?.closest<HTMLElement>('.home-cover');
    if (!video || !root || video.dataset.ready) return;
    video.dataset.ready = 'true';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = matchMedia('(max-width: 767px)');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    let failed = false, visible = true;
    const credits = root.querySelectorAll<HTMLElement>('[data-cover-attribution]');
    function setScene(index: number) {
      credits.forEach((credit, i) => { credit.hidden = i !== index || credit.dataset.creditEmpty === 'true'; });
      video!.style.objectPosition = mobile.matches ? ['90% center','50% center','68% center','50% center'][index] : 'center';
    }
    function frame() {
      const t = video!.currentTime;
      setScene(t < 6.5 || t >= 25.5 ? 0 : t < 12.5 ? 1 : t < 19 ? 2 : 3);
    }
    function sync() {
      const still = reduce.matches || !!connection?.saveData || failed || document.body.dataset.piEditMode === 'on';
      video!.hidden = still;
      if (still) setScene(0);
      if (still || document.hidden || !visible) { video!.pause(); return; }
      if (!video!.src) video!.src = video!.dataset.src!;
      video!.muted = true;
      video!.play().catch(() => { failed = true; sync(); });
    }
    video.addEventListener('playing', () => { if (!reduce.matches && !failed) video.classList.add('is-playing'); });
    video.addEventListener('timeupdate', frame);
    video.addEventListener('error', () => { failed = true; sync(); });
    refreshMotion = sync;
    reduce.addEventListener('change', sync);
    mobile.addEventListener('change', frame);
    const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); });
    observer.observe(root);
    const editObserver = new MutationObserver(sync);
    editObserver.observe(document.body, { attributes: true, attributeFilter: ['data-pi-edit-mode'] });
    cleanupMotion = () => { observer.disconnect(); editObserver.disconnect(); reduce.removeEventListener('change',sync); mobile.removeEventListener('change',frame); video!.pause(); refreshMotion = () => {}; };
    sync();
  }
  initCoverMotion();
  document.addEventListener('astro:page-load', initCoverMotion);
</script>
<style>
  .cover-motion { position:absolute; inset:0; z-index:-2; width:100%; height:100%; object-fit:cover; opacity:0; }
  .cover-motion.is-playing { opacity:1; }
  .cover-motion[hidden] { display:none; }
  @media (prefers-reduced-motion:reduce) { .cover-motion { display:none; } }
</style>
