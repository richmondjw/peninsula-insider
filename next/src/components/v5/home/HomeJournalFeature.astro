---
/**
 * HomeJournalFeature - block 6, the one flagship Journal feature
 * (page-redesigns.md 1.9 item 6; wireframes.html #home note 5: "Exactly
 * one Journal feature; more editorial lives behind Journal").
 *
 * The desk selects a current seasonal feature and an evergreen fallback.
 * Picks remain discoverable at their own URLs but never fill this curated slot.
 * Hero resolves through resolveHero so CMS image overrides
 * survive rebuilds; the img carries the editableImage slot.
 */
import { getCollection } from 'astro:content';
import { isJournalDiscovery } from '../../../lib/journal-curation.mjs';
import { routeSlug, formatLabel } from '../../../lib/editorial';
import { resolveHero } from '../../../lib/inline-edit/resolve-hero';
import { editableImage } from '../../../lib/inline-edit/attrs';

const published = await getCollection('articles', ({ data }) => isJournalDiscovery(data));
// The spring school-holiday guide expires on 5 October. Its own
// promotionExpiresAt controls the switch to the evergreen Red Hill guide.
const lead = ['spring-school-holidays-2026', 'area-guide-red-hill']
  .map((slug) => published.find((article) => routeSlug(article) === slug))
  .find((article) => article !== undefined);
const slug = lead ? routeSlug(lead) : '';
const hero = lead ? await resolveHero('article', slug, lead.data, 'hero') : null;
const kicker = lead?.data.tags.includes('insider-picks') ? 'Insider Picks' : (lead ? (formatLabel[lead.data.format] ?? 'Feature') : '');
---

{lead && hero && (
  <section class="home-journal" aria-labelledby="home-journal-title">
    <div class="container home-journal__layout">
    <figure class="home-journal__media">
      <img
        src={hero.src} data-pi-responsive="(max-width: 767px) 100vw, 55vw"
        alt={hero.alt || lead.data.title}
        loading="lazy"
        decoding="async"
        {...editableImage({
          entityType: 'article',
          entitySlug: slug,
          fieldPath: 'hero',
          label: `${lead.data.title} image`,
          purpose: 'hero',
        })}
      />
    </figure>
    <div class="home-journal__body">
      <p class="home-journal__kicker">From the Journal <span aria-hidden="true">&middot;</span> {kicker}</p>
      <h2 id="home-journal-title" class="home-journal__headline">
        <a
          href={`/journal/${slug}/`}
          data-evt="card_click"
          data-entity-type="article"
          data-entity-slug={slug}
          data-surface="home-journal"
        >
          {lead.data.title}
        </a>
      </h2>
      {lead.data.dek && <p class="home-journal__dek">{lead.data.dek}</p>}
      <p class="home-journal__cta">
        <a href={`/journal/${slug}/`} tabindex="-1" aria-hidden="true">Read the story &rarr;</a>
      </p>
    </div>
    </div>
  </section>
)}

<script>
  import { initV5Analytics } from '../../../lib/v5-analytics';
  initV5Analytics();
</script>

<style>
  .home-journal { background: var(--paper, var(--bg-alt)); padding-block: clamp(2rem, 4vw, 3.5rem); border-block: 1px solid var(--border); }
  .home-journal__layout { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .home-journal__media { margin: 0; min-width: 0; }
  .home-journal__media img { display: block; width: 100%; aspect-ratio: 1.3; object-fit: cover; border-radius: var(--radius-m); }
  .home-journal__body { min-width: 0; }
  .home-journal__kicker { font: var(--fw-semibold) var(--fs-100)/var(--lh-ui) var(--font-ui); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--accent); margin: 0 0 var(--space-4); }
  .home-journal__headline { font: var(--fw-display) clamp(2rem, 3vw, 3rem)/1.12 var(--font-display); letter-spacing: -.035em; text-wrap: balance; margin: 0; }
  .home-journal__headline a { color: var(--accent); text-decoration: none; }
  .home-journal__headline a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .15em; }
  .home-journal__dek { font-size: var(--fs-500); line-height: var(--lh-body); margin: var(--space-5) 0; max-width: 40ch; }
  .home-journal__cta { font-weight: var(--fw-semibold); margin-top: var(--space-5); }
  .home-journal__cta a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 47.94em) { .home-journal__layout { grid-template-columns: 1fr; gap: var(--space-5); } .home-journal__dek { font-size: var(--fs-400); } }
</style>
