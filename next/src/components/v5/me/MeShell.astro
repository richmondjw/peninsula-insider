---
/**
 * MeShell (v5) - the My Peninsula reader-layer header (tools spec 4.9, 4.21).
 *
 * One door for "my stuff": Saved, My Trip, Account. Tabs are real links to
 * shell pages, never JS tabs (spec 4.26 - no tab-role misuse). Used by
 * /me/saved/ and /me/trip/; Account points at the existing /account/ page
 * until that surface moves under /me/.
 *
 * The count slot is filled by the page script once the local store has
 * rendered (client data, so it cannot be static).
 */
export interface Props {
  active: 'saved' | 'trip';
  heading: string;
}

const { active, heading } = Astro.props;

const tabs = [
  { id: 'saved', label: 'Saved', href: '/me/saved/' },
  { id: 'trip', label: 'My Trip', href: '/me/trip/' },
  { id: 'account', label: 'Account', href: '/account/' },
];
---

<header class="me-shell">
  <p class="me-shell__eyebrow">My Peninsula</p>
  <h1 class="me-shell__heading">
    {heading}
    <slot name="count" />
  </h1>
  <nav class="me-shell__nav" aria-label="My Peninsula">
    {tabs.map((tab) => (
      <a
        href={tab.href}
        class="me-shell__tab"
        aria-current={tab.id === active ? 'page' : undefined}
      >
        {tab.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .me-shell {
    padding: var(--space-6, 2rem) 0 0;
  }

  .me-shell__eyebrow {
    margin: 0 0 var(--space-1, 0.25rem);
    font-family: var(--font-ui, 'Outfit', system-ui, sans-serif);
    font-size: var(--fs-100, 0.75rem);
    font-weight: var(--fw-semibold, 600);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .me-shell__heading {
    margin: 0 0 var(--space-4, 1rem);
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: var(--fs-800, clamp(2rem, 1.6rem + 2vw, 2.75rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-display, 1.08);
    color: var(--text);
  }

  .me-shell__nav {
    display: flex;
    gap: var(--space-2, 0.5rem);
    border-bottom: 1px solid var(--border);
  }

  .me-shell__tab {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-3, 0.75rem);
    font-family: var(--font-ui, 'Outfit', system-ui, sans-serif);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-medium, 500);
    color: var(--soft);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .me-shell__tab:hover {
    color: var(--text);
  }

  .me-shell__tab[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .me-shell__tab:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: -2px;
  }
</style>
