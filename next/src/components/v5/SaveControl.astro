---
/**
 * SaveControl (v5) - save/unsave an entity to the reader's list.
 * Successor to PiSaveActions for the v5 Card system (spec 2.25).
 *
 * - Same pi:saves:v2 store as the rest of the site (lib/saves/store);
 *   no parallel store is introduced (BUILD-CONTRACT rule).
 * - Save only: cards carry Save, never Share (spec 2.26 keeps Share off cards).
 * - 48px touch target, aria-pressed, accessible name "Save {title}".
 * - Emits save_add / save_remove / plan_fork through v5-analytics.
 * - Never nested inside a card's stretched link; Card places it in an
 *   actions layer above the link (no nested interactive elements).
 *
 * NOTE for the CI enforcer follow-up (component spec section 0, rule 2):
 * next/scripts/check-editable-coverage.mjs still asserts on <PiSaveActions;
 * it needs a matching <SaveControl rule (kind/slug/title/href) when the
 * enforcer file's owner updates it. Props here keep those exact names so
 * the future rule is a one-line addition.
 */
export interface Props {
  kind: 'article' | 'venue' | 'place' | 'event' | 'experience' | 'itinerary' | 'tour' | 'tour-operator' | 'tour-package';
  slug: string;
  title: string;
  href: string;
  /** Editorial section, required for articles (saved-list grouping). */
  section?: string;
  /** Short summary; carried into the saved-plan view. */
  dek?: string;
  /** Cover image; carried into the saved-plan view. */
  imageUrl?: string;
  /** Show the text label next to the icon (detail pages, plan cards). */
  labelled?: boolean;
  /**
   * 'save' (default) or 'fork' (plan entities only). Both save to the same
   * list and wear the same bookmark; fork reads "Save plan" and reports
   * plan_fork. The old copy glyph gave no clue what it did.
   */
  variant?: 'save' | 'fork';
}

const {
  kind,
  slug,
  title,
  href,
  section,
  dek,
  imageUrl,
  labelled = false,
  variant = 'save',
} = Astro.props;

const isFork = variant === 'fork';
const restLabel = isFork ? 'Save plan' : 'Save';
/* The visible label leads the accessible name (WCAG 2.5.3, label in name). */
const accessibleName = isFork ? `Save plan: ${title}` : `Save ${title}`;
---

<div
  class="v5-save"
  data-v5-save-control
  data-kind={kind}
  data-slug={slug}
  data-title={title}
  data-href={href}
  data-section={section}
  data-dek={dek}
  data-image={imageUrl}
  data-variant={variant}
>
  <button
    type="button"
    class:list={['v5-save__btn', labelled && 'v5-save__btn--labelled', isFork && 'v5-save__btn--fork']}
    aria-pressed="false"
    aria-label={accessibleName}
    data-v5-save-btn
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
    </svg>
    <span class:list={['v5-save__label', !labelled && 'v5-save__label--sr']} data-v5-save-label>
      {restLabel}
    </span>
  </button>
</div>

<style>
  .v5-save {
    display: inline-flex;
  }

  .v5-save__btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    /* 48px touch target (build brief; exceeds the 44px spec floor). */
    min-width: 48px;
    min-height: 48px;
    padding: 0 0.6rem;
    background: var(--bg, #fff);
    color: var(--soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-200, 0.8125rem);
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-ui, 1.4);
    transition:
      background var(--dur-fast, 120ms) var(--ease, ease),
      border-color var(--dur-fast, 120ms) var(--ease, ease),
      color var(--dur-fast, 120ms) var(--ease, ease);
  }

  .v5-save__btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .v5-save__btn:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }

  .v5-save__btn[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--white, #fff);
  }

  .v5-save__btn[aria-pressed='true'] svg path {
    fill: currentColor;
  }

  /* With a visible label the control is a button, not an icon: 8px radius
     and the button inset, like the "Add to trip" button beside it. The
     icon-only bookmark stays the 48px circle. */
  .v5-save__btn--labelled {
    gap: var(--space-2, 0.5rem);
    padding: 0 var(--space-4, 1rem);
    border-radius: var(--radius-s, 8px);
    font-size: var(--fs-300, 0.9375rem);
    color: var(--harbour);
  }

  /* Icon-only mode keeps the label for screen readers. */
  .v5-save__label--sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import * as Saves from '../../lib/saves/store';
  import type { SaveKind } from '../../lib/saves/store';
  import { trackEvent, initV5Analytics } from '../../lib/v5-analytics';

  initV5Analytics();

  function hydrate(el: HTMLElement) {
    if ((el as any)._v5Init) return;
    (el as any)._v5Init = true;

    const kind = el.dataset.kind as SaveKind;
    const slug = el.dataset.slug;
    const title = el.dataset.title || slug || '';
    const href = el.dataset.href || (typeof location !== 'undefined' ? location.pathname : '/');
    const section = el.dataset.section;
    const dek = el.dataset.dek;
    const image_url = el.dataset.image;
    const variant = el.dataset.variant || 'save';
    if (!kind || !slug) return;

    const btn = el.querySelector<HTMLButtonElement>('[data-v5-save-btn]');
    if (!btn) return;
    const label = btn.querySelector<HTMLElement>('[data-v5-save-label]');

    const restLabel = el.dataset.restLabel || 'Save';

    function paint() {
      const saved = Saves.isSaved(kind, slug!);
      btn!.setAttribute('aria-pressed', saved ? 'true' : 'false');
      if (label) label.textContent = saved ? 'Saved' : restLabel;
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const wasSaved = Saves.isSaved(kind, slug!);
      const result = Saves.toggle({ kind, slug: slug!, section, title, dek, image_url, href });
      if (!result.ok) {
        // Private mode / quota: nothing changed and no repaint fires. Do not
        // paint "Saved", and do not report an event that did not happen.
        btn!.setAttribute('title', 'Saving is unavailable in this browser');
        if (label) {
          const previous = label.textContent;
          label.textContent = 'Not saved';
          setTimeout(() => { label.textContent = previous; }, 1600);
        }
        return;
      }
      const evt = variant === 'fork' ? 'plan_fork' : wasSaved ? 'save_remove' : 'save_add';
      trackEvent(evt, {
        entity_type: kind,
        entity_slug: slug,
        surface: 'card',
      });
    });

    paint();
    // Deliberately NOT Saves.onChange(paint) per control. onChange returns an
    // unsubscribe nothing here could call, and the store's listener set lives
    // in a bundled module that the client router never re-evaluates - so a
    // per-control subscription survives the swap that discards its control,
    // and every navigation adds one more callback repainting a detached
    // button. One module-scope subscription below repaints whatever is live.
    (el as any)._v5Paint = paint;
  }

  function paintAll() {
    document.querySelectorAll<HTMLElement>('[data-v5-save-control]').forEach((el) => {
      const fn = (el as any)._v5Paint;
      if (typeof fn === 'function') fn();
    });
  }
  Saves.onChange(paintAll);

  function init() {
    document.querySelectorAll<HTMLElement>('[data-v5-save-control]').forEach(hydrate);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
