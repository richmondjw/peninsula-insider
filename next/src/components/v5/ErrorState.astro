---
/**
 * ErrorState (v5) - recoverable failure surface (spec 2.34).
 *
 * Honest, Local voice, no error codes in the body (code goes in the micro
 * detail line), no blame, no jokes. Primary "Try again" fires error_retry
 * through v5-analytics; the owning surface listens for the click and
 * retries the failed request only.
 *
 * Set live={true} when this component is inserted dynamically so it
 * announces via role="alert"; leave it off for server-rendered error
 * routes (404/500 pages compose the `page` variant).
 */
export interface Props {
  variant?: 'inline' | 'page';
  heading?: string;
  body?: string;
  /** Machine detail, e.g. an HTTP status. Micro line, not body copy. */
  detail?: string;
  retryLabel?: string;
  /** Region identifier carried on the error_retry event. */
  region?: string;
  /** True when inserted client-side: adds role="alert". */
  live?: boolean;
  /** Hide the retry button (e.g. static 404 pages). */
  retry?: boolean;
}

const {
  variant = 'inline',
  heading = variant === 'page' ? 'That page is not here' : 'That did not load',
  body = variant === 'page'
    ? 'The link may be old, or the page has moved. The search box below will find it if we have it.'
    : 'Give it another go. Reception runs thin between towns, so this happens.',
  detail,
  retryLabel = 'Try again',
  region,
  live = false,
  retry = variant !== 'page',
} = Astro.props;
---

<div class:list={['v5-error', `v5-error--${variant}`]} role={live ? 'alert' : undefined}>
  <svg
    class="v5-error__icon"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9" />
    <path d="M12 8v4" />
    <path d="M12 16h.01" />
  </svg>
  <h3 class="v5-error__heading">{heading}</h3>
  <p class="v5-error__body">{body}</p>
  {detail && <p class="v5-error__detail">{detail}</p>}
  <div class="v5-error__actions">
    {retry && (
      <button
        type="button"
        class="v5-error__retry"
        data-evt="error_retry"
        data-region={region}
        data-v5-error-retry
      >
        {retryLabel}
      </button>
    )}
    <slot name="actions" />
    {variant === 'page' && (
      <nav class="v5-error__links" aria-label="popular sections">
        <a href="/eat/">Eat &amp; Drink</a>
        <a href="/wine/">Wine</a>
        <a href="/whats-on/">What's On</a>
      </nav>
    )}
  </div>
</div>

<style>
  .v5-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    padding: var(--space-7, 3rem) var(--space-5, 1.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-m, var(--tile-image-radius, 10px));
  }

  .v5-error--page {
    border: none;
    padding: var(--space-8, 4rem) var(--space-5, 1.5rem);
  }

  .v5-error__icon {
    color: var(--gold-text);
  }

  .v5-error__heading {
    margin: 0;
    font-family: var(--font-display, var(--font-display));
    font-size: var(--fs-600, clamp(1.375rem, 1.2rem + 0.8vw, 1.625rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.2);
    color: var(--text);
  }
  .v5-error--page .v5-error__heading {
    font-size: var(--fs-700, clamp(1.75rem, 1.4rem + 1.6vw, 2.25rem));
  }

  .v5-error__body {
    margin: 0;
    max-width: var(--measure-dek, 52ch);
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    line-height: var(--lh-ui, 1.4);
    color: var(--soft);
  }

  .v5-error__detail {
    margin: 0;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-100, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .v5-error__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .v5-error__retry {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.1rem;
    background: var(--accent);
    color: var(--white, #fff);
    border: none;
    border-radius: var(--radius-s, 4px);
    cursor: pointer;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-medium, 500);
    transition: background var(--dur-fast, 120ms) var(--ease, ease);
  }
  .v5-error__retry:hover {
    background: var(--acc-h);
  }
  .v5-error__retry:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .v5-error__retry[disabled] {
    opacity: 0.4;
    cursor: default;
  }

  .v5-error__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .v5-error__links a {
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-medium, 500);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    padding: 0.75rem 0;
  }
  .v5-error__links a:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
</style>

<script>
  import { initV5Analytics } from '../../lib/v5-analytics';
  initV5Analytics();
</script>
