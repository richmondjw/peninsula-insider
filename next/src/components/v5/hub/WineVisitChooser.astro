---
/**
 * Three ways into a wine-country day. The "confirm with the producer" caveat
 * is stated once on the page, under the directory heading, not on each row.
 */
const visits = [
  { title: 'A tasting, then move on', line: 'Make one cellar door the anchor when you have only part of the day. Choose the wine interest first, then check its tasting format.', label: 'Browse tasting-first visits', href: '/wine/?mood=tasting-first#wine-directory' },
  { title: 'Lunch is the main event', line: 'Choose a winery with a kitchen, book the meal, then fit the tasting around it. Leave room for the visit itself.', label: 'Find wineries with lunch', href: '/wine/?mood=lunch-attached#wine-directory' },
  { title: 'Wine worth an appointment', line: 'Build the day around a confirmed tasting time. Add another stop only after checking the journey and the available appointment.', label: 'Read the appointment guide', href: '/wine/appointment-producers/' },
];
---
<section class="wine-choices pi-section" aria-labelledby="wine-choices-heading">
  <div class="container">
    <div class="pi-section-head">
      <div class="pi-section-head__text">
        <p class="pi-eyebrow">Choose your visit</p>
        <h2 class="pi-h2" id="wine-choices-heading">What kind of <span class="nowrap">wine-country</span> day?</h2>
      </div>
    </div>
    <div class="wine-choices__rows">
      {visits.map((visit) => (
        <article class="wine-choices__row">
          <h3>{visit.title}</h3>
          <div>
            <p>{visit.line}</p>
            <a class="pi-section-link" href={visit.href}>{visit.label} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
    <div class="wine-choices__foot">
      <p><strong>Plan the return trip first.</strong> Arrange a designated driver or transport before tasting. Use <a href="/map/?cat=winery">the winery map</a> for location, then check the actual route and timing.</p>
      <p><strong>Make wine optional.</strong> Pair the area with <a href="/explore/?cat=gallery#directory">art and galleries</a> or <a href="/explore/rainy-day/">a rainy-day plan</a>. Ask the venue about non-alcoholic options before booking.</p>
    </div>
  </div>
</section>
<style>
  .wine-choices__row { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-6, 2rem); border-top: 1px solid var(--border); padding-block: var(--space-5, 1.5rem); }
  h3 { font: 600 var(--fs-600, 1.375rem)/1.25 var(--font-display); color: var(--text); margin: 0; text-wrap: balance; }
  /* Row and foot copy only: a bare `p` rule here would outrank the section
     head's canonical eyebrow margin. */
  .wine-choices__row p, .wine-choices__foot p { margin: 0 0 var(--space-2, 0.5rem); max-width: 70ch; }
  /* The compound stays whole: .pi-h2 balances, and a plain hyphen is a
     legal break (U+2011 is not an option; Sora has no glyph for it). */
  .nowrap { white-space: nowrap; }
  a { color: var(--harbour, #10527E); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  a:hover { color: var(--harbour-h, #0C4166); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* The practical tips read at body size, like the rows above them. */
  .wine-choices__foot { border-top: 1px solid var(--border); padding-top: var(--space-5, 1.5rem); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6, 2rem); font-size: var(--fs-400, 1.0625rem); line-height: var(--lh-body, 1.65); color: var(--text); text-wrap: pretty; }
  .wine-choices__foot p { margin: 0; }
  strong { color: var(--text); font-weight: 600; }
  @media (max-width: 48em) {
    .wine-choices__row, .wine-choices__foot { grid-template-columns: 1fr; gap: var(--space-3, 0.75rem); }
  }
</style>
