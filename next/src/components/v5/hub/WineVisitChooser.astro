---
/**
 * WineVisitChooser - three ways into a wine-country day, as a quiet
 * three-column row on the page ground (round 2, 2026-11-10: the navy band,
 * white boxes, numerals and the two advice paragraphs went; the return-trip
 * line stays, once, as the footnote).
 */
const visits = [
  { title: 'A tasting, then move on', line: 'Make one cellar door the anchor when you have only part of the day. Choose the wine interest first, then check its tasting format.', label: 'Browse tasting-first visits', href: '/wine/?mood=tasting-first#browse-wine' },
  { title: 'Lunch is the main event', line: 'Choose a winery with a kitchen, book the meal, then fit the tasting around it. Leave room for the visit itself.', label: 'Find wineries with lunch', href: '/wine/?mood=lunch-attached#browse-wine' },
  { title: 'Wine worth an appointment', line: 'Build the day around a confirmed tasting time. Add another stop only after checking the journey and the available appointment.', label: 'Read the appointment guide', href: '/wine/appointment-producers/' },
];
---
<section class="wine-choices" id="wine-choices" aria-labelledby="wine-choices-heading">
  <div class="container">
    <h2 id="wine-choices-heading">What kind of day in wine country?</h2>
    <p class="wine-choices__intro">Choose the shape of the day first, then confirm hours and booking with the producer before you travel.</p>
    <div class="wine-choices__rows">
      {visits.map((visit) => (
        <article class="wine-choices__row">
          <h3>{visit.title}</h3>
          <p>{visit.line}</p>
          <a href={visit.href}>{visit.label} <span aria-hidden="true">&rarr;</span></a>
        </article>
      ))}
    </div>
    <p class="wine-choices__foot"><strong>Plan the return trip first.</strong> Arrange a designated driver or transport before tasting, and use <a href="/map/?cat=winery">the winery map</a> to check the route.</p>
  </div>
</section>
<style>
  .wine-choices { padding-block: var(--space-7); scroll-margin-top: 10rem; }
  .wine-choices h2 { max-width: 22ch; margin: 0; font-family: var(--font-display); font-size: var(--fs-700); line-height: var(--lh-heading); letter-spacing: -.01em; color: var(--text); text-wrap: balance; }
  .wine-choices__intro { max-width: 52ch; margin: var(--space-2) 0 var(--space-6); color: var(--soft); font-size: var(--fs-400); line-height: var(--lh-dek); }
  .wine-choices__rows { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .wine-choices__row { display: flex; flex-direction: column; min-width: 0; }
  .wine-choices h3 { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: var(--fs-500); line-height: 1.25; letter-spacing: var(--ls-display); color: var(--text); }
  .wine-choices__row p { margin: 0; color: var(--soft); font-size: var(--fs-400); line-height: var(--lh-dek); }
  .wine-choices__row a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; align-self: flex-start; margin-top: auto; padding-top: var(--space-2); color: var(--accent); font-size: var(--fs-300); font-weight: 600; text-decoration: none; }
  .wine-choices__row a:hover, .wine-choices__foot a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .wine-choices__foot { max-width: 70ch; margin: var(--space-5) 0 0; color: var(--soft); font-size: var(--fs-300); line-height: 1.5; }
  .wine-choices__foot strong { color: var(--text); }
  .wine-choices__foot a { color: var(--accent); text-underline-offset: .2em; }
  .wine-choices a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 800px) {
    .wine-choices__rows { grid-template-columns: 1fr; gap: var(--space-5); }
    .wine-choices__row a { margin-top: 0; }
  }
</style>
