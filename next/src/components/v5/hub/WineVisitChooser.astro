---
const visits = [
  { title: 'A tasting, then move on', line: 'Make one cellar door the anchor when you have only part of the day. Choose the wine interest first, then check its tasting format.', constraint: 'Walk-in labels do not promise space today. Confirm hours and availability with the producer.', label: 'Browse tasting-first visits', href: '/wine/?mood=tasting-first#browse-wine' },
  { title: 'Lunch is the main event', line: 'Choose a winery with a kitchen, book the meal, then fit the tasting around it. Leave room for the visit itself.', constraint: 'A restaurant reservation and a tasting reservation may be separate.', label: 'Find wineries with lunch', href: '/wine/?mood=lunch-attached#browse-wine' },
  { title: 'Wine worth an appointment', line: 'Build the day around a confirmed tasting time. Add another stop only after checking the journey and the available appointment.', constraint: 'Booking policies vary by producer; the guide is a starting point, not live availability.', label: 'Read the appointment guide', href: '/wine/appointment-producers/' },
];
---
<section class="wine-choices" id="wine-choices" aria-labelledby="wine-choices-heading">
  <div class="container">
    <div class="wine-choices__intro">
      <p class="wine-choices__eyebrow">Start with the kind of visit</p>
      <h2 id="wine-choices-heading">What kind of wine-country day?</h2>
      <p>Choose the shape of the day first. Then check the producer's current hours and booking details before travelling.</p>
    </div>
    <div class="wine-choices__rows">
      {visits.map((visit, index) => (
        <article class="wine-choices__row">
          <span class="wine-choices__number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{visit.title}</h3>
          <p>{visit.line}</p>
          <p class="wine-choices__constraint">{visit.constraint}</p>
          <a href={visit.href}>{visit.label} <span aria-hidden="true">&rarr;</span></a>
        </article>
      ))}
    </div>
    <div class="wine-choices__foot">
      <p><strong>Plan the return trip first.</strong> Arrange a designated driver or transport before tasting. Use <a href="/map/?cat=winery">the winery map</a> for location, then check the route and timing.</p>
      <p><strong>Make wine optional.</strong> Pair the area with <a href="/explore/?cat=gallery#directory">art and galleries</a> or <a href="/explore/rainy-day/">a rainy-day plan</a>. Ask the venue about non-alcoholic options before booking.</p>
    </div>
  </div>
</section>
<style>
  .wine-choices { padding-block: clamp(3rem, 5vw, 5rem); background: #0e3249; color: #fff; scroll-margin-top: 10rem; }
  .wine-choices__intro { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: .7rem 2.5rem; align-items: end; margin-bottom: 2rem; }
  .wine-choices__eyebrow { grid-column: 1 / -1; margin: 0; color: #edbc79; font-size: .75rem; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
  .wine-choices h2 { max-width: 14ch; margin: 0; color: #fff; font-family: var(--font-display); font-size: clamp(2.3rem, 3.8vw, 3.8rem); line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
  .wine-choices__intro > p:last-child { max-width: 48ch; margin: 0 0 .25rem; color: #dce9ee; font-size: 1.03rem; line-height: 1.58; }
  .wine-choices__rows { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .wine-choices__row { display: flex; flex-direction: column; min-width: 0; padding: clamp(1.25rem, 2vw, 1.85rem); border-top: 4px solid #bd8752; border-radius: .25rem; background: #fff; color: var(--text); }
  .wine-choices__number { color: #8d5a2b; font-size: .77rem; font-weight: 750; letter-spacing: .12em; }
  .wine-choices h3 { max-width: 17ch; margin: .7rem 0 1rem; font-family: var(--font-display); font-size: clamp(1.55rem, 2vw, 2rem); line-height: 1.12; letter-spacing: -.025em; }
  .wine-choices__row p { margin: 0; font-size: .96rem; line-height: 1.55; }
  .wine-choices__row .wine-choices__constraint { margin-top: .8rem; color: var(--soft); font-size: .84rem; }
  .wine-choices__row a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; align-self: flex-start; margin-top: auto; padding-top: 1rem; color: #89531d; font-size: .91rem; font-weight: 750; text-underline-offset: .2em; }
  .wine-choices__foot { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 2.2rem; padding-top: 1.4rem; border-top: 1px solid #547185; color: #dce9ee; font-size: .9rem; line-height: 1.6; }
  .wine-choices__foot p { max-width: 62ch; margin: 0; }
  .wine-choices__foot strong { color: #fff; }
  .wine-choices__foot a { color: #fff; text-underline-offset: .2em; }
  .wine-choices a:focus-visible { outline: 3px solid #edbc79; outline-offset: 3px; }
  @media (max-width: 800px) {
    .wine-choices__intro { grid-template-columns: 1fr; gap: .75rem; }
    .wine-choices__rows { grid-template-columns: 1fr; }
    .wine-choices__row { min-height: 0; }
    .wine-choices__row a { margin-top: .5rem; }
    .wine-choices__foot { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
