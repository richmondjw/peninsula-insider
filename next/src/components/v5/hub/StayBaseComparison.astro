---
const bases = [
  { name: 'Red Hill & Main Ridge', places: 'red-hill,main-ridge', town: 'red-hill', go: 'Vineyard lunches and a quieter hinterland weekend.', evening: 'Make dinner part of the booking plan; properties and cellar doors are spread out.', trade: 'Arrange transport between stops. A ridge address does not mean a walkable winery route.' },
  { name: 'Sorrento & Rye', places: 'sorrento,rye', town: 'sorrento', go: 'Bay foreshore days with a coastal village base.', evening: 'Look for a property near the village if dinner on foot matters.', trade: 'Check the actual address: the bay, ocean coast and hot springs are separate outings.' },
  { name: 'Mornington', places: 'mornington', town: 'mornington', go: 'A town base for dining, the foreshore and a shorter trip down the Peninsula.', evening: 'Choose the centre for access to the main street’s food and drink.', trade: 'The southern beaches and ridge wineries still need their own transport plan.' },
  { name: 'Flinders', places: 'flinders', town: 'flinders', go: 'A smaller village base for the southern coast.', evening: 'Plan around the village’s opening days before choosing a dinner spot.', trade: 'Allow for transfers to the ridge and bay coast; do not assume a late return ride is available.' },
];
---
<section class="base-comparison pi-section" aria-labelledby="base-heading">
  <div class="container">
    <div class="pi-section-head">
      <div class="pi-section-head__text">
        <p class="pi-eyebrow">Where to base yourself</p>
        <h2 class="pi-h2" id="base-heading">Each corner of the Peninsula makes a different weekend</h2>
        <p class="pi-section-dek">Pick the days you want, then the bed. These are area comparisons; check each property’s address and transport before booking.</p>
      </div>
      <a class="pi-section-link" href="/map/">Compare stays on the map <span aria-hidden="true">→</span></a>
    </div>
    <div class="base-comparison__rows">
      {bases.map((base) => (
        <article class="base-comparison__row">
          <h3><a href={`/explore/places/${base.town}/`}>{base.name}</a></h3>
          <div><p>{base.go}</p><p class="base-comparison__detail"><strong>Evenings.</strong> {base.evening}</p><p class="base-comparison__detail"><strong>Getting around.</strong> {base.trade}</p></div>
          <div class="base-comparison__actions"><a href={`/stay/?place=${base.places}#stay-directory`}><span class="base-comparison__label">Find stays</span> <span aria-hidden="true">→</span></a></div>
        </article>
      ))}
    </div>
    <div class="base-comparison__foot">
      <p>Travelling without a car? Start with <a href="/explore/getting-around/">the transport guide</a> and check the journeys for your dates before selecting a base.</p>
    </div>
  </div>
</section>
<style>
  /* Row copy only: a bare `p` rule here would outrank the section head's
     canonical eyebrow and dek margins. */
  .base-comparison__row p { margin: 0 0 var(--space-2, 0.5rem); text-wrap: pretty; }
  /* The two-sentence intro balances rather than ragging on a short line. */
  .pi-section-dek { text-wrap: balance; }
  a { color: var(--harbour, #10527E); text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  a:hover { color: var(--harbour-h, #0C4166); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* Rows and the foot share one full-frame rule; only the text keeps a measure. */
  .base-comparison__row { display: grid; grid-template-columns: 1fr 2.3fr auto; gap: var(--space-5, 1.5rem); border-top: 1px solid var(--border); padding-block: var(--space-5, 1.5rem); }
  h3 { font: 600 var(--fs-600, 1.375rem)/1.25 var(--font-display); margin: 0; text-wrap: balance; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--harbour, #10527E); text-decoration: underline; }
  .base-comparison__row p:last-child { margin-bottom: 0; }
  .base-comparison__detail, .base-comparison__foot p { color: var(--soft); font-size: var(--fs-300, 0.9375rem); line-height: 1.6; text-wrap: pretty; }
  strong { color: var(--text); font-weight: 600; }
  /* The link stack ends on the frame's right edge, so both arrows line up,
     and the first link's text sits on the lead sentence's first baseline:
     its 44px box centres a 15px line about 7px lower than the 17px lead's
     baseline, so it rises by that much. The hit area stays 44px. */
  .base-comparison__actions { display: flex; flex-direction: column; align-items: flex-end; font-size: var(--fs-300, 0.9375rem); font-weight: 600; }
  .base-comparison__actions a { display: inline-flex; align-items: center; gap: 0.3em; min-height: 44px; white-space: nowrap; }
  .base-comparison__actions a:first-child { margin-block-start: -7px; }
  /* Links read as links, like the section link above: the label carries the
     underline and the arrow sits clean beside it. */
  .base-comparison__label, .base-comparison__foot a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .base-comparison__foot { border-top: 1px solid var(--border); padding-top: var(--space-5, 1.5rem); }
  .base-comparison__foot p { max-width: 75ch; margin: 0; }
  @media (max-width: 48em) {
    .base-comparison__row { grid-template-columns: 1fr; gap: var(--space-3, 0.75rem); }
    .base-comparison__actions { flex-direction: row; align-items: center; gap: var(--space-5, 1.5rem); }
    .base-comparison__actions a:first-child { margin-block-start: 0; }
  }
</style>
