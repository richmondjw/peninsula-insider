---
/**
 * HubStandfirst (v5 hub module) - the immersive v6 "Evergreen Coast" hub hero.
 *
 * The orientation layer of every hub: one uppercase eyebrow, one giant Sora
 * h1 and one Editor-voice stand-first of at most 80 words carrying the page's
 * load-bearing search phrases. Three modes: `compact` is the paper band
 * (its default slot carries the page's CategoryBrowse so the band contains
 * its controls); a Peninsula photograph gives the cover pattern (a band of at
 * least 360px under a bottom-up harbour-deep scrim); neither gives the
 * harbour-deep ground (no fake photo). Wayfinding still belongs to chrome's
 * V5Breadcrumbs, not here.
 *
 * Generic and prop-driven: Eat / Wine / Stay / Explore agents pass their own
 * copy. Content rules (content-guidelines 3.1/3.2) warn at build time and
 * never mutate copy.
 */
export interface Props {
  /** The page h1, matching the title tag's primary phrase. */
  title: string;
  /** Editor voice, 80 words maximum (build warns over). */
  standfirst: string;
  /** Optional id for skip links / anchors. */
  id?: string;
  /** Uppercase kicker above the headline (mint, on the dark ground). */
  eyebrow?: string;
  /** Optional full-bleed hero photograph. Omit for the forest-teal glow ground. */
  image?: { src: string; alt?: string };
  /** CSS object-position for the photograph, to keep its subject in frame. */
  imagePosition?: string;
  /**
   * Compact editorial entry for decision-led category pages (paper band).
   * A photograph always wins: with `image` the header renders the cover
   * pattern whatever this says, because a 180px sliver of photo is neither.
   */
  compact?: boolean;
  /**
   * Compact mode only: a credited photograph beside the heading, so the first
   * screen carries a sense of place without turning the band into a cover.
   */
  aside?: { src: string; alt: string; credit: string; caption?: string; position?: string };
}

const { title, standfirst, id, eyebrow, image, imagePosition = '50% 40%', compact = false, aside } = Astro.props;
const isPhoto = Boolean(image);
const isCompact = compact && !isPhoto;
const hasActions = Astro.slots.has('default');
const hasAside = isCompact && Boolean(aside);

const words = standfirst.trim().split(/\s+/).length;
if (words > 80) {
  console.warn(`[v5 HubStandfirst] stand-first over 80 words (${words}) for "${title}"`);
}
const EM_DASH = String.fromCharCode(0x2014);
if (`${title} ${standfirst}`.includes(EM_DASH)) {
  console.warn(`[v5 HubStandfirst] em-dash in copy for "${title}" (house rule: none, ever)`);
}
if (/!/.test(standfirst)) {
  console.warn(`[v5 HubStandfirst] exclamation mark in stand-first for "${title}"`);
}
---

<header
  class:list={['v5-standfirst', {
    'v5-standfirst--photo': isPhoto,
    'v5-standfirst--compact': isCompact,
    'v5-standfirst--has-actions': hasActions,
    'v5-standfirst--has-aside': hasAside,
  }]}
  id={id}
>
  {image && (
    <img class="v5-standfirst__bg" src={image.src} alt="" aria-hidden="true" loading="eager" fetchpriority="high" decoding="async" data-pi-responsive="100vw" style={`--pos:${imagePosition}`} />
  )}
  <div class="container v5-standfirst__inner">
    <div class="v5-standfirst__lead">
      {eyebrow && <p class="v5-standfirst__eyebrow">{eyebrow}</p>}
      <h1 class="v5-standfirst__title">{title}</h1>
      <p class="v5-standfirst__dek">{standfirst}</p>
    </div>
    {hasAside && (
      <figure class="v5-standfirst__aside">
        <img src={aside!.src} alt={aside!.alt} loading="eager" fetchpriority="high" decoding="async" data-pi-responsive="(max-width: 1023px) 100vw, 40vw" style={aside!.position ? `object-position:${aside!.position}` : undefined} />
        <figcaption>{aside!.caption ? `${aside!.caption} ` : ''}{aside!.credit}</figcaption>
      </figure>
    )}
    {hasActions && <div class="v5-standfirst__actions"><slot /></div>}
  </div>
</header>

<style>
  .v5-standfirst {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg-deep);
    color: var(--white);
    padding: clamp(2.6rem, 8vw, 5rem) 0;
  }
  /* Forest-teal glow ground when no photograph is supplied (no fake photo). */
  .v5-standfirst:not(.v5-standfirst--photo)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(120% 90% at 10% 6%, color-mix(in srgb, var(--teal) 32%, transparent), transparent 55%),
      radial-gradient(95% 85% at 94% 104%, color-mix(in srgb, var(--mint) 18%, transparent), transparent 60%);
  }
  .v5-standfirst__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The page's position arrives as a custom property (not an inline
       object-position), so a later rule, such as a phone crop, can still
       override it. */
    object-position: var(--pos, 50% 40%);
  }
  .v5-standfirst__inner {
    position: relative;
    z-index: 1;
  }

  /* ── Photo mode: the documented cover pattern. A band tall enough to show
     the subject, copy anchored to the foot, and a bottom-up harbour-deep
     scrim that holds at least .82 alpha behind every line of text. The
     scrim is drawn from the text block rather than the band, so it keeps
     that alpha however many lines the title wraps to at 390px. It holds
     .86 from a rem above the first title line (or the eyebrow) down to the
     foot, then feathers out, so the top of the photograph stays clean.
     No text-shadow: the scrim does the work.

     The inner is also a .container, and public/assets/mobile-fixes.css
     clips every .container on the x axis. That cut the -50vw scrim to the
     frame and left unscrimmed photo strips in the gutters. The scoped
     overflow:visible below lets it span the whole band; the header's own
     overflow:hidden still contains it. ── */
  .v5-standfirst--photo {
    display: grid;
    align-content: end;
    min-height: clamp(22.5rem, 40vw, 30rem);
    padding-block: clamp(3rem, 6vw, var(--space-8, 4rem));
    background: var(--harbour-deep, #0B2E4A);
  }
  .v5-standfirst--photo .v5-standfirst__inner {
    overflow: visible;
  }
  .v5-standfirst--photo .v5-standfirst__inner::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -8.5rem;
    bottom: calc(-1 * clamp(3rem, 6vw, var(--space-8, 4rem)));
    left: -50vw;
    right: -50vw;
    background: linear-gradient(to top,
      rgb(11 46 74 / .88) 0%,
      rgb(11 46 74 / .86) calc(100% - 7.5rem),
      rgb(11 46 74 / .35) calc(100% - 3rem),
      rgb(11 46 74 / 0) 100%);
    pointer-events: none;
  }
  /* Phones: the copy fills most of the band, so the band grows to keep
     the photograph's subject visible above the feather, and the feather is
     shorter. The .86 hold still starts a rem above the first title line. */
  @media (max-width: 47.99em) {
    .v5-standfirst--photo {
      min-height: 30rem;
    }
    .v5-standfirst--photo .v5-standfirst__inner::before {
      top: -6.5rem;
      background: linear-gradient(to top,
        rgb(11 46 74 / .88) 0%,
        rgb(11 46 74 / .86) calc(100% - 5.5rem),
        rgb(11 46 74 / .35) calc(100% - 2.25rem),
        rgb(11 46 74 / 0) 100%);
    }
  }
  .v5-standfirst.v5-standfirst--photo .v5-standfirst__title,
  .v5-standfirst.v5-standfirst--photo .v5-standfirst__dek,
  .v5-standfirst.v5-standfirst--photo .v5-standfirst__eyebrow {
    text-shadow: none;
  }
  .v5-standfirst.v5-standfirst--photo .v5-standfirst__eyebrow { color: var(--sand); }
  .v5-standfirst.v5-standfirst--photo .v5-standfirst__title { color: var(--white); }
  .v5-standfirst.v5-standfirst--photo .v5-standfirst__dek { color: rgb(255 255 255 / .9); }
  .v5-standfirst__eyebrow {
    margin: 0 0 var(--space-3, 0.75rem);
    font-family: var(--font-ui);
    font-size: var(--fs-100);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--mint);
  }
  .v5-standfirst__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-900);
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-display, 1.02);
    letter-spacing: var(--ls-display, -0.02em);
    color: var(--white);
    max-width: 18ch;
    text-wrap: balance;
  }
  .v5-standfirst__dek {
    margin: var(--space-4, 1rem) 0 0;
    font-family: var(--font-ui);
    font-size: var(--fs-500);
    line-height: var(--lh-dek, 1.45);
    color: var(--soft-inverse);
    max-width: var(--measure-dek, 52ch);
    text-wrap: pretty;
  }
  /* The actions slot holds whatever belongs to the header's decision: on the
     compact band that is the page's CategoryBrowse (jump links, the one
     FilterBar and the planning help), so the paper band visibly contains its
     own controls instead of closing at the dek. */
  .v5-standfirst__actions {
    margin-top: var(--space-5, 1.5rem);
  }
  .v5-standfirst--compact {
    padding-block: clamp(1.5rem, 3vw, 2.75rem);
    background: var(--paper, #faf8f3);
    color: var(--text);
  }
  /* The band closes with the same air it opens with, so the chip row does
     not sit pressed against the band's lower edge. */
  .v5-standfirst--compact.v5-standfirst--has-actions {
    padding-bottom: clamp(2rem, 3vw, 2.75rem);
  }
  .v5-standfirst--compact::before { display: none; }
  /* Sora 600, the site's one display voice (James, 2 October 2026). The
     bold Georgia read as a fallback font above Sora section heads. */
  .v5-standfirst--compact .v5-standfirst__title {
    font-family: var(--font-display);
    font-weight: var(--fw-display, 600);
    letter-spacing: var(--ls-display, -0.02em);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1.06;
    max-width: 22ch;
    color: var(--text);
    text-wrap: balance;
  }
  /* The page's main introduction: one step larger than any section lede
     below it, balanced at a 56ch measure so it never ends on a stray word. */
  .v5-standfirst--compact .v5-standfirst__dek {
    font-size: var(--fs-500, 1.125rem);
    line-height: 1.55;
    max-width: 56ch;
    color: var(--soft);
    margin-top: 0.75rem;
    text-wrap: pretty;
  }
  .v5-standfirst--compact .v5-standfirst__eyebrow { color: var(--sand-text, #8A5620); }

  /* Compact band with a photograph beside the heading. The lead and the photo
     share the first row; the band's controls run the full width beneath. On
     phones the photo follows the lede at a short 16:9 so the filters stay
     close to the first screen. The credit sits under the photo, as the
     licence asks. */
  .v5-standfirst__aside {
    margin: var(--space-5, 1.5rem) 0 0;
  }
  /* Explicit heights, not aspect-ratio: the responsive-image pass writes
     width and height attributes that won the ratio and rendered a tall
     portrait crop. Phones: the photograph opens the band as a short strip
     and the lede drops to body size, so the heading and the filter chips
     reach the first screen. */
  .v5-standfirst--has-aside .v5-standfirst__inner {
    display: flex;
    flex-direction: column;
  }
  .v5-standfirst--has-aside .v5-standfirst__aside {
    order: -1;
    margin: 0 0 var(--space-5, 1.5rem);
  }
  .v5-standfirst__aside img {
    display: block;
    width: 100%;
    height: 11rem;
    object-fit: cover;
    border-radius: var(--radius-m, 16px);
  }
  @media (max-width: 63.99em) {
    .v5-standfirst--has-aside .v5-standfirst__dek {
      font-size: var(--fs-400, 1.0625rem);
    }
  }
  .v5-standfirst__aside figcaption {
    margin-top: var(--space-2, 0.5rem);
    font-family: var(--font-ui);
    font-size: var(--fs-200, 0.8125rem);
    line-height: 1.5;
    color: var(--soft);
  }
  /* Desktop: the lead and its controls form one column beside the photo,
     which spans both rows, so the band closes on one line and the links
     sit directly under the lede rather than below the photograph. */
  @media (min-width: 64em) {
    .v5-standfirst--has-aside .v5-standfirst__inner {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      grid-template-rows: auto auto;
      column-gap: var(--space-8, 4rem);
      align-items: start;
    }
    .v5-standfirst--has-aside .v5-standfirst__lead {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
    }
    .v5-standfirst--has-aside .v5-standfirst__actions {
      grid-column: 1;
      grid-row: 2;
    }
    .v5-standfirst--has-aside .v5-standfirst__aside {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin: 0;
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }
    .v5-standfirst__aside img {
      flex: 1 1 auto;
      height: auto;
      min-height: 18rem;
      max-height: 26rem;
    }
  }
</style>
