---
/**
 * HubStandfirst (v5 hub module) - breadcrumbless h1 + Editor stand-first.
 *
 * The orientation layer of every v5 hub (page-redesigns section 2 block 9.1
 * and its Stay / Wine / Explore siblings): one h1 and one Editor-voice
 * stand-first of at most 80 words that carries the page's load-bearing
 * search phrases. No hero image, no read-time chip, no breadcrumb here
 * (chrome's V5Breadcrumbs owns wayfinding).
 *
 * Generic and prop-driven: Eat / Wine / Stay / Explore agents pass their own
 * copy. Content rules (content-guidelines 3.1/3.2) warn at build time and
 * never mutate copy.
 */
export interface Props {
  /** The page h1, matching the title tag's primary phrase. */
  title: string;
  /** Editor voice, 80 words maximum (build warns over). */
  standfirst: string;
  /** Optional id for skip links / anchors. */
  id?: string;
}

const { title, standfirst, id } = Astro.props;

const words = standfirst.trim().split(/\s+/).length;
if (words > 80) {
  console.warn(`[v5 HubStandfirst] stand-first over 80 words (${words}) for "${title}"`);
}
const EM_DASH = String.fromCharCode(0x2014);
if (`${title} ${standfirst}`.includes(EM_DASH)) {
  console.warn(`[v5 HubStandfirst] em-dash in copy for "${title}" (house rule: none, ever)`);
}
if (/!/.test(standfirst)) {
  console.warn(`[v5 HubStandfirst] exclamation mark in stand-first for "${title}"`);
}
---

<header class="v5-standfirst" id={id}>
  <div class="container">
    <h1 class="v5-standfirst__title">{title}</h1>
    <p class="v5-standfirst__dek">{standfirst}</p>
    <slot />
  </div>
</header>

<style>
  .v5-standfirst {
    padding: var(--space-6, 2rem) 0 var(--space-4, 1rem);
  }
  .v5-standfirst__title {
    margin: 0;
    font-family: var(--font-display, var(--font-display));
    font-size: var(--fs-900, clamp(2.1rem, 1.6rem + 2.4vw, 3.25rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-display, 1.08);
    color: var(--text);
    max-width: var(--measure-heading, 26ch);
  }
  .v5-standfirst__dek {
    margin: var(--space-3, 0.75rem) 0 0;
    font-family: var(--font-display, var(--font-display));
    font-size: var(--fs-500, 1.1875rem);
    line-height: var(--lh-dek, 1.45);
    color: var(--text);
    max-width: var(--measure-body, 64ch);
  }
</style>
