---
/**
 * JournalModule (v5 hub module) - "From the Journal": at most three
 * contextual guides below the catalogue layer (page-redesigns section 2
 * block 9.6; wireframes #eat note 5). Editorial cards only: Card(guide)
 * with Sora display titles, byline provenance, zero venue cosmetics (HUB-08).
 *
 * Generic and prop-driven for the Eat / Wine / Stay / Explore hub agents.
 * Pass a page-written verdict of 25 words or fewer per item; article deks
 * usually run long, so do not pipe frontmatter deks straight through.
 */
import Card from '../Card.astro';
import CardGrid from '../CardGrid.astro';
import type { CardImage } from '../Card.astro';

export interface JournalItem {
  title: string;
  href: string;
  entitySlug: string;
  image?: CardImage;
  /** 25 words maximum (Card warns over). */
  verdict?: string;
  byline?: string;
  /** e.g. "7 min read". */
  readTime?: string;
  /** Publish date, ISO. */
  dateISO?: string;
}

export interface Props {
  /** h2; defaults to the cross-hub convention. */
  heading?: string;
  /** Uppercase eyebrow above the heading (teal). */
  eyebrow?: string;
  sub?: string;
  /** At most 3 (build warns and slices). */
  items: JournalItem[];
  moreHref?: string;
  moreLabel?: string;
  surface?: string;
  id?: string;
  /**
   * Type eyebrow on each card. Off by default: the module eyebrow reads
   * "The Journal" and the heading "From the Journal", so a GUIDE stamp on
   * every card below repeats what the section has already said.
   */
  showEyebrow?: boolean;
}

const {
  heading = 'From the Journal',
  eyebrow = 'The Journal',
  sub,
  items,
  moreHref,
  moreLabel = 'All in the Journal',
  surface,
  id,
  showEyebrow = false,
} = Astro.props;

if (items.length > 3) {
  console.warn(`[v5 JournalModule] more than 3 items (${items.length}); rendering the first 3`);
}
/* One photograph per row: a piece whose hero repeats an earlier card's in
   this module loses the image and takes the house plate instead. */
const seenSrc = new Map<string, string>();
const shown = items.slice(0, 3).map((item) => {
  const src = item.image?.src;
  if (!src) return item;
  const firstSlug = seenSrc.get(src);
  if (firstSlug) {
    console.warn(
      `[v5 JournalModule] "${item.entitySlug}" repeats the image of "${firstSlug}" (${src}); rendering the house plate instead`,
    );
    return { ...item, image: undefined };
  }
  seenSrc.set(src, item.entitySlug);
  return item;
});
const headingId = `${id ?? `journal-${surface ?? 'hub'}`}-heading`;

/* Image-bearing row: a piece without a hero takes the Card house plate so
   the three cards keep a level media line. All-text sets stay all-text. */
const anyImage = shown.some((item) => Boolean(item.image?.src));
---

{shown.length > 0 && (
  <section class="v5-journal pi-section" id={id} aria-labelledby={headingId}>
    <div class="container">
      <div class="pi-section-head">
        <div class="pi-section-head__text">
          {eyebrow && <p class="pi-eyebrow">{eyebrow}</p>}
          <h2 class="pi-h2" id={headingId}>{heading}</h2>
          {sub && <p class="pi-section-dek">{sub}</p>}
        </div>
        {moreHref && (
          <a href={moreHref} class="pi-section-link">{moreLabel} <span aria-hidden="true">&rarr;</span></a>
        )}
      </div>
      <CardGrid label={heading}>
        {shown.map((item, i) => (
          <Card
            variant="guide"
            title={item.title}
            href={item.href}
            entityType="article"
            entitySlug={item.entitySlug}
            image={item.image}
            mediaFallback={anyImage}
            showEyebrow={showEyebrow}
            verdict={item.verdict}
            byline={item.byline}
            readTime={item.readTime}
            dateISO={item.dateISO}
            surface={surface}
            position={i + 1}
          />
        ))}
      </CardGrid>
    </div>
  </section>
)}

<style>
  /* Head, link and vertical rhythm come from the shared .pi-section /
     .pi-section-head canon (global.css, G1). The band is the paper-warm
     ground; the cards on it are white with a hairline (Card editorial). */
  .v5-journal {
    background: var(--bg-alt);
  }
</style>
