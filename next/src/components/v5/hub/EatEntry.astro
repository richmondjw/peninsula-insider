---
import type { PageImage } from '../../../lib/page-images';
import { captionParts } from '../../../lib/image-caption.mjs';
interface Props { count: number; categories: {value:string;label:string;count:number}[]; towns:{value:string;label:string}[]; image:PageImage; }
const {count,categories,towns,image}=Astro.props;
/* House caption rule (lib/image-caption.mjs): a place line and its source, nothing for artwork.
   Credit wording matches Card: "Courtesy of X" reads "Photo courtesy of X". */
const caption=captionParts(image);
const credit=(caption?.credit??'').replace(/\.$/,'');
const creditLine=!credit?'':/^Courtesy of /i.test(credit)?`Photo courtesy of ${credit.slice(12)}.`:/^(Photo|Illustration)(?::|\s)/i.test(credit)?`${credit}.`:`Photo: ${credit}.`;
---
<header class="eat-entry container">
  <div class="eat-entry__copy">
    <p class="label eat-entry__eyebrow">Eat &amp; drink on the Mornington Peninsula</p>
    <h1>A long lunch, a village coffee, a table by the bay</h1>
    <p class="eat-entry__dek">{count} places to eat and drink across the Peninsula, from ridge-top farm kitchens to bayside pubs. Find the one that fits your day.</p>
    <nav class="eat-entry__links" aria-label="Browse this guide">
      <a class="eat-entry__primary" href="#directory">Browse all {count} places <span aria-hidden="true">↓</span></a>
      <a href="#the-six">Start with six choices <span aria-hidden="true">↓</span></a>
      <a href="/map/">View the map <span aria-hidden="true">→</span></a>
    </nav>
    <p class="eat-entry__trust">Chosen by our editors, never paid for. <a href="/about/">How we choose</a></p>
  </div>
  <figure class="eat-entry__photo">
    <img src={image.src} alt={image.alt} width="1200" height="800" fetchpriority="high" decoding="async" data-pi-responsive="(max-width: 700px) 100vw, 640px" />
    {caption && <figcaption>{caption.place && <>{caption.place}. </>}{creditLine}</figcaption>}
  </figure>
</header>
<section class="eat-finder container" aria-labelledby="eat-finder-title" data-eat-finder>
  <div class="eat-finder__heading"><h2 id="eat-finder-title">Find your kind of place</h2><p>{count} places. Your choice of town, table or coffee stop.</p></div>
  <form class="eat-finder__form" action="/eat/" method="get">
    <div><label for="eat-find">Search places</label><input id="eat-find" name="find" type="search" placeholder="Name, town or type" data-directory-search autocomplete="off" /></div>
    <div><label for="eat-category">I’m looking for</label><select id="eat-category" name="cat" data-eat-select="cat"><option value="">Everything</option>{categories.map(c=><option value={c.value}>{c.label} ({c.count})</option>)}</select></div>
    <div><label for="eat-town">Around</label><select id="eat-town" name="place" data-eat-select="place"><option value="">All towns</option>{towns.map(t=><option value={t.value}>{t.label}</option>)}</select></div>
    <button type="submit">Find places <span aria-hidden="true">↓</span></button>
  </form>
  <noscript><style>.eat-finder__form{display:none!important}</style><p><a href="#directory">Browse all {count} places</a>. Search and filters need JavaScript; the complete directory is available below.</p></noscript>
</section>
<style>
  .eat-entry{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(2rem,5vw,5rem);align-items:center;padding-block:2rem 1.5rem}
  .eat-entry h1{font-weight:600;line-height:1.1;font-family:var(--font-display);letter-spacing:var(--ls-display);max-width:22ch;margin:.75rem 0 1rem;text-wrap:balance}
  .eat-entry__dek{font-size:var(--fs-400);line-height:1.6;max-width:49ch;color:var(--soft)}
  .eat-entry__links{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1.5rem;margin-top:1.5rem}
  .eat-entry__eyebrow{color:var(--teal-text)}
  .eat-entry__links a{min-height:48px;display:inline-flex;align-items:center;gap:.4rem;color:var(--accent);font-weight:500;font-size:var(--fs-300);text-underline-offset:.2em}
  .eat-entry__links .eat-entry__primary{padding:0 1.35rem;border-radius:var(--radius-s);background:var(--accent);color:var(--white);font-weight:600;font-size:var(--fs-400);text-decoration:none;margin-inline-end:.25rem}
  .eat-entry__links .eat-entry__primary:hover{background:var(--text)}
  .eat-entry__trust{margin:1.25rem 0 0;font:400 var(--fs-300)/1.5 var(--font-ui);color:var(--soft)}
  .eat-entry__trust a{color:var(--accent);font-weight:600;text-underline-offset:.2em;white-space:nowrap}
  .eat-entry__photo{margin:0}.eat-entry__photo img{display:block;width:100%;aspect-ratio:4/3;height:auto;object-fit:cover;border-radius:var(--radius-m)}
  figcaption{font:400 var(--fs-200)/1.5 var(--font-ui);color:var(--soft);padding-top:.5rem}
  .eat-finder{padding-block:1.25rem}
  .eat-finder__heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1rem}
  .eat-finder h2{font:600 var(--fs-600)/1.2 var(--font-display);margin:0}.eat-finder__heading p{font-size:var(--fs-300);color:var(--soft);margin:0}
  .eat-finder__form{display:grid;grid-template-columns:1.2fr 1fr 1fr auto;gap:1rem;align-items:end}
  label{display:block;font-size:var(--fs-200);font-weight:600;margin-bottom:.4rem}
  input,select{width:100%;min-height:48px;background:var(--white);border:1px solid var(--border-control);border-radius:var(--radius-s);padding:.65rem .8rem;color:var(--text);font:400 var(--fs-400) var(--font-ui)}
  button{min-height:48px;border:0;border-radius:var(--radius-s);padding:.65rem 1.2rem;background:var(--accent);color:white;font:600 var(--fs-400) var(--font-ui);cursor:pointer}
  :is(a,button,input,select):focus-visible{outline:3px solid var(--accent);outline-offset:3px}
  @media(max-width:700px){.eat-entry{grid-template-columns:1fr;gap:1rem;padding-block:1.25rem .75rem}.eat-entry h1{max-width:22ch;margin-top:.5rem}.eat-entry__photo{order:-1}.eat-entry__photo img{aspect-ratio:2/1;border-radius:var(--radius-m)}.eat-entry__photo figcaption{font-size:var(--fs-100);padding-top:.35rem}.eat-entry__dek{margin-bottom:0}.eat-entry__links{gap:0 1.25rem;margin-top:1rem}.eat-entry__links .eat-entry__primary{flex:1 0 100%;justify-content:center;margin-bottom:.25rem}.eat-entry__trust{margin-top:.75rem}.eat-finder__heading{display:block}.eat-finder__heading p{display:none}.eat-finder__form{grid-template-columns:1fr 1fr;gap:.75rem}.eat-finder__form>div:first-child{grid-column:1/-1}.eat-finder__form>button{grid-column:1/-1}}
</style>
<script>
  import {commit,getState,type FilterKey} from '../../../lib/v5-filter-state';
  function paint(){
    const params=new URLSearchParams(location.search);
    document.querySelectorAll<HTMLSelectElement>('[data-eat-select]').forEach(select=>{select.value=params.get(select.dataset.eatSelect!)?.split(',')[0]||'';});
    const input=document.querySelector<HTMLInputElement>('[data-directory-search]');
    if(input && document.activeElement!==input) input.value=params.get('find')||'';
  }
  function init(){
    const finder=document.querySelector<HTMLElement>('[data-eat-finder]');
    if(!finder || finder.dataset.initialized) return;
    finder.dataset.initialized='true';paint();
    const input=finder.querySelector<HTMLInputElement>('[data-directory-search]')!;
    function updateSearch(){
      const url=new URL(location.href);const query=input.value.trim();
      if(query)url.searchParams.set('find',query);else url.searchParams.delete('find');
      history.replaceState(history.state,'',url.pathname+url.search+url.hash);
      commit(getState(),{source:'search',noun:'places'});
    }
    input.addEventListener('input',updateSearch);
    finder.querySelectorAll<HTMLSelectElement>('[data-eat-select]').forEach(select=>select.addEventListener('change',()=>{
      const key=select.dataset.eatSelect as FilterKey;const state={...getState()};
      if(select.value)state[key]=[select.value];else delete state[key];
      commit(state,{source:'select',noun:'places'});
    }));
    finder.querySelector('form')!.addEventListener('submit',event=>{
      event.preventDefault();updateSearch();document.querySelector('#directory')?.scrollIntoView({behavior:'instant',block:'start'});
      history.replaceState(history.state,'',location.pathname+location.search+'#directory');
      document.querySelector<HTMLElement>('#directory-heading')?.focus({preventScroll:true});
    });
  }
  document.addEventListener('pi:filters-changed',paint);
  document.addEventListener('astro:page-load',init);
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
</script>
