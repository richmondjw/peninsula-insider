---
/**
 * DirectoryRows (v5 hub module) - the catalogue layer: the full corpus as
 * compact rows, server-rendered once for SEO (page-redesigns section 2
 * block 9.5; wireframes #eat note 4). Rows, not cards: 2 interactive
 * elements per row (row link + save; stays add Book via `booking`).
 *
 * Filter contract (lib/v5-filter-state.ts): every row `li` carries
 * `data-facets`, `data-title` and, unless `countable={false}`,
 * `data-filter-countable` (this is the catalogue layer, so a row here is the
 * page's one node standing for that result); the list is a
 * `data-sort-container` so SortControl can reorder it; a `[data-filter-empty]` EmptyState toggles at
 * zero results and its Clear action commits an empty filter state. The page
 * FilterBar owns counts and the live region.
 *
 * Generic and prop-driven for the Eat / Wine / Stay / Explore hub agents.
 * Slots: `before-list` (e.g. a cross-link module such as Eat's "Winery
 * kitchens") and `after-list`.
 *
 * Rows: every row carries the same action pair (Save + Add to trip), a
 * thumb slot (a paper PI tile when the venue has no photo and its siblings
 * do) and, on lists where any row can book, a reserved booking slot so the
 * actions never shift. The li draws the one divider between rows.
 *
 * Long lists (more than 20 rows) open on the first `initialCount` (12) with
 * a "Show N more {noun}" button, N being the rows still hidden (the heading
 * already states the full count). The remaining rows stay server-rendered in
 * the DOM for crawlers and are only hidden by CSS; any active filter reveals
 * every row, so filtering always searches the full set.
 */
import Card from '../Card.astro';
import EmptyState from '../EmptyState.astro';
import type { CardImage, CardBooking } from '../Card.astro';
import type { CmsEntityType } from '../../../lib/inline-edit/attrs';
import type { FacetKey } from '../../../lib/facets';

export interface DirectoryRowItem {
  title: string;
  href: string;
  entityType: CmsEntityType;
  entitySlug: string;
  /** Omit for a text-only compact row. */
  image?: CardImage;
  /** One-sentence verdict line, 25 words maximum (Card warns over). */
  verdict?: string;
  /** Up to 3 plain-text chips (town, category, caveat). */
  meta?: string[];
  priceBand?: string | number;
  freshness?: string;
  freshnessKind?: 'reviewed' | 'checked';
  /** Unified facet payload from getFacets(kind, data). */
  facets?: Partial<Record<FacetKey, string[]>>;
  /** Stay surfaces: Book is the one primary row action. */
  booking?: CardBooking;
  partnerLabel?: string;
  /** A-to-Z sort key override (defaults to title). */
  sortTitle?: string;
}

export interface Props {
  /** h2, e.g. "All 87 places to eat". */
  heading: string;
  /** Uppercase eyebrow above the heading (teal). */
  eyebrow?: string;
  sub?: string;
  /** Plural noun used in empty-state copy, e.g. "places". */
  noun?: string;
  /** Analytics surface (eat, wine, stay, explore). */
  surface: string;
  items: DirectoryRowItem[];
  /** Optional header link, e.g. { label: "Ranked top 15", href: ... }. */
  topLink?: { label: string; href: string };
  id?: string;
  emptyHeading?: string;
  emptyBody?: string;
  /**
   * Do these rows stand for distinct results the page's counts describe?
   *
   * True for the catalogue layer, which is the default use. Pass false for a
   * secondary module built from rows the catalogue already lists (Wine's
   * "Winery kitchens" bridge): those rows must still filter, but counting
   * them again would report more results than the page holds.
   */
  countable?: boolean;
  /** Rows shown before "Show all" on lists longer than 20. Default 12. */
  initialCount?: number;
}

const COLLAPSE_THRESHOLD = 20;

const {
  heading,
  eyebrow,
  sub,
  noun = 'places',
  surface,
  items,
  topLink,
  id,
  emptyHeading,
  emptyBody,
  countable = true,
  initialCount = 12,
} = Astro.props;

const baseId = id ?? `directory-${surface}`;
const headingId = `${baseId}-heading`;
const listId = `${baseId}-list`;

/* Photographic list: a row without a photo takes the paper PI tile so its
   title stays on the list's text line. An all-text list stays all-text. */
const anyImage = items.some((item) => Boolean(item.image?.src));
/* Any row that can book: every row holds the booking slot. */
const anyBooking = items.some((item) => Boolean(item.booking));
const collapsible = items.length > COLLAPSE_THRESHOLD && initialCount < items.length;
---

<section class="v5-directory pi-section" id={id} aria-labelledby={headingId} data-directory-rows data-noun={noun}>
  <div class="container">
    <div class="pi-section-head">
      <div class="pi-section-head__text">
        {eyebrow && <p class="pi-eyebrow">{eyebrow}</p>}
        <h2 class="pi-h2" id={headingId}>{heading}</h2>
        {sub && <p class="pi-section-dek">{sub}</p>}
      </div>
      {topLink && (
        <a href={topLink.href} class="pi-section-link">{topLink.label} <span aria-hidden="true">&rarr;</span></a>
      )}
    </div>

    <slot name="before-list" />

    <ul
      class="v5-directory__list"
      id={listId}
      aria-label={heading}
      data-sort-container
      data-directory-list
      data-directory-collapsed={collapsible ? '' : undefined}
      data-initial-count={collapsible ? initialCount : undefined}
    >
      {items.map((item, i) => (
        <li
          class="v5-directory__row"
          data-facets={item.facets ? JSON.stringify(item.facets) : undefined}
          data-filter-countable={countable && item.facets ? 'true' : undefined}
          data-title={item.sortTitle ?? item.title}
          data-directory-overflow={collapsible && i >= initialCount ? '' : undefined}
        >
          <Card
            as="div"
            variant="compact-row"
            title={item.title}
            href={item.href}
            entityType={item.entityType}
            entitySlug={item.entitySlug}
            image={item.image}
            mediaFallback={anyImage}
            verdict={item.verdict}
            meta={item.meta}
            priceBand={item.priceBand}
            freshness={item.freshness}
            freshnessKind={item.freshnessKind}
            booking={item.booking}
            reserveBooking={anyBooking}
            trip={true}
            partnerLabel={item.partnerLabel}
            surface={surface}
            position={i + 1}
          />
        </li>
      ))}
    </ul>

    {collapsible && (
      <div class="v5-directory__more" data-directory-more>
        <button
          type="button"
          class="v5-directory__show-all"
          aria-controls={listId}
          aria-expanded="false"
          data-directory-show-all
        >
          Show {items.length - initialCount} more {noun}
        </button>
      </div>
    )}
    {collapsible && (
      <noscript>
        <style is:inline>
          [data-directory-collapsed] > [data-directory-overflow] { display: list-item !important; }
          [data-directory-more] { display: none !important; }
        </style>
      </noscript>
    )}

    <div data-filter-empty hidden>
      <EmptyState
        variant="filter-zero"
        heading={emptyHeading}
        body={emptyBody}
        surface={surface}
      />
    </div>

    <slot name="after-list" />
  </div>
</section>

<style>
  /* Section head, link and vertical rhythm come from the shared
     .pi-section / .pi-section-head canon (global.css, G1). */
  .v5-directory__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  /* The one divider between rows, with 24px either side (refinement.css
     states the same padding). The compact card draws no rule of its own.
     Hover is the title's colour change, not a tint band. */
  .v5-directory__row {
    padding-block: var(--space-5, 1.5rem);
    border-bottom: 1px solid var(--border);
  }
  .v5-directory__row:last-child {
    border-bottom: none;
  }
  /* Phones: a 16px inset each side of the rule. The body[data-v4] prefix
     outranks refinement.css (body[data-v4] .v5-directory__row), which
     would otherwise hold the 24px. */
  @media (max-width: 47.99em) {
    :global(body[data-v4]) .v5-directory__row {
      padding-block: var(--space-4, 1rem);
    }
  }

  /* Show the first rows only; the rest stay in the DOM. */
  .v5-directory__list[data-directory-collapsed] > [data-directory-overflow] {
    display: none;
  }
  .v5-directory__more {
    margin-top: var(--space-5, 1.5rem);
  }
  .v5-directory__more[hidden] {
    display: none;
  }
  .v5-directory__show-all {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-5, 1.5rem);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s, 8px);
    font-family: var(--font-ui);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-ui, 1.4);
    color: var(--harbour);
    cursor: pointer;
    transition:
      border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .v5-directory__show-all:hover {
    border-color: var(--harbour);
    color: var(--harbour-h);
  }
  .v5-directory__show-all:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
</style>

<script>
  // EmptyState's "Clear filters" button carries data-action="clear-filters";
  // wire it to the shared filter state so one tap restores a working list.
  import { commit, isEmptyState, parseFilters } from '../../../lib/v5-filter-state';

  /* Collapsed lists show the first N rows in their CURRENT order, so a sort
     that reorders the list re-marks which rows overflow. One observer per
     live list; the set is disconnected before every re-init, so a
     client-router swap never leaves one watching a discarded node. */
  const observers: MutationObserver[] = [];

  function markOverflow(list: HTMLElement) {
    const limit = Number(list.dataset.initialCount || 0);
    Array.from(list.children).forEach((row, i) => {
      row.toggleAttribute('data-directory-overflow', i >= limit);
    });
  }

  function expand(section: HTMLElement, moveFocus = false) {
    const list = section.querySelector<HTMLElement>('[data-directory-list]');
    if (!list || !list.hasAttribute('data-directory-collapsed')) return;
    list.removeAttribute('data-directory-collapsed');
    const more = section.querySelector<HTMLElement>('[data-directory-more]');
    if (more) more.hidden = true;
    section.querySelector('[data-directory-show-all]')?.setAttribute('aria-expanded', 'true');
    if (moveFocus) {
      // The button is gone; land keyboard users on the first revealed row.
      const limit = Number(list.dataset.initialCount || 0);
      const first = list.children[limit]?.querySelector<HTMLElement>('a[href]');
      first?.focus();
    }
  }

  function init() {
    observers.splice(0).forEach((observer) => observer.disconnect());
    const filtering = !isEmptyState(parseFilters(window.location.search));
    document.querySelectorAll<HTMLElement>('[data-directory-rows]').forEach((section) => {
      const list = section.querySelector<HTMLElement>('[data-directory-list][data-directory-collapsed]');
      if (list) {
        if (filtering) {
          expand(section);
        } else {
          markOverflow(list);
          const observer = new MutationObserver(() => markOverflow(list));
          observer.observe(list, { childList: true });
          observers.push(observer);
        }
      }
      if ((section as any)._piDirInit) return;
      (section as any)._piDirInit = true;
      const noun = section.dataset.noun || 'results';
      section.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target && target.closest('[data-action="clear-filters"]')) {
          commit({}, { source: 'clear', noun });
        }
        if (target && target.closest('[data-directory-show-all]')) {
          expand(section, true);
        }
      });
    });
  }

  /* Any active filter searches the whole list: reveal every row. Registered
     once at module scope (listener hygiene), never inside page-load. */
  function onFiltersChanged(event: Event) {
    const detail = (event as CustomEvent<{ filters?: Parameters<typeof isEmptyState>[0] }>).detail;
    if (!detail || !detail.filters || isEmptyState(detail.filters)) return;
    document.querySelectorAll<HTMLElement>('[data-directory-rows]').forEach((section) => expand(section));
  }
  document.addEventListener('pi:filters-changed', onFiltersChanged);

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
