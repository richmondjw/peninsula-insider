---
/**
 * DirectoryRows (v5 hub module) - the catalogue layer: the full corpus as
 * compact rows, server-rendered once for SEO (page-redesigns section 2
 * block 9.5; wireframes #eat note 4). Rows, not cards: content height, one
 * hairline, the title is the link (stretched over the row), Save inline at
 * the right of the title line.
 *
 * Filter contract (lib/v5-filter-state.ts): every row `li` carries
 * `data-facets`, `data-title` and, unless `countable={false}`,
 * `data-filter-countable` (this is the catalogue layer, so a row here is the
 * page's one node standing for that result); the list is a
 * `data-sort-container` so SortControl can reorder it; a `[data-filter-empty]` EmptyState toggles at
 * zero results and its Clear action commits an empty filter state. The page
 * FilterBar owns counts and the live region.
 *
 * Say it once: rows marked `featured` are the shortlist shown above the list.
 * While no filter or search is active they are hidden here (the shortlist is
 * on screen); the moment one is, the shortlist yields (CategoryBrowse) and
 * these rows return, so every match is still listed. They stay countable, so
 * the "All N" heading and the filter counts describe the whole catalogue.
 * Without JavaScript every row shows.
 *
 * Generic and prop-driven for the Eat / Wine / Stay / Explore hub agents.
 * Slots: `before-list` (the page's search / FilterBar) and `after-list`.
 */
import Card from '../Card.astro';
import EmptyState from '../EmptyState.astro';
import type { CardImage, CardBooking } from '../Card.astro';
import type { CmsEntityType } from '../../../lib/inline-edit/attrs';
import type { FacetKey } from '../../../lib/facets';

export interface DirectoryRowItem {
  title: string;
  href: string;
  entityType: CmsEntityType;
  entitySlug: string;
  /** Omit for a text-only compact row. */
  image?: CardImage;
  /** One-sentence verdict line, 25 words maximum (Card warns over). */
  verdict?: string;
  /** Up to 3 plain-text chips (town, category, caveat). */
  meta?: string[];
  priceBand?: string | number;
  freshness?: string;
  freshnessKind?: 'reviewed' | 'checked';
  /** Unified facet payload from getFacets(kind, data). */
  facets?: Partial<Record<FacetKey, string[]>>;
  /** Stay surfaces: Book is the one primary row action. */
  booking?: CardBooking;
  partnerLabel?: string;
  /** A-to-Z sort key override (defaults to title). */
  sortTitle?: string;
  /** Shown in the page's shortlist above; hidden here until a filter is active. */
  featured?: boolean;
}

export interface Props {
  /** h2, e.g. "All 87 places to eat". */
  heading: string;
  eyebrow?: string;
  sub?: string;
  /** Plural noun used in empty-state copy, e.g. "places". */
  noun?: string;
  /** Analytics surface (eat, wine, stay, explore). */
  surface: string;
  items: DirectoryRowItem[];
  /** Optional header link, e.g. { label: "Ranked top 15", href: ... }. */
  topLink?: { label: string; href: string };
  id?: string;
  emptyHeading?: string;
  emptyBody?: string;
  /**
   * Do these rows stand for distinct results the page's counts describe?
   * True for the catalogue layer (the default). Pass false for a secondary
   * module built from rows the catalogue already lists.
   */
  countable?: boolean;
  missingImagePlate?: boolean;
  /** Keep documented listing photography fixed when the public CMS hydrates image slots. */
  suppressImageHydration?: boolean;
  lockImageEditing?: boolean;
  desktopColumns?: 1 | 2;
  fullVerdicts?: boolean;
  detailActionFallback?: boolean;
  /** Progressive browsing only after JavaScript initialises; all results stay in HTML. */
  initialLimit?: number;
}

const {
  heading,
  eyebrow,
  sub,
  noun = 'places',
  surface,
  items,
  topLink,
  id,
  emptyHeading,
  emptyBody,
  countable = true,
  missingImagePlate = false,
  suppressImageHydration = false,
  lockImageEditing = false,
  desktopColumns = 1,
  fullVerdicts = false,
  detailActionFallback = false,
  initialLimit,
} = Astro.props;

const headingId = `${id ?? `directory-${surface}`}-heading`;
const featuredCount = items.filter((item) => item.featured).length;
const words = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const featuredWord = words[featuredCount] ?? String(featuredCount);
const featuredNote = featuredCount > 0
  ? `${featuredWord[0]?.toUpperCase()}${featuredWord.slice(1)} are featured above; the other ${items.length - featuredCount} follow.`
  : '';
---

<section class:list={["v5-directory", { "v5-directory--columns-2": desktopColumns === 2, "v5-directory--full-verdicts": fullVerdicts }]} id={id} aria-labelledby={headingId} data-directory-rows data-noun={noun} data-directory-limit={initialLimit} data-directory-featured={featuredCount > 0 ? 'true' : undefined}>
  <div class="container">
    <div class="v5-directory__header">
      <div>
        {eyebrow && <p class="v5-directory__eyebrow">{eyebrow}</p>}
        <h2 class="v5-directory__heading" id={headingId} tabindex="-1">{heading}</h2>
        {(sub || featuredNote) && <p class="v5-directory__sub">{featuredNote && <span data-featured-note hidden>{featuredNote} </span>}{sub}</p>}
      </div>
      {topLink && (
        <a href={topLink.href} class="v5-directory__toplink">{topLink.label} <span aria-hidden="true">&rarr;</span></a>
      )}
    </div>

    <slot name="before-list" />

    <ul class="v5-directory__list" aria-label={heading} data-sort-container>
      {items.map((item, i) => (
        <li
          class="v5-directory__row"
          data-facets={item.facets ? JSON.stringify(item.facets) : undefined}
          data-filter-countable={countable && item.facets ? 'true' : undefined}
          data-featured-row={item.featured ? 'true' : undefined}
          data-title={item.sortTitle ?? item.title}
          data-search-text={`${item.title} ${(item.meta ?? []).join(' ')} ${item.verdict ?? ''}`}
        >
          <Card
            as="div"
            variant="compact-row"
            title={item.title}
            href={item.href}
            entityType={item.entityType}
            entitySlug={item.entitySlug}
            image={item.image}
            suppressImageHydration={suppressImageHydration}
            lockImageEditing={lockImageEditing}
            mediaFallback={missingImagePlate && !item.image}
            verdict={item.verdict}
            meta={item.meta}
            priceBand={item.priceBand}
            freshness={item.freshness}
            freshnessKind={item.freshnessKind}
            booking={item.booking}
            detailActionLabel={detailActionFallback && !item.booking ? 'View details' : undefined}
            partnerLabel={item.partnerLabel}
            surface={surface}
            position={i + 1}
          />
        </li>
      ))}
    </ul>

    {initialLimit && <div class="directory-progress" data-directory-progress hidden><p data-directory-progress-count></p><button type="button" data-directory-more>Show more {noun}</button><button type="button" data-directory-all>Show all {noun}</button></div>}

    <div data-filter-empty hidden>
      <EmptyState
        variant="filter-zero"
        heading={emptyHeading}
        body={emptyBody}
        surface={surface}
      />
    </div>

    <slot name="after-list" />
  </div>
</section>

<script>
  import { commit, isEmptyState, parseFilters } from '../../../lib/v5-filter-state';

  /** A filter or a local search narrows the page: the shortlist yields and every match is listed. */
  function narrowing(): boolean {
    const searching = !!document.querySelector('[data-directory-search]') && !!new URLSearchParams(location.search).get('find')?.trim();
    return searching || !isEmptyState(parseFilters(location.search));
  }

  function update(section: HTMLElement, reset = false) {
    const narrowed = narrowing();
    section.querySelectorAll<HTMLElement>('[data-featured-row]').forEach((row) => row.toggleAttribute('data-featured-hidden', !narrowed));
    const note = section.querySelector<HTMLElement>('[data-featured-note]');
    if (note) note.hidden = narrowed;
    const limit = Number(section.dataset.directoryLimit);
    if (!limit) return;
    if (reset) section.dataset.directoryShown = String(limit);
    const shown = Number(section.dataset.directoryShown) || limit;
    const all = [...section.querySelectorAll<HTMLElement>('[data-filter-countable]')];
    const rows = all.filter((row) => row.dataset.filteredOut !== '1' && !row.hasAttribute('data-featured-hidden'));
    all.forEach((row) => row.removeAttribute('data-page-hidden'));
    rows.forEach((row, index) => row.toggleAttribute('data-page-hidden', index >= shown));
    const progress = section.querySelector<HTMLElement>('[data-directory-progress]')!;
    progress.hidden = rows.length === 0;
    progress.querySelector('[data-directory-progress-count]')!.textContent = `Showing ${Math.min(shown, rows.length)} of ${rows.length} ${section.dataset.noun || 'places'}`;
    progress.querySelectorAll<HTMLButtonElement>('button').forEach((button) => (button.hidden = shown >= rows.length));
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-directory-rows]').forEach((section) => {
      if (section.dataset.pagerReady) return;
      section.dataset.pagerReady = 'true';
      section.querySelector('[data-directory-more]')?.addEventListener('click', () => {
        const limit = Number(section.dataset.directoryLimit), previous = Number(section.dataset.directoryShown) || limit;
        section.dataset.directoryShown = String(previous + limit);
        update(section);
        const rows = [...section.querySelectorAll<HTMLElement>('[data-filter-countable]')].filter((row) => row.dataset.filteredOut !== '1' && !row.hasAttribute('data-featured-hidden'));
        rows[previous]?.querySelector<HTMLAnchorElement>('h3 a')?.focus({ preventScroll: false });
      });
      section.querySelector('[data-directory-all]')?.addEventListener('click', () => {
        section.dataset.directoryShown = '100000';
        update(section);
        section.querySelector<HTMLElement>('.v5-directory__heading')?.focus({ preventScroll: true });
      });
      // EmptyState's "Clear filters" carries data-action="clear-filters".
      section.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement | null)?.closest('[data-action="clear-filters"]')) return;
        commit({}, { source: 'clear', noun: section.dataset.noun || 'results' });
        // The empty-state button disappears; orient focus at the restored list.
        window.requestAnimationFrame(() => section.querySelector<HTMLElement>('.v5-directory__heading')?.focus({ preventScroll: true }));
      });
      update(section, true);
    });
  }
  const refresh = () => document.querySelectorAll<HTMLElement>('[data-directory-rows]').forEach((section) => update(section, true));
  document.addEventListener('pi:filters-changed', refresh);
  document.addEventListener('pi:sort-changed', refresh);
  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
</script>

<style>
  .v5-directory {
    padding-block: var(--space-7);
    scroll-margin-top: calc(var(--masthead-h, 0px) + 1rem);
  }
  [data-page-hidden], [data-featured-hidden] { display: none !important; }
  .v5-directory__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .v5-directory__eyebrow {
    margin: 0 0 var(--space-2);
    font: 600 var(--fs-100)/var(--lh-label) var(--font-ui);
    letter-spacing: var(--ls-eyebrow, .1em);
    text-transform: uppercase;
    color: var(--soft);
  }
  .v5-directory__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-700);
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.14);
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }
  /* Doubled class: refinement.css sets this sub at body size with body[data-v4]. */
  .v5-directory__sub.v5-directory__sub {
    margin: var(--space-2) 0 0;
    max-width: var(--measure-dek, 52ch);
    font-size: var(--fs-300);
    line-height: var(--lh-ui, 1.4);
    color: var(--soft);
  }
  /* A section cross-link is a plain arrow link: no rule beneath it. */
  .v5-directory__toplink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.4rem;
    font: var(--fw-semibold, 600) var(--fs-300) var(--font-ui);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .v5-directory__toplink:hover { text-decoration: underline; text-underline-offset: .2em; }
  .v5-directory__toplink:focus-visible { outline: var(--focus-ring, 2px solid var(--accent)); outline-offset: 2px; }
  .v5-directory__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  /* The compact card draws the row's one hairline. Doubled class: refinement.css
     pads every row 24px top and bottom with body[data-v4], on top of the card's own. */
  .v5-directory__row.v5-directory__row { padding-block: 0; border-bottom: 0; }
  .v5-directory__row > :global(.pi-card.pi-card--compact:hover) { background: transparent; }
  .v5-directory--full-verdicts :global(.pi-card__dek) { max-width: 60ch; }
  /* Phone: the text takes the full width and Save sits beside the title,
     with the body padded clear of it so text never runs underneath. */
  @media (max-width: 599px) {
    .v5-directory__row.v5-directory__row :global(.pi-card.pi-card--compact:has(.pi-card__actions > :only-child)) { position: relative; display: block; }
    .v5-directory__row.v5-directory__row :global(.pi-card.pi-card--compact:has(.pi-card__actions > :only-child) .pi-card__media) { display: none; }
    .v5-directory__row.v5-directory__row :global(.pi-card.pi-card--compact:has(.pi-card__actions > :only-child) .pi-card__body) { padding-right: 56px; }
    .v5-directory__row.v5-directory__row :global(.pi-card.pi-card--compact .pi-card__actions:has(> :only-child)) { position: absolute; top: var(--space-1); right: 0; margin: 0; }
  }
  @media (min-width: 900px) {
    .v5-directory--columns-2 .v5-directory__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
    .v5-directory--columns-2 .v5-directory__row > :global(.pi-card) { height: 100%; }
  }
  .directory-progress { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); margin-top: var(--space-5); }
  /* A paginated list states its count once, at the pager. The filter bar
     count stays in the accessibility tree but is not shown twice. */
  [data-directory-limit] :global([data-filter-count]) { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .directory-progress p { flex: 1 1 100%; margin: 0; color: var(--soft); font-size: var(--fs-300); }
  .directory-progress button { min-height: 48px; border: 1px solid var(--accent); border-radius: var(--radius-s); padding: 0 var(--space-5); background: transparent; color: var(--accent); font: 600 var(--fs-300) var(--font-ui); cursor: pointer; }
  .directory-progress button:hover { background: var(--accent); color: var(--white); }
  /* One primary pager action; "Show all" is the quieter text link. */
  .directory-progress button[data-directory-all] { border-color: transparent; padding-inline: var(--space-1); text-decoration: underline; text-underline-offset: .2em; }
  .directory-progress button[data-directory-all]:hover { background: transparent; color: var(--acc-h, var(--accent)); }
  .directory-progress button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
</style>
