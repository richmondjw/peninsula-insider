---
/**
 * TheSix (v5 hub module) - the verdict layer: six cards worth planning
 * around this month (page-redesigns section 2 block 9.3; wireframes #eat
 * note 3). Editorially pinned, never algorithmic; each card is a Card(venue)
 * with a verdict of 25 words or fewer.
 *
 * One filter state governs the whole page: every item here carries a
 * `data-facets` payload (values from lib/facets getFacets) on its `li`, so
 * the page FilterBar shows/hides The Six AND the directory together.
 * Editorial order is fixed: no data-sort-container on this list.
 *
 * Filterable, never countable: every pick here is pinned FROM the directory
 * below, so these `li`s deliberately omit `data-filter-countable`
 * (COUNTABLE_ATTR in lib/v5-filter-state). The directory hides its copies of
 * these picks while the shortlist is on screen (DirectoryRows `featured`).
 *
 * Round 2 (2026-11-10): six equal cards in one grid, the one card style. A
 * pick without a rights-cleared photograph is a typographic card on paper,
 * never a stand-in illustration. On a phone the six become one swipe row, so
 * the shortlist costs a screen of scroll rather than six.
 */
import Card from '../Card.astro';
import CardGrid from '../CardGrid.astro';
import type { CardImage, CardBooking } from '../Card.astro';
import type { CmsEntityType } from '../../../lib/inline-edit/attrs';
import type { FacetKey } from '../../../lib/facets';

export interface SixItem {
  title: string;
  href: string;
  entityType: CmsEntityType;
  entitySlug: string;
  image?: CardImage;
  /** Retired with the house plate. Accepted, ignored. */
  plateLabel?: string;
  imageEdit?: { entityType: CmsEntityType; entitySlug: string; fieldPath: string };
  /** Critic voice, 25 words maximum (Card warns over). */
  verdict?: string;
  /** Joins the card's one meta line. */
  planningNote?: string;
  /** Up to 3 plain-text chips. */
  meta?: string[];
  priceBand?: string | number;
  /** ISO date, rendered via freshnessLabel(). */
  freshness?: string;
  /** Unified facet payload from getFacets(kind, data). */
  facets?: Partial<Record<FacetKey, string[]>>;
  booking?: CardBooking;
  partnerLabel?: string;
  saveSection?: string;
}

export interface Props {
  heading: string;
  eyebrow?: string;
  sub?: string;
  /** Analytics surface (eat, wine, stay, explore). */
  surface: string;
  /** Exactly six editorially pinned items (build warns off-count). */
  items: SixItem[];
  id?: string;
  /** Type eyebrow on each card. Off by default: the heading says what they are. */
  showEyebrow?: boolean;
  /** Retired: a pick without a photograph is always a text card now. Accepted, ignored. */
  missingImagePlate?: boolean;
  /** Keep documented listing photography fixed when the public CMS hydrates image slots. */
  suppressImageHydration?: boolean;
  lockImageEditing?: boolean;
  /** Retired: 'feature' now renders the same grid. Accepted for compatibility. */
  layout?: 'feature' | 'grid';
  /** Render "+ Trip" on each pick. Hubs turn it off (Save is the one card action). */
  trip?: boolean;
}

const { heading, eyebrow, sub, surface, items, id, showEyebrow = false, suppressImageHydration = false, lockImageEditing = false, trip = true } = Astro.props;

if (items.length !== 6) {
  console.warn(`[v5 TheSix] expected 6 items for surface "${surface}", got ${items.length}`);
}
const six = items.slice(0, 6);
/* In a set with photography, a pick without one becomes a text card. */
const anyImage = six.some((item) => Boolean(item.image?.src));
const headingId = `${id ?? `six-${surface}`}-heading`;
---

<section class="v5-six" id={id} aria-labelledby={headingId}>
  <div class="container">
    <div class="v5-six__header">
      {eyebrow && <p class="v5-six__eyebrow">{eyebrow}</p>}
      <h2 class="v5-six__heading" id={headingId}>{heading}</h2>
      {sub && <p class="v5-six__sub">{sub}</p>}
    </div>
    <CardGrid label={heading} layout="grid" maxCols={3}>
      {six.map((item, i) => (
        <li class="v5-six__item" data-facets={item.facets ? JSON.stringify(item.facets) : undefined} data-title={item.title}>
          <Card as="div" variant="venue"
            title={item.title} href={item.href} entityType={item.entityType} entitySlug={item.entitySlug}
            image={item.image} imageSizes="(max-width: 767px) 82vw, (max-width: 1023px) 50vw, 400px" imageEdit={item.imageEdit}
            suppressImageHydration={suppressImageHydration} lockImageEditing={lockImageEditing} mediaFallback={anyImage}
            planningNote={item.planningNote} showEyebrow={showEyebrow} verdict={item.verdict} meta={item.meta}
            priceBand={item.priceBand} freshness={item.freshness} freshnessKind="checked"
            booking={item.booking} partnerLabel={item.partnerLabel} saveSection={item.saveSection}
            trip={trip} surface={surface} position={i + 1} />
        </li>
      ))}
    </CardGrid>
  </div>
</section>

<style>
  .v5-six { padding-block: var(--space-7); }
  .v5-six__header { margin-bottom: var(--space-5); }
  .v5-six__eyebrow {
    margin: 0 0 var(--space-2);
    font: 600 var(--fs-100)/var(--lh-label) var(--font-ui);
    letter-spacing: var(--ls-eyebrow, .1em);
    text-transform: uppercase;
    color: var(--soft);
  }
  .v5-six__heading {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--fs-700);
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.14);
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }
  .v5-six__sub {
    margin: var(--space-2) 0 0;
    max-width: var(--measure-dek, 52ch);
    font-size: var(--fs-400);
    line-height: var(--lh-dek);
    color: var(--soft);
  }
  .v5-six__item { list-style: none; display: flex; }
  .v5-six__item > :global(.pi-card) { flex: 1; }
  /* Rows of three share one row gap with the cards' own rhythm. */
  .v5-six :global(.v5-card-grid) { row-gap: var(--space-7); column-gap: var(--space-5); }
  /* Phone: one swipe row of the same cards, bleeding to the screen edge. */
  @media (max-width: 47.99em) {
    .v5-six :global(.v5-card-grid) {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(82%, 20rem);
      gap: var(--space-4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px;
      margin-inline: -16px;
      padding: 0 16px var(--space-2);
      scrollbar-width: none;
    }
    .v5-six :global(.v5-card-grid)::-webkit-scrollbar { display: none; }
    .v5-six__item { scroll-snap-align: start; }
  }
</style>
