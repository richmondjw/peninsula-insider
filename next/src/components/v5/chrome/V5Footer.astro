---
import { PLAY, playUrl } from '../../../lib/play';
import { getConditionsStrip } from '../../../lib/conditions';
// The homepage and Dispatch page already present the full signup decision.
const showFooterLetter = Astro.url.pathname !== '/' && !Astro.url.pathname.startsWith('/dispatch');
// 2026-11-10 round 2: the edition and sunset left the masthead and live here as one quiet
// line. The cellar-door route keeps its named region (scripts/cellar-door-evidence-manifest.mjs).
const strip = getConditionsStrip();
const editionLandmark = Astro.url.pathname === '/wine/best-cellar-doors/' ? 'Peninsula conditions and edition' : undefined;
---
<footer class="footer pi-shell">
<div class="wrap footer-main">
<div class="footer-lead">
<a aria-label="Peninsula Insider home" class="brand" href="/">Peninsula <span>Insider</span></a>
{showFooterLetter ? <div class="footer-letter">
<h2>Good stories travel.</h2>
<p>The Peninsula worth knowing. An occasional email.</p>
<a class="footer-letter__link" href="/dispatch/">Join The Insider Note <span aria-hidden="true">→</span></a>
</div> : <p class="footer-tagline">Every pick earns its place. Every verdict, a reason.</p>}
</div>
<div class="footer-group">
<h2>More of the Peninsula</h2>
<a href="/weddings/">Weddings</a>
<a href="/fishing/">Fishing</a>
<a href="/boating/">Boating</a>
<a href="/map/">Open the map</a>
<a href="/site-index/">All places &amp; stories</a>
</div>
<div class="footer-group">
<h2>The publication</h2>
<a href="/about/">About us</a>
<a href="/photography/">Photography credits</a>
<a href="/partners/">For Peninsula businesses</a>
<a href="/contact/">Contact</a>
<a href="https://www.instagram.com/peninsula_insider/" rel="me noopener" target="_blank">Instagram <span aria-hidden="true">↗</span></a>
</div>
<div class="footer-group">
<h2>Your Peninsula</h2>
<a href="/me/saved/">Saved places</a>
<a href="/me/trip/">My trip</a>
<a href="/account/">Account</a>
{PLAY.enabled && <a href={playUrl('footer')} data-evt="pi_play_promo" data-surface="footer">Play: find PI <span aria-hidden="true">↗</span></a>}
</div>
</div>
<div class="wrap footer-bottom">
<p>Peninsula Insider acknowledges the Bunurong people of the Kulin Nation as the Traditional Custodians of the lands and waters of the Mornington Peninsula. We pay our respects to Elders past and present and acknowledge their continuing connection to Country, culture and community.</p>
<div class="legal-links">
<a href="/privacy/">Privacy</a>
<a href="/terms/">Terms</a>
<a href="/contact/?type=accessibility">Accessibility</a>
<a href="/contact/?type=correction">Corrections</a>
<a href="#cookie-settings" data-pi-consent="open">Cookie settings</a>
</div>
<p class="company-line">© {new Date().getFullYear()} Peninsula Insider, a trading name of Optiflows Pty Ltd · ABN 71 155 199 637</p>
<p class="footer-edition" role={editionLandmark ? 'region' : undefined} aria-label={editionLandmark}>{strip.issue}{strip.sunset && <> · Sunset {strip.sunset}</>}</p>
</div>
</footer>
<style>
 .footer{padding-top:var(--space-8);background:var(--bg-alt)}
 .footer-main{display:grid;grid-template-columns:minmax(0,1.5fr) repeat(3,minmax(0,1fr));gap:var(--space-7) var(--space-6)}
 .footer-tagline,.footer-letter p{margin:var(--space-3) 0 0;max-width:34ch;font:var(--fs-300)/var(--lh-dek) var(--font-ui);color:var(--soft)}
 .footer-letter{margin-top:var(--space-6)}
 .footer-letter h2{margin:0;font:var(--fw-display) var(--fs-600)/var(--lh-heading) var(--font-display);letter-spacing:var(--ls-display);color:var(--text)}
 .footer-letter .footer-letter__link{display:inline-flex;align-items:center;gap:var(--space-2);min-height:44px;margin-top:var(--space-2);font:var(--fw-semibold) var(--fs-300)/1.3 var(--font-ui);color:var(--accent)}
 .footer-group{display:flex;flex-direction:column;align-items:flex-start}
 .footer-group h2{margin:0 0 var(--space-2);font:var(--fw-semibold) var(--fs-200)/1.4 var(--font-display);color:var(--text)}
 .footer-group a{display:flex;align-items:center;gap:var(--space-1);min-height:36px;font:var(--fs-300)/1.3 var(--font-ui);color:var(--soft)}
 .footer a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
 .footer-bottom{margin-top:var(--space-7);padding:var(--space-5) 0 var(--space-6);border-top:1px solid var(--border)}
 .footer-bottom>p{margin:0;max-width:72ch;font:var(--fs-300)/var(--lh-dek) var(--font-ui);color:var(--soft)}
 .legal-links{display:flex;flex-wrap:wrap;gap:0 var(--space-5);margin-top:var(--space-3)}
 .legal-links a{display:flex;align-items:center;min-height:44px;font:var(--fs-300)/1.3 var(--font-ui);color:var(--soft)}
 .footer-bottom>.company-line,.footer-bottom>.footer-edition{margin-top:var(--space-2);font-size:var(--fs-200)}
 .footer a:focus-visible{outline:var(--focus-ring);outline-offset:3px}
 @media(max-width:900px){
  .footer-main{grid-template-columns:1fr 1fr;gap:var(--space-6) var(--space-5)}
  .footer-lead{grid-column:1/-1}
  .footer-group a{min-height:44px}
 }
 @media(max-width:767px){
  .footer{padding-top:var(--space-7)}
  .footer-letter{margin-top:var(--space-5)}
 }
</style>
