---
import { PLAY, playUrl } from '../../../lib/play';
// The homepage and Dispatch page already present the full signup decision.
const showFooterLetter = Astro.url.pathname !== '/' && !Astro.url.pathname.startsWith('/dispatch');
// Home promotes the case in the header beacon and the This-weekend panel,
// so the footer drops its Play link there (design-perfection G6).
const showPlay = PLAY.enabled && Astro.url.pathname !== '/';
---
<footer class="footer pi-shell">
<div class="wrap footer-lead">
<div>
<a aria-label="Peninsula Insider home" class="brand" href="/">Peninsula <span>Insider</span>
</a>
<p>Every pick earns its place.</p>
</div>
{showFooterLetter && <div class="footer-letter">
<p class="eyebrow">A note from the Peninsula</p>
<h2>Good stories travel.</h2>
<p>The Peninsula worth knowing. An occasional email.</p>
<a class="text-link" href="/dispatch/">Join The Insider Note <span aria-hidden="true">→</span>
</a>
</div>}
</div>
<div class="wrap footer-links">
<div>
<h2>Sections</h2>
<a href="/eat/">Eat &amp; Drink</a>
<a href="/stay/">Stay</a>
<a href="/wine/">Wine</a>
<a href="/explore/">Explore</a>
<a href="/explore/plans/">Plans</a>
<a href="/whats-on/">What’s On</a>
<a href="/journal/">Journal</a>
</div>
<div>
<h2>More of the Peninsula</h2>
<a href="/weddings/">Weddings</a>
<a href="/fishing/">Fishing</a>
<a href="/boating/">Boating</a>
<a href="/map/">Open the map</a>
<a href="/site-index/">All places &amp; stories</a>
</div>
<div>
<h2>The publication</h2>
<a href="/about/">About us</a>
<a href="/agents/">For AI assistants</a>
<a href="/photography/">Photography credits</a>
<a href="/partners/">For Peninsula businesses</a>
<a href="/contact/">Contact</a>
<a href="https://www.instagram.com/peninsula_insider/" rel="me noopener" target="_blank" aria-label="Instagram, @peninsula_insider (opens in a new tab)">Instagram</a>
</div>
<div>
<h2>Your Peninsula</h2>
<a href="/me/saved/">Saved places</a>
<a href="/me/trip/">My Trip</a>
<a href="/account/">Account</a>
</div>
</div>
{/* G21: the Play promo is its own full-width line under the link grid, in ink, so it neither breaks the
    column rhythm nor wraps beside its icon inside a narrow column. */}
{showPlay && <p class="wrap footer-promo"><a class="footer-play" href={playUrl('footer')} data-evt="pi_play_promo" data-surface="footer">
<img src="/images/play/pi-mark-still-96.png" width="20" height="19" alt=""/>Play Case {PLAY.case.id}: find PI on the map</a></p>}
<div class="wrap footer-bottom">
<p>Peninsula Insider acknowledges the Bunurong people of the Kulin Nation as the Traditional Custodians of the lands and waters of the Mornington Peninsula. We pay our respects to Elders past and present and acknowledge their continuing connection to Country, culture and community.</p>
<div class="legal-links">
<a href="/privacy/">Privacy</a>
<a href="/terms/">Terms</a>
<a href="/contact/?type=accessibility">Accessibility</a>
<a href="/contact/?type=correction">Corrections</a>
<a href="#cookie-settings" data-pi-consent="open">Cookie settings</a>
</div>
<p class="company-line">© {new Date().getFullYear()} Peninsula Insider, a trading name of Optiflows Pty Ltd<span class="company-sep"> · </span><span class="nowrap company-abn">ABN&nbsp;71&nbsp;155&nbsp;199&nbsp;637</span></p>
</div>
</footer>
