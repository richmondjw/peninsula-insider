---
/**
 * V5 mega panel (future-ia.md section 3.1, wireframes nav-desktop).
 *
 * One panel per pillar: 1 intro line (PI voice) + <=5 curated links +
 * 1 to 2 browse links + 1 editor's rail pin. Closed panels carry the
 * `hidden` attribute so their links are genuinely unreachable (fixes
 * A-01: no 113-tab-stop header traversal) and their text never appears
 * in the accessibility tree. No h1-h6 inside the panel (fixes A-09
 * heading pollution: intro, eyebrows and pin title are <p>/<span>).
 *
 * Open/close behaviour lives in V5Masthead's script: click or Enter on
 * the trigger, never focus or hover.
 *
 * v6 token pass (P3-6, 2026-07-25): the panel is all links, so nothing
 * moves to .pi-btn. Radii already follow the scale (--radius-l for the
 * panel, --radius-m for the pin tile) and --elev-3 is kept deliberately:
 * this floats over page content, which is what the elevation scale is
 * for - unlike in-flow cards, where P0-4 dropped shadows.
 */
import type { V5Pillar } from '../../../lib/v5-nav';
import { editableText } from '../../../lib/inline-edit/attrs';

export interface Props {
  pillar: V5Pillar;
}

const { pillar } = Astro.props;
const panelId = `v5-panel-${pillar.key}`;

// The rail pin is CMS-editable in place: title and verdict light up for
// admins via the existing inline editor. Inert data attributes otherwise.
const pinTitleAttrs = editableText({
  entityType: 'page',
  entitySlug: `nav-${pillar.key}`,
  fieldPath: 'rail.title',
  label: `${pillar.label} nav pin title`,
});
const pinVerdictAttrs = editableText({
  entityType: 'page',
  entitySlug: `nav-${pillar.key}`,
  fieldPath: 'rail.verdict',
  label: `${pillar.label} nav pin verdict`,
});
---

<div class="v5-mega" id={panelId} data-v5-mega hidden>
  <div class="v5-mega__inner">

    <div class="v5-mega__main">
      <p class="v5-mega__intro">{pillar.intro}</p>
      <ul class="v5-mega__curated">
        {pillar.curated.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="v5-mega__browse">
      <p class="v5-mega__eyebrow">Browse</p>
      <ul>
        {pillar.browse.map((item) => (
          <li><a href={item.href}>{item.label} <span aria-hidden="true">&rarr;</span></a></li>
        ))}
      </ul>
    </div>

    <a class="v5-mega__pin" href={pillar.rail.href}>
      <p class="v5-mega__eyebrow">{pillar.rail.eyebrow}</p>
      <p class="v5-mega__pin-title" {...pinTitleAttrs}>{pillar.rail.title}</p>
      <p class="v5-mega__pin-verdict" {...pinVerdictAttrs}>{pillar.rail.verdict}</p>
      <span class="v5-mega__pin-cta">{pillar.rail.cta ?? 'Read the verdict'} <span aria-hidden="true">&rarr;</span></span>
    </a>

  </div>
</div>

<style>
  .v5-mega {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: var(--space-4);
    right: var(--space-4);
    z-index: 40;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    box-shadow: var(--elev-3);
    overflow: hidden;
  }

  .v5-mega__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: var(--space-7) var(--space-6);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr minmax(200px, 0.9fr);
    gap: var(--space-7);
  }

  .v5-mega__intro {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-500);
    line-height: var(--lh-dek);
    letter-spacing: var(--ls-display);
    color: var(--text);
    margin-bottom: var(--space-4);
    max-width: var(--measure-dek);
  }

  .v5-mega__curated {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .v5-mega__curated a {
    display: inline-block;
    padding: var(--space-1) 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: var(--fw-medium);
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-enter);
  }
  .v5-mega__curated a:hover { color: var(--accent); }

  .v5-mega__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-100);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    /* Was --teal-text. That measures 5.05:1 on white but only 4.45:1 on
       --bg-alt, and this same class is used inside .v5-mega__pin, which
       is an --bg-alt tile - so the eyebrow shipped below AA there.
       --accent clears AA on both grounds (8.17:1 on --bg, 7.19:1 on
       --bg-alt) and gives the chrome one eyebrow colour instead of two. */
    color: var(--accent);
    margin-bottom: var(--space-3);
    line-height: var(--lh-label);
  }

  .v5-mega__browse ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .v5-mega__browse a {
    display: inline-block;
    padding: var(--space-1) 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: var(--fw-semibold);
    color: var(--accent);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-enter);
  }
  .v5-mega__browse a:hover { color: var(--acc-h); }

  .v5-mega__pin {
    display: block;
    text-decoration: none;
    background: var(--bg-alt);
    border-radius: var(--radius-m);
    padding: var(--space-5);
  }
  .v5-mega__pin-title {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-600);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--text);
    margin-bottom: var(--space-2);
    transition: color var(--dur-fast) var(--ease-enter);
  }
  .v5-mega__pin:hover .v5-mega__pin-title { color: var(--accent); }
  .v5-mega__pin-verdict {
    font-family: var(--font-ui);
    font-size: var(--fs-400);
    line-height: var(--lh-dek);
    color: var(--soft);
    margin-bottom: var(--space-3);
    max-width: var(--measure-card);
  }
  .v5-mega__pin-cta {
    font-family: var(--font-ui);
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    color: var(--accent);
  }

  .v5-mega a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  /* The nav row (and therefore the panel) is desktop-only; the drawer
     carries mobile wayfinding. Belt-and-braces with V5Masthead's rule. */
  @media (max-width: 1023px) {
    .v5-mega { display: none; }
  }
</style>
