---
/**
 * V5 mega panel (future-ia.md section 3.1, wireframes nav-desktop).
 *
 * One panel per pillar: 1 intro line (PI voice) + <=5 curated links +
 * 1 to 2 browse links + 1 editor's rail pin. Closed panels carry the
 * `hidden` attribute so their links are genuinely unreachable (fixes
 * A-01: no 113-tab-stop header traversal) and their text never appears
 * in the accessibility tree. No h1-h6 inside the panel (fixes A-09
 * heading pollution: intro, eyebrows and pin title are <p>/<span>).
 *
 * Open/close behaviour lives in V5Masthead: hover on desktop, and the
 * disclosure button on keyboard and touch screens.
 *
 * v6 token pass (P3-6, 2026-07-25): the panel is all links, so nothing
 * moves to .pi-btn. Radii already follow the scale (--radius-l for the
 * panel, --radius-m for the pin tile) and --elev-3 is kept deliberately:
 * this floats over page content, which is what the elevation scale is
 * for - unlike in-flow cards, where P0-4 dropped shadows.
 */
import type { V5Pillar } from '../../../lib/v5-nav';
import { editableText } from '../../../lib/inline-edit/attrs';

export interface Props {
  pillar: V5Pillar;
}

const { pillar } = Astro.props;
const panelId = `v5-panel-${pillar.key}`;
const iconPaths: Record<string, string> = {
  'long-lunch': 'M4 3v7a3 3 0 0 0 6 0V3M7 13v8M17 21V3c-3 2-4 6-4 10h4',
  breakfast: 'M3 17h18M5 13a7 7 0 0 1 14 0M12 3v2M4.5 6l1.5 1.5M19.5 6 18 7.5',
  cafes: 'M4 8h13v7a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8ZM17 9h2a2 2 0 0 1 0 4h-2M3 21h17',
  breweries: 'M8 3h8M9 3v4l-3 4v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-8l-3-4V3M6 13h12',
  'one-night': 'M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z',
  kids: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20v-2a5 5 0 0 1 10 0v2M12 20v-2a5 5 0 0 1 10 0v2',
  villas: 'M3 11 12 4l9 7M5 10v10h14V10M9 20v-6h6v6',
  glamping: 'M12 3 2 20h20L12 3ZM12 3v17M8 20l4-7 4 7',
  'best-cellar': 'M8 3h8M9 3v7l-3 6a4 4 0 0 0 4 5h4a4 4 0 0 0 4-5l-3-6V3M8 14h8',
  producers: 'M12 5c2-2 4-2 6-1M12 5c0-2 1-3 3-4M9 9a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM14 9a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM11.5 14a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM16 14a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM13.5 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z',
  shortlist: 'm12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z',
  'winery-weddings': 'M7 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM17 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM3 14l4 7 5-8 5 8 4-7',
  walks: 'M8 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM12 21l-2-6-3-2 2-4 4 2 2 4 4 2M5 21l4-6',
  golf: 'M5 22V3l13 3-13 4M3 22h5M17 18c2 0 4 1 4 2s-2 2-4 2-4-1-4-2 2-2 4-2Z',
  dog: 'M8 13 6 9M16 13l2-4M8 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM16 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM4 14c0-2 2-3 4-3h8c2 0 4 1 4 3v4a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-4Z',
  tours: 'm12 2 7 3 3 7-3 7-7 3-7-3-3-7 3-7 7-3ZM15 9l-6 6 2-5 4-1Z',
  fishing: 'M3 12c4-5 10-6 16 0-6 6-12 5-16 0ZM19 12l3-3v6l-3-3ZM7 11h.01',
  'ridge-sea': 'M3 18c3-8 5-13 8-13 4 0 2 14 10 14M3 18l4-1M18 5l3 1-1 3',
  sorrento: 'M3 17h18M5 13a7 7 0 0 1 14 0M12 3v2M4.5 6l1.5 1.5M19.5 6 18 7.5',
  family: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20v-2a5 5 0 0 1 10 0v2M12 20v-2a5 5 0 0 1 10 0v2',
  weddings: 'M7 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM17 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM3 14l4 7 5-8 5 8 4-7',
  'weekend-edit': 'M4 5h16v16H4V5ZM4 10h16M8 3v4M16 3v4M8 14h3M8 17h7',
  rainy: 'M6 16a5 5 0 0 1 1-9 7 7 0 0 1 13 4 4 4 0 0 1-1 8H8M8 19l-1 3M14 19l-1 3',
  orientation: 'm12 2 7 3 3 7-3 7-7 3-7-3-3-7 3-7 7-3ZM15 9l-6 6 2-5 4-1Z',
};

// The rail pin is CMS-editable in place: title and verdict light up for
// admins via the existing inline editor. Inert data attributes otherwise.
const pinTitleAttrs = editableText({
  entityType: 'page',
  entitySlug: `nav-${pillar.key}`,
  fieldPath: 'rail.title',
  label: `${pillar.label} nav pin title`,
});
const pinVerdictAttrs = editableText({
  entityType: 'page',
  entitySlug: `nav-${pillar.key}`,
  fieldPath: 'rail.verdict',
  label: `${pillar.label} nav pin verdict`,
});
---

<div class="v5-mega" id={panelId} data-v5-mega hidden>
  <div class="v5-mega__inner">

    <div class="v5-mega__main">
      <p class="v5-mega__eyebrow">{pillar.label}</p>
      <p class="v5-mega__intro">{pillar.intro}</p>
      <ul class="v5-mega__curated">
        {pillar.curated.map((item) => (
          <li><a href={item.href}><span class="v5-mega__icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={iconPaths[item.key] ?? iconPaths.orientation} /></svg></span><span>{item.label}</span><span class="v5-mega__arrow" aria-hidden="true">&rarr;</span></a></li>
        ))}
      </ul>
    </div>

    <div class="v5-mega__browse">
      <p class="v5-mega__eyebrow">Browse</p>
      <ul>
        {pillar.browse.map((item) => (
          <li><a href={item.href}>{item.label} <span aria-hidden="true">&rarr;</span></a></li>
        ))}
      </ul>
    </div>

    <a class="v5-mega__pin" href={pillar.rail.href}>
      <p class="v5-mega__eyebrow">{pillar.rail.eyebrow}</p>
      <p class="v5-mega__pin-title" {...pinTitleAttrs}>{pillar.rail.title}</p>
      <p class="v5-mega__pin-verdict" {...pinVerdictAttrs}>{pillar.rail.verdict}</p>
      <span class="v5-mega__pin-cta">{pillar.rail.cta ?? 'Read the verdict'} <span aria-hidden="true">&rarr;</span></span>
    </a>

  </div>
</div>

<style>
  .v5-mega {
    position: absolute;
    top: 100%;
    left: var(--space-4);
    right: var(--space-4);
    z-index: 40;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    box-shadow: var(--elev-3);
    overflow: hidden;
  }
  .v5-mega[hidden] { display: none !important; }

  .v5-mega__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: var(--space-7) var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.9fr);
    gap: var(--space-4) var(--space-7);
  }

  .v5-mega__intro {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-500);
    line-height: var(--lh-dek);
    letter-spacing: var(--ls-display);
    color: var(--text);
    margin-bottom: var(--space-4);
    max-width: var(--measure-dek);
  }

  .v5-mega__curated {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .v5-mega__curated a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 45px;
    padding: 3px 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: var(--fw-medium);
    color: var(--text);
    text-decoration: none;
    text-transform: none;
    letter-spacing: normal;
    transition: color var(--dur-fast) var(--ease-enter);
  }
  .v5-mega__curated a:hover { color: var(--accent); }
  .v5-mega__icon { width: 34px; height: 34px; flex: none; display: grid; place-items: center; color: var(--accent); background: var(--bg-alt); border-radius: 10px; }
  .v5-mega__icon svg { width: 19px; height: 19px; }
  .v5-mega__arrow { margin-left: auto; font-size: 18px; color: var(--accent); opacity: 0; transform: translateX(-4px); transition: opacity .18s ease, transform .18s ease; }
  .v5-mega__curated a:hover .v5-mega__arrow, .v5-mega__curated a:focus-visible .v5-mega__arrow { opacity: 1; transform: translateX(0); }

  .v5-mega__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-100);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    /* Was --teal-text. That measures 5.05:1 on white but only 4.45:1 on
       --bg-alt, and this same class is used inside .v5-mega__pin, which
       is an --bg-alt tile - so the eyebrow shipped below AA there.
       --accent clears AA on both grounds (8.17:1 on --bg, 7.19:1 on
       --bg-alt) and gives the chrome one eyebrow colour instead of two. */
    color: var(--accent);
    margin-bottom: var(--space-3);
    line-height: var(--lh-label);
  }

  .v5-mega__browse { grid-column: 1; grid-row: 2; }
  .v5-mega__browse ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .v5-mega__browse a {
    display: inline-block;
    padding: var(--space-1) 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: var(--fw-semibold);
    color: var(--accent);
    text-decoration: none;
    text-transform: none;
    letter-spacing: normal;
    transition: color var(--dur-fast) var(--ease-enter);
  }
  .v5-mega__browse a:hover { color: var(--acc-h); }

  .v5-mega .v5-mega__pin {
    display: block;
    text-decoration: none;
    background: var(--bg-alt);
    border-radius: var(--radius-m);
    padding: var(--space-5);
    min-height: 0;
    text-transform: none;
    letter-spacing: normal;
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .v5-mega__pin-title {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-600);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--text);
    margin-bottom: var(--space-2);
    transition: color var(--dur-fast) var(--ease-enter);
  }
  .v5-mega__pin:hover .v5-mega__pin-title { color: var(--accent); }
  .v5-mega__pin-verdict {
    font-family: var(--font-ui);
    font-size: var(--fs-400);
    line-height: var(--lh-dek);
    color: var(--soft);
    margin-bottom: var(--space-3);
    max-width: var(--measure-card);
  }
  .v5-mega__pin-cta {
    font-family: var(--font-ui);
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    color: var(--accent);
  }

  .v5-mega a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  @media (max-width: 1100px) {
    .v5-mega { position: static; border: 0; border-radius: 0; box-shadow: none; background: var(--bg-alt); }
    .v5-mega__inner { display: block; padding: 14px 16px 20px; }
    .v5-mega__intro { font-size: var(--fs-400); margin-bottom: 12px; }
    .v5-mega__curated { gap: 0; }
    .v5-mega__browse { margin-top: 12px; }
    .v5-mega__browse ul { gap: 0; }
    .v5-mega__browse a { min-height: 42px; }
    .v5-mega .v5-mega__pin { display: none; }
  }
</style>
