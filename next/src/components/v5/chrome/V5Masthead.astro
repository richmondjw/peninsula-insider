---
import PlayBeacon from '../../play/PlayBeacon.astro';
import V5MegaPanel from './V5MegaPanel.astro';
import { v5Pillars } from '../../../lib/v5-nav';
import '../../../styles/editorial-shell.css';
const { section = 'home' } = Astro.props;
const path = Astro.url.pathname;
const active = path.startsWith('/explore/plans') || path.startsWith('/plans') ? 'plans' : path.startsWith('/events') ? 'whats-on' : section;
---
<header class="masthead site-header pi-shell" data-v5-masthead>
<div class="masthead-row wrap">
<a aria-label="Peninsula Insider home" class="brand" href="/">Peninsula <span>Insider</span>
</a>
<p class="brand-note">A local point of view.<br/>A Peninsula worth knowing.</p>
<div class="header-actions">
<a class="search-link" data-open-search data-evt="search_open" href="/search/">
<svg aria-hidden="true" fill="none" height="17" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="17">
<circle cx="10.5" cy="10.5" r="6.5">
</circle>
<path d="m16 16 5 5">
</path>
</svg>
<span>Search</span>
</a>
<PlayBeacon />
<a class="note-link" href="/dispatch/">The Insider Note <span aria-hidden="true">↗</span>
</a>
<button aria-controls="site-nav" aria-expanded="false" aria-label="Open navigation" class="mobile-menu">
<svg aria-hidden="true" height="22" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="22">
<path d="M3 7h18M3 12h18M3 17h18">
</path>
</svg>
</button>
</div>
</div>
<nav aria-label="Main navigation" class="site-nav" id="site-nav">
<div class="wrap">
<button class="mobile-menu-close" type="button" aria-label="Close navigation">Close</button>
{v5Pillars.map(p => <div class="pillar-menu" data-pillar-menu>
<div class="pillar-menu__trigger">
<a href={p.hub} aria-current={active === p.key ? 'page' : undefined}>{p.label}</a>
<button class="pillar-menu__toggle" type="button" aria-label={`Open ${p.label} menu`} aria-expanded="false" aria-controls={`v5-panel-${p.key}`} data-pillar-toggle>
<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="m3.5 6 4.5 4 4.5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
</div>
<V5MegaPanel pillar={p} />
</div>)}<details class="personal-menu">
<summary>Your Peninsula <span aria-hidden="true">⌄</span>
</summary>
<div class="personal-panel">
<span class="v2-util__links">
</span>
<a href="/me/saved/">Saved places</a>
<a href="/me/trip/">My trip</a>
<a href="/account/">Account</a>
<a href="/map/">Open the map</a>
</div>
</details>
<a class="mobile-search" data-open-search href="/search/">Search the site ↗</a>
<a class="mobile-note" href="/dispatch/">The Insider Note ↗</a>
</div>
</nav>
</header>
<script>
let shellCleanup:(()=>void)|undefined;
document.addEventListener('astro:before-swap',()=>shellCleanup?.());
function initEditorialShell(){
 const header=document.querySelector<HTMLElement>('.site-header');
 if(!header || header.dataset.bound)return;
 header.dataset.bound='true';
 const button=header.querySelector<HTMLButtonElement>('.mobile-menu')!;
 const nav=header.querySelector<HTMLElement>('#site-nav')!;
 const personal=header.querySelector<HTMLDetailsElement>('.personal-menu')!;
 const closeButton=header.querySelector<HTMLButtonElement>('.mobile-menu-close')!;
 const menus=[...header.querySelectorAll<HTMLElement>('[data-pillar-menu]')];
 const mobileMedia=window.matchMedia('(max-width: 1100px)');
 let previousOverflow=document.body.style.overflow;
 let previousRootOverflow=document.documentElement.style.overflow;
 const focusable=()=>[...nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), summary')].filter(el=>!el.closest('[hidden], [aria-hidden="true"]')&&el.getClientRects().length>0);
 let closeTimer:number|undefined;

 function closeMenu(menu:HTMLElement){
   const panel=menu.querySelector<HTMLElement>('[data-v5-mega]')!;
   const toggle=menu.querySelector<HTMLButtonElement>('[data-pillar-toggle]')!;
   panel.hidden=true;
   toggle.setAttribute('aria-expanded','false');
   menu.classList.remove('is-open');
 }
 function closePanels(except?:HTMLElement){
  window.clearTimeout(closeTimer);
  menus.forEach(menu=>{if(menu!==except)closeMenu(menu);});
 }
 function openPanel(menu:HTMLElement){
  closePanels(menu);
  const panel=menu.querySelector<HTMLElement>('[data-v5-mega]')!;
  const toggle=menu.querySelector<HTMLButtonElement>('[data-pillar-toggle]')!;
  panel.hidden=false;
  toggle.setAttribute('aria-expanded','true');
  menu.classList.add('is-open');
  personal.open=false;
 }
 menus.forEach(menu=>{
  const toggle=menu.querySelector<HTMLButtonElement>('[data-pillar-toggle]')!;
  let hoverTimer:number|undefined;
  menu.addEventListener('pointerenter',e=>{
   if(e.pointerType!=='mouse' || !window.matchMedia('(min-width: 1101px)').matches)return;
   // Give a direct chevron click priority over hover-opening the panel.
   if(toggle.contains(document.elementFromPoint(e.clientX,e.clientY)))hoverTimer=window.setTimeout(()=>openPanel(menu),550);
   else openPanel(menu);
  });
  menu.addEventListener('pointerleave',e=>{window.clearTimeout(hoverTimer);if(e.pointerType==='mouse' && window.matchMedia('(min-width: 1101px)').matches)closeTimer=window.setTimeout(()=>closePanels(),180);});
  toggle.addEventListener('pointerdown',()=>window.clearTimeout(hoverTimer));
  menu.addEventListener('focusout',e=>{if(!menu.contains(e.relatedTarget as Node))window.setTimeout(()=>closeMenu(menu),0);});
  toggle.addEventListener('click',()=>{menu.classList.contains('is-open')?closePanels():openPanel(menu);});
 });

 function close(){if(button.getAttribute('aria-expanded')==='true'){document.body.style.overflow=previousOverflow;document.documentElement.style.overflow=previousRootOverflow;}button.setAttribute('aria-expanded','false');nav.style.removeProperty('--mobile-nav-top');nav.removeAttribute('role');nav.removeAttribute('aria-modal');nav.classList.remove('open');closePanels();}
 function open(){previousOverflow=document.body.style.overflow;previousRootOverflow=document.documentElement.style.overflow;button.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';document.documentElement.style.overflow='hidden';nav.setAttribute('role','dialog');nav.setAttribute('aria-modal','true');nav.classList.add('open');nav.style.setProperty('--mobile-nav-top',`${Math.max(0,nav.getBoundingClientRect().top)}px`);nav.scrollTop=0;window.requestAnimationFrame(()=>focusable()[0]?.focus());}
 function trapFocus(e:KeyboardEvent){const items=focusable();const first=items[0],last=items[items.length-1];if(!first||!last)return;if(!nav.contains(document.activeElement)){e.preventDefault();(e.shiftKey?last:first).focus();return;}if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}
 button.addEventListener('click',()=>button.getAttribute('aria-expanded')==='true'?close():open());
 closeButton.addEventListener('click',()=>{close();button.focus();});
 const onKeydown=(e:KeyboardEvent)=>{if(e.key==='Tab' && button.getAttribute('aria-expanded')==='true'){trapFocus(e);return;}if(e.key!=='Escape')return;const open=menus.find(menu=>menu.classList.contains('is-open'));if(open){closePanels();open.querySelector<HTMLButtonElement>('[data-pillar-toggle]')?.focus();}else if(personal.open){personal.open=false;personal.querySelector('summary')?.focus();}else if(button.getAttribute('aria-expanded')==='true'){close();button.focus();}};
 const onClick=(e:MouseEvent)=>{if(!personal.contains(e.target as Node))personal.open=false;if(!nav.contains(e.target as Node))closePanels();if(button.getAttribute('aria-expanded')==='true'&&!nav.contains(e.target as Node)&&!button.contains(e.target as Node)){close();button.focus();}};
 const onMediaChange=(e:MediaQueryListEvent)=>{if(!e.matches&&button.getAttribute('aria-expanded')==='true')close();};
 document.addEventListener('keydown',onKeydown);
 document.addEventListener('click',onClick);
 mobileMedia.addEventListener('change',onMediaChange);
 shellCleanup=()=>{window.clearTimeout(closeTimer);close();document.removeEventListener('keydown',onKeydown);document.removeEventListener('click',onClick);mobileMedia.removeEventListener('change',onMediaChange);};
}
initEditorialShell();document.addEventListener('astro:page-load',initEditorialShell);
</script>
<style>
 .site-nav{position:relative}
 .pillar-menu__trigger{display:flex;align-items:center}
 .pillar-menu__toggle{display:flex;align-items:center;justify-content:center;width:25px;height:44px;margin-left:-2px;padding:0;border:0;background:transparent;color:#53636d;cursor:pointer}
 .pillar-menu__toggle svg{transition:transform .18s ease}
 @media(prefers-reduced-motion:reduce){.pillar-menu__toggle svg{transition:none}}
 .pillar-menu.is-open .pillar-menu__toggle svg{transform:rotate(180deg)}
 .pillar-menu.is-open .pillar-menu__trigger>a{color:#10527e}
 .pillar-menu__toggle:focus-visible{outline:3px solid #11309c;outline-offset:2px}
 .mobile-menu-close{display:none}
 @media(max-width:1100px){
  .site-nav{display:none}
  .site-nav.open{display:block;max-height:calc(100dvh - var(--mobile-nav-top, 124px));overflow-y:auto;overscroll-behavior:contain}
  .site-nav>.wrap{display:grid;grid-template-columns:1fr;gap:0;padding:10px 0 20px}
  .mobile-menu{display:flex;align-items:center;justify-content:center;cursor:pointer}
  .mobile-menu-close{display:flex;align-items:center;justify-content:center;min-height:44px;min-width:44px;justify-self:end;padding:0 14px;border:1px solid #53636d;background:#fff;color:#12211e;font:600 12px/1 Inter,Arial,sans-serif;cursor:pointer}
  .pillar-menu{border-bottom:1px solid #e4e5e3}
  .pillar-menu__trigger{justify-content:space-between}
  .site-nav .pillar-menu__trigger>a{flex:1;min-height:44px}
  .pillar-menu__toggle{width:46px;height:46px;border-left:1px solid #e4e5e3}
  .personal-menu{margin:0;border-bottom:1px solid #e4e5e3}
  .personal-panel{position:static;box-shadow:none;border:0;padding:0 8px 10px}
  .site-nav .mobile-search,.site-nav .mobile-note{display:flex}
 }
 .mobile-menu-close:focus-visible,
 .mobile-menu:focus-visible{outline:3px solid #11309c;outline-offset:3px}
 @media(max-width:767px){.site-nav>.wrap{grid-template-columns:1fr;gap:0}}
</style>
