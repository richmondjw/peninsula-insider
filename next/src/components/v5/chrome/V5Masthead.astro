---
import V5MegaPanel from './V5MegaPanel.astro';
import { v5Pillars, v5DrawerItems, v5DrawerCta } from '../../../lib/v5-nav';
import { PLAY, playUrl } from '../../../lib/play';
import '../../../styles/editorial-shell.css';
const { section = 'home' } = Astro.props;
const path = Astro.url.pathname;
const active = path.startsWith('/explore/plans') || path.startsWith('/plans') ? 'plans' : path.startsWith('/events') ? 'whats-on' : section;
/* 2026-11-10 round 2: one calm band - wordmark, the seven pillars, search and one
   personal menu. The edition and sunset dateline moved to the footer (V5Footer keeps
   the cellar-door named region). The Insider Note and Play live in the personal
   menu and the mobile drawer. The site notice stays, as quiet text (owner decision). */
const SITE_UPDATING = true;
---
<header class="masthead site-header pi-shell" data-v5-masthead>
<div class="masthead-row wrap">
<div class="brand-lockup">
<a aria-label="Peninsula Insider home" class="brand" href="/">Peninsula <span>Insider</span></a>
{SITE_UPDATING && <span class="masthead-update">Under update</span>}
</div>
<nav aria-label="Main navigation" class="site-nav" id="site-nav">
{v5Pillars.map(p => <div class="pillar-menu" data-pillar-menu>
<div class="pillar-menu__trigger">
<a href={p.hub} aria-current={active === p.key ? 'page' : undefined}>{p.label}</a>
<button class="pillar-menu__toggle" type="button" aria-label={`Open ${p.label} menu`} aria-expanded="false" aria-controls={`v5-panel-${p.key}`} data-pillar-toggle>
<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none"><path d="m3.5 6 4.5 4 4.5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
</div>
<V5MegaPanel pillar={p} />
</div>)}
<a class="mobile-note" href="/dispatch/">The Insider Note</a>
</nav>
<div class="header-actions">
<a class="search-link" data-open-search data-evt="search_open" href="/search/" aria-label="Search the Peninsula">
<svg aria-hidden="true" fill="none" height="19" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="19"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
<span>Search</span>
</a>
<details class="personal-menu">
<summary>
<svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="20"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.3-3.6 4.2-5.5 7.5-5.5s6.2 1.9 7.5 5.5" stroke-linecap="round"/></svg>
<span class="personal-menu__label">Your Peninsula</span>
</summary>
<div class="personal-panel">
<a href="/me/saved/">Saved places</a>
<a href="/me/trip/">My trip</a>
<a href="/account/">Account</a>
<a href="/map/">Open the map</a>
<a class="personal-panel__sep" href="/dispatch/">The Insider Note</a>
{PLAY.enabled && <a href={playUrl('masthead')} data-evt="pi_play_promo" data-surface="masthead">Play: find PI <span aria-hidden="true">↗</span></a>}
</div>
</details>
<button type="button" aria-controls="mobile-drawer" aria-expanded="false" aria-label="Open navigation" class="mobile-menu">
<svg aria-hidden="true" height="22" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="22"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
</button>
</div>
</div>
<dialog class="mobile-drawer" id="mobile-drawer" aria-label="Mobile navigation">
  <div class="mobile-drawer__top">
    <a class="mobile-drawer__brand" href="/" aria-label="Peninsula Insider home">Peninsula <span>Insider</span></a>
    <button class="mobile-drawer__close" type="button" aria-label="Close navigation" data-mobile-drawer-close>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 5 19 19M19 5 5 19"/></svg>
    </button>
  </div>
  <nav class="mobile-drawer__body" aria-label="Explore the Peninsula">
    <div class="mobile-drawer__intro">
      <p class="mobile-drawer__eyebrow">The local edit</p>
      <p class="mobile-drawer__title">Find your way.</p>
    </div>
    <a class="mobile-drawer__search" data-open-search data-evt="search_open" href="/search/">
      <svg aria-hidden="true" fill="none" height="19" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="19"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
      <span>Search places, plans &amp; stories</span>
    </a>
    <div class="mobile-drawer__columns">
      <section class="mobile-drawer__section" aria-labelledby="mobile-drawer-explore">
        <h2 class="mobile-drawer__group-label" id="mobile-drawer-explore">Explore</h2>
        <ul class="mobile-drawer__primary">
          {v5DrawerItems.filter(item => item.group === 'pillars').map(item => (
            <li><a href={item.href} aria-current={active === item.key ? 'page' : undefined}><span>{item.label}</span><span class="mobile-drawer__arrow" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </section>
      <div class="mobile-drawer__aside">
        <section class="mobile-drawer__section" aria-labelledby="mobile-drawer-yours">
          <h2 class="mobile-drawer__group-label" id="mobile-drawer-yours">Your Peninsula</h2>
          <ul class="mobile-drawer__secondary">
            {v5DrawerItems.filter(item => item.group === 'mine').map(item => (
              <li><a href={item.href}><span>{item.label}</span></a></li>
            ))}
            <li><a href="/map/"><span>Open the map</span></a></li>
            {PLAY.enabled && <li><a href={playUrl('drawer')} data-evt="pi_play_promo" data-surface="drawer"><span>Play: find PI</span><span aria-hidden="true">↗</span></a></li>}
          </ul>
        </section>
        <section class="mobile-drawer__section mobile-drawer__section--about" aria-labelledby="mobile-drawer-about">
          <h2 class="mobile-drawer__group-label" id="mobile-drawer-about">About us</h2>
          <ul class="mobile-drawer__secondary">
            {v5DrawerItems.filter(item => item.group === 'trust').map(item => (
              <li><a href={item.href}><span>{item.label}</span></a></li>
            ))}
          </ul>
        </section>
        <a class="mobile-drawer__dispatch" href={v5DrawerCta.href}>
          <strong>{v5DrawerCta.label}</strong>
          <span class="mobile-drawer__dispatch-dek">{v5DrawerCta.dek}</span>
          <span class="mobile-drawer__dispatch-action">{v5DrawerCta.ctaLabel} <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </nav>
</dialog>
</header>
<noscript>
  <style is:inline>
    @media (max-width: 1279px) {
      .pi-shell.site-header .masthead-row { flex-wrap: wrap; }
      .pi-shell.site-header .site-nav { display: flex !important; flex-wrap: wrap; flex-basis: 100%; }
      .pi-shell.site-header .mobile-menu { display: none !important; }
    }
  </style>
</noscript>
<script>
let shellCleanup:(()=>void)|undefined;
document.addEventListener('astro:before-swap',()=>shellCleanup?.());
/* Desktop navigation (inline pillars + hover panels) starts at 1280px; below that the drawer takes over. */
const DESKTOP='(min-width: 1280px)';
const COMPACT='(max-width: 1279px)';
function initEditorialShell(){
 const header=document.querySelector<HTMLElement>('.site-header');
 if(!header || header.dataset.bound)return;
 header.dataset.bound='true';
 const button=header.querySelector<HTMLButtonElement>('.mobile-menu')!;
 const nav=header.querySelector<HTMLElement>('#site-nav')!;
 const drawer=header.querySelector<HTMLDialogElement>('#mobile-drawer')!;
 const drawerClose=drawer.querySelector<HTMLButtonElement>('[data-mobile-drawer-close]')!;
 const personal=header.querySelector<HTMLDetailsElement>('.personal-menu')!;
 const menus=[...header.querySelectorAll<HTMLElement>('[data-pillar-menu]')];
 let closeTimer:number|undefined;
 let savedScrollY=0;
 let savedBodyStyle:{position:string;top:string;width:string;overflow:string;htmlOverflow:string}|undefined;

 function closeMenu(menu:HTMLElement){
   const panel=menu.querySelector<HTMLElement>('[data-v5-mega]')!;
   const toggle=menu.querySelector<HTMLButtonElement>('[data-pillar-toggle]')!;
   panel.hidden=true;
   toggle.setAttribute('aria-expanded','false');
   toggle.setAttribute('aria-label',`Open ${menu.querySelector('.pillar-menu__trigger a')?.textContent?.trim()} menu`);
   menu.classList.remove('is-open');
 }
 function closePanels(except?:HTMLElement){
  window.clearTimeout(closeTimer);
  menus.forEach(menu=>{if(menu!==except)closeMenu(menu);});
 }
 function openPanel(menu:HTMLElement){
  closePanels(menu);
  const panel=menu.querySelector<HTMLElement>('[data-v5-mega]')!;
  const toggle=menu.querySelector<HTMLButtonElement>('[data-pillar-toggle]')!;
  panel.hidden=false;
  toggle.setAttribute('aria-expanded','true');
  toggle.setAttribute('aria-label',`Close ${menu.querySelector('.pillar-menu__trigger a')?.textContent?.trim()} menu`);
  menu.classList.add('is-open');
  personal.open=false;
 }
 menus.forEach(menu=>{
  const toggle=menu.querySelector<HTMLButtonElement>('[data-pillar-toggle]')!;
  let hoverTimer:number|undefined;
  menu.addEventListener('pointerenter',e=>{
   if(e.pointerType!=='mouse' || !window.matchMedia(DESKTOP).matches)return;
   // Give a direct chevron click priority over hover-opening the panel.
   if(toggle.contains(document.elementFromPoint(e.clientX,e.clientY)))hoverTimer=window.setTimeout(()=>openPanel(menu),550);
   else openPanel(menu);
  });
  menu.addEventListener('pointerleave',e=>{window.clearTimeout(hoverTimer);if(e.pointerType==='mouse' && window.matchMedia(DESKTOP).matches)closeTimer=window.setTimeout(()=>closePanels(),180);});
  toggle.addEventListener('pointerdown',()=>window.clearTimeout(hoverTimer));
  menu.addEventListener('focusout',e=>{if(!menu.contains(e.relatedTarget as Node))window.setTimeout(()=>closeMenu(menu),0);});
  toggle.addEventListener('click',()=>{menu.classList.contains('is-open')?closePanels():openPanel(menu);});
 });
 personal.addEventListener('toggle',()=>{if(personal.open)closePanels();});

 function unlockPage(){
  if(!savedBodyStyle)return;
  document.body.style.position=savedBodyStyle.position;
  document.body.style.top=savedBodyStyle.top;
  document.body.style.width=savedBodyStyle.width;
  document.body.style.overflow=savedBodyStyle.overflow;
  document.documentElement.style.overflow=savedBodyStyle.htmlOverflow;
  savedBodyStyle=undefined;
  window.scrollTo(0,savedScrollY);
 }
 function closeDrawer(restoreFocus=true){
  if(drawer.open)drawer.close();
  unlockPage();
  button.setAttribute('aria-expanded','false');
  button.setAttribute('aria-label','Open navigation');
  if(restoreFocus && button.isConnected && window.matchMedia(COMPACT).matches)button.focus();
 }
 function openDrawer(){
  if(!window.matchMedia(COMPACT).matches || drawer.open)return;
  closePanels();
  personal.open=false;
  savedScrollY=window.scrollY;
  savedBodyStyle={
   position:document.body.style.position,
   top:document.body.style.top,
   width:document.body.style.width,
   overflow:document.body.style.overflow,
   htmlOverflow:document.documentElement.style.overflow,
  };
  document.body.style.position='fixed';
  document.body.style.top=`-${savedScrollY}px`;
  document.body.style.width='100%';
  document.body.style.overflow='hidden';
  document.documentElement.style.overflow='hidden';
  drawer.showModal();
  button.setAttribute('aria-expanded','true');
  button.setAttribute('aria-label','Close navigation');
  drawerClose.focus({preventScroll:true});
  drawer.scrollTop=0;
 }
 button.addEventListener('click',()=>drawer.open?closeDrawer():openDrawer());
 drawerClose.addEventListener('click',()=>closeDrawer());
 drawer.addEventListener('cancel',e=>{e.preventDefault();closeDrawer();});
 drawer.addEventListener('click',e=>{if((e.target as Element).closest('a'))closeDrawer(false);});
 const onKeydown=(e:KeyboardEvent)=>{if(e.key!=='Escape')return;if(drawer.open){e.preventDefault();closeDrawer();return;}const open=menus.find(menu=>menu.classList.contains('is-open'));if(open){closePanels();open.querySelector<HTMLButtonElement>('[data-pillar-toggle]')?.focus();}else if(personal.open){personal.open=false;personal.querySelector('summary')?.focus();}};
 const onClick=(e:MouseEvent)=>{if(!personal.contains(e.target as Node))personal.open=false;if(!nav.contains(e.target as Node))closePanels();};
 const onResize=()=>{if(drawer.open && !window.matchMedia(COMPACT).matches)closeDrawer(false);};
 document.addEventListener('keydown',onKeydown);
 document.addEventListener('click',onClick);
 window.addEventListener('resize',onResize);
 shellCleanup=()=>{closeDrawer(false);window.clearTimeout(closeTimer);document.removeEventListener('keydown',onKeydown);document.removeEventListener('click',onClick);window.removeEventListener('resize',onResize);};
}
initEditorialShell();document.addEventListener('astro:page-load',initEditorialShell);
</script>
<style>
 /* One band. The header itself is the positioning context for the mega panels
    (it is sticky, from global.css), so a panel spans the page, not the nav. */
 .site-header{padding-top:env(safe-area-inset-top);border-bottom:1px solid var(--border)}
 .masthead-row{display:flex;align-items:center;gap:var(--space-6);min-height:72px}
 .brand-lockup{display:flex;align-items:baseline;gap:var(--space-3);flex:none}
 .masthead-update{font:var(--fw-medium) var(--fs-100)/var(--lh-label) var(--font-ui);color:var(--soft);white-space:nowrap}
 .site-nav{display:flex;align-self:stretch;align-items:stretch;gap:var(--space-5);margin-inline:auto}
 .pillar-menu,.pillar-menu__trigger{display:flex;align-items:stretch}
 .site-nav .pillar-menu__trigger>a{display:flex;align-items:center;min-height:44px;font:var(--fw-medium) var(--fs-300)/var(--lh-ui) var(--font-ui);color:var(--text);white-space:nowrap;text-decoration:none}
 .site-nav .pillar-menu__trigger>a:hover,.pillar-menu.is-open .pillar-menu__trigger>a{color:var(--accent)}
 .site-nav .pillar-menu__trigger>a[aria-current=page]{color:var(--accent);text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:8px}
 .pillar-menu__toggle{display:flex;align-items:center;justify-content:center;width:22px;padding:0;border:0;background:transparent;color:var(--soft);cursor:pointer}
 .pillar-menu__toggle svg{transition:transform var(--dur-fast) ease}
 .pillar-menu.is-open .pillar-menu__toggle svg{transform:rotate(180deg)}
 .site-nav .mobile-search,.site-nav .mobile-note{display:none}
 .header-actions{display:flex;align-items:center;gap:var(--space-2);flex:none;margin-left:auto}
 .search-link,.personal-menu summary,.mobile-menu{display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;background:transparent;color:var(--text);cursor:pointer;font:var(--fw-medium) var(--fs-300)/1 var(--font-ui);list-style:none;border-radius:50%}
 .search-link:hover,.personal-menu summary:hover,.personal-menu[open] summary{color:var(--accent);background:var(--bg-alt)}
 .search-link span,.personal-menu__label{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 .personal-menu{position:relative}
 .personal-menu summary::-webkit-details-marker{display:none}
 .personal-panel{position:absolute;right:0;top:calc(100% + var(--space-2));z-index:var(--z-sticky);display:flex;flex-direction:column;min-width:220px;padding:var(--space-2) 0;background:var(--white);border:1px solid var(--border);border-radius:var(--radius-s);box-shadow:var(--elev-3)}
 .personal-panel a{display:flex;align-items:center;gap:var(--space-2);min-height:44px;padding:0 var(--space-4);font:var(--fs-300)/var(--lh-ui) var(--font-ui);color:var(--text);text-decoration:none}
 .personal-panel a:hover{color:var(--accent);background:var(--bg-alt)}
 .personal-panel .personal-panel__sep{margin-top:var(--space-2);border-top:1px solid var(--border)}
 .mobile-menu{display:none}
 .site-header a:focus-visible,.site-header summary:focus-visible,.site-header button:focus-visible{outline:var(--focus-ring);outline-offset:2px}
 .mobile-drawer{display:none}
 @media(max-width:1279px){
  .masthead-row{min-height:64px;gap:var(--space-3)}
  .site-nav,.personal-menu{display:none}
  .mobile-menu{display:flex;flex:none}
  .mobile-drawer[open]{display:block;position:fixed;inset:0;width:100%;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;border:0;background:var(--bg-alt);color:var(--text);overflow-y:auto;overscroll-behavior:contain;z-index:10000}
  .mobile-drawer::backdrop{background:var(--bg-deep)}
  .mobile-drawer__top{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:var(--space-5);min-height:64px;padding:var(--space-2) max(24px,calc((100vw - 920px)/2));background:var(--white);border-bottom:1px solid var(--border)}
  .mobile-drawer__brand{display:flex;align-items:center;gap:.18em;min-height:44px;font:700 var(--fs-600)/1.05 var(--font-display);letter-spacing:-.025em;color:var(--text);white-space:nowrap}
  .mobile-drawer__brand span{color:var(--accent)}
  .mobile-drawer__close{display:grid;place-items:center;width:44px;height:44px;flex:none;border:0;border-radius:50%;background:var(--bg-alt);color:var(--text);cursor:pointer}
  .mobile-drawer__body{width:min(920px,calc(100% - 48px));margin:0 auto;padding:var(--space-5) 0 max(48px,env(safe-area-inset-bottom))}
  .mobile-drawer__eyebrow,.mobile-drawer__group-label{margin:0;font:var(--fw-semibold) var(--fs-100)/1.5 var(--font-ui);letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--soft)}
  .mobile-drawer__title{margin:var(--space-1) 0 var(--space-5);font:var(--fw-display) var(--fs-700)/1.1 var(--font-display);letter-spacing:-.025em;color:var(--text)}
  .mobile-drawer__search{display:flex;align-items:center;gap:var(--space-3);min-height:52px;padding:0 var(--space-4);background:var(--white);border:1px solid var(--border-control,var(--border-strong));border-radius:var(--radius-s);font:var(--fw-medium) var(--fs-300)/1.3 var(--font-ui);color:var(--soft);text-decoration:none}
  .mobile-drawer__columns{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(255px,.85fr);gap:var(--space-8);margin-top:var(--space-6)}
  .mobile-drawer__group-label{margin-bottom:var(--space-2)}
  .mobile-drawer__primary,.mobile-drawer__secondary{list-style:none;margin:0;padding:0}
  .mobile-drawer__primary a,.mobile-drawer__secondary a{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);min-height:52px;border-bottom:1px solid var(--border);color:var(--text);font:var(--fw-medium) var(--fs-500)/1.2 var(--font-ui);text-decoration:none}
  .mobile-drawer__secondary a{min-height:48px;font-size:var(--fs-300)}
  .mobile-drawer__primary a:hover,.mobile-drawer__primary a[aria-current=page],.mobile-drawer__secondary a:hover{color:var(--accent)}
  .mobile-drawer__arrow{color:var(--soft)}
  .mobile-drawer__section--about{margin-top:var(--space-5)}
  .mobile-drawer__dispatch{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-2);margin-top:var(--space-6);padding:var(--space-5);background:var(--bg-deep);color:var(--white);border-radius:var(--radius-m);text-decoration:none}
  .mobile-drawer__dispatch strong{font:var(--fw-display) var(--fs-600)/1.1 var(--font-display);letter-spacing:-.02em}
  .mobile-drawer__dispatch-dek{max-width:40ch;color:var(--soft-inverse);font:var(--fs-300)/1.5 var(--font-ui)}
  .mobile-drawer__dispatch-action{margin-top:var(--space-1);color:var(--sand);font:var(--fw-semibold) var(--fs-300)/1.3 var(--font-ui)}
  .mobile-drawer a:focus-visible,.mobile-drawer button:focus-visible{outline:var(--focus-ring);outline-offset:3px}
  .mobile-drawer__dispatch:focus-visible{outline-color:var(--sand)}
 }
 @media(max-width:767px){
  .brand-lockup{flex-direction:column;align-items:flex-start;gap:0}
  .header-actions{gap:0}
  .mobile-drawer__top{padding:var(--space-2) var(--space-4)}
  .mobile-drawer__body{width:calc(100% - 32px)}
  .mobile-drawer__columns{display:block}
  .mobile-drawer__aside{margin-top:var(--space-6)}
 }
</style>
