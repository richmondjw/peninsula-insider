---
/**
 * FilterBar (v5, spec 2.16) - the single top-of-list filtering surface.
 *
 * Intent preset chips first (from CHIP_PRESETS[surface]), then a "More
 * filters" trigger that opens FilterSheet. The trigger sits outside the chip
 * scroller so it is never scrolled off-screen. Below 768px it is pinned first
 * and the chips form one scrolling row beside it, so the whole toolbar is a
 * single 48px row with a fade cue at the scrolled edges. A result line
 * ("12 places") and Clear appear only
 * while a filter is active: the page's total lives in its directory heading.
 * The default slot takes SortControl / MapToggle. One per listing surface.
 *
 * One filter state governs the whole page: every element carrying a
 * `data-facets` JSON attribute (curated grid AND directory) is shown/hidden
 * by lib/v5-filter-state.ts. See that file's header for the page-agent
 * contract. This component renders the page's single polite live region
 * (#pi-results-status), so keep exactly one FilterBar per page.
 */
import { CHIP_PRESETS, type FacetKey } from '../../lib/facets';
import FilterSheet from './FilterSheet.astro';

export interface Props {
  /** CHIP_PRESETS surface key (eat, stay, wine, explore, whats-on, ...). */
  surface: string;
  /** Plural noun for count copy: "12 places". */
  noun?: string;
  /** Accessible name for the group. */
  label?: string;
  /** Stick the bar to the top of the viewport on scroll. */
  sticky?: boolean;
  /** Render the paired FilterSheet (turn off if the page composes its own). */
  withSheet?: boolean;
  /**
   * Restrict the paired FilterSheet to these facet groups (contextual filters,
   * P1.2). Omit for the full shared taxonomy; every hub surface should pass
   * only the groups its readers actually expect (page-redesigns-hubs.md /
   * precision-sprint pass 04 "Reader-first filters").
   */
  facets?: FacetKey[];
}

const {
  surface,
  noun = 'places',
  label = 'Filters',
  sticky = false,
  withSheet = true,
  facets,
} = Astro.props;

const presets = CHIP_PRESETS[surface] ?? [];
const hasTools = Astro.slots.has('default');
---

<div
  class:list={['v5-filterbar', { 'v5-filterbar--sticky': sticky }]}
  data-v5-filterbar
  data-noun={noun}
  role="group"
  aria-label={label}
>
  <div class="v5-filterbar__row">
    <div class="v5-filterbar__scroll" data-chip-scroll>
      {presets.map((chip) => (
        <button
          type="button"
          class="v5-filterbar__chip"
          data-filter-chip
          data-key={chip.key}
          data-value={chip.value}
          data-evt="filter_apply"
          aria-pressed="false"
        >
          {chip.label}
        </button>
      ))}
    </div>
    <div class="v5-filterbar__end">
      <button
        type="button"
        class="v5-filterbar__chip v5-filterbar__chip--more"
        data-sheet-open
        data-evt="filter_open"
        aria-haspopup="dialog"
      >
        <svg class="v5-filterbar__more-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M2 4h12M4.5 8h7M6.5 12h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        More filters<span class="v5-filterbar__more-count" data-filter-active-count hidden></span>
      </button>
      {hasTools && <div class="v5-filterbar__tools"><slot /></div>}
    </div>
  </div>
  <p class="v5-filterbar__meta">
    <span class="v5-filterbar__count" data-filter-count data-filter-count-quiet hidden></span>
    <button type="button" class="v5-filterbar__clear" data-filter-clear data-evt="filter_clear" hidden>
      Clear filters
    </button>
  </p>
  <p id="pi-results-status" class="v5-vh" role="status" aria-live="polite"></p>
</div>

{withSheet && <FilterSheet noun={noun} facets={facets} surface={surface} />}

<style>
  /* The bar sits on whatever ground it is placed on (the compact hero band
     on the hubs), so it carries no panel of its own and no rule: one rule at
     most between the hero controls and the content. */
  .v5-filterbar {
    background: transparent;
    padding: var(--space-2, 0.5rem) 0 0;
  }
  .v5-filterbar--sticky {
    position: sticky;
    /* Sit below the sticky masthead (its measured height is published as
       --masthead-h on <html> by BaseLayout) rather than jamming under it. */
    top: var(--masthead-h, 0px);
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2, 0.5rem);
  }
  .v5-filterbar__row {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }
  /* Horizontally scrollable chip row with a fade affordance on each edge
     that still has chips beyond it (the script sets data-scroll-start and
     data-scroll-end). "More filters" lives outside it, so the one control
     that opens every facet is never faded out. */
  .v5-filterbar__scroll {
    --fade-start: 0px;
    --fade-end: 3rem;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-2, 0.5rem);
    overflow-x: auto;
    flex: 0 1 auto;
    min-width: 0;
    padding: 2px;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(to right,
      transparent 0,
      black var(--fade-start),
      black calc(100% - var(--fade-end)),
      transparent 100%);
  }
  .v5-filterbar__scroll::-webkit-scrollbar {
    display: none;
  }
  .v5-filterbar__scroll[data-scroll-start='false'] {
    --fade-start: 1.5rem;
  }
  .v5-filterbar__scroll[data-scroll-end='true'] {
    --fade-end: 0px;
  }
  .v5-filterbar__scroll[data-scroll-start='true'][data-scroll-end='true'] {
    mask-image: none;
  }
  .v5-filterbar__end {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem) var(--space-4, 1rem);
    flex: 1 0 auto;
  }
  .v5-filterbar__tools {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    margin-left: auto;
  }
  /* Phones: one 48px toolbar row. "More filters" is pinned first as a fixed
     chip (display: contents lifts it out of __end into the row), the chips
     scroll horizontally beside it with snap and an edge fade, and any tools
     (sort, map toggle) take their own line underneath. The scroller's 4px
     padding keeps each chip's focus ring inside its clip box; the matching
     negative margins keep the row 48px tall and the gap at 8px. */
  @media (max-width: 767px) {
    .v5-filterbar__row { flex-wrap: wrap; align-items: center; }
    .v5-filterbar__end { display: contents; }
    .v5-filterbar__chip--more { order: -1; flex: 0 0 auto; }
    .v5-filterbar__scroll {
      flex: 1 1 0;
      padding: 4px;
      margin: -4px 0 -4px -4px;
      scroll-snap-type: x proximity;
    }
    .v5-filterbar__scroll > .v5-filterbar__chip { scroll-snap-align: start; }
    .v5-filterbar__tools { order: 1; flex: 1 0 100%; margin-left: 0; }
  }
  .v5-filterbar__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: 500;
    line-height: var(--lh-ui, 1.4);
    color: var(--text);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 1rem;
    min-height: 48px; /* accessibility audit: 48px touch targets */
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.15s var(--ease),
      border-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }
  .v5-filterbar__chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .v5-filterbar__chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .v5-filterbar__chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--white);
  }
  @media (max-width: 767px) {
    .v5-filterbar__chip {
      font-size: 0.875rem;
      padding: 0 0.875rem;
    }
  }
  .v5-filterbar__more-icon {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--harbour, #10527E);
  }
  .v5-filterbar__chip:hover .v5-filterbar__more-icon { color: currentColor; }
  .v5-filterbar__more-count {
    margin-left: 0.1rem;
    background: var(--accent);
    color: var(--white);
    border-radius: 999px;
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
  }
  .v5-filterbar__chip--more[aria-expanded='true'],
  .v5-filterbar__chip[aria-pressed='true'] .v5-filterbar__more-count {
    background: var(--white);
    color: var(--accent);
  }
  /* Result line: silent until a filter is active, then "12 places" and
     Clear sit directly under the chips they answer. */
  .v5-filterbar__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4, 1rem);
    margin: var(--space-1, 0.25rem) 0 0;
    font-family: var(--font-ui);
    font-size: var(--fs-300, 0.9375rem);
    color: var(--soft);
  }
  .v5-filterbar__meta:not(:has(> :not([hidden]))) {
    display: none;
  }
  .v5-filterbar__count {
    font-weight: 600;
    color: var(--text);
  }
  .v5-filterbar__clear {
    background: none;
    border: none;
    color: var(--harbour, #10527E);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
    min-height: 44px;
    padding: 0 0.25rem;
  }
  .v5-filterbar__clear:hover { color: var(--harbour-h, #0C4166); }
  .v5-filterbar__clear:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .v5-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import {
    initFilterState,
    getState,
    toggleValue,
    commit,
    countActive,
    isEmptyState,
    type FilterState,
    type FilterKey,
  } from '../../lib/v5-filter-state';

  function paint(bar: HTMLElement, state: FilterState) {
    bar.querySelectorAll<HTMLButtonElement>('[data-filter-chip]').forEach((chip) => {
      const key = chip.dataset.key as FilterKey;
      const value = chip.dataset.value || '';
      const on = !!state[key] && state[key]!.indexOf(value) !== -1;
      chip.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    const clear = bar.querySelector<HTMLElement>('[data-filter-clear]');
    if (clear) clear.toggleAttribute('hidden', isEmptyState(state));
    const badge = bar.querySelector<HTMLElement>('[data-filter-active-count]');
    if (badge) {
      const n = countActive(state);
      badge.textContent = n ? String(n) : '';
      badge.toggleAttribute('hidden', n === 0);
    }
  }

  function hydrate(bar: HTMLElement) {
    if ((bar as any)._piInit) return;
    (bar as any)._piInit = true;
    const noun = bar.dataset.noun || 'results';

    initFilterState({ noun });
    paint(bar, getState());

    bar.querySelectorAll<HTMLButtonElement>('[data-filter-chip]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.key as FilterKey;
        const value = chip.dataset.value || '';
        if (!key || !value) return;
        commit(toggleValue(getState(), key, value), { source: 'chip', noun });
      });
    });

    bar.querySelector('[data-filter-clear]')?.addEventListener('click', () => {
      commit({}, { source: 'clear', noun });
    });

    // Fade affordance: each edge fades only while chips remain beyond it.
    const scroller = bar.querySelector<HTMLElement>('[data-chip-scroll]');
    if (scroller) {
      const update = () => {
        const atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
        scroller.dataset.scrollEnd = atEnd ? 'true' : 'false';
        scroller.dataset.scrollStart = scroller.scrollLeft <= 4 ? 'true' : 'false';
      };
      scroller.addEventListener('scroll', update, { passive: true });
      update();
    }
  }

  // Keep chips in sync when the sheet, popstate, or another island commits.
  //
  // This sits at module scope, not inside hydrate(). The `_piInit` guard is on
  // the bar element, and the client router replaces that element on every
  // navigation - so the guard is fresh each time while the listener on
  // `document` is not. Registering here added one more copy per visit to a
  // filtered hub, each holding the previous, detached bar alive and repainting
  // it forever. Measured at +1 per navigation by tests/journeys before this
  // change. The listener now paints whichever bars are live when it fires.
  document.addEventListener('pi:filters-changed', ((e: CustomEvent) => {
    document.querySelectorAll<HTMLElement>('[data-v5-filterbar]').forEach((bar) => {
      paint(bar, e.detail.filters);
    });
  }) as EventListener);

  function init() {
    document.querySelectorAll<HTMLElement>('[data-v5-filterbar]').forEach(hydrate);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
