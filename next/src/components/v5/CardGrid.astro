---
/**
 * CardGrid (v5) - the labelled list wrapper for Card.
 *
 * Cards are `li` elements (Card's default root); this provides the `ul`
 * with an accessible name and the responsive grid: 1 column to bp-sm,
 * 2 at bp-md (768), 3 at bp-lg (1024) and up. `layout="rows"` stacks
 * compact-row cards as a single-column list (search results, agendas).
 *
 * One card gutter sitewide: 24px between columns and between grid rows.
 * In `rows` the list owns the single divider between rows (compact rows draw
 * no rule of their own), with 24px either side of it.
 */
export interface Props {
  /** Accessible name for the list, e.g. "Wineries in Red Hill". */
  label: string;
  layout?: 'grid' | 'rows';
  /** Cap grid tracks at 2 columns for narrow rails. */
  maxCols?: 2 | 3;
}

const { label, layout = 'grid', maxCols = 3 } = Astro.props;
---

<ul
  class:list={['v5-card-grid', `v5-card-grid--${layout}`, maxCols === 2 && 'v5-card-grid--two']}
  aria-label={label}
>
  <slot />
</ul>

<style>
  .v5-card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5, 1.5rem);
    grid-template-columns: 1fr;
  }
  /* Square gutters (C26): the row gap equals the column gap, so a grid
     reads as one block rather than loose rows. */
  .v5-card-grid--grid {
    row-gap: var(--space-5, 1.5rem);
  }
  /* Equal-height cells (C24). A card that is itself the grid item already
     stretches to its row. A wrapper item (an li holding the card, as in
     TheSix) becomes a flex box so its card fills the cell too, and the
     card's pinned foot line lands on one baseline across the row.
     Scoped to li: Astro emits component module scripts inside the list at
     first render, and a broader selector turned them into empty grid cells. */
  .v5-card-grid--grid > :global(li:not(.pi-card)) {
    display: flex;
  }
  .v5-card-grid--grid > :global(li:not(.pi-card)) > :global(.pi-card) {
    flex: 1 1 auto;
    min-width: 0;
  }
  .v5-card-grid--grid > :global(.pi-card) {
    height: 100%;
  }

  @media (min-width: 48em) {
    .v5-card-grid--grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64em) {
    .v5-card-grid--grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .v5-card-grid--grid.v5-card-grid--two {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .v5-card-grid--rows {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .v5-card-grid--rows > :global(li) {
    padding-block: var(--space-5, 1.5rem);
    border-bottom: 1px solid var(--border);
  }
  .v5-card-grid--rows > :global(li:last-child) {
    border-bottom: 0;
  }
</style>
