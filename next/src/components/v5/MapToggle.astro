---
/**
 * MapToggle (v5, per spec 2.20 MapResultPanel toggle) - a two-button
 * List / Map segmented control with aria-pressed semantics (not tabs; the
 * accessibility audit A-11 demotes fake role="tab" switches to toggle
 * buttons).
 *
 * Toggling preserves the current filter state: only the `view` param is
 * touched (history.replaceState), so `?mood=long-lunch&place=red-hill`
 * travels between list and map views of the same surface. Emits
 * 'pi:view-toggle' with { view, filters }; the map island itself is wired
 * by a later agent and listens for that event.
 */
export interface Props {
  /** Accessible name for the control group. */
  label?: string;
}

const { label = 'View as' } = Astro.props;
---

<div class="v5-viewtoggle" data-v5-maptoggle role="group" aria-label={label}>
  <button type="button" class="v5-viewtoggle__btn" data-view="list" data-evt="map_toggle" aria-pressed="true">
    List
  </button>
  <button type="button" class="v5-viewtoggle__btn" data-view="map" data-evt="map_toggle" aria-pressed="false">
    Map
  </button>
</div>

<style>
  .v5-viewtoggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    background: var(--white);
  }
  .v5-viewtoggle__btn {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    background: transparent;
    border: none;
    min-height: 48px;
    min-width: 64px;
    padding: 0 1rem;
    cursor: pointer;
    transition:
      background 0.15s var(--ease),
      color 0.15s var(--ease);
  }
  .v5-viewtoggle__btn[aria-pressed='true'] {
    background: var(--accent);
    color: var(--white);
  }
  .v5-viewtoggle__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
</style>

<script>
  import { getView, setView, type ViewValue } from '../../lib/v5-filter-state';

  function paint(root: HTMLElement, view: ViewValue) {
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.view === view ? 'true' : 'false');
    });
  }

  function hydrate(root: HTMLElement) {
    if ((root as any)._piInit) return;
    (root as any)._piInit = true;

    paint(root, getView());

    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = (btn.dataset.view === 'map' ? 'map' : 'list') as ViewValue;
        if (view === getView()) return;
        setView(view); // preserves filter params, emits pi:view-toggle
        paint(root, view);
      });
    });

    window.addEventListener('popstate', () => paint(root, getView()));
    document.addEventListener('pi:view-toggle', ((e: CustomEvent) => {
      paint(root, e.detail.view);
    }) as EventListener);
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-v5-maptoggle]').forEach(hydrate);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
