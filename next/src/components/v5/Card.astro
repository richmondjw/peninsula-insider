---
/**
 * Card (v5) - THE one card primitive (component spec 2.15).
 *
 * Seven variants, one anatomy: media / title / dek / one meta line /
 * stretched link. Replaces VenueCard, PlaceCard, EventCard, ArticleCard,
 * ItineraryCard, PlanCard, TourCard and friends.
 *
 * One card style site-wide (simplification round 2, 2026-11-10):
 *  - No fill, no frame, no footer band. The photograph and the gutter define
 *    the card; the text runs flush with the photograph's edge.
 *  - Image, title, one dek, ONE meta line (chips, practical note, check date
 *    and any partner disclosure share it). The whole card is the link.
 *  - Save is a small icon over the photograph's top-right corner. A card
 *    without a photograph carries it at the top right of the text.
 *  - Licence credits stay, as one quiet line laid over the photograph's foot,
 *    so every title in a row starts on the same line.
 *  - No stand-in art. A card asked to hold a photo slot it has no photograph
 *    for (`mediaFallback`) becomes a typographic card on paper. Its empty CMS
 *    slot stays in the DOM for editors and appears only in edit mode.
 *
 * Content rules enforced here (spec 0.1): title <= 60 chars, verdict <= 25
 * words, meta <= 3 chips, priceBand chips only (never dollar figures),
 * no em-dashes. Violations warn at build time so page agents catch them.
 *
 * A11y contract:
 *  - Root is an `li` by default (cards live in labelled lists); use
 *    `as="article"` for standalone placements.
 *  - The title anchor is the ONLY link; a ::after stretches it over the
 *    card. SaveControl / trip / booking sit ABOVE the stretched link and are
 *    never nested inside it. The focus ring is drawn around the whole card.
 *  - Verdict is a <p>, never a heading. Save target >= 44px.
 *
 * Analytics: link carries data-evt="card_click" plus entity attrs; the
 * "+ Trip" affordance carries data-evt="trip_add" and writes to the shared
 * trip store on every surface, with visible confirmation.
 */
import { editableImage, type CmsEntityType } from '../../lib/inline-edit/attrs';
import { freshnessLabel } from '../../lib/freshness';
import SaveControl from './SaveControl.astro';
import { cleanCaption, isArtwork } from '../../lib/image-caption.mjs';
import BookingControl from './BookingControl.astro';
import type { EditorialPlan } from '../../lib/editorial-plan-import';

export type CardVariant = 'venue' | 'compact-row' | 'event' | 'guide' | 'plan' | 'place' | 'article';

export interface CardImage {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  sourceUrl?: string;
  licenceUrl?: string;
  changeNote?: string;
}

export interface CardBooking {
  url: string;
  label?: string;
  venueName?: string;
  partnerLabel?: string;
}

/** Save kinds accepted by the pi:saves:v2 store. */
type SaveKind = 'article' | 'venue' | 'place' | 'event' | 'experience' | 'itinerary' | 'tour' | 'tour-operator' | 'tour-package';

export interface Props {
  variant?: CardVariant;
  title: string;
  href: string;
  /** CMS identity for the editable media slot (cms-architecture Rule 1). */
  entityType: CmsEntityType;
  entitySlug: string;
  /** Defaults to 'heroImage', the live convention across card surfaces. */
  fieldPath?: string;
  /** A page-specific media slot can differ from the card's save/link identity. */
  imageEdit?: { entityType: CmsEntityType; entitySlug: string; fieldPath: string };
  /** Keep a curated image when an incomplete CMS row exists at this slot. */
  suppressImageHydration?: boolean;
  /** Lock this card photo to its reviewed source; editing remains available on its detail page. */
  lockImageEditing?: boolean;
  /** Client CMS replacement must have descriptive alt text and a credit. */
  requireImageMetadata?: boolean;
  /** Omit for text-only compact rows (enforcer HERO_EXEMPT case). */
  image?: CardImage;
  /** Real display sizes when this card is wider than a third of the row (feature placements). */
  imageSizes?: string;
  /** Opt-in smaller AVIF delivery; the build retains a native WebP fallback. */
  preferAvif?: boolean;
  /** Verdict line <= 25 words. The named slot `verdict` overrides this. */
  verdict?: string;
  /** Practical line; joins the meta line rather than taking a row of its own. */
  planningNote?: string;
  /** Retired with the house plate (no stand-in art). Accepted, ignored. */
  mediaFallbackMark?: string;
  /** Up to 3 plain-text chips, joined with a middot separator. */
  meta?: string[];
  /** '$'..'$$$$' or 1..4. Rendered as a band chip, never a dollar figure. */
  priceBand?: string | number;
  /** ISO date; rendered through freshnessLabel() ("Reviewed May 2026"). */
  freshness?: string;
  freshnessKind?: 'reviewed' | 'checked';
  /** Entity label eyebrow; defaults per variant (Venue/Event/Guide/...). */
  typeMark?: string;
  /**
   * Render the type eyebrow. Set false from a section whose heading already
   * declares the type ("This weekend" over three event cards stamped EVENT).
   */
  showEyebrow?: boolean;
  /**
   * This card sits in an image-bearing row. When it has no photograph it
   * becomes a typographic card on paper (never a stand-in illustration), so
   * the row still reads as designed. Leave false for text-only lists.
   */
  mediaFallback?: boolean;
  /** Retired with the house plate. Accepted, ignored. */
  mediaFallbackLabel?: string;
  /** Region eyebrow for the place variant (replaces typeMark when set). */
  eyebrow?: string;
  /** Article variant: byline (falls back to "Peninsula Insider"). */
  byline?: string;
  /** Article/guide variants: e.g. "7 min read". */
  readTime?: string;
  /** Event start date or article publish date, ISO. */
  dateISO?: string;
  /** Event variant: show the day/month tile on the photograph. Default on. */
  showDate?: boolean;
  /** Plan variant: renders the day-count chip. */
  dayCount?: number;
  /** Full itinerary used by the Copy action on a plan card. */
  plan?: EditorialPlan;
  /** Set the photo credit as a row below the photograph instead of over it. */
  separateImageNote?: boolean;
  /** Partner label; mandatory when the placement is commercial. */
  partnerLabel?: string;
  /** Secondary booking action (card-action weight). */
  booking?: CardBooking;
  /** Internal action for entries without an external booking destination. */
  detailActionLabel?: string;
  /** Render the "+ Trip" affordance backed by the shared trip store. */
  trip?: boolean;
  /**
   * Render the card's actions (Save, + Trip, booking, detail link). Default
   * on. Set false where the surface is a pure way in (home rails): the whole
   * card is still the link.
   */
  actions?: boolean;
  /** Save metadata overrides. saveKind defaults from entityType. */
  saveKind?: SaveKind;
  saveSection?: string;
  saveDek?: string;
  /** Analytics context. */
  surface?: string;
  position?: number;
  /** Root element. Cards default to `li` (spec: card is an li in a list). */
  as?: 'li' | 'article' | 'div';
}

const {
  variant = 'venue',
  title,
  href,
  entityType,
  entitySlug,
  fieldPath = 'heroImage',
  imageEdit,
  suppressImageHydration = false,
  lockImageEditing = false,
  requireImageMetadata = false,
  preferAvif = false,
  imageSizes,
  image,
  verdict,
  meta = [],
  priceBand,
  freshness,
  freshnessKind = 'reviewed',
  typeMark,
  showEyebrow = true,
  mediaFallback = false,
  planningNote,
  eyebrow,
  byline,
  readTime,
  dateISO,
  showDate = true,
  dayCount,
  plan,
  separateImageNote = false,
  partnerLabel,
  booking,
  detailActionLabel,
  trip = false,
  actions = true,
  saveKind,
  saveSection,
  saveDek,
  surface,
  position,
  as: Tag = 'li',
} = Astro.props;

/* ---- content-rule guards (warn at build, never mutate copy) ---- */
if (title.length > 60) {
  console.warn(`[v5 Card] title over 60 chars (${title.length}): "${title.slice(0, 60)}..."`);
}
if (verdict && verdict.trim().split(/\s+/).length > 25) {
  console.warn(`[v5 Card] verdict over 25 words for "${entitySlug}"`);
}
if (meta.length > 3) {
  console.warn(`[v5 Card] more than 3 meta chips for "${entitySlug}"; rendering the first 3`);
}
if (/—/.test(`${title} ${verdict ?? ''} ${meta.join(' ')}`)) {
  console.warn(`[v5 Card] em-dash in card copy for "${entitySlug}" (house rule: none, ever)`);
}

const defaultMarks: Record<CardVariant, string> = {
  venue: 'Venue',
  'compact-row': '',
  event: 'Event',
  guide: 'Guide',
  plan: 'Plan',
  place: 'Place',
  article: 'Article',
};
const markText = eyebrow ?? typeMark ?? defaultMarks[variant];

/* priceBand -> band 1..4, rendered as glyph chip with accessible name */
const band =
  priceBand === undefined
    ? 0
    : Math.min(4, Math.max(1, typeof priceBand === 'number' ? priceBand : String(priceBand).trim().length));

const metaChips = meta.slice(0, 3);

/* Event date tile (day + short month) */
const eventDate =
  variant === 'event' && dateISO && showDate
    ? {
        day: new Date(dateISO).toLocaleDateString('en-AU', { day: 'numeric' }),
        month: new Date(dateISO).toLocaleDateString('en-AU', { month: 'short' }),
      }
    : null;

/* Article publish month for the byline row */
const articleDate =
  variant === 'article' && dateISO
    ? new Date(dateISO).toLocaleDateString('en-AU', { month: 'long', year: 'numeric' })
    : null;

const freshnessBase = freshness ? freshnessLabel(freshness) : null;
const freshnessText = freshnessKind === 'checked' ? freshnessBase?.replace('Reviewed ', 'Details checked ') : freshnessBase;

const isCompact = variant === 'compact-row';
const isEditorial = variant === 'article' || variant === 'guide';
const showMedia = !!image;
/* An image-bearing row asked for a slot this card has no photograph for:
   the card is set as type on paper, and the empty CMS slot is kept for
   editors only. */
const showSlot = !image && mediaFallback;
const textCard = showSlot && !isCompact;
const hasVerdictSlot = Astro.slots.has('verdict');

/* Save kind: entityType maps 1:1 except page/region, which are not saveable. */
const resolvedSaveKind: SaveKind | null =
  actions && (saveKind ?? (entityType !== 'page' && entityType !== 'region' ? (entityType as SaveKind) : null)) || null;
/* A plan's labelled "Copy this plan" stays in the action row. */
const forkPlan = variant === 'plan' && !!plan;
const saveOnImage = !!resolvedSaveKind && showMedia && !isCompact && !forkPlan;
const otherActions = actions && (trip || !!booking || !!detailActionLabel);
const saveInRow = !!resolvedSaveKind && !saveOnImage;
const hasActions = saveInRow || otherActions;
/* Save alone, no photograph: it sits at the top right of the text. */
const saveCorner = saveInRow && !otherActions && !isCompact && !forkPlan;

const creditLine = (credit: string) => {
  const clean = credit.trim().replace(/\.$/, '');
  return /^Courtesy of /i.test(clean)
    ? `Photo courtesy of ${clean.slice('Courtesy of '.length)}.`
    : /^(Photo|Illustration|Artwork)(?::|\s)/i.test(clean)
      ? `${clean}.`
      : `${/\b(?:illustration|artwork|drawing)\b/i.test(clean) ? 'Illustration' : 'Photo'}: ${clean}.`;
};
// Caption rule (lib/image-caption.mjs): artwork prints nothing.
const imageArtwork = isArtwork(image);
const imageCaption = imageArtwork ? '' : cleanCaption(image?.caption);
const imageCredit = !imageArtwork && image?.credit ? creditLine(image.credit) : '';
const hasNote = Boolean(imageCaption || imageCredit);
/* Compact rows keep their small credit beside the thumbnail; every other
   card lays it over the photograph's foot unless asked for a separate row. */
const noteOnImage = hasNote && showMedia && !isCompact && !separateImageNote;

const editAttrs = lockImageEditing ? {} : editableImage({
  entityType: imageEdit?.entityType ?? entityType,
  entitySlug: imageEdit?.entitySlug ?? entitySlug,
  fieldPath: imageEdit?.fieldPath ?? fieldPath,
  label: `${title} image`,
  purpose: 'card',
});

---

{/* `compact-row` is the primitive's `--compact` variant; the other six are
    content-type modifiers layered on the same base. */}
<Tag
  class:list={[
    'pi-card',
    isCompact ? 'pi-card--compact' : `pi-card--${variant}`,
    isEditorial && 'pi-card--editorial',
    lockImageEditing && 'pi-card--image-locked',
    textCard && 'pi-card--text',
    saveCorner && 'pi-card--save-corner',
  ]}
  data-variant={variant}
>
  {showMedia && (
    <div class="pi-card__media">
      <img
        data-pi-avif={preferAvif ? "true" : undefined}
        src={image!.src} data-pi-responsive={imageSizes ?? "(max-width: 767px) 100vw, (max-width: 1100px) 50vw, 33vw"}
        data-pi-no-hydrate={suppressImageHydration ? 'true' : undefined}
        data-pi-requires-image-metadata={requireImageMetadata ? 'true' : undefined}
        alt={image!.alt}
        loading="lazy"
        decoding="async"
        {...editAttrs}
      />
      {eventDate && (
        <span class="pi-card__date-block" aria-hidden="true">
          <span class="pi-card__date-day">{eventDate.day}</span>
          <span class="pi-card__date-month">{eventDate.month}</span>
        </span>
      )}
      {variant === 'event' && <slot name="badges" />}
      {noteOnImage && (
        <p class="pi-card__image-note pi-card__image-note--overlay">
          {imageCaption && <span>{imageCaption}</span>}
          {imageCaption && imageCredit && ' '}
          {imageCredit && <span class="pi-card__image-credit">{image?.sourceUrl ? <a href={image.sourceUrl}>{imageCredit}</a> : imageCredit}{image?.licenceUrl && <>{' · '}<a href={image.licenceUrl}>CC BY-SA 3.0 licence</a></>}{image?.changeNote && <>{' · '}{image.changeNote}</>}</span>}
        </p>
      )}
      {saveOnImage && resolvedSaveKind && <div class="pi-card__save"><SaveControl kind={resolvedSaveKind} slug={entitySlug} title={title} href={href} section={saveSection} dek={saveDek ?? verdict} imageUrl={image?.src} variant={forkPlan ? 'fork' : 'save'} plan={plan} labelled={false} /></div>}
    </div>
  )}

  {showSlot && (
    <div
      class="pi-card__media pi-card__media--plate"
      data-pi-no-hydrate={suppressImageHydration ? 'true' : undefined}
      data-pi-requires-image-metadata={requireImageMetadata ? 'true' : undefined}
      {...editAttrs}
    >
      <span class="pi-card__plate" aria-hidden="true"></span>
      {variant === 'event' && <slot name="badges" />}
    </div>
  )}

  {hasNote && showMedia && !isCompact && separateImageNote && (
    <p class="pi-card__image-note pi-card__image-note--separate">
      {imageCaption && <span>{imageCaption}</span>}
      {imageCaption && imageCredit && ' '}
      {imageCredit && <span class="pi-card__image-credit">{image?.sourceUrl ? <a href={image.sourceUrl}>{imageCredit}</a> : imageCredit}{image?.licenceUrl && <>{' · '}<a href={image.licenceUrl}>CC BY-SA 3.0 licence</a></>}{image?.changeNote && <>{' · '}{image.changeNote}</>}</span>}
    </p>
  )}

  <div class="pi-card__body">
    {hasNote && isCompact && showMedia && (
      <p class="pi-card__image-note">
        {imageCaption && <span>{imageCaption}</span>}
        {imageCaption && imageCredit && ' '}
        {imageCredit && <span class="pi-card__image-credit">{image?.sourceUrl ? <a href={image.sourceUrl}>{imageCredit}</a> : imageCredit}{image?.licenceUrl && <>{' · '}<a href={image.licenceUrl}>CC BY-SA 3.0 licence</a></>}{image?.changeNote && <>{' · '}{image.changeNote}</>}</span>}
      </p>
    )}
    {eventDate && !showMedia && <p class="pi-card__eyebrow pi-card__date-line">{eventDate.day} {eventDate.month}</p>}
    {showEyebrow && markText && <p class="pi-card__eyebrow">{markText}</p>}

    <h3 class="pi-card__title">
      <a
        href={href}
        class="pi-card__link"
        data-evt="card_click"
        data-entity-type={entityType}
        data-entity-slug={entitySlug}
        data-variant={variant}
        data-surface={surface}
        data-position={position}
      >
        {title}
      </a>
    </h3>

    {(hasVerdictSlot || verdict) && (
      <p class="pi-card__dek">
        <slot name="verdict">{verdict}</slot>
      </p>
    )}

    {variant === 'article' ? (
      <p class="pi-card__meta">
        <span class="pi-card__byline">{byline ?? 'Peninsula Insider'}</span>
        {articleDate && <><span class="pi-card__sep" aria-hidden="true">&middot;</span><span>{articleDate}</span></>}
        {readTime && <><span class="pi-card__sep" aria-hidden="true">&middot;</span><span>{readTime}</span></>}
        {partnerLabel && <><span class="pi-card__sep" aria-hidden="true">&middot;</span><span class="pi-card__partner">{partnerLabel}</span></>}
      </p>
    ) : (
      (metaChips.length > 0 || band > 0 || (variant === 'guide' && readTime) || (variant === 'plan' && dayCount) || planningNote || freshnessText || partnerLabel) && (
        <p class="pi-card__meta">
          {variant === 'plan' && dayCount && (
            <>
              <span class="pi-card__chip">{dayCount} {dayCount === 1 ? 'day' : 'days'}</span>
              {(metaChips.length > 0 || band > 0) && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
            </>
          )}
          {metaChips.map((chip, i) => (
            <>
              {i > 0 && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
              <span class="pi-card__chip">{chip}</span>
            </>
          ))}
          {band > 0 && (
            <>
              {metaChips.length > 0 && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
              <span class="pi-card__chip pi-card__chip--price" aria-label={`price band ${band} of 4`}>
                <span aria-hidden="true">{'$'.repeat(band)}</span>
              </span>
            </>
          )}
          {variant === 'guide' && readTime && (
            <>
              {(metaChips.length > 0 || band > 0) && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
              <span class="pi-card__chip">{readTime}</span>
            </>
          )}
          {planningNote && <>{(metaChips.length > 0 || band > 0) && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}<span class="pi-card__planning">{planningNote}</span></>}
          {freshnessText && <>{(metaChips.length > 0 || band > 0 || planningNote) && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}<span class="pi-card__provenance">{freshnessText}</span></>}
          {partnerLabel && <>{(metaChips.length > 0 || band > 0 || planningNote || freshnessText) && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}<span class="pi-card__partner">{partnerLabel}</span></>}
        </p>
      )
    )}
  </div>

  {hasActions && <div class:list={['pi-card__actions', saveCorner && 'pi-card__actions--corner']}>
    {saveInRow && resolvedSaveKind && <SaveControl kind={resolvedSaveKind} slug={entitySlug} title={title} href={href} section={saveSection} dek={saveDek ?? verdict} imageUrl={image?.src} variant={forkPlan ? 'fork' : 'save'} plan={plan} labelled={variant === 'plan'} />}
    {actions && trip && (
      <button
        type="button"
        class="pi-card__text-action"
        data-evt="trip_add"
        data-card-trip
        data-save-kind={resolvedSaveKind}
        data-entity-href={href}
        data-entity-type={entityType}
        data-entity-slug={entitySlug}
        data-entity-title={title}
        data-surface={surface}
        aria-label={`Add ${title} to trip`}
      >
        + Trip
      </button>
    )}
    {actions && detailActionLabel && (
      <a href={href} class="pi-card__text-action pi-card__detail-action" aria-label={`${detailActionLabel} for ${title}`}
        data-evt="card_click" data-entity-type={entityType} data-entity-slug={entitySlug}
        data-variant={variant} data-surface={surface} data-position={position}>
        {detailActionLabel} <span aria-hidden="true">&rarr;</span>
      </a>
    )}
    {actions && booking && (
      <BookingControl
        url={booking.url}
        label={booking.label}
        venueName={booking.venueName ?? title}
        partnerLabel={booking.partnerLabel}
        variant="card-action"
        entityType={entityType}
        entitySlug={entitySlug}
        surface={surface}
      />
    )}
  </div>}
</Tag>

<script>
  import { tripAdd, tripEntries, SAVE_KINDS, type SaveKind } from '../../lib/v5-store';

  function syncTripButtons() {
    const entries = new Set(tripEntries().filter((entry) => entry.kind && entry.slug).map((entry) => entry.kind + '/' + entry.slug));
    document.querySelectorAll<HTMLButtonElement>('[data-card-trip]').forEach((button) => {
      const { entitySlug: slug, entityTitle: title, saveKind } = button.dataset;
      if (!slug || !title || !saveKind) return;
      const included = entries.has(saveKind + '/' + slug);
      button.textContent = included ? 'In trip' : '+ Trip';
      button.setAttribute('aria-label', included ? title + ' is in your trip' : 'Add ' + title + ' to trip');
    });
  }

  syncTripButtons();
  document.addEventListener('astro:page-load', syncTripButtons);
  window.addEventListener('pi:store-changed', (event) => {
    if ((event as CustomEvent<{ scope?: string }>).detail?.scope === 'trip') syncTripButtons();
  });

  // Delegation survives Astro navigation and also covers cards on the home/hubs.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-card-trip]');
    if (!button) return;
    const { entitySlug: slug, entityTitle: title, entityHref: href, saveKind } = button.dataset;
    if (!slug || !title || !href || !SAVE_KINDS.includes(saveKind as SaveKind)) return;
    if (!tripEntries().some((entry) => entry.kind === saveKind && entry.slug === slug)) {
      // null means the write did not land (private mode / quota). Do not
      // paint "In trip" for a stop that is not in the trip.
      if (!tripAdd({ kind: saveKind as SaveKind, slug, title, href })) {
        button.textContent = 'Not added';
        setTimeout(syncTripButtons, 2000);
        return;
      }
    }
    syncTripButtons();
  });
</script>

<style>
  /* Frame, ground, body rhythm and the type scale come from .pi-card in
     primitives.css (no fill, no frame, text flush with the photograph).
     Only what is specific to this component lives here. */
  .pi-card { list-style: none; }
  /* refinement.css (body[data-v4]) still carries the older card scale
     (26px titles, 13px meta). The doubled class keeps the one scale here:
     21px card title, 26px on a text card, 15px meta. */
  .pi-card.pi-card:not(.pi-card--compact) .pi-card__title { font-size: var(--fs-500); line-height: 1.25; }
  .pi-card.pi-card.pi-card--text .pi-card__title { font-size: var(--fs-600); }
  .pi-card.pi-card .pi-card__meta { font-size: var(--fs-300); line-height: var(--lh-ui); }

  /* Focus: one ring around the whole card, not a box round the title text. */
  .pi-card:has(.pi-card__link:focus-visible) {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 4px;
    border-radius: var(--radius-s);
  }
  .pi-card__link { color: inherit; text-decoration: none; transition: color var(--dur-fast) var(--ease-enter); }
  .pi-card__link:focus-visible,
  .pi-card.pi-card .pi-card__link:focus-visible::after { outline: none; }
  .pi-card:hover .pi-card__link { color: var(--accent); }
  /* Stretched link: the whole card navigates; actions sit above it. */
  .pi-card__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }

  .pi-card__media img { transition: transform var(--dur-slow) var(--ease-enter); }
  .pi-card:hover .pi-card__media img { transform: scale(1.02); }

  /* Credit: one quiet line over the photograph's foot, on its own scrim. */
  .pi-card__image-note { margin: 0; font-size: var(--fs-100); line-height: 1.4; color: var(--soft); }
  .pi-card__image-credit a { position: relative; z-index: 2; color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .pi-card__image-credit a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .pi-card__image-note--overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-6) var(--space-3) var(--space-2);
    background: linear-gradient(to top, rgba(12, 28, 40, 0.8), rgba(12, 28, 40, 0));
    color: #fff;
    text-wrap: pretty;
  }
  .pi-card__image-note--separate { padding-top: var(--space-2); }

  /* Save: a small icon on the photograph's corner, or the text's top right. */
  .pi-card__actions { position: relative; z-index: 2; }
