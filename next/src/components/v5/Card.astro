---
/**
 * Card (v5) - THE one card primitive (component spec 2.15).
 *
 * Seven variants, one anatomy: media / type-mark / title / verdict / meta /
 * provenance / actions / stretched link. Replaces VenueCard, PlaceCard,
 * EventCard, ArticleCard, ItineraryCard, PlanCard, TourCard and friends as
 * pages migrate (page agents do the swapping; this file is the target).
 *
 * Content rules enforced here (spec 0.1): title <= 60 chars, verdict <= 25
 * words, meta <= 3 chips, no prices of any kind (no dollar figures, no
 * price-band glyphs), no em-dashes. Violations warn at build time so page
 * agents catch them.
 *
 * A11y contract:
 *  - Root is an `li` by default (cards live in labelled lists); use
 *    `as="article"` for standalone placements.
 *  - The title anchor is the ONLY link; a ::after stretches it over the
 *    card. SaveControl / trip / booking sit in an actions layer ABOVE the
 *    stretched link and are never nested inside it.
 *  - Verdict is a <p> in the Critic voice style, never a heading.
 *  - Save target >= 48px; focus-visible ring on the link.
 *
 * Actions (one pair everywhere): a 48px circular Save bookmark, then a 48px,
 * 8px-radius "Add to trip" ghost button, then any booking CTA at the same
 * height. The row starts on the body's text inset. Article and guide cards
 * carry only the bookmark, on the meta line, never on a row of its own.
 *
 * Analytics: link carries data-evt="card_click" plus entity attrs; the
 * "Add to trip" affordance carries data-evt="trip_add" and writes to the
 * shared trip store on every surface, with visible confirmation.
 */
import { editableImage, type CmsEntityType } from '../../lib/inline-edit/attrs';
import { freshnessLabel } from '../../lib/freshness';
import SaveControl from './SaveControl.astro';
import BookingControl from './BookingControl.astro';

export type CardVariant = 'venue' | 'compact-row' | 'event' | 'guide' | 'plan' | 'place' | 'article';

export interface CardImage {
  src: string;
  alt: string;
  /**
   * Image note. Never printed above the title. The reader disclosure
   * ('Illustrative image') joins the provenance line under the meta; the
   * internal QA status ('Image subject unverified') is never shown, because
   * lib/media-provenance renders silence for an unverified image.
   */
  caption?: string;
}

export interface CardBooking {
  url: string;
  label?: string;
  venueName?: string;
  partnerLabel?: string;
}

/** Save kinds accepted by the pi:saves:v2 store. */
type SaveKind = 'article' | 'venue' | 'place' | 'event' | 'experience' | 'itinerary' | 'tour' | 'tour-operator' | 'tour-package';

export interface Props {
  variant?: CardVariant;
  title: string;
  href: string;
  /** CMS identity for the editable media slot (cms-architecture Rule 1). */
  entityType: CmsEntityType;
  entitySlug: string;
  /** Defaults to 'heroImage', the live convention across card surfaces. */
  fieldPath?: string;
  /** Omit for text-only compact rows (enforcer HERO_EXEMPT case). */
  image?: CardImage;
  /** Verdict line <= 25 words. The named slot `verdict` overrides this. */
  verdict?: string;
  /** Up to 3 plain-text chips, joined with a middot separator. */
  meta?: string[];
  /** Accepted for facets; never rendered (no prices anywhere). */
  priceBand?: string | number;
  /** ISO date; rendered through freshnessLabel() ("Reviewed May 2026"). */
  freshness?: string;
  freshnessKind?: 'reviewed' | 'checked';
  /** Entity label eyebrow; defaults per variant (Venue/Event/Guide/...). */
  typeMark?: string;
  /**
   * Render the type eyebrow. Set false from a section whose heading already
   * declares the type ("This weekend" over three event cards stamped EVENT).
   * The card stays reusable: in a mixed grid the label still carries
   * information, so the default is on and the parent opts out.
   */
  showEyebrow?: boolean;
  /**
   * Render a typographic plate in place of the media block when no image is
   * supplied. Set true from image-bearing grids so one entry missing a photo
   * does not open a hole in the row. Compact rows take a small paper tile
   * with the PI monogram instead, so their titles stay on the list's text
   * line. Leave false for sets that are text-only by design (guide rails, an
   * all-text directory), where a plate would be noise.
   */
  mediaFallback?: boolean;
  /** Region eyebrow for the place variant (replaces typeMark when set). */
  eyebrow?: string;
  /** Article variant: byline (falls back to "Peninsula Insider"). */
  byline?: string;
  /** Article/guide variants: e.g. "7 min read". */
  readTime?: string;
  /** Event start date or article publish date, ISO. */
  dateISO?: string;
  /** Plan variant: renders the day-count chip. */
  dayCount?: number;
  /** Partner label; mandatory when the placement is commercial. */
  partnerLabel?: string;
  /** Secondary booking action (card-action weight). */
  booking?: CardBooking;
  /**
   * Hold an empty booking-width slot when `booking` is absent. Set from a
   * list whose other rows carry booking, so the bookmark and trip button
   * never change position from row to row.
   */
  reserveBooking?: boolean;
  /** Render the "Add to trip" affordance backed by the shared trip store. */
  trip?: boolean;
  /** Save metadata overrides. saveKind defaults from entityType. */
  saveKind?: SaveKind;
  saveSection?: string;
  saveDek?: string;
  /** Analytics context. */
  surface?: string;
  position?: number;
  /** Root element. Cards default to `li` (spec: card is an li in a list). */
  as?: 'li' | 'article' | 'div';
}

const {
  variant = 'venue',
  title,
  href,
  entityType,
  entitySlug,
  fieldPath = 'heroImage',
  image,
  verdict,
  meta = [],
  freshness,
  freshnessKind = 'reviewed',
  typeMark,
  showEyebrow = true,
  mediaFallback = false,
  eyebrow,
  byline,
  readTime,
  dateISO,
  dayCount,
  partnerLabel,
  booking,
  reserveBooking = false,
  trip = false,
  saveKind,
  saveSection,
  saveDek,
  surface,
  position,
  as: Tag = 'li',
} = Astro.props;

/* ---- content-rule guards (warn at build, never mutate copy) ---- */
if (title.length > 60) {
  console.warn(`[v5 Card] title over 60 chars (${title.length}): "${title.slice(0, 60)}..."`);
}
if (verdict && verdict.trim().split(/\s+/).length > 25) {
  console.warn(`[v5 Card] verdict over 25 words for "${entitySlug}"`);
}
if (meta.length > 3) {
  console.warn(`[v5 Card] more than 3 meta chips for "${entitySlug}"; rendering the first 3`);
}
if (/\u2014/.test(`${title} ${verdict ?? ''} ${meta.join(' ')}`)) {
  console.warn(`[v5 Card] em-dash in card copy for "${entitySlug}" (house rule: none, ever)`);
}

const defaultMarks: Record<CardVariant, string> = {
  venue: 'Venue',
  'compact-row': '',
  event: 'Event',
  guide: 'Guide',
  plan: 'Plan',
  place: 'Place',
  article: 'Article',
};
const markText = eyebrow ?? typeMark ?? defaultMarks[variant];

/* priceBand is deliberately not read: pages pass it for facets, and the card
   never renders a price signal of any kind. */

const metaChips = meta.slice(0, 3);

/* Plan duration chip. Built as one string so the number and unit can never
   render as "3days", and skipped when a chip already states the length. */
const durationChip =
  variant === 'plan' && dayCount && !metaChips.some((chip) => /\b(day|night)s?\b/i.test(chip))
    ? `${dayCount} ${dayCount === 1 ? 'day' : 'days'}`
    : null;

/* Guide cards also carry the read time as a chip. */
const trailingChip = variant === 'guide' && readTime ? readTime : null;

/* Image note: the reader disclosure only. The QA status is internal and
   stays out of the render (lib/media-provenance: unverified renders
   silence). The disclosure sits in the provenance line, not above the
   eyebrow, so every card in a row starts its text at the same offset. */
const imageNote = image?.caption && !/unverified/i.test(image.caption) ? image.caption : null;

/* Event date block (day + short month) */
const eventDate =
  variant === 'event' && dateISO
    ? {
        day: new Date(dateISO).toLocaleDateString('en-AU', { day: 'numeric' }),
        month: new Date(dateISO).toLocaleDateString('en-AU', { month: 'short' }),
      }
    : null;

/* Article publish month for the byline row */
const articleDate =
  variant === 'article' && dateISO
    ? new Date(dateISO).toLocaleDateString('en-AU', { month: 'long', year: 'numeric' })
    : null;

const freshnessBase = freshness ? freshnessLabel(freshness) : null;
const freshnessText = freshnessKind === 'checked' ? freshnessBase?.replace('Reviewed ', 'Details checked ') : freshnessBase;

const isEditorial = variant === 'article' || variant === 'guide';
const isCompact = variant === 'compact-row';
const showMedia = !!image;
/* No photo, but the row around this card has them: draw the house plate so
   the card keeps its media height and the grid stays level. A compact row
   takes the small paper monogram tile instead of the full plate. */
const showPlate = !image && mediaFallback && !isCompact;
const showTile = !image && mediaFallback && isCompact;
const hasMediaSlot = showMedia || showPlate || showTile;
const hasVerdictSlot = Astro.slots.has('verdict');

/* Save kind: entityType maps 1:1 except page/region, which are not saveable. */
const resolvedSaveKind: SaveKind | null =
  saveKind ?? (entityType !== 'page' && entityType !== 'region' ? (entityType as SaveKind) : null);

/* Editorial cards keep the bookmark on the meta line: a lone 48px circle on
   a row of its own read as an orphaned control under every journal card. */
const inlineSave = isEditorial && !!resolvedSaveKind && !trip && !booking;
const showBookingSlot = !booking && reserveBooking;
const hasActions = (!inlineSave && !!resolvedSaveKind) || trip || !!booking || showBookingSlot;

/* Guide cards without a picture are text links on a band; the trailing
   arrow is their link affordance. */
const showGuideArrow = variant === 'guide' && !hasMediaSlot;

const hasMeta =
  variant === 'article' || metaChips.length > 0 || !!durationChip || !!trailingChip || inlineSave;
const hasProvenance = !!(freshnessText || imageNote || partnerLabel);

const saveProps = resolvedSaveKind
  ? {
      kind: resolvedSaveKind,
      slug: entitySlug,
      title,
      href,
      section: saveSection,
      dek: saveDek ?? verdict,
      imageUrl: image?.src,
      variant: variant === 'plan' ? ('fork' as const) : ('save' as const),
      labelled: variant === 'plan',
    }
  : null;
---

{/* `compact-row` is the primitive's `--compact` variant; the other six are
    content-type modifiers layered on the same base. */}
<Tag
  class:list={[
    'pi-card',
    variant === 'compact-row' ? 'pi-card--compact' : `pi-card--${variant}`,
    isEditorial && 'pi-card--editorial',
    !hasMediaSlot && 'pi-card--no-media',
  ]}
  data-variant={variant}
>
  {showMedia && (
    <div class="pi-card__media">
      <img
        src={image!.src}
        data-pi-responsive={isCompact ? '(max-width: 767px) 88px, 120px' : '(max-width: 767px) 100vw, (max-width: 1100px) 50vw, 33vw'}
        alt={image!.alt}
        loading="lazy"
        decoding="async"
        {...editableImage({
          entityType,
          entitySlug,
          fieldPath,
          label: `${title} image`,
          purpose: 'card',
        })}
      />
      {eventDate && (
        <span class="pi-card__date-block" aria-hidden="true">
          <span class="pi-card__date-day">{eventDate.day}</span>
          <span class="pi-card__date-month">{eventDate.month}</span>
        </span>
      )}
      {variant === 'event' && <slot name="badges" />}
    </div>
  )}

  {showPlate && (
    <div class="pi-card__media pi-card__media--plate">
      <span class="pi-card__plate" aria-hidden="true">
        <span class="pi-card__plate-rule"></span>
        <span class="pi-card__plate-mark">Peninsula Insider</span>
      </span>
      {eventDate && (
        <span class="pi-card__date-block" aria-hidden="true">
          <span class="pi-card__date-day">{eventDate.day}</span>
          <span class="pi-card__date-month">{eventDate.month}</span>
        </span>
      )}
      {variant === 'event' && <slot name="badges" />}
    </div>
  )}

  {showTile && (
    <div class="pi-card__media pi-card__media--tile" aria-hidden="true">
      <span class="pi-card__tile-rule"></span>
      <span class="pi-card__tile-mark">PI</span>
    </div>
  )}

  <div class="pi-card__body">
    {showEyebrow && markText && <p class="pi-card__eyebrow">{markText}</p>}

    <h3 class="pi-card__title">
      <a
        href={href}
        class="pi-card__link"
        data-evt="card_click"
        data-entity-type={entityType}
        data-entity-slug={entitySlug}
        data-variant={variant}
        data-surface={surface}
        data-position={position}
      >
        {title}{showGuideArrow && <span class="pi-card__arrow" aria-hidden="true">&nbsp;&rarr;</span>}
      </a>
    </h3>

    {(hasVerdictSlot || verdict) && (
      <p class="pi-card__dek">
        <slot name="verdict">{verdict}</slot>
      </p>
    )}

    {/* Meta: one list, every token a non-breaking li whose separator is its
        own ::before, so a line can never start or end on a stranded dot. */}
    {hasMeta && (
      <ul class="pi-card__meta" role="list">
        {variant === 'article' ? (
          <>
            <li class="pi-card__chip pi-card__byline">{byline ?? 'Peninsula Insider'}</li>
            {articleDate && <li class="pi-card__chip">{articleDate}</li>}
            {readTime && <li class="pi-card__chip">{readTime}</li>}
          </>
        ) : (
          <>
            {durationChip && <li class="pi-card__chip">{durationChip}</li>}
            {metaChips.map((chip) => <li class="pi-card__chip">{chip}</li>)}
            {trailingChip && <li class="pi-card__chip">{trailingChip}</li>}
          </>
        )}
        {inlineSave && saveProps && (
          <li class="pi-card__meta-save">
            <SaveControl {...saveProps} />
          </li>
        )}
      </ul>
    )}

    {hasProvenance && (
      <ul class="pi-card__provenance" role="list">
        {freshnessText && <li class="pi-card__chip">{freshnessText}</li>}
        {imageNote && <li class="pi-card__chip">{imageNote}</li>}
        {partnerLabel && <li class="pi-card__chip pi-card__partner">{partnerLabel}</li>}
      </ul>
    )}
  </div>

  {hasActions && <div class="pi-card__actions">
    {!inlineSave && saveProps && <SaveControl {...saveProps} />}
    {trip && (
      <button
        type="button"
        class="pi-card__trip"
        data-evt="trip_add"
        data-card-trip
        data-save-kind={resolvedSaveKind}
        data-entity-href={href}
        data-entity-type={entityType}
        data-entity-slug={entitySlug}
        data-entity-title={title}
        data-surface={surface}
        aria-label={`Add to trip: ${title}`}
      >
        Add to trip
      </button>
    )}
    {booking && (
      <BookingControl
        url={booking.url}
        label={booking.label}
        venueName={booking.venueName ?? title}
        partnerLabel={booking.partnerLabel}
        variant="card-action"
        entityType={entityType}
        entitySlug={entitySlug}
        surface={surface}
      />
    )}
    {showBookingSlot && <span class="pi-card__booking-slot" aria-hidden="true"></span>}
  </div>}
</Tag>

<script>
  import { tripAdd, tripEntries, SAVE_KINDS, type SaveKind } from '../../lib/v5-store';

  // Delegation survives Astro navigation and also covers cards on the home/hubs.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-card-trip]');
    if (!button) return;
    const { entitySlug: slug, entityTitle: title, entityHref: href, saveKind } = button.dataset;
    if (!slug || !title || !href || !SAVE_KINDS.includes(saveKind as SaveKind)) return;
    if (!tripEntries().some((entry) => entry.kind === saveKind && entry.slug === slug)) {
      // null means the write did not land (private mode / quota). Do not
      // paint "In trip" for a stop that is not in the trip.
      if (!tripAdd({ kind: saveKind as SaveKind, slug, title, href })) {
        const previous = button.textContent;
        button.textContent = 'Not added';
        setTimeout(() => { button.textContent = previous; }, 2000);
        return;
      }
    }
    button.textContent = 'In trip';
    button.setAttribute('aria-label', `In trip: ${title}`);
  });
</script>

<style>
  /* Only what the shared primitive does NOT provide lives here.
     Ground, hairline, radius, body/eyebrow/title/dek/meta typography,
     the two-line dek clamp and the --compact row direction all come from
     .pi-card in primitives.css. Deleting the local copies is the point:
     the card had been re-declaring the frame it was already inheriting,
     including a resting/hover box-shadow that contradicts the primitive's
     deliberate no-shadow rule. */

  /* Hover: the primitive shifts the hairline; the media and the title
     respond too, which is specific to this card having a photograph. */
  .pi-card:hover .pi-card__media img {
    transform: scale(1.03);
  }
  .pi-card:hover .pi-card__link {
    color: var(--accent);
  }
  /* This card family runs 3/2, unlike the converted page cards the
     primitive defaults to (16/10). Stated explicitly rather than
     inherited so the two cannot drift apart again silently. */
  .pi-card__media {
    aspect-ratio: 3 / 2;
  }
  .pi-card__media img {
    transition: transform var(--dur-slow) var(--ease-enter);
  }

  /* Cards are list items by default, so the marker has to go. */
  .pi-card {
    list-style: none;
  }

  /* ---- media fallback: the house plate ----
     A card with no photograph used to render a blank slot inside an
     image-bearing row. Instead we set the masthead on the signature
     evergreen ground, at exactly the media block's 3:2 ratio, so the grid
     stays level and the absence reads as a deliberate typographic tile.
     Colour is tokens only: --bg-dark ground, --white type (about 13:1),
     rule at 42% white (decorative, not text). No placeholder photography. */
  .pi-card__media--plate {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background: var(--bg-dark);
  }

  .pi-card__plate {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
  }

  .pi-card__plate-rule {
    display: block;
    width: 2.25rem;
    height: 2px;
    background: var(--sage);
  }

  .pi-card__plate-mark {
    display: block;
    max-width: 7ch;
    font-family: var(--font-display);
    font-size: var(--fs-600);
    font-weight: var(--fw-display);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--white);
  }

  .pi-card__date-block {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 2.75rem;
    padding: 0.3rem 0.45rem;
    background: var(--white);
    border-radius: var(--radius-s);
    font-family: var(--font-ui);
    line-height: var(--lh-label);
  }
  .pi-card__date-day {
    font-size: var(--fs-500);
    font-weight: var(--fw-bold);
    color: var(--text);
  }
  .pi-card__date-month {
    font-size: var(--fs-100);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--teal-text);
  }

  /* The eyebrow is the entity type mark, so it takes the teal the rest of
     the masthead uses for entity labels rather than the primitive's --soft. */
  .pi-card__eyebrow {
    color: var(--teal-text);
  }

  .pi-card__link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-enter);
  }
  /* Stretched link: whole card navigates; actions layer sits above. */
  .pi-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pi-card__link:focus-visible {
    outline: var(--focus-ring);
    /* Inset ring: the card clips overflow, so a positive offset would hide
       the focus outline at the card edge. Draw it just inside instead. */
    outline-offset: -3px;
  }
  /* Guide cards with no picture: the arrow is the link affordance. It
     travels with the last word, so it never wraps onto a line alone. */
  .pi-card__arrow {
    color: var(--sand-text);
    white-space: nowrap;
  }

  /* The verdict is this masthead's product line, so it runs one step up
     from the primitive's dek and in the UI face at medium weight. */
  .pi-card__dek {
    font-size: var(--fs-500);
    font-weight: var(--fw-medium);
  }

  /* ---- meta line: the canonical token list (C4) ----
     Every token is an li that never breaks internally; the separator is the
     token's own ::before, so it wraps with its token and a line can never
     start or end on a stranded dot. A dot with 0.5em either side, fs-200,
     --soft text. WhatsOnRow draws the same tokens. The line sits a fixed
     12px under the dek (the body's 8px gap plus 4px) instead of the
     primitive's margin-top:auto, so equal-height cards collect spare height
     below the meta, never in a hollow above it. */
  .pi-card__meta,
  .pi-card__provenance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5em;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-200);
    line-height: var(--lh-ui);
    color: var(--soft);
  }
  .pi-card__meta {
    margin-top: var(--space-1);
  }
  .pi-card__chip {
    white-space: nowrap;
  }
  .pi-card__chip + .pi-card__chip::before {
    content: '\00B7';
    content: '\00B7' / '';
    margin-right: 0.5em;
    color: var(--border-strong);
  }
  /* Provenance (check date, image disclosure, partner) is a second token
     line with the same grammar; it never pins. */
  .pi-card__partner {
    text-transform: uppercase;
    font-size: var(--fs-100);
    letter-spacing: var(--ls-eyebrow);
    color: var(--teal-text);
  }
  /* Editorial cards: the bookmark closes the meta line, right-aligned, and
     sits above the stretched link like the actions row does. */
  .pi-card__meta-save {
    position: relative;
    z-index: 2;
    margin-left: auto;
    padding-left: var(--space-3);
  }

  /* ---- actions: the one card action pair (C5) ----
     Actions sit outside __body, above the stretched link, so they take the
     body's 16px inset (the bookmark's left edge lands on the text edge) and
     a stacking context of their own. Buttons are top-aligned, so a booking
     note under one button never lifts it off its neighbours' line. */
  .pi-card__actions {
    position: relative;
    z-index: 2;
    align-items: flex-start;
    gap: var(--space-3);
    padding: 0 var(--space-4) var(--space-4);
  }
  .pi-card__trip {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    font-family: var(--font-ui);
    font-size: var(--fs-300);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-ui);
    color: var(--harbour);
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-enter),
      color var(--dur-fast) var(--ease-enter);
  }
  .pi-card__trip:hover {
    border-color: var(--harbour);
    color: var(--harbour-h);
  }
  .pi-card__trip:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  /* Held open when a sibling row has a booking link and this one does not,
     so the bookmark and trip button keep their x position. Matches the
     card-action BookingControl width (--booking-slot). */
  .pi-card__booking-slot {
    display: block;
    min-width: var(--booking-slot, 13rem);
    min-height: 48px;
  }

  /* ---- variant: compact (directory row) ----
     The primitive's --compact is a horizontal media card. This surface uses
     it as a directory list row, read left to right as
       thumb (120x90) | text (up to 62ch) | actions
     with the actions directly after the text rather than pinned to the far
     edge of the frame. The row draws no frame and no rule of its own: the
     list that holds it owns the single divider (DirectoryRows, CardGrid
     rows), which is what ended the doubled hairline between rows.
     Selectors repeat the block class so they beat the primitive regardless
     of bundle order. */
  .pi-card.pi-card--compact {
    display: grid;
    grid-template-columns: 120px minmax(0, 62ch) auto;
    justify-content: start;
    align-items: start;
    column-gap: var(--space-5);
    border: 0;
    border-radius: 0;
    overflow: visible;
    padding: 0;
    background: none;
  }
  .pi-card.pi-card--compact.pi-card--no-media {
    grid-template-columns: minmax(0, 62ch) auto;
  }
  .pi-card.pi-card--compact .pi-card__media {
    grid-column: 1;
    grid-row: 1;
    width: 120px;
    height: 90px;
    max-width: none;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-m);
  }
  .pi-card.pi-card--compact .pi-card__body {
    grid-column: 2;
    grid-row: 1;
    gap: var(--space-1);
    padding: 0;
  }
  .pi-card.pi-card--compact.pi-card--no-media .pi-card__body {
    grid-column: 1;
  }
  .pi-card.pi-card--compact .pi-card__title {
    font-size: var(--fs-500);
    line-height: 1.25;
  }
  /* The whole verdict, no clamp: a row has the width to show it. */
  .pi-card.pi-card--compact .pi-card__dek {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: none;
    overflow: visible;
    min-height: 0;
    max-width: 62ch;
    font-size: var(--fs-300);
    font-weight: var(--fw-body);
    line-height: var(--lh-dek);
    text-wrap: pretty;
  }
  .pi-card.pi-card--compact .pi-card__meta {
    margin-top: var(--space-1);
  }
  .pi-card.pi-card--compact .pi-card__actions {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    margin: 0;
    padding: 2px 0 0;
    flex-wrap: nowrap;
  }
  .pi-card.pi-card--compact.pi-card--no-media .pi-card__actions {
    grid-column: 2;
  }

  /* No photo in a list that has them: a paper tile with the PI monogram
     holds the thumb slot, so this row's title stays on the list's text line. */
  .pi-card__media--tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--paper-warm);
    border: 1px solid var(--border);
  }
  .pi-card__tile-rule {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--bronze);
  }
  .pi-card__tile-mark {
    font-family: var(--font-display);
    font-size: var(--fs-400);
    font-weight: var(--fw-display);
    line-height: 1;
    letter-spacing: var(--ls-display);
    color: var(--harbour-deep);
  }

  /* Tablet: the text keeps its width and the actions move under it. */
  @media (max-width: 63.99em) {
    .pi-card.pi-card--compact {
      grid-template-columns: 120px minmax(0, 1fr);
    }
    .pi-card.pi-card--compact.pi-card--no-media {
      grid-template-columns: minmax(0, 1fr);
    }
    .pi-card.pi-card--compact .pi-card__actions,
    .pi-card.pi-card--compact.pi-card--no-media .pi-card__actions {
      grid-column: 2;
      grid-row: 2;
      flex-wrap: wrap;
      padding-top: var(--space-3);
    }
    .pi-card.pi-card--compact.pi-card--no-media .pi-card__actions {
      grid-column: 1;
    }
  }

  /* Phone: an 88x66 thumb beside the text, then a full-width action bar
     (bookmark on the left, a booking button flexed to fill). */
  @media (max-width: 47.99em) {
    .pi-card.pi-card--compact {
      grid-template-columns: 88px minmax(0, 1fr);
      column-gap: var(--space-4);
    }
    .pi-card.pi-card--compact .pi-card__media {
      width: 88px;
      height: 66px;
    }
    .pi-card.pi-card--compact .pi-card__title {
      font-size: var(--fs-400);
    }
    .pi-card.pi-card--compact .pi-card__actions {
      grid-column: 1 / -1;
      padding-top: var(--space-3);
    }
    /* Fills the bar when it fits beside the pair; on a narrow phone it takes
       its own full-width line under them rather than squeezing its label. */
    .pi-card.pi-card--compact .pi-card__actions > :global(.v5-booking) {
      flex: 1 1 var(--booking-slot, 13rem);
    }
    .pi-card.pi-card--compact .pi-card__booking-slot {
      display: none;
    }
  }

  /* ---- variant: place (region eyebrow, evergreen to distinguish) ---- */
  .pi-card--place .pi-card__eyebrow {
    color: var(--accent);
  }

  /* ---- variants: article + guide (editorial surface, HUB-08 fix) ----
     Paper card, hairline and 16px radius on any band. The old sea-fog
     surface matched the bands these cards sit on (JournalModule, the
     best-of rails), so the card vanished while its 16px padding stayed,
     leaving titles floating inset from the section edge. An article still
     never wears venue clothing: no chips, no trip or booking actions. */
  .pi-card--editorial {
    background: var(--white);
    border-color: var(--border);
  }
  .pi-card--article .pi-card__byline {
    font-weight: var(--fw-semibold);
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-card__media img {
      transition: none;
    }
    .pi-card:hover .pi-card__media img {
      transform: none;
    }
  }
</style>
