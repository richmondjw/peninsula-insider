---
/**
 * Card (v5) - THE one card primitive (component spec 2.15).
 *
 * Seven variants, one anatomy: media / type-mark / title / verdict / meta /
 * provenance / actions / stretched link. Replaces VenueCard, PlaceCard,
 * EventCard, ArticleCard, ItineraryCard, PlanCard, TourCard and friends as
 * pages migrate (page agents do the swapping; this file is the target).
 *
 * Content rules enforced here (spec 0.1): title <= 60 chars, verdict <= 25
 * words, meta <= 3 chips, priceBand chips only (never dollar figures),
 * no em-dashes. Violations warn at build time so page agents catch them.
 *
 * A11y contract:
 *  - Root is an `li` by default (cards live in labelled lists); use
 *    `as="article"` for standalone placements.
 *  - The title anchor is the ONLY link; a ::after stretches it over the
 *    card. SaveControl / trip / booking sit in an actions layer ABOVE the
 *    stretched link and are never nested inside it.
 *  - Verdict is a <p> in the Critic voice style, never a heading.
 *  - Save target >= 48px; focus-visible ring on the link.
 *
 * Analytics: link carries data-evt="card_click" plus entity attrs; the
 * "+ Trip" affordance carries data-evt="trip_add" (behaviour is wired by
 * the store agent later, the event fires from day one via v5-analytics).
 */
import { editableImage, type CmsEntityType } from '../../lib/inline-edit/attrs';
import { freshnessLabel } from '../../lib/freshness';
import SaveControl from './SaveControl.astro';
import BookingControl from './BookingControl.astro';

export type CardVariant = 'venue' | 'compact-row' | 'event' | 'guide' | 'plan' | 'place' | 'article';

export interface CardImage {
  src: string;
  alt: string;
}

export interface CardBooking {
  url: string;
  label?: string;
  venueName?: string;
  partnerLabel?: string;
}

/** Save kinds accepted by the pi:saves:v2 store. */
type SaveKind = 'article' | 'venue' | 'place' | 'event' | 'experience' | 'itinerary' | 'tour' | 'tour-operator' | 'tour-package';

export interface Props {
  variant?: CardVariant;
  title: string;
  href: string;
  /** CMS identity for the editable media slot (cms-architecture Rule 1). */
  entityType: CmsEntityType;
  entitySlug: string;
  /** Defaults to 'heroImage', the live convention across card surfaces. */
  fieldPath?: string;
  /** Omit for text-only compact rows (enforcer HERO_EXEMPT case). */
  image?: CardImage;
  /** Verdict line <= 25 words. The named slot `verdict` overrides this. */
  verdict?: string;
  /** Up to 3 plain-text chips, joined with a middot separator. */
  meta?: string[];
  /** '$'..'$$$$' or 1..4. Rendered as a band chip, never a dollar figure. */
  priceBand?: string | number;
  /** ISO date; rendered through freshnessLabel() ("Reviewed May 2026"). */
  freshness?: string;
  /** Entity label eyebrow; defaults per variant (Venue/Event/Guide/...). */
  typeMark?: string;
  /**
   * Render the type eyebrow. Set false from a section whose heading already
   * declares the type ("This weekend" over three event cards stamped EVENT).
   * The card stays reusable: in a mixed grid the label still carries
   * information, so the default is on and the parent opts out.
   */
  showEyebrow?: boolean;
  /**
   * Render a typographic plate in place of the media block when no image is
   * supplied. Set true from image-bearing grids so one entry missing a photo
   * does not open a hole in the row. Leave false for grids that are text-only
   * by design (guide rails, compact rows), where a plate would be noise.
   */
  mediaFallback?: boolean;
  /** Region eyebrow for the place variant (replaces typeMark when set). */
  eyebrow?: string;
  /** Article variant: byline (falls back to "Peninsula Insider"). */
  byline?: string;
  /** Article/guide variants: e.g. "7 min read". */
  readTime?: string;
  /** Event start date or article publish date, ISO. */
  dateISO?: string;
  /** Plan variant: renders the day-count chip. */
  dayCount?: number;
  /** Partner label; mandatory when the placement is commercial. */
  partnerLabel?: string;
  /** Secondary booking action (card-action weight). */
  booking?: CardBooking;
  /** Render the "+ Trip" affordance (store agent wires behaviour). */
  trip?: boolean;
  /** Save metadata overrides. saveKind defaults from entityType. */
  saveKind?: SaveKind;
  saveSection?: string;
  saveDek?: string;
  /** Analytics context. */
  surface?: string;
  position?: number;
  /** Root element. Cards default to `li` (spec: card is an li in a list). */
  as?: 'li' | 'article' | 'div';
}

const {
  variant = 'venue',
  title,
  href,
  entityType,
  entitySlug,
  fieldPath = 'heroImage',
  image,
  verdict,
  meta = [],
  priceBand,
  freshness,
  typeMark,
  showEyebrow = true,
  mediaFallback = false,
  eyebrow,
  byline,
  readTime,
  dateISO,
  dayCount,
  partnerLabel,
  booking,
  trip = false,
  saveKind,
  saveSection,
  saveDek,
  surface,
  position,
  as: Tag = 'li',
} = Astro.props;

/* ---- content-rule guards (warn at build, never mutate copy) ---- */
if (title.length > 60) {
  console.warn(`[v5 Card] title over 60 chars (${title.length}): "${title.slice(0, 60)}..."`);
}
if (verdict && verdict.trim().split(/\s+/).length > 25) {
  console.warn(`[v5 Card] verdict over 25 words for "${entitySlug}"`);
}
if (meta.length > 3) {
  console.warn(`[v5 Card] more than 3 meta chips for "${entitySlug}"; rendering the first 3`);
}
if (/\u2014/.test(`${title} ${verdict ?? ''} ${meta.join(' ')}`)) {
  console.warn(`[v5 Card] em-dash in card copy for "${entitySlug}" (house rule: none, ever)`);
}

const defaultMarks: Record<CardVariant, string> = {
  venue: 'Venue',
  'compact-row': '',
  event: 'Event',
  guide: 'Guide',
  plan: 'Plan',
  place: 'Place',
  article: 'Article',
};
const markText = eyebrow ?? typeMark ?? defaultMarks[variant];

/* priceBand -> band 1..4, rendered as glyph chip with accessible name */
const band =
  priceBand === undefined
    ? 0
    : Math.min(4, Math.max(1, typeof priceBand === 'number' ? priceBand : String(priceBand).trim().length));

const metaChips = meta.slice(0, 3);

/* Event date block (day + short month) */
const eventDate =
  variant === 'event' && dateISO
    ? {
        day: new Date(dateISO).toLocaleDateString('en-AU', { day: 'numeric' }),
        month: new Date(dateISO).toLocaleDateString('en-AU', { month: 'short' }),
      }
    : null;

/* Article publish month for the byline row */
const articleDate =
  variant === 'article' && dateISO
    ? new Date(dateISO).toLocaleDateString('en-AU', { month: 'long', year: 'numeric' })
    : null;

const freshnessText = freshness ? freshnessLabel(freshness) : null;

const isEditorial = variant === 'article' || variant === 'guide';
const showMedia = !!image;
/* No photo, but the row around this card has them: draw the house plate so
   the card keeps its media height and the grid stays level. compact-row is
   text-only by contract (HUB-11) and never takes a plate. */
const showPlate = !image && mediaFallback && variant !== 'compact-row';
const hasVerdictSlot = Astro.slots.has('verdict');

/* Save kind: entityType maps 1:1 except page/region, which are not saveable. */
const resolvedSaveKind: SaveKind | null =
  saveKind ?? (entityType !== 'page' && entityType !== 'region' ? (entityType as SaveKind) : null);

const hasActions = !!resolvedSaveKind || trip || !!booking;
---

{/* `compact-row` is the primitive's `--compact` variant; the other six are
    content-type modifiers layered on the same base. */}
<Tag
  class:list={[
    'pi-card',
    variant === 'compact-row' ? 'pi-card--compact' : `pi-card--${variant}`,
    isEditorial && 'pi-card--editorial',
  ]}
  data-variant={variant}
>
  {showMedia && (
    <div class="pi-card__media">
      <img
        src={image!.src}
        alt={image!.alt}
        loading="lazy"
        decoding="async"
        {...editableImage({
          entityType,
          entitySlug,
          fieldPath,
          label: `${title} image`,
          purpose: 'card',
        })}
      />
      {eventDate && (
        <span class="pi-card__date-block" aria-hidden="true">
          <span class="pi-card__date-day">{eventDate.day}</span>
          <span class="pi-card__date-month">{eventDate.month}</span>
        </span>
      )}
      {variant === 'event' && <slot name="badges" />}
    </div>
  )}

  {showPlate && (
    <div class="pi-card__media pi-card__media--plate">
      <span class="pi-card__plate" aria-hidden="true">
        <span class="pi-card__plate-rule"></span>
        <span class="pi-card__plate-mark">Peninsula Insider</span>
      </span>
      {eventDate && (
        <span class="pi-card__date-block" aria-hidden="true">
          <span class="pi-card__date-day">{eventDate.day}</span>
          <span class="pi-card__date-month">{eventDate.month}</span>
        </span>
      )}
      {variant === 'event' && <slot name="badges" />}
    </div>
  )}

  <div class="pi-card__body">
    {showEyebrow && markText && <p class="pi-card__eyebrow">{markText}</p>}

    <h3 class="pi-card__title">
      <a
        href={href}
        class="pi-card__link"
        data-evt="card_click"
        data-entity-type={entityType}
        data-entity-slug={entitySlug}
        data-variant={variant}
        data-surface={surface}
        data-position={position}
      >
        {title}
      </a>
    </h3>

    {(hasVerdictSlot || verdict) && (
      <p class="pi-card__dek">
        <slot name="verdict">{verdict}</slot>
      </p>
    )}

    {variant === 'article' ? (
      <p class="pi-card__meta">
        <span class="pi-card__byline">{byline ?? 'Peninsula Insider'}</span>
        {articleDate && (
          <>
            <span class="pi-card__sep" aria-hidden="true">&middot;</span>
            <span>{articleDate}</span>
          </>
        )}
        {readTime && (
          <>
            <span class="pi-card__sep" aria-hidden="true">&middot;</span>
            <span>{readTime}</span>
          </>
        )}
      </p>
    ) : (
      (metaChips.length > 0 || band > 0 || (variant === 'guide' && readTime) || (variant === 'plan' && dayCount)) && (
        <p class="pi-card__meta">
          {variant === 'plan' && dayCount && (
            <>
              <span class="pi-card__chip">{dayCount} {dayCount === 1 ? 'day' : 'days'}</span>
              <span class="pi-card__sep" aria-hidden="true">&middot;</span>
            </>
          )}
          {metaChips.map((chip, i) => (
            <>
              {i > 0 && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
              <span class="pi-card__chip">{chip}</span>
            </>
          ))}
          {band > 0 && (
            <>
              {metaChips.length > 0 && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
              <span class="pi-card__chip pi-card__chip--price" aria-label={`price band ${band} of 4`}>
                <span aria-hidden="true">{'$'.repeat(band)}</span>
              </span>
            </>
          )}
          {variant === 'guide' && readTime && (
            <>
              {(metaChips.length > 0 || band > 0) && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
              <span class="pi-card__chip">{readTime}</span>
            </>
          )}
        </p>
      )
    )}

    {(freshnessText || partnerLabel) && (
      <p class="pi-card__provenance">
        {freshnessText && <span>{freshnessText}</span>}
        {freshnessText && partnerLabel && <span class="pi-card__sep" aria-hidden="true">&middot;</span>}
        {partnerLabel && <span class="pi-card__partner">{partnerLabel}</span>}
      </p>
    )}
  </div>

  {hasActions && <div class="pi-card__actions">
    {resolvedSaveKind && (
      <SaveControl
        kind={resolvedSaveKind}
        slug={entitySlug}
        title={title}
        href={href}
        section={saveSection}
        dek={saveDek ?? verdict}
        imageUrl={image?.src}
        variant={variant === 'plan' ? 'fork' : 'save'}
      />
    )}
    {trip && (
      <button
        type="button"
        class="pi-btn pi-btn--ghost pi-btn--sm"
        data-evt="trip_add"
        data-entity-type={entityType}
        data-entity-slug={entitySlug}
        data-entity-title={title}
        data-surface={surface}
        aria-label={`Add ${title} to trip`}
      >
        + Trip
      </button>
    )}
    {booking && (
      <BookingControl
        url={booking.url}
        label={booking.label}
        venueName={booking.venueName ?? title}
        partnerLabel={booking.partnerLabel}
        variant="card-action"
        entityType={entityType}
        entitySlug={entitySlug}
        surface={surface}
      />
    )}
  </div>}
</Tag>

<style>
  /* Only what the shared primitive does NOT provide lives here.
     Ground, hairline, radius, body/eyebrow/title/dek/meta typography,
     the two-line dek clamp and the --compact row direction all come from
     .pi-card in primitives.css. Deleting the local copies is the point:
     the card had been re-declaring the frame it was already inheriting,
     including a resting/hover box-shadow that contradicts the primitive's
     deliberate no-shadow rule. */

  /* Hover: the primitive shifts the hairline; the media and the title
     respond too, which is specific to this card having a photograph. */
  .pi-card:hover .pi-card__media img {
    transform: scale(1.03);
  }
  .pi-card:hover .pi-card__link {
    color: var(--accent);
  }
  /* This card family runs 3/2, unlike the converted page cards the
     primitive defaults to (16/10). Stated explicitly rather than
     inherited so the two cannot drift apart again silently. */
  .pi-card__media {
    aspect-ratio: 3 / 2;
  }
  .pi-card__media img {
    transition: transform var(--dur-slow) var(--ease-enter);
  }

  /* Cards are list items by default, so the marker has to go. */
  .pi-card {
    list-style: none;
  }

  /* ---- media fallback: the house plate ----
     A card with no photograph used to render a blank slot inside an
     image-bearing row. Instead we set the masthead on the signature
     evergreen ground, at exactly the media block's 3:2 ratio, so the grid
     stays level and the absence reads as a deliberate typographic tile.
     Colour is tokens only: --bg-dark ground, --white type (about 13:1),
     rule at 42% white (decorative, not text). No placeholder photography. */
  .pi-card__media--plate {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background: var(--bg-dark);
  }

  .pi-card__plate {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
  }

  .pi-card__plate-rule {
    display: block;
    width: 2.25rem;
    height: 2px;
    background: var(--sage);
  }

  .pi-card__plate-mark {
    display: block;
    max-width: 7ch;
    font-family: var(--font-display);
    font-size: var(--fs-600);
    font-weight: var(--fw-display);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    color: var(--white);
  }

  .pi-card__date-block {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 2.75rem;
    padding: 0.3rem 0.45rem;
    background: var(--white);
    border-radius: var(--radius-s);
    font-family: var(--font-ui);
    line-height: var(--lh-label);
  }
  .pi-card__date-day {
    font-size: var(--fs-500);
    font-weight: var(--fw-bold);
    color: var(--text);
  }
  .pi-card__date-month {
    font-size: var(--fs-100);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--teal-text);
  }

  /* The eyebrow is the entity type mark, so it takes the teal the rest of
     the masthead uses for entity labels rather than the primitive's --soft. */
  .pi-card__eyebrow {
    color: var(--teal-text);
  }

  .pi-card__link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-enter);
  }
  /* Stretched link: whole card navigates; actions layer sits above. */
  .pi-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pi-card__link:focus-visible {
    outline: var(--focus-ring);
    /* Inset ring: the card clips overflow, so a positive offset would hide
       the focus outline at the card edge. Draw it just inside instead. */
    outline-offset: -3px;
  }

  /* The verdict is this masthead's product line, so it runs one step up
     from the primitive's dek and in the UI face at medium weight. */
  .pi-card__dek {
    font-size: var(--fs-500);
    font-weight: var(--fw-medium);
  }

  /* Provenance is a second metadata row (freshness + partner) that the
     primitive has no element for. It matches __meta but never pins. */
  .pi-card__provenance {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: var(--fs-200);
    line-height: var(--lh-ui);
    color: var(--soft);
  }
  .pi-card__sep {
    color: var(--border-strong);
  }
  .pi-card__chip--price {
    letter-spacing: 0.08em;
  }
  .pi-card__partner {
    text-transform: uppercase;
    font-size: var(--fs-100);
    letter-spacing: var(--ls-eyebrow);
    color: var(--teal-text);
  }

  /* Actions sit outside __body, above the stretched link, so they need the
     body's horizontal gutter restored and a stacking context of their own. */
  .pi-card__actions {
    position: relative;
    z-index: 2;
    padding: 0 var(--space-5) var(--space-5);
  }

  /* ---- variant: compact ----
     The primitive's --compact is a horizontal media card. This surface uses
     it as a directory list row: no frame, a square thumb, a bottom rule.
     Selectors repeat the block class so they beat the primitive regardless
     of bundle order. */
  .pi-card.pi-card--compact {
    align-items: center;
    gap: var(--space-3);
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    overflow: visible;
    padding: var(--space-3) 0;
  }
  .pi-card.pi-card--compact:hover {
    background: var(--bg-alt);
  }
  .pi-card.pi-card--compact .pi-card__media {
    flex: 0 0 56px;
    max-width: 56px;
    width: 56px;
    height: 56px;
    aspect-ratio: 1;
    border-radius: var(--radius-s);
  }
  .pi-card.pi-card--compact .pi-card__body {
    padding: 0;
  }
  .pi-card.pi-card--compact .pi-card__title {
    font-size: var(--fs-400);
  }
  .pi-card.pi-card--compact .pi-card__dek {
    font-size: var(--fs-300);
  }
  .pi-card.pi-card--compact .pi-card__actions {
    padding: 0;
    margin-left: auto;
  }
  @media (max-width: 22.5em) {
    /* thumb hides below 360px per spec 2.15 responsive rules */
    .pi-card.pi-card--compact .pi-card__media {
      display: none;
    }
  }

  /* ---- variant: place (region eyebrow, evergreen to distinguish) ---- */
  .pi-card--place .pi-card__eyebrow {
    color: var(--accent);
  }

  /* ---- variants: article + guide (editorial surface, HUB-08 fix) ----
     Distinct at a glance: sea-fog surface, no venue chip cosmetics.
     Titles already render in Sora. An article never wears venue clothing. */
  .pi-card--editorial {
    background: var(--bg-alt);
    border-color: transparent;
  }
  .pi-card--article .pi-card__byline {
    font-weight: var(--fw-semibold);
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-card__media img {
      transition: none;
    }
    .pi-card:hover .pi-card__media img {
      transform: none;
    }
  }
</style>
