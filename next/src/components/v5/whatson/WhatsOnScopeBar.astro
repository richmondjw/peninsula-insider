---
/**
 * WhatsOnScopeBar (v5 What's On, T-601) - the date-scope controls that sit
 * directly under the h1: This weekend (default, server-rendered content) /
 * Next weekend / School holidays / Pick dates.
 *
 * Presentational + declarative only: the page script owns behaviour. Scope
 * buttons are real <button aria-pressed>; "Pick dates" is a <details> with
 * two native date inputs (keyboard-complete by the platform, wireframes
 * note 1 / journey-e). School holidays renders only when the VIC term-date
 * table still has a current-or-future range.
 *
 * The nav carries the runtime data the client needs (weekend anchor, the
 * school-holiday window) so scope maths lives in one place (_data.ts).
 */
export interface Props {
  /** ISO date of the default weekend's Friday. */
  weekendStartISO: string;
  /** Human labels for the two weekend scopes. */
  weekendLabel: string;
  nextWeekendLabel: string;
  /** School-holiday window, or null to hide the control. */
  holidays: { startISO: string; endISO: string; label: string; name: string } | null;
  /** min attribute for the date inputs (today, ISO). */
  todayISO: string;
}

const { weekendStartISO, weekendLabel, nextWeekendLabel, holidays, todayISO } = Astro.props;
---

<nav
  class="wo-scope"
  aria-label="Choose dates"
  data-wo-scope
  data-weekend-start={weekendStartISO}
  data-holiday-start={holidays?.startISO}
  data-holiday-end={holidays?.endISO}
  data-holiday-name={holidays?.name}
>
  <div class="wo-scope__row">
    <button
      type="button"
      class="wo-scope__btn"
      data-wo-scope-btn
      data-scope="weekend"
      aria-pressed="true"
      data-evt="wo_date_change"
    >
      This weekend
      <span class="wo-scope__dates">{weekendLabel}</span>
    </button>
    <button
      type="button"
      class="wo-scope__btn"
      data-wo-scope-btn
      data-scope="next-weekend"
      aria-pressed="false"
      data-evt="wo_date_change"
    >
      Next weekend
      <span class="wo-scope__dates">{nextWeekendLabel}</span>
    </button>
    {holidays && (
      <button
        type="button"
        class="wo-scope__btn"
        data-wo-scope-btn
        data-scope="school-holidays"
        aria-pressed="false"
        data-evt="wo_date_change"
      >
        School holidays
        <span class="wo-scope__dates">{holidays.label}</span>
      </button>
    )}
    <details class="wo-scope__custom" data-wo-custom>
      <summary class="wo-scope__btn wo-scope__btn--summary" data-wo-custom-summary>
        Pick dates
      </summary>
      <form class="wo-scope__form" data-wo-custom-form>
        <label class="wo-scope__field">
          <span>From</span>
          <input type="date" name="from" required min={todayISO} />
        </label>
        <label class="wo-scope__field">
          <span>To</span>
          <input type="date" name="to" required min={todayISO} />
        </label>
        <button type="submit" class="wo-scope__apply" data-evt="wo_date_change">
          Show these dates
        </button>
      </form>
    </details>
  </div>
</nav>

<style>
  .wo-scope {
    margin: var(--space-4, 1rem) 0 0;
  }
  .wo-scope__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2, 0.5rem);
  }
  .wo-scope__btn {
    appearance: none;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    min-height: 48px;
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    background: var(--surface, var(--bg));
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-m, 10px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9rem);
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-ui, 1.4);
    cursor: pointer;
    transition:
      border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      background var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .wo-scope__btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .wo-scope__btn:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wo-scope__btn[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--white, #fff);
  }
  .wo-scope__dates {
    font-size: var(--fs-100, 0.75rem);
    font-weight: var(--fw-body, 400);
    color: var(--soft);
  }
  .wo-scope__btn[aria-pressed='true'] .wo-scope__dates {
    color: var(--soft-inverse, rgba(250, 247, 240, 0.72));
  }

  /* Pick dates disclosure */
  .wo-scope__custom {
    position: relative;
  }
  .wo-scope__btn--summary {
    list-style: none;
    justify-content: center;
  }
  .wo-scope__btn--summary::-webkit-details-marker {
    display: none;
  }
  .wo-scope__custom[open] .wo-scope__btn--summary {
    border-color: var(--accent);
    color: var(--accent);
  }
  .wo-scope__custom[data-active='true'] .wo-scope__btn--summary {
    background: var(--text);
    border-color: var(--text);
    color: var(--white, #fff);
  }
  .wo-scope__form {
    position: absolute;
    z-index: 30;
    top: calc(100% + var(--space-2, 0.5rem));
    left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-4, 1rem);
    background: var(--surface, var(--bg));
    border: 1px solid var(--border);
    border-radius: var(--radius-m, 10px);
    box-shadow: var(--elev-2);
    min-width: min(320px, 82vw);
  }
  .wo-scope__field {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-200, 0.8rem);
    color: var(--soft);
  }
  .wo-scope__field input {
    min-height: 44px;
    padding: 0 var(--space-2, 0.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-s, 4px);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9rem);
  }
  .wo-scope__field input:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wo-scope__apply {
    appearance: none;
    min-height: 44px;
    padding: 0 var(--space-4, 1rem);
    background: var(--accent);
    color: var(--white, #fff);
    border: 1px solid var(--accent);
    border-radius: var(--radius-m, 10px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9rem);
    font-weight: var(--fw-semibold, 600);
    cursor: pointer;
  }
  .wo-scope__apply:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }

  @media (max-width: 47.9375em) {
    .wo-scope__dates {
      display: none;
    }
    .wo-scope__btn {
      flex-direction: row;
      align-items: center;
    }
    .wo-scope__form {
      left: auto;
      right: 0;
    }
  }
</style>
