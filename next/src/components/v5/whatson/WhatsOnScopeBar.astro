---
/**
 * WhatsOnScopeBar (v5 What's On, T-601) - the date-scope controls that sit
 * directly under the h1: This weekend (default, server-rendered content) /
 * Next weekend / School holidays / Pick dates.
 *
 * Presentational + declarative only: the page script owns behaviour. Scope
 * buttons are real <button aria-pressed>; "Pick dates" is a <details> with
 * two native date inputs (keyboard-complete by the platform, wireframes
 * note 1 / journey-e). School holidays renders only when the VIC term-date
 * table still has a current-or-future range.
 *
 * The nav carries the runtime data the client needs (weekend anchor, the
 * school-holiday window) so scope maths lives in one place (_data.ts).
 */
export interface Props {
  /** ISO date of the default weekend's Friday. */
  weekendStartISO: string;
  /** Human labels for the two weekend scopes. */
  weekendLabel: string;
  nextWeekendLabel: string;
  /** School-holiday window, or null to hide the control. */
  holidays: { startISO: string; endISO: string; label: string; name: string } | null;
  /** min attribute for the date inputs (today, ISO). */
  todayISO: string;
}

const { weekendStartISO, weekendLabel, nextWeekendLabel, holidays, todayISO } = Astro.props;
---

<nav
  class="wo-scope"
  aria-label="Choose dates"
  data-wo-scope
  data-weekend-start={weekendStartISO}
  data-holiday-start={holidays?.startISO}
  data-holiday-end={holidays?.endISO}
  data-holiday-name={holidays?.name}
>
  <div class="wo-scope__row">
    <button
      type="button"
      class="wo-scope__btn"
      data-wo-scope-btn
      data-scope="weekend"
      aria-pressed="true"
      data-evt="wo_date_change"
    >
      This weekend
      <span class="wo-scope__dates">{weekendLabel}</span>
    </button>
    <button
      type="button"
      class="wo-scope__btn"
      data-wo-scope-btn
      data-scope="next-weekend"
      aria-pressed="false"
      data-evt="wo_date_change"
    >
      Next weekend
      <span class="wo-scope__dates">{nextWeekendLabel}</span>
    </button>
    {holidays && (
      <button
        type="button"
        class="wo-scope__btn"
        data-wo-scope-btn
        data-scope="school-holidays"
        aria-pressed="false"
        data-evt="wo_date_change"
      >
        School holidays
        <span class="wo-scope__dates">{holidays.label}</span>
      </button>
    )}
    <details class="wo-scope__custom" data-wo-custom>
      <summary class="wo-scope__btn wo-scope__btn--summary" data-wo-custom-summary>
        Pick dates
        <span class="wo-scope__dates">
          <svg class="wo-scope__cal" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M3 10h18M8 3v4M16 3v4" />
          </svg>
          Your dates
        </span>
      </summary>
      <form class="wo-scope__form" data-wo-custom-form>
        <label class="wo-scope__field">
          <span>From</span>
          <input type="date" name="from" required min={todayISO} />
        </label>
        <label class="wo-scope__field">
          <span>To</span>
          <input type="date" name="to" required min={todayISO} />
        </label>
        <button type="submit" class="wo-scope__apply" data-evt="wo_date_change">
          Show these dates
        </button>
      </form>
    </details>
  </div>
</nav>

<style>
  /* One filter-chip spec for the page (WO3, DESIGN.md "Filters and
     search"): 48px pills with a hairline at rest and a Harbour fill when
     selected, shared with the category jump chips further down. Every chip
     carries a two-line label, so the row lines up top and bottom. */
  .wo-scope {
    position: relative;
    margin: 0;
  }
  .wo-scope__row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-2, 0.5rem);
  }
  .wo-scope__btn {
    appearance: none;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    height: 100%;
    min-height: 48px;
    padding: var(--space-2, 0.5rem) var(--space-5, 1.5rem);
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill, 999px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    line-height: 1.25;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      background var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .wo-scope__btn:hover {
    border-color: var(--harbour);
    color: var(--harbour);
  }
  .wo-scope__btn:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wo-scope__btn[aria-pressed='true'] {
    background: var(--harbour);
    border-color: var(--harbour);
    color: var(--white, #fff);
  }
  .wo-scope__dates {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: var(--fs-100, 0.75rem);
    font-weight: var(--fw-body, 400);
    color: var(--soft);
  }
  .wo-scope__cal {
    flex: none;
  }
  .wo-scope__btn[aria-pressed='true'] .wo-scope__dates,
  .wo-scope__custom[data-active='true'] .wo-scope__dates {
    color: var(--white, #fff);
    opacity: 0.85;
  }

  /* Pick dates disclosure */
  .wo-scope__custom {
    position: relative;
  }
  .wo-scope__btn--summary {
    list-style: none;
  }
  .wo-scope__btn--summary::-webkit-details-marker {
    display: none;
  }
  .wo-scope__custom[open] .wo-scope__btn--summary {
    border-color: var(--harbour);
    color: var(--harbour);
  }
  .wo-scope__custom[data-active='true'] .wo-scope__btn--summary {
    background: var(--harbour);
    border-color: var(--harbour);
    color: var(--white, #fff);
  }
  .wo-scope__form {
    position: absolute;
    z-index: 30;
    top: calc(100% + var(--space-2, 0.5rem));
    left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-4, 1rem);
    background: var(--surface, var(--bg));
    border: 1px solid var(--border);
    border-radius: var(--radius-m, 10px);
    box-shadow: var(--elev-2);
    min-width: min(320px, 82vw);
  }
  .wo-scope__field {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-200, 0.8rem);
    color: var(--soft);
  }
  /* Fields and buttons: 48px, 8px radius (the house control spec). */
  .wo-scope__field input {
    min-height: 48px;
    padding: 0 var(--space-3, 0.75rem);
    border: 1px solid var(--border-strong, var(--border));
    border-radius: var(--radius-s, 8px);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-ui, inherit);
    font-size: 1rem;
  }
  .wo-scope__field input:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wo-scope__apply {
    appearance: none;
    min-height: 48px;
    padding: 0 var(--space-5, 1.5rem);
    background: var(--harbour);
    color: var(--white, #fff);
    border: 1px solid var(--harbour);
    border-radius: var(--radius-s, 8px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    cursor: pointer;
    transition: background var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .wo-scope__apply:hover {
    background: var(--harbour-h, var(--harbour));
  }
  .wo-scope__apply:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }

  /* Phones: keep every date sub-line and let the chips scroll sideways in
     one row, with an end fade as the cue that more sits off-screen. The
     date panel anchors to the whole bar, outside the scroller, so the
     scroller cannot clip it. */
  @media (max-width: 47.9375em) {
    .wo-scope::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 2rem;
      background: linear-gradient(to right, transparent, var(--bg));
      pointer-events: none;
    }
    .wo-scope__row {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: -3px;
      padding: 3px 2rem 3px 3px;
      scrollbar-width: none;
    }
    .wo-scope__row::-webkit-scrollbar {
      display: none;
    }
    .wo-scope__btn {
      padding-inline: var(--space-4, 1rem);
    }
    .wo-scope__custom {
      position: static;
    }
    .wo-scope__form {
      left: 0;
      right: 0;
      min-width: 0;
    }
  }
</style>
