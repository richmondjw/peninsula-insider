---
/**
 * WhatsOnRow (v5 What's On, T-601) - the listing row.
 *
 * Text-first (HUB-11: the row layer carries almost no image weight): title
 * link, one-liner and meta, with the labelled Save and "Add to trip" pair
 * the pick cards use (C23). One row per group may carry the event's own
 * hero image as a small thumbnail (a feature row, WO23), so a long list has
 * an anchor without turning into a grid of cards.
 *
 * Layout (WO21, design-perfection round 2):
 *  - 48em and up: a three-column grid. Column 1 holds the lead token (the
 *    time, or the cadence or dates for rows without one) and, on a feature
 *    row, the thumbnail under it. Column 2 is title, dek (68ch) and meta.
 *    Column 3 is the action pair, pinned to the frame's right edge.
 *  - Below 48em: one column. The title takes the full width, then the dek,
 *    the meta (the lead token becomes its first item), then the action pair
 *    on its own line. A feature row sets its thumbnail beside the title.
 *  - Every row carries a bottom rule, the last one too, so each list closes
 *    on the same hairline that separates its rows.
 *  - Meta separators trail their token (`li:not(:last-child)::after`), so a
 *    wrapped line can end on a dot but never start with one.
 *
 * The page's client script clones this exact markup (via a <template>) when
 * it renders other date scopes from the JSON island, so keep the class and
 * data-attribute surface stable: .wo-row__when / .wo-row__link /
 * .wo-row__dek / .wo-row__meta (a list) / [data-v5-save-control] /
 * .wo-row__trip / .wo-row__trip-label. Elements the script creates itself
 * (meta items, the thumbnail) carry no scope attribute, which is why their
 * selectors below are :global() under a scoped parent.
 */
import SaveControl from '../SaveControl.astro';

export interface Props {
  title: string;
  href: string;
  slug: string;
  oneLiner?: string;
  /**
   * The lead token: the time for a row filed under its day (or its cadence
   * when it has no time), the dates for an ongoing or shelf row ("All
   * weekend", "Saturdays", "Sat 17 Oct"). Column 1 on desktop, the first
   * meta item on mobile.
   */
  when?: string;
  /** Meta tokens after the lead token (place, access or category). */
  meta?: string[];
  surface?: string;
  /**
   * PI-008. The occurrence's own state, not the record's: "Ended", "Sold out",
   * "Cancelled this time". It joins the meta line rather than arriving as a new
   * badge, so the client island that clones this markup keeps working and the
   * CSS budget is untouched. `bookable` is exposed as a data attribute only;
   * the row has no booking affordance of its own, and the attribute is what
   * lets a listing be checked from the built HTML.
   */
  statusLabel?: string | null;
  phase?: 'upcoming' | 'running' | 'past';
  bookable?: boolean;
  /** Feature row (WO23): the event's own hero image as a 4:3 thumbnail. */
  image?: { src: string; alt: string } | null;
  /** Strip row (WO23): title, lead token, meta and actions; no dek. */
  strip?: boolean;
  /** Held back behind its group's "Show all" control (still in the DOM). */
  collapsed?: boolean;
}

const {
  title,
  href,
  slug,
  oneLiner = '',
  when = '',
  meta = [],
  surface = 'whatson',
  statusLabel = null,
  phase = 'upcoming',
  bookable = true,
  image = null,
  strip = false,
  collapsed = false,
} = Astro.props;
const tokens = [...meta, statusLabel].filter((t): t is string => Boolean(t));
const dek = strip ? '' : oneLiner;
---

<li
  class:list={['wo-row', image && 'wo-row--feature', strip && 'wo-row--strip']}
  data-occurrence-phase={phase}
  data-occurrence-bookable={String(bookable)}
  data-wo-more-row={collapsed ? '' : undefined}
  hidden={collapsed || undefined}
>
  <p class="wo-row__when">{when}</p>
  {image && (
    <div class="wo-row__thumb">
      <img
        src={image.src}
        alt=""
        width="120"
        height="90"
        loading="lazy"
        decoding="async"
        data-pi-responsive="(max-width: 767px) 96px, 120px"
      />
    </div>
  )}
  <a
    class="wo-row__link"
    href={href}
    data-evt="card_click"
    data-entity-type="event"
    data-entity-slug={slug}
    data-surface={surface}
  >
    {title}
  </a>
  <p class="wo-row__dek">{dek}</p>
  <ul class="wo-row__meta" role="list">{when && <li class="wo-row__meta-when">{when}</li>}{tokens.map((t) => <li>{t}</li>)}</ul>
  <div class="wo-row__actions">
    <SaveControl kind="event" slug={slug} title={title} href={href} dek={oneLiner} labelled />
    <button
      type="button"
      class="wo-row__trip"
      data-evt="trip_add"
      data-entity-type="event"
      data-entity-slug={slug}
      data-entity-title={title}
      data-entity-href={href}
      aria-label={`Add ${title} to trip`}
    >
      <span class="wo-row__trip-label">Add to trip</span>
    </button>
  </div>
</li>

<style>
  /* ── Mobile first: title full width, then dek, meta, and the action pair ── */
  .wo-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'title'
      'dek'
      'meta'
      'actions';
    align-items: start;
    align-content: start;
    padding-block: var(--space-5, 1.5rem);
    border-bottom: 1px solid var(--border);
  }
  /* Author display:grid would otherwise override the UA [hidden] rule. */
  .wo-row[hidden] {
    display: none;
  }

  /* The lead token column exists from 48em; on a phone the token opens the
     meta line instead, so this copy is not rendered (and not read). */
  .wo-row__when {
    grid-area: when;
    display: none;
    margin: 0;
  }

  .wo-row__link {
    grid-area: title;
    justify-self: start;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--fs-500, 1.2rem);
    font-weight: var(--fw-display, 600);
    line-height: 1.2;
    /* Pretty, not balance: a title just over one line fills the column and
       only avoids an orphan, rather than splitting into two short halves. */
    text-wrap: pretty;
  }
  .wo-row__link:hover {
    color: var(--harbour);
  }
  .wo-row__link:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
    border-radius: 2px;
  }

  .wo-row__dek {
    grid-area: dek;
    margin: var(--space-1, 0.25rem) 0 0;
    color: var(--text);
    font-style: normal;
    font-size: var(--fs-400, 1.0625rem);
    line-height: 1.5;
    max-width: 68ch;
    text-wrap: pretty;
  }
  .wo-row__dek:empty {
    display: none;
  }

  /* Meta: the canonical token line. Each item is an unbreakable unit that
     carries its separator AFTER it, so a wrapped line may end on a dot but
     never begins with one. Items the client script builds have no scope
     attribute, hence :global() under the scoped list. */
  .wo-row__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin: var(--space-2, 0.5rem) 0 0;
    padding: 0;
    list-style: none;
    color: var(--soft);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-200, 0.8125rem);
    line-height: 1.5;
  }
  .wo-row__meta:not(:has(li)) {
    display: none;
  }
  .wo-row__meta :global(li) {
    white-space: nowrap;
  }
  .wo-row__meta :global(li:not(:last-child)::after) {
    content: '\00B7';
    content: '\00B7' / '';
    margin-left: 0.5em;
    color: var(--border-strong, var(--soft));
  }
  .wo-row__meta :global(.wo-row__meta-when) {
    color: var(--text);
    font-weight: var(--fw-semibold, 600);
  }

  /* ── The action pair (C23): labelled Save beside "Add to trip", the pick
     cards' exact shape. 44px on phones, 48px from 48em, 8px radius. ── */
  .wo-row__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-2, 0.5rem);
    margin-top: var(--space-3, 0.75rem);
  }
  .wo-row__trip {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Holds the "Add to trip" width when the label reads "In trip". */
    min-width: 6.75rem;
    min-height: 44px;
    padding: 0 var(--space-4, 1rem);
    background: transparent;
    color: var(--harbour);
    border: 1px solid var(--border);
    border-radius: var(--radius-s, 8px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-200, 0.8125rem);
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-ui, 1.4);
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      background var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .wo-row__trip:hover {
    border-color: var(--harbour);
    color: var(--harbour-h, var(--harbour));
  }
  .wo-row__trip:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wo-row__trip[data-added='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--white, #fff);
  }

  /* ── Feature row, phones: a 96px 4:3 thumbnail beside the title ── */
  .wo-row :global(.wo-row__thumb) {
    grid-area: thumb;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-m, 16px);
    background: var(--paper-warm, var(--border));
  }
  .wo-row :global(.wo-row__thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wo-row.wo-row--feature {
    grid-template-columns: minmax(0, 1fr) 6rem;
    grid-template-areas:
      'title   thumb'
      'dek     dek'
      'meta    meta'
      'actions actions';
    column-gap: var(--space-4, 1rem);
  }

  /* ── 48em and up: when | text | actions on the frame edge ── */
  @media (min-width: 48em) {
    .wo-row,
    .wo-row.wo-row--feature {
      grid-template-columns: 7.5rem minmax(0, 1fr) auto;
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'when title actions'
        'when dek   actions'
        'when meta  actions';
      column-gap: var(--space-6, 2rem);
      /* A row without a dek holds the rhythm: the block of a title, one dek
         line and the meta line, so short rows do not jitter the list. */
      min-height: calc(
        2 * var(--space-5, 1.5rem) + var(--fs-500, 1.2rem) * 1.2 + var(--space-1, 0.25rem) +
          var(--fs-400, 1.0625rem) * 1.5 + var(--space-2, 0.5rem) + var(--fs-200, 0.8125rem) * 1.5
      );
    }
    .wo-row__when {
      display: block;
      align-self: start;
      /* Optical: sit the token on the title's first line. */
      padding-top: 0.3em;
      color: var(--text);
      font-family: var(--font-ui, inherit);
      font-size: var(--fs-200, 0.8125rem);
      font-weight: var(--fw-semibold, 600);
      line-height: 1.4;
    }
    /* The feature thumbnail shares column 1, under the lead token. */
    .wo-row :global(.wo-row__thumb) {
      grid-area: 1 / 1 / -1 / 2;
      align-self: start;
      margin-top: calc(var(--fs-200, 0.8125rem) * 1.7 + var(--space-2, 0.5rem));
    }
    .wo-row__when:empty + :global(.wo-row__thumb) {
      margin-top: 0;
    }
    .wo-row__actions {
      align-self: start;
      justify-self: end;
      gap: var(--space-3, 0.75rem);
      margin-top: 0;
    }
    .wo-row__trip {
      min-width: 7.5rem;
      min-height: 48px;
      font-size: var(--fs-300, 0.9375rem);
    }
    /* Column 1 carries the lead token, so its meta copy is not rendered at
       all: no hidden token, and no separator left in front of the next. */
    .wo-row__meta :global(.wo-row__meta-when) {
      display: none;
    }
    .wo-row__meta:not(:has(li:not(.wo-row__meta-when))) {
      display: none;
    }
  }

  /* ── Strip row: the compact "On all weekend" list. No dek, no reserved
     dek line, a tighter inset. ── */
  .wo-row.wo-row--strip {
    min-height: 0;
    padding-block: var(--space-4, 1rem);
  }
</style>
