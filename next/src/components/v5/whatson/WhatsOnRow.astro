---
/**
 * WhatsOnRow (v5 What's On, T-601) - the compact listing row.
 *
 * Text-only by design (HUB-11: the row layer carries zero image weight);
 * title link + one-liner + meta line, with Save and "Add to trip" as the
 * canonical action pair. Mirrors the Card compact-row anatomy but stays
 * purpose-built so fifty of them cost a fraction of fifty cards.
 *
 * Layout (WO2, design-perfection 2026-09-29):
 *  - 48em and up: a three-column grid. Column 1 is the lead token (time, or
 *    the date for ongoing and shelf rows), column 2 is title, dek and meta at
 *    no more than 68ch, column 3 the action pair, which sits right after the
 *    text rather than pinned to the far edge of the frame.
 *  - Below 48em: title and two 44px icon actions share the first line, then
 *    the dek and the meta. The lead token becomes the first meta item.
 *  - Rows carry one bottom rule; the last row in a list has none, so a group
 *    heading is never boxed between two rules.
 *
 * The page's client script clones this exact markup (via a <template>) when
 * it renders other date scopes from the JSON island, so keep the class and
 * data-attribute surface stable: .wo-row__when / .wo-row__link /
 * .wo-row__dek / .wo-row__meta (a list) / [data-v5-save-control] /
 * .wo-row__trip / .wo-row__trip-label.
 */
import SaveControl from '../SaveControl.astro';

export interface Props {
  title: string;
  href: string;
  slug: string;
  oneLiner?: string;
  /**
   * The lead token: the time for a row filed under its day, or the date for
   * an ongoing or shelf row ("Until 30 Apr 2027", "Every Saturday",
   * "Sat 17 Oct"). Column 1 on desktop, the first meta item on mobile.
   */
  when?: string;
  /** Meta tokens after the lead token (place, access or category, cadence). */
  meta?: string[];
  surface?: string;
  /**
   * PI-008. The occurrence's own state, not the record's: "Ended", "Sold out",
   * "Cancelled this time". It joins the meta line rather than arriving as a new
   * badge, so the client island that clones this markup keeps working and the
   * CSS budget is untouched. `bookable` is exposed as a data attribute only;
   * the row has no booking affordance of its own, and the attribute is what
   * lets a listing be checked from the built HTML.
   */
  statusLabel?: string | null;
  phase?: 'upcoming' | 'running' | 'past';
  bookable?: boolean;
  /** Day lists: on mobile the dek is held to one line to keep rows compact. */
  compact?: boolean;
}

const {
  title,
  href,
  slug,
  oneLiner = '',
  when = '',
  meta = [],
  surface = 'whatson',
  statusLabel = null,
  phase = 'upcoming',
  bookable = true,
  compact = false,
} = Astro.props;
const tokens = [...meta, statusLabel].filter((t): t is string => Boolean(t));
---

<li
  class:list={['wo-row', compact && 'wo-row--compact']}
  data-occurrence-phase={phase}
  data-occurrence-bookable={String(bookable)}
>
  <p class="wo-row__when" aria-hidden="true">{when}</p>
  <a
    class="wo-row__link"
    href={href}
    data-evt="card_click"
    data-entity-type="event"
    data-entity-slug={slug}
    data-surface={surface}
  >
    {title}
  </a>
  <p class="wo-row__dek">{oneLiner}</p>
  <ul class="wo-row__meta" role="list">{when && <li class="wo-row__meta-when">{when}</li>}{tokens.map((t) => <li>{t}</li>)}</ul>
  <div class="wo-row__actions">
    <SaveControl kind="event" slug={slug} title={title} href={href} dek={oneLiner} />
    <button
      type="button"
      class="wo-row__trip"
      data-evt="trip_add"
      data-entity-type="event"
      data-entity-slug={slug}
      data-entity-title={title}
      data-entity-href={href}
      aria-label={`Add ${title} to trip`}
    >
      <svg class="wo-row__trip-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M12 5v14M5 12h14" />
      </svg>
      <svg class="wo-row__trip-done" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M5 12.5l4.5 4.5L19 7.5" />
      </svg>
      <span class="wo-row__trip-label">Add to trip</span>
    </button>
  </div>
</li>

<style>
  /* ── Mobile first: title + icon actions on one line, then dek and meta ── */
  .wo-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title actions'
      'dek   dek'
      'meta  meta';
    column-gap: var(--space-3, 0.75rem);
    align-items: start;
    padding-block: var(--space-4, 1rem);
    border-bottom: 1px solid var(--border);
  }
  .wo-row:last-child {
    border-bottom: 0;
  }

  .wo-row__when {
    grid-area: when;
    display: none;
    margin: 0;
  }

  .wo-row__link {
    grid-area: title;
    align-self: center;
    justify-self: start;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--fs-500, 1.2rem);
    font-weight: var(--fw-display, 600);
    line-height: 1.2;
    text-wrap: balance;
  }
  .wo-row__link:hover {
    color: var(--harbour);
  }
  .wo-row__link:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
    border-radius: 2px;
  }

  .wo-row__dek {
    grid-area: dek;
    margin: var(--space-1, 0.25rem) 0 0;
    color: var(--text);
    font-style: normal;
    font-size: var(--fs-400, 1.0625rem);
    line-height: 1.5;
    max-width: 68ch;
    text-wrap: pretty;
  }
  .wo-row__dek:empty {
    display: none;
  }

  /* Meta: the canonical token line (C4). Each item is an unbreakable unit
     with its own leading middot, so a line never starts with a separator
     and a date never splits. */
  .wo-row__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin: var(--space-2, 0.5rem) 0 0;
    padding: 0;
    list-style: none;
    color: var(--soft);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-200, 0.8125rem);
    line-height: 1.5;
  }
  .wo-row__meta:not(:has(li)) {
    display: none;
  }
  .wo-row__meta li {
    white-space: nowrap;
  }
  .wo-row__meta li + li::before {
    content: '·';
    margin-right: 0.5em;
    color: var(--border-strong, var(--soft));
  }
  .wo-row__meta-when {
    color: var(--text);
    font-weight: var(--fw-semibold, 600);
  }

  /* ── The action pair (C5): circular bookmark + 8px-radius trip control ── */
  .wo-row__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }
  .wo-row__actions :global(.v5-save__btn) {
    min-width: 44px;
    min-height: 44px;
  }
  .wo-row__trip {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: 44px;
    min-width: 44px;
    padding: 0;
    background: var(--bg);
    color: var(--harbour);
    border: 1px solid var(--border);
    border-radius: var(--radius-s, 8px);
    font-family: var(--font-ui, inherit);
    font-size: var(--fs-300, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast, 120ms) var(--ease-enter, ease),
      background var(--dur-fast, 120ms) var(--ease-enter, ease),
      color var(--dur-fast, 120ms) var(--ease-enter, ease);
  }
  .wo-row__trip:hover {
    border-color: var(--harbour);
    color: var(--harbour-h, var(--harbour));
  }
  .wo-row__trip:focus-visible {
    outline: var(--focus-ring, 2px solid var(--accent));
    outline-offset: 2px;
  }
  .wo-row__trip[data-added='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--white, #fff);
  }
  .wo-row__trip-label,
  .wo-row__trip-done {
    display: none;
  }
  .wo-row__trip[data-added='true'] .wo-row__trip-icon {
    display: none;
  }
  .wo-row__trip[data-added='true'] .wo-row__trip-done {
    display: block;
  }

  @media (max-width: 47.9375em) {
    /* Day lists stay scannable on a phone: one line of dek per row. */
    .wo-row.wo-row--compact .wo-row__dek {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
      line-clamp: 1;
      overflow: hidden;
    }
  }

  /* ── 48em and up: when | text (68ch) | actions ── */
  @media (min-width: 48em) {
    .wo-row {
      grid-template-columns: 7.5rem minmax(0, 68ch) auto;
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'when title actions'
        'when dek   actions'
        'when meta  actions';
      column-gap: var(--space-6, 2rem);
      justify-content: start;
      padding-block: var(--space-5, 1.5rem);
    }
    .wo-row__when {
      display: block;
      /* Optical: sit the token on the title's first line. */
      padding-top: 0.3em;
      color: var(--text);
      font-family: var(--font-ui, inherit);
      font-size: var(--fs-200, 0.8125rem);
      font-weight: var(--fw-semibold, 600);
      line-height: 1.4;
    }
    .wo-row__link {
      align-self: start;
    }
    .wo-row__actions {
      align-self: start;
      gap: var(--space-3, 0.75rem);
    }
    .wo-row__actions :global(.v5-save__btn) {
      min-width: 48px;
      min-height: 48px;
    }
    .wo-row__trip {
      min-height: 48px;
      padding: 0 var(--space-4, 1rem);
    }
    .wo-row__trip-icon,
    .wo-row__trip[data-added='true'] .wo-row__trip-done {
      display: none;
    }
    .wo-row__trip-label {
      display: inline;
    }
    /* Column 1 shows the lead token, so its meta copy is kept for assistive
       technology only, and the next token drops its leading middot. */
    .wo-row__meta-when {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .wo-row__meta-when + li::before {
      content: none;
    }
    .wo-row__meta:not(:has(li:not(.wo-row__meta-when))) {
      margin: 0;
    }
  }
</style>
