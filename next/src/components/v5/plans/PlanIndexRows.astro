---
/**
 * PlanIndexRows (v5, /plans/ hub section 5) - the full plan catalogue as
 * server-rendered compact rows. An index, not a card wall (P3): every plan
 * URL stays linked and crawlable, in the DOM with zero JS.
 */
import Card from '../Card.astro';
import CardGrid from '../CardGrid.astro';
import type { PlanRecord } from './plans-data';

export interface Props {
  plans: PlanRecord[];
}

const { plans } = Astro.props;
const sorted = [...plans].sort((a, b) => a.title.localeCompare(b.title));
---

<section class="plan-index" id="all-plans" aria-labelledby="all-plans-heading">
  <div class="container">
    <header class="plan-index__header">
      <p class="plan-index__label">The full catalogue</p>
      <h2 class="plan-index__title" id="all-plans-heading">All {sorted.length} plans</h2>
      <p class="plan-index__sub">Every plan we publish, one line each. The chips above are the short way through this list.</p>
    </header>
    <div class="plan-index__cols">
      <CardGrid label="All Peninsula plans" layout="rows">
        {sorted.map((plan, i) => (
          <Card
            variant="compact-row"
            title={plan.title}
            href={plan.href}
            entityType={plan.entityType}
            entitySlug={plan.slug}
            verdict={plan.verdict}
            meta={plan.meta}
            saveSection={plan.entityType === 'article' ? 'plans' : undefined}
            surface="plans-index"
            position={i + 1}
          />
        ))}
      </CardGrid>
    </div>
  </div>
</section>

<style>
  .plan-index {
    padding: var(--space-7, 2.5rem) 0;
    border-top: 1px solid var(--border);
  }
  .plan-index__header {
    margin-bottom: var(--space-5, 1.5rem);
    max-width: 60ch;
  }
  .plan-index__label {
    margin: 0 0 0.35rem;
    font-family: var(--font-ui, var(--font-ui));
    font-size: var(--fs-100, 0.75rem);
    font-weight: var(--fw-semibold, 600);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .plan-index__title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display, var(--font-display));
    font-size: var(--fs-800, clamp(1.75rem, 1.4rem + 1.6vw, 2.375rem));
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.15);
  }
  .plan-index__sub {
    margin: 0;
    font-family: var(--font-ui, var(--font-ui));
    color: var(--soft);
    line-height: var(--lh-ui, 1.5);
  }

  /* Two-column index on desktop (hub spec 23); single column below. */
  @media (min-width: 64em) {
    .plan-index__cols :global(.v5-card-grid--rows) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6, 2rem);
    }
  }
</style>
