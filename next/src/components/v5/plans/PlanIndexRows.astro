---
import { editableImage } from '../../../lib/inline-edit/attrs';
import type { PlansModel } from './plans-data';
export interface Props { model: PlansModel; }
const { model } = Astro.props;
const itineraries = model.plans.filter(plan => plan.kind === 'itinerary').sort((a,b) => b.editorialPriority - a.editorialPriority);
const guides = model.plans.filter(plan => plan.kind === 'guide').sort((a,b) => a.displayTitle.localeCompare(b.displayTitle));
---
<!-- The one itinerary collection. Each plan appears once: the editor's pick leads with its photograph,
     the rest follow as quiet rows. The matcher (slot) sits under the heading and answers above the list. -->
<section class="plan-index" id="all-plans" aria-labelledby="all-plans-heading" data-plan-index>
  <div class="container">
    <h2 id="all-plans-heading">Ready-made itineraries</h2>
    <p class="plan-index__intro">Days in order, with the stops already chosen. Check transport between stops and booking requirements, then make it yours.</p>
    <slot />
    <div class="plan-index__rows">
      {itineraries.map((plan,i) => <article class:list={['plan-index__row', { 'plan-index__row--pick': i === 0 && plan.image }]} data-plan-row={plan.id}>
        <div class="plan-index__copy">
          {i === 0 && <p class="plan-index__mark">Editor’s pick</p>}
          <h3><a href={plan.href} data-evt="card_click" data-entity-type={plan.entityType} data-entity-slug={plan.slug} data-surface="plans-index">{plan.displayTitle}</a></h3>
          <p>{plan.editorialReason}</p>
          <p class="plan-index__meta">{plan.meta.join(' · ')}</p>
          <button class="pi-btn pi-btn--text plan-index__use" type="button" data-plan-fork={plan.id} aria-label={`Use this itinerary: ${plan.title}`}>Use this itinerary</button>
        </div>
        {i === 0 && plan.image && <figure class="plan-index__media">
          <img src={plan.image.src} alt={plan.image.alt} loading="eager" fetchpriority="high" decoding="async" width="720" height="480" data-pi-responsive="(max-width: 720px) calc(100vw - 32px), (max-width: 1280px) 46vw, 600px"
            {...editableImage({entityType:plan.entityType,entitySlug:plan.slug,fieldPath:plan.imageField,label:`${plan.title} image`,purpose:'card'})} />
          {plan.image.credit && <figcaption>{plan.image.caption} Photo: {plan.image.credit}</figcaption>}
        </figure>}
      </article>)}
    </div>
  </div>
</section>
<section class="plan-guides" id="planning-guides" aria-labelledby="plan-guides-heading">
  <div class="container">
    <h2 id="plan-guides-heading">Planning guides</h2>
    <p class="plan-index__intro">Advice for choosing your own stops, a place to stay or a bigger occasion. Reading, rather than day-by-day plans.</p>
    <div class="plan-guides__grid">{guides.slice(0,6).map(plan => <article class="plan-guide" data-plan-guide={plan.id}><h3><a href={plan.href}>{plan.displayTitle}</a></h3><p>{plan.verdict}</p></article>)}</div>
    {guides.length > 6 && <details class="plan-guides__more"><summary>More planning guides <span>({guides.length - 6})</span> <span aria-hidden="true">+</span></summary><div class="plan-guides__grid">{guides.slice(6).map(plan => <article class="plan-guide" data-plan-guide={plan.id}><h3><a href={plan.href}>{plan.displayTitle}</a></h3><p>{plan.verdict}</p></article>)}</div></details>}
  </div>
</section>
<style>
  .plan-index{padding:1rem 0 3rem;scroll-margin-top:8rem}
  h2{font:500 var(--fs-700)/1.2 var(--font-display);letter-spacing:-.04em;margin:0}
  .plan-index__intro{font:var(--fs-300)/1.65 var(--font-ui);color:var(--soft);max-width:62ch;margin:.75rem 0 1rem}
  .plan-index__rows{margin-top:1rem}
  .plan-index__row{padding:1.5rem 0;border-bottom:1px solid var(--border)}
  .plan-index__row:last-child{border-bottom:0}
  .plan-index__row--pick{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:2.5rem;align-items:center;padding-top:.5rem}
  .plan-index__mark{font:600 var(--fs-100)/1.4 var(--font-ui);letter-spacing:var(--ls-eyebrow, .1em);text-transform:uppercase;color:var(--accent);margin:0 0 .5rem}
  h3{font:500 var(--fs-500)/1.3 var(--font-display);letter-spacing:-.025em;margin:0 0 .4rem}h3 a{color:var(--text);text-decoration:none}h3 a:hover{text-decoration:underline;text-underline-offset:.15em}
  .plan-index__row--pick h3{font-size:var(--fs-700);line-height:1.15;max-width:17ch;margin-bottom:.6rem}
  .plan-index__copy>p{font:var(--fs-300)/1.6 var(--font-ui);max-width:60ch;margin:0}
  .plan-index__row--pick .plan-index__copy>p:not(.plan-index__mark):not(.plan-index__meta){font-size:var(--fs-400)}
  .plan-index__copy .plan-index__meta{color:var(--soft);font-size:var(--fs-200);margin-top:.35rem}
  .plan-index__copy .plan-index__mark{font-size:var(--fs-100)}
  .plan-index__use{margin-top:.5rem;font-size:var(--fs-200);min-height:44px;padding-inline:0}
  .plan-index__media{margin:0;min-width:0}
  .plan-index__media img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:var(--radius-s)}
  .plan-index__media figcaption{margin-top:.4rem;font:var(--fs-100)/1.45 var(--font-ui);color:var(--soft)}
  .plan-guides{padding:2.5rem 0 3rem;scroll-margin-top:8rem}
  .plan-guides__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem 3rem;margin-top:1.25rem}
  .plan-guide{min-width:0}
  .plan-guide h3{font-size:var(--fs-400);margin-bottom:.25rem}
  .plan-guide>p{font:var(--fs-200)/1.6 var(--font-ui);color:var(--soft);margin:0;max-width:52ch}
  .plan-guides__more{margin-top:1.5rem}.plan-guides__more summary{font:600 var(--fs-200)/1.5 var(--font-ui);min-height:44px;display:inline-flex;align-items:center;gap:.5rem;cursor:pointer;list-style:none;color:var(--accent)}.plan-guides__more summary::-webkit-details-marker{display:none}.plan-guides__more summary span{font-weight:400;color:var(--soft)}.plan-guides__more summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media(max-width:45rem){
    .plan-index{padding-bottom:2rem}.plan-guides{padding:2rem 0}
    .plan-index__row--pick{display:flex;flex-direction:column-reverse;gap:1rem;align-items:stretch}
    .plan-index__row--pick h3{font-size:var(--fs-600)}
    .plan-guides__grid{grid-template-columns:1fr;gap:1.25rem}
  }
</style>
