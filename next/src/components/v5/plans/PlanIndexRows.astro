---
import { editableImage } from '../../../lib/inline-edit/attrs';
import { cleanCaption } from '../../../lib/image-caption.mjs';
import type { PlansModel } from './plans-data';
export interface Props { model: PlansModel; }
const { model } = Astro.props;
const itineraries = model.plans.filter(plan => plan.kind === 'itinerary').sort((a,b) => b.editorialPriority - a.editorialPriority);
const guides = model.plans.filter(plan => plan.kind === 'guide').sort((a,b) => a.displayTitle.localeCompare(b.displayTitle));
const [pick, ...rest] = itineraries;
// Caption rule (lib/image-caption.mjs): the place line, then its source.
const caption = (image: { caption?: string; credit?: string } | null) => image?.credit ? [cleanCaption(image.caption), `Photo: ${image.credit}`].filter(Boolean).join(' · ') : '';
---
<!-- One opening: headline, one standfirst, the matcher, and the editor's pick with its photograph.
     The other itineraries follow as image cards; the whole card is the link. Each plan appears once. -->
<section class="plan-index" id="all-plans" aria-labelledby="all-plans-heading" data-plan-index>
  <div class="container">
    <div class="plan-index__lead">
      <div class="plan-index__open">
        <slot name="intro" />
        <slot name="matcher" />
      </div>
      <h2 id="all-plans-heading" class="plan-index__sr">Ready-made itineraries</h2>
      {pick && <article class="plan-index__row plan-index__row--pick" data-plan-row={pick.id}>
        <div class="plan-index__copy">
          <p class="plan-index__mark">Editor’s pick</p>
          <h3><a href={pick.href} data-evt="card_click" data-entity-type={pick.entityType} data-entity-slug={pick.slug} data-surface="plans-index">{pick.displayTitle}</a></h3>
          <p>{pick.editorialReason}</p>
          <p class="plan-index__meta">{pick.meta.join(' · ')}</p>
          <button class="pi-btn pi-btn--text plan-index__use" type="button" data-plan-fork={pick.id} aria-label={`Use this itinerary: ${pick.title}`}>Use this itinerary</button>
        </div>
        {pick.image && <figure class="plan-index__media">
          <img src={pick.image.src} alt={pick.image.alt} loading="eager" fetchpriority="high" decoding="async" width="720" height="480" data-pi-responsive="(max-width: 720px) calc(100vw - 32px), (max-width: 1280px) 50vw, 640px"
            {...editableImage({entityType:pick.entityType,entitySlug:pick.slug,fieldPath:pick.imageField,label:`${pick.title} image`,purpose:'card'})} />
          {caption(pick.image) && <figcaption>{caption(pick.image)}</figcaption>}
        </figure>}
      </article>}
    </div>
    <slot />
    <div class="plan-index__grid">
      {rest.map(plan => <article class="plan-index__row plan-card" data-plan-row={plan.id}>
        {plan.image && <figure class="plan-card__media">
          <img src={plan.image.src} alt={plan.image.alt} loading="lazy" decoding="async" width="720" height="480" data-pi-responsive="(max-width: 720px) calc(100vw - 32px), (max-width: 1280px) 31vw, 400px"
            {...editableImage({entityType:plan.entityType,entitySlug:plan.slug,fieldPath:plan.imageField,label:`${plan.title} image`,purpose:'card'})} />
          {caption(plan.image) && <figcaption>{caption(plan.image)}</figcaption>}
        </figure>}
        <h3><a href={plan.href} data-evt="card_click" data-entity-type={plan.entityType} data-entity-slug={plan.slug} data-surface="plans-index">{plan.displayTitle}</a></h3>
        <p>{plan.editorialReason}</p>
        <p class="plan-index__meta">{plan.meta.join(' · ')}</p>
      </article>)}
    </div>
  </div>
</section>
<section class="plan-guides" id="planning-guides" aria-labelledby="plan-guides-heading">
  <div class="container">
    <h2 id="plan-guides-heading">Planning guides</h2>
    <p class="plan-guides__intro">Advice for choosing your own stops, a place to stay or a bigger occasion.</p>
    <div class="plan-guides__grid">{guides.slice(0,6).map(plan => <article class="plan-guide" data-plan-guide={plan.id}><h3><a href={plan.href}>{plan.displayTitle}</a></h3><p>{plan.verdict}</p></article>)}</div>
    {guides.length > 6 && <details class="plan-guides__more"><summary>More planning guides <span>({guides.length - 6})</span> <span aria-hidden="true">+</span></summary><div class="plan-guides__grid">{guides.slice(6).map(plan => <article class="plan-guide" data-plan-guide={plan.id}><h3><a href={plan.href}>{plan.displayTitle}</a></h3><p>{plan.verdict}</p></article>)}</div></details>}
  </div>
</section>
<style>
  /* Seven sizes: h1 (page), fs-700 section, fs-600 pick, fs-500 card titles, fs-400 body, fs-300 meta, fs-100 captions. */
  .plan-index{padding:var(--space-6) 0 var(--space-8);scroll-margin-top:8rem}
  .plan-index__lead{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);grid-template-areas:"open media" "pick media";gap:var(--space-6) var(--space-7);align-items:start}
  .plan-index__open{grid-area:open}
  /* The pick's copy sits under the opening and its photograph fills the right column. */
  .plan-index__row--pick{display:contents}
  .plan-index__row--pick .plan-index__copy{grid-area:pick;align-self:end}
  .plan-index__row--pick .plan-index__media{grid-area:media}
  .plan-index__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  h2{font:500 var(--fs-700)/1.2 var(--font-display);letter-spacing:-.04em;margin:0}
  .plan-index__mark{font:600 var(--fs-100)/1.4 var(--font-ui);letter-spacing:var(--ls-eyebrow, .1em);text-transform:uppercase;color:var(--accent);margin:0 0 var(--space-2)}
  h3{font:500 var(--fs-500)/1.3 var(--font-display);letter-spacing:-.025em;margin:0 0 var(--space-2)}h3 a{color:var(--text);text-decoration:none}h3 a:hover{text-decoration:underline;text-underline-offset:.15em}
  .plan-index__row--pick h3{font-size:var(--fs-600);line-height:1.2}
  .plan-index__copy>p,.plan-card>p{font:var(--fs-400)/1.6 var(--font-ui);max-width:60ch;margin:0}
  .plan-index .plan-index__meta{color:var(--soft);font-size:var(--fs-300);margin-top:var(--space-2)}
  .plan-index__use{margin-top:var(--space-2);font-size:var(--fs-300);min-height:44px;padding-inline:0}
  .plan-index__media,.plan-card__media{margin:0;min-width:0}
  .plan-index__media img,.plan-card__media img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:var(--radius-s)}
  figcaption{margin-top:var(--space-2);font:var(--fs-100)/1.45 var(--font-ui);color:var(--soft)}
  .plan-index__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-7) var(--space-6);margin-top:var(--space-8)}
  /* The whole card is the link: the title's hit area covers the card. */
  .plan-card{position:relative;min-width:0}
  .plan-card__media{margin-bottom:var(--space-4)}
  .plan-card h3 a::after{content:'';position:absolute;inset:0}
  .plan-card h3 a:focus-visible{outline:none}.plan-card:has(h3 a:focus-visible){outline:2px solid var(--accent);outline-offset:6px;border-radius:var(--radius-s)}
  .plan-card:hover h3 a{text-decoration:underline;text-underline-offset:.15em}
  .plan-guides{padding:var(--space-6) 0 var(--space-8);scroll-margin-top:8rem}
  .plan-guides__intro{font:var(--fs-400)/1.6 var(--font-ui);color:var(--soft);max-width:62ch;margin:var(--space-3) 0 0}
  .plan-guides__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-2) var(--space-6);margin-top:var(--space-5)}
  .plan-guide{position:relative;min-width:0;padding:var(--space-3) 0;min-height:44px}
  .plan-guide h3 a::after{content:'';position:absolute;inset:0}
  .plan-guide h3 a:focus-visible{outline:none}.plan-guide:has(h3 a:focus-visible){outline:2px solid var(--accent);outline-offset:2px;border-radius:var(--radius-s)}
  .plan-guide:hover h3 a{text-decoration:underline;text-underline-offset:.15em}
  .plan-guide>p{font:var(--fs-300)/1.6 var(--font-ui);color:var(--text);margin:0;max-width:52ch}
  .plan-guides__more{margin-top:var(--space-4)}.plan-guides__more summary{font:600 var(--fs-300)/1.5 var(--font-ui);min-height:44px;display:inline-flex;align-items:center;gap:var(--space-2);cursor:pointer;list-style:none;color:var(--accent)}.plan-guides__more summary::-webkit-details-marker{display:none}.plan-guides__more summary span{font-weight:400;color:var(--soft)}.plan-guides__more summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media(max-width:60rem){.plan-index__grid,.plan-guides__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:45rem){
    .plan-index{padding:var(--space-5) 0 var(--space-7)}.plan-guides{padding:var(--space-5) 0 var(--space-7)}
    .plan-index__lead{grid-template-columns:1fr;grid-template-areas:"open" "media" "pick";gap:var(--space-5)}
    .plan-index__grid{grid-template-columns:1fr;gap:var(--space-6);margin-top:var(--space-7)}
    .plan-guides__grid{grid-template-columns:1fr;gap:0}
  }
</style>
