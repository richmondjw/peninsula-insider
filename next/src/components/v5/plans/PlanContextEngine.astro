---
import type { PlansModel } from './plans-data';
import { matchPlans } from './plan-match';
import PlanRecommendation from './PlanRecommendation.astro';
export interface Props { model: PlansModel; }
const { model } = Astro.props;
const initial = matchPlans(model.plans, {});
const recommended = initial.ids.map(id => model.plans.find(plan => plan.id === id)!);
const payload = { plans: Object.fromEntries(model.plans.map(plan => [plan.id, plan])), contexts: model.contexts };
---
<section class="plan-engine" aria-labelledby="plan-engine-heading">
  <div class="container">
    <div class="plan-engine__intro">
      <div><p class="plan-engine__eyebrow">Chosen by Peninsula Insider</p><h2 id="plan-engine-heading" tabindex="-1" data-plan-results-heading>A good place to start</h2></div>
      <a href="#all-plans">See every itinerary <span aria-hidden="true">↓</span></a>
    </div>
    <p class="plan-engine__explanation" data-plan-results-note>A weekend with a bit of everything, plus two other ways to spend your time.</p>
    <p id="pi-results-status" class="plan-engine__sr" role="status" aria-live="polite" aria-atomic="true"></p>
    <div class="plan-engine__answer" data-plan-answer>
      {recommended.map((plan, index) => <PlanRecommendation plan={plan} index={index} />)}
    </div>
    <div class="plan-engine__empty" data-plan-empty hidden>
      <p class="plan-engine__eyebrow">No ready-made match yet</p>
      <h3>We don’t have an itinerary that fits that choice.</h3>
      <p>Try a different combination, or use our planning guides to choose your own stops.</p>
      <a class="pi-btn pi-btn--ghost" href="#planning-guides">Browse planning guides</a>
    </div>
    <aside class="plan-engine__guide-suggestion" data-plan-guide-suggestion hidden>
      <div><p class="plan-engine__eyebrow">A planning guide, to help you choose</p><h3><a data-guide-title></a></h3><p>Wet-weather ideas to read and adapt. This guide does not include a ready-made itinerary.</p></div>
      <a class="pi-btn pi-btn--ghost" data-guide-link>Read guide <span aria-hidden="true">↗</span></a>
    </aside>
    <p class="plan-engine__assurance">Editorial choices. No sign-in needed to use an itinerary. <a href="/me/trip/">Open My Trip</a></p>
  </div>
</section>
<script type="application/json" id="pi-plans-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
<script>
  import { matchPlans, assessPlan, criterionLabel, describeQuery, type MatchQuery, type PlanFit, type QueryLabels, type LengthValue } from './plan-match';
  import type { PlanRecord, PlanContext } from './plans-data';
  import { useEditorialPlan } from '../../../lib/plan-trip-client';
  import { trackEvent } from '../../../lib/v5-analytics';

  type Payload = { plans: Record<string, PlanRecord>; contexts: PlanContext[] };
  // These handlers are installed once; page-specific state is replaced on every navigation.
  let activePayload: Payload | null = null;
  let restoreQuery: (() => void) | null = null;
  window.addEventListener('popstate', () => restoreQuery?.());
  document.addEventListener('click', async event => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-plan-fork]');
    if (!button || button.disabled || !activePayload) return;
    if (button.dataset.planAdded === 'true') { window.location.assign('/me/trip/'); return; }
    const plan = activePayload.plans[button.dataset.planFork ?? ''];
    if (!plan || plan.kind !== 'itinerary') return;
    button.disabled = true;
    try {
      const result = await useEditorialPlan(plan, button);
      if (result === 'added' || result === 'existing') {
        button.textContent = 'Open My Trip';
        button.setAttribute('aria-label', 'Open My Trip');
        button.dataset.planAdded = 'true';
      }
      if (result === 'added') trackEvent('trip_fork', { entity_type: 'itinerary', entity_slug: plan.slug, surface: 'plans' });
    } finally { button.disabled = false; }
  });

  function initPlans() {
    const root = document.querySelector<HTMLElement>('[data-plan-answer]');
    if (!root) { activePayload = null; restoreQuery = null; return; }
    if (root.dataset.bound) return;
    root.dataset.bound = '1';
    let payload: Payload;
    let labels: QueryLabels;
    try {
      payload = JSON.parse(document.getElementById('pi-plans-data')?.textContent ?? '{}');
      labels = JSON.parse(document.getElementById('pi-plan-builder-labels')?.textContent ?? '{}');
    } catch { return; }
    activePayload = payload;
    const plans = Object.values(payload.plans);
    const form = document.querySelector<HTMLFormElement>('[data-plan-form]');
    const matcher = document.querySelector<HTMLDetailsElement>('[data-plan-matcher]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-plan-card]')];
    const responsiveImages = new Map<string, { src: string; srcset: string; sizes: string }>();
    root.querySelectorAll<HTMLImageElement>('[data-slot="image"]').forEach(image => {
      const original = image.dataset.piImageOriginalSrc;
      if (original && image.srcset) responsiveImages.set(original, { src: image.getAttribute('src')!, srcset: image.srcset, sizes: image.sizes });
    });
    const heading = document.querySelector<HTMLElement>('[data-plan-results-heading]');
    const explanation = document.querySelector<HTMLElement>('[data-plan-results-note]');
    const status = document.getElementById('pi-results-status');
    const pending = document.querySelector<HTMLElement>('[data-plan-selection-note]');
    const empty = document.querySelector<HTMLElement>('[data-plan-empty]');
    let query: MatchQuery = {};
    const slot = <T extends HTMLElement = HTMLElement>(el: HTMLElement, name: string) => el.querySelector<T>(`[data-slot="${name}"]`);
    const text = (el: HTMLElement, name: string, value: string) => { const target = slot(el, name); if (target) target.textContent = value; };

    function fillCard(el: HTMLElement, plan: PlanRecord, fit: PlanFit, index: number, asked: number) {
      el.hidden = false;
      text(el, 'label', asked ? (fit.exact ? (index === 0 ? 'Our pick for you' : 'Also matches your choices') : 'A partial match') : (index === 0 ? 'Editor’s pick' : 'Another way to spend it'));
      const title = slot<HTMLAnchorElement>(el, 'title');
      if (title) { title.textContent = plan.displayTitle; title.href = plan.href; title.dataset.entityType = plan.entityType; title.dataset.entitySlug = plan.slug; }
      text(el, 'reason', plan.editorialReason);
      text(el, 'facts', [...plan.meta, ...(plan.pace ? [plan.pace] : [])].join(' · '));
      const read = slot<HTMLAnchorElement>(el, 'read');
      if (read) read.href = plan.href;
      const button = el.querySelector<HTMLButtonElement>('[data-plan-fork]');
      if (button) {
        button.dataset.planFork = plan.id;
        button.removeAttribute('data-plan-added');
        button.disabled = false;
        button.textContent = 'Use this itinerary';
        button.setAttribute('aria-label', `Use this itinerary: ${plan.title}`);
      }
      text(el, 'copy', `${plan.stops.length} stops across ${plan.dayCount === 1 ? 'one day' : `${plan.dayCount} days`}. Yours to adjust in My Trip.`);
      const image = slot<HTMLImageElement>(el, 'image');
      if (image) {
        const media = image.parentElement!;
        media.hidden = !plan.image;
        if (plan.image) {
          const responsive = responsiveImages.get(plan.image.src);
          image.src = responsive?.src ?? plan.image.src;
          if (responsive) {
            image.srcset = responsive.srcset;
            image.sizes = image.dataset.piResponsive ?? responsive.sizes;
            image.dataset.piImageOriginalSrc = plan.image.src;
          } else {
            image.removeAttribute('srcset'); image.removeAttribute('sizes'); image.removeAttribute('data-pi-image-original-src');
          }
          image.alt = plan.image.alt;
          image.dataset.piEntityType = plan.entityType;
          image.dataset.piEntitySlug = plan.slug;
          image.dataset.piFieldPath = plan.imageField;
          image.dataset.piLabel = `${plan.title} image`;
        } else image.removeAttribute('src');
      }
      const fitBox = slot(el, 'fit');
      if (fitBox) fitBox.hidden = asked === 0;
      text(el, 'matched', fit.matched.length ? `Fits: ${fit.matched.map(token => criterionLabel(token, labels)).join(' · ')}` : '');
      const missing = slot(el, 'missing');
      if (missing) {
        missing.hidden = !fit.missing.length;
        const duration = fit.missing.filter(token => token.startsWith('length:'));
        const unsupported = fit.missing.filter(token => !token.startsWith('length:'));
        missing.textContent = [
          duration.length ? `Different duration: ${plan.dayCount} day${plan.dayCount === 1 ? '' : 's'}.` : '',
          unsupported.length ? `Not confirmed for: ${unsupported.map(token => criterionLabel(token, labels)).join(' · ')}.` : '',
        ].filter(Boolean).join(' ');
      }
      const route = slot<HTMLDetailsElement>(el, 'route');
      if (route) route.open = false;
      text(el, 'route-count', `${plan.stops.length} stops +`);
      const days = slot<HTMLOListElement>(el, 'days');
      if (days) {
        days.replaceChildren();
        for (const day of [...new Set(plan.stops.map(stop => stop.day))].sort((a,b) => a-b)) {
          const item = document.createElement('li');
          const label = document.createElement('span'); label.textContent = `Day ${day}`;
          const list = document.createElement('p'); list.textContent = plan.stops.filter(stop => stop.day === day).map(stop => stop.title).join(' → ');
          item.append(label, list); days.append(item);
        }
      }
      const practical: Record<string, string> = {
        booking: plan.bookingNote ?? '',
        driving: plan.driveMins ? `Editorial route estimate: ${plan.driveMins} minutes driving. My Trip recalculates from your selected stops; allow extra time for traffic and parking.` : '',
        verified: plan.verifiedAt ? `Information checked ${new Date(plan.verifiedAt).toLocaleDateString('en-AU', {day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})}. Confirm current hours and booking requirements with each operator.` : '',
      };
      for (const [name, value] of Object.entries(practical)) { const target = slot(el, name); if (target) { target.textContent = value; target.hidden = !value; } }
    }

    function render(announce = false) {
      const result = matchPlans(plans, query, 3);
      cards.forEach((card, index) => {
        const fit = result.fits[index];
        if (fit) fillCard(card, payload.plans[fit.id], fit, index, result.asked);
        else card.hidden = true;
      });
      if (empty) empty.hidden = result.ids.length > 0;
      const guideSuggestion = document.querySelector<HTMLElement>('[data-plan-guide-suggestion]');
      if (guideSuggestion) {
        const guide = query.weather && !result.exact ? plans.filter(plan => plan.kind === 'guide' && (plan.facets.mood ?? []).includes(query.weather!))
          .sort((a,b) => assessPlan(b, query).score - assessPlan(a, query).score || a.id.localeCompare(b.id))[0] : undefined;
        guideSuggestion.hidden = !guide;
        if (guide) {
          const title = guideSuggestion.querySelector<HTMLAnchorElement>('[data-guide-title]');
          const link = guideSuggestion.querySelector<HTMLAnchorElement>('[data-guide-link]');
          if (title) { title.textContent = guide.displayTitle; title.href = guide.href; }
          if (link) link.href = guide.href;
        }
      }
      const title = !result.asked ? 'A good place to start' : result.exact ? 'Your matching itineraries' : result.ids.length ? 'Your closest itineraries' : 'Let’s try another shape';
      if (heading) heading.textContent = title;
      if (explanation) explanation.textContent = !result.asked
        ? 'A weekend with a bit of everything, plus two other ways to spend your time.'
        : `${describeQuery(query, labels)}. ${result.exact ? 'Your best match comes first. Any compromises are shown with each alternative.' : result.ids.length ? 'No itinerary meets every choice. Check the differences beside each suggestion.' : 'No published itinerary has a confirmed match for these choices yet.'}`;
      if (pending) pending.textContent = result.asked ? 'These choices are reflected below.' : 'All choices are optional.';
      if (announce && status) {
        status.textContent = `${title}. ${result.ids.length} itinerar${result.ids.length === 1 ? 'y' : 'ies'} shown. ${result.asked && !result.exact ? 'No itinerary meets every choice.' : ''}`;
        heading?.focus({ preventScroll: true });
        heading?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
      }
    }

    function syncControls() {
      if (!form) return;
      for (const key of ['length','who','weather'] as const) {
        const input = form.elements.namedItem(key) as HTMLSelectElement | null;
        if (input) input.value = query[key] ?? '';
      }
      form.querySelectorAll<HTMLInputElement>('input[name="into"]').forEach(input => input.checked = (query.into ?? []).includes(input.value));
      const season = form.elements.namedItem('season') as HTMLInputElement | null;
      if (season) season.checked = Boolean(query.season);
      const seasonControl = form.querySelector<HTMLElement>('[data-plan-season-control]');
      if (seasonControl) seasonControl.hidden = !query.season;
    }
    function readUrl() {
      const params = new URLSearchParams(location.search);
      const valid = (key: keyof QueryLabels, value: string | null) => value && labels[key]?.[value] ? value : null;
      query = { length: valid('length', params.get('length')) as LengthValue | null, who: valid('who', params.get('who')), weather: valid('weather', params.get('weather')) as 'rainy-day' | null, into: (params.get('into') ?? '').split(',').filter(value => valid('into', value)), season: params.get('season') === 'current' };
      // Old context URLs remain useful, without a second set of controls.
      const context = payload.contexts.find(context => context.id === params.get('context'));
      if (context && !query.length && !query.who && !query.weather && !query.into?.length && !query.season) {
        if (context.key === 'party') query.who = context.value;
        if (context.value === 'one-day' || context.value === 'weekend') query.length = context.value;
        if (context.value === 'rainy-day') query.weather = 'rainy-day';
        else if (context.key === 'cat' || context.key === 'mood') query.into = [context.value];
        if (context.value === 'this-season') query.season = true;
      }
      syncControls();
      if (matcher && (query.length || query.who || query.weather || query.into?.length || query.season || location.hash === '#build')) matcher.open = true;
      render();
    }
    function saveUrl() {
      const url = new URL(location.href);
      for (const key of ['context','length','who','into','weather','season']) url.searchParams.delete(key);
      if (query.length) url.searchParams.set('length', query.length);
      if (query.who) url.searchParams.set('who', query.who);
      if (query.weather) url.searchParams.set('weather', query.weather);
      if (query.into?.length) url.searchParams.set('into', query.into.join(','));
      if (query.season) url.searchParams.set('season', 'current');
      history.pushState({}, '', url);
    }
    form?.addEventListener('submit', event => {
      event.preventDefault();
      const values = new FormData(form);
      query = { length: (values.get('length') || null) as LengthValue | null, who: (values.get('who') || null) as string | null, into: values.getAll('into').map(String), weather: (values.get('weather') || null) as 'rainy-day' | null, season: values.get('season') === 'current' };
      saveUrl(); render(true);
      trackEvent('filter_apply', { surface: 'plans-matcher', label: describeQuery(query, labels) || 'editorial picks' });
    });
    form?.addEventListener('reset', event => { event.preventDefault(); query = {}; syncControls(); saveUrl(); render(true); });
    form?.addEventListener('change', () => { if (pending) pending.textContent = 'Choose “Find my plan” to update the suggestions.'; });
    restoreQuery = readUrl;
    readUrl();
  }
  initPlans();
  document.addEventListener('astro:page-load', initPlans);
</script>
<style>
  .plan-engine{padding:0 0 3.5rem}
  .plan-engine__intro{display:flex;align-items:end;justify-content:space-between;gap:1rem}
  .plan-engine__eyebrow{font:600 .68rem/1.4 var(--font-ui);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 .5rem}
  h2{font:500 clamp(1.65rem,3vw,2.2rem)/1.2 var(--font-display);letter-spacing:-.04em;margin:0;scroll-margin-top:8rem}
  h2:focus{outline:none}h2:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
  .plan-engine__intro>a{font-size:.85rem;white-space:nowrap;text-underline-offset:.2em}
  .plan-engine__explanation{font:.95rem/1.65 var(--font-ui);color:var(--soft);max-width:78ch;margin:.9rem 0 1.8rem}
  .plan-engine__answer{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem}
  .plan-engine__assurance{font:.8rem/1.6 var(--font-ui);color:var(--soft);margin:1.5rem 0 0}.plan-engine__assurance a{margin-left:.25rem}
  .plan-engine__guide-suggestion{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding:1.5rem;border:1px solid var(--border);margin-top:1.5rem}
  .plan-engine__guide-suggestion[hidden]{display:none}
  .plan-engine__guide-suggestion h3{font:500 1.15rem/1.4 var(--font-display);margin:.5rem 0}.plan-engine__guide-suggestion h3 a{color:var(--text)}
  .plan-engine__guide-suggestion div>p:last-child{font-size:.85rem;color:var(--soft);margin:0;max-width:60ch}.plan-engine__guide-suggestion>a{flex-shrink:0}
  .plan-engine__empty{padding:2rem;background:var(--bg-alt);border-block:1px solid var(--border)}
  .plan-engine__empty h3{font:500 1.5rem/1.3 var(--font-display);max-width:30ch;margin:0 0 .8rem}
  .plan-engine__empty p{max-width:55ch}
  .plan-engine__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  @media(max-width:45rem){.plan-engine__answer{grid-template-columns:1fr;gap:1.5rem}.plan-engine__intro{align-items:start;flex-direction:column;gap:.7rem}.plan-engine__explanation{margin-bottom:1.25rem}.plan-engine{padding-bottom:2rem}.plan-engine__guide-suggestion{align-items:start;flex-direction:column}}
</style>
