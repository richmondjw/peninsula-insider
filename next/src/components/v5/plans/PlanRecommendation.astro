---
import { editableImage } from '../../../lib/inline-edit/attrs';
import { routePreview } from './plan-preview';
import type { PlanRecord } from './plans-data';
export interface Props { plan: PlanRecord; index: number; }
const { plan, index } = Astro.props;
const days = [...new Set(plan.stops.map(stop => stop.day))].sort((a,b) => a-b);
const facts = [...plan.meta];
if (plan.pace) facts.push(plan.pace);
const checked = plan.verifiedAt ? new Date(plan.verifiedAt).toLocaleDateString('en-AU', { day:'numeric',month:'short',year:'numeric',timeZone:'UTC' }) : '';
---
<article class:list={['plan-recommendation', { 'plan-recommendation--featured': index === 0 }]} data-plan-card={index}>
  <div class="plan-recommendation__body">
    <p class="plan-recommendation__mark" data-slot="label">{index === 0 ? 'Editor’s pick' : 'Another way to spend it'}</p>
    <h3><a href={plan.href} data-slot="title" data-evt="card_click" data-entity-type={plan.entityType} data-entity-slug={plan.slug} data-surface="plans-recommendation">{plan.displayTitle}</a></h3>
    <p class="plan-recommendation__reason" data-slot="reason">{plan.editorialReason}</p>
    <p class="plan-recommendation__facts" data-slot="facts">{facts.join(' · ')}</p>
    <div class="plan-recommendation__fit" data-slot="fit" hidden>
      <p data-slot="matched"></p><p class="plan-recommendation__missing" data-slot="missing"></p>
    </div>
    <div class="plan-recommendation__preview">
      <p data-slot="route-preview">{routePreview(plan)}</p>
      <p data-slot="booking-preview" hidden={!plan.bookingNote}>{plan.bookingNote}</p>
      <p>Plan transport between stops, and check the route for your dates before booking.</p>
    </div>
    <div class="plan-recommendation__actions">
      <a class:list={['pi-btn', index === 0 ? 'pi-btn--solid' : 'pi-btn--ghost']} href={plan.href} data-slot="read">See the itinerary <span aria-hidden="true">↗</span></a>
      <button type="button" class="pi-btn pi-btn--text" data-plan-fork={plan.id} aria-label={`Use this itinerary: ${plan.title}`}>Use this itinerary</button>
    </div>
    <p class="plan-recommendation__copy" data-slot="copy">{plan.stops.length} stops across {plan.dayCount === 1 ? 'one day' : `${plan.dayCount} days`}. Yours to adjust in My Trip.</p>
  </div>
  <div class="plan-recommendation__media" hidden={!plan.image}>
    <img src={plan.image?.src} alt={plan.image?.alt ?? ''} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="720" height="520" data-slot="image" data-pi-responsive={plan.image ? (index === 0 ? '(max-width: 720px) calc(100vw - 72px), (max-width: 1280px) 42vw, 520px' : '(max-width: 720px) 82px, 112px') : undefined}
      {...editableImage({entityType:plan.entityType,entitySlug:plan.slug,fieldPath:plan.imageField,label:`${plan.title} image`,purpose:'card'})} />
  </div>
  <details class="plan-recommendation__route" data-slot="route">
    <summary><span>At a glance</span><span data-slot="route-count">{plan.stops.length} stops <span aria-hidden="true">+</span></span></summary>
    <div class="plan-recommendation__route-inner">
      <ol class="plan-recommendation__days" data-slot="days">{days.map(day => <li><span>Day {day}</span><p>{plan.stops.filter(stop => stop.day === day).map(stop => stop.title).join(' → ')}</p></li>)}</ol>
      <p class="plan-recommendation__practical" data-slot="booking" hidden={!plan.bookingNote}>{plan.bookingNote}</p>
      <p class="plan-recommendation__practical" data-slot="driving" hidden={!plan.driveMins}>{plan.driveMins ? `Editorial route estimate: ${plan.driveMins} minutes driving. My Trip recalculates from your selected stops; allow extra time for traffic and parking.` : ''}</p>
      <p class="plan-recommendation__practical" data-slot="verified" hidden={!checked}>{checked ? `Information checked ${checked}. Confirm current hours and booking requirements with each operator.` : ''}</p>
    </div>
  </details>
</article>
<style is:global>
  .plan-recommendation{display:grid;grid-template-columns:minmax(0,1fr) 112px;column-gap:1.1rem;align-content:start;border-top:1px solid var(--border);padding:1.5rem 0 0;min-width:0}
  .plan-recommendation[hidden]{display:none}
  .plan-recommendation__body{min-width:0}
  .plan-recommendation__mark{font:600 .68rem/1.4 var(--font-ui);text-transform:uppercase;letter-spacing:.13em;color:var(--accent);margin:0 0 .7rem}
  .plan-recommendation h3{font:500 clamp(1.35rem,2vw,1.7rem)/1.25 var(--font-display);letter-spacing:-.035em;margin:0 0 .75rem;max-width:23ch}
  .plan-recommendation h3 a{color:var(--text);text-decoration:none}
  .plan-recommendation h3 a:hover{text-decoration:underline;text-underline-offset:.15em}
  .plan-recommendation__reason{font:.96rem/1.65 var(--font-ui);margin:0 0 .9rem;color:var(--text);max-width:58ch}
  .plan-recommendation__facts{font:.79rem/1.6 var(--font-ui);color:var(--soft);margin:0 0 1rem}
  .plan-recommendation__media{align-self:start;aspect-ratio:1;overflow:hidden;background:var(--bg-alt)}
  .plan-recommendation__media img{height:100%;width:100%;object-fit:cover;display:block}
  .plan-recommendation__preview{border-block:1px solid var(--border);padding:.6rem 0;margin:0 0 1rem;font:.8rem/1.6 var(--font-ui);max-width:65ch}.plan-recommendation__preview p{margin:.35rem 0}.plan-recommendation__preview p:last-child{color:var(--soft)}
  .plan-recommendation__actions{display:flex;align-items:center;gap:.45rem .7rem;flex-wrap:wrap}
  .plan-recommendation__actions .pi-btn{font-size:.82rem;min-height:44px}
  .plan-recommendation__copy{font:.73rem/1.5 var(--font-ui);color:var(--soft);margin:.8rem 0 0}
  .plan-recommendation__fit{margin:0 0 1rem;border-left:1px solid var(--accent);padding:.2rem 0 .2rem .7rem;font:.8rem/1.55 var(--font-ui)}
  .plan-recommendation__fit p{margin:0}.plan-recommendation__missing{color:var(--soft);margin-top:.2rem!important}
  .plan-recommendation__route{grid-column:1/-1;margin-top:1.2rem;border-top:1px solid color-mix(in srgb,var(--border) 55%,transparent)}
  .plan-recommendation__route summary{display:flex;justify-content:space-between;gap:1rem;list-style:none;cursor:pointer;padding:.8rem 0;font:600 .79rem/1.5 var(--font-ui)}
  .plan-recommendation__route summary::-webkit-details-marker{display:none}
  .plan-recommendation__route summary>span:last-child{font-weight:400;color:var(--soft)}
  .plan-recommendation__route summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .plan-recommendation__route-inner{padding:.25rem 0 1rem}
  .plan-recommendation__days{list-style:none;padding:0;margin:0;display:grid;gap:.7rem}
  .plan-recommendation__days li{display:grid;grid-template-columns:3.4rem minmax(0,1fr);gap:.4rem;font:.82rem/1.6 var(--font-ui)}
  .plan-recommendation__days li>span{font-weight:600;color:var(--accent)}
  .plan-recommendation__days p{margin:0;color:var(--soft)}
  .plan-recommendation__practical{font:.78rem/1.6 var(--font-ui);color:var(--soft);margin:.9rem 0 0}
  .plan-recommendation--featured{grid-column:1/-1;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:0 2.5rem;border:0;background:var(--bg-alt);padding:2rem}
  .plan-recommendation--featured h3{font-size:clamp(1.9rem,3.5vw,2.85rem);max-width:17ch;line-height:1.13;margin-bottom:1rem}
  .plan-recommendation--featured .plan-recommendation__reason{font-size:1rem}
  .plan-recommendation--featured .plan-recommendation__media{aspect-ratio:4/3;align-self:center}
  .plan-recommendation--featured .plan-recommendation__facts{font-size:.85rem}
  .plan-recommendation--featured .plan-recommendation__route{margin-top:1.5rem}
  .plan-recommendation--featured .plan-recommendation__route summary{padding-bottom:0}
  .plan-recommendation--featured .plan-recommendation__route[open] summary{padding-bottom:1rem}
  @media(max-width:65rem){.plan-recommendation{grid-template-columns:minmax(0,1fr) 86px}.plan-recommendation--featured{grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);column-gap:1.5rem;padding:1.5rem}}
  @media(max-width:45rem){
    .plan-recommendation{grid-template-columns:minmax(0,1fr) 82px;padding-top:1.2rem;column-gap:.8rem}
    .plan-recommendation--featured{grid-template-columns:1fr;padding:1.2rem}
    .plan-recommendation--featured .plan-recommendation__body{order:1}
    .plan-recommendation--featured .plan-recommendation__media{order:0;margin-bottom:1.2rem;aspect-ratio:2.3}
    .plan-recommendation--featured .plan-recommendation__route{order:2}
    .plan-recommendation--featured h3{font-size:1.85rem;max-width:22ch}
    .plan-recommendation__actions .pi-btn{padding-inline:.8rem}
  }
</style>
