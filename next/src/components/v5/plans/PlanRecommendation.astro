---
import { editableImage } from '../../../lib/inline-edit/attrs';
import { routePreviewParts, planFacts, stopsSummary } from './plan-preview';
import type { PlanRecord } from './plans-data';
export interface Props { plan: PlanRecord; index: number; }
const { plan, index } = Astro.props;
const featured = index === 0;
const days = [...new Set(plan.stops.map(stop => stop.day))].sort((a,b) => a-b);
const facts = planFacts(plan);
const checked = plan.verifiedAt ? new Date(plan.verifiedAt).toLocaleDateString('en-AU', { day:'numeric',month:'short',year:'numeric',timeZone:'UTC' }) : '';
---
<article class:list={['plan-recommendation', { 'plan-recommendation--featured': featured }]} data-plan-card={index}>
  <div class="plan-recommendation__media" hidden={!plan.image}>
    <img src={plan.image?.src} alt={plan.image?.alt ?? ''} loading={featured ? 'eager' : 'lazy'} decoding="async" width="720" height="480" data-slot="image" data-pi-responsive={plan.image ? (featured ? '(max-width: 720px) calc(100vw - 72px), (max-width: 1280px) 42vw, 520px' : '(max-width: 767px) 100vw, 40vw') : undefined}
      {...editableImage({entityType:plan.entityType,entitySlug:plan.slug,fieldPath:plan.imageField,label:`${plan.title} image`,purpose:'card'})} />
  </div>
  <div class="plan-recommendation__body">
    <p class="plan-recommendation__mark" data-slot="label">{featured ? 'Editor’s pick' : 'Another way to spend it'}</p>
    <h3><a href={plan.href} data-slot="title" data-evt="card_click" data-entity-type={plan.entityType} data-entity-slug={plan.slug} data-surface="plans-recommendation">{plan.displayTitle}</a></h3>
    <p class="plan-recommendation__reason" data-slot="reason">{plan.editorialReason}</p>
    <ul class="plan-recommendation__facts" data-slot="facts" role="list">{facts.map(fact => <li>{fact}</li>)}</ul>
    <div class="plan-recommendation__fit" data-slot="fit" hidden>
      <p data-slot="matched"></p><p class="plan-recommendation__missing" data-slot="missing"></p>
    </div>
    <div class="plan-recommendation__preview">
      <ol class="plan-route plan-recommendation__route-line" data-slot="route-preview" role="list">{routePreviewParts(plan).map(part => <li><span class="plan-day-label">{part.label}</span>{part.route}</li>)}</ol>
    </div>
    <div class="plan-recommendation__actions">
      <a class="pi-btn pi-btn--solid" href={plan.href} data-slot="read">See the itinerary <span aria-hidden="true">→</span></a>
      <button type="button" class="pi-btn pi-btn--text" data-plan-fork={plan.id} aria-label={`Use this itinerary: ${plan.title}`}>Use this itinerary</button>
    </div>
  </div>
  <details class="plan-recommendation__route" data-slot="route">
    <summary><span data-slot="route-summary">{stopsSummary(plan.stops.length)}</span><span class="plan-recommendation__chevron" aria-hidden="true"></span></summary>
    <div class="plan-recommendation__route-inner">
      <ol class="plan-recommendation__days" data-slot="days">{days.map(day => <li><span>Day {day}</span><p>{plan.stops.filter(stop => stop.day === day).map(stop => stop.title).join(' → ')}</p></li>)}</ol>
      <p class="plan-recommendation__practical" data-slot="booking" hidden={!plan.bookingNote}>{plan.bookingNote}</p>
      <p class="plan-recommendation__practical" data-slot="driving" hidden={!plan.driveMins}>{plan.driveMins ? `Editorial route estimate: ${plan.driveMins} minutes driving. My Trip recalculates from your selected stops; allow extra time for traffic and parking.` : ''}</p>
      <p class="plan-recommendation__practical" data-slot="verified" hidden={!checked}>{checked ? `Information checked ${checked}. Confirm current hours and booking requirements with each operator.` : ''}</p>
    </div>
  </details>
</article>
<style is:global>
  .plan-recommendation{display:flex;flex-direction:column;height:100%;min-width:0}
  .plan-recommendation[hidden]{display:none}
  .plan-recommendation__media{aspect-ratio:3/2;overflow:hidden;border-radius:var(--radius-m);background:var(--bg-alt);margin:0 0 var(--space-5)}
  .plan-recommendation__media[hidden]{display:none}
  .plan-recommendation__media img{display:block;width:100%;height:100%;object-fit:cover}
  .plan-recommendation__body{display:flex;flex-direction:column;flex:1 1 auto;min-width:0}
  .plan-recommendation__mark{font:600 var(--fs-100)/1.4 var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-eyebrow);color:var(--sand-text);margin:0 0 var(--space-3)}
  .plan-recommendation h3{font:600 var(--fs-600)/1.2 var(--font-display);letter-spacing:var(--ls-display);color:var(--text);margin:0 0 var(--space-3);text-wrap:balance}
  .plan-recommendation h3 a{color:inherit;text-decoration:none}
  .plan-recommendation h3 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.15em}
  .plan-recommendation__reason{font:var(--fs-400)/1.6 var(--font-ui);margin:0 0 var(--space-3);color:var(--text);max-width:62ch;text-wrap:pretty}
  .plan-recommendation__facts{display:flex;flex-wrap:wrap;gap:0 .5em;list-style:none;padding:0;margin:0 0 var(--space-5);font:var(--fs-200)/1.5 var(--font-ui);color:var(--soft)}
  .plan-recommendation__facts li{white-space:nowrap}
  .plan-recommendation__facts li:not(:last-child)::after{content:'\00B7';content:'\00B7' / '';margin-left:.5em;color:var(--border-strong)}
  .plan-recommendation__preview{border-block:1px solid var(--border);padding:var(--space-3) 0;margin:0 0 var(--space-5);font:var(--fs-300)/1.6 var(--font-ui)}
  .plan-route{list-style:none;padding:0;margin:0;max-width:68ch}
  .plan-route li{display:block;margin:var(--space-1) 0;text-wrap:pretty}
  .plan-route .plan-day-label{white-space:nowrap;font-weight:600;color:var(--text)}
  .plan-recommendation__actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-2) var(--space-5);margin-top:auto}
  .plan-recommendation__actions .pi-btn--solid{min-height:48px;gap:.35em}
  .plan-recommendation__actions .pi-btn--text{padding-inline:0;min-height:44px;font-weight:600}
  .plan-recommendation__fit{margin:0 0 var(--space-5);border-left:1px solid var(--harbour);padding:var(--space-1) 0 var(--space-1) var(--space-3);font:var(--fs-300)/1.55 var(--font-ui)}
  .plan-recommendation__fit[hidden]{display:none}
  .plan-recommendation__fit p{margin:0}.plan-recommendation__missing{color:var(--soft);margin-top:var(--space-1)!important}
  .plan-recommendation__route{margin-top:var(--space-5);border-top:1px solid var(--border)}
  .plan-recommendation__route summary{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);min-height:48px;padding:var(--space-2) 0;list-style:none;cursor:pointer;font:600 var(--fs-300)/1.4 var(--font-ui);color:var(--text)}
  .plan-recommendation__route summary::-webkit-details-marker{display:none}
  .plan-recommendation__route summary:focus-visible{outline:var(--focus-ring);outline-offset:2px}
  .plan-recommendation__chevron{flex:none;width:.6rem;height:.6rem;margin-right:.3rem;border-right:2px solid var(--harbour);border-bottom:2px solid var(--harbour);transform:translateY(-25%) rotate(45deg);transition:transform var(--dur-fast) var(--ease-enter)}
  .plan-recommendation__route[open] .plan-recommendation__chevron{transform:translateY(25%) rotate(-135deg)}
  .plan-recommendation__route-inner{padding:var(--space-2) 0 var(--space-4)}
  .plan-recommendation__days{list-style:none;padding:0;margin:0;display:grid;gap:var(--space-3)}
  .plan-recommendation__days li{display:grid;grid-template-columns:3.5rem minmax(0,1fr);gap:var(--space-2);font:var(--fs-300)/1.6 var(--font-ui)}
  .plan-recommendation__days li>span{font-weight:600;color:var(--harbour);white-space:nowrap}
  .plan-recommendation__days p{margin:0;color:var(--soft)}
  .plan-recommendation__practical{font:var(--fs-200)/1.6 var(--font-ui);color:var(--soft);margin:var(--space-3) 0 0;max-width:68ch}
  .plan-recommendation--featured{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);grid-template-areas:"body media" "route route";column-gap:var(--space-7);height:auto;padding:var(--space-6) var(--space-6) var(--space-5);border:1px solid var(--border);border-radius:var(--radius-l);background:var(--paper-warm,#F2EFEA)}
  .plan-recommendation--featured:has(>.plan-recommendation__media[hidden]){grid-template-columns:minmax(0,1fr);grid-template-areas:"body" "route"}
  .plan-recommendation--featured .plan-recommendation__media{grid-area:media;margin:0;aspect-ratio:3/2;align-self:start}
  /* The featured body is composed, not stretched: its actions sit one step under the route rule and the
     column centres against the image, instead of margin-top:auto opening a void above the button. */
  .plan-recommendation--featured .plan-recommendation__body{grid-area:body;align-self:center}
  .plan-recommendation--featured .plan-recommendation__actions{margin-top:0}
  .plan-recommendation--featured .plan-recommendation__route{grid-area:route}
  .plan-recommendation--featured h3{font-size:clamp(1.5rem,1.2rem + 1.2vw,2.25rem);line-height:1.12;margin-bottom:var(--space-4)}
  @media(max-width:56rem){
    .plan-recommendation--featured{grid-template-columns:minmax(0,1fr);grid-template-areas:"media" "body" "route";padding:var(--space-5)}
    .plan-recommendation--featured .plan-recommendation__media{margin-bottom:var(--space-5)}
  }
  /* Every card stacks its action pair the same way on phones, whatever its padding. */
  @media(max-width:45rem){
    .plan-recommendation__actions{flex-direction:column;align-items:flex-start;gap:var(--space-3)}
  }
  @media(prefers-reduced-motion:reduce){.plan-recommendation__chevron{transition:none}}
</style>
