---
import { FACET_OPTIONS, type FacetKey } from '../../../lib/facets';
import type { PlansModel } from './plans-data';
export interface Props { model: PlansModel; }
const { model } = Astro.props;
const present = (key: FacetKey, excluded: string[] = []) => FACET_OPTIONS[key].filter(option =>
  !excluded.includes(option.value) && model.plans.some(plan => (plan.facets[key] ?? []).includes(option.value)));
const interests = [...present('cat', ['plan']), ...present('mood', ['rainy-day'])]
  .filter((option, i, list) => list.findIndex(item => item.value === option.value) === i);
const lengths = [{ value: 'one-day', label: 'One day' }, { value: 'weekend', label: 'A weekend' }, { value: 'longer', label: 'Two nights or more' }];
const who = present('party');
const labels = { length: Object.fromEntries(lengths.map(o => [o.value, o.label])), who: Object.fromEntries(who.map(o => [o.value, o.label])), into: Object.fromEntries(interests.map(o => [o.value, o.label])), weather: { 'rainy-day': 'Wet-weather option' } };
---
<div class="plan-builder" id="build">
  <details class="plan-builder__panel" data-plan-matcher>
    <summary>
      <span id="plan-builder-heading" class="plan-builder__heading">Narrow it down</span>
      <span class="plan-builder__toggle" aria-hidden="true">+</span>
    </summary>
    <form class="plan-builder__form" data-plan-form aria-labelledby="plan-builder-heading">
      <div class="plan-builder__fields">
        <label>How long have you got?<select name="length" data-build-key="length"><option value="">Any length</option>{lengths.map(o => <option value={o.value}>{o.label}</option>)}</select></label>
        <label>Who’s coming?<select name="who" data-build-key="who"><option value="">Anyone</option>{who.map(o => <option value={o.value}>{o.label}</option>)}</select></label>
        <label>Weather<select name="weather" data-build-key="weather"><option value="">No preference</option><option value="rainy-day">Wet-weather option</option></select></label>
      </div>
      <fieldset class="plan-builder__interests"><legend>What would make the day? <span>Choose any</span></legend>
        <div class="plan-builder__chips">{interests.map(o => <label class="plan-builder__chip"><input type="checkbox" name="into" value={o.value} /><span>{o.label}</span></label>)}</div>
      </fieldset>
      <label class="plan-builder__season" data-plan-season-control hidden><input type="checkbox" name="season" value="current" /> This season <span>Carried over from your shared link. Clear to search every season.</span></label>
      <div class="plan-builder__actions"><button type="submit" class="pi-btn pi-btn--solid" data-build-go>Find my plan <span aria-hidden="true">↓</span></button><button type="reset" class="pi-btn pi-btn--text" data-build-clear>Reset choices</button><span data-plan-selection-note></span></div>
    </form>
  </details>
  <noscript><p>Every itinerary is listed below. Matching and copying a trip need JavaScript.</p></noscript>
</div>
<script type="application/json" id="pi-plan-builder-labels" set:html={JSON.stringify(labels).replace(/</g, '\\u003c')} />
<style>
  /* One quiet line until opened: the itineraries, not the form, own the first screen. */
  .plan-builder{margin:0 0 .5rem;scroll-margin-top:8rem}
  summary{list-style:none;cursor:pointer;display:inline-flex;align-items:center;gap:.5rem;min-height:44px;font:600 var(--fs-300)/1.4 var(--font-ui);color:var(--accent)}
  summary::-webkit-details-marker{display:none}
  summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
  .plan-builder__toggle{font-size:var(--fs-400);line-height:1;transition:transform 150ms ease}
  details[open] .plan-builder__toggle{transform:rotate(45deg)}
  .plan-builder__form{padding:1rem 0 1.5rem}
  .plan-builder__fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}
  .plan-builder__fields label,legend{font-size:var(--fs-200);font-weight:600;color:var(--text)}
  select{display:block;width:100%;margin-top:.5rem;padding:.7rem 2rem .7rem .8rem;border:1px solid var(--border-control);background:var(--bg);color:var(--text);font:400 var(--fs-300)/1.5 var(--font-ui);border-radius:var(--radius-s);min-height:46px}
  select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .plan-builder__interests{padding:0;margin:1.5rem 0;border:0;min-width:0}
  legend{margin-bottom:.6rem;padding:0}legend span{font-weight:400;color:var(--soft);margin-left:.4rem}
  .plan-builder__chips{display:flex;flex-wrap:wrap;gap:.5rem}
  .plan-builder__chip{position:relative;display:inline-flex;cursor:pointer}
  .plan-builder__chip input{position:absolute;opacity:0;width:1px;height:1px}
  .plan-builder__chip span{display:flex;align-items:center;border-radius:var(--radius-pill);padding:.5rem .9rem;min-height:44px;background:var(--bg-alt);font-size:var(--fs-200);line-height:1.25}
  .plan-builder__chip input:checked+span{background:var(--accent);color:var(--white)}
  .plan-builder__chip input:focus-visible+span{outline:2px solid var(--accent);outline-offset:3px}
  .plan-builder__actions{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap}.plan-builder__actions>span{margin-left:auto;font-size:var(--fs-200);color:var(--soft)}
  .plan-builder__season{display:flex;align-items:center;gap:.5rem;margin-bottom:1rem;font-size:var(--fs-200);min-height:44px}.plan-builder__season[hidden]{display:none}.plan-builder__season span{color:var(--soft);font-size:var(--fs-100)}
  @media(max-width:45rem){.plan-builder__fields{grid-template-columns:1fr}.plan-builder__actions>span{flex-basis:100%;margin:0}}
  @media(prefers-reduced-motion:reduce){.plan-builder__toggle{transition:none}}
</style>
