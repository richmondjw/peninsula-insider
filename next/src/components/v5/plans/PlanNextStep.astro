---
/**
 * PlanNextStep (v5, /plans/ hub) - the quiet close.
 * One sentence and one link for visitors no ready-made plan suits. It also
 * carries the page's single "no sign-in needed" assurance. No Dispatch here;
 * the footer carries the page's single sign-up.
 */
---

<section class="plan-next" aria-labelledby="plan-next-heading">
  <div class="container">
    <h2 class="plan-next__heading" id="plan-next-heading">None of these fit?</h2>
    <p class="plan-next__sub">Choose your own places and days out. My Trip keeps your stops together, ready to share or print, with no sign-in needed. <a href="/me/trip/">Open My Trip <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .plan-next {
    padding: var(--space-5, 1.5rem) 0 var(--space-7, 2.5rem);
  }
  .plan-next__heading {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: var(--fs-500);
    font-weight: var(--fw-display, 600);
    line-height: var(--lh-heading, 1.15);
  }
  .plan-next__sub {
    margin: 0;
    font-family: var(--font-ui);
    color: var(--soft);
    max-width: 62ch;
  }
  .plan-next__sub a {
    white-space: nowrap;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }
</style>
