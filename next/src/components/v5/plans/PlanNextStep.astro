---
/**
 * PlanNextStep (v5, /plans/ hub section 9.6) - the next-step band.
 * Two exits when no ready-made plan fits: Ask PI to shape one, or start a
 * blank My Trip. No Dispatch here; the footer carries the page's single
 * Dispatch instance (hub spec 19 removed the mid-page NewsletterBlock).
 */
---

<section class="plan-next pi-section" aria-labelledby="plan-next-heading">
  <div class="container">
    <div class="plan-next__inner">
      <div class="plan-next__text">
        <h2 class="pi-h2 plan-next__heading" id="plan-next-heading">None of these fit?</h2>
        <p class="pi-section-dek plan-next__sub">Choose your own places and days out. My Trip keeps your stops together, ready to share or print.</p>
      </div>
      <div class="plan-next__actions">
        <a class="pi-btn pi-btn--solid" href="/search/" data-open-search data-evt="search_open" data-surface="plans">Search the site</a>
        <a class="pi-btn pi-btn--ghost" href="/me/trip/">Open My Trip</a>
      </div>
    </div>
  </div>
</section>

<style>
  .plan-next__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-6);
    padding: var(--space-6);
    background: var(--paper-warm, #F2EFEA);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
  }
  .plan-next__text {
    flex: 1 1 28rem;
    min-width: 0;
  }
  .plan-next__sub {
    max-width: 52ch;
  }
  .plan-next__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .plan-next__actions .pi-btn {
    min-height: 48px;
  }
  @media (max-width: 45rem) {
    .plan-next__inner {
      padding: var(--space-5);
    }
  }
</style>
