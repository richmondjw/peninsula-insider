<script>
  function useWebpFallback(img: HTMLImageElement) {
    const sources = img.closest('picture')?.querySelectorAll('source[data-pi-avif-source]');
    if (!sources?.length) return;
    sources.forEach(source => source.remove());
    // Re-evaluate the unchanged WebP srcset after a failed AVIF download.
    img.src = img.getAttribute('src') || '';
  }
  document.addEventListener('error', event => {
    if (event.target instanceof HTMLImageElement) useWebpFallback(event.target);
  }, true);
  const check = () => document.querySelectorAll<HTMLImageElement>('picture img').forEach(img => {
    if (img.complete && !img.naturalWidth) useWebpFallback(img);
  });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', check, {once:true});
  else check();
  document.addEventListener('astro:page-load', check);
</script>
