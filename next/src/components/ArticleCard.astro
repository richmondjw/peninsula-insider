---
/**
 * ArticleCard  -  compact editorial card for Journal index and related reads.
 * Uses the .venue-card--editorial variant: whole card is clickable (stretched
 * link on the title), no CTA pill, no hairline divider above the dek.
 */
import { formatLabel, routeSlug } from '../lib/editorial';
import PiSaveActions from './PiSaveActions.astro';

export interface Props {
  article: any;
  /** Hide the format type chip - useful on format-grouped sections where
   *  the section heading already names the format. */
  hideType?: boolean;
  /** Optional local label override for index pages that group formats differently. */
  typeLabel?: string;
}

const { article, hideType = false, typeLabel } = Astro.props;
const slug = routeSlug(article);
const articleBase = (article.data.section ?? 'journal') === 'plans' ? '/plans' : '/journal';

const namedAuthor = !article.data.houseByline
  ? String(article.data.author?.id ?? article.data.author ?? '').trim()
  : '';
const dateLabel = article.data.publishedAt
  ? article.data.publishedAt.toLocaleDateString('en-AU', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
const meta = namedAuthor ? `By ${namedAuthor}` : dateLabel;
const readingTime = article.data.readingTimeMinutes;
---

<article class="venue-card venue-card--editorial">
  <div class="venue-card__top">
    {!hideType && <span class="venue-card__type">{typeLabel ?? formatLabel[article.data.format] ?? article.data.format}</span>}
    {readingTime && <span class="venue-card__price">{readingTime} min</span>}
  </div>
  <h3 class="venue-card__name">
    <a href={`${articleBase}/${slug}/`}>{article.data.title}</a>
  </h3>
  {meta && <p class="venue-card__place">{meta}</p>}
  <p class="venue-card__signature">{article.data.dek}</p>
  <PiSaveActions
    kind="article"
    slug={slug}
    title={article.data.title}
    href={`${articleBase}/${slug}/`}
    section={article.data.section ?? 'journal'}
    dek={article.data.dek}
    imageUrl={article.data.heroImage?.src}
  />
</article>
