    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.3",
    "@astrojs/react": "^5.0.4",
    "@astrojs/vercel": "^10.0.6",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/vite": "^4.3.0",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "potrace": "^2.1.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
