# Resend API key — set in Vercel Environment Variables
RESEND_API_KEY=re_xxxxx
# Beehiiv signup popup: `preview` for QA builds, `on` for production, unset/off to disable.
# PUBLIC_NEWSLETTER_POPUP=preview


# PI-008 occurrence model: `off` restores the previous What’s On renderer,
# `on` forces the new one even when the nightly expiry job is unhealthy.
# Unset is the default and the safe one: the new model runs only while
# next/src/data/event-expiry-state.json says the expiry job is alive.
# PUBLIC_EVENT_OCCURRENCE_MODEL=off
