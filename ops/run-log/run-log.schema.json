{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peninsulainsider.com.au/schemas/run-log.schema.json",
  "title": "Peninsula Insider — Run-log entry",
  "description": "One execution of a recurring PI job. See ops/run-log-standard.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "jobName",
    "jobSource",
    "startedAt",
    "status",
    "mutation"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "description": "UUID. Should match Mission Control cron_job_runs.id when applicable."
    },
    "parentRunId": {
      "type": ["string", "null"],
      "description": "When set, this entry is a sub-phase of the named composite run."
    },
    "jobName": {
      "type": "string",
      "description": "Matches a name in ops/editorial-jobs.json or the cron registry."
    },
    "jobSource": {
      "type": "string",
      "enum": ["openclaw-cron", "github-actions", "manual", "composite"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "durationMs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "partial", "skipped"]
    },
    "mutation": {
      "type": "string",
      "enum": ["scan-only", "report-only", "mutating-content", "mutating-live", "mutating-config"]
    },
    "surfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "counts": {
      "type": "object",
      "properties": {
        "scanned": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": ["integer", "number", "string", "boolean"] }
    },
    "alertSent": { "type": "boolean" },
    "alertChannel": {
      "type": ["string", "null"],
      "enum": [null, "telegram", "email", "mission-control", "github-issue", "slack"]
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ledgerEntries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errorSummary": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
