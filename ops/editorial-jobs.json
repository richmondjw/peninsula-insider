      "medium": {
        "label": "Medium-risk update",
        "approvalMode": "light-editorial-review",
        "defaultPublishMode": "review-required",
        "description": "For changes that materially alter emphasis, inclusion/exclusion, or framing without becoming full strategic editorial judgments."
      },
      "high": {
        "label": "High-risk editorial/strategic",
        "approvalMode": "founder-led-editorial-approval",
        "defaultPublishMode": "approval-required",
        "description": "For Journal, flagship recommendation products, opinion, strategic positioning, and any change that materially affects trust, taste, or interpretation."
      }
    }
