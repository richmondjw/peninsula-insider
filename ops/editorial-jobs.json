    "tiers": {
      "low": {
        "label": "Low-risk operational",
        "approvalMode": "system-approved",
        "defaultPublishMode": "autonomous",
        "description": "For governed operational changes that do not materially affect editorial positioning, recommendations, trust, or factual interpretation."
